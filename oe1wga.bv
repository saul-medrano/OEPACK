GLOBAL MY'PRGNAM="OE1WGA"
GLOBAL SKIP'PRT'COPYF = "Y"
GLOBAL DO'FIRST'SET="Y"
GLOBAL DEBUG="N"
GLOBAL SKIP'DAYS="M"
COPY "CVTMAP",SKIP'DAYS="M"
CIF DEBUG="Y" THEN
        PROGRAM OE1WGA,8.0D(47)  !!Order Entry (T-Shirt)
CELSE
        PROGRAM OE1WGA,8.0(47)  !!Order Entry (T-Shirt)
ENDCIF
!%W% %G% %U% - SCCS
GLOBAL UP'CHARGES = "N"
CIF UP'CHARGES = "N" THEN
    GLOBAL UP'HDR = "CHR(0)"
    GLOBAL TOTAL'UP'CHARGE = "II"
    GLOBAL UP'NEEDED'DOZ2 = "II"
    GLOBAL UP'NEEDED'PCS2 = "II"
    GLOBAL UP'RTOTAL2 = "II"
CELSE
    GLOBAL UP'HDR = "UP'HDR"
    GLOBAL TOTAL'UP'CHARGE = "TOTAL'UP'CHARGE"
    GLOBAL UP'NEEDED'DOZ2 = "UP'NEEDED'DOZ(2)"
    GLOBAL UP'NEEDED'PCS2 = "UP'NEEDED'PCS(2)"
    GLOBAL UP'RTOTAL2 = "UP'RTOTAL(2)"
ENDCIF

GLOBAL NOT'REFCHG="Y"
GLOBAL V''MBA'LOG = "N"
GLOBAL WGA'PRGNAM="OE1WGA"
GLOBAL USE'SRL="N"
GLOBAL V''SKIP'PTP="Y"
GLOBAL E'ADD3="E'ADD3"
GLOBAL DELETE'IT3="DELETE'IT3"
GLOBAL ATTDPTR="ATTDPTR"
GLOBAL MCPTYPTR="MCPTYPTR"
GLOBAL STXPTR="STXPTR"
GLOBAL TRHPTR="TRHPTR"
GLOBAL USE'CC="Y"
GLOBAL USE'PLUG="N"
GLOBAL USE'CUTS="N"
GLOBAL USE'TAD="Y"
GLOBAL USE'CAP="N"
GLOBAL USE'CHO="L"
GLOBAL USE'CHI="Y"
GLOBAL USE'RTN="N"
COPY "OE1HDR.BV"
COPYF "PRWFIL[SY]"
