GLOBAL REVISION="001"
GLOBAL LHS'MARK = "N"
GLOBAL SHS'MARK = "N"
GLOBAL HHS'MARK = "N"
GLOBAL GLI'MARK = "N"
GLOBAL BCH'MARK = "N"
GLOBAL TRX'MARK = "N"
GLOBAL PASREC1 = "TLT'REC"                      !![17]
GLOBAL PASREC2 = "WSL'REC"                      !![17]
