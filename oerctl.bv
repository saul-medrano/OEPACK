!  8.221  06/27/23 j4878    CC enhancement - suppress street address, city and state when cvsetup.cc_zip_only tag is "Y".
!                           Removed SND XML from log file See CV/CCANET.CPY
!  8.222  06/29/23 j4878    Change CC billing zip code lookup to test for nine or five digit zip code records, see CCANET fo
!                           changes
!  8.223  02/09/24 j5724    Mass compile - got unmapped variable
!                           EMAIL'FAX which is used in qmail.mac
!  8.224  04/02/24 j4878    Additional changes to add Authorization messages to ATQ for both the initial Authorization and
!                           Reauthorization
!  8.225  05/31/24 j4878    Fix Long ANET msg parsing in CV/CCANET.CPY
!  8.226  06/08/24 j5724    Change save RCNs to B,4
!  8.227  05/01/25 j5724    Add LINK to mvr001 (Ship A Package) and debug
!                           code
!  8.228  06/13/25 j5724    Move Ship A Package link (MVR002) to WLDQ2F.
!                           Also removed old VICS UPS code.
!  8.229  06/26/25 j5724    Malvern June 28 2025 pre deployment checkin
!                           Printer fix, remover label from cache, add
!                           Force from queue and folders
!  8.230  08/05/25 j5512    add logging to track issue with "f" status
!                           which is causing issues.
!  8.231  08/27/25 j5724    Integrator/Malvern Batch Ship-a-Package using
!                           asynchronous Malvern calls
!  8.232  10/06/25 j5724    Replace LINK to mvrx01 with LINK to oerx01.
!                           Replace LINK to mvr023 with LINK to oer023.
!  8.233  11/24/25 j5724    If all MBX boxes validate get the Malvern
!                           Shipping Label. We are no longer retrieving
!                           the labels in OETSTP.
!  8.234  03/20/26 j4878    Enhance authorization logging for credit card reauthorization Remove CVV validation from overall
!                           order reauthorization test flow Retain logging details to support authorization troubleshooting
!                           and audit
! !!COMMENT-MARKER!!LANGUAGE=BASIC!!    DO NOT REMOVE  DO NOT REMOVE
!!
CIF OLD'WAY AND NOT OLD'WAY THEN
        Theory of changes:  WHY oh WHY was I journalling in here?  As far
as I could tell to cause restarts to be automatic on system crash.  It did
this before and after each link so that the error message on reboot would
say what program died.  BUT, the cost of journalling is very high in
overhead.  This is because I was journalling at every link for up to
14 program names and I was journalling every write to HDR and HHS.
I removed it all and added in some simple journalling that
never journals any of the record reads and writes.  Instead only the
header in the journal file is updated 3 times.  It sets "START" into
program name when it starts, sets "OEXQTY" at a particular critical
point, and "ARCHIV" after the critical point.  At program end it clear
the journal file.  We will see if it 1) is faster; and 2) works!
ENDCIF
!!
MAP1    SHIPPING'ENTRY,S,80
MAP1    NG'FLAG,S,1
MAP1    PRHPTR,X,30
MAP1    THIS'ACTION,S,1
MAP1    TARGET'VIA'NO,B,2
MAP1    EMAIL'FAX,S,200    !! used in qmail.mac[WB]
MAP1    LENTRY,S,500

DEFINE GETPROFILE
    GETPROFILE'TMP = ""
    |2 = ""
    XCALL ABUTIL,41,|0,|1,GETPROFILE'TMP
    |2 = GETPROFILE'TMP
ENDMACRO

DEFINE LOG'IT        !!do I need to move this below GETCMN CMN'REC?
    IF |PGODS| THEN
        \LABLOGGER LENTRY """/tmp/oerctl.txt"""    !!Malvern
        LENTRY = ""
    ENDIF
ENDMACRO

\SSRPTMAPS                      !!Standard report maps
!!
\COPYF OC2 OE
\COPYF MEA IN MODE="PRI"
COPYF   "IN2FIL[IN]",NOAFR
COPYF   "LSTFIL[MC]",NOAFR
COPYF   "LSTKEY[MC]"
COPYF   "LSTFKY[MC]"
\COPYF  COU MC
\COPYF  VIL IN
\COPYF  HDR OE HDR2 MODE="DTA"
\COPYF DOC AR                           !![6]
!![6]\COPYF DOC AR MODE="PRI"
!![6]COPYF   "DOCVKY[AR]"
\COPYF DHS AR MODE="PRI"                !![62]
COPYF   "DHSVKY[AR]"                    !![62]
COPYF "HHSFIL",NOAFR                    !![6]
!!
COPYF   "CMNFIL[SY]",NOAFR
COPYF   "CMNFIL[SY]",=CMN2,NOAFR
!!
!![82] start;
COPYF "LINFIL"
COPYF "LINKEY"

COPYF "SUBFIL"
COPYF "SUBKEY"

COPYF "PRHFIL[IN]"
COPYF "PRHKEY[IN]"
!![82] end;
COPY    "FORMAD"
COPY    "CVTMAP"
!!
MAP1    ARCHIVE,B,1
MAP1    XDAYS,F
MAP1    CRLF,S,2,CHR(13)+CHR(10)
MAP1    LOOP'TST,B,1
MAP1    TST'BAL,B,5
MAP1    CMN'OTHER'OVR,@CMN'OTHER
                MAP2 MAX'DR,B,5
                MAP2 MAX'CR,B,5
!!
MAP1    FAIL'LINK,B,1
MAP1    CALC'HTOTAL,B,5
MAP1    PRGNAM(14),S,6
MAP1    FINISHED'WITH,B,1
MAP1    IN'TASK,B,1                                             !![67]
MAP1    LINKED,B,1
MAP1    IN'UTASK,B,1            !!IN UNIX TASK
!![69]MAP1      TASK'CNT,B,1                                    !![67]

!!
MAP1 ELAPSED'HRS,B,2            !!Calculated hours between today's day and hour with Approval Day and Hour

!!
!!
MAP1 INLOOP,B,1                                         !![36]
MAP1 QUEUE'EMPTY,B,1,1                                  !![51]
MAP1 TIME1,B,3                                          !![69]
MAP1 TIME2,B,3                                          !![69]
MAP1 TIMET,B,3                                          !![69]
MAP1 TMP,S,300000

CIF V''CSYSTEM="AMOS" THEN
        COPYF "BAS:USRBUF.CPY",=UB2
        COPYF "BAS:USRBUF.CPY",=UB3
CELSE
        GLOBAL USRBUF'ALREADY="N"
        COPY "/met/sy/lib/usrbuf.cpy",=UB2
        GLOBAL USRBUF'ALREADY="N"
        COPY "/met/sy/lib/usrbuf.cpy",=UB3
ENDCIF
\COPYF USR SY MODE="PRI"
MAP1 BG'FLAG,S,1

MAP1 O''PRODUCTION'YN,S,1

ON ERROR GOTO PRE'ERTRAP

BEGIN:
        XCALL VICSIT,-29,BG'FLAG
        IF V''SYSTEM = "AMOS" THEN
                IF V''JOBNAM[1;4] = "TASK" THEN IN'TASK = 1     !![67]
        ELSE
                IF UB'UID[1;4] = "TASK" THEN IN'TASK = 1        !![92]
                UB2'BUF = USR'BUF
                IN'UTASK = IN'TASK
!!              IF IN'TASK = 1 THEN
!!NEED XCALL TO KILL ALARMS
!!              ENDIF
        ENDIF
MAP1 WBWHAP,B,1
        GETCMN CMN'REC


!!      MAP1 PASSED'SCALE'PRT'SEQ,B,1
        PASSED'SCALE'PRT'SEQ = CMN'SAV'RCN(4)
        IF CMN'FRM'PRGNAM = "WBWHAP" OR &
                                        CMN'FRM'PRGNAM = "WB1XML" OR &
                                        CMN'FRM'PRGNAM = "POLSHC" OR &
                                        CMN'FRM'PRGNAM = "WBFULL" OR &
                                        CMN'FRM'PRGNAM = "POLRED" OR &
                                        CMN'FRM'PRGNAM = "POLBAD" OR &
                                        CMN'FRM'PRGNAM = "POL945" OR &
                                        CMN'FRM'PRGNAM = "WLDQ2F" OR &
                                        CMN'FRM'PRGNAM = "POLHAR" OR &
                                        CMN'FRM'PRGNAM = "WB1PST" OR &
                                        CMN'FRM'PRGNAM = "WLPOST" OR &
                                        CMN'FRM'PRGNAM = "WBPOST" THEN
                WBWHAP = 1
        ELSE
                WBWHAP = 0
        ENDIF
        MAP1 BAGGER'PARMS,S,128
        XCALL GETENV,"BAGGER_PARMS",BAGGER'PARMS
        XCALL GETENV,"MALVERN_PROD",ENTRY
        O''PRODUCTION'YN = ENTRY
!!Need this, not HDR'BAGGER, because we need it before we read the header
        CASE
        IF IN'TASK # 0 AND WBWHAP = 0 THEN  !![67] - this case
            CALL SET'UP
            IF OEC'TASK'YN = "Y" THEN
                PQU'DID = "OEQUE"
                PQU'KID = "OEQUE"
            ELSE
                ENTRY = "Bad problem ... task/queue mismatch!"
                CALL DO'ERR'OERCTLL
!!              IN'TASK = 0
                GOTO ABORT
            ENDIF
            TIME1 = TIME                            !![69]

            LENTRY = "OERCTL - Malvern" : \LOG'IT

            DO WHILE CTC = 0
                TIME2 = TIME
                TIMET = TIMET + ((TIME2 - TIME1) MAX 0)
                TIME1 = TIME2
                IF V''SYSTEM = "AMOS" THEN      !![92]
                    IF (TIMET/60) > 15 EXIT !!More than 15 minutes
                ENDIF
                IF IN'TASK # 1 THEN
                    CALL GET'BGP'DATA
                    CALL PROCESS'ONE'HDR
                ENDIF
                IN'TASK = 2
                GOT'HHS'RCN = 0
                PQU'CTL = 3
                PQU'QUEUE = 0
                PQU'SEQ = 0
                \SETKEY PQU MODE="KEY" APID="SY"
                USE PQU INTO PQU'REC KEY PQU'KEY
                DO
                    GETNXT PQU INTO PQU'REC
                    IF PQU'QUEUE > 40 THEN PQU'CTL = 3
                LOOP UNTIL PQU'PROG = "OERCTL" OR PQU'CTL # 0
                IF PQU'CTL = 0 THEN
                    IF CMP'RCN # PQU'CMP THEN
                        \COPYF CMP SY
                        USE CMP PQU'CMP INTO CMP'REC
                        UB'CNAME = CMP'NAME
                        \ULDUSR                 !!reload
                    ENDIF
                    IF PQU'CMP # UB'CNO OR PQU'SYS # UB'SYS THEN
                        UB'CNO = PQU'CMP
                        UB'SYS = PQU'SYS
                        \ULDUSR                 !!reload
                    ENDIF
                    IF PQU'USER # USR'RCN AND PQU'USER # 0 THEN
                        USE USR PQU'USER INTO USR'REC
                        IF USR'CTL = 0 THEN
                            UB'UID = USR'IDD
                            UB'NAME = USR'NAME
                            UB'RCN = USR'RCN
                            UB'LOC = USR'LOC
                            \ULDUSR         !!reload
                        ELSE
                            IN'TASK = 1
                            REPEAT
                        ENDIF
                    ENDIF
                    RDCOND PQU INTO PQU'REC
                    IF PQU'CTL # 0 THEN
                        IN'TASK = 1
                    ELSE
                        PS'DTAPTR = PQU'USRPTR
                        PS'QNO = PQU'RCN
                    ENDIF
                ELSE
                    QUEUE'EMPTY = 1
                    CALL CLEAN'UPS
                    IN'TASK = 1
                    USE OEC OEC'RCN INTO OEC'REC
                    IF OEC'REPEAT = 0 EXIT
                    I = OEC'REPEAT          !!Xcall sleep needs float!
                    USR'BUF = UB2'BUF
                    \ULDUSR         !!reload
                    IF IN'UTASK # 0 THEN
                        ? "Sleeping for ";STR(I);" seconds"
                    ENDIF
                    \SLEEP I
                ENDIF
            LOOP
        ELSE
        IF IN'BGP # 0 AND WBWHAP = 0 AND BAGGER'PARMS = "" THEN   !![26] Changed from = 1
                LENTRY = "IN'BGP # 0 AND WBWHAP = 0 AND B" : \LOG'IT
!!Print one in background (NEVER can this be a repost!)

                GETCMN
                CALL SET'UP
                IF V''JOBNAM = "BGP1" THEN QUEUE'EMPTY = 0
                IF OEC'REPEAT = 0 THEN QUEUE'EMPTY = 0
                DO                                      !![36] - loop
                        CALL GET'BGP'DATA
                        CALL PROCESS'ONE'HDR
!![36] - keep processing the queue
                        MAX'SLEEP = 0                           !![52]
!![59]                  CALL CLEAN'UPS                          !![38]
                        GOT'HHS'RCN = 0                         !![37]
                        PQU'CTL = 3
                        IF CTC > 0 GOTO ABORT2
                        IF PQU'QUEUE # 0 AND LOC'MIN'BGP # 99 AND &
                           OEC'REPEAT # 0 AND                     &
                           V''JOBNAM # "BGP1" THEN                      !![42]
BEGIN2:                                                                 !![40]
                                IF LOC'MIN'BGP # 0 THEN
                                        PQU'QUEUE = LOC'MIN'BGP MAX 1
                                ENDIF
                                PQU'SEQ = 0
                                \SETKEY PQU MODE="KEY" APID="SY"
                                USE PQU INTO PQU'REC KEY PQU'KEY
                                DO
                                        GETNXT PQU INTO PQU'REC
                                        IF PQU'QUEUE # PQU'KQUEUE AND &
                                                        LOC'MAX'BGP = 0 THEN
                                                PQU'CTL = 3
                                        ENDIF
                                        IF PQU'QUEUE > LOC'MAX'BGP AND &
                                                        LOC'MAX'BGP # 0 THEN
                                                PQU'CTL = 3
                                        ENDIF
                                        IF PQU'QUEUE = 0 THEN PQU'CTL = 3 !![57]
                                LOOP UNTIL PQU'PROG = "OERCTL" OR PQU'CTL # 0
                                IF PQU'CTL = 0 THEN
!![45]  below
                                        IF PQU'CMP # UB'CNO OR PQU'SYS # UB'SYS THEN
                                                GOTO ABORT
                                        ENDIF
                                        IF PQU'USER # USR'RCN AND PQU'USER # 0 THEN
                                                USE USR PQU'USER INTO USR'REC
                                                IF USR'CTL = 0 THEN
                                                        UB'UID = USR'IDD
                                                        \ULDUSR         !!reload
                                                ENDIF
                                        ENDIF
!![45] above
                                        RDCOND PQU INTO PQU'REC
                                        IF PQU'QUEUE = 0 THEN
!![57]                                          REL PQU
!!                                              \SLEEP 1
!![57]                                          GOTO BEGIN2
                                                GOTO ABORT      !![57]
                                        ENDIF
                                        PS'DTAPTR = PQU'USRPTR
                                        PS'QNO = PQU'RCN
                                        INLOOP = 1
                                ENDIF
                        ENDIF
                LOOP UNTIL PQU'CTL # 0
!![40] Below
!!When PQU empty, check control record to see if we should die.
!!if not, sleep some seconds, then try again.
                IF V''JOBNAM # "BGP1" THEN                      !![42]
                    USE OEC INTO OEC'REC
                    IF OEC'REPEAT # 0 THEN
                        MAP1 MAX'SLEEP,B,1                      !![45]
                        MAX'SLEEP = MAX'SLEEP + 1               !![45]
                        IF MAX'SLEEP >= 3 CALL CLEAN'UPS        !![66]
                        IF MAX'SLEEP > 30 GOTO ABORT            !![45]
                        I = OEC'REPEAT          !!Xcall sleep needs float!
                        \SLEEP I
                        QUEUE'EMPTY = 1                         !![51]
                        GOTO BEGIN2
                    ENDIF
                ENDIF
!![40] Above
                GOTO ABORT2                                     !![37]
!![36] - above
        ELSE
                LENTRY = "QUEUE'EMPTY=0 TO'PRGNAM:"+CMN'TO'PRGNAM+" FRM'PRGNAM:"+ &
                        CMN'FRM'PRGNAM+" CMN'OTHER:"+CMN'OTHER
                \LOG'IT
                QUEUE'EMPTY = 0                                 !![85]
!!              GETCMN CMN'REC
                IF CMN'TO'PRGNAM = "LINK" THEN
                        COPYF "TRMFIL[AR]",NOAFR
                        \HDRLNK 2
                        CMN'TO'PRGNAM = "OERCTL"
                        LINKED = 1
                ENDIF
                IF CMN'TO'PRGNAM = "CHAIN" THEN
                        XCALL VICSIT,8,3,PASSED'PRH'ARRAY,CMN'OTHER,SF
                        CMN'TO'PRGNAM = "OERCTL"
                ENDIF
                CMN2'REC = CMN'REC
                IF CMN'TO'PRGNAM # "OERCTL" THEN
!!Bad news bears
                        ENTRY = "Cannot run program directly"
                        CALL DO'ERR'OERCTL
                        GOTO ABORT2
                ENDIF
                IF CMN'FRM'PRGNAM # "OERBAK"                    AND &
                                        CMN'FRM'PRGNAM # "OERBAT" THEN
                        LENTRY = "CMN'FRM'PRGNAM # OERBAK" : \LOG'IT
!!Print one in foreground (could be a repost)
!!WBWHAP goes here
                        CALL SET'UP
                        CALL GET'CMN'DATA
                        CALL PROCESS'ONE'HDR
                        IF WBWHAP # 0 AND WBWHAP # 3 THEN WBWHAP = 2
                ELSE
                        LENTRY = "WOED'DID = CMN'OTHER[1;5]" : \LOG'IT
!!Fill backorders batch picking ticket processing (never a repost)
                        WOEO'DID = CMN'OTHER[1;5]
                        WOEO'KID = CMN'OTHER[7;6]
                        CMN'SPACE = SPACE
                        CALL SET'UP
                        CALL PROCESS'PICK'FROM'WOEO
                ENDIF
        ENDCASE
ABORT:
!![57]  IF HDR'RCN # 0 THEN
!!              RDLOCK HDR
!!              IF HDR'PQU'STAT # "" THEN
!!                      HDR'PQU'STAT = SPACE
!!                      WRITE HDR
!!              ENDIF
!![57]  ENDIF
ABORT2:
        IF CTC > 0 AND CTC <= 200 AND (IN'BGP = 1 OR IN'TASK = 1) THEN
                ? "CTRL-C abort completed gracefully!"
        ENDIF
        CALL CLEAN'UPS                          !![38]
        IF IN2'WL'YN = "Y" AND WLC'USE'VFH'YN = "Y" THEN
            IF WL'SKIPDOCS # "Y" THEN
                XCALL DB,22,HDR'PKT                     !![23] - general release
            ENDIF
        ELSE
            XCALL DB,22,HDR'PKT                     !![23] - general release
        ENDIF
        CMN'REC = CMN2'REC
!![26] Changed IN'BGP test below to = 0 from # 1
        IF WL'DEBUG # "" THEN
            ENTRY = "WBWHAP="+WBWHAP+" PICKING="+WL'PICKING'CC+" CC="+CC'FAILED+" R="+CC'RESPONSE
            CALL LOG'ENTRY
        ENDIF
        IF WBWHAP # 0 OR WL'PICKING'CC = 1 THEN
            CMN'SPACE = SPACE
            CMN'TO'PRGNAM = CMN2'FRM'PRGNAM
            IF WBWHAP = 2 OR WL'PICKING'CC = 1 THEN
                IF CC'FAILED = 1 THEN
                    CMN'FRM'PRGNAM = "CCFAIL"
                    IF CC'RESPONSE = "" THEN
                        CMN'OTHER = "Credit card did not authorize"
                    ELSE
                        CMN'OTHER = CC'RESPONSE
                    ENDIF
                ELSE
                    CMN'FRM'PRGNAM = "GOOD"
                ENDIF
            ELSE
                IF SHIPPING'ENTRY # "" THEN
                    CMN'FRM'PRGNAM = "ERROR"
                    CMN'OTHER = SHIPPING'ENTRY
                ELSE
                    CMN'FRM'PRGNAM = "ERROR"
                    IF WBWHAP = 3 THEN
                        CMN'OTHER = ENTRY'OERCTL
                    ELSE
                        CMN'OTHER = "Unexplained error in OERCTL!"
                    ENDIF
                ENDIF
            ENDIF
            ENTRY = "From="+CMN'FRM'PRGNAM+" O="+CMN'OTHER
            CALL SNDMON
            IF WL'DEBUG # "" THEN
                CALL LOG'ENTRY
            ENDIF

            IF ERRORS'MBX # 0 THEN
                LENTRY = "ERRORS'MBX: #01" : \LOG'IT
                CMN'FRM'PRGNAM = "ERROR9"
            ENDIF

            SNDCMN CMN'REC
            XCALL GETENV,"DOING_WB1PST",ENTRY
            IF ENTRY = "Y" THEN
                \HDRLNK 3
            ENDIF
            XCALL GETENV,"DOING_WLPOST",ENTRY
            IF ENTRY = "Y" THEN
                \HDRLNK 3
            ENDIF
        ELSE
        IF (IN'BGP = 0 OR BAGGER'PARMS # "") AND &
                                CMN'TO'PRGNAM = "OERCTL" AND &
                                CMN'FRM'PRGNAM[1;5] # "RPOST"   AND &
                                CMN'FRM'PRGNAM[1;5] # ""        AND &
                                IN'TASK = 0                     THEN

            IF CMN'FRM'PRGNAM[1;5] = "RPSTH" THEN
                CMN'SPACE = SPACE
                CMN'TO'PRGNAM = "OE1HDR"
                CMN'FRM'PRGNAM = "EXTRNL"
                \SETKEY HDR MODE="KEY"
                RDKEY HDR
                GETNXT HDR
                IF HDR'CTL = 0 THEN
                    CMN'SAV'RCN(1) = HDR'RCN
                    SNDCMN CMN'REC
                ENDIF
!![29]                  CHAIN "DSK0:L.LIT[1,4] 1/SY,B"+CRLF+"ERASE SYXCHN.CMD"+CRLF+"L "+STR(UB'SYS)+"/OE"+CRLF+"RUN OE1HDR"
                \LOGGER """SY""" 1 LOC="B"
                KILL "SYXCHN.CMD"
                \LOGGER
                CHAIN "OE1HDR"
!![29] Above
            ELSE
!![81] - added V''SYSTEM to below.
!![79] - added OE2CRE to below.
                IF LINKED = 1 THEN
                    IF OEC'PPRGNAM # "OEPACK" THEN
                        CMN'SPACE = SPACE
                        CMN'TO'PRGNAM = CMN2'FRM'PRGNAM
                        CASE
                        IF CC'FAILED = 1 THEN
                            CMN'FRM'PRGNAM = "CC"
                            CMN'OTHER = CC'RESPONSE
                            HDR'BREASON = "1"
                            MAP1 ERROR'HDR'RCN,B,4
                            IF HDR'RCN # 0 AND HDR'RCN # ERROR'HDR'RCN THEN
                                UPDATE HDR FROM HDR'REC
                                ERROR'HDR'RCN = HDR'RCN
                            ENDIF
                        ELSE
                        IF SHIPPING'ENTRY # "" THEN
                            CMN'OTHER = SHIPPING'ENTRY
                            CMN'FRM'PRGNAM = "SHIP"
                            HDR'BREASON = "7"
                            IF HDR'RCN # 0 AND HDR'RCN # ERROR'HDR'RCN THEN
                                UPDATE HDR FROM HDR'REC
                                ERROR'HDR'RCN = HDR'RCN
                            ENDIF
                        ELSE
                        IF ENTRY'OERCTL = "" THEN
                            CMN'FRM'PRGNAM = "GOOD"
                            IF ERRORS'MBX # 0 THEN
                                LENTRY = "ERRORS'MBX: #03" : \LOG'IT
                                CMN'FRM'PRGNAM = "ERROR9"
                            ENDIF
                        ELSE
                            CMN'FRM'PRGNAM = "ERROR"
                            CMN'OTHER = ENTRY'OERCTL
                        ENDCASE
                        CMN'SAV'RCN(4) = LABELS'PRINTED
                    ELSE
                        IF CC'FAILED = 1 THEN
                            CMN'FRM'PRGNAM = "CCFAIL"
                            IF CC'RESPONSE = "" THEN
                                CMN'OTHER = "Credit card did not authorize"
                            ELSE
                                CMN'OTHER = CC'RESPONSE
                            ENDIF
                        ELSE
                            CMN'FRM'PRGNAM = "GOOD"
                            CMN'OTHER = "Credit card worked!"
                        ENDIF
                    ENDIF
                    ENTRY = CMN'OTHER
                    \STRIP ENTRY 3
                    IF ENTRY # "" THEN
                        CALL SNDMON
                    ENDIF
                    \HDRLNK 3
                ELSE
                    IF CMN'FRM'PRGNAM # "OE2CRM" AND CMN'FRM'PRGNAM # &
                                  "OE2CRE" AND CMN'FRM'PRGNAM[1;2] # "WB" AND &
                                    CMN'FRM'PRGNAM[1;2] # "WH" THEN
                        CMN'TO'PRGNAM = CMN'FRM'PRGNAM
                        CMN'FRM'PRGNAM = "OERCTL"
                        IF CMN'TO'PRGNAM = "OE1HDR" AND &
                                        INC'INTERFACE = 5 AND &
                                                HDR'PROC = 5 THEN
                            SNDCMN CMN'REC
                            CHAIN "OESHOP"
                        ELSE
                            IF CMN'TO'PRGNAM # "WL1WLQ" THEN
                                SNDCMN CMN'REC
                                CHAIN CMN'TO'PRGNAM
                            ELSE
                                IF ENTRY'OERCTL = "" THEN
                                    CMN'FRM'PRGNAM = "GOOD"
                                    IF ERRORS'MBX # 0 THEN
                                        LENTRY = "ERRORS'MBX: #02-A" : \LOG'IT
                                        CMN'FRM'PRGNAM = "ERROR9"
                                    ENDIF
                                ELSE
                                    CMN'FRM'PRGNAM = "ERROR"
                                    CMN'OTHER = ENTRY'OERCTL
                                    IF ERRORS'MBX # 0 THEN
                                        LENTRY = "ERRORS'MBX: #02-B" : \LOG'IT
                                        CMN'FRM'PRGNAM = "ERROR9"
                                    ENDIF
                                ENDIF
                                ENTRY = CMN'OTHER
                                \STRIP ENTRY 3
                                IF ENTRY # "" THEN
                                    CALL SNDMON
                                ENDIF
                                SNDCMN CMN'REC
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        ENDIF
END

SET'UP:
        IF IN'TASK # 0 THEN                             !![67]
            LDUSR                                   !![67]
            PWASTR = "YYYYYYYY"                     !![67]
        ELSE                                            !![67]
            \DOPASS ABORT="PRE'DO'TIMPQU"
        ENDIF                                           !![67]
        USE IN2 UB'CNO INTO IN2'REC
        IF IN2'CTL # 0 THEN
            ENTRY = "IN2 Control Record Not Found"
            CALL DO'ERR'OERCTL
        ENDIF
        USE OC2 UB'CNO INTO OC2'REC
        IF OC2'CTL # 0 THEN
            ENTRY = "OC2 control record not found!"
            CALL DO'ERR'OERCTL
        ENDIF

        IF LINKED # 1 THEN
            \READCTL APP="MC" GL="N" ABORT="PRE'DO'TIMPQU"
            \READCTL APP="OE" GL="N" ABORT="PRE'DO'TIMPQU"
            \READCTL APP="AR" GL="N" ABORT="PRE'DO'TIMPQU"
            \READCTL APP="IN" GL="N" ABORT="PRE'DO'TIMPQU"
            \READCTL APP="UP" GL="N" ABORT="PRE'DO'TIMPQU"
            USE OC2 UB'CNO INTO OC2'REC
        ENDIF
        MAP1 BAGGER'BQUEUE,S,1
        XCALL GETENV,"BQUEUE",BAGGER'BQUEUE
        IF BAGGER'BQUEUE >= "1" AND BAGGER'BQUEUE <= "9" THEN
            ENTRY = ""
            \ADDPATH OUTPUT="ENTRY" APID="WL" MODE="P"
            ENTRY = ENTRY + "x/bagger"+BAGGER'BQUEUE+".xml"
            \DG LOADFILE BAGGER ENTRY ENTRY
            IF DG'CTL = 0 THEN
                \DG GETCHILD BAGGER monitor MONITOR
                IF DG'CTL # 0 THEN
                    ENTRY = "Must set up monitor in "+ENTRY
                    CALL LOG'ENTRY
                    GOTO ABORT
                ENDIF

                \DG GETVALUE MONITOR ipc_mqid MON'MQID
                IF DG'CTL # 0 THEN
                    ENTRY = "Must set up ipc_mqid in monitor in "+ENTRY
                    CALL LOG'ENTRY
                    GOTO ABORT
                ENDIF
            ENDIF
        ENDIF

!![WC] Lookup CC Provider Code
        IF INC'USE'CV = "Y" THEN
            \READCTL APID="CV" GL="N"
            CALL GET'CC'PROVIDER
        ENDIF

        IF IN2'WB'YN = "Y" THEN
            \READCTL APID="WB" GL="N"
        ENDIF
        IF IN2'WL'YN = "Y" THEN
            \READCTL APID="WL" GL="N"
        ENDIF
        XCALL GETENV,"USPS_DEBUG",USPS'DEBUG
        IF USPS'DEBUG # "Y" AND USPS'DEBUG # "G" THEN USPS'DEBUG = "N"
        MAP1 WANT'TIF,S,1
        IF USPS'DEBUG # "N" THEN
            WANT'TIF = "Y"
        ELSE
            XCALL GETENV,"USPS_DEBUG_TIF",WANT'TIF
            IF WANT'TIF # "Y" THEN WANT'TIF = "N"
        ENDIF
        CALL SET'VICS'PTRS
        MAP1 DO'WAVE'PICKING,S,1
        MAP1 MASTER'DO'WAVE'PICKING,S,1
        XCALL GETENV,"OEPACK_WAVE_PICKING",MASTER'DO'WAVE'PICKING

        IF MASTER'DO'WAVE'PICKING = "" THEN
!!Either wave or consolidated, we add the record
            XCALL GETENV,"OEPACK_CONSOLIDATED'PICKING",MASTER'DO'WAVE'PICKING
        ENDIF
        IF MASTER'DO'WAVE'PICKING = "Y" THEN
            MAP1 OEPACK'WAVE'PU,S,1
            XCALL GETENV,"OEPACK_WAVE_PU",OEPACK'WAVE'PU
            MAP1 WL'DEBUG,S,100
            IF BAGGER'PARMS # "" THEN
                ENTRY = BAGGER'PARMS        !!LAZY
                XDAYS = INSTR(1,ENTRY,"~")
                IF XDAYS > 0 THEN
                    YDAYS = INSTR(XDAYS+1,ENTRY,"~")
                    WL'DEBUG = ENTRY[XDAYS+1,YDAYS-1]
                    IF (WL'DEBUG = "Y" OR &
                                  INSTR(1,WL'DEBUG,"wl_debug") # 0) AND &
                                  HDR'BQUEUE >="1" AND HDR'BQUEUE <= "9" THEN
                        WL'DEBUG = "/debug/bagger"+BAGGER'BQUEUE+".DAILY"
                        XCALL ABUTIL,46,WL'DEBUG,WL'DEBUG
                    ELSE
                    IF WL'DEBUG = "N" THEN
                        WL'DEBUG = ""
                    ENDIF
                    ENDIF
                ENDIF
            ELSE
            IF WL'DEBUG = "" THEN
                XCALL GETENV,"WL_DEBUG",WL'DEBUG
                MAP1 ENV'DEBUG,S,128
                CASE
                IF (WL'DEBUG = "Y" OR &
                                  INSTR(1,WL'DEBUG,"wl_debug") # 0) AND &
                                  HDR'BQUEUE >="1" AND HDR'BQUEUE <= "9" THEN
                    WL'DEBUG = "/debug/bagger"+HDR'BQUEUE+".DAILY"
                    XCALL ABUTIL,46,WL'DEBUG,WL'DEBUG
                    ENV'DEBUG = WL'DEBUG
                    XCALL PUTENV,"WL_DEBUG="+ENV'DEBUG
                    XCALL VICSIT,-107,WL'DEBUG
                ELSE
                IF WL'DEBUG = "Y" THEN
                    WL'DEBUG = "/debug/wl_debug.DAILY"
                ELSE
                IF WL'DEBUG = "N" THEN
                    WL'DEBUG = ""
                ENDCASE
            ENDIF
            ENDIF
            MAP1 WL'SKIPDOCS,S,1
            XCALL GETENV,"WL_SKIPDOCS",WL'SKIPDOCS
        ENDIF

        IF WL'DEBUG # "" THEN
            ENTRY = "CMN TO="+CMN'TO'PRGNAM+" FRM="+CMN'FRM'PRGNAM+" WL="+WL'SKIPDOCS+" MW="+MASTER'DO'WAVE'PICKING
            CALL LOG'ENTRY
        ENDIF
        MAP1 NO'EMAIL,S,1
        XCALL GETENV,"OEPACK_NO_EMAIL",NO'EMAIL
        CALL SET'USE'CC                         !![99]

![82] start;
        IF OEC'SKIP'FUT = "Y" AND INC'INTERFACE = 6 THEN
                \CNV'DTT DATE XDAYS
!!              DTT = DATE
!!              CALL CNV'DTT
!!              XDAYS = YDAYS                   !!Todays date.
        ENDIF
![82] end;
RETURN

COPY "CCCARD[CV]",CCONLY="Y"
COPY "CCANET[CV]",BLD="AUTH" SOURCE="OE" !![WC] Include ANET'BLD'AUTH'REQUEST subroutine

MAP1 FIRST'HDR'NO,B,3
MAP1 FIRST'LOC'NO,B,2
!![90]MAP1 EVER'FIRST,B,1
MAP1 DEL'FIRST,F                                        !![90]
MAP1 EVER'MULTI,B,1                                     !![64]
MAP1 FIRST'RCN,B,4                                      !![91]
MAP1 FINAL'FFP'TOTAL,B,2                                !![17]

PROCESS'ONE'HDR:
    LENTRY ="(PROCESS'ONE'HDR) PPRGNAM:"+OEC'PPRGNAM+" TO'PRGNAM:"+CMN'TO'PRGNAM+ &
    " FRM'PRGNAM:"+CMN'FRM'PRGNAM+" CMN'OTHER:"+CMN'OTHER

        !! Record User Info in AUTHDEBUG log
        ENTRY = LENTRY
        CALL LOG'AUTH
        ENTRY = "(PROCESS'ONE'HDR) [UB'UID="+UB'UID+" UB'NAME="+UB'NAME+"] "
        CALL LOG'AUTH

    \LOG'IT

!![17] Added HDR'PROC test below (can't break transfers into multi-locations!)
        IF WL'DEBUG # "" THEN
            ENTRY = "OERCTL PROCESS ONE HDR "
            \KERROR HDR MODE="D" CNO="N"
            CALL LOG'ENTRY
        ENDIF
        \CHO HDR
        IF OEC'PPRGNAM = "OEPACK" THEN
            \TSTBIT HDR'BIT'FLAG 4 VAR="SF"         !!Re-pricing bit set
            IF SF # 0 THEN
                CALL DELETE'PIC
                ENTRY = "Cannot process - re-pricing set - see order in order entry program!"
                CALL DO'ERR'OERCTL
                GOTO ABORT
            ENDIF
        ENDIF
        IF HDR'PROC # 6 THEN
            CALL CHECK'NOS
            IF NOS'CTL = 0 THEN
                ENTRY = "Cannot process - NOS No ship set!"
                CALL DO'ERR'OERCTL
                GOTO ABORT
            ENDIF
        ENDIF
        IF INSTR(1,UCS(UB'CNAME),"MORRIS") # 0 THEN
            IN2'WB'YN = "Y"
        ENDIF

        MOST'CACHE'SPACE = SPACE                !![70]
        FINAL'FFP'TOTAL = HDR'FFP'TOTAL                 !![17]
        IF (HDR'ACTION = "P" OR HDR'ACTION = "E")               AND &
                OEC'MULTI'LOC = "Y" AND REPOSTING = 0           AND &
                                HDR'PROC <= 5 AND HDR'MULTI # 0 THEN
                DEL'FIRST = -1                          !![91]
                EVER'MULTI = 0                          !![64]
                FIRST'HDR'NO = HDR'NO
                FIRST'LOC'NO = HDR'LOC'NO
                FIRST'RCN = HDR'RCN                     !![91]
                SHL'LOC'NO = HDR'LOC'NO
                SHL'DOC'TYPE = HDR'DOC'TYPE
                SHL'NO = HDR'NO
                SHL'SLOC'NO = 0
                \SETKEY SHL MODE="KEY"
                USE SHL INTO SHL'REC KEY SHL'KEY
                DO
                    GETNXT SHL INTO SHL'REC
                    \CHKKEY SHL
                    IF SHL'CTL # 0 EXIT
                    EVER'MULTI = 1                  !![64]
                    GOT'HHS'RCN = 0                 !![33]
                    HDR'LOC'NO = SHL'SLOC'NO
                    HDR'NO = SHL'NNO
                    \SETKEY HDR MODE="KEY"
                    RDLOCK HDR INTO HDR'REC KEY HDR'KEY
                    IF HDR'CTL = 0 THEN
                        IF HDR'LOC'NO = FIRST'LOC'NO    AND &
                                                HDR'NO = FIRST'HDR'NO   THEN
                            CALL CHECK'DELETE       !![90]
                        ENDIF
                        IF DEL'FIRST = 0                        OR &
                                        HDR'LOC'NO # FIRST'LOC'NO       OR &
                                                HDR'NO # FIRST'HDR'NO   THEN
                            CMN'SAV'RCN(1) = HDR'RCN

                            CALL PROCESS'ONE'HDR2
                        ENDIF
                    ELSE
                        ENTRY = "Lost multi-loc order number: "
                        \KERROR HDR MODE="K"
                        CALL DO'ERR'OERCTLL
                    ENDIF
                LOOP
                IF EVER'MULTI = 0 THEN
                        RDLOCK HDR CMN'SAV'RCN(1) INTO HDR'REC
                        IF HDR'CTL # 0 THEN
                                CALL DELETE'PIC
                                ENTRY = "Lost HDR place 1!"
                                CALL DO'ERR'OERCTLL
                                HDR'RCN = 0
                                GOTO ABORT
                        ENDIF
                        HDR'MULTI = 0
                        UPDATE HDR FROM HDR'REC
                        GOTO PROCESS'ONE'HDR
                ENDIF
!![64] - above
                HDR'CTL = 3                                     !![56]
!![91] basicly call CHECK'DELETE if it was never called.
                IF DEL'FIRST < 0 CALL CHECK'DELETE      !![91]
                IF DEL'FIRST > 0 THEN                   !![90]
                        RDLOCK HDR DEL'FIRST INTO HDR'REC
                        IF HDR'CTL = 0 AND HDR'NO = FIRST'HDR'NO AND &
                                        HDR'LOC'NO = FIRST'LOC'NO THEN
                                \SETKEY HDR MODE="ALL"
                                \DELKEY HDR MODE="ALL"
                                DELETE HDR
                        ENDIF
                        CMN'SAV'RCN(1) = 0
                        HDR'RCN = 0
                ENDIF
                CALL DELETE'SHL
        ELSE
                CALL PROCESS'ONE'HDR2
        ENDIF
RETURN

DELETE'SHL:
    SHL'LOC'NO = FIRST'LOC'NO
    SHL'DOC'TYPE = HDR'DOC'TYPE
    SHL'NO = FIRST'HDR'NO
    SHL'SLOC'NO = 0
    \SETKEY SHL MODE="KEY"
    \DELOOP PRE="SHL" DSP="N"               !![40]
RETURN


PROCESS'ONE'HDR2:
        WL'PICKING'CC = 0
        MOST'CACHE'SPACE = SPACE                        !![74]
        THIS'ACTION = HDR'ACTION
        IF HDR'ACTION = "P" AND HDR'DOC'TYPE = 1 AND &
                (CMN'FRM'PRGNAM # "POLSHC" AND &
                CMN'FRM'PRGNAM # "POLRED" AND CMN'FRM'PRGNAM # "POL945" AND &
                CMN'FRM'PRGNAM # "POLBAD" AND CMN'FRM'PRGNAM # "POLHAR") THEN
            XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY

            CASE
            IF ENTRY # "" THEN
                THIS'ACTION = "E"
                IF WL'DEBUG # "" THEN
                    ENTRY = "HOB-like order: "
                    \KERROR HDR MODE="D" APID="OE" CNO="N"
                    \ABLOGGER ENTRY WL'DEBUG

                    ENTRY = "PROC'ONE'HDR2: "+ENTRY+" -> "
                    CALL LOG'AUTH
                ENDIF
            ELSE
            IF IN2'WL'YN = "Y" AND WLC'USE'VFH'YN = "Y" THEN
                LOC'KNO = HDR'LOC'NO
                \VUSE LOC
                IF INC'AUTOPACK = "Y" OR HDR'ACTION = "E" AND (IN2'WL'YN = "Y" AND &
                                WLC'DOC'TYPES(HDR'DOC'TYPE) = "Y") AND &
                                                HDR'QUOTE'YN # "Y" THEN
                    DO'WAVE'PICKING = MASTER'DO'WAVE'PICKING
                    IF OEPACK'WAVE'PU = "N" THEN
                        IF HDR'VIA'NO >= OEC'SCUS'VIA AND HDR'VIA'NO <= OEC'ECUS'VIA THEN
                            DO'WAVE'PICKING = "N"
                        ENDIF
                    ENDIF
                    IF LOC'WL'YN # "Y" THEN DO'WAVE'PICKING = "N"
                ELSE
                    DO'WAVE'PICKING = "N"
                ENDIF
                IF WL'DEBUG # "" THEN
                    ENTRY = "Order: "
                    \KERROR HDR MODE="D" APID="OE" CNO="N"
                    IF DO'WAVE'PICKING # "Y" THEN
                        ENTRY = ENTRY + " Wave pick NOT set oerctl, LOC:"+LOC'WL'YN+" IN2:"+IN2'WL'YN+" ACT:"+HDR'ACTION+" TYPE="+WLC'DOC'TYPES(HDR'DOC'TYPE)+" DW="+DO'WAVE'PICKING
                    ELSE
                        ENTRY = ENTRY + " Wave pick set oerctl, LOC:"+LOC'WL'YN+" IN2:"+IN2'WL'YN+" ACT:"+HDR'ACTION+" TYPE="+WLC'DOC'TYPES(HDR'DOC'TYPE)+" HOLD="+HDR'HOLD'YN+" DW="+DO'WAVE'PICKING
                    ENDIF
                    ENTRY = ENTRY + " SD="+WL'SKIPDOCS
                    CALL LOG'ENTRY
                ENDIF
                IF DO'WAVE'PICKING = "Y" THEN
                    IF WL'SKIPDOCS = "N" THEN  !!This is Y if wldq2f is posting
                                     !!N is credit card only for WL
                       THIS'ACTION = "E"
                       MAP1 WL'PICKING'CC,B,1
                       WL'PICKING'CC = 1
                       CC'FAILED = 1
                       CC'RESPONSE = "Never even tried"
                    ELSE
                    IF WL'SKIPDOCS = "X" THEN
                        RETURN                    !!Goes on queue from oepack
                    ENDIF
                    ENDIF
                ENDIF
            ENDCASE
        ENDIF
        CALL PROCESS'ONE'HDR3
        IF THIS'ACTION = "P" AND (FINISHED'WITH >= 13 OR HDR'RCN # 0) THEN !![3]
                IF FINISHED'WITH >= 13 THEN
                        FINISHED'WITH = 14
                        CALL SET'HDR'PRGNAM
                ENDIF
                IF HDR'RCN # 0 AND FINISHED'WITH = 14 THEN
!![20]                  FINISHED'WITH = 1
                        FINISHED'WITH = 0           !![20]
MAP1 MY'SLM'FLAG,B,1,0                                  !![21]
                        MY'SLM'FLAG = 1                 !![21]
                        CALL SET'HDR'PRGNAM
                ENDIF
        ENDIF
!![57] - below
        IF HDR'RCN # 0 AND HDR'PQU'STAT # "" AND (THIS'ACTION = "P" OR &
                      THIS'ACTION = "E" OR THIS'ACTION = "L") THEN
                HDR'FFP'TOTAL = FINAL'FFP'TOTAL                 !![17]
                HDR'PQU'STAT = SPACE
                HDR'ACTION = ""                         !![64]
                HDR'MULTI = 0                           !![7.4]
                UPDATE HDR
        ENDIF
!![57] - above

        CALL CLEAN'UPS                                  !![59]
RETURN

PROCESS'ONE'HDR3:
        IF HDR'CTL # 0 OR HDR'DOC'TYPE < 1 OR HDR'DOC'TYPE > 9 THEN
                CASE
                IF HDR'CTL = 4 THEN
                        USE HDR HDR'RCN INTO HDR'REC
                        ENTRY = "Order Header is locked: "
                        \KERROR HDR MODE="D"
                ELSE
                IF HDR'CTL # 0 THEN
                        ENTRY = "Cannot read order header, RCN="+HDR'RCN+" CTL="+HDR'CTL
                ELSE
                        ENTRY = "Invalid DOC'TYPE "
                        \KERROR HDR MODE="D"
                ENDCASE
                CALL DELETE'PIC
                ENTRY = ENTRY +" BGP="+IN'BGP+" RPOST="+REPOSTING
                CMN'REC = CMN2'REC
                IF CMN'FRM'PRGNAM[1;5] # "RPSTH" CALL DO'ERR'OERCTLL
                HDR'RCN = 0                             !![3]
                IF LOOP'TST # 1 AND IN'TASK # 1 GOTO ABORT2 ELSE RETURN !!KLUDGE
        ENDIF
        IF HDR'PQU'STAT # "Q" OR THIS'ACTION = SPACE THEN
                CALL DELETE'PIC
                ENTRY = "ABORT: "
                \KERROR HDR MODE="D"
                ENTRY = ENTRY + "|"+HDR'PQU'STAT+"-"+THIS'ACTION+"-"+HDR'MULTI
                CALL DO'ERRLO'OERCTL
                GOTO ABORT
        ENDIF
        IF HDR'PROC < 5 THEN
                \SSGET ARCUS ARTRH INLOC INVIA INVIL SCHEMA="20"
                IF CUS'TAXABLE # "Y" AND CUS'TAXABLE # "S"              AND &
                                (OEC'CHG'TAX # "Y" OR CUS'STX'NO = 0)   THEN
                        STX'DESC = "N/A"
                        HDR'STX'NO = 0
                ELSE
                        CALL GET'STX                            !![95]
                ENDIF
!![65] - do not write HDR if archive repost.
                IF REPOSTING = 0 OR (FINISHED'WITH < 10                 AND &
                                        CMN'FRM'PRGNAM[6;1] = "C")      THEN
                        UPDATE HDR FROM HDR'REC                 !![15]

                        IF CMN'FRM'PRGNAM = "WL1WLQ" AND VIA'MTYPE = "U" THEN
                            CALL SHIP'A'PACKAGE
                            CALL VALIDATE'MBX      !!If any BOX doesn't have MBX then VOID all Malvern shipped boxes
                            IF ERRORS'MBX # 0 THEN
                                ENTRY = "Malvern Ship-A-Package failed on a BOX"
                                CALL MSG'APPEND
                                ENTRY = "Force failed.  Retry"
                                GOTO DO'ERR'OERCTLL                    !!KLUDGE
                            ELSE
                                CALL GET'SHIP'LABELS
                            ENDIF
                        ENDIF
                ENDIF
                IF LST'NO # CUS'LST'NO OR HDR'SHIP'TO # 0 OR HDR'SHP'NO # 0 THEN
                        \USELST CUS'LST'NO
                ENDIF
CIF JUNK AND NOT JUNK THEN
                IF (HDR'BO'YN = "S" OR HDR'BO'YN = "N") AND HDR'LIN'BO # 0 THEN
                        CALL DELETE'PIC
                        ENTRY = "Cannot ship "
                        \HDRERR
                        IF HDR'BO'YN = "S" THEN
                            ENTRY = ENTRY + " until BO's all filled"
                        ELSE
                            ENTRY = ENTRY = " cancel order, BO's not allowed!"
                        ENDIF
                        GOTO DO'ERR'OERCTLL                    !!KLUDGE
                ENDIF
CELSE
                IF HDR'BO'YN = "S" AND HDR'LIN'BO # 0 THEN
                        CALL DELETE'PIC
                        ENTRY = "Cannot ship "
                        \HDRERR
                        ENTRY = ENTRY + " until BO's all filled"
                        GOTO DO'ERR'OERCTLL                    !!KLUDGE
                ENDIF
ENDCIF
        ELSE
                \SSGET INLOC SCHEMA="20"
                CUS'TAXABLE = "N"
        ENDIF
        IF WL'DEBUG # "" THEN
            ENTRY = "OERCTL ACTION="+THIS'ACTION
            CALL LOG'ENTRY
        ENDIF
        IF THIS'ACTION = "P" THEN
                MAP1 OE1WGA'TYP'APA,B,2
                MAP1 OE1WGA'TYP'PLUS,B,1
                XCALL GETENV,"OE1WGA_TYP_FORMAT",ENTRY
                II = INSTR(1,ENTRY,"_")
                IF II # 0 THEN
                    OE1WGA'TYP'APA = VAL(ENTRY[1,II-1])
                    OE1WGA'TYP'PLUS = VAL(ENTRY[I+II,-1])
                ENDIF
                IF TRH'APA'NO = OE1WGA'TYP'APA THEN
                    CALL CASH'IT
                ENDIF
                IF REPOSTING = 0 THEN
                        IF HDR'LIN'COM = 0 THEN
                                CALL DELETE'PIC
                                ENTRY = "Nothing on order to ship: "
                                \HDRERR
                                GOTO DO'ERR'OERCTL
![89] start;
                        ELSE
                                IF INC'INTERFACE = 6 THEN
                                        CALL VERIFY'SERIAL'NO
                                ENDIF
![89] end;
                        ENDIF
                ENDIF

                IF HDR'PROC # 6 AND HDR'PROC # 5 THEN
                    CALL GET'TRACK'NOS
                ENDIF
                PRGNAM(1) = ""
                PRGNAM(2) = "AR1OEU"
                FOR I = 1 TO 7
                        IF VIL'PRGNAM(I) # "" AND VIL'PRGNAM(I) # "NOTHIN" THEN
                                PRGNAM(I+2) = VIL'PRGNAM(I)
                        ELSE
                                PRGNAM(I+2) = "NADA"+STR(I)
                        ENDIF
                NEXT I
                PRGNAM(10) = "OEPQTY"
                PRGNAM(11) = "OEPDOC"
                IF IN2'WL'YN = "Y" THEN
                    XCALL GETENV,"WL_PRINT_ALL",ENTRY
                    IF ENTRY = "Y" THEN    !!Prints order and pick and docs
                        PRGNAM(12) = LOC'FORM(HDR'DOC'TYPE)
                    ELSE
                    IF ENTRY = "S" THEN    !!Prints order and docs (NO PICK)
                        PRGNAM(12) = LOC'FORM(HDR'DOC'TYPE)
                        PRGNAM(12)[-1,-1] = "Q"
                    ELSE
                        PRGNAM(12) = "NOTHIN"
                    ENDIF
                    ENDIF
                ELSE
                    PRGNAM(12) = LOC'FORM(HDR'DOC'TYPE)
                ENDIF
                PRGNAM(13) = "OEPBOX"
                PRGNAM(14) = "CHERYL"

                IF REPOSTING # 0 AND HDR'POST'LEVEL = 255 THEN          !![9]
                        FINISHED'WITH = 14
!!                      PRGNAM = "CHERYL"
                ELSE
!!                      FINISHED'WITH = 1
!!                      FOR I = 1 TO 14         !![11] - was to 12
!!                              IF PRGNAM(I) = HDR'PRGNAM THEN FINISHED'WITH = I
!!                      NEXT I
!!                      PRGNAM = HDR'PRGNAM                             !![32]
                        FINISHED'WITH = HDR'POST'LEVEL
                ENDIF
                IF JNL'WAS'USED = 2 AND ERROR'DID = JNL'DID THEN
!![61] - update = "Y" will now handle the case for no JNL record.
                        \VICS'START ACTION="SET'REPOST" UPDATE="Y"
                ELSE
                        \VICS'START ACTION="SET'REPOST"
                ENDIF
                IF CMN'FRM'PRGNAM[6;1] # "C" AND REPOSTING # 0 THEN
                        IF FINISHED'WITH > 2 AND FINISHED'WITH < 10 THEN
                                \SETKEY HDR MODE="KEY"
                                RDKEY HDR
                                IF HDR'CTL # 0 THEN
!!                                      ENTRY = "PRGNAM was: "+HDR'PRGNAM+" changed to OEPQTY! ("+STR(HDR'CTL)+")/("+STR(FINISHED'WITH)+")"
                                        ENTRY = "POST'LEVEL was: "+HDR'POST'LEVEL+" changed to OEPQTY! ("+STR(HDR'CTL)+")/("+STR(FINISHED'WITH)+")"
                                        CALL DO'ERRLO'OERCTL
                                        HDR'RCN = 0
                                        FINISHED'WITH = 10
                ENTRY = ENTRY +" finished with = "+FINISHED'WITH+" PRGNAM "+PRGNAM+" order "+HDR'NO
                \LABLOGGER ENTRY """/debug/oerctl_debug.DAILY"""  !![blm]
                                        CALL SET'HDR'PRGNAM
                                ENDIF
                        ENDIF
                ENDIF
                IF REPOSTING # 0 THEN
                        ENTRY = "Repost="+REPOSTING+" POST'LEVEL="+HDR'POST'LEVEL+" Finished="+FINISHED'WITH
                        \LABLOGGER ENTRY """/tmp/oerctl.txt"""    !!Malvern
                        CALL DO'ERRLO'OERCTL
                ENDIF
                !![99] This IF
!![16] BELOW needs <= 1 just like SLM's fix below for ar1oeu!!!
                IF WL'DEBUG # "" THEN
                    ENTRY = "CTP="+TRH'CTP'NO+" Finished="+FINISHED'WITH
                    CALL LOG'ENTRY
                ENDIF
                IF TRH'CTP'NO # 0 AND FINISHED'WITH <= 1 THEN
P4'PRE'AUTH:
                        CALL PRE'AUTHORIZE'CREDIT'CARD
                        ENTRY = "P4) "
                        CALL LOG'AUTH
P4'AUTH:
                        CC'RESPONSE = "Credit card declined, see credit manager!"
                        IF CC'FAILED = 1 THEN
                            ENTRY = CC'RESPONSE
                            \HDRERR
                            CALL SNDMON
P4'DECLINED:
                            RETURN    !!KLUDGE
                        ENDIF
                ENDIF
                IF HDR'OLD'DR # 0 OR HDR'OLD'CR # 0 THEN
                        IF FINISHED'WITH <= 1 CALL PRE'DO'AR1OEU
                ENDIF

                CALL SET'TRACK'NO
                MAP1 SET'TRACK,B,1
                MAP1 OE1WGA'WP'LOCATION,S,1
                IF OC2'TRACK'YN = "Y" AND UPC'TBL'NO # 0 AND &
                        FINISHED'WITH <= 1 THEN
                    IF HDR'SLOC = 0 AND VIA'MTYPE = "U" THEN
                        XCALL GETENV,"OE1WGA_WP_LOCATION",OE1WGA'WP'LOCATION
                        IF HDR'LOC'NO # OE1WGA'WP'LOCATION THEN
                            XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY
                            IF ENTRY # "" AND HDR'LOC'NO # STR(HDR'LOC'NO) THEN
                                CALL DELETE'PIC
                                ENTRY = "Invalid shipping location!"
                                \KERROR HDR MODE="D" CNO="N"
                                CALL DO'ERRL'OERCTL
                                GOTO ABORT
                            ENDIF
                        ENDIF
                    ELSE
                        UPDATE HDR FROM HDR'REC
                        SET'TRACK = HDR'SLOC
                    ENDIF
                ENDIF
                FINISHED'WITH = FINISHED'WITH MAX 2
                IF HDR'PROC < 5 THEN
                   IF FINISHED'WITH >= 10 THEN
                        HDR2'REC = HDR'REC
                        CALL LOCK'HHS
                   ENDIF
                   CALL SET'TOTALS
                   IF CALC'HTOTAL # 0 OR HDR'OLD'CASH # 0 OR HDR'OLD'CR # 0 THEN
                        TST'BAL = SGN(SKIP'HTOTAL)      !![87] - was = 1
                   ELSE
                        TST'BAL = 0                             !![36]
                   ENDIF
                   IF FINISHED'WITH >= 10 THEN
                        HDR'REC = HDR2'REC
                   ENDIF
                   IF OEC'INV'YN # "N" AND FINISHED'WITH < 9 THEN
                     I = 0
                     DO UNTIL I >= INC'MAX'VIA          !![28] (was >= 7)
                        I = I + 1
                        IF (I+1) < FINISHED'WITH REPEAT
                        FINISHED'WITH = FINISHED'WITH + 1
                        PRGNAM = VIL'PRGNAM(I)
                        IF PRGNAM = "" REPEAT
                        IF PRGNAM = "NOTHIN" REPEAT     !![28]
                        PRT'KSEQ = VIL'PRT'NO(I)
                        IF VIL'PRG'FLAG(I) = 1                          OR &
                           (VIL'PRG'FLAG(I) = 2 AND CALC'HTOTAL > 0     AND &
                            TRH'COD'STATUS # 1)                         OR &
                           (VIL'PRG'FLAG(I) = 3 AND (CALC'HTOTAL  <= 0  OR &
                            TRH'COD'STATUS = 1)) CALL PRT'LINK'IT
                        IF FAIL'LINK = 1 RETURN         !!KLUDGE
                     LOOP
                   ENDIF
                ENDIF
                FINISHED'WITH = FINISHED'WITH MAX 9
                IF FINISHED'WITH = 9 CALL SET'HDR'PRGNAM
!!CLEAR I PRIOR TO PROCESSING
                I = 0
                IF FINISHED'WITH = 9 THEN
                        PRGNAM = "OEPQTY"               !!POST IT
                        \VICS'START ACTION="SET'REPOST" UPDATE="Y"
                        CALL LINK'IT
                        FINISHED'WITH = 10
                        PRGNAM = "ARCHIV"                          !![32]
                        \VICS'START ACTION="SET'REPOST" UPDATE="Y"
                        IF FAIL'LINK = 1 THEN
                            ENTRY = "finished with = "+FINISHED'WITH+" PRGNAM "+PRGNAM+" fail link "+FAIL'LINK+" ORDER "+HDR'NO
                            \LABLOGGER ENTRY """/debug/oerctl_debug.DAILY"""  !![blm]
                            RETURN
                        ENDIF
                        CALL SET'HDR'PRGNAM
                ENDIF
                IF (PRGNAM # "GOODNO" OR REPOSTING = 1)                 AND &
                          HDR'PROC < 5 AND TST'BAL # 0 AND OEC'INV'YN # "N" THEN
                        IF FINISHED'WITH = 10 THEN
!![30] - below 'if' test added, plus the 'else' stuff.
!![46] - test reposting and internal below.
                                RDLOCK CUS
                                IF OEC'CRL'FLAG = 5 THEN        !![54] - below
                                        CUS'FAST'AR = CUS'FAST'AR + SKIP'HTOTAL !![46]
                                        UPDATE CUS FROM CUS'REC
                                ENDIF                           !![54] - above
!![87] - below tested HDR'SHP'TOTAL, now test TST'BAL
                                IF OEC'SKIPDOC # "Y" OR TST'BAL < 0       OR &
                                                        REPOSTING # 0     OR &
                                                        HDR'INTERNAL # 0  OR &
                                                        HDR'OLD'CASH # 0  OR &
                                                        HDR'OLD'DR # 0    OR &
                                                        HDR'OLD'CR # 0    OR &
                                                        QUEUE'EMPTY = 1   THEN
!![51] - queue empty, do OEPDOC.
                                        QUEUE'EMPTY = 0                 !![51]
                                        PRGNAM = "OEPDOC"
                                        CALL LINK'IT
                                        FINISHED'WITH = 11
                                        IF FAIL'LINK = 1 THEN
                                            ENTRY = "OPPDOC failed:"
                                            \HDRERR
                                            CALL SNDMON
                                            RETURN !!KLUDGE
                                        ENDIF
                                ELSE
                                        CALL LOCK'HHS
                                        CALL SKIPDOC
!!                                      HDR'PRGNAM = "OEPDOC"
                                        HDR'POST'LEVEL = 11
                                        UPDATE HHS FROM HDR'REC
                                ENDIF
                                REL CUS
                        ENDIF
                ENDIF
                FINISHED'WITH = FINISHED'WITH MAX 11
                CALL LOCK'HHS

\COPYF HDR OE EHDR MODE="DTA"
                EHDR'REC = HDR'REC

                IF FINISHED'WITH = 11 CALL SET'HDR'PRGNAM
        ENDIF
        PRGNAM = ""
        CASE
        IF THIS'ACTION = "P" THEN
           XCALL GETENV,"WL_SKIPDOCS",ENTRY
           IF FINISHED'WITH = 11 AND ENTRY # "Y" THEN    !!wldq2f sets to Y
                IF OEC'INV'YN # "N" THEN
                        PRGNAM = LOC'FORM(HDR'DOC'TYPE)
                                        !!INVOICE
                        !![109] Added option to set from NOP
                        IF HDR'VIA'NO >= OEC'SCUS'VIA AND HDR'VIA'NO <= &
                        OEC'ECUS'VIA AND LOC'PRT'NOP(HDR'DOC'TYPE) # 0 THEN
                                PRT'KSEQ = LOC'PRT'NOP(HDR'DOC'TYPE)
                        ELSE
                                PRT'KSEQ = LOC'PRT'NO(HDR'DOC'TYPE)
                        ENDIF
                ELSE
                        PRGNAM = "NOTHIN"
                ENDIF
           ELSE
                PRGNAM = "NOTHIN"
           ENDIF
        ELSE

        IF THIS'ACTION = "E" THEN
                                                !!PICKING TICKET
!![2] Redid below
                \COPYF LOC IN LOC9 MODE="PRI"
                MAP1 SECOND'PASS
                        MAP2 SECOND'FLAG,S,3
                        MAP2 SECOND'LOC'NO,B,2
                        MAP2 SECOND'OEW'DID,S,6
                        MAP2 SECOND'OEW'KID,S,6
P5'PICK'AUTH:
                CALL PICK'AUTHORIZE'CREDIT'CARD
                ENTRY = "P5) "
                CALL LOG'AUTH
P5'AUTH:
                IF CC'FAILED = 1 THEN
                    IF CC'RESPONSE = "" THEN
                        CC'RESPONSE = "Credit card declined, see credit manager!"
                    ENDIF
P5'DECLINED:
                    RETURN    !!KLUDGE
                ENDIF
!!Could print HOB here if you wanted.

                LOC9'REC = LOC'REC
                LOC9'PKT = LOC'PKT
                DO
                        IF SECOND'FLAG = "YES" THEN
                                IF LOC'KNO # SECOND'LOC'NO THEN
                                        LOC'KNO = SECOND'LOC'NO
                                        USE LOC INTO LOC'REC KEY LOC'KEY
                                ENDIF
                        ENDIF
                        PRGNAM = LOC'FORMT(HDR'DOC'TYPE)
                        PRT'KSEQ = LOC'PRT'NOT(HDR'DOC'TYPE)
                        CALL PRT'LINK'IT
                        GETCMN SECOND'PASS
                LOOP UNTIL SECOND'FLAG # "YES" OR FAIL'LINK = 1
                PRGNAM = "NOTHIN"
                LOC'REC = LOC9'REC
                LOC'PKT = LOC9'PKT
!![2] Redid above
        ELSE
        IF THIS'ACTION = "L" THEN
                PRGNAM = LOC'FORML(HDR'DOC'TYPE)
                                !!ORDER/ACKNOWLEDGEMENT
                PRT'KSEQ = LOC'PRT'NOL(HDR'DOC'TYPE)
        ELSE
        IF THIS'ACTION = "U" THEN
                PRGNAM = LOC'FORMA(HDR'DOC'TYPE)
                                !!PACKING SLIP
                PRT'KSEQ = LOC'PRT'NOA(HDR'DOC'TYPE)
        ENDCASE
        IF PRGNAM = "" THEN
                ENTRY = "Print program blank: "
                \HDRERR
                ENTRY = ENTRY + ":" + THIS'ACTION + " Loc=" + LOC'NO
                CALL DO'ERR'OERCTLL
        ELSE
                CALL PRT'LINK'IT
                IF FAIL'LINK = 1 RETURN                 !!KLUDGE
                IF THIS'ACTION = "P" THEN
                   FINISHED'WITH = FINISHED'WITH MAX 12
                   CALL SET'HDR'PRGNAM
                ENDIF
                IF THIS'ACTION = "P" THEN
                        IF OEC'BLOW'BOX = "Y" AND OC2'UPSONL'YN # "Y" AND &
                                   OEC'INV'YN # "N" AND HDR'PROC < 5 THEN
                           IF FINISHED'WITH = 12 THEN
                                PRGNAM = "OEPBOX"
                                CALL LINK'IT
                                IF FAIL'LINK = 1 RETURN         !!KLUDGE
                           ENDIF
                        ENDIF
                        FINISHED'WITH = FINISHED'WITH MAX 13
                        CALL SET'HDR'PRGNAM
                        CALL PRE'DO'EMAIL
                ELSE
!                       IF THIS'ACTION = "E" CALL PRE'DO'EMAIL
                        CALL PRE'DO'EMAIL
                ENDIF
        ENDIF
RETURN

!![99] This routine
MAP1 CC'FAILED,B,1
LCL1 TTY,S,30
\COPYF ATQ CV
\COPYF PAC AR
\COPYF AAF WB
\COPYF CTP AR MODE="PRI"
COPYF "ATQFIL[CV]",=ZZZQ,NOAFR
MAP1 ZZZ,F
MAP1 REAUTH,B,1
MAP1 DOING'MSG,B,1
MAP1 DOING'MSG'SUBJECT,S,100
MAP1 DOING'MSG'BODY,S,200

AUTHORIZE'CREDIT'CARD:
    ETIME = 0
    ENTRY = "Begin credit card auth"
    \HDRERR
    CALL SNDMON
AUTH'CC2:
    CALL AUTHORIZE'CREDIT'CARD2
    IF CC'FAILED # 0 AND WBC'USE'QMAIL = "Y" AND WBC'QMAIL'MSG = "Y" THEN
        DOING'MSG = 1
        ENTRY = "Credit Card Hold on PO: "+HDR'PO+" order: "
        \KERROR HHS MODE="D" ALTPRE="HDR" APID="OE"
        DOING'MSG'SUBJECT = ENTRY
        DOING'MSG'BODY = "Credit card response was: "+CC'RESPONSE
        CALL PRE'DO'EMAIL
        DOING'MSG = 0
    ENDIF
    ENTRY = "Authorize credit card: "
    \KERROR HDR MODE="D" APID="OE" CNO="N"
    ENTRY = ENTRY + " hold="+HDR'HOLD'YN+" CC="+CC'FAILED
    IF CC'FAILED # 0 THEN
        ENTRY = "FAILED: "+ENTRY
    ELSE
        ENTRY = "Completed"
    ENDIF
    ENTRY = ENTRY + " Auth time: "+STR(ETIME)
    \HDRERR
    CALL SNDMON
    IF WL'DEBUG # "" THEN
        \ABLOGGER ENTRY WL'DEBUG
    ENDIF
AUTH'CC'RET:
RETURN

AUTHORIZE'CREDIT'CARD2:
        IF WL'DEBUG # "" THEN
            ENTRY = "Authorize Credit Card"
            CALL LOG'ENTRY
        ENDIF
        REAUTH = REPOSTING
        CC'FAILED = 0
        CTP'KNO = TRH'CTP'NO


        USE CTP INTO CTP'REC KEY CTP'KEY
        IF CTP'CTL # 0 THEN
            ENTRY = "Credit card type for this order not found! "
            \KERROR HDR MODE="D"
            CC'RESPONSE = ENTRY
            CALL DO'ERR'OERCTLL
            CC'FAILED = 1
            IF WL'DEBUG # "" THEN
                ENTRY = "Credit card type not found: "
                \KERROR HDR MODE="D" APID="OE" CNO="N"
                ENTRY = ENTRY + " hold="+HDR'HOLD'YN+" CC="+CC'RESPONSE
                \ABLOGGER ENTRY WL'DEBUG
            ENDIF
AUTH'CC2'FAILED'RET:
            RETURN
        ENDIF

        \UCNVATQ AKEY="Y"
        RDLOCK ATQT INTO ATQ'REC KEY ATQT'KEY
LU'AUTH'0:
!![WC] - Track the ATQT record
        IF ATQT'CTL = 0 THEN
            ENTRY = ""
            \KERROR ATQT MODE="K" APID="CV"
            ENTRY = "(LU'AUTH'0: "+ENTRY+")"
            \CNV'DTT ATQ'APP'DTT XDAYS
            \S'TO'JUL'HMS YDAYS HMS
            ENTRY = ENTRY +" AMT="+ATQ'AMT+" STAT="+ATQ'STATUS+" HRS="+ATQ'HRS+" CTL="+ATQT'CTL+" APP'DYS="+XDAYS+" TODYS="+YDAYS
            CALL LOG'AUTH
        ENDIF

        IF ATQT'CTL # 0 THEN
            IF ATQT'KSOURCE = "OE" THEN
                ATQT'KSOURCE = "WB"
            ELSE
                ATQT'KSOURCE = "OE"
            ENDIF
            RDLOCK ATQT INTO ATQ'REC KEY ATQT'KEY
LU'AUTH'1:
!![WC] - Track the ATQT record
            ENTRY = ""
            \KERROR ATQT MODE="K" APID="CV"
            ENTRY = "[LU'AUTH'1: "+ENTRY+"]"
            \CNV'DTT ATQ'APP'DTT XDAYS
            \S'TO'JUL'HMS YDAYS HMS
            ENTRY = ENTRY +" AMT="+ATQ'AMT+" STAT="+ATQ'STATUS+" HRS="+ATQ'HRS+" CTL="+ATQT'CTL+" APP'DYS="+XDAYS+" TODYS="+YDAYS
            CALL LOG'AUTH

            IF ATQT'CTL = 0 THEN
                ENTRY = "Source now "+ATQT'KSOURCE+" on "
                \KERROR HDR MODE="D" CNO="N"
                CALL DO'ERRLO'OERCTL
!![WC]          CALL DO'ERRL
            ELSE

!![wc]
SCAN'VD'ATQ:
                CALL SCAN'VOID'ATQ        !![WC] See CCANET.CPY
                RDLOCK ATQT INTO ATQ'REC KEY ATQT'KEY
                IF ATQT'CTL = 0 THEN
                    ENTRY = "Used VOID Source now "+ATQT'KSOURCE+" on "
                    \KERROR HDR MODE="D" CNO="N"
                    CALL DO'ERRLO'OERCTL
!![WC]              CALL DO'ERRL
                ENDIF
                XCALL GIN,"SCAN'VOID: "+ENTRY
            ENDIF
        ENDIF
        IF THIS'ACTION # "P" THEN
            \HDRSUM HDR BALANCE="ATQ'AMT"
            JJ = ATQ'AMT
            IF CVC'FUDGE'PERC > 10000 THEN
                \FROUND (ATQ'AMT*CVC'FUDGE'PERC/100/100) ATQ'AMT
            ENDIF
            IF (ATQ'AMT-JJ) < MIN'CCFRT THEN
                ATQ'AMT = JJ + MIN'CCFRT
            ENDIF
        ENDIF
        MIN'CCFRT = 0
        ENTRY = "Y4) ATQ ETRON="+ATQ'ELECTRONIC+" AMT="+ATQ'AMT+" STAT="+ATQ'STATUS+" "
        CALL LOG'AUTH
Y4'AUTH:
        IF WL'DEBUG # "" THEN
            CALL LOG'ENTRY
        ENDIF
        IF ATQ'ELECTRONIC = "Y" AND ATQ'AMT > 0 THEN
                \S'TO'U
!![WC] If ANET Active and ATQ is VISANET skip test for time

                IF ATQ'STATUS = "A" OR ATQ'STATUS = "P" THEN
                    \WHATCC ATQ'CARDNO JJ
                    CASE
                    IF JJ = 1 OR JJ = 2 THEN
                        JJ = CVC'VISA'HOURS
                    ELSE
                    IF JJ = 3 THEN
                        JJ = CVC'AMEX'HOURS
                    ELSE
                    IF JJ = 5 THEN
                        JJ = CVC'DISC'HOURS
                    ELSE
                        CC'FAILED = 1
                        ENTRY = "Invalid card type2!"+ATQ'CARDNO
                        CC'RESPONSE = ENTRY
                        GOTO DO'ERR'OERCTL
                    ENDCASE

                    \CNV'DTT ATQ'APP'DTT XDAYS !! Approval Days
                    \S'TO'JUL'HMS YDAYS HMS    !! Today Days

                    !! Calculated the number of hours since authorization approval
                    !! ATQ'HRS = approval hour of the day  HRS = today's hour of the day
!!old               XDAYS = ((YDAYS-XDAYS)*24) - ATQ'HRS + HRS + 1
                    ELAPSED'HRS = ((YDAYS-XDAYS)*24) - ATQ'HRS + HRS + 1

!!                  CALL DO'ERRL            !![WC]

                    !! Old VICS CC retrieving the CC CVV value during the session
                    !! We are not saving this information anymore when we started using Authorized.net
!!                  GETPROFILE'TMP = "C"+STR(ATQ'CARDNO)
!!                  XCALL GETENV,GETPROFILE'TMP,ENTRY
!!                  IF ENTRY = "" AND JJ # 0 THEN
!!                      ENTRY = STR(ATQ'MAGIC)
!!                  ENDIF
!!                  IF VAL(ENTRY) = 0 THEN ENTRY = ""

Z1'AUTH:
                    ENTRY = "Z1) Grace Period: ATQ APP'DYS="+XDAYS+" TDYS="+YDAYS+" ATQ'HRS="+ATQ'HRS+" TDHRS="+HRS+" CALC'HRS="+ELAPSED'HRS+" CV'HRS="+CVC'HOURS+" RP="+REPOSTING
                    CALL LOG'AUTH
!![WC] old          IF XDAYS <= CVC'HOURS AND ENTRY = "" AND &
!![WC] old                   REPOSTING = 0 AND ATQ'HRS # 99 THEN

                    !! Removed test condition for MAGIC Value (ENTRY)
                    !! The authorization record has been previously approved and the MAGIC value will always be zero
                    !! after processing by Authorized.net
                    !!
                    !! CV'HOURS = Number of hours to keep authorization?: 240
                    !! New Reauthorization test
                    IF ELAPSED'HRS <= CVC'HOURS AND REPOSTING = 0 AND ATQ'HRS # 99 THEN

Y1'AUTH:                !!Authorization still good, and we don't have cvv2 and not reposting
                        ENTRY = "Y1) "
                        CALL LOG'AUTH

                        RETURN                                !!KLUDGE
                    ELSE
Y2'AUTH:                !!re-do the auth because we have a cvv2 or the auth is too old or reposting
                        ENTRY = "Y2) Grace Period Failed: ATQ APP'DYS="+XDAYS+" TDYS="+YDAYS+" ATQ'HRS="+ATQ'HRS+" TDHRS="+HRS+" CALC'HRS="+ELAPSED'HRS+" CV'HRS="+CVC'HOURS+" RP="+REPOSTING
                        CALL LOG'AUTH
                        REAUTH = 1
                    ENDIF
                ENDIF
        ENDIF
        ATQ'RCN = ATQT'RCN
        IF ATQT'CTL # 0 THEN
            ENTRY = "Credit card authorization record not found! "
            \KERROR HDR MODE="D"
            ENTRY = ENTRY +"/"
            \KERROR ATQT MODE="K" APID="CV"
            CALL SNDMON
            CC'RESPONSE = ENTRY
            CALL DO'ERR'OERCTLL
            CC'FAILED = 1
            IF WL'DEBUG # "" THEN
                ENTRY = "Authorization record not found "
                \KERROR HDR MODE="D" APID="OE" CNO="N"
                ENTRY = ENTRY + " hold="+HDR'HOLD'YN+" CC="+CC'RESPONSE
                \ABLOGGER ENTRY WL'DEBUG
            ENDIF
AUTH'CC2'ATQ'NF'RET:
            RETURN
        ENDIF
!![103] - added checks below
        \CHKKEY ATQT LASTFIX="SPECIAL" APID="CV"
        IF ATQT'CTL # 0 THEN
            ENTRY = "Credit card authorization record INVALID! "
            \KERROR HDR MODE="D"
            ENTRY = ENTRY +"/"
            \KERROR ATQT MODE="K" APID="CV"
            CC'RESPONSE = ENTRY
            CALL DO'ERR'OERCTLL
            CC'FAILED = 1
            IF WL'DEBUG # "" THEN
                ENTRY = "Authorization record invalid :"
                \KERROR HDR MODE="D" APID="OE" CNO="N"
                ENTRY = ENTRY + " hold="+HDR'HOLD'YN+" CC="+CC'RESPONSE
                CALL SNDMON
                \ABLOGGER ENTRY WL'DEBUG
            ENDIF
AUTH'CC2'ATQ'INVD'RET:
            RETURN
        ENDIF
        \SETKEY ATQ MODE="KY2" APID="CV" BAD1="ATQT"
        ZZZQ'REC = ATQ'REC

        !![6] Next IF
        IF HDR'OLD'CASH # 0 THEN
            CALL VERIFY'OLD'CASH
        ENDIF

        CASE
        IF ATQ'AMT > 0 THEN
            ATQ'TRX'CODES = CTP'DEB'SET
            ATQ'TRX'CODEA = CTP'DEB'AUTH
        ELSE
        IF ATQ'AMT < 0 THEN
            ATQ'TRX'CODES = CTP'CRE'SET
            ATQ'TRX'CODEA = CTP'CRE'AUTH
        ELSE
        IF HDR'SHP'TOTAL > 0 THEN
            ATQ'TRX'CODES = CTP'DEB'SET
            ATQ'TRX'CODEA = CTP'DEB'AUTH
        ELSE
        IF HDR'SHP'TOTAL < 0 THEN
            ATQ'TRX'CODES = CTP'CRE'SET
            ATQ'TRX'CODEA = CTP'CRE'AUTH
        ELSE
            CALL DELETE'PIC
            ENTRY = "Amount INVALID on authorize!"
            \HDRERR
            CALL DO'ERR'OERCTLL
            GOTO ABORT
        ENDCASE
        ATQT2'RCN = 0
        IF ATQ'ELECTRONIC = "N" AND ATQ'APPROVAL # "" THEN
            ATQ'STATUS = "A"
        ENDIF
        IF ATQ'AMT < 0 THEN
                IF ATQ'OSPECIAL # "" THEN
                    ATQT2'KEY = ATQT'KEY
                    ATQT2'KSPECIAL = ATQ'OSPECIAL
                    RDLOCK ATQT2 INTO ATQ2'REC KEY ATQT2'KEY
                        !![108] Added key checking stuff.
                    \CHKKEY ATQT LASTFIX="SPECIAL" APID="CV" ALTPRE="ATQ2" ALTKEY="ATQT2"
                    IF ATQT2'CTL # 0 AND ATQT2'KSOURCE = "OE" THEN
                        ATQT2'KSOURCE = "WB"
                        RDLOCK ATQT2 INTO ATQ2'REC KEY ATQT2'KEY
                        \CHKKEY ATQT LASTFIX="SPECIAL" APID="CV" ALTPRE="ATQ2" ALTKEY="ATQT2"

!![WC]                  IF ATQT2'CTL # 0 THEN
!!                          ATQT'KEY = ATQT2'KEY
!!                          CALL SCAN'VOID'ATQ
!!                          ATQT2'KSOURCE = ATQT'KSOURCE
!!                          RDLOCK ATQT2 INTO ATQ2'REC KEY ATQT2'KEY
!!                          \CHKKEY ATQT LASTFIX="SPECIAL" APID="CV" ALTPRE="ATQ2" ALTKEY="ATQT2"
!!                      ENDIF
                    ENDIF
                    ATQ2'RCN = ATQT2'RCN
                    IF ATQT2'CTL # 0 THEN
                        RDKEY ATQT2
                        CALL DELETE'PIC
                        IF ATQT2'CTL = 0 THEN
                            ENTRY = "Credit card authorization record INVALID! - Rebuild ATQ keys!"
                        ELSE
                            ENTRY = "Can't find DR! "+ATQT2'KSPECIAL
                        ENDIF
                        CALL DO'ERR'OERCTLL
AUTH'CC2'ATQ'INVD'ABORT:
                        GOTO ABORT
                    ENDIF
                ELSE
                    IF ATQ'AMT # 0 THEN             !![6]
                        CALL DELETE'PIC
                        ENTRY = "Original debit not marked!"
                        CALL DO'ERR'OERCTLL
                        GOTO ABORT
                    ENDIF                           !![6]
                ENDIF
                IF ATQ'AMT = 0 THEN
                    ATQ'AMT = -ATQ2'AMT
                ENDIF
                !!This is a credit for a settled debit -
                !!so we just mark authorized.
                IF ATQ2'STATUS = "P" OR CTP'CRE'AUTH = "NO" THEN
                    ATQ'STATUS = "A"
                    ATQ'RESPONSE = "CR"
                    ATQ'APPROVAL = "AUTONO"
                    ATQ'RMSG = "No auth needed"
                    ATQ'ELECTRONIC = "Y"
                    \SET'TIME ATQ'APP'TIM
                    ATQ'ATHDT = DATE
                    ATQ'DEST = ""
                    VINVOICE = HDR'NO
                    RSEQ = SPACE(80)
                    ATQ'RSEQ = VINVOICE[-LEN(RSEQ),-1]
                    ATQ'AUTH'QID = LOC'AUTH'QID
!![wc] XCALL GIN,"ATQ'AMT="+ATQ'AMT+" ATQ'STATUS="+ATQ'STATUS+" ATQ'APPROVAL="+ATQ'APPROVAL
                ENDIF
        ENDIF
        ENTRY = "P7) "
        CALL LOG'AUTH
P7'AUTH:
        IF ZZZQ'REC # ATQ'REC THEN
            UPDATE ATQT FROM ATQ'REC
            ATQ'RCN = ATQT'RCN                              !![108]
            \UPDKEY ATQ MODE="KY2" APID="CV" BAD1="ATQT"
            ZZZQ'REC = ATQ'REC
            ENTRY = "P8) "
            CALL LOG'AUTH
P8'AUTH:
        ENDIF
        IF WL'DEBUG # "" THEN
            ENTRY = "ATQ ELECTRONIC="+ATQ'ELECTRONIC
            CALL LOG'ENTRY
        ENDIF

        CASE
        !!If for zero amount (due to cash applied perhaps), do nothing.
        !![6] Next IF
        IF ATQ'AMT = 0 THEN
            IF ATQT2'RCN # 0 THEN
                REL ATQT2
            ENDIF
            RETURN
        ELSE
        !!Not ready for authorization.
        IF ATQ'ELECTRONIC # "Y" AND ATQ'STATUS # "A" AND ATQ'STATUS # "P" THEN
                ENTRY = "This credit card order not yet approved.  Aborting."
                \KERROR HDR MODE="D"
                ENTRY = ENTRY +"/"
                \KERROR ATQT MODE="K" APID="CV"
                CC'RESPONSE = ENTRY
                CALL DO'ERR'OERCTLL
                CC'FAILED = 1
                IF ATQT2'RCN # 0 THEN
                        REL ATQT2
                ENDIF
AUTH'CC2'ATQ'UNAPR'RET:
                RETURN
        ELSE
        !!Already authorized/paid, must be in repost or it was authorized
        !!in WGA by the user, or is a credit just marked as authorized.
        IF ATQ'ELECTRONIC # "Y" OR (ATQ'AMT < 0 AND (ATQ'STATUS = "A" OR &
                                        ATQ'STATUS = "P")) THEN
                IF ATQT2'RCN # 0 THEN
                        REL ATQT2
                ENDIF
AUTH'CC2'ATQ'APPR'RET:
                RETURN
        ELSE
        !!Has not passed initial verification.
        IF (ATQ'STATUS # "U" OR (ATQ'VSTATUS # "P" AND HDR'HOLD'YN # "O")) AND &
                    REAUTH # 1 AND REPOSTING # 1 THEN
                ENTRY = "This credit card order has not yet been verified.  Aborting."
                \KERROR HDR MODE="D"
                CC'RESPONSE = ENTRY
                CALL DO'ERR'OERCTLL
                CC'FAILED = 1
                IF ATQT2'RCN # 0 THEN
                        REL ATQT2
                ENDIF
AUTH'CC2'ATQ'NOT'VER'RET:
                RETURN
        ELSE
        IF ATQ'APPROVAL # "" AND REAUTH # 1 AND REPOSTING # 1 THEN
                ENTRY = "This credit card order has an approval code, but it not marked as authorized."
                \KERROR HDR MODE="D"
                ENTRY = ENTRY +"/"
                \KERROR ATQT MODE="K" APID="CV"
                CC'RESPONSE = ENTRY
                CALL DO'ERR'OERCTLL
                CC'FAILED = 1
                IF ATQT2'RCN # 0 THEN
                        REL ATQT2
                ENDIF
AUTH'CC2'ATQ'UNAUTH'RET:
                RETURN
        ELSE
        IF (ATQ'APPROVAL = "" OR ATQ'RESPONSE = "") AND REAUTH # 1 AND &
                            REPOSTING # 1 AND ATQ'STATUS = "A" THEN
                ENTRY = "This credit card order has no approval code, but it is marked as authorized."
                \KERROR HDR MODE="D"
                ENTRY = ENTRY +"/"
                \KERROR ATQT MODE="K" APID="CV"
                CC'RESPONSE = ENTRY
                CALL DO'ERR'OERCTLL
                CC'FAILED = 1
                IF ATQT2'RCN # 0 THEN
                        REL ATQT2
                ENDIF
AUTH'CC2'ATQ'UNAPPR'RET:
                RETURN
        ELSE
                !!All systems go - Authorize

!![WC]    Add subroutine to check for old visanet
!![WC]    If ANET and ATQ is ANET then VOID previous Authorization in ANET
                IF ATQ'PPI = "YES" AND ATQ'STATUS = "A"
                    !![WC] We have an authorization by ANET
                    CALL REAUTH'VOID
                    !![WC] get new ATQ record for Authorization

                    \UCNVATQ AKEY="Y"
                    RDLOCK ATQT INTO ATQ'REC KEY ATQT'KEY

                ENDIF

                ATQ'RCN = ATQT'RCN
                \SETKEY ATQ MODE="KY2" APID="CV" BAD1="ATQT"
\COPYF ATQ CV ATQ2
!![101] - re-wrote all key logic ... for credits
!!        also set amount from atq2
                ATQ'ELECTRONIC = "Y"
                ATQ'CTP'NO = TRH'CTP'NO
                ATQ'RESPONSE = ""
                ATQ'STATUS = "U"
                ATQ'APPROVAL = ""
                ATQ'ATHID = UB'UID
                ATQ'ATHDT = DATE
                \SET'TIME ATQ'ATHTM
                \GETPID ATQ'JOBNUM
                IF REAUTH # 0 THEN
                    IF ATQ'AMT < 0 THEN
                        ATQ'TRX'CODEA = CTP'CRE'REAUTH
                    ELSE
                        ATQ'TRX'CODEA = CTP'DEB'REAUTH
                    ENDIF
                ENDIF
                UPDATE ATQT FROM ATQ'REC
                ENTRY = "A3) "
                CALL LOG'AUTH
A3'AUTH:
                ATQ'RCN = ATQT'RCN                              !![108]
                \UPDKEY FILE="ATQ" MODE="KY2" APID="CV" BAD1="ATQT"
                MAP1 CC'RESPONSE,S,25
                ETIME = 0

!![WC] Create logic to switch between VISANET and ANET
                IF PPI'ACTIVE = "AN" THEN
                    !![WC] Record TCP messages in ABLOGFILE do not display on screen
                    XCALL PUTENV,"DOTCP_DISPLAY=A"
P1'AUTH'CALL:
                    \ANAUTH LOCPRE="LOC" SAVE'CV'RESPONSE="CC'RESPONSE" TIME'WANTED="ETIME"
                ELSE
                    !![WC] fix dup maps in ANAUTH
                    !![WC] \VAUTH LOCPRE="LOC" SAVE'CV'RESPONSE="CC'RESPONSE" TIME'WANTED="ETIME"
                ENDIF
                ENTRY = "P1) "
                CALL LOG'AUTH
P1'AUTH:
                !!If authorizing a credit, mark both the credit and the
                !!original debit as settled.
                IF ATQ'AMT < 0 AND ATQ'STATUS = "A" THEN
                        ATQ'STATUS = "P"
                        ATQ'PAYID = UB'UID
                        ATQ'PAYDT = DATE
                        \SET'TIME ATQ'PAYTM
                        UPDATE ATQT FROM ATQ'REC
                        ENTRY = "P3"
                        CALL LOG'AUTH
P3'AUTH:
                        ATQ'RCN = ATQT'RCN                      !![108]
                        \UPDKEY FILE="ATQ" MODE="KY2" APID="CV" BAD1="ATQT"
!!Done with credit, start on debit
                        ATQ2'RCN = ATQT2'RCN                    !![108]
                        \SETKEY ATQ ALTPRE="ATQ2" ALTKEY="ATQ2" &
                                MODE="KY2" APID="CV" BAD1="ATQT"
                        \DELKEY ATQ ALTPRE="ATQ2" ALTKEY="ATQ2" &
                                MODE="KY2" APID="CV" BAD1="ATQT"
                        ATQ2'STATUS = "P"
                        ATQ2'PAYID = UB'UID
                        ATQ2'PAYDT = DATE
                        \SET'TIME ATQ2'PAYTM
                        \SETKEY ATQ ALTPRE="ATQ2" ALTKEY="ATQ2" &
                                MODE="KY2" APID="CV" BAD1="ATQT"
                        \ADDKEY ATQ ALTPRE="ATQ2" ALTKEY="ATQ2" &
                                MODE="KY2" APID="CV" BAD1="ATQT"
                        WRITE ATQT2 FROM ATQ2'REC
                ELSE
!!Just update and fix keys
                        UPDATE ATQT FROM ATQ'REC
                        ATQ'RCN = ATQT'RCN                      !![108]
                        \UPDKEY FILE="ATQ" MODE="KY2" APID="CV" BAD1="ATQT"
                        ENTRY = "P2) "
                        CALL LOG'AUTH
P2'AUTH:
                ENDIF
                IF ATQ'STATUS # "A" AND ATQ'STATUS # "P" THEN !![101] Added "P"
                        IF CC'RESPONSE = "" THEN
                            CC'RESPONSE = "CC Status problem"
                        ENDIF
                        CC'FAILED = 1
                ENDIF
        ENDCASE
AUTH'CC2'DONE'RET:
RETURN

!![6] Next routine
MAP1 APPLY'AMT,B,5
VERIFY'OLD'CASH:
        APPLY'AMT = HDR'OLD'CASH
        DOCO'RCN = 0
        DOCO'KHDR'LOC'NO = HDR'LOC'NO
        DOCO'KDOC'TYPE = 1
        DOCO'KHDR'NO = HDR'NO
        DOCO'KSHIPMENT = 0
        USE DOCO INTO DOC'REC KEY DOCO'KEY
        DO
                GETNXT DOCO INTO DOC'REC
                \CHKKEY DOCO APID="AR"
                IF DOCO'CTL # 0 OR (DOC'TYPE = 1 AND DOC'YEAR = 1) EXIT
        LOOP
        IF DOCO'CTL = 0 THEN
                \SETKEY DOCA MODE="KEY" APP="AR"
                DOCA'KSEQ = 1                   !!Skip type 1
                USE DOCA INTO DOC'REC KEY DOCA'KEY
                DO
                        GETNXT DOCA INTO DOC'REC
                        \CHKKEY DOCA APID="AR"
                        IF DOCA'CTL # 0 EXIT
                        IF SGN(DOC'AMT) # SGN(APPLY'AMT) REPEAT
                        IF DOC'STAT # "U" AND DOC'STAT # "" REPEAT
                        IF ABS(APPLY'AMT) <= ABS(DOC'AMT) THEN
                                APPLY'AMT = 0
                        ELSE
                                APPLY'AMT = APPLY'AMT - DOC'AMT
                        ENDIF
                LOOP UNTIL APPLY'AMT = 0
        ENDIF
        HDR'OLD'CASH = HDR'OLD'CASH - APPLY'AMT
        ATQ'AMT = ATQ'AMT + APPLY'AMT
RETURN

\COPYF LST MC LST2

!![99] This routine
SET'REQUEST'REC:
        REQUEST'SPACE = SPACE
        CASE
        IF HDR'VIA'NO >= OEC'SCUS'VIA AND HDR'VIA'NO <= OEC'ECUS'VIA THEN
            VMECI = " "
        ELSE
        IF HDR'CRID[1;2] = "WB" THEN
            VMECI = CVC'WB'MECI
            IF VMECI = "" THEN VMECI = "2"
        ELSE
            VMECI = CVC'OE'MECI
            IF VMECI = "" THEN VMECI = "2"
        ENDCASE
        VLOC'NO = LOC'NO
        VLOC'DESC = LOC'SDESC
        \USELST LOC'NO ALTPRE="LST2" ALTKEY="LST2"
        VLOC'STATE = LST2'ST
        VLOC'ZIP = LST2'ZIP
        XCALL GETENV,"FLPCTL_TTY",TTY
        IF INSTR(1,TTY,"tty") # 0 THEN
                VTERM'ID = TTY[INSTR(1,TTY,"tty")+1,-1]
        ENDIF
        VKEY = (ATQ'CNO USING "#Z")+ATQ'SOURCE+ATQ'SPECIAL
        VINVOICE = HDR'NO
        VTRX'CODE = ATQ'TRX'CODEA                       !![101]
!![101] IF ATQ'AMT >= 0 THEN
!!              VTRX'CODE = CTP'DEB'AUTH
!!      ELSE
!!              VTRX'CODE = CTP'CRE'AUTH
!![101] ENDIF
        IF ATQ'AMT < 0 THEN
                VORG'RESP = ATQ2'RESP                   !![101]
        ENDIF
        \CARDNO ATQ'CARDNO VCARD
        VEXPDTT = ATQ'EXP
        PAC'KLST'NO = HDR'NAM'NO
        IF HDR'NAM'NO = OEC'CAN'LST'NO THEN             !![104] - this stuff.
                COPYF "MSGFIL[SY]",NOAFR
                IF HDR'MSGNO = 0 THEN
                        ENTRY = "INVALID MSG PTR ON CANCEL/REPLACE!"
                        \HDRERR
                        CALL DO'ERR'OERCTLL
                ELSE
                        MSG'DID = "OEMSG"
                        MSG'SPACE = SPACE
                        USE MSG HDR'MSGNO INTO MSG'REC
                        DO
                                FLAG = INSTR(1,UCS(MSG'DATA[1;15]),"CANCEL/REPLACE:")
                                IF FLAG # 0 THEN
                                        PAC'KLST'NO = VAL(MSG'DATA[FLAG+15,-1])
                                ELSE
                                        IF MSG'CH = 0 EXIT
                                        USE MSG MSG'CH INTO MSG'REC
                                ENDIF
                        LOOP UNTIL MSG'CTL # 0 OR FLAG # 0
                        IF FLAG = 0 OR PAC'KLST'NO = 0 THEN
                                ENTRY = "INVALID MSG DATA ON CANCEL/REPLACE!"
                                \HDRERR
                                CALL DO'ERR'OERCTLL
                        ENDIF
                ENDIF
        ENDIF
        PAC'KCTP'NO = TRH'CTP'NO
        PAC'KCARDNO = VCARD
        PAC'KEXP = ATQ'EXP
        USE PAC INTO PAC'REC KEY PAC'KEY
        IF PAC'CTL = 0 THEN
                VCARD'ADDRESS = PAC'ADDRESS
                VCARD'ZIP = PAC'ZIP

                \WHATCC ATQ'CARDNO JJ
                CASE
                IF JJ = 1 OR JJ = 2 THEN
                    JJ = CVC'VISA'HOURS
                ELSE
                IF JJ = 3 THEN
                    JJ = CVC'AMEX'HOURS
                ELSE
                IF JJ = 5 THEN
                    JJ = CVC'DISC'HOURS
                ELSE
                    CC'FAILED = 1
                    ENTRY = "Invalid card type3!"+ATQ'CARDNO
                    CC'RESPONSE = ENTRY
                    GOTO DO'ERR'OERCTL
                ENDCASE
                MAP1 MEM'CVV2,S,4
                \CARDNO ATQ'CARDNO ENTRY
                ENTRY = "C"+ENTRY
                XCALL GETENV,ENTRY,MEM'CVV2

!!              XCALL GIN, "What is MEM'CVV2=["+MEM'CVV2+"] MAGIC="+ATQ'MAGIC+" SOURCE="+ATQ'SOURCE
                MEM'CVV2 = STR(ATQ'MAGIC)  !![WC] Force MEM'CVV2
                IF MEM'CVV2 = "" AND JJ # 0 THEN
                    MEM'CVV2 = STR(ATQ'MAGIC)
                ENDIF
                IF (PAC'CVV2'TYPE = "1" OR PAC'CVV2'TYPE = "2") AND &
                                                        MEM'CVV2 # "" THEN
                    VCVV2 = MEM'CVV2
                    VCVV2'TYPE = "1"
                ELSE
                    VCVV2'TYPE = "9"
                    VCVV2 = ""
!![WC]              XCALL GIN, "What is MEM'CVV2=["+MEM'CVV2+"] MAGIC="+ATQ'MAGIC+" VCVV2="+VCVV2
                ENDIF
                VCVV2 = MEM'CVV2        !![WC] Force VCVV2
!![WC]          XCALL GIN, "Final MEM'CVV2=["+MEM'CVV2+"] MAGIC="+ATQ'MAGIC+" VCVV2="+VCVV2
        ELSE
            CC'FAILED = 1
            ENTRY = " PAC read failed ctp'no "+PAC'KCTP'NO+" CARDNO "+PAC'KCARDNO+" EXP "+PAC'KEXP
            \LABLOGGER ENTRY """/debug/oerctl_debug.DAILY"""  !![blm]

            ENTRY = "Invalid PAC record:"
            \KERROR PAC APID="AR" MODE="K" CNO="N"
            CC'RESPONSE = ENTRY
            GOTO DO'ERRL'OERCTL
        ENDIF
        VAMT = ATQ'AMT
!![WC]
        CALL ANET'BLD'AUTH'REQUEST                 !![WC] CCANET.CPY

RETURN


MAP1 GOT'HHS'RCN,B,4                                    !![32]

GET'HHS'RCN:
        IF GOT'HHS'RCN = 0 THEN                         !![32]
                CALL SET'HHS'KEY
                RDKEY HHS
                IF HHS'CTL # 0 THEN
                        ENTRY = "GET'HHS'RCN ERROR: "
                        \KERROR HHS MODE="K"
                        CALL DO'ERR'OERCTLL
                        HHS'RCN = 0
                ELSE                                    !![32]
                        GOT'HHS'RCN = HHS'RCN           !![32]
                ENDIF
        ELSE                                            !![32]
                HHS'RCN = GOT'HHS'RCN                   !![32]
        ENDIF
RETURN

!![32] - Experimental - but why does this journal at all?????????
!!       I took it out.

MAP1 LOCS
        MAP2 LOC'ARRAY(2)
                MAP3 ALOC'NO,B,2
                MAP3 ALOC'ZONE,S,4

SET'HDR'PRGNAM:
    IF ERRORS'MBX # 0 THEN
        CMN'FRM'PRGNAM = "ERROR9"
        RETURN
    ENDIF

!![32] - below
        IF FINISHED'WITH >= 10 THEN
                CALL GET'HHS'RCN
                RDLOCK HHS INTO HDR'REC
                CALL SET'HDR'PRGNAM2
                IF FINISHED'WITH = 14 THEN
                        HDR'PQU'STAT = ""       !![50]
                        HDR'POST'LEVEL = 255    !![9] and below
!!                      HDR'PRGNAM = SPACE(6)
                        IF HDR'ORG'LOC = 0 THEN
                          IF FIRST'LOC'NO = 0 THEN
                                HDR'ORG'LOC = HDR'LOC'NO
                                IF THIS'ACTION = "P" AND &
                                                OEC'MULTI'LOC = "Y" AND &
                                                OC2'ORG'KEY = "Y"   AND &
                                                        HDR'PROC <= 5 THEN
                                        LHS'KHDR'LOC'NO = HDR'LOC'NO
                                        LHS'KDOC'TYPE = HDR'DOC'TYPE
                                        LHS'KHDR'NO = HDR'NO
                                        LHS'KSHIPMENT = HDR'SHIPMENT
                                        LHS'KNO = 0
                                        USE LHS INTO LHS'REC KEY LHS'KEY
                                        GETNXT LHS INTO LHS'REC
                                        \CHKKEY LHS
                                        IF LHS'CTL = 0                  AND &
                                                     LHS'PRV'LOC'NO # 0 THEN
                                                HDR'ORG'LOC = LHS'PRV'LOC'NO
                                        ENDIF
                                ENDIF
                          ELSE
                                HDR'ORG'LOC = FIRST'LOC'NO
                          ENDIF
                        ENDIF
                        IF HDR'CLOSE'LOC = 0 THEN
                          IF OEC'MULTI'LOC = "Y" THEN
                                \FNDLOC FLDNAM="HDR'SHP'ZIP" OUTPUT="LOCS" MAX="2" &
                                        ABORT="DUMMY'LABEL"
                                HDR'CLOSE'LOC = ALOC'NO(1)
                          ELSE
                                HDR'CLOSE'LOC = HDR'LOC'NO
                          ENDIF
                        ENDIF
                ENDIF                           !![9] and above
                UPDATE HHS FROM HDR'REC
                IF HDR'RCN # 0 THEN
                        RDLOCK HDR
!!no need               CALL SET'HDR'PRGNAM2
                        HDR'POST'LEVEL = 0
                        IF FINISHED'WITH = 14 THEN
                                HDR'PQU'STAT = "" !![50]
                        ENDIF
                        UPDATE HDR
                ENDIF
        ELSE
                RDLOCK HDR INTO HDR'REC
                CALL SET'HDR'PRGNAM2
!![65] - below
                IF REPOSTING = 1 THEN
                        HDR'ACTION = "P"
                        HDR'PQU'STAT = "Q"
                ENDIF
!![65] - above
                IF MY'SLM'FLAG = 1 THEN             !![21]
                        HDR'ACTION = " "            !!
                        HDR'PQU'STAT = " "          !!
!!bad                   HDR'PRGNAM = " "            !!
                        HDR'POST'LEVEL = 0          !!Good
                ENDIF                               !![21]

                UPDATE HDR FROM HDR'REC
        ENDIF
!![32] - above
RETURN

SET'HDR'PRGNAM2:
!!      HDR'PRGNAM = PRGNAM(FINISHED'WITH)
        HDR'POST'LEVEL = FINISHED'WITH
        ENTRY = "set'hdr'prgnam2 "+FINISHED'WITH+" PRGNAM "+PRGNAM+" ORDER "+HDR'NO
        \LABLOGGER ENTRY """/debug/oerctl_debug.DAILY"""  !![blm]

RETURN

SET'HDR'PRGNAM3:
!!      HDR'PRGNAM = SAV'PRGNAM
        HDR'POST'LEVEL = SAV'POST'LEVEL
RETURN

MAP1 SKIP'HTOTAL,B,5                    !![30]

PRE'DO'AR1OEU:
        PRGNAM = "AR1OEU"
        CALL DO'AR1OEU                          !![32]
        UPDATE HDR                              !![32]
!![84]  IF V''SYSTEM="UNIX" THEN
!!              XCALL SYSTEM,"sync"
!!      ENDIF
        IF HDR'OLD'DR # MAX'DR OR HDR'OLD'CR # MAX'CR OR &
                                CMN'TO'PRGNAM # "GOOD" THEN
                ENTRY = "OLD'DR "+HDR'OLD'DR+" MAX'DR "+MAX'DR+" OLD'CR "+HDR'OLD'CR+" MAX'CR "+MAX'CR+" CMN'TO "+CMN'TO'PRGNAM+" 1ST CALL"
!               ENTRY = "1: Couldn't apply all DR's and/or CR's - aborting "
                \HDRERR
                CALL DO'ERR'OERCTLL
                ENTRY = "O'CR "+HDR'OLD'CR+" MAX'CR "+MAX'CR+" O'DR "+HDR'OLD'DR+" MAX'DR "+MAX'DR+" CMN'TO "+CMN'TO'PRGNAM+" 1ST CALL"
                CALL DO'ERRLO'OERCTL
        ENDIF
        HDR'OLD'DR = 0
        HDR'OLD'CR = 0
        HDR'SAV'OCASH = HDR'SAV'OCASH + MAX'CR - MAX'DR
        HDR'OLD'CASH = HDR'OLD'CASH + MAX'CR - MAX'DR
!!      HDR'PRGNAM = "AR1OEU"
        HDR'POST'LEVEL = 2
        IF ENTRY # "" THEN
            CALL DELETE'PIC
            GOTO ABORT  !!E.G. error message generated
        ENDIF
        UPDATE HDR
RETURN

SETTLE'CREDIT'CARD:
        PRGNAM = "AR1CC"
        CALL DO'AR1OEU
        IF CMN'TO'PRGNAM # "GOOD" THEN
                ENTRY = "Credit card application failed - aborting"
                \HDRERR
                CALL DO'ERR'OERCTLL
        ENDIF
!!      HDR'PRGNAM = "CREDIT"
        HDR'POST'LEVEL = 111      !!Special flag for credit card
        IF ENTRY # "" THEN
            CALL DELETE'PIC
            GOTO ABORT  !!E.G. error message generated
        ENDIF
        UPDATE HDR
        \SETKEY ATQ APID="CV" MODE="KY2"
        ATQ'STATUS = "P"
        UPDATE ATQT FROM ATQ'REC KEY ATQT'KEY
        ATQ'RCN = ATQT'RCN                      !![108]
        \UPDKEY ATQ APID="CV" MODE="KY2"
        REL ATQT
        ENTRY = "B1) "
        CALL LOG'AUTH
B1'AUTH:
RETURN

MAP1 FRM'PRGNAM,S,6

DO'AR1OEU:
        FRM'PRGNAM="OEDRCR"
        CALL DO'AR1OEU2
RETURN

DO'AR1OEU2:
        !!LINK TO AR1OEU TO APPLY PAYMENT TO DR'S & CR'S
        !!      AND CREATE AN UNAPPLIED -PAYMENT TO ORDER
        CMN'SPACE = SPACE
        CMN'FRM'PRGNAM = FRM'PRGNAM
!![99]  CMN'TO'PRGNAM = "AR1OEU"
        CMN'TO'PRGNAM = PRGNAM                          !!![99]
        CMN'SAV'RCN(1) = HDR'RCN
MAP1 FLAG,B,1
        XCALL ABUTIL,6,"AR",UB'SYS,"",FLAG
        IF FLAG # 0 THEN
                ENTRY = "Error logging to A/R"
                CALL DO'ERR'OERCTLL
                IF PRGNAM = "AR1OEU" THEN       !![99]
                        ENTRY = "2: Couldn't apply all DR's and/or CR's - aborting"
                ELSE
                        ENTRY = "Could not authorize credit card - aborting"
                ENDIF
                \HDRERR
                CALL DO'ERR'OERCTLL
                ENTRY = "O'CR2 "+HDR'OLD'CR+" MAX'CR "+MAX'CR+" O'DR "+HDR'OLD'DR+" MAX'DR "+MAX'DR+" CMN'TO "+CMN'TO'PRGNAM+" 2ND CALL"
                CALL DO'ERRLO'OERCTL
        ELSE
                ENTRY = "AR1OEU"
                IF IN'UTASK # 0 THEN
                        ? "Linking to ";ENTRY
                ENDIF
                IF CMN'FRM'PRGNAM = "DOPAY" THEN
                    SNDCMN CMN'REC
                    XCALL LINK,1,"AR1OEU",BAT'REC,CHK'REC,DOC'REC,HDR'REC           ![5]
                    GETCMN CMN'REC
                ELSE
                    XCALL LINK,1,ENTRY,CMN'REC,LOC'REC,ARC'REC,HDR'REC,HDR'RCN
                ENDIF
                IF IN'UTASK # 0 THEN
                        ? "Back from ";ENTRY
                ENDIF
                XCALL ABUTIL,6,"OE",UB'SYS,"",FLAG
                ENTRY = ""
        ENDIF
RETURN

PRT'LINK'IT:
        IF HDR'TSTAMP = 0 THEN
            \S'TO'U UDT="HDR'TSTAMP"
        ENDIF
        IF WL'PICKING'CC = 1 RETURN                        !!KLUDGE
        IF PRGNAM = "NOTHIN" RETURN                             !!KLUDGE
        IF PRT'KSEQ # PRT'SEQ THEN
            \VUSE PRT - V''PTR2
            IF PRT'CTL # 0 THEN
                ENTRY = "Printer number "+PRT'KSEQ+" for: "+HDR'VIA'NO+"-"+HDR'LOC'NO
                CALL DO'ERR'OERCTLL
                ENTRY = PRGNAM + " NOT run as requested"
                CALL DO'ERR'OERCTLL
                RETURN
            ENDIF
        ENDIF
        IF SECOND'FLAG = "YES" THEN                     !![2]
            SNDCMN SECOND'PASS
        ENDIF

!MAP1 SAV'PRGNAM,S,6
MAP1 SAV'POST'LEVEL,B,1
MAP1 DOING'HDR,B,1
!![32]MAP1 SAV'RCN,B,4

!![32] - experimental change - why was i using journaling in this
!!       routine????  no need to journal here???

COPYF "HDRFIL",=WAIT,NOAFR              !![32]

LINK'IT:
                                        !!MODIFY LINKER.CPY TO MATCH
        IF THIS'ACTION = "P" THEN
!!              SAV'PRGNAM = PRGNAM
                SAV'POST'LEVEL = FINISHED'WITH
                IF FINISHED'WITH >= 10 THEN
                        IF HDR'RCN # 0 THEN
                                RDLOCK HDR
                                CALL SET'HDR'PRGNAM3
                                WAIT'REC = HDR'REC
                        ENDIF
                        CALL LOCK'HHS
                        DOING'HDR = 2
!![32]                  SAV'RCN = HHS'RCN
!!                      RDLOCK HHS HHS'RCN INTO HDR'REC
                        CALL LINK'IT2
                        IF FAIL'LINK = 0 THEN
!![32]                          SAV'RCN = HDR'RCN
                                UPDATE HHS FROM HDR'REC
                                IF HDR'RCN # 0 THEN
                                        UPDATE HDR FROM WAIT'REC
                                ENDIF
                        ENDIF
                ELSE
                        DOING'HDR = 1
                        CALL LINK'IT2
                        IF FAIL'LINK = 0 THEN
!![32]                          SAV'RCN = HDR'RCN
                                IF HDR'RCN # 0 THEN
                                        UPDATE HDR
                                ENDIF
                        ENDIF
                ENDIF
!![84]          IF V''SYSTEM="UNIX" THEN
!!                      XCALL SYSTEM,"sync"
!!              ENDIF
        ELSE
                CALL LINK'IT2
        ENDIF
RETURN

MAP1 SF'HDR,B,1

!!TST'HDR:
!!      IF JNL'KEY'DBID = "OEHDR" AND SAV'RCN = 0 THEN SF'HDR = 1
!!RETURN

MAP1 SET'HHS'INV'YN,B,1

LINK'IT2:
        IF PRGNAM = "NOTHIN" RETURN                             !!KLUDGE
        SKIP'JNL = JNL'DID
        IF IN'UTASK # 0 THEN
                \KERROR HDR MODE="D" CNO="N"
                ? "Linking to ";PRGNAM;" for ";ENTRY
        ENDIF
        XCALL GETENV,"WMI_CUSNO",ENTRY
        IF VAL(ENTRY) = HDR'NAM'NO THEN
!!If walmart customer on particular program change name from standard
!!e.g. oermr2 becimes oewmr2
            XCALL GETENV,"WMI_PRGNAM",ENTRY
            IF UCS(PRGNAM) = UCS(ENTRY) THEN
                PRGNAM[3;1] = "W"
            ENDIF
        ENDIF
        ENTRY = PRGNAM
        IF PRGNAM = "OEPDOC" THEN
            SET'HHS'INV'YN = 1
        ELSE
            SET'HHS'INV'YN = 0 !![47]
        ENDIF
        IF PRGNAM = "OEPDOC" OR PRGNAM = "OEPQTY" THEN
            IF INC'USE'CV = "Y" AND TRH'CTP'NO # 0 THEN
                IF PRGNAM = "OEPQTY" THEN
                    \UCNVATQ AKEY="Y" VIN="C" PRE="HDR"
                ELSE
                    \UCNVATQ AKEY="Y" VIN="A" PRE="HDR"
                ENDIF
                USE ATQT INTO ATQ'REC KEY ATQT'KEY
            ENDIF
        ENDIF
        MAP1 LABELS'PRINTED,B,3
        COPYF "LOCFIL[IN]",=LOC8
        LOC8'REC = LOC'REC
        GETPROFILE'TMP = ENTRY
        ENTRY = "Linking "+ENTRY
        \HDRERR
        CALL SNDMON
        ENTRY = GETPROFILE'TMP
        LCL1 T1,F
        LCL1 T2,F
        XCALL ABUTIL,80,T1
        XCALL LINK,1,ENTRY,CNT'REC,INC'REC,ARC'REC,OEC'REC,HDR'REC,      &
                HDR'RCN,LOC'REC,LOC'RCN,VIA'REC,VIA'RCN,CUS'REC,CUS'RCN, &
                LST'REC,PRGNAM,PASS'SEL'REC,TRH'REC,TRH'RCN,I,           &
                STX'REC,PRT'REC,VIL'REC,REPOSTING,SKIP'JNL,CACHE'REC
        XCALL ABUTIL,80,T2
        GETPROFILE'TMP = ENTRY
        ENTRY = "Completed "+PRGNAM+" time: "+(T2-T1)+" E="+ENTRY
        \HDRERR
        CALL SNDMON
        ENTRY = GETPROFILE'TMP
        IF OEC'PPRGNAM # "OEPACK" THEN
            LABELS'PRINTED = PRGNAM[-1,-1]
            IF PRGNAM[-1,-1] >= "0" AND PRGNAM[-1,-1] <= "9" THEN
                PRGNAM = PRGNAM[1,-2]
            ENDIF
        ENDIF
        LOC'REC = LOC8'REC
        IF IN'UTASK # 0 THEN
                ? "Back from ";ENTRY
        ENDIF
        IF PRGNAM="CTRLC" THEN
                CTC = CTC + 1
                IF IN'UTASK THEN
                        CALL UNIX'FLIP
                ENDIF
                PRGNAM="GOOD"
        ENDIF
        IF PRGNAM[1;4] # "GOOD" THEN
                IF PRGNAM = "ABORT" THEN
                    ENTRY = "Invoicing aborted: "
                ELSE
                    ENTRY = PRGNAM + " (inv) aborted: "
                ENDIF
                \HDRERR
                ENTRY = ENTRY + ":" + THIS'ACTION
                CALL DO'ERR'OERCTLL
                FAIL'LINK = 1
        ELSE
                IF THIS'ACTION = "P" THEN
!![47]                  IF FINISHED'WITH = 11 AND OEC'INV'YN # "N" THEN !![6]
                        IF SET'HHS'INV'YN = 1 AND OEC'INV'YN # "N" THEN !![47]
                                HHS'REC = HDR'REC               !![6]
                                HHS'INV'YN = "Y"                !![6]
                                HDR'REC = HHS'REC               !![6]
                        ENDIF
!!                      HDR'PRGNAM = SAV'PRGNAM
                        HDR'POST'LEVEL = SAV'POST'LEVEL
                ELSE
                IF THIS'ACTION = "E" THEN
                    IF HDR'FPICK'UDT = 0 THEN
                        IF IN2'WL'YN = "Y" AND WLC'USE'VFH'YN = "Y" THEN
                            IF HDR'FPICK'UDT = 0 THEN
                                HDR'FPICK'UDT = HDR'TSTAMP
                                IF HDR'FPICK'UDT = 0 THEN
                                    \S'TO'U HDR'FPICK'UDT
                                ENDIF
                            ENDIF
                        ELSE
                            \S'TO'U HDR'FPICK'UDT
                            HDR'LPICK'UDT = HDR'FPICK'UDT
                        ENDIF
                    ENDIF
                ENDIF
                ENDIF
        ENDIF
RETURN

COPY    "FORMAT"
COPY    "BASERR"


GET'CMN'DATA:
!!IF RPOST SET REPOSTING ...
        ARCHIVE = 0
        IF CMN'FRM'PRGNAM[1;5] = "RPOST" OR CMN'FRM'PRGNAM[1;5] = "RPSTH" THEN
                ENTRY = "Reposting in OERCTL: "+CMN'FRM'PRGNAM+"/"+STR(CMN'SAV'RCN(1))
                CALL DO'ERRLO'OERCTL
                REPOSTING = 1
!![76] - below
                IF CMN'FRM'PRGNAM[6;1] = "A" THEN
                        USE HHS CMN'SAV'RCN(1) INTO HDR'REC
                        IF HHS'CTL # 0 THEN
                                HHS'KLOC'NO = CMN'SAV'RCN(2)
                                HHS'KDOC'TYPE = CMN'SAV'RCN(3)
                                HHS'KNO = CMN'SAV'RCN(4)
                                HHS'KSHIPMENT = CMN'SAV'RCN(5)
                                USE HHS INTO HDR'REC KEY HHS'KEY
                        ENDIF
                        IF HHS'CTL # 0 THEN
                                HDR'KLOC'NO = CMN'SAV'RCN(2)
                                HDR'KDOC'TYPE = CMN'SAV'RCN(3)
                                HDR'KNO = CMN'SAV'RCN(4)
                        ELSE
                                \SETKEY HDR MODE="KEY"
                                ARCHIVE = 1
                        ENDIF
                        USE HDR INTO HDR'REC KEY HDR'KEY
!!                      IF HDR'PRGNAM # "" AND HDR'CTL = 0 THEN
                        IF HDR'POST'LEVEL > 0 AND HDR'CTL = 0 THEN
                                ARCHIVE = 0
                                CMN'FRM'PRGNAM[6;1] = "C"
                                CMN'SAV'RCN(1) = HDR'RCN
                                ENTRY = "Changed to current as both exist! "+CMN'SAV'RCN(1)+" "+HDR'PRGNAM
                                CALL DO'ERRLO'OERCTL
                        ENDIF
                        HDR'RCN = 0                             !![77]
                ENDIF
!![76] - above
                IF CMN'FRM'PRGNAM[6;1] = "C" THEN
                        RDLOCK HDR CMN'SAV'RCN(1) INTO HDR'REC  !![32]
                ELSE
                        RDLOCK HHS CMN'SAV'RCN(1) INTO HDR'REC  !![32]
                        HDR'CTL = HHS'CTL
                        ARCHIVE = 1
                ENDIF
!![49] - below
                IF HDR'CTL # 0 THEN
                        HHS'KLOC'NO = CMN'SAV'RCN(2)
                        HHS'KDOC'TYPE = CMN'SAV'RCN(3)
                        HHS'KNO = CMN'SAV'RCN(4)
                        HHS'KSHIPMENT = CMN'SAV'RCN(5)
                        RDLOCK HHS INTO HDR'REC KEY HHS'KEY
                        HDR'CTL = HHS'CTL
                        IF HDR'CTL = 0 THEN
                            CMN'FRM'PRGNAM[6;1] = "A"
                            ARCHIVE = 1
                        ENDIF
                ENDIF
                IF HDR'CTL = 0 THEN                             !![55]
                        IF THIS'ACTION # "P" OR HDR'PQU'STAT # "Q" THEN
                                HDR'ACTION = "P"
                                HDR'PQU'STAT = "Q"
                                IF CMN'FRM'PRGNAM[6;1] = "C" THEN
                                        UPDATE HDR FROM HDR'REC
                                ELSE
                                        UPDATE HHS FROM HDR'REC
                                ENDIF
                        ENDIF
                ENDIF
!![49] - above
        ELSE
                RDLOCK HDR CMN'SAV'RCN(1) INTO HDR'REC  !![32]
                IF HDR'CRID = "WBFULL" THEN
                   IF WBWHAP = 0 THEN
                       CALL GET'FUC
                       FNAME = "/docroot/"+FUC'CLIENT+"/done/shiporder."+HDR'PO
                       LOOKUP FNAME,SFOUND
                       IF SFOUND = 0 THEN          !!KLUDGE
                           FNAME = "/docroot/"+FUC'CLIENT+"/error/shiporder."+HDR'PO
                           LOOKUP FNAME,SFOUND
                            IF SFOUND = 0 THEN
                               ENTRY = FNAME+" Not found... aborting on "
                               \KERROR HDR MODE="D" APID="OE" CNO="N"
                               CALL DO'ERRL'OERCTL
                               GOTO ABORT
                            ENDIF
                            ENTRY = "'Y' and [RETURN] to use shiporder from /error: "
                            \L24CHR CLR="Y"
                            IF UCS(ENTRY) = "Y" AND INX1 = I'RT THEN
                               ENTRY = "/docroot/"+FUC'CLIENT+"/done/shiporder."+HDR'PO
                               XCALL SYSTEM,"mv "+FNAME+" "+ENTRY+" 2>/dev/null"
                               ENTRY = "Moved to done directory: "+ENTRY
                               CALL DO'ERRL'OERCTL
                            ELSE
                                GOTO ABORT
                            ENDIF
                       ENDIF
                       \GETPROFILE FNAME """po""" ENTRY
                       IF ENTRY # HDR'PO THEN
                           ENTRY = "Shiporder not correct for "
                           \KERROR HDR MODE="D" CNO="N"
                           ENTRY = ENTRY + " PO="+HDR'PO
                           CALL DO'ERRL'OERCTL
                           ENTRY = "/docroot/"+FUC'CLIENT+"/error/shiporder."+HDR'PO
                           XCALL SYSTEM,"mv "+FNAME+" "+ENTRY+" 2>/dev/null"
                           ENTRY = "Moved to error directory: "+ENTRY
                           CALL DO'ERRL'OERCTL
                           ENTRY = "Have shiporder resent!"
                           CALL DO'ERR'OERCTL
                           GOTO ABORT
                       ENDIF
                   ENDIF
                ELSE
                IF HDR'CRID = "WBLOAD" THEN
                       CALL GET'FUC
                       \STRDTT DTT="HDR'CRDT" CDATE="ENTRY" YYMMDD="Y"
                       ENTRY = "/orders."+ENTRY
                       FNAME = "/docroot"+FUC'CLIENT+"/invdata" + ENTRY
                       LOOKUP FNAME,SFOUND
                       IF SFOUND = 0 THEN          !!KLUDGE
                           ENTRY = FNAME+" Not found... aborting on "
                           \KERROR HDR MODE="D" APID="OE" CNO="N"
                           CALL DO'ERRL'OERCTL
                           GOTO ABORT
                       ENDIF
                       \GETPROFILE FNAME HDR'PO ENTRY
                       IF ENTRY = "" THEN
                           ENTRY = HDR'PO + " failed getprofile in "+FNAME
                           \KERROR HDR MODE="D" APID="OE" CNO="N"
                           CALL DO'ERRL'OERCTL
                           GOTO ABORT
                       ENDIF
                ENDIF
                ENDIF
        ENDIF
RETURN

\COPYF FUC WB
MAP1 SFOUND,F

GET'FUC:
        IF FUC'CUS'NO # HDR'NAM'NO THEN
            FUCC'KCUS'NO = HDR'NAM'NO
            USE FUCC INTO FUC'REC KEY FUCC'KEY
            IF FUCC'CTL # 0 THEN
                ENTRY = "Invalid fullfilment customer on: "
                \HDRERR
                CALL DO'ERRL'OERCTL
                GOTO ABORT
            ENDIF
        ENDIF
RETURN

GET'BGP'DATA:
        I = 0                           !![40] (Just in case I > 24)
        RDCOND HDR PS'DTAPTR INTO HDR'REC                       !![27]
        DO WHILE HDR'CTL = 4 AND I < 24
!!LOCKED STILL BY FOREGROUND PROGRAM? - TRY FOR 2 MINUTES TO GET HEADER THEN EXIT
            ?TAB(24,1) "Order locked - waiting!";
            \SLEEP 2                !![18] - was \SLEEP 5
            RDCOND HDR PS'DTAPTR INTO HDR'REC               !![27]
            I = I + 1
            ?TAB(24,1) ; TAB(-1,9) ;
        LOOP
!![45] - (actually only maybe but this is better this way)
!![43] - if locked and no longer on QUEUE then another job is posting it!
        IF IN'BGP # 0 AND PS'QNO # 0 AND INLOOP = 0 AND I = 24 THEN
            USE PQU PS'QNO INTO PQU'REC
            IF HDR'RCN # PQU'USRPTR THEN PQU'CTL = 3
            IF PQU'CTL # 0 THEN HDR'CTL = 7
        ENDIF
        CASE
        IF HDR'CTL = 4 THEN             !![8], fix TIMPQU.MAC.
                                        !!BGCTL.LIT and PQUFIL.CPY fixed.
                CALL DO'TIMPQU
        ELSE
        IF (IN'BGP # 0 AND PS'QNO # 0) OR IN'TASK # 0 THEN      !![67]
!![9] - below delete from queue
!!NOTE: with out test, was releasing record for brief time, then another
!!bgp job would lock it, but header was locked by this one - OUCH
                IF INLOOP = 0 AND HDR'CTL # 7 AND IN'TASK = 0 THEN !![42] !![67]
                        USE PQU PS'QNO INTO PQU'REC
                        IF HDR'RCN # PQU'USRPTR THEN PQU'CTL = 3 !![45]
                ENDIF                                            !![42]
                IF PQU'CTL # 0 THEN
!![43]Another job got HDR and removed from BGP if HDR'CTL # 0
                        IF HDR'CTL # 0 GOTO ABORT               !![43]
                        ENTRY = "COULD NOT remove from background (INLOOP="+STR(INLOOP)+")"
                        CALL DO'ERR'OERCTLL
                ELSE
!![36] - add INLOOP to below.
                        IF PQU'QUEUE = 0 OR INLOOP = 1 OR IN'TASK # 0 THEN !![67]
                                IF INLOOP = 0 AND IN'TASK = 0 THEN      !![36] !![67]
                                        RDLOCK PQU
                                ENDIF
                                \SETKEY PRE="PQU" APID="SY" MODE="KEY"
                                DELETE PQU KEY PQU'KEY
                                IF INLOOP = 0 AND IN'TASK = 0 THEN      !![36] !![67]
                                        PQU'QUEUE = PQU'ORGQUE          !![36]
                                ENDIF                                   !![36]
                        ENDIF
                ENDIF
        ENDCASE
        IF HDR'CTL # 0 AND HDR'CTL # 4 THEN
                CALL DELETE'PIC
                ENTRY = "Cannot read header: "+HDR'RCN+" ctl="+HDR'CTL
                CALL DO'ERR'OERCTLL
                GOTO ABORT
        ELSE
        IF (HDR'PQU'STAT # "Q" OR HDR'ACTION = SPACE) AND REPOSTING = 0 &
                                                        AND HDR'CTL = 0 THEN
            ENTRY = "FIXED: "
            \KERROR HDR MODE="D"
            ENTRY = ENTRY + "|"+HDR'PQU'STAT+"-"+HDR'ACTION+"-"+HDR'MULTI+"-"+HDR'PICK'NEED+"-"+HDR'PICK'VER
            CALL DO'ERRLO'OERCTL
            HDR'PQU'STAT = "Q"
            IF HDR'ACTION = SPACE THEN
!![72] Risked below - was finding PICK'NEED = "N" AND PICK'VER = 1 on "FIXED" ones
                IF INC'AUTOPACK = "Y" THEN
                    HDR'ACTION = "P"
                ELSE
                    HDR'ACTION = "E"
                ENDIF
            ENDIF
            UPDATE HDR FROM HDR'REC
        ENDIF
        ENDIF
RETURN

PRE'DO'TIMPQU:
        CALL DO'TIMPQU
GOTO ABORT

MAP1 SAV'PQU'RCN,B,4

DO'TIMPQU:
!![42]  \TIMPQU                 !!Put back on QUEUE in 'Hold' status.
        IF IN'TASK # 0 THEN                             !![73] - this case
                PQU'DID = "OEQUE"
                PQU'KID = "OEQUE"
        ENDIF
        SAV'PQU'RCN = PQU'RCN
        \SETKEY PQU MODE="KEY" APID="SY"
        DELKEY PQU
        IF OEC'TASK'YN = "Y" THEN                               !![68]
                PQU'QUEUE = ((PQU'QUEUE + 40) MAX 41) MIN 99
        ELSE
                PQU'QUEUE = ((PQU'ORGQUE + 40) MAX 41) MIN 99
        ENDIF
        PQU'KQUEUE = PQU'QUEUE
        PQU'KSEQ = -1
        RDKEY PQU
        GETPRV PQU
        PQU'KEY = PQU'KEY2
        IF PQU'KQUEUE = PQU'QUEUE THEN
                PQU'SEQ = PQU'KSEQ + 1
        ELSE
                PQU'SEQ = 1
        ENDIF
        PQU'RCN = SAV'PQU'RCN
        \SETKEY PQU MODE="KEY" APID="SY"
        ADDKEY PQU
        DO UNTIL PQU'CTL = 0 OR PQU'SEQ >= 9999
                PQU'SEQ = PQU'SEQ + 1
                PQU'KSEQ = PQU'SEQ
                ADDKEY PQU
        LOOP
        IF PQU'CTL # 0 THEN
                ENTRY = "Unable to put order on PQU hold in OERCTL"
                \HDRERR
                CALL DO'ERR'OERCTLL
                DELETE PQU
        ELSE
                WRITE PQU FROM PQU'REC
        ENDIF
RETURN

\COPYF  WOE

PROCESS'PICK'FROM'WOEO:         !!Batch picking tickets
        LOOP'TST = 1
        RDKEY WOEO
        DO
                GETNXT WOEO
                IF WOEO'CTL # 0 EXIT
                WOEO'KEY = WOEO'KEY2
                RDLOCK HDR WOEO'KHDR'RCN INTO HDR'REC
                IF HDR'PQU'STAT # "Q" OR HDR'CTL # 0                    OR &
                        (HDR'ACTION # "E" AND HDR'ACTION # "L")         REPEAT
                CALL PROCESS'ONE'HDR
                FAIL'LINK = 0
        LOOP UNTIL CTC > 0
RETURN

SET'HHS'KEY:
        HHS'KLOC'NO = HDR'LOC'NO
        HHS'KDOC'TYPE = HDR'DOC'TYPE
        HHS'KNO = HDR'NO
        HHS'KSHIPMENT = HDR'SHIPMENT
RETURN

LOCK'HHS:
        CALL SET'HHS'KEY
        RDLOCK HHS INTO HDR'REC KEY HHS'KEY
        IF HHS'CTL # 0 THEN
                ENTRY = "Cannot find archived header: "
                \HDRERR PRE="HDR" APID="OE"             !!NOT HHS AS USES 'REC
                CALL DO'ERR'OERCTL
                GOTO ABORT
        ENDIF
        I = HHS'RCN
RETURN

COPYF "CMNFIL[SY]",=CMN2,NOAFR

MAP1 JNL'WAS'USED,B,1                           !![32]
MAP1 ERROR'DID,S,6                              !![61]

SET'REPOST:
        ERROR'DID = JNL'DID                     !![61]
        JNL'WAS'USED = 1                        !![32]
!![35]  CMN2'REC = CMN'REC
        CMN'SPACE = SPACE
        CMN'TO'PRGNAM = "OERCTL"
        CMN'FRM'PRGNAM = "RPOST"
        IF FINISHED'WITH >= 10 THEN
                CMN'FRM'PRGNAM[6;1] = "A"
                CALL GET'HHS'RCN
                CMN'SAV'RCN(1) = HHS'RCN
!![49] - below
                CMN'SAV'RCN(2) = HDR'LOC'NO
                CMN'SAV'RCN(3) = HDR'DOC'TYPE
                CMN'SAV'RCN(4) = HDR'NO
                CMN'SAV'RCN(5) = HDR'SHIPMENT
!![49] - above
        ELSE
                CMN'FRM'PRGNAM[6;1] = "C"
                CMN'SAV'RCN(1) = HDR'RCN
!![49] - below
                CMN'SAV'RCN(2) = HDR'LOC'NO
                CMN'SAV'RCN(3) = HDR'DOC'TYPE
                CMN'SAV'RCN(4) = HDR'NO
                CMN'SAV'RCN(5) = HDR'SHIPMENT + 1
!![49] - above
        ENDIF
        JNL'CMN'REC = CMN'REC
        JNL'FLAG = "Y"
        JNL'PRGNAM = PRGNAM
        IF PRGNAM = "OEPQTY" THEN                       !![19]
                JNL'LPRGNAM = "OEXQTY"
        ENDIF
        ENTRY = ""
        \KERROR HDR MODE="D"
        JNL'DESC = " Order " + ENTRY + " from OERCTL"
        CMN'REC = CMN2'REC
RETURN

COPY "CVTDTT"

!![30] - below

MAP1 NEW'INTERNAL,B,3

SET'NEW'INTERNAL:                       !![86] - re-wrote routine
        DO
                RDLOCK ARC UB'CNO INTO ARC'REC
                ARC'COUNTER(ARC'INV'CNT'NO(HDR'DOC'TYPE)) =             &
                                ARC'COUNTER(ARC'INV'CNT'NO(HDR'DOC'TYPE)) + 1
                WRITE ARC FROM ARC'REC
                IF ARC'COUNTER(ARC'INV'CNT'NO(HDR'DOC'TYPE)) > 9999999 THEN
                        NEW'INTERNAL = 0
                        CALL DELETE'PIC
                        ENTRY = "Cannot generate invoice number: "+" HDR="+LOC'NO+"-"+HHS'DOC'TYPE+"-"+HHS'NO
                        CALL DO'ERR'OERCTLL
                        GOTO ABORT
                ENDIF
                NEW'INTERNAL = ARC'COUNTER(ARC'INV'CNT'NO(HDR'DOC'TYPE))
                DOCV'KINV'TYPE = HDR'DOC'TYPE
                DOCV'KINVOICE = NEW'INTERNAL
                RDKEY DOCV
                IF DOCV'CTL # 0 THEN
                        DHSV'KINV'TYPE = HDR'DOC'TYPE
                        DHSV'KINVOICE = NEW'INTERNAL
                        RDKEY DHSV
                ENDIF
        LOOP UNTIL DOCV'CTL # 0 AND DHSV'CTL # 0
RETURN

SKIPDOC:
        IF OEC'CRL'FLAG # 5 THEN                        !![54]
                CUS'TMP'AR = CUS'TMP'AR + SKIP'HTOTAL   !![46]
        ENDIF                                           !![54]
        CALL SET'NEW'INTERNAL
        HDR'INTERNAL = NEW'INTERNAL
        IF OEC'CRL'FLAG # 5 THEN                        !![54]
                UPDATE CUS FROM CUS'REC                 !![32]
        ENDIF
RETURN

CLEAN'UPS:
        IF JNL'WAS'USED = 1 THEN
                JNL'WAS'USED = 2
                CLRKEY JNL
                CLRDTA JNL
                IF ERROR'DID # JNL'DID THEN             !![61]
                        JNL'WAS'USED = 0
                        ENTRY = "ERROR DID: "+ERROR'DID+"/"+JNL'DID
                        CALL DO'ERR'OERCTLL
                ENDIF
!![84]          IF V''SYSTEM="UNIX" THEN
!!                      XCALL SYSTEM,"sync"
!![84]          ENDIF
        ENDIF
        IF V''JOBNAM = "BGP1" OR QUEUE'EMPTY = 1 THEN !![55]
                JNL'RCN = 0
                HDR'RCN = 0
                LHS'RCN = 0
                SHS'RCN = 0
                HHS'RCN = 0                             !![59]
        ENDIF
        REL JNL
!![59]  HHS'RCN = 0
        REL HHS
        REL HDR
        REL LHS
        REL SHS
        REL ARC
!![66] - below
        HDR'RCN = 0
        LHS'RCN = 0
        SHS'RCN = 0
        HHS'RCN = 0
!![66] - above
RETURN

![82] start;
MAP1 COUNT'SUBS,F
MAP1 ERROR'COUNT,F

VERIFY'SERIAL'NO:
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KDOC'TYPE = HDR'DOC'TYPE
        LIN'KHDR'NO = HDR'NO
        LIN'KNO = 0
        USE LIN INTO LIN'REC KEY LIN'KEY
        DO
                GETNXT LIN
                IF LIN'CTL # 0 OR LIN'KHDR'LOC'NO # LIN'HDR'LOC'NO OR   &
                                  LIN'KDOC'TYPE # LIN'DOC'TYPE OR       &
                                  LIN'KHDR'NO # LIN'HDR'NO THEN EXIT

                IF LIN'COM'QTY <= 0 THEN REPEAT
                IF LIN'SUB'COUNT = 0 REPEAT

                IF OEC'SKIP'FUT = "Y" THEN
                        DTT = LIN'PROM'DTT
                        CALL CNV'DTT
                        IF YDAYS > XDAYS THEN REPEAT
                ENDIF

                PRH'KTRK'NO = LIN'TRK'NO
                USE PRH INTO PRH'REC KEY PRH'KEY
                IF PRH'CTL # 0 THEN
                        CALL DELETE'PIC
                        ENTRY = "Missing PRH Record: "
                        \LINERR
                        CALL DO'ERR'OERCTL
                        GOTO ABORT
                ENDIF

                IF PRH'USE'SRL'YN = "N" THEN REPEAT

                SUB'KHDR'LOC'NO = LIN'HDR'LOC'NO
                SUB'KDOC'TYPE = LIN'DOC'TYPE
                SUB'KHDR'NO = LIN'HDR'NO
                SUB'KLIN'NO = LIN'NO
                SUB'KNO = 0

                COUNT'SUBS = 0
                ERROR'COUNT = 0

                USE SUB INTO SUB'REC KEY SUB'KEY
                DO
                        GETNXT SUB
                        IF SUB'CTL # 0 OR SUB'KHDR'LOC'NO # SUB'HDR'LOC'NO OR &
                                        SUB'KDOC'TYPE # SUB'DOC'TYPE OR &
                                        SUB'KHDR'NO # SUB'HDR'NO OR &
                                        SUB'KLIN'NO # SUB'LIN'NO THEN EXIT

                        COUNT'SUBS = COUNT'SUBS + 1

                        IF SUB'SERIAL = "" OR SUB'SERIAL[1;1] = "?" THEN
                                CALL DELETE'PIC
                                ENTRY = "Missing Serial Number: "
                                \LINERR
                                CALL DO'ERR'OERCTL
                                GOTO ABORT
                        ENDIF
                LOOP

                IF (LIN'COM'QTY + LIN'BO'QTY) # COUNT'SUBS THEN
                        CALL DELETE'PIC
                        ENTRY = "Committed+B/O # SUB Count: "
                        \LINERR
                        CALL DO'ERR'OERCTL
                        GOTO ABORT
                ENDIF
        LOOP
RETURN

![82] end;

CHECK'DELETE:                                   !![90] moved from above
        LIN'KHDR'LOC'NO = FIRST'LOC'NO
        LIN'KDOC'TYPE = HDR'DOC'TYPE
        LIN'KHDR'NO = FIRST'HDR'NO
        LIN'KNO = 0
        RDKEY LIN
        GETNXT LIN
        LIN'KEY = LIN'KEY2
        IF LIN'KHDR'LOC'NO # FIRST'LOC'NO OR &
           LIN'KDOC'TYPE # HDR'DOC'TYPE OR &
           LIN'KHDR'NO # FIRST'HDR'NO OR &
           LIN'CTL # 0 THEN
                DEL'FIRST = FIRST'RCN
        ELSE
                DEL'FIRST = 0
        ENDIF
RETURN

UNIX'FLIP:
        UB3'BUF = USR'BUF
        USR'BUF = UB2'BUF
        \ULDUSR         !!reload
        ENTRY = "F1 thru F10 for 1 - 10 new tasks, any other key to abort."
        \L24CHR CLR="Y"
        IF INX2 >= 1 AND INX2 <= 10 THEN
                FOR XDAYS = 1 TO INX2
                        XCALL VICSIT,10
                NEXT XDAYS
                CTC = 0
        ENDIF
        USR'BUF = UB3'BUF
        \ULDUSR         !!reload
RETURN

MAP1 CTC,B,5

PRE'ERTRAP:
        IF ERR(0) = 1 THEN
                CTC = CTC + 1
                IF CTC > 200 GOTO ERTRAP        !!Die if lots ...
                CV'CC'ABORT = 1                 !!Credit car die
                ENTRY = "CTRL-C pressed - will abort at a good time."
                IF IN'UTASK # 0 THEN
                        CALL UNIX'FLIP
                ELSE
                IF IN'TASK = 1 OR IN'BGP = 1 THEN
                        ?TAB(-1,A'RED) ; ENTRY ; TAB(-1,A'NORM) ; TAB(-1,9)
                ELSE
                        CALL DO'ERR'OERCTL
                ENDIF
                ENDIF
                ENTRY = "CTRL-C pressed in OERCTL: "+PRGNAM+" ORDER "+HDR'NO
                \LABLOGGER ENTRY """/debug/oerctl_debug.DAILY"""  !![blm]
                RESUME
        ENDIF
        CTC = 0
GOTO ERTRAP

LCL1 LAST'STX'LOC'NO,B,2
\COPYF STX IN MODE="PRI"

GET'STX:
        STX'KNO = CUS'STX'NO
        STX'KLOC'NO = HDR'LOC'NO
        \CHKKEY STX LASTFIX="NO" APID="IN"
        IF STX'CTL # 0 THEN
          IF STX'NO # STX'KNO OR LAST'STX'LOC'NO # STX'KLOC'NO THEN
                LAST'STX'LOC'NO = STX'KLOC'NO
                STX'CTL = 1
                XCALL VICSIT,7,106,STX'REC,0,STXPTR,5,STX'PKT,STX'KEY
                IF STX'CTL # 0 THEN
                        STX'SPACE = SPACE
                        USE STX INTO STX'REC KEY STX'KEY
                        XCALL VICSIT,7,105,STX'REC,0,STXPTR,5,STX'PKT,STX'KEY
                ENDIF
                IF STX'CTL # 0 OR STX'NO # STX'KNO THEN
                        STX'KLOC'NO = 0
                        STX'SPACE = SPACE
                        \VUSE STX
                        STX'LOC'NO = LAST'STX'LOC'NO
                        STX'KLOC'NO = LAST'STX'LOC'NO
                        XCALL VICSIT,7,105,STX'REC,0,STXPTR,5,STX'PKT,STX'KEY
                ENDIF
          ENDIF
          IF STX'CTL # 0 THEN
                ENTRY = "Invalid STX: "
                \KERROR STX APID="IN" MODE="K" CNO="N"
                ENTRY = ENTRY + " on "
                \KERROR HDR MODE="D" CNO="N"
                CALL DO'ERR'OERCTLL
                STX'SPACE = SPACE
          ENDIF
        ENDIF
        HDR'STX'NO = CUS'STX'NO
RETURN

SET'TOTALS:
        \HDRSUM BALANCE="CALC'HTOTAL" INVOICE="SKIP'HTOTAL"
RETURN

!!\COPYF PIC WH

DELETE'PIC:
        IF IN2'RCN # UB'CNO THEN
                USE IN2 UB'CNO INTO IN2'REC
        ENDIF
CIF WH AND NOT WH THEN
    IF IN2'WH'YN = "Y" THEN
            PIC'SPACE = SPACE
            PIC'LOC'NO = HDR'LOC'NO
            PIC'DOC'TYPE = HDR'DOC'TYPE
            PIC'HDR'NO = HDR'NO
            PIC'SHIPMENT = HDR'SHIPMENT
            \SETKEY PIC MODE="KEY" APID="WH"
            RDCOND PIC INTO PIC'REC KEY PIC'KEY
            IF PIC'CTL = 0 THEN
                \SETKEY PIC MODE="KY2" APID="WH"
                \DELKEY PIC MODE="ALL" APID="WH"
                DELETE PIC
            ENDIF
        ENDIF
ENDCIF
        IF IN2'WL'YN = "Y" THEN
            WLQ'SPACE = SPACE
            WLQ'LOC'NO = HDR'LOC'NO
            WLQ'DOC'TYPE = HDR'DOC'TYPE
            WLQ'HDR'NO = HDR'NO
            WLQ'SHIPMENT = HDR'SHIPMENT
            \SETKEY WLQ MODE="KEY" APID="WL"
            RDCOND WLQ INTO WLQ'REC KEY WLQ'KEY
            IF WLQ'CTL = 0 THEN
                \SETKEY WLQ MODE="KY2" APID="WL"
                \DELKEY WLQ MODE="ALL" APID="WL"
                DELETE WLQ
            ENDIF
        ENDIF
RETURN

DO'ERR'OERCTL:
    IF WL'DEBUG # "" THEN
        CALL LOG'ENTRY
    ENDIF
    IF WBWHAP # 0 CALL DO'ERRLO ELSE CALL DO'ERR
RETURN

MAP1 ENTRY'OERCTL,S,25

DO'ERR'OERCTLL:
    IF WBWHAP # 0 THEN
        CALL DO'ERRLO'OERCTL
        IF WBWHAP # 3 THEN
            ENTRY'OERCTL = ENTRY
        ENDIF
        WBWHAP = 3
    ELSE
        IF ENTRY'OERCTL = "" THEN ENTRY'OERCTL = ENTRY
        CALL DO'ERRL'OERCTL
    ENDIF
RETURN

DO'ERRL'OERCTL:
    IF WL'DEBUG # "" THEN
        CALL LOG'ENTRY
    ENDIF
    CALL DO'ERRL
RETURN

DO'ERRLO'OERCTL:
    IF WL'DEBUG # "" THEN
        CALL LOG'ENTRY
    ELSE
        CALL DO'ERRLO
    ENDIF
RETURN

MAP1 II,F
MAP1 JJ,F

\COPYF WCS WB WCS2
\COPYF WCS WB
COPYF "IN2FIL[IN]",NOAFR


PRE'DO'EMAIL:
!       IF HDR'ACTION # "P" THEN
!               RETURN
!       ENDIF
        IF IN2'RCN # UB'CNO THEN
            USE IN2 UB'CNO INTO IN2'REC
        ENDIF
        IF IN2'WB'YN # "Y" RETURN                   !!KLUDGE
        IF NO'EMAIL = "Y" RETURN
        IF THIS'ACTION # "E" AND THIS'ACTION # "L" THEN
            IF HDR'INTERNAL = 0 AND DOING'MSG = 0 THEN
                IF EHDR'NO # HDR'NO THEN
                    ENTRY = "Recovery program error -- aborting!"
                    CALL DO'ERRL
                    GOTO ABORT
                ENDIF
                HDR'REC = EHDR'REC
                ENTRY = "OERCTL: Lost HDR before email invoice. Will auto-recover."
                IF LEN(WL'DEBUG) > 1 THEN
                    XCALL VICSIT,26,ENTRY,WL'DEBUG
                ELSE
                    XCALL VICSIT,26,ENTRY,"/logs/oerctl.DAILY"
                ENDIF
!!              CALL DO'ERRLO
                ENTRY = "OERCTL: HDR="
                \KERROR HDR MODE="D"
                ENTRY = ENTRY + "Repost="+REPOSTING+" POST'LEVEL="+HDR'POST'LEVEL+ &
                " |"+HDR'PQU'STAT+"-"+HDR'ACTION+"-"+HDR'MULTI
!!              CALL DO'ERRLO
                IF LEN(WL'DEBUG) > 1 THEN
                    XCALL VICSIT,26,ENTRY,WL'DEBUG
                ELSE
                    XCALL VICSIT,26,ENTRY,"/logs/oerctl.DAILY"
                ENDIF
            ENDIF
        ENDIF
!all web orders get an ack
        IF THIS'ACTION = "E" OR THIS'ACTION = "L" THEN
            PRT'KSEQ = LOC'PPRT'NOL(HDR'DOC'TYPE)
        ELSE
        IF HDR'VIA'NO >= OEC'SCUS'VIA AND HDR'VIA'NO <= &
                        OEC'ECUS'VIA AND LOC'PRT'NOP(HDR'DOC'TYPE) # 0 THEN
            PRT'KSEQ = LOC'PRT'NOP(HDR'DOC'TYPE)
        ELSE
            PRT'KSEQ = LOC'PRT'NO(HDR'DOC'TYPE)
        ENDIF
        ENDIF
        IF PRT'KSEQ # PRT'SEQ THEN
            \VUSE PRT - V''PTR2
            IF PRT'CTL # 0 THEN
                ENTRY = "Printer #: "+PRT'KSEQ+" for: "+HDR'VIA'NO+"-"+HDR'LOC'NO+" PRT="+PRT'SEQ
                CALL DO'ERR'OERCTLL
                ENTRY = "Queue invoice NOT run as requested"
                CALL DO'ERR'OERCTLL
                PRT'SPACE = SPACE
            ENDIF
        ENDIF
        \SEND'EMAIL LABEL="PRE'DO'EMAIL2" CHECK'IEMAIL="Y" ACTION="THIS'ACTION"
        IF HDR'CRID = "WBWHAP" AND EVER'EMAIL # 1 THEN !!EZID not found
            IF THIS'ACTION = "E" THEN
                ENTRY = "ERROR - Acknowledgement Email was not sent for HDR: "
            ELSE
                ENTRY = "ERROR - Invoice Email was not sent for HDR: "
            ENDIF
            \KERROR HDR CNO="N" MODE="D"
!           CALL DO'ERRL
            CALL LOG'ENTRY
        ENDIF
RETURN

PRE'DO'EMAIL2:
!!  IF STAT'EMAIL = 0 RETURN                !!KLUDGE no email address
    IF STAT'EMAIL = 0 AND (STAT'PRINT = 0 OR INSTR(1,PRT'DESC,"{") = 0) RETURN
    IF WCS'NO # HDR'NAM'NO AND STAT'EMAIL # 0 THEN
        IF HDR'CRID = "WB1XML" RETURN                    !!KLUDGE
        ENTRY = "BAD ERROR:  WCS not matching order!"
        \KERROR HDR MODE="D" CNO="N"
        GOTO DO'ERR                        !!KLUDGE
    ENDIF
    IF INC'INTERFACE # 5 THEN
        IF STAT'EMAIL = 0 RETURN
        IF DOING'MSG # 0 RETURN
    ENDIF
    IF DOING'MSG = 0 AND THIS'ACTION # "L" THEN
        GOTO DO'EMAIL                    !!KLUDGE
    ENDIF

    IF THIS'ACTION = "E" OR THIS'ACTION = "L" THEN
        \QMAIL'ACK HDR EMAIL'ADDRESS="WCS'EMAIL" RCN="HDR'RCN" AS'MSG="Y" &
            SUBJECT="DOING'MSG'SUBJECT" BODY="DOING'MSG'BODY"
    ELSE
        \QMAIL'INVOICE HDR C EMAIL'ADDRESS="WCS'EMAIL" RCN="HDR'RCN" AS'MSG="Y" &
            SUBJECT="DOING'MSG'SUBJECT" BODY="DOING'MSG'BODY"
    ENDIF
    ENTRY = DOING'MSG'SUBJECT
    CALL MSG'APPEND
    ENTRY = DOING'MSG'BODY
    CALL MSG'APPEND
RETURN

COPY "EMAIL",OERCTL="Y" USE'TAD="Y" USE'QMAIL="Y" ACTION="THIS'ACTION" !!DO'EMAIL:

\COPYF BAT AR MODE="DTA"
\COPYF CHK AR MODE="DTA"
\COPYF CKB CB MODE="PRI"

CASH'IT:
        CALL SET'TOTALS
        IF CALC'HTOTAL = 0 RETURN           !!KLUDGE
        BAT'SPACE = SPACE
        CHK'SPACE = SPACE
        DOC'SPACE = SPACE
        XCALL GETENV,"OE1WGA_TYP_UGL_NO",ENTRY
        IF ENTRY = "" RETURN                        !!KLUDGE
        DOC'UGL'NO = VAL(ENTRY)
        IF ARC'CB'YN = "Y" THEN
                XCALL GETENV,"OE1WGA_TYP_CKB_NO",ENTRY
                BAT'CKB'NO = VAL(ENTRY)
                IF CKB'NO # BAT'CKB'NO THEN
                        CKB'KNO = BAT'CKB'NO
                        USE CKB INTO CKB'REC KEY CKB'KEY
                        IF CKB'CTL # 0 THEN
                                CALL DELETE'PIC
                                ENTRY = "Invalid checkbook - aborting - panic now! "+CKB'KNO
                                CALL DO'ERR
                                GOTO ABORT
                        ENDIF
                ENDIF
                BAT'GLA'MACT(1) = CKB'MACT
                BAT'GLA'PTC(1) = CKB'PTC
                BAT'GLA'CST(1) = CKB'CST
                BAT'GLA'MACT(2) = CKB'DMACT
                BAT'GLA'PTC(2) = CKB'DPTC
                BAT'GLA'CST(2) = CKB'DCST
        ELSE
                BAT'GLA'MACT(1) = ARC'CMACT
                BAT'GLA'PTC(1) = ARC'CPTC
                BAT'GLA'CST(1) = ARC'CCST
                BAT'GLA'MACT(2) = ARC'DMACT
                BAT'GLA'PTC(2) = ARC'DPTC
                BAT'GLA'CST(2) = ARC'DCST
        ENDIF

        CHK'CHECK'DTT = DATE
        CALL SET'TOTALS
        CHK'AMT = CALC'HTOTAL
        DOC'AMT = CHK'AMT
        CHK'CHECK'NO = "Cash"
        DOC'AMT = CHK'AMT
        CALL CASH'IT2
RETURN

CASH'IT2:
        UPDATE HDR
        PRGNAM = "AR1OEU"
        FRM'PRGNAM = "DOPAY"
        ?TAB(24,1) ; TAB(-1,A'RED) ; "Posting to A/R ...";
        CALL DO'AR1OEU2
        ?TAB(24,1) ; TAB(-1,9) ;
        IF CMN'TO'PRGNAM # "GOOD" THEN
                ENTRY = "Did not post to A/R correctly!  Call for support."
                CALL DO'ERRL
                !!MAYBE ABORT AT THIS POINT?
        ELSE
                RDLOCK HDR
                HDR'OLD'CASH = HDR'SAV'OCASH
                UPDATE HDR
                CALL SET'TOTALS
        ENDIF
RETURN

MAP1 MOD'BASE,B,5
MAP1 PRV'TRACK'NO,S,25
MAP1 PRV'TRACK'NO2,S,26        !!they are different sizes
MAP1 PRV'TRACK'NO3,S,9
MAP1 SERV'TYPE,S,2
MAP1 DOING'CALL'TAG,S,1

SET'TRACK'NO:
        XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY
        IF ENTRY # "" THEN
            RETURN
        ENDIF
        IF OC2'TRACK'YN # "Y" RETURN
        IF UPC'RCN # UB'CNO THEN
                \READCTL APP="UP" GL="N" ABORT="PRE'DO'TIMPQU"
        ENDIF
MAP1 COD'STATUS,B,1
MAP1 THE'ONE'COD,S,1
CIF MALVERN AND NOT MALVERN THEN    !!**** Malven
        CALL OERCTL'SET'ADDR
        \USPS'CLEAN'PO L3LST
!!UPS Surepost and Basic
        CASE
        IF VIA'MTYPE = "U" AND (VIA'1Z'SERV = "PT" OR VIA'1Z'SERV = "YN" OR &
                    VIA'1Z'SERV = "YP" OR VIA'1Z'SERV = "YW") THEN
            DOING'CALL'TAG = "N"
            SERV'TYPE = VIA'1Z'SERV
            CALL SET'SLOC
            BOX'KHDR'LOC'NO = HDR'LOC'NO
            BOX'KDOC'TYPE = HDR'DOC'TYPE
            BOX'KHDR'NO = HDR'NO
            BOX'KSHIPMENT = HDR'SHIPMENT+1-ARCHIVE
            BOX'KNO = 1
            USE BOX INTO BOX'REC KEY BOX'KEY
            IF BOX'CTL # 0 THEN
                ENTRY = "1: No boxes on order!"
                CALL DO'ERR
                GOTO ABORT
            ENDIF
!!Malvern
            \UPSNUM ADDCNT="HDR'BOX'COUNT" FRSTRK="PRV'TRACK'NO" &
                    SERV="SERV'TYPE" CODSTAT="TRH'COD'STATUS"    &
                    TRACK'NO2="PRV'TRACK'NO2" TRACK'NO3="PRV'TRACK'NO3"

!!          IF PRV'TRACK'NO = "" THEN
!!              ENTRY = "No tracking number on this box; invalid shipment!"
!!              CALL DO'ERR
!!              GOTO ABORT
!!          ENDIF

            BOX'KHDR'LOC'NO = HDR'LOC'NO
            BOX'KDOC'TYPE = HDR'DOC'TYPE
            BOX'KHDR'NO = HDR'NO
            BOX'KSHIPMENT = HDR'SHIPMENT+1-ARCHIVE
            BOX'KNO = 1
            RDLOCK BOX INTO BOX'REC KEY BOX'KEY
            IF BOX'CTL # 0 THEN
                ENTRY = "2: No boxes on order!"
                \KERROR BOX CNO="N" APID="OE" MODE="K"
                CALL DO'ERR
                GOTO ABORT
            ENDIF
            \SETKEY BOX MODE="KY2"
            BOX'TRACK'NO = PRV'TRACK'NO
            BOX'TRACK'NO2 = PRV'TRACK'NO2
            BOX'TRACK'NO3 = PRV'TRACK'NO3
            \UPDKEY BOX MODE="KY2"
            WRITE BOX FROM BOX'REC
            IF VIA'1Z'SERV # "PT" THEN
                BOX'KHDR'LOC'NO = HDR'LOC'NO
                BOX'KDOC'TYPE = HDR'DOC'TYPE
                BOX'KHDR'NO = HDR'NO
                BOX'KSHIPMENT = HDR'SHIPMENT+1-ARCHIVE
                BOX'KNO = 2
                \LOOPER OPR="RDLOCK" PRE="BOX" ACTION="SET'TRACK'NO'SUREPOST"
            ENDIF
        ELSE
!!Non Resident to Canada
        IF VIA'MTYPE = "U" AND VIA'IMPORTER = "Y" AND (L3LST'COUNTRY = "CA" OR &
                            L3LST'COUNTRY = "CAN") AND TRH'COD'STATUS = 1 THEN
            DOING'CALL'TAG = "N"
            SERV'TYPE = VIA'1Z'SERV
            CALL SET'SLOC
            \UPSNUM ADDCNT="HDR'BOX'COUNT" FRSTRK="PRV'TRACK'NO" SERV="SERV'TYPE" &
                    CODSTAT="TRH'COD'STATUS"

            BOX'KHDR'LOC'NO = HDR'LOC'NO
            BOX'KDOC'TYPE = HDR'DOC'TYPE
            BOX'KHDR'NO = HDR'NO
            BOX'KSHIPMENT = HDR'SHIPMENT+1-ARCHIVE
            BOX'KNO = 1
            \LOOPER OPR="RDLOCK" PRE="BOX" ACTION="SET'NRI'TRACK'NO'UPS'NOT'BOX1"
        ELSE
        IF VIA'MTYPE = "U" OR VIA'MTYPE = "C" THEN
            DOING'CALL'TAG = "N"
            IF VIA'1Z'SERV # "" THEN
                IF ARC'INV'CR'YN(HDR'DOC'TYPE) = "Y" THEN
                    IF OEC'INT'CR # HDR'DOC'TYPE  AND &
                                OEC'MAN'YN = "Y"  AND &
                                VIA'MAN'YN # "N"  AND &
                                VIA'MAN'YN # "O" THEN
                        CALO'KDOC'TYPE = BOX'DOC'TYPE
                        CALO'KHDR'NO = BOX'HDR'NO
                        CALO'KNO = BOX'NO
                        USE CALO INTO CAL'REC KEY CALO'KEY
                        IF CALO'CTL = 0 THEN
                            IF CAL'PRINTED'YN = "N" THEN
                                DOING'CALL'TAG = "Y"
                            ELSE
                                ENTRY = " Call tag printed DOC'TYPE "+CALO'KDOC'TYPE+" HDR'NO "+CALO'KHDR'NO+" KNO "+CALO'KNO
                                \LABLOGGER ENTRY """/debug/oerctl_debug.DAILY"""  !![blm]
                                ENTRY = "Call tag printed!? "
                                \KERROR HDR CNO="N" MODE="D"
                                GOTO DO'ERRL        !!KLUDGE
                            ENDIF
                        ELSE
                            ENTRY = " CALO read failed DOC'TYPE "+CALO'KDOC'TYPE+" HDR'NO "+CALO'KHDR'NO+" KNO "+CALO'KNO
                            \LABLOGGER ENTRY """/debug/oerctl_debug.DAILY"""  !![blm]
                        ENDIF
                    ENDIF
                ENDIF
                IF DOING'CALL'TAG = "Y" THEN
                    SERV'TYPE = UPC'CALL'SERV
                ELSE
                    SERV'TYPE = VIA'1Z'SERV
                ENDIF
                CALL SET'SLOC
                THE'ONE'COD = "N"
                IF TRH'COD'STATUS = 1 THEN
!!Not COD -- just leave it
                    COD'STATUS = 1
                ELSE
!!OEPACK changes CUS'ONE'COD to Y if TRH'COD'STATUS = 2 AND OC2'ONE'COD'OVR = "Y"
                    IF (CUS'ONE'COD = "Y" AND HDR'BOX'COUNT > 1) OR &
                       (CUS'ONE'COD = "N" AND OC2'ONECOD'OVR = "Y" AND &
                            TRH'COD'STATUS = 2 AND HDR'BOX'COUNT > 1) THEN
!!One COD per order on multi-box order
                        THE'ONE'COD = "Y"
                        BOX'KHDR'LOC'NO = HDR'LOC'NO
                        BOX'KDOC'TYPE = HDR'DOC'TYPE
                        BOX'KHDR'NO = HDR'NO
                        BOX'KSHIPMENT = HDR'SHIPMENT+1-ARCHIVE
                        BOX'KNO = 1
                        USE BOX INTO BOX'REC KEY BOX'KEY
                        IF BOX'VALUE'YN = "Y" THEN
!!This means it's COD
                            COD'STATUS = TRH'COD'STATUS
                        ELSE
!!This means it's not COD
                            COD'STATUS = 1
                        ENDIF
                    ELSE
!!All boxes are COD 2 or 3
                        COD'STATUS = TRH'COD'STATUS
                    ENDIF
                ENDIF
                \UPSNUM ADDCNT="HDR'BOX'COUNT" FRSTRK="PRV'TRACK'NO" SERV="SERV'TYPE" CODSTAT="COD'STATUS"
            ENDIF
            IF HDR'SLOC = 0 THEN
                IF UPC'TBL'NO # 0 THEN HDR'SLOC = 1
            ENDIF
            IF DOING'CALL'TAG = "Y" THEN
                CLB'KCAL'LOC'NO = CAL'LOC'NO
                CLB'KCAL'NO = CAL'NO
                CLB'KNO = BOX'NO
                \LOOPER OPR="RDLOCK" PRE="CLB" ACTION="SET'TRACK'NO'CLB"
            ELSE
                BOX'KHDR'LOC'NO = HDR'LOC'NO
                BOX'KDOC'TYPE = HDR'DOC'TYPE
                BOX'KHDR'NO = HDR'NO
                BOX'KSHIPMENT = HDR'SHIPMENT+1-ARCHIVE
                BOX'KNO = 1
                \LOOPER OPR="RDLOCK" PRE="BOX" ACTION="SET'TRACK'NO'UPS'NOT'BOX1"
            ENDIF
        ENDCASE
ENDCIF                                !!MALVERN
RETURN

SET'TRACK'NO'SUREPOST:
    RETURN
CIF MALVERN AND NOT MALVERN THEN
    \NXTUPS PRV'TRACK'NO BOX'TRACK'NO TRACK'NO2="PRV'TRACK'NO2" TRACK'NO3="PRV'TRACK'NO3"
    PRV'TRACK'NO = BOX'TRACK'NO

    BOX'TRACK'NO = PRV'TRACK'NO
    BOX'TRACK'NO2 = PRV'TRACK'NO2
    BOX'TRACK'NO3 = PRV'TRACK'NO3
ENDCIF
RETURN

SET'NRI'TRACK'NO'UPS'NOT'BOX1:
    RETURN
CIF MALVERN AND NOT MALVERN THEN
    \NXTUPS PRV'TRACK'NO BOX'TRACK'NO
    PRV'TRACK'NO = BOX'TRACK'NO
ENDCIF
RETURN

SET'TRACK'NO'CLB:
    RETURN
CIF MALVERN AND NOT MALVERN THEN
        IF CLB'NO = 1 THEN
            CLB'TRACK'NO = PRV'TRACK'NO
        ELSE
            IF CLB'NO <= HDR'BOX'COUNT AND CUS'ONE'COD # "Y" THEN !!In case count is off
                \NXTUPS PRV'TRACK'NO CLB'TRACK'NO
                PRV'TRACK'NO = CLB'TRACK'NO
            ELSE
                \UPSNUM CLB'TRACK'NO SERV="UPC'CALL'SERV" CODSTAT="TRH'COD'STATUS"
            ENDIF
        ENDIF
        \SETKEY CLBT MODE="KEY"
        ADDKEY CLBT
        DO WHILE CLBT'CTL # 0  !!Ooops - duplicate
            \UPSNUM CLB'TRACK'NO CODSTAT="TRH'COD'STATUS"
            \SETKEY CLBT MODE="KEY"
            ADDKEY CLBT
        LOOP
        BOX'KHDR'LOC'NO = HDR'LOC'NO
        BOX'KDOC'TYPE = HDR'DOC'TYPE
        BOX'KHDR'NO = HDR'NO
        BOX'KSHIPMENT = HDR'SHIPMENT
        BOX'KNO = CLB'NO
        RDLOCK BOX INTO BOX'REC KEY BOX'KEY
        IF BOX'CTL = 0 THEN
            \SETKEY BOXT MODE="KEY"
            DELKEY BOXT
            BOX'TRACK'NO = CLB'TRACK'NO
            \SETKEY BOXT MODE="KEY"
            ADDKEY BOXT
            WRITE BOX
        ENDIF
ENDCIF
RETURN

SET'TRACK'NO'UPS'NOT'BOX1:
    RETURN
CIF MALVERN AND NOT MALVERN THEN
        IF VIA'1Z'SERV = "" THEN
            BOX'TRACK'NO = ""
            \SETKEY BOXT MODE="KEY"
            DELKEY BOXT                     !!A little cleanup action
            ENTRY = "Non UPS: "
            \KERROR BOX MODE="D" CNO="N"
            BOX'TRACK'NO = ENTRY
            \SETKEY BOXT MODE="KEY"
            ADDKEY BOXT
        ELSE
            IF BOX'NO = 1 THEN
                BOX'TRACK'NO = PRV'TRACK'NO
            ELSE
                IF HDR'CRID = "WBWHAP" AND OC2'ONECOD'OVR = "Y" THEN
                    IF TRH'COD'STATUS = 2 THEN    !! should be order terms
                        CUS'ONE'COD = "Y"
                    ENDIF
                ENDIF
                COD'STATUS = TRH'COD'STATUS
                IF THE'ONE'COD = "Y" THEN
                    IF BOX'VALUE'YN # "Y" THEN
!!This means it's not COD
                        COD'STATUS = 1
                    ENDIF
                    \UPSNUM BOX'TRACK'NO SERV="SERV'TYPE" CODSTAT="COD'STATUS"
                ELSE
                    \NXTUPS PRV'TRACK'NO BOX'TRACK'NO
                    PRV'TRACK'NO = BOX'TRACK'NO
                ENDIF
             ENDIF
             ENTRY = "P1: " : CALL VERIFY'TRACK'NO
             \SETKEY BOXT MODE="KEY"
             ADDKEY BOXT
             DO WHILE BOXT'CTL # 0  !!Ooops - duplicate
                 \UPSNUM BOX'TRACK'NO SERV="SERV'TYPE" CODSTAT="TRH'COD'STATUS"
                 ENTRY = "P2: " : CALL VERIFY'TRACK'NO
                 \SETKEY BOXT MODE="KEY"
                 ADDKEY BOXT
             LOOP
        ENDIF
ENDCIF
RETURN


MAP1 LAST'CNT,B,4
MAP1 END'CNT,B,4
MAP1 FST,S,12
MAP1 LST,S,12

GET'SEQ'PKG'ID:
    IF BOX'NO = 1 THEN
        RDLOCK UPC UB'CNO INTO UPC'REC
        LAST'CNT = UPC'LAST'PIECE + 1
        LAST'CNT = LAST'CNT MAX 10
        END'CNT = LAST'CNT + HDR'BOX'COUNT - 1
        IF END'CNT > 99999999 THEN
            LAST'CNT = 10
            END'CNT = LAST'CNT + HDR'BOX'COUNT - 1
        ENDIF
        UPC'LAST'PIECE = END'CNT
        WRITE UPC FROM UPC'REC
    ELSE
        LAST'CNT = LAST'CNT + 1
        IF LAST'CNT > END'CNT THEN
            RDLOCK UPC UB'CNO INTO UPC'REC
            UPC'LAST'PIECE = (UPC'LAST'PIECE+1) MAX LAST'CNT
            IF UPC'LAST'PIECE > 99999999 THEN
                LAST'CNT = 10
                UPC'LAST'PIECE = 10
                END'CNT = 10
            ENDIF
            WRITE UPC FROM UPC'REC
            LAST'CNT = UPC'LAST'PIECE
        ENDIF
    ENDIF
RETURN

MAP1 LAST'CN22'CNT,B,4

GET'SEQ'CUSTOMS'ID:
    IF BOX'NO = 1 THEN
        RDLOCK UPC UB'CNO INTO UPC'REC
        LAST'CN22'CNT = UPC'CN22'CNT + 1
        LAST'CN22'CNT = LAST'CN22'CNT MAX 10
        END'CNT = LAST'CN22'CNT + HDR'BOX'COUNT - 1
        IF END'CNT > 99999999 THEN
            LAST'CN22'CNT = 10
            END'CNT = LAST'CN22'CNT + HDR'BOX'COUNT - 1
        ENDIF
        UPC'CN22'CNT = END'CNT
        WRITE UPC FROM UPC'REC
    ELSE
        LAST'CN22'CNT = LAST'CN22'CNT + 1
        IF LAST'CN22'CNT > END'CNT THEN
            RDLOCK UPC UB'CNO INTO UPC'REC
            UPC'CN22'CNT = (UPC'CN22'CNT+1) MAX LAST'CN22'CNT
            IF UPC'CN22'CNT > 99999999 THEN
                LAST'CN22'CNT = 10
                UPC'CN22'CNT = 10
                END'CNT = 10
            ENDIF
            WRITE UPC FROM UPC'REC
            LAST'CN22'CNT = UPC'CN22'CNT
        ENDIF
    ENDIF
RETURN

MAP1 MY'TRACK'NO,S,25
MAP1 MY'CHECK,B,1

VERIFY'TRACK'NO:                !!Set ENTRY before calling this
        MY'TRACK'NO = BOX'TRACK'NO[1;17]
        \CHKDGT UPSNO="MY'TRACK'NO" CHKDGT="MY'CHECK"
        IF VAL(BOX'TRACK'NO[18;1]) # MY'CHECK THEN
                ENTRY = ENTRY + "Invalid 1Z number on "
                \KERROR BOX MODE="D" CNO="N"
                ENTRY = ENTRY + " old="+BOX'TRACK'NO+" new="
                BOX'TRACK'NO[18;1] = MY'CHECK
                ENTRY = ENTRY + BOX'TRACK'NO
                ENTRY = ENTRY + " fixed before written to disk!"
                \ABLOGGER ENTRY WL'DEBUG
        ENDIF
RETURN

MAP1 MIN'CCFRT,B,5
MAP1 DO'HOB,B,1

PICK'AUTHORIZE'CREDIT'CARD:
    IF WL'DEBUG # "" THEN
        ENTRY = "Authorize credit card: "
        \KERROR HDR MODE="D" APID="OE" CNO="N"
        ENTRY = ENTRY + " hold="+HDR'HOLD'YN+" CC="+CC'FAILED
        \ABLOGGER ENTRY WL'DEBUG
    ENDIF
    CC'RESPONSE = ""
    IF TRH'CTP'NO = 0 RETURN                    !!KLUDGE
    DO'HOB = 0
    IF WL'PICKING'CC = 0 THEN
        XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY
        IF ENTRY = "" THEN
            XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PICK_MIN_CCFRT",ENTRY
            MIN'CCFRT = VAL(ENTRY)
            IF ENTRY # "" THEN
                DO'HOB = 1
            ENDIF
        ELSE
            MIN'CCFRT = 0
            DO'HOB = 1            !!HOB order
        ENDIF
    ENDIF
    \UCNVATQ AKEY="Y"
    USE ATQT INTO ATQ'REC KEY ATQT'KEY
    IF ATQT'CTL = 0 THEN
        IF DO'HOB = 0 AND WL'PICKING'CC = 0 THEN
!!HOB and special One Stop case always auth the card
            \WHATCC ATQ'CARDNO JJ
            CASE
            IF JJ = 1 OR JJ = 2 THEN
                JJ = CVC'VISA'HOURS
            ELSE
            IF JJ = 3 THEN
                JJ = CVC'AMEX'HOURS
            ELSE
            IF JJ = 5 THEN
                JJ = CVC'DISC'HOURS
            ELSE
                CC'FAILED = 1
                ENTRY = "Invalid card type1!"+PAC'FCARDNO
                CC'RESPONSE = ENTRY
                GOTO DO'ERR
            ENDCASE
!!Standard tickets will not auth if there are ANY hours for that card type
!!because of the RETURN below ...
            IF JJ # 0 RETURN                    !!KLUDGE
        ENDIF
A1'PRE'AUTH:
        CALL PRE'AUTHORIZE'CREDIT'CARD
        ENTRY = "A1) "
        CALL LOG'AUTH
A1'AUTH:
    ELSE
        CC'FAILED = 1
        ENTRY = "Cannot find atqt record."
        CC'RESPONSE = ENTRY
        GOTO DO'ERR
    ENDIF
PICK'AUTH'CC'RET:
RETURN

PRE'AUTHORIZE'CREDIT'CARD:

    CALL AUTHORIZE'CREDIT'CARD
    IF CC'FAILED = 1 THEN
        HDR'HOLD'YN = "7"
        UPDATE HDR FROM HDR'REC
        REL ATQT
        IF WL'DEBUG # "" THEN
            ENTRY = "Pre authorize cc: "
            \KERROR HDR MODE="D" APID="OE" CNO="N"
            ENTRY = ENTRY + " hold="+HDR'HOLD'YN+" CC="+CC'FAILED
            \ABLOGGER ENTRY WL'DEBUG
        ENDIF
PRE'AUTH'CC'FAIL'RET:
        RETURN          !!KLUDGE
    ELSE
        IF HDR'POST'LEVEL # 111 AND ATQ'STATUS = "A" THEN
            IF CVC'TRAN'TYPE = "N" OR ATQ'ELECTRONIC # "Y" THEN
                CALL SETTLE'CREDIT'CARD
            ENDIF
        ENDIF
        REL ATQT
    ENDIF
A2'AUTH:
    ENTRY = "A2) "
    CALL LOG'AUTH
PRE'AUTH'CC'RET:
RETURN

GET'TRACK'NOS:
    VIA'KNO = HDR'VIA'NO
    USE VIA INTO VIA'REC KEY VIA'KEY
    IF VIA'CTL # 0 THEN
        ENTRY = "Cannot read VIA: "+VIA'KNO
        \HDRERR
        CALL DO'ERRL
        GOTO ABORT
    ENDIF
    ENTRY = "Get track nos: "+HDR'VIA'NO+" TYPE="+VIA'MTYPE
    \HDRERR
    CALL SNDMON
    CALL LOG'ENTRY
    IF VIA'MTYPE = "G" OR VIA'MTYPE = "F" OR VIA'MTYPE = "E" OR VIA'MTYPE = "A" THEN
        IF HDR'LIN'TOTAL >= 0 THEN
            IF TESTING = "" THEN
                XCALL GETENV,"USPS_TESTING",TESTING
                IF TESTING # "Y" THEN TESTING = "N"
                \READCTL APID="UP" GL="N"
                XCALL GETENV,"USPS_SEPARATE_PAGE",SEP'PAGE
                IF USPS'TESTING = "Y" THEN
                    ENTRY = "WARNING:  in test mode!"
                    CALL DO'ERR
                ENDIF
            ENDIF
            IF VIA'MTYPE # "A" THEN
                CALL OERCTL'SET'ADDR
                \USPS'CLEAN'PO L3LST
                IF VIA'MTYPE = "F" AND VIA'MAN'YN # "E" THEN
                    IF USPS'PO'BOX # 0 THEN
                        ENTRY = "Cannot Fedex to a PO Box!"
                        CALL SNDMON
                        CALL DO'ERR
                        GOTO ABORT
                    ENDIF
                    \DG GETVALUE _UPSETUP FedexAllowNonUS ENTRY
                    IF DG'CTL # 0 OR ENTRY # "Y" THEN
                        IF USPS'CUSTOMS # 0 THEN
                            ENTRY = "Cannot Fedex overseas! CUSTOMS="+USPS'CUSTOMS
                            CALL SNDMON
                            CALL DO'ERR
                            GOTO ABORT
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
            \COPYF BOX OE BOX8 MODE="PRI"
            BOX8'KHDR'LOC'NO = HDR'LOC'NO
            BOX8'KDOC'TYPE = HDR'DOC'TYPE
            BOX8'KHDR'NO = HDR'NO
            BOX8'KSHIPMENT = HDR'SHIPMENT+1-ARCHIVE
            BOX8'KNO = 1
            USE BOX8 INTO BOX'REC KEY BOX8'KEY
            DO
                GETNXT BOX8 INTO BOX'REC
                \CHKKEY BOX ALTKEY="BOX8"
                IF BOX8'CTL # 0 EXIT
                RDLOCK BOX BOX8'RCN INTO BOX'REC
                IF BOX'CTL # 0 REPEAT
                IF BOX'TRACK'NO # "" THEN
                    \SETKEY BOXT MODE="KEY"
                    DELKEY BOXT
                ENDIF
                CALL GET'TRACK'NO
                IF VIA'MTYPE = "A" AND BOX'TRACK'NO = "" THEN
                    BOX'TRACK'NO = STR(BOX'RCN)+"-"+STR(BOX'HDR'NO)+"-"+STR(BOX'NO)
                ENDIF
                IF BOX'TRACK'NO # "" THEN
                    \SETKEY BOXT MODE="KEY"
                    ADDKEY BOXT
                ENDIF
                WRITE BOX FROM BOX'REC
            LOOP
!!          \LOOPER OPR="RDLOCK" PRE="BOX" ACTION="GET'TRACK'NO"
        ENDIF
    ENDIF
RETURN

GET'TRACK'NO:
    ENTRY = "For order: "
    \KERROR HDR MODE="D" CNO="N"
    LTMP = ENTRY
    IF BOX'TRACK'NO # "" RETURN            !!Already have it
    CASE
    IF VIA'MTYPE = "A" THEN
        CALL GET'AMAZON'TRACK'NO
    ELSE
    IF VIA'MTYPE = "E" THEN
        CALL GET'ENDICIA'TRACK'NO
    ELSE
    IF VIA'MTYPE = "G" THEN
        CALL GET'USPS'TRACK'NO
    ELSE
    IF VIA'MTYPE = "F" AND VIA'MAN'NO = 0 THEN
        CALL GET'FEDEX'TRACK'NO
    ENDCASE
RETURN

\COPYF WNG WB

ADD'WNG'RECORD:
    WNG'HDR'LOC'NO = HDR'LOC'NO
    WNG'DOC'TYPE = HDR'DOC'TYPE
    WNG'HDR'NO = HDR'NO
    WNG'SHIPMENT = HDR'SHIPMENT + 1
    WNG'PO = HDR'PO
    WNG'STAT = "B"
    \SETKEY WNG MODE="KEY" APID="WB"
    ADDL WNG FROM WNG'REC KEY WNG'KEY
    IF WNG'CTL = 0 THEN
        \SETKEY WNG MODE="KY2" APID="WB"
        \ADDKEY WNG MODE="KY2" APID="WB"
        REL WNG
    ENDIF
RETURN

MAP1 BOXNO,B,1
MAP1 COUNT,B,1

GET'AMAZON'TRACK'NO:
    IF HDR'BOX'COUNT > 1 THEN
        WNG'SPACE = SPACE
        WNG'REASON = "Multi Box Order, "+HDR'BOX'COUNT+ " boxes total"
        ENTRY = WNG'REASON
        CALL SNDMON
        ENTRY = "Will print temporary labels for them"
        CALL SNDMON
        CALL ADD'WNG'RECORD
        GOTO AMAZON'BAD'LABEL
        RETURN                        !!KLUDGE
    ENDIF

    FUC'SPACE = SPACE
    FUCC'KCUS'NO = HDR'NAM'NO
    USE FUCC INTO FUC'REC KEY FUCC'KEY
    IF FUCC'CTL # 0 THEN
        WNG'SPACE = SPACE
        WNG'REASON = "No fullfillment customer"
        CALL ADD'WNG'RECORD
        GOTO AMAZON'BAD'LABEL
        RETURN
    ENDIF
!!Client directory
    TMP = FUC'CLIENT
    IF FUC'CLIENT[1;1] # "/" THEN
        FUC'CLIENT = "/"+FUC'CLIENT
    ENDIF

!!Lookup xml file to get the tracking number
    TMP = "/docroot"+FUC'CLIENT+"/zpl"
    TMP = TMP + "/lbl_"+HDR'PO+".xml"
    LOOKUP TMP,XX
    IF XX = 0 THEN
        ENTRY = "/lbl_"+HDR'PO+".xml"
        WNG'SPACE = SPACE
        WNG'REASON = "No zpl file "+ENTRY +" for po "+ HDR'PO
        CALL ADD'WNG'RECORD
        GOTO AMAZON'BAD'LABEL
        RETURN                        !!KLUDGE
    ENDIF
    ENTRY = ""
    FNAME = TMP
    \DG LOADFILE LBL ENTRY FNAME
    IF DG'CTL # 0 OR LCS(ENTRY) # "label" THEN
        WNG'SPACE = SPACE
        WNG'REASON = "Cannot load: "+FNAME+ " for tracking"
        CALL ADD'WNG'RECORD
        GOTO AMAZON'BAD'LABEL
        RETURN                        !!KLUDGE
    ENDIF
    \DG GETVALUE LBL box.tracking BOX'TRACK'NO
    IF DG'CTL # 0 OR BOX'TRACK'NO = "" THEN
        WNG'SPACE = SPACE
        WNG'REASON = "Tracking # not found: "+TMP
        CALL ADD'WNG'RECORD
        GOTO AMAZON'BAD'LABEL
        RETURN                        !!KLUDGE
    ENDIF
!!Lookup label file for the zpl file
    TMP1 = "/docroot"+FUC'CLIENT+"/zpl"
    TMP1 = TMP1 + "/lbl_"+LCS(HDR'PO)+"_1.zpl"
    LOOKUP TMP1,XX
    IF XX = 0 THEN
        WNG'SPACE = SPACE
        WNG'REASON = "Cannot find: "+ TMP1 + " to load zpl label file"
        CALL ADD'WNG'RECORD
        GOTO AMAZON'BAD'LABEL
        RETURN                        !!KLUDGE
    ELSE
        CALL ADD'TWO'INCHES                !!addtwo.cpy
        ENTRY = "Amazon label complete: "
        \HDRERR
        CALL SNDMON
    ENDIF
RETURN

COPY "ADDTWO",PRGNAM="OERCTL"

GET'FEDEX'TRACK'NO:
    LENTRY = "GET'FEDEX'TRACK'NO:" : \LOG'IT
    XCALL VICSIT,254,ZZZ
    IF ZZZ = 577400 THEN
        RETURN
    ENDIF
    ETIME = 0
    CASE
    IF (VIA'MAN'YN = "J" OR VIA'MAN'YN = "K" OR VIA'MAN'YN = "L" OR &
            VIA'MAN'YN = "M") AND VIA'FINT'YN = "Y" THEN
        CALL PROCESS'SHIPMENT'REQUEST
    ELSE
    IF VIA'MAN'YN = "E" AND USPS'CUSTOMS > 0 THEN
!!APO/FPO
        CALL PROCESS'SHIPMENT'REQUEST
    ELSE
!!USPS'CUSTOMS negative is internationl
    IF VIA'MAN'YN = "E" AND USPS'CUSTOMS < 0 THEN
        CALL PROCESS'SHIPMENT'REQUEST
    ELSE
    IF USPS'CUSTOMS = 0 THEN                 !!Domestic
        CALL PROCESS'SHIPMENT'REQUEST        !!fedex.cpy
    ENDCASE
    TMP = "/lbl/fdx"+STR(HDR'NO)+".1"
    LOOKUP TMP,XX
    IF XX = 0 THEN
        ENTRY = "No FedEx label (oerctl)"+TMP
        IF WL'DEBUG # "" THEN
            CALL LOG'ENTRY
        ENDIF
        CALL DO'ERR'OERCTLL
        GOTO ABORT
    ELSE
        OPEN #127,TMP, INPUT
        DO
            INPUT LINE #127, ENTRY
            IF EOF(127) # 0 EXIT
            IF ENTRY[1;3] = "^XZ" OR ENTRY[1;2] = "P1" EXIT
        LOOP
        CLOSE #127
        IF ENTRY # "^XZ" AND ENTRY # "P1" THEN
            ENTRY = "Invalid Fedex label (oerctl), no ^XZ or P1"
            \KERROR HDR CNO="N" MODE="D"
            IF WL'DEBUG # "" THEN
                CALL LOG'ENTRY
            ENDIF
            CALL DO'ERR'OERCTLL
            GOTO ABORT
        ENDIF
    ENDIF
    ENTRY = "Fedex label request time: "+STR(ETIME)
    \HDRERR
    CALL SNDMON
    !!MAKE CORRECT CALL based on BOX'REC (HDR'REC && L3LST'REC)
    !!set BOX'TRACK'NO and print label
RETURN

MAP1 SEP'PAGE,S,1
MAP1 TESTING,S,1
MAP1 III,F
MAP1 TNAME,S,200
MAP1 LABEL'SIZE,B,5

GET'USPS'TRACK'NO:
    LENTRY = "GET'USPS'TRACK'NO:" : \LOG'IT
!!USPS'CUSTOMS,F  !!0=No (domestic),
!!negative is International,
!!plus is APO/FPO where if = 99 "APO" is in the city, 1-5 is address 1-5 has "APO"
    IF USPS'CUSTOMS = 0 THEN            !!Domestic
!!Label
        CALL CONFIRMATION'TRACK'NO
        IF L3LST'ST = "AS" OR L3LST'ST = "FM" OR &
                L3LST'ST = "MH" OR L3LST'ST = "MP" OR L3LST'ST = "PW" OR &
                L3LST'ST = "VI" OR L3LST'ST = "GU" THEN
            CALL DO'CUSTOMS'FORM
        ENDIF
    ELSE                                !!International and APO/FPO
!!Label
        IF USPS'CUSTOMS < 0 THEN
            CALL CUSTOMS'TRACK'NO
        ELSE
            CALL CONFIRMATION'TRACK'NO
        ENDIF
!!Customs form
        CALL DO'CUSTOMS'FORM            !!Always
        \DG RELEASEALL
    ENDIF
RETURN

GET'ENDICIA'TRACK'NO:
    LENTRY = "GET'ENDICIA'TRACK'NO:" : \LOG'IT
!!USPS'CUSTOMS,F  !!0=No (domestic),
!!negative is International,
!!plus is APO/FPO where if = 99 "APO" is in the city, 1-5 is address 1-5 has "APO"
    IF USPS'CUSTOMS = 0 THEN            !!Domestic
        LABEL'TYPE = "Domestic"
        IF L3LST'ST = "AS" OR L3LST'ST = "FM" OR &
                L3LST'ST = "MH" OR L3LST'ST = "MP" OR L3LST'ST = "PW" OR &
                L3LST'ST = "GU" THEN
            LABEL'SUB'TYPE = "Integrated"
        ELSE
            LABEL'SUB'TYPE = ""
        ENDIF
    ELSE                                !!International and APO/FPO
        IF USPS'CUSTOMS < 0 THEN
            LABEL'TYPE = "International"
            LABEL'SUB'TYPE = "Integrated"
        ELSE
            LABEL'TYPE = "Domestic"
            LABEL'SUB'TYPE = "Integrated"     !!APO/FPO
        ENDIF
    ENDIF
    ETIME = 0
    CIF TIME'WANTED THEN
        LCL1 T1,F
        XCALL ABUTIL,80,T1
    ENDCIF
    CALL LABEL'REQUEST                        !!Endicia.cpy
    CIF TIME'WANTED THEN
        XCALL ABUTIL,80,|TIME'WANTED|
        |TIME'WANTED| = |TIME'WANTED| - T1
    ENDCIF
    ENTRY = "Endicia label request time: "+STR(ETIME)
    \HDRERR
    CALL SNDMON

    XCALL VICSIT,254,ZZZ
    IF ZZZ = 577400 THEN
        RETURN
    ENDIF

    ENTRY = "/lbl/end"+STR(HDR'NO)+".1"
    LOOKUP ENTRY,XX
    IF XX = 0 THEN
        ENTRY = "No Endicia label (oerctl)"+ENTRY
        IF WL'DEBUG # "" THEN
            CALL LOG'ENTRY
        ENDIF
        CALL DO'ERR'OERCTLL
        GOTO ABORT
    ELSE
        OPEN #127,ENTRY, INPUT
        DO
            INPUT LINE #127, ENTRY
            IF EOF(127) # 0 EXIT
            IF ENTRY[1;3] = "^XZ" EXIT
        LOOP
        CLOSE #127
        IF ENTRY # "^XZ" THEN
            ENTRY = "Invalid Endicia label (oerctl), no ^XZ"
            \KERROR HDR CNO="N" MODE="D"
            IF WL'DEBUG # "" THEN
                CALL LOG'ENTRY
            ENDIF
            CALL DO'ERR'OERCTLL
            GOTO ABORT
        ENDIF
    ENDIF
RETURN

MAP1 ALT'SHIP'FROM,B,1    !!0=ship from is Morris (no need for AVS, see fedex.cpy)
                          !!1=customer supplied ship from, check AVS
\COPYF LST MC L3LST  !! used in USPS.MAC to stuff Ship To variables
\COPYF LST MC L1LST  !! used for return address
\COPYF TAD OE
MAP1 SAVE'LOC'ZIP,S,9
\COPYF UPS IN
MAP1 HAVE'L3LST'TAD,B,1

MAP1 LBLRTN,S,100
MAP1 DO'BILL'ADDR,B,1   !!0=take from TAD if sent, else take from LOC'REC
                        !!1=take from HDR'NAM'NO
                        !!This is the return address printed
MAP1 LLF,F

!!This is really only for fedex and usps as labels are made here.
!!This is only for USPS and FedEx labels only; other shipping methods in invoice program
!!UPS calls this to check address
OERCTL'SET'ADDR:
    LENTRY = "OERCTL'SET'ADDR:" : \LOG'IT
    DO'BILL'ADDR = 0    !!Normal people do it normal way ...
    CASE
    IF HDR'CRID = "WB1XML" OR HDR'CRID = "WBLOAD" OR HDR'SHIP'BLIND = "Y" THEN
!!Morris only on the 1st two, thinc, ostp use the blind
!!Loaded from XML (BC) or from mass load
!!BC and Johnson Smith orders use their return address
        DO'BILL'ADDR = 1
    ELSE
    IF (VIA'MTYPE = "F" OR VIA'MTYPE = "U") AND VIA'CHG'TYPE = "TPB" THEN
        DO'BILL'ADDR = 1
    ELSE
    IF LBLRTN = "NO" THEN
!!No file, be normal
        DO'BILL'ADDR = 0
    ELSE
    IF LBLRTN = "" THEN
        TMP = ""
        \ADDPATH OUTPUT="TMP" APID="OE" MODE="P"
        LBLRTN = TMP + "lblrtn.ini"
        LOOKUP LBLRTN,LLF
        IF LLF = 0 THEN
!!No file, be normal
            LBLRTN = "NO"
        ENDIF
    ENDCASE
    IF LBLRTN # "NO" AND DO'BILL'ADDR = 0 AND LBLRTN # "" THEN
          !!Only Morris uses this ...
        \GETPROFILE LBLRTN STR(HDR'NAM'NO) ENTRY
        IF UCS(ENTRY) = "Y" THEN
            DO'BILL'ADDR = 1
        ELSE
            DO'BILL'ADDR = 0
        ENDIF
    ENDIF
    \USELST LOC'LST'NO
    L1LST'REC = LST'REC !!This is PRINTED return address, NOT always Morris's Location
                        !!at this point it is Morris's address but
                        !!if DO'BILL'ADDR is set above it can change

    SAVE'LOC'ZIP = LST'ZIP        !!For USPS labels
    UPS'KLOC'NO = HDR'LOC'NO
    UPS'KMTYPE = "G"
    USE UPS INTO UPS'REC KEY UPS'KEY
    IF UPS'CTL = 0 AND LEN(UPS'OR'ZIPCODE) = 5 THEN
        SAVE'LOC'ZIP = UPS'OR'ZIPCODE
    ENDIF
!!SAVE'LOC'ZIP is the actual LOC->LST'ZIP so we know if different from printed

    IF DO'BILL'ADDR = 1 THEN
!So far L1LST has location address
           \USELST HDR'NAM'NO            !!Set from customer
        CALL SET'L1LST'FROM'LST
    ELSE
!!      it is set from LOC'LST'NO
        ALT'SHIP'FROM = 0
    ENDIF

    HAVE'L3LST'TAD = 0        !!Set if LST is really from TAD for L3LST

    TAD'KBS = "S"
    TAD'KHDR'LOC'NO = HDR'LOC'NO
    TAD'KDOC'TYPE = HDR'DOC'TYPE
    TAD'KHDR'NO = HDR'NO
    USE TAD INTO TAD'REC KEY TAD'KEY
    IF TAD'CTL = 0 AND TAD'BOTH'YN = "Y" THEN
        CALL OERCTL'SET'LST'FROM'TAD            !!One TAD for both bill and ship
        HAVE'L3LST'TAD = 1
!!It would be sick and wrong to set L1 unless both TADs exist
!!because bill and ship would be the same ...
    ELSE
        TAD'KBS = "B"
        USE TAD INTO TAD'REC KEY TAD'KEY
        IF TAD'CTL = 0 THEN
            CALL OERCTL'SET'LST'FROM'TAD
            IF TAD'BOTH'YN = "Y" THEN
!!It would be sick and wrong to set L1 unless both TADs exist
!!because bill and ship would be the same ...
                HAVE'L3LST'TAD = 1
            ELSE
            IF DO'BILL'ADDR = 0 THEN
                CALL SET'L1LST'FROM'LST
            ENDIF
            ENDIF
        ENDIF
    ENDIF
    IF HAVE'L3LST'TAD = 0 THEN
        TAD'KBS = "S"
        USE TAD INTO TAD'REC KEY TAD'KEY
        IF TAD'CTL = 0 THEN
            CALL OERCTL'SET'LST'FROM'TAD
            HAVE'L3LST'TAD = 1
        ELSE
            IF HDR'SHIP'TO # 0 OR HDR'SHP'NO # 0 THEN
                IF HDR'DROP'YN = "N" THEN HDR'SHP'NO = HDR'NAM'NO
                \NTABLST PRE="CUS" FLDNAM="HDR'SHP'NO" DSP="Y"  &
                                                    ALTFLD="HDR'SHIP'TO"
                ALT'SHIP'FROM = 1
                IF HDR'DROP'YN = "N" THEN HDR'SHP'NO = 0
            ELSE
                \USELST HDR'NAM'NO
            ENDIF
        ENDIF
    ENDIF
!!If only a name filled in
    IF VIA'MTYPE # "F" THEN
        IF LST'COMPANY = "" THEN
            IF LST'FIRST = "" THEN
                LST'COMPANY = LST'LAST
            ELSE
                LST'COMPANY = LST'FIRST + " " + LST'LAST
            ENDIF
        ENDIF
    ENDIF

    IF HAVE'L3LST'TAD = 0 THEN
        IF WCS'CUS'NO = CUS'NO AND WCS'CONTACT # "" AND LST'LAST = "" AND &
                                                    LST'FIRST = "" THEN
            LST'FIRST = "Attn"
            LST'LAST = WCS'CONTACT
        ENDIF
    ENDIF

    IF VIA'MTYPE = "G" AND VIA'MAN'YN # "E" THEN
!!USPS
        IF LST'ADDR(2) = "" AND (LST'LAST # "" OR LST'FIRST # "") THEN
              LST'ADDR(2) = LST'ADDR(1)
              LST'ADDR(1) = "Attn: " + LST'FIRST + " " +LST'LAST
        ENDIF
    ENDIF

    L3LST'REC = LST'REC
!!fedex makes the EPL/ZPL code and we get it back and fedex.cpy only uses
!!        L1LST'REC and L3LST'REC ... USPS we make the label and it uses
!!        ADDR2() for part of it. Hardcode 150 is only Morris, could do it
!!        in _UPSETUP if we need.
    IF VIA'MTYPE = "G" THEN
        \NFMTADR ADDRESS="ADDR2" MAXI="7" FMT="150"
    ENDIF
RETURN

OERCTL'SET'LST'FROM'TAD:
    LST'SPACE = SPACE
    LST'LAB'YN = "N"
    LST'NO = HDR'NAM'NO
    LST'COMPANY = TAD'COMPANY
    LST'LAST = TAD'NAME
    LST'ADDR1 = TAD'ADDR1
    LST'ADDR2 = TAD'ADDR2
    LST'CITY = TAD'CITY
    LST'ST = TAD'ST
    LST'ZIP = TAD'ZIP
    LST'COUNTRY = TAD'COUNTRY
    LST'RES'YN = TAD'RES'YN
    LST'PHONE1 = TAD'PHONE
RETURN

MAP1 LNAME,S,200
MAP1 CNAME,S,200
MAP1 ILINE,S,1000

CONFIRMATION'TRACK'NO:
    LENTRY = "CONFIRMATION'TRACK'NO" : \LOG'IT
!!  \ADDPATH UP MODE="D"
!!  LNAME = ENTRY + "d/usps_label_"+LCS(VIA'MAN'YN)+"_"+STR(HDR'LOC'NO)+".template"
!!  LOOKUP LNAME,II
!!  IF II = 0 THEN
!!      ENTRY = "Label permit not found: "+LNAME
!!      CALL DO'ERR
!!      GOTO ABORT
!!  ENDIF
    \DG NEW USPS USPS
    IF VIA'MAN'YN = "E" THEN
        IF TESTING = "Y" THEN
            \DG ADDCHILD USPS OUT ExpressMailLabelCertifyRequest
            \DG SETVALUE USPS ExpressMailLabelCertifyRequest UPC'USERID ATTR="USERID"
            \DG SETVALUE USPS ExpressMailLabelCertifyRequest UPC'PASSWORD ATTR="PASSWORD"
        ELSE
            \DG ADDCHILD USPS OUT ExpressMailLabelRequest
            \DG SETVALUE USPS ExpressMailLabelRequest UPC'USERID ATTR="USERID"
            \DG SETVALUE USPS ExpressMailLabelRequest UPC'PASSWORD ATTR="PASSWORD"
        ENDIF
        ENTRY = ""
    ELSE
        IF TESTING = "Y" THEN
            \DG ADDCHILD USPS OUT DelivConfirmCertifyV30Request
            \DG SETVALUE USPS DelivConfirmCertifyV30Request UPC'USERID ATTR="USERID"
            \DG SETVALUE USPS DelivConfirmCertifyV30Request UPC'PASSWORD ATTR="PASSWORD"
        ELSE
            \DG ADDCHILD USPS OUT DeliveryConfirmationV30Request
            \DG SETVALUE USPS DeliveryConfirmationV30Request UPC'USERID ATTR="USERID"
            \DG SETVALUE USPS DeliveryConfirmationV30Request UPC'PASSWORD ATTR="PASSWORD"
        ENDIF
        ENTRY = "1"
    ENDIF
    \DG SETVALUE OUT Option ENTRY
    IF VIA'MAN'YN = "E" THEN
        ENTRY = ""
        \DG SETVALUE OUT EMCAAccount ENTRY
        \DG SETVALUE OUT EMCAPassword ENTRY
    ENDIF
    ENTRY = ""
    \DG SETVALUE OUT ImageParameters ENTRY
    IF VIA'MAN'YN = "E" THEN
        ENTRY = "From:"
        \DG SETVALUE OUT FromFirstName ENTRY
        \DG SETVALUE OUT FromLastName UB'NAME
        ENTRY = ""
    ELSE
        \DG SETVALUE OUT FromName UB'NAME
    ENDIF
    \DG SETVALUE OUT FromFirm L1LST'COMPANY
    \USPS'CLEAN'PO L1LST
    \DG SETVALUE OUT FromAddress1 USPS'ADDR2
    \DG SETVALUE OUT FromAddress2 USPS'ADDR1
    \DG SETVALUE OUT FromCity L1LST'CITY
    \DG SETVALUE OUT FromState L1LST'ST
    \DG SETVALUE OUT FromZip5 L1LST'ZIP[1;5]
    IF LEN(L1LST'ZIP) = 9 AND L1LST'ZIP[6,9] # "0000" THEN
        ENTRY = L1LST'ZIP[6,9]
    ELSE
        ENTRY = ""
    ENDIF
    \DG SETVALUE OUT FromZip4 ENTRY
    IF VIA'MAN'YN = "E" THEN
        MAP1 K,F
        ENTRY = ""
        FOR K = 1 TO LEN(L1LST'PHONE1)
            IF L1LST'PHONE1[K;1] >= "0" AND L1LST'PHONE1[K;1] <= "9" THEN
                ENTRY = ENTRY + L1LST'PHONE1[K;1]
            ENDIF
        NEXT K
        L1LST'PHONE1 = ENTRY
        IF L1LST'PHONE1 = "" THEN
            L1LST'PHONE1 = CMP'AC + CMP'PHONE
        ENDIF
        \DG SETVALUE OUT FromPhone L1LST'PHONE1[1;10]
        CASE
        IF L3LST'FIRST # "" THEN
            IF L3LST'LAST # "" THEN
                \DGSETVALUE OUT ToFirstName L3LST'FIRST
                \DGSETVALUE OUT ToLastName L3LST'LAST
            ELSE
                    !!Move first name into last name
                ENTRY = "Attn"
                \DGSETVALUE OUT ToFirstName ENTRY
                \DGSETVALUE OUT ToLastName L3LST'FIRST
            ENDIF
        ELSE
        IF L3LST'LAST # "" THEN
            ENTRY = "Attn"
            \DGSETVALUE OUT ToFirstName ENTRY
            \DGSETVALUE OUT ToLastName L3LST'LAST
        ELSE
        IF L3LST'FIRST = "" AND L3LST'LAST = "" THEN
                !!put company name in last name
            ENTRY = "To: "
            \DG SETVALUE OUT ToFirstName ENTRY
            \DG SETVALUE OUT ToLastName L1LST'COMPANY
        ELSE
                !!Should never get here
            ENTRY = "Must have a first or last name for express mail!"
            CALL DO'ERR
            GOTO ABORT
        ENDCASE
    ELSE
        CASE
        IF WCS'CUS'NO = CUS'NO AND WCS'CONTACT # "" THEN
            ENTRY = WCS'CONTACT
        ELSE
        IF L3LST'LAST # "" THEN
            ENTRY = L3LST'FIRST + " " + L3LST'LAST
        ELSE
        IF L3LST'FIRST # "" THEN
            ENTRY = L3LST'FIRST
        ELSE
            ENTRY = "Attn"
        ENDCASE
        \DG SETVALUE OUT ToName ENTRY
    ENDIF
    \DG SETVALUE OUT ToFirm L3LST'COMPANY
    \USPS'CLEAN'PO L3LST
    \DG SETVALUE OUT ToAddress1 USPS'ADDR2
    \DG SETVALUE OUT ToAddress2 USPS'ADDR1
    \DG SETVALUE OUT ToCity L3LST'CITY
    \DG SETVALUE OUT ToState L3LST'ST
    \DG SETVALUE OUT ToZip5 L3LST'ZIP[1;5]
    IF LEN(L3LST'ZIP) = 9 AND L3LST'ZIP[6,9] # "0000" THEN
        ENTRY = L3LST'ZIP[6,9]
    ELSE
        ENTRY = ""
    ENDIF
    \DG SETVALUE OUT ToZip4 ENTRY
    IF VIA'MAN'YN = "E" THEN
        ENTRY = ""
        FOR K = 1 TO LEN(L3LST'PHONE1)
            IF L3LST'PHONE1[K;1] >= "0" AND L3LST'PHONE1[K;1] <= "9" THEN
                ENTRY = ENTRY + L3LST'PHONE1[K;1]
            ENDIF
        NEXT K
        L3LST'PHONE1 = ENTRY
        IF L3LST'PHONE1 = "" THEN
            L3LST'PHONE1 = L1LST'PHONE1
        ENDIF
        \DG SETVALUE OUT ToPhone L3LST'PHONE1[1;10]
    ENDIF
    \FROUND (BOX'WEIGHT*16)/100 III
    ENTRY = STR(III)
    \DG SETVALUE OUT WeightInOunces ENTRY
    IF VIA'MAN'YN = "E" THEN
        \SETWGTFROMBOX
        IF WGT'AC'YN = "E" THEN            !!Envelope
            ENTRY = "True"
        ELSE
            ENTRY = "False"
        ENDIF
        \DG SETVALUE OUT FlatRate ENTRY
        \DG SETVALUE OUT StandardizeAddress """True"""
        IF VIA'SIG'WAIVER = "Y" THEN
            ENTRY = "True"
        ELSE
            ENTRY = "False"
        ENDIF
        \DG SETVALUE OUT WaiverOfSignature ENTRY
        IF VIA'HOLIDAY'YN = "Y" THEN
            ENTRY = "False"
        ELSE
            ENTRY = "True"
        ENDIF
        \DG SETVALUE OUT NoHoliday ENTRY
        IF VIA'WEEKEND'YN = "Y" THEN
            ENTRY = "False"
        ELSE
            ENTRY = "True"
        ENDIF
        \DG SETVALUE OUT NoWeekend ENTRY
    ELSE
        CASE
        IF VIA'MAN'YN = "1" THEN
            ENTRY = "First Class"
        ELSE
        IF VIA'MAN'YN = "P" THEN
            ENTRY = "Priority"
        ELSE
        IF VIA'MAN'YN = "E" THEN
            ENTRY = "Express uses a different label"
        ELSE
        IF VIA'MAN'YN = "D" THEN
            ENTRY = "Parcel Post"
        ELSE
            ENTRY = "Invalid MAN'YN"
        ENDCASE
        \DG SETVALUE OUT ServiceType ENTRY
    ENDIF
    IF SEP'PAGE = "Y" THEN
        \DG SETVALUE OUT SeparateReceiptPage """True"""
    ELSE
        \DG SETVALUE OUT SeparateReceiptPage """False"""
    ENDIF
    IF SAVE'LOC'ZIP # L1LST'ZIP[1;5] THEN
        \DG SETVALUE OUT POZipCode SAVE'LOC'ZIP[1;5]
    ENDIF
    IF USPS'CUSTOMS = 0 THEN
        \DG SETVALUE OUT ImageType """None"""
    ELSE
        \DG SETVALUE OUT ImageType """TIF"""
    ENDIF
    ENTRY = ""
    \KERROR HHS MODE="D" CNO="N"
    \DG SETVALUE OUT CustomerRefNo ENTRY
    IF WCS'CUS'NO = CUS'NO AND INSTR(1,WCS'EMAIL,"@") # 0 THEN
        \DG SETVALUE OUT SenderName """Morris Costumes"""
        \DG SETVALUE OUT SenderEMail """confirm@morriscostumes.com"""
        IF WCS'CONTACT # "" THEN
            \DG SETVALUE OUT RecipientName WCS'CONTACT
        ENDIF
        \DG SETVALUE OUT RecipientEMail WCS'EMAIL
    ENDIF
    FNAME = "/tmp/label_xml.PID"
    XCALL ABUTIL,46,FNAME,FNAME
    \DG TOFILE OUT FNAME
    IF DG'CTL # 0 THEN
        ENTRY = DG'CTL+" Could not create "+FNAME
        CALL DO'ERR
        ENTRY = "1: Aborting as labels failed!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    LOOKUP FNAME,III
    IF III = 0 THEN
        ENTRY = "File created is empty "+FNAME
        CALL DO'ERR
        ENTRY = "2: Aborting as labels failed!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    USPS'DATA = ""
    II = 0
    OPEN #123,FNAME,INPUT
    DO
        INPUT LINE #123, ENTRY
        IF EOF(123) # 0 EXIT
        \STRIP ENTRY
        IF ENTRY = "" THEN
            II = 1
            REPEAT
        ENDIF
        DO
            III = INSTR(1,ENTRY,"&amp;")
            IF III # 0 THEN
                ENTRY = ENTRY[1,III-1] + "%26" + ENTRY[III+1,-1]
                II = 1
            ENDIF
        LOOP UNTIL III = 0
        USPS'DATA = USPS'DATA + ENTRY + CHR(10)
    LOOP
    CLOSE #123
    IF II # 0 THEN
        OPEN #123,FNAME,OUTPUT
        PRINT #123,USPS'DATA
        CLOSE #123
    ENDIF
    IF USPS'DEBUG # "N" THEN
        XCALL SYSTEM,"aroot cp "+FNAME+" /logs/ese1.xml"
    ENDIF
    \USPS'SEND FNAME
    IF USPS'CTL # 0 THEN
        ENTRY = "3:  Aborting as labels failed!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF

    IF VIA'MAN'YN = "E" THEN
        III = INSTR(1,USPS'DATA,"<EMConfirmationNumber>")
    ELSE
        III = INSTR(1,USPS'DATA,"<DeliveryConfirmationNumber>")
    ENDIF
    IF III = 0 THEN
        GOTO CONFIRMATION'INVALID
    ENDIF
    USPS'ILINE = USPS'DATA[III,-1]
    III = INSTR(1,USPS'ILINE,">")
    USPS'ILINE = USPS'ILINE[III+1,-1]
    IF VIA'MAN'YN = "E" THEN
        III = INSTR(1,USPS'ILINE,"</EMConfirmationNumber>")
    ELSE
        III = INSTR(1,USPS'ILINE,"</DeliveryConfirmationNumber>")
    ENDIF
    IF III = 0 GOTO CONFIRMATION'INVALID
    ENTRY = USPS'ILINE[1,III-1]
    \STRIP ENTRY 3
    IF ENTRY = "" THEN
        ENTRY = "Invalid tracking number returned, ABORTING"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    BOX'TRACK'NO = ENTRY
    \STRIP BOX'TRACK'NO 67
    IF USPS'CUSTOMS > 0 THEN
        \DG GETINT _OESETUP label_printer PRT'KSEQ
        IF DG'CTL # 0 THEN
            ENTRY = "Cannot find label printer!"
            CALL DO'ERR
            GOTO ABORT
        ENDIF
        \DG RELEASE USPS
        USE PRT INTO PRT'REC KEY PRT'KEY
        IF PRT'CTL # 0 THEN
            ENTRY = "Conf Printer "+ PRT'KSEQ+" not found!"
            CALL DO'ERR
            GOTO ABORT
        ENDIF
        \SETPRT
        IF PRT'EXSPL # "N" THEN
            IF WANT'TIF = "Y" THEN
!           !!.gif file converted from encode ASCII to real .gif
                XCALL ABUTIL,107,LABEL'SIZE,USPS'ILINE,USPS'BINARY
                ENTRY = "decoded "+LABEL'SIZE+" bytes"
                IF USPS'DEBUG = "Y" THEN
                    ? ENTRY
                ELSE
                    CALL DO'ERR'OERCTL
                ENDIF
                OPEN #88,"/lbl/label.gif",OUTPUT
                PRINT #88,USPS'BINARY[1,LABEL'SIZE];
                CLOSE #88
                ENTRY = "gif file /lbl/label.gif created!"
                IF USPS'DEBUG = "Y" THEN
                    ? ENTRY
                ELSE
                    CALL DO'ERR'OERCTL
                ENDIF
            ENDIF
            OPEN #1234,"/lbl/usps_NXTC.ps",OUTPUT
            GETCMN TNAME
            CLOSE #1234
            XCALL ABUTIL,109,LABEL'SIZE,USPS'ILINE,TNAME
            ENTRY = "lp -d "+PRT'DEVCD+" "+TNAME + ">> /dev/null 2>> /dev/null"
            XCALL SYSTEM,ENTRY
            FOR III = 2 TO 6
                ENTRY = "Page"+STR(III)+"Image"
                \DG GETSTRING USPSDOC ENTRY USPS'DATA TAGVAR="Y" NOSTRIP="Y"
                IF DG'CTL = 0 AND LEN(USPS'ILINE) > 0 THEN
                    LABEL'SIZE = LEN(USPS'ILINE)
                    IF WANT'TIF = "Y" THEN
                        !!.gif file converted from encode ASCII to real .gif
                        XCALL ABUTIL,107,LABEL'SIZE,USPS'ILINE,USPS'BINARY
                        ENTRY = "decoded "+LABEL'SIZE+" bytes"
                        IF USPS'DEBUG = "Y" THEN
                            ? ENTRY
                        ELSE
                            CALL DO'ERR'OERCTL
                        ENDIF
                        ENTRY = "page"+STR(III)+"image.gif"
                        OPEN #88,ENTRY,OUTPUT
                        PRINT #88,USPS'BINARY[1,LABEL'SIZE];
                        CLOSE #88
                        ENTRY = "gif file "+ENTRY+" created!"
                        IF USPS'DEBUG = "Y" THEN
                            ? ENTRY
                        ELSE
                            CALL DO'ERR'OERCTL
                        ENDIF
                    ENDIF
                    OPEN #1234,"/lbl/usps_NXTC.ps",OUTPUT
                    GETCMN TNAME
                    CLOSE #1234
                    XCALL ABUTIL,109,LABEL'SIZE,USPS'ILINE,TNAME
                    ENTRY = "lp -d "+PRT'DEVCD+" "+TNAME + ">> /dev/null 2>> /dev/null"
                    XCALL SYSTEM,ENTRY
                ELSE
                    III = 7
                ENDIF
            NEXT III
        ENDIF
    ENDIF
RETURN

CONFIRMATION'INVALID:
    SF = 2
    CALL FAILED
    GOTO ABORT
RETURN

MAP1 XX,F
MAP1 ST,F
MAP1 EN,F

MSG'APPEND:
        MSG'DID = "OEMSG"
        IF HDR'MSGNO = 0 THEN
                MSG'SPACE = SPACE
                MSG'DATA = ENTRY
                ADD MSG
                HDR'MSGNO = MSG'RCN
                UPDATE HDR
        ELSE
                USE MSG HDR'MSGNO INTO MSG'REC
                DO WHILE MSG'CH # 0 AND MSG'CTL = 0
                    USE MSG MSG'CH INTO MSG'REC
                LOOP
                II = MSG'RCN
                MSG'SPACE = SPACE
                MSG'DATA = ENTRY
                ADD MSG
                XX = MSG'RCN
                RDLOCK MSG II INTO MSG'REC
                MSG'CH = XX
                WRITE MSG
                MSG'RCN = XX        !!So we leave routine w/correct MSG'RCN
        ENDIF
RETURN

FAILED:
    ENTRY = CHR(7)+"USPS label errors below (see "+TNAME+"):"
    CALL MSG'APPEND
    ENTRY = "Number: "+USPS'ENO
    CALL MSG'APPEND
    DO
        ENTRY = USPS'EDESC[1,78]
        CALL MSG'APPEND
        IF LEN(USPS'EDESC) <= 78 EXIT
        USPS'EDESC = USPS'EDESC[79,-1]
    LOOP
    ENTRY = "USPS/oerctl error1: "+USPS'ENO+"-"+USPS'EDESC
    DOING'MSG'BODY = ENTRY
    CALL DO'ERR
    DOING'MSG = 1
    ENTRY = "Invalid Address on PO: "+HDR'PO+" order: "
    \KERROR HHS MODE="D" ALTPRE="HDR" APID="OE"
    DOING'MSG'SUBJECT = ENTRY
    DOING'MSG'BODY = "USPS response was: "+DOING'MSG'BODY
    CALL PRE'DO'EMAIL
    DOING'MSG = 0
    TNAME = "/lbl/usps_error.NXTC"
    CALL OUTPUT'XML
    ENTRY = "results="+TNAME
    CALL DO'ERR
    ENTRY = "Failed: aborting as labels failed!"
    CALL DO'ERR
    LOOKUP FNAME,III
    IF III # 0 THEN
        KILL FNAME
    ENDIF
RETURN

MAP1 TTL'WGT,B,5
MAP1 ANYZERO,B,5
MAP1 ADRCNT,B,1
MAP1 REF,S,30
MAP1 QQ,F

MAP1 TRK'NO'MAX,B,2,2000
MAP1 TRK'STUFF'SPACE,S
    MAP2 TRK'NO(2000),B,3
    MAP2 TRK'NO'VALUE(2000),B,5
    MAP2 TRK'NO'WGT(2000),B,4
    MAP2 TRK'NO'QTY(2000),B,5
    MAP2 TRK'NO'CNT,B,2

MAP1 TTL'ITEMS,B,5
MAP1 VALUE,B,5
MAP1 ITEMS,F
MAP1 ITEMS'PER'BOX,B,5
MAP1 LINES'PER'BOX,B,5
MAP1 TOP,B,2
MAP1 BTM,B,2
MAP1 NUM'OF'ITEMS,B,5
MAP1 TRK'NO'WGT,B,5
MAP1 NUM'OF'BOXES,B,5
MAP1 SUB'NET,B,5

CUSTOMS'TRACK'NO:
    LENTRY = "CUSTOM'TRACK'NO:" : \LOG'IT
    CALL CUSTOMS'TRACK'NO2
    \DG RELEASEALL
RETURN

CUSTOMS'TRACK'NO2:
    LENTRY = "CUSTOM'TRACK'NO2:" : \LOG'IT
    \DG NEW USPS USPS
!!Label
    IF TESTING = "Y" THEN
        IF VIA'MAN'YN = "E" THEN
            \DG ADDCHILD USPS OUT ExpressMailIntlRequest
            \DG SETVALUE USPS ExpressMailIntlRequest UPC'USERID ATTR="USERID"
            \DG SETVALUE USPS ExpressMailIntlRequest UPC'PASSWORD ATTR="PASSWORD"
        ELSE
            \DG ADDCHILD USPS OUT PriorityMailIntlRequest
            \DG SETVALUE USPS PriorityMailIntlRequest UPC'USERID ATTR="USERID"
            \DG SETVALUE USPS PriorityMailIntlRequest UPC'PASSWORD ATTR="PASSWORD"
        ENDIF
    ELSE
        IF VIA'MAN'YN = "E" THEN
            \DG ADDCHILD USPS OUT ExpressMailIntlRequest
            \DG SETVALUE USPS ExpressMailIntlRequest UPC'USERID ATTR="USERID"
            \DG SETVALUE USPS ExpressMailIntlRequest UPC'PASSWORD ATTR="PASSWORD"
        ELSE
            \DG ADDCHILD USPS OUT PriorityMailIntlRequest
            \DG SETVALUE USPS PriorityMailIntlRequest UPC'USERID ATTR="USERID"
            \DG SETVALUE USPS PriorityMailIntlRequest UPC'PASSWORD ATTR="PASSWORD"
        ENDIF
    ENDIF
    ENTRY = ""
    \DG SETVALUE OUT Option ENTRY

    ENTRY = ""
    \DG SETVALUE OUT ImageParameters ENTRY
    IF L1LST'FIRST = "" THEN
        L1LST'FIRST = "From:"
    ENDIF
    \STRIP L1LST'COMPANY 3
    \DG SETVALUE OUT FromFirstName L1LST'FIRST
    \DG SETVALUE OUT FromLastName L1LST'LAST
    \DG SETVALUE OUT FromFirm L1LST'COMPANY
    \USPS'CLEAN'PO L1LST
    \DG SETVALUE OUT FromAddress1 USPS'ADDR2
    \DG SETVALUE OUT FromAddress2 USPS'ADDR1
    \DG SETVALUE OUT FromCity L1LST'CITY
    \DG SETVALUE OUT FromState L1LST'ST
    \DG SETVALUE OUT FromZip5 L1LST'ZIP[1;5]
    IF LEN(L1LST'ZIP) = 9 AND L1LST'ZIP[6,9] # "0000" THEN
        ENTRY = L1LST'ZIP[6,9]
    ELSE
        ENTRY = ""
    ENDIF
    \DG SETVALUE OUT FromZip4 ENTRY
    \DG SETVALUE OUT FromPhone L1LST'PHONE1[1;10]
    ENTRY = "Order:"
    \KERROR HDR MODE="D" CNO="N"
    \DG SETVALUE OUT FromCustomsReference ENTRY

    NAME'AND'COMPANY = 0
    CASE
    IF WCS'CUS'NO = CUS'NO AND WCS'CONTACT # "" THEN
        ENTRY = WCS'CONTACT
    ELSE
    IF L3LST'LAST # "" THEN
        ENTRY = L3LST'FIRST + " " + L3LST'LAST
    ELSE
    IF L3LST'FIRST # "" THEN
        ENTRY = L3LST'FIRST
    ELSE
        ENTRY = L3LST'LAST
    ENDCASE
    \STRIP ENTRY 3
    \DG SETVALUE OUT ToName ENTRY
    IF L3LST'COMPANY # "" THEN
        ENTRY = L3LST'COMPANY
    ENDIF
    \STRIP ENTRY 3
    \DG SETVALUE OUT ToFirm ENTRY

    \USPS'CLEAN'PO L3LST

    IF USPS'ADDR1 = "" AND USPS'ADDR2 # "" THEN
        USPS'ADDR1 = USPS'ADDR2
    ENDIF
    \DG SETVALUE OUT ToAddress1 USPS'ADDR1

    IF USPS'ADDR2 # "" THEN
        \DG SETVALUE OUT ToAddress2 USPS'ADDR2
    ENDIF

!!USPS'CUSTOMS never zero here
    COU'KABV = UCS(L3LST'COUNTRY)
    USE COU INTO COU'REC KEY COU'KEY
    IF COU'CTL # 0 THEN
        ENTRY = "Invalid country: "+COU'KABV
        \KERROR HDR MODE="D" CNO="N"
        CALL DO'ERRL
        GOTO ABORT
    ENDIF

    IF USPS'CUSTOMS < 0 THEN            !!International/not APO,FOP
        \DG SETVALUE OUT ToCity L3LST'CITY
        IF L3LST'ST # "" THEN
            \DG SETVALUE OUT ToProvince L3LST'ST
        ENDIF

        \DG SETVALUE OUT ToCountry COU'DESC

        \DG SETVALUE OUT ToPostalCode L3LST'ZIP
    ELSE                                !!apo/fpo
        IF USPS'CUSTOMS = 99 THEN        !!(MEANS city is APO)
            \DG SETVALUE OUT ToCity L3LST'CITY
        ELSE
            CASE
            IF UCS(L3LST'ADDR(USPS'CUSTOMS)[1;1]) = "A" THEN
                \DG SETVALUE OUT ToCity """APO"""
            ELSE
            IF UCS(L3LST'ADDR(USPS'CUSTOMS)[1;1]) = "F" THEN
                \DG SETVALUE OUT ToCity """FPO"""
            ELSE
                \DG SETVALUE OUT ToCity """DPO"""
            ENDCASE
        ENDIF
        IF L3LST'ST # "" THEN
            \DG SETVALUE OUT ToProvince L3LST'ST
        ENDIF
        \DG SETVALUE OUT ToCountry COU'DESC
        \DG SETVALUE OUT ToPostalCode L3LST'ZIP
    ENDIF

    IF USPS'PO'BOX > 0 THEN
        ENTRY = "Y"
    ELSE
        ENTRY = "N"
    ENDIF
    \DG SETVALUE OUT ToPOBoxFlag ENTRY

    ENTRY = ""
    FOR K = 1 TO LEN(L3LST'PHONE1)
        IF L3LST'PHONE1[K;1] >= "0" AND L3LST'PHONE1[K;1] <= "9" THEN
            ENTRY = ENTRY + L3LST'PHONE1[K;1]
        ENDIF
    NEXT K
    L3LST'PHONE1 = ENTRY
    IF L3LST'PHONE1 = "" THEN
        L3LST'PHONE1 = L1LST'PHONE1
    ENDIF
    \DG SETVALUE OUT ToPhone L3LST'PHONE1[1;10]

    ENTRY = ""
    FOR QQ = 2 TO 6
        IF L3LST'PTY'NO(QQ) = "F" AND L3LST'PHONE(QQ) # "" THEN
            ENTRY = L3LST'PHONE(QQ)
            QQ = 100
        ENDIF
    NEXT QQ
    \DG SETVALUE OUT ToFax ENTRY

    IF WCS'CUS'NO = CUS'NO AND WCS'EMAIL # "" THEN
        ENTRY = WCS'EMAIL
    ELSE
        \COPYF EXT MC MODE="PRI"
        EXT'KLST'NO = L3LST'NO
        EXT'SPACE = SPACE
        USE EXT INTO EXT'REC KEY EXT'KEY
        ENTRY = EXT'EMAIL
    ENDIF
    IF INSTR(1,ENTRY,"@") = 0 OR INSTR(1,ENTRY,".") = 0 THEN
        ENTRY = ""        !!Invalid
    ENDIF
    \DG SETVALUE OUT ToEmail ENTRY

    IF HDR'PO # "" THEN
        \DG SETVALUE OUT ToCustomsReference HDR'PO
    ENDIF

    \DG SETVALUE OUT NonDeliveryOption """RETURN"""

    \SETWGTFROMBOX
    IF VIA'MAN'YN = "P" THEN        !!Priority
        CASE
        IF WGT'RECTANGLE = "E" THEN
            \DG SETVALUE OUT Container """FLATRATEENV"""
        ELSE
        IF WGT'RECTANGLE = "F" THEN
            \DG SETVALUE OUT Container """FLATRATEBOX"""
        ELSE
            \DG SETVALUE OUT Container """VARIABLE"""
        ENDCASE
    ELSE                            !!Express
        IF WGT'RECTANGLE = "E" THEN
            \DG SETVALUE OUT Container """FLATRATEENV"""
        ELSE
            \DG SETVALUE OUT Container """VARIABLE"""
        ENDIF
    ENDIF

!!  MAP1 FREIGHT,B,5
!!  MAP1 TAX1,B,5
!!  MAP1 MAX'TOTAL,B,5
    MAP1 DISC,B,5
!!  MAP1 OTHER2,B,5
    MAP1 BOX'TOTAL,B,5
    MAP1 BOX'INV'TOTAL,B,5

    \HDRSUM BOX VIA="FREIGHT" TAX="TAX1" DISC="DISC" INVOICE="MAX'TOTAL" &
            FREE'FRT="OTHER2"

    IF (BOX'SHP'TOTAL - BOX'SHP'DISC) >= UPC'INTL'VALUE OR &
                    (BOX'SHP'TOTAL - BOX'SHP'DISC) <= UPC'RPT'VALUE THEN
        BOX'TOTAL = BOX'SHP'TOTAL - BOX'SHP'DISC
        BOX'INV'TOTAL = MAX'TOTAL
    ELSE
        ENTRY = STR(HDR'NO)
                    !!semi-random value less than control record by up
                    !!to $1.00 and using the last 2 digits of invoice #
                    !!for the pennies. maxcod.mac MUST match.
        BOX'TOTAL  = UPC'RPT'VALUE - 100 + VAL(ENTRY[-2,-1])
        BOX'INV'TOTAL = MAX'TOTAL - (BOX'SHP'TOTAL -BOX'SHP'DISC - BOX'TOTAL)
    ENDIF

    \DG ADDCHILD OUT CONTENTS ShippingContents
    \DG ADDCHILD CONTENTS DETAIL ItemDetail

    \DG SETVALUE DETAIL Description UPC'INTL'DESC

    ENTRY = 1
    \DG SETVALUE DETAIL Quantity ENTRY

    III = BOX'TOTAL/100
    ENTRY = (III USING "#########.##")
    \STRIP ENTRY 3
    \DG SETVALUE DETAIL Value ENTRY

    MAP1 LBS,B,2
    MAP1 OUNCES,B,2

    LBS = BOX'WEIGHT/100
    \FROUND ((BOX'WEIGHT-(LBS*100))*16)/100 III
    IF III <= 0 THEN
        OUNCES = 0
    ELSE
        OUNCES = III
    ENDIF

    III = BOX'WEIGHT/100
    \DG SETVALUE DETAIL NetPounds LBS

    \DG SETVALUE DETAIL NetOunces OUNCES

    ENTRY = ""
    \DG SETVALUE DETAIL HSTariffNumber ENTRY

    ENTRY = "China"
    \DG SETVALUE DETAIL CountryOfOrigin ENTRY

    ENTRY = ""
    \DG SETVALUE OUT Postage ENTRY

    \DG SETVALUE OUT GrossPounds LBS
    ENTRY = ""
    \DG SETVALUE OUT GrossOunces OUNCES

    \DG SETVALUE OUT ContentType """MERCHANDISE"""

    \DG SETVALUE OUT Agreement """Y"""

    \DG SETVALUE OUT InvoiceNumber HDR'NO

    \DG SETVALUE OUT ImageType """TIF"""

    \DG SETVALUE OUT ImageLayout """ONEPERFILE"""

    ENTRY = ""
    \KERROR HDR MODE="D" CNO="N"
    \DG SETVALUE OUT CustomerRefNo ENTRY

    FNAME = "/tmp/label_xml.PID"
    XCALL ABUTIL,46,FNAME,FNAME
    \DG TOFILE OUT FNAME
    IF DG'CTL # 0 THEN
        ENTRY = DG'CTL+" Could not create "+FNAME
        CALL DO'ERR
        ENTRY = "1:  Aborting as international labels failed!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    LOOKUP FNAME,III
    IF III = 0 THEN
        ENTRY = "File created is empty "+FNAME
        CALL DO'ERR
        ENTRY = "2: Aborting as international labels failed!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    IF USPS'DEBUG # "N" THEN
        ENTRY = "aroot cp "+FNAME+" /logs/ese2.xml"
        XCALL SYSTEM,ENTRY
        IF USPS'DEBUG = "Y" THEN
            ? ENTRY
        ELSE
            CALL DO'ERR'OERCTL
        ENDIF
    ENDIF
    USPS'DATA = ""
    II = 0
    OPEN #123,FNAME,INPUT
    DO
        INPUT LINE #123, ENTRY
        IF EOF(123) # 0 EXIT
        \STRIP ENTRY
        IF ENTRY = "" THEN
            II = 1
            REPEAT
        ENDIF
        DO
            III = INSTR(1,ENTRY,"&amp;")
            IF III # 0 THEN
                ENTRY = ENTRY[1,III-1] + "%26" + ENTRY[III+1,-1]
                II = 1
            ENDIF
        LOOP UNTIL III = 0
        USPS'DATA = USPS'DATA + ENTRY + CHR(10)
    LOOP
    CLOSE #123
    IF II # 0 THEN
        OPEN #123,FNAME,OUTPUT
        PRINT #123,USPS'DATA
        CLOSE #123
    ENDIF
    \USPS'SEND FNAME
    IF USPS'CTL # 0 THEN
        ENTRY = "3:  Aborting as international labels failed!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF

    \DG GETSTRING USPSDOC BarcodeNumber ENTRY
    \STRIP ENTRY 3
    IF ENTRY = "" THEN
        ENTRY = "Invalid tracking number returned, ABORTING: "+ENTRY+" ctl="+DG'CTL
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    BOX'TRACK'NO = ENTRY
    \STRIP BOX'TRACK'NO 67

    \DG GETSTRING USPSDOC LabelImage USPS'ILINE NOSTRIP="Y"
    IF DG'CTL # 0 THEN
        ENTRY = "Could not find LabelImage in response!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    IF USPS'ILINE = "" THEN
        ENTRY = "No LabelImage returned!"
        CALL DO'ERR
        \ABLOGGER USPS'DATA WL'DEBUG
        RETURN                                !!KLUDGE
    ENDIF
    LABEL'SIZE = LEN(USPS'ILINE)
    IF WANT'TIF = "Y" THEN
!           !!.tif file converted from encode ASCII to real .tif
        XCALL ABUTIL,107,LABEL'SIZE,USPS'ILINE,USPS'BINARY
        ENTRY = "decoded "+LABEL'SIZE+" bytes"
        IF USPS'DEBUG = "Y" THEN
            ? ENTRY
        ELSE
            CALL DO'ERR'OERCTL
        ENDIF
        OPEN #88,"/lbl/label.tif",OUTPUT
        PRINT #88,USPS'BINARY[1,LABEL'SIZE];
        CLOSE #88
        ENTRY = "tif file /lbl/label.tif created!"
        IF USPS'DEBUG = "Y" THEN
            ? ENTRY
        ELSE
            CALL DO'ERR'OERCTL
        ENDIF
    ENDIF
    IF USPS'DEBUG # "N" THEN
        ENTRY = "Spooling "+TNAME
        IF USPS'DEBUG = "Y" THEN
            ? ENTRY
        ELSE
            CALL DO'ERR'OERCTL
        ENDIF
    ENDIF

    \DG GETINT _OESETUP label_printer PRT'KSEQ
    IF DG'CTL # 0 THEN
        ENTRY = "Cannot find label printer!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    \DG RELEASE USPS
    USE PRT INTO PRT'REC KEY PRT'KEY
    IF PRT'CTL # 0 THEN
        ENTRY = "Printer USPS "+ PRT'KSEQ+" not found!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    \SETPRT
    IF PRT'EXSPL # "N" THEN
        OPEN #1234,"/lbl/usps_NXTC.ps",OUTPUT
        GETCMN TNAME
        CLOSE #1234
        XCALL ABUTIL,108,LABEL'SIZE,USPS'ILINE,TNAME
        ENTRY = "lp -d "+PRT'DEVCD+" "+TNAME + ">> /dev/null 2>> /dev/null"
        XCALL SYSTEM,ENTRY
        FOR III = 2 TO 6
            ENTRY = "Page"+STR(III)+"Image"
            \DG GETSTRING USPSDOC ENTRY USPS'DATA TAGVAR="Y" NOSTRIP="Y"
            IF DG'CTL = 0 AND LEN(USPS'ILINE) > 0 THEN
                LABEL'SIZE = LEN(USPS'ILINE)
                IF WANT'TIF = "Y" THEN
                    !!.tif file converted from encode ASCII to real .tif
                    XCALL ABUTIL,107,LABEL'SIZE,USPS'ILINE,USPS'BINARY
                    ENTRY = "decoded "+LABEL'SIZE+" bytes"
                    IF USPS'DEBUG = "Y" THEN
                        ? ENTRY
                    ELSE
                        CALL DO'ERR'OERCTL
                    ENDIF
                    ENTRY = "page"+STR(III)+"image.tif"
                    OPEN #88,ENTRY,OUTPUT
                    PRINT #88,USPS'BINARY[1,LABEL'SIZE];
                    CLOSE #88
                    ENTRY = "tif file "+ENTRY+" created!"
                    IF USPS'DEBUG = "Y" THEN
                        ? ENTRY
                    ELSE
                        CALL DO'ERR'OERCTL
                    ENDIF
                ENDIF
                OPEN #1234,"/lbl/usps_NXTC.ps",OUTPUT
                GETCMN TNAME
                CLOSE #1234
                XCALL ABUTIL,108,LABEL'SIZE,USPS'ILINE,TNAME
                ENTRY = "lp -d "+PRT'DEVCD+" "+TNAME + ">> /dev/null 2>> /dev/null"
                XCALL SYSTEM,ENTRY
            ELSE
                III = 7
            ENDIF
        NEXT III
    ELSE
        IF USPS'DEBUG # "Y" THEN
            ENTRY = "NOT SPOOLING BECAUSE EXSPL="+PRT'EXSPL
            IF USPS'DEBUG = "Y" THEN
                ? ENTRY
            ELSE
                CALL DO'ERR'OERCTL
            ENDIF
        ENDIF
    ENDIF
RETURN

MAP1 NAME'AND'COMPANY,B,1
MAP1 CSZ,S,80

DO'CUSTOMS'FORM:
    IF L3LST'ST = "GU" THEN
        CALL DO'MANUAL'CUSTOMS'FORM
    ELSE
        CALL DO'ELECTRONIC'CUSTOMS'FORM
    ENDIF
RETURN

MAP1 REGULAR'PRINT,S,20,CHR(27)+"(s0p10h0s0b4099T"
MAP1 BOLD'PRINT,S,20,CHR(27)+"(s5H"

DO'MANUAL'CUSTOMS'FORM:
    TNAME = "/tmp/manual_customs.PID"
    XCALL ABUTIL,46,TNAME,TNAME
    OPEN #123,TNAME,OUTPUT
    ? #123,BOLD'PRINT
    ? "*************************************************************************"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? "*************************************************************************"
    ? #123,REGULAR'PRINT
    ? #123
    ? #123
    ENTRY = ""
    \KERROR HHS MODE="D" CNO="N"
    ? #123,"Order=";ENTRY
    ? #123,"Name=";L3LST'FIRST;" ";L3LST'LAST
    ? #123,"Company=";L3LST'COMPANY
    ? #123,"Description=";UPC'INTL'DESC
    ? #123,"Quantity=1";
    III = BOX'TOTAL/100
    ENTRY = (III USING "#########.##")
    \STRIP ENTRY 3
    ? #123,"Value=";ENTRY
    LBS = BOX'WEIGHT/100
    \FROUND ((BOX'WEIGHT-(LBS*100))*16)/100 III
    IF III <= 0 THEN
        OUNCES = 0
    ELSE
        OUNCES = III
    ENDIF

    III = BOX'WEIGHT/100
    ? #123,"NetPounds=";LBS

    ? #123,"NetOunces=";OUNCES

    ? #123,"GrossPounds=";LBS
    ? #123,"GrossOunces=";OUNCES
    ? #123
    ? #123
    ? #123,BOLD'PRINT
    ? "*************************************************************************"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? #123,"YOU MUST FILL OUT A HAND-MADE CUSTOMS FORM!!!!!!!!!!!!!!!!!!"
    ? "*************************************************************************"
    ? #123,REGULAR'PRINT
    CLOSE #123
    \DG GETINT _OESETUP label_printer PRT'KSEQ
    IF DG'CTL # 0 THEN
        ENTRY = "Cannot find label printer!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    \DG RELEASE USPS
    USE PRT INTO PRT'REC KEY PRT'KEY
    IF PRT'CTL # 0 THEN
        ENTRY = "Printer USPS2 "+ PRT'KSEQ+" not found!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    \SETPRT
    IF PRT'EXSPL # "N" THEN
        ENTRY = "lp -d "+PRT'DEVCD+" "+TNAME + ">> /dev/null 2>> /dev/null"
        XCALL SYSTEM,ENTRY
    ENDIF
RETURN

DO'ELECTRONIC'CUSTOMS'FORM:
    \DG NEW USPS USPS
    IF TESTING = "Y" THEN
        \DG ADDCHILD USPS OUT CustomsCN22V2Request
        \DG SETVALUE USPS CustomsCN22V2Request UPC'USERID ATTR="USERID"
        \DG SETVALUE USPS CustomsCN22V2Request UPC'PASSWORD ATTR="PASSWORD"
    ELSE
        \DG ADDCHILD USPS OUT CustomsCN22V2Request
        \DG SETVALUE USPS CustomsCN22V2Request UPC'USERID ATTR="USERID"
        \DG SETVALUE USPS CustomsCN22V2Request UPC'PASSWORD ATTR="PASSWORD"
    ENDIF
    ENTRY = ""
    \DG SETVALUE OUT Option ENTRY

    IF L1LST'FIRST = "" THEN
        L1LST'FIRST = "From:"
    ENDIF
    \STRIP L1LST'COMPANY 3
    \DG SETVALUE OUT FromFirstName L1LST'FIRST
    \DG SETVALUE OUT FromLastName L1LST'LAST
    \DG SETVALUE OUT FromFirm L1LST'COMPANY
    \USPS'CLEAN'PO L1LST
    \DG SETVALUE OUT FromAddress1 USPS'ADDR2
    \DG SETVALUE OUT FromAddress2 USPS'ADDR1
    \DG SETVALUE OUT FromCity L1LST'CITY
    \DG SETVALUE OUT FromState L1LST'ST
    \DG SETVALUE OUT FromZip5 L1LST'ZIP[1;5]
    IF LEN(L1LST'ZIP) = 9 AND L1LST'ZIP[6,9] # "0000" THEN
        ENTRY = L1LST'ZIP[6,9]
    ELSE
        ENTRY = ""
    ENDIF
    \DG SETVALUE OUT FromZip4 ENTRY
    \DG SETVALUE OUT FromPhone L1LST'PHONE1[1;10]

    NAME'AND'COMPANY = 0
    CASE
    IF WCS'CUS'NO = CUS'NO AND WCS'CONTACT # "" THEN
        ENTRY = WCS'CONTACT
    ELSE
    IF L3LST'LAST # "" THEN
        ENTRY = L3LST'FIRST + " " + L3LST'LAST
    ELSE
    IF L3LST'FIRST # "" THEN
        ENTRY = L3LST'FIRST
    ELSE
        ENTRY = L3LST'LAST
    ENDCASE
    \STRIP ENTRY 3
    IF ENTRY # "" THEN
        \DG SETVALUE OUT ToAddress1 ENTRY
        IF L3LST'COMPANY # "" THEN
            \DG SETVALUE OUT ToAddress2 L3LST'COMPANY
            NAME'AND'COMPANY = 1
        ENDIF
    ELSE
    IF L3LST'COMPANY # "" THEN
        \DG SETVALUE OUT ToAddress1 L3LST'COMPANY
    ENDIF
    ENDIF

    \USPS'CLEAN'PO L3LST
    IF USPS'ADDR1 = "" AND USPS'ADDR2 # "" THEN
        USPS'ADDR1 = USPS'ADDR2
    ENDIF
    IF NAME'AND'COMPANY = 1 THEN
        \DG SETVALUE OUT ToAddress3 USPS'ADDR1
        \DG SETVALUE OUT ToAddress4 USPS'ADDR2
    ELSE
        \DG SETVALUE OUT ToAddress2 USPS'ADDR1
        \DG SETVALUE OUT ToAddress3 USPS'ADDR2
    ENDIF
                                                   !!International/not APO,FPO
    IF USPS'CUSTOMS < 0 OR USPS'CUSTOMS = 0 THEN   !!or a US Territory
        CSZ = L3LST'CITY + ", " + L3LST'ST + " " + L3LST'ZIP
        IF NAME'AND'COMPANY = 1 THEN
            \STRIP CSZ 3
            \DG SETVALUE OUT ToAddress5 CSZ
            ENTRY = ""
            \DG SETVALUE OUT ToAddress6 ENTRY
        ELSE
            \DG SETVALUE OUT ToAddress4 CSZ
            ENTRY = ""
            \DG SETVALUE OUT ToAddress5 ENTRY
            ENTRY = ""
            \DG SETVALUE OUT ToAddress6 ENTRY
        ENDIF

        COU'KABV = L3LST'COUNTRY
        USE COU INTO COU'REC KEY COU'KEY

        IF COU'CTL = 0 THEN
            \DG SETVALUE OUT ToCountry COU'DESC
        ELSE
            \DG SETVALUE OUT ToCountry L3LST'COUNTRY
        ENDIF
        ENTRY = ""
        \DG SETVALUE OUT ToAPOFPOZip5 ENTRY
    ELSE                                 !!APO/FPO
        IF USPS'CUSTOMS = 99 THEN        !!(MEANS city is APO)
            ENTRY = L3LST'CITY
        ELSE
            CASE
            IF UCS(L3LST'ADDR(USPS'CUSTOMS)[1;1]) = "A" THEN
                ENTRY = "APO"
            ELSE
            IF UCS(L3LST'ADDR(USPS'CUSTOMS)[1;1]) = "F" THEN
                ENTRY = "FPO"
            ELSE
                ENTRY = "DPO"
            ENDCASE
        ENDIF
        CSZ = ENTRY + ", " + L3LST'ST + " " + L3LST'ZIP
        IF NAME'AND'COMPANY = 1 THEN
            ENTRY = ""
            \DG SETVALUE OUT ToAddress5 ENTRY
            \DG SETVALUE OUT ToAddress6 CSZ
        ELSE
            ENTRY = ""
            \DG SETVALUE OUT ToAddress4 ENTRY
            ENTRY = ""
            \DG SETVALUE OUT ToAddress5 ENTRY
            \DG SETVALUE OUT ToAddress6 CSZ
        ENDIF
        ENTRY = ""
        \DG SETVALUE OUT ToCountry ENTRY
        \STRIP L3LST'ZIP 3
        \DG SETVALUE OUT ToAPOFPOZip5 L3LST'ZIP[1;5]
    ENDIF

    ENTRY = ""
    FOR K = 1 TO LEN(L3LST'PHONE1)
        IF L3LST'PHONE1[K;1] >= "0" AND L3LST'PHONE1[K;1] <= "9" THEN
            ENTRY = ENTRY + L3LST'PHONE1[K;1]
        ENDIF
    NEXT K
    L3LST'PHONE1 = ENTRY
    IF L3LST'PHONE1 = "" THEN
        L3LST'PHONE1 = L1LST'PHONE1
    ENDIF
    \DG SETVALUE OUT ToPhone L3LST'PHONE1[1;10]

    ENTRY = ""
    FOR QQ = 2 TO 6
        IF L3LST'PTY'NO(QQ) = "F" AND L3LST'PHONE(QQ) # "" THEN
            ENTRY = L3LST'PHONE(QQ)
            QQ = 100
        ENDIF
    NEXT QQ
    \DG SETVALUE OUT ToFax ENTRY

    IF WCS'CUS'NO = CUS'NO AND WCS'EMAIL # "" THEN
        ENTRY = WCS'EMAIL
    ELSE
        \COPYF EXT MC MODE="PRI"
        EXT'KLST'NO = L3LST'NO
        EXT'SPACE = SPACE
        USE EXT INTO EXT'REC KEY EXT'KEY
        ENTRY = EXT'EMAIL
    ENDIF
    IF INSTR(1,ENTRY,"@") = 0 OR INSTR(1,ENTRY,".") = 0 THEN
        ENTRY = ""        !!Invalid
    ENDIF
    \DG SETVALUE OUT ToEmail ENTRY

    \HDRSUM BOX VIA="FREIGHT" TAX="TAX1" DISC="DISC" INVOICE="MAX'TOTAL" &
            FREE'FRT="OTHER2"

    IF (BOX'SHP'TOTAL - BOX'SHP'DISC) >= UPC'INTL'VALUE OR &
                    (BOX'SHP'TOTAL - BOX'SHP'DISC) <= UPC'RPT'VALUE THEN
        BOX'TOTAL = BOX'SHP'TOTAL - BOX'SHP'DISC
        BOX'INV'TOTAL = MAX'TOTAL
    ELSE
        ENTRY = STR(HDR'NO)
                    !!semi-random value less than control record by up
                    !!to $1.00 and using the last 2 digits of invoice #
                    !!for the pennies. maxcod.mac MUST match.
        BOX'TOTAL  = UPC'RPT'VALUE - 100 + VAL(ENTRY[-2,-1])
        BOX'INV'TOTAL = MAX'TOTAL - (BOX'SHP'TOTAL -BOX'SHP'DISC - BOX'TOTAL)
    ENDIF

    \DG ADDCHILD OUT CONTENTS ShippingContents
    \DG ADDCHILD CONTENTS DETAIL ItemDetail

    \DG SETVALUE DETAIL Description UPC'INTL'DESC

    ENTRY = 1
    \DG SETVALUE DETAIL Quantity ENTRY

    III = BOX'TOTAL/100
    ENTRY = (III USING "#########.##")
    \STRIP ENTRY 3
    \DG SETVALUE DETAIL Value ENTRY

    LBS = BOX'WEIGHT/100
    \FROUND ((BOX'WEIGHT-(LBS*100))*16)/100 III
    IF III <= 0 THEN
        OUNCES = 0
    ELSE
        OUNCES = III
    ENDIF

    III = BOX'WEIGHT/100
    \DG SETVALUE DETAIL NetPounds LBS

    \DG SETVALUE DETAIL NetOunces OUNCES

!!  ENTRY = ""
!!  \DG SETVALUE DETAIL HSTariffNumber ENTRY

    \DG SETVALUE OUT GrossPounds LBS
    ENTRY = ""
    \DG SETVALUE OUT GrossOunces OUNCES

    \DG SETVALUE OUT ImageType """TIF"""

    \DG SETVALUE OUT ContentType """Other"""

    ENTRY = ""
    \DG SETVALUE OUT HSTariffNumber ENTRY

    ENTRY = "China"
    \DG SETVALUE OUT CountryOfOrigin ENTRY

    ENTRY = ""
    \KERROR HDR MODE="D" CNO="N"
    \STRIP ENTRY 3
    \DG SETVALUE OUT CustomerRefNo ENTRY

    FNAME = "/tmp/customs-form_xml.PID"
    XCALL ABUTIL,46,FNAME,FNAME
    \DG TOFILE OUT FNAME
    IF DG'CTL # 0 THEN
        ENTRY = DG'CTL+" Could not create "+FNAME
        CALL DO'ERR
        ENTRY = "1: Aborting as customs form failed!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    LOOKUP FNAME,III
    IF III = 0 THEN
        ENTRY = "File created is empty "+FNAME
        CALL DO'ERR
        ENTRY = "2: Aborting as customs form failed!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF

    IF USPS'DEBUG # "N" THEN
        ENTRY = "aroot cp "+FNAME+" /logs/ese3.xml"
        IF USPS'DEBUG = "Y" THEN
            ? ENTRY
        ELSE
            CALL DO'ERR'OERCTL
        ENDIF
    ENDIF
    \USPS'SEND FNAME
    IF USPS'CTL # 0 THEN
        ENTRY = "3: Aborting as customs form failed!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    \DG GETSTRING USPSDOC CN22V2FormImage USPS'ILINE NOSTRIP="Y"
    IF DG'CTL # 0 THEN
        ENTRY = "Cannot find CN22V2FormImage in response!"
        CALL DO'ERR
        GOTO ABORT
    ENDIF
    IF USPS'ILINE = "" THEN
        ENTRY = "No CN22V2FormImage returned!"
        CALL DO'ERR
        \ABLOGGER USPS'DATA WL'DEBUG
        RETURN                                !!KLUDGE
    ENDIF
    LABEL'SIZE = LEN(USPS'ILINE)
    IF WANT'TIF = "Y" THEN
!           !!.tif file converted from encode ASCII to real .tif
        XCALL ABUTIL,107,LABEL'SIZE,USPS'ILINE,USPS'BINARY
        ? "decoded ";III;" bytes"
        OPEN #88,"/lbl/customs.tif",OUTPUT
        PRINT #88,USPS'BINARY[1,LABEL'SIZE];
        CLOSE #88
        ENTRY = "tif file /lbl/customs.tif created!"
        IF USPS'DEBUG = "Y" THEN
            ? ENTRY
        ELSE
            CALL DO'ERR'OERCTL
        ENDIF
    ENDIF
    IF USPS'DEBUG # "N" THEN
        ENTRY = "Spooling Customs "+TNAME+" ("+PRT'EXSPL+")"
        IF USPS'DEBUG = "Y" THEN
            ? ENTRY
        ELSE
            CALL DO'ERR'OERCTL
        ENDIF
    ENDIF
    IF PRT'EXSPL # "N" THEN
        OPEN #1234,"/lbl/usps_NXTC.ps",OUTPUT
        GETCMN TNAME
        CLOSE #1234
        XCALL ABUTIL,108,LABEL'SIZE,USPS'ILINE,TNAME
        ENTRY = "lp -d "+PRT'DEVCD+" "+TNAME + ">> /dev/null 2>> /dev/null"
        XCALL SYSTEM,ENTRY
!       FOR III = 2 TO 6
!           ENTRY = "Page"+STR(III)+"Image"
!           \DG GETSTRING USPSDOC ENTRY USPS'ILINE TAGVAR="Y" NOSTRIP="Y"
!           IF DG'CTL = 0 AND USPS'ILINE # "" THEN
!               OPEN #1234,"/tmp/usps_NXTC.ps",OUTPUT
!               GETCMN TNAME
!               CLOSE #1234
!               LABEL'SIZE = LEN(USPS'ILINE)
!               XCALL ABUTIL,108,LABEL'SIZE,USPS'ILINE,TNAME
!               ENTRY = "lp -d "+PRT'DEVCD+" "+TNAME + ">> /dev/null 2>> /dev/null"
!               XCALL SYSTEM,ENTRY
!           ELSE
!               III = 7
!           ENDIF
!       NEXT III
    ENDIF
RETURN

OUTPUT'XML:
        XCALL ABUTIL,46,TNAME,TNAME
        \DG TOFILE OUT TNAME
        XCALL SYSTEM,ENTRY
        OPEN #88,TNAME,OUTPUT
        PRINT #88,USPS'DATA
        CLOSE #88
RETURN


LOG'AUTH:
        XCALL GETENV,"OERCTL_AUTH_LOG",AUTH'FILLER    !!Save a variable
        IF AUTH'FILLER = "Y" THEN
            XCALL GETENV,"AUTH_LOG",AUTH'FILLER    !!Save a variable
        ENDIF
        IF AUTH'FILLER # "" THEN
            IF LEN(ENTRY) > 75 THEN
                \LABLOGGER ENTRY AUTH'FILLER
!![WC]          \LABLOGGER ENTRY """/debug/authdebug.DAILY"""
                ZZZ = INSTR(1,ENTRY,")")
                ENTRY = ENTRY[1,ZZZ+1]
            ENDIF
            ENTRY = ENTRY + LEFT(ATQ'SEQ+SPACE(11),11)
            ENTRY = ENTRY + LEFT(ATQ'CARDNO[-4,-1]+SPACE(5),5)
            IF ATQ'MAGIC > 0 THEN
                ENTRY = ENTRY + "MagicOnRec "
            ELSE
                ENTRY = ENTRY + "MagicUnKno "
            ENDIF
            ENTRY = ENTRY + LEFT(ATQ'RESPONSE+SPACE(5),5)
            ENTRY = ENTRY + LEFT(ATQ'APPROVAL+SPACE(5),5)
            \KERROR ATQT APID="CV" MODE="D"
            ENTRY = ENTRY + "->"
            \KERROR ATQ APID="CV" MODE="D"
            \LABLOGGER ENTRY AUTH'FILLER
!![WC]      \LABLOGGER ENTRY """/debug/authdebug.DAILY"""
        ENDIF
RETURN

FIND'PRH:
        \VUSEPRH FLDNAM="LIN'TRK'NO" SKIP'MAP="Y"
        IF PRH'CTL # 0 THEN
            ENTRY = "Part not found: "+LIN'TRK'NO+" line="
            \KERROR LIN MODE="D"
            CALL DO'ERRL
        ENDIF
RETURN

FIND'MEA:
        CALL FIND'PRH
        MEA'SPACE = SPACE
        MEA'KTRK'NO = PRH'TRK'NO
        MEA'KUOM'NO = LIN'UOM'NO
        \VUSE MEA
        IF MEA'CTL # 0 THEN
            ENTRY = "Weights not found - aborting: "
            \KERROR MEA APID="IN" MODE="K"
            CALL DO'ERR
            GOTO ABORT
        ENDIF
RETURN

FIND'UOW:
    \COPYF UOW IN MODE="PRI"
    \VUSE UOW
RETURN

\COPYF BQR OE

BQR'ABORT:
    IF HDR'BAGGER >= "1" AND HDR'BAGGER <= "9" AND ENTRY # "" THEN
        BQR'DID = "OEBQ"+HDR'BAGGER
        BQR'KID = BQR'DID
        BQRO'DID = BQR'DID
        BQRO'KID = "OEBQ"+HDR'BAGGER+"O"
        BQRO'KLOC'NO = HDR'LOC'NO
        BQRO'KDOC'TYPE = HDR'DOC'TYPE
        BQRO'KHDR'NO = HDR'NO
        RDLOCK BQRO INTO BQR'REC KEY BQRO'KEY
        IF BQRO'CTL = 0 THEN
            BQR'CNAME = "BADL:"+ENTRY
            WRITE BQRO FROM BQR'REC
        ENDIF
    ENDIF
    GOTO ABORT
RETURN

FEDEX'ERROR'CALL:
    IF HDR'BAGGER >= "1" AND HDR'BAGGER <= "9" AND SHIPPING'ENTRY = "" THEN
        SHIPPING'ENTRY = "FEDEX: "+ENTRY
    ELSE
        CALL DO'ERRL
    ENDIF
RETURN

ENDICIA'ERROR'CALL:
    IF HDR'BAGGER >= "1" AND HDR'BAGGER <= "9" AND SHIPPING'ENTRY = "" THEN
        SHIPPING'ENTRY = "ENDICIA: "+ENTRY
    ELSE
        CALL DO'ERRL
    ENDIF
RETURN

MAP1 ETIME,F

COPY "SETSLO[OE]",PRGNAM="OERCTL"    SET'SLOC:
COPY "ZONECA[OE]"  !!Canada zip/zones  CA'ZONE:
COPY "FEDEX",WANT'PSR="Y",WANT'PKG="Y",ERR'CALL="FEDEX'ERROR'CALL",ABORT'CALL="BQR'ABORT",TIME'WANTED="ETIME"
COPY "ENDICIA",WANT'LR="Y",ERR'CALL="ENDICIA'ERROR'CALL",ABORT'CALL="BQR'ABORT",TIME'WANTED="ETIME",RATE'SHOPPING="0"

SET'L1LST'FROM'LST:
    IF VIA'MTYPE # "F" AND VIA'MTYPE # "E" THEN
        L1LST'REC = LST'REC
        ALT'SHIP'FROM = 1
    ELSE
!!For Federal Express, we use Morris return address
!!we might change the label in fedex.cpy, but not these fields.
        L1LST'COMPANY = LST'COMPANY
        L1LST'FIRST = LST'FIRST
        L1LST'LAST = LST'LAST
        L1LST'TITLE = LST'TITLE
        L1LST'PHONE(1) = LST'PHONE(1)
        L1LST'NO = LST'NO
        IF HDR'SHIP'BLIND = "Y" AND INC'INTERFACE = 5 THEN
            PRINT'REC = LST'REC       !!Address to print on label (actual customer)
                                      !!to replace city, state, zip
        ELSE
            PRINT'REC = L1LST'REC     !!This is customer name/company with
                                      !!Morris's city, state, zip
        ENDIF
        ALT'SHIP'FROM = 0             !!Always Morris used in fedex calls
    ENDIF
RETURN

CHECK'NOS:
    NOS'KCUS'NO = HDR'NAM'NO
    NOS'KPO = UCS(HDR'PO)
    RDLOCK NOS INTO NOS'REC KEY NOS'KEY
    IF NOS'CTL = 0 THEN
        IF NOS'UDT = 0 THEN
            \S'TO'U UDT="NOS'UDT"
            ENTRY = "Order rejected oerctl: "
            \KERROR HDR MODE="D" CNO="N"
            NOS'FNAME = ENTRY
            WRITE NOS FROM NOS'REC
        ELSE
            REL NOS
        ENDIF
        NOS'CTL = 0
    ENDIF
RETURN

LOG'ENTRY:
    IF WL'DEBUG # "" THEN
        \ABLOGGER ENTRY WL'DEBUG
    ENDIF
RETURN

MAP1 FFF,F

SET'VICS'PTRS:
    \DG GETVALUE _OESETUP name_cache ENTRY
    IF ENTRY # "Y" RETURN                            !!KLUDGE
    XCALL VICSIT,7,999,"ROTPTR",ROTPTR,FFF
    XCALL VICSIT,7,999,"COUPTR",COUPTR,FFF
    XCALL VICSIT,7,999,"UPSPTR",UPSPTR,FFF
    XCALL VICSIT,7,999,"ZIPPTR",ZIPPTR,FFF
    XCALL VICSIT,7,999,"FEDPTR",FEDPTR,FFF
    XCALL VICSIT,7,999,"USCPTR",USCPTR,FFF
    XCALL VICSIT,7,999,"PRCPTR",PRCPTR,FFF
    XCALL VICSIT,7,999,"TYPPTR",TYPPTR,FFF
    XCALL VICSIT,7,999,"VIAPTR",VIAPTR,FFF
    XCALL VICSIT,7,999,"TRMPTR",TRMPTR,FFF
    XCALL VICSIT,7,999,"LOCPTR",LOCPTR,FFF
    XCALL VICSIT,7,999,"TRHPTR",TRHPTR,FFF
    XCALL VICSIT,7,999,"CMGPTR",CMGPTR,FFF
    XCALL VICSIT,7,999,"ATTDPTR",ATTDPTR,FFF
    XCALL VICSIT,7,999,"MCPTYPTR",MCPTYPTR,FFF
    XCALL VICSIT,7,999,"V''PTR1",V''PTR1,FFF
    XCALL VICSIT,7,999,"V''PTR2",V''PTR2,FFF
    XCALL VICSIT,7,999,"V''PTR3",V''PTR3,FFF
    XCALL VICSIT,7,999,"FFPPTR",FFPPTR,FFF
    XCALL VICSIT,7,999,"MEAPTR",MEAPTR,FFF
    XCALL VICSIT,7,999,"VILPTR",VILPTR,FFF
    XCALL VICSIT,7,999,"VTBPTR",VTBPTR,FFF
    XCALL VICSIT,7,999,"CTPPTR",CTPPTR,FFF
    XCALL VICSIT,7,999,"STXPTR",STXPTR,FFF
    XCALL VICSIT,7,999,"UOWPTR",UOWPTR,FFF
    XCALL VICSIT,7,999,"DGMSGPTR",DGMSGPTR,FFF
