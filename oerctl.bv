RETURN

MAP1 MON'MQID,B,4
MAP1 MON'KEY,B,2
MAP1 MON'REC
    MAP2 MON'SPACE,S
        MAP3 MON'PRGNAM,S,6
        MAP3 MON'ENTRY,S,166            !!Data message
        MAP3 MON'UDT,B,4
        MAP3 MON'NOLF,B,1
MAP1 NOLF,B,1

MAP1 MSP,S,20
MAP1 SPEED'T2,F
MAP1 SNDMON'LOG,S,100
MAP1 DENTRY,S,160
MAP1 RATE'SHOPPING,B,1

SNDMON:
    IF MON'MQID # 0 AND ENTRY # "" THEN   !!Only for use with OEDSHP
        MON'SPACE = SPACE
        MON'PRGNAM = "OERCTL"
        \DG GETVALUE _OESETUP monMS MSP
        IF MSP = "Y" THEN
            MSP = STR(SPEED'T2)
            MSP = LEFT(MSP+"000000000",12)
            MON'ENTRY = MSP+":"+ENTRY
        ELSE
            MON'ENTRY = ENTRY
        ENDIF
        MON'NOLF = NOLF
        NOLF = 0
        \S'TO'U UDT="MON'UDT"
        MON'MQID = MON'MQID
        MON'KEY = 1                !!1 for sending to monitor


!![WC]  \VIPCSND MON'REC DEST="MON'KEY" CTL="VMYCTL" MQID="MON'MQID"


        IF SNDMON'LOG = "" THEN
            \DG GETVALUE _UPSETUP sndmon_log SNDMON'LOG
            IF DG'CTL # 0 OR SNDMON'LOG # "Y" THEN
                SNDMON'LOG = "N"
            ENDIF
            IF SNDMON'LOG = "Y" THEN
                SNDMON'LOG = "/logs/sndmon.DAILY"
            ENDIF
        ENDIF
        IF SNDMON'LOG # "N" THEN
            \U'TO'DTT'HMS UDT="MON'UDT"
            \STRDTC DDATE="DENTRY"
            DENTRY = MON'PRGNAM+":"+MON'ENTRY+" D="+DENTRY+ &
                (HRS USING "#Z") + ":" + &
                    (MNS USING "#Z") + ":" + (SEC USING "#Z")
            \ABLOGGER DENTRY SNDMON'LOG
        ENDIF
    ENDIF
RETURN

!!malvern below
MAP1 LAST'BOX,B,2
MAP1 FROM'PRGNAM,S,10,"WLDQ2F"
MAP1 ERRORS'MBX,B,1

SHIP'A'PACKAGE:   !!send all BOX records to Malvern
    CALL GET'LAST'BOX
!!  XCALL LINK,1,"mvrx01[oe]",HDR'REC,LAST'BOX
    XCALL LINK,1,"oerx01[oe]",HDR'REC,LAST'BOX
RETURN

GET'LAST'BOX:
    LAST'BOX = 0
    BOX'SPACE = SPACE
    BOX'HDR'LOC'NO = HDR'LOC'NO
    BOX'DOC'TYPE = HDR'DOC'TYPE
    BOX'HDR'NO = HDR'NO
    BOX'SHIPMENT = HDR'SHIPMENT + 1
    BOX'NO = 1
    \SETKEY BOX MODE="KEY" APP="OE"
    USE BOX INTO BOX'REC KEY BOX'KEY
    DO
        GETNXT BOX INTO BOX'REC
        IF BOX'CTL # 0 EXIT
        IF BOX'HDR'LOC'NO # HDR'LOC'NO OR BOX'DOC'TYPE # HDR'DOC'TYPE OR &
            BOX'HDR'NO # HDR'NO OR BOX'SHIPMENT # (HDR'SHIPMENT+1) EXIT
        IF BOX'NO > LAST'BOX THEN
            LAST'BOX = BOX'NO
        ENDIF
    LOOP
RETURN

MAP1 BAD'BOX,B,2
\COPYF BOX OE BOX2 MODE="ALL"

VALIDATE'MBX:     !!If any BOX doesn't have MBX then VOID
    BAD'BOX = 0
    ERRORS'MBX = 0
    BOX'SPACE = SPACE
    BOX'HDR'LOC'NO = HDR'LOC'NO
    BOX'DOC'TYPE = HDR'DOC'TYPE
    BOX'HDR'NO = HDR'NO
    BOX'NO = 1
    BOX'SHIPMENT = HDR'SHIPMENT + 1
    \SETKEY BOX MODE="KEY" APID="OE"
    RDLOCK BOX INTO BOX'REC KEY BOX'KEY
    DO
        GETNXT BOX INTO BOX'REC
        IF BOX'CTL # 0 EXIT
        IF BOX'HDR'LOC'NO # HDR'LOC'NO OR BOX'DOC'TYPE # HDR'DOC'TYPE OR &
            BOX'HDR'NO # HDR'NO EXIT

        MBX'HDR'LOC'NO = BOX'HDR'LOC'NO
        MBX'DOC'TYPE = BOX'DOC'TYPE
        MBX'HDR'NO = BOX'HDR'NO
        MBX'SHIPMENT = BOX'SHIPMENT
        MBX'BOX'NO = BOX'NO              !!read each BOX - get Tracking No
        \SETKEY MBX MODE="KEY" APID="OE"
        USE MBX INTO MBX'REC KEY MBX'KEY
        IF MBX'CTL # 0 THEN
            BAD'BOX = BOX'NO
            ERRORS'MBX = ERRORS'MBX + 1
            REL BOX
            EXIT        !!If one fails then void all boxes
        ELSE
            IF MBX'ERROR'FLAG = "Y" THEN
                BAD'BOX = BOX'NO
                ERRORS'MBX = ERRORS'MBX + 1
                REL BOX
                EXIT        !!If one fails then void all boxes
            ENDIF

            IF O''PRODUCTION'YN = "Y" THEN
                BOX'TRACK'NO = MBX'TRACK'NO
            ELSE
!!***** Make a temporary unique Tracking number while in Test Mode *****
                BOX'TRACK'NO = "1Z"+BOX'HDR'LOC'NO + "-" + BOX'DOC'TYPE + "-"+ &
                        BOX'HDR'NO + "-" + BOX'NO + "-" + BOX'SHIPMENT
            ENDIF
            WRITE BOX FROM BOX'REC KEY BOX'KEY
            IF BOX'CTL = 0 THEN
                \SETKEY BOXT MODE="KEY" APID="OE"
                \ADDKEY BOXT MODE="KEY" APID="OE"
                IF BOXT'CTL # 0 THEN
                    IF |PGODS| THEN
                        LENTRY = "ADDKEY BOXT failed - "+BOX'TRACK'NO
                        \LOG'IT
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    LOOP
    IF ERRORS'MBX > 0 AND BAD'BOX > 1 THEN
        CALL VOID'ALL'BOX
    ENDIF
RETURN

MAP1 O''VOID'BOX,B,2,0        !!0 means void all boxes

VOID'ALL'BOX:              !!Clear BOX'TRACK'NO
    BOX'SPACE = SPACE
    BOX'HDR'LOC'NO = HDR'LOC'NO
    BOX'DOC'TYPE = HDR'DOC'TYPE
    BOX'HDR'NO = HDR'NO
    BOX'NO = 1
    BOX'SHIPMENT = HDR'SHIPMENT + 1
    \SETKEY BOX MODE="KEY" APID="OE"
    RDLOCK BOX INTO BOX'REC KEY BOX'KEY
    DO
        GETNXT BOX INTO BOX'REC
        IF BOX'CTL # 0 EXIT
        IF BOX'HDR'LOC'NO # HDR'LOC'NO OR BOX'DOC'TYPE # HDR'DOC'TYPE OR &
            BOX'HDR'NO # HDR'NO EXIT

        \SETKEY BOXT MODE="KEY" APID="OE"
        BOX'TRACK'NO = ""
        WRITE BOX FROM BOX'REC KEY BOX'KEY
        IF BOX'CTL = 0 THEN
            DELKEY BOXT
        ENDIF

        IF BOX'NO = 1 THEN
            MBX'HDR'LOC'NO = BOX'HDR'LOC'NO
            MBX'DOC'TYPE = BOX'DOC'TYPE
            MBX'HDR'NO = BOX'HDR'NO
            MBX'SHIPMENT = BOX'SHIPMENT
            MBX'BOX'NO = BOX'NO              !!read each BOX - get Tracking No
            \SETKEY MBX MODE="KEY" APID="OE"
            USE MBX INTO MBX'REC KEY MBX'KEY
            IF MBX'CTL = 0 THEN
                O''VOID'BOX = 0          !!0 means void all boxes
!!              XCALL LINK,1,"mvr023[oe]",HDR'REC,FROM'PRGNAM,O''VOID'BOX !!Void all boxes
                XCALL LINK,1,"oer023[oe]",HDR'REC,FROM'PRGNAM,O''VOID'BOX !!Void all boxes
            ENDIF
            CALL VALIDATE'ALL'BOXES'VOID
        ENDIF
    LOOP
RETURN

\COPYF MBX OE        !!Malvern Box
\COPYF MBX OE MBX9   !!Malvern Box
MAP1 VOID'ERROR'COUNT,F

VALIDATE'ALL'BOXES'VOID:
    VOID'ERROR'COUNT = 0
    MBX'HDR'LOC'NO = HDR'LOC'NO
    MBX'DOC'TYPE = HDR'DOC'TYPE
    MBX'HDR'NO = HDR'NO
    MBX'SHIPMENT = 1
    MBX'BOX'NO = 1
    \SETKEY MBX MODE="KEY" APID="OE"
    USE MBX INTO MBX'REC KEY MBX'KEY
    DO
        GETNXT MBX INTO MBX'REC KEY MBX'KEY
        IF MBX'CTL # 0 EXIT
        IF MBX'HDR'LOC'NO # HDR'LOC'NO OR MBX'DOC'TYPE # HDR'DOC'TYPE OR &
            MBX'HDR'NO # HDR'NO OR MBX'SHIPMENT # 1 EXIT

        MBX9'REC = MBX'REC
        MBX9'SHIPMENT = 99
        \SETKEY MBX MODE="KEY" APID="OE" ALTPRE="MBX9" ALTKEY="MBX9"
        USE MBX9 INTO MBX9'REC KEY MBX9'KEY
        IF MBX9'CTL # 0 THEN
            VOID'ERROR'COUNT = VOID'ERROR'COUNT + 1
        ENDIF
    LOOP
    IF VOID'ERROR'COUNT > 0 THEN
        ENTRY = "Unable to void all Malvern Ship A Package boxes Q="
        \KERROR WLQ APID="WL" CNO="N" MODE="D"
        CALL MSG'APPEND
    ENDIF
RETURN

GET'SHIP'LABELS:
    BAD'BOX = 0
    ERRORS'MBX = 0
    BOX'SPACE = SPACE
    BOX'HDR'LOC'NO = HDR'LOC'NO
    BOX'DOC'TYPE = HDR'DOC'TYPE
    BOX'HDR'NO = HDR'NO
    BOX'NO = 1
    BOX'SHIPMENT = HDR'SHIPMENT + 1
    \SETKEY BOX MODE="KEY" APID="OE"
    USE BOX INTO BOX'REC KEY BOX'KEY
    DO
        GETNXT BOX INTO BOX'REC
        IF BOX'CTL # 0 EXIT
        IF BOX'HDR'LOC'NO # HDR'LOC'NO OR BOX'DOC'TYPE # HDR'DOC'TYPE OR &
                                          BOX'HDR'NO # HDR'NO EXIT
        MBX'HDR'LOC'NO = BOX'HDR'LOC'NO
        MBX'DOC'TYPE = BOX'DOC'TYPE
        MBX'HDR'NO = BOX'HDR'NO
        MBX'SHIPMENT = BOX'SHIPMENT
        MBX'BOX'NO = BOX'NO
        \SETKEY MBX MODE="KEY" APID="OE"
        USE MBX INTO MBX'REC KEY MBX'KEY
        IF MBX'CTL = 0 THEN
            IF MBX'ERROR'FLAG = "Y" THEN
                BAD'BOX = BOX'NO
                ERRORS'MBX = ERRORS'MBX + 1
                ENTRY = "Some Malvern ship labels not retrieved BOX:"
                \KERROR BOX MODE="D" APID="OE" CNO="N"
                CALL DO'ERR'OERCTL
                REPEAT                  !!skip any with errors but keep going
            ENDIF
            BEFORE'OER095:
            XCALL LINK,1,"oer095[oe]",BOX'REC,HDR'REC,LAST'BOX,HDR'RCN,FROM'PRGNAM
            AFTER'OER095:
        ENDIF
    LOOP
RETURN
!!Malvern above
