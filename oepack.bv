PROGRAM OEPACK,8.0(66)
GLOBAL MY'PRGNAM="OEPACK"
GLOBAL PACK'PRGNAM="OEPACK"
GLOBAL BITS'CHECK'ERROR="N"                     !!BITS.MAC
