ADD'HOLIDAY'CHARGES:
    TIME'CSV = "ADD'HOLIDAY'CHARGER:" : \TIME'CSV
    LENTRY = "ADD'HOLIDAY'CHARGER:"
    \LOG'IT
    RETURN    !!Malvern
CIF MALVERN AND NOT MALVERN THEN
    CASE
!!Surepost (11/19 - 12/23 $.36)
!!Once more should by via and only that (well tbl too)
    IF VIA'MAN'YN = "C" AND (VIA'SERV'TYPE = "92" OR VIA'SERV'TYPE = "93") THEN
        \DG GETVALUE _UPSETUP UPS_holiday.surepost.date_start ENTRY
        IF DG'CTL = 0 AND ENTRY # "" THEN
            DMN = ENTRY[1;2] USING "#Z"
            DDY = ENTRY[3;2] USING "#Z"
            DYR = BYR
            CALL CNV'DTT
            SDAYS = YDAYS
            \DG GETVALUE _UPSETUP UPS_holiday.surepost.date_end ENTRY
            IF DG'CTL = 0 AND ENTRY # "" THEN
                DMN = ENTRY[1;2] USING "#Z"
                DDY = ENTRY[3;2] USING "#Z"
                DYR = BYR
                CALL CNV'DTT
                EDAYS = YDAYS
                IF SDAYS # 0 AND EDAYS # 0 THEN
                    IF TODAY >= SDAYS AND TODAY <= EDAYS THEN
                        \DG GETVALUE _UPSETUP UPS_holiday.surepost.fee ENTRY
                        IF DG'CTL = 0 AND ENTRY # "" THEN
!!Malvern                   CALC'TBL'AMT = CALC'TBL'AMT + STR(ENTRY)
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
!!Ground (11/19 - 12/23 $.27)
    ELSE
    IF VIA'MAN'YN = "C" OR VIA'MAN'YN = "H" OR VIA'MAN'YN = "F" THEN
        \DG GETVALUE _UPSETUP UPS_holiday.ground.date_start ENTRY
        IF DG'CTL = 0 AND ENTRY # "" THEN
            DMN = ENTRY[1;2] USING "#Z"
            DDY = ENTRY[3;2] USING "#Z"
            DYR = BYR
            CALL CNV'DTT
            SDAYS = YDAYS
            \DG GETVALUE _UPSETUP UPS_holiday.ground.date_end ENTRY
            IF DG'CTL = 0 AND ENTRY # "" THEN
                DMN = ENTRY[1;2] USING "#Z"
                DDY = ENTRY[3;2] USING "#Z"
                DYR = BYR
                CALL CNV'DTT
                EDAYS = YDAYS
                IF SDAYS # 0 AND EDAYS # 0 THEN
                    IF TODAY >= SDAYS AND TODAY <= EDAYS THEN
                        \DG GETVALUE _UPSETUP UPS_holiday.ground.fee ENTRY
                        IF DG'CTL = 0 AND ENTRY # "" THEN
!!Malvern                   CALC'TBL'AMT = CALC'TBL'AMT + STR(ENTRY)
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ELSE
!!Second (12/17 - 12/23 $.97)
    IF VIA'MAN'YN = "S" OR VIA'MAN'YN = "E" OR VIA'MAN'YN = "2" OR &
                           VIA'MAN'YN = "Y" THEN
        \DG GETVALUE _UPSETUP UPS_holiday.second.date_start ENTRY
        IF DG'CTL = 0 AND ENTRY # "" THEN
            DMN = ENTRY[1;2] USING "#Z"
            DDY = ENTRY[3;2] USING "#Z"
            DYR = BYR
            CALL CNV'DTT
            SDAYS = YDAYS
            \DG GETVALUE _UPSETUP UPS_holiday.second.date_end ENTRY
            IF DG'CTL = 0 AND ENTRY # "" THEN
                DMN = ENTRY[1;2] USING "#Z"
                DDY = ENTRY[3;2] USING "#Z"
                DYR = BYR
                CALL CNV'DTT
                EDAYS = YDAYS
                IF SDAYS # 0 AND EDAYS # 0 THEN
                    IF TODAY >= SDAYS AND TODAY <= EDAYS THEN
                        \DG GETVALUE _UPSETUP UPS_holiday.second.fee ENTRY
                        IF DG'CTL = 0 AND ENTRY # "" THEN
!!Malvern                   CALC'TBL'AMT = CALC'TBL'AMT + STR(ENTRY)
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ELSE
!!Third (12/17 - 12/23 $.97)
    IF VIA'MAN'YN = "R" OR VIA'MAN'YN = "3" OR VIA'MAN'YN = "Z" THEN
        \DG GETVALUE _UPSETUP UPS_holiday.second.date_start ENTRY
        IF DG'CTL = 0 AND ENTRY # "" THEN
            DMN = ENTRY[1;2] USING "#Z"
            DDY = ENTRY[3;2] USING "#Z"
            DYR = BYR
            CALL CNV'DTT
            SDAYS = YDAYS
            \DG GETVALUE _UPSETUP UPS_holiday.second.date_end ENTRY
            IF DG'CTL = 0 AND ENTRY # "" THEN
                DMN = ENTRY[1;2] USING "#Z"
                DDY = ENTRY[3;2] USING "#Z"
                DYR = BYR
                CALL CNV'DTT
                EDAYS = YDAYS
                IF SDAYS # 0 AND EDAYS # 0 THEN
                    IF TODAY >= SDAYS AND TODAY <= EDAYS THEN
                        \DG GETVALUE _UPSETUP UPS_holiday.second.fee ENTRY
                        IF DG'CTL = 0 AND ENTRY # "" THEN
!!Malvern                   CALC'TBL'AMT = CALC'TBL'AMT + STR(ENTRY)
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ELSE
!!Next (12/17 - 12/23 $.81)
    IF VIA'MAN'YN = "A" OR VIA'MAN'YN = "L" OR VIA'MAN'YN = "1" OR &
                           VIA'MAN'YN = "X" THEN
        \DG GETVALUE _UPSETUP UPS_holiday.next.date_start ENTRY
        IF DG'CTL = 0 AND ENTRY # "" THEN
            DMN = ENTRY[1;2] USING "#Z"
            DDY = ENTRY[3;2] USING "#Z"
            DYR = BYR
            CALL CNV'DTT
            SDAYS = YDAYS
            \DG GETVALUE _UPSETUP UPS_holiday.next.date_end ENTRY
            IF DG'CTL = 0 AND ENTRY # "" THEN
                DMN = ENTRY[1;2] USING "#Z"
                DDY = ENTRY[3;2] USING "#Z"
                DYR = BYR
                CALL CNV'DTT
                EDAYS = YDAYS
                IF SDAYS # 0 AND EDAYS # 0 THEN
                    IF TODAY >= SDAYS AND TODAY <= EDAYS THEN
                        \DG GETVALUE _UPSETUP UPS_holiday.next.fee ENTRY
                        IF DG'CTL = 0 AND ENTRY # "" THEN
!!Malvern                   CALC'TBL'AMT = CALC'TBL'AMT + STR(ENTRY)
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDCASE
ENDCIF        !!Malvern
RETURN

SET'FAKE'BOX:                !!Only used if not AUTOPACK
    TIME'CSV = "SET'FAKE'BOX:" : \TIME'CSV
    LENTRY = "SET'FAKE'BOX:"
    \LOG'IT
    INX1 = 1
    INX2 = 0
    TST'FUNC = 0
    KK = 1
!!Sun fill weights or??  For free freight.
    WGT'WGT(KK) = 1
    WGT'OVERSIZ1(KK) = "N"
    WGT'OVERSIZ2(KK) = "N"
    WGT'OVERSIZ3(KK) = "N"
    WGT'ADDCHG(KK) = "N"
    WGT'DIMENSION(KK) = "N"
    WGT'HAZ'MAT(KK) = "N"
    BREC'SPACE = SPACE
    BTYPE = "B"                     !Customer/actual/????
    BNO = 1                         !Box Number
    BCWEIGHT = 1                    !Computed Weight
    BFWEIGHT = 1                    !![66] Computed Weight (Free Freight Items)
    BCMAX = 1                       !Maximum Weight (weighted average)
!   BCD(6),B,5                      !Charge/Discount totals
    BSHP'TOTAL = HDR'SHP'TOTAL      !Shippable Total
    BSHP'DISC = HDR'SHP'DISC        !Shippable Discount
    BSHP'STX1 = HDR'STX2FINAL       !Sales Tax
!   BSHP'STX2 = 0                   !Extra Tax (Excise, Etc)
!   BOLD'CASH = 0                   !Old Cash Applied
!   BOLD'DR = 0                     !Old Debits Applied
!   BOLD'CR = 0                     !Old Credits Applied
!!Sun free freight may be wrong if we don't do this right (BITEMS)
    BITEMS = HDR'LIN'COUNT          !Number Of Items
!   BSHP'VTTL(7),B,5                !Ship Via Totals
    BSHP'LOC'NO = HDR'LOC'NO        !Ship From Location

    BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ") + "0001"
    XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD
    BKEY[1;1] = "A"
    XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE

    WE'HAVE'BRECS = 1
    WE'HAVE'ARECS = 1
RETURN

\COPYF SPD IN
MAP1 HIGH'BOX,B,2
MAP1 SPDPTR,X,30

INIT'SPECIAL'PACKING:
    TIME'CSV = "INIT'SPEICAL'PACKING:" : \TIME'CSV
    LENTRY = "INIT'SPEICAL'PACKING:"
    \LOG'IT
    SF = 0

    CALL GET'ZONE

    IF MAX'BOX = 9999 THEN
        HIGH'BOX = 9999
    ELSE
        SPD'KSPI'VIA'NO = HDR'BVIA'NO
        SPD'KSPI'ZONE = ALOC'ZONE(1)
        SPD'KSPI'WGT = INT((SPECIAL'WGT+99)/100)
        SPD'KBOX'NO = 1
        \VUSE SPD
        CASE
        IF SPD'CTL # 0 THEN
            MAX'BOX = 9999
            HIGH'BOX = 9999
            HDR'HOW'PACK = "C"    !!Conventional
        ELSE
        IF SPD'BOX'WGT > CUS'MAX'WEIGHT THEN
            MAX'BOX = 9999
            HIGH'BOX = 9999
            HDR'HOW'PACK = "W"    !!Weight
        ELSE
            SPD'KBOX'NO = -1
            RDKEY SPD
            GETPRV SPD
            SPD'KEY = SPD'KEY2
            HIGH'BOX = SPD'KBOX'NO
            MAX'BOX = HIGH'BOX
            HDR'HOW'PACK = "A"    !!Algorithm
        ENDCASE
    ENDIF
    TIME'CSV = "INIT'SPEICAL'PACKING: HDR'HOW'PACK = "+HDR'HOW'PACK
    \TIME'CSV
RETURN

\COPYF PKG WL

SET'LWH:
        TIME'CSV = "SET'LWH:" : \TIME'CSV
        LENTRY = "SET'LWH:"
        \LOG'IT
        LINKEY = (BXL'HDR'LOC'NO USING "#ZZZ") + (BXL'HDR'NO USING "#ZZZZZZ")
        IF LIN'CACHED = 2 THEN
            LIN'NO = BXL'LIN'NO
            ENTRY = LINKEY+" look for "+LIN'NO+" in SET'LWH"
            CALL FIND'LIN'REC
        ELSE
            LINKEY = LINKEY + (BXL'LIN'NO USING "#ZZZ")
            ENTRY = LINKEY
            XCALL VICSIT,7,3,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!USE
        ENDIF
        IF LIN'CTL # 0 THEN
            ENTRY = "Packing failed on LIN dimensional: " + ENTRY
            CALL DO'ERRL
            GOTO DEAD'ABORT
        ENDIF
        IF LIN'TEMP = "D" THEN
            BOX'KHDR'LOC'NO = BXL'HDR'LOC'NO
            BOX'KDOC'TYPE = BXL'DOC'TYPE
            BOX'KHDR'NO = BXL'HDR'NO
            BOX'KSHIPMENT = BXL'SHIPMENT
            BOX'KNO = BXL'BOX'NO
            RDLOCK BOX INTO BOX'REC KEY BOX'KEY
            IF BOX'CTL # 0 THEN
                ENTRY = "Packing failed on BOX dimensional:"
                \KERROR BOX MODE="K" CNO="N"
                CALL DO'ERRL
                GOTO DEAD'ABORT
            ENDIF
            CALL FIND'MEA            !!And UOW and PKG
            IF BOX'LENGTH # PKG'CASE'LEN OR BOX'WIDTH # PKG'CASE'WID OR &
                                             BOX'HEIGHT # PKG'CASE'HEI THEN
                BOX'LENGTH = PKG'CASE'LEN
                BOX'WIDTH = PKG'CASE'WID
                BOX'HEIGHT = PKG'CASE'HEI
                BOX'GIRTH = (BOX'HEIGHT * 2) + (BOX'WIDTH * 2)
                WRITE BOX FROM BOX'REC
            ELSE
                REL BOX
            ENDIF
        ENDIF
RETURN

MAP1 LINKEY3,S,40
\COPYF LIN OE LIN3 MODE="DTA"

DUMP'LIN:
!!  OPEN #223,"OEPACK.BUG", APPEND
!!  PRINT #223,"START DUMP'LIN: ";ENTRY
!!  LINKEY3 = ""
!!  DO
!!      XCALL VICSIT,7,4,LIN3'REC,LINKEY3,LINPTR,0,LIN3'PKT !!GETNXT
!!      IF LIN3'CTL # 0 EXIT
!!      PRINT #223,"CACHE: ";LINKEY3;" ";LIN3'NO;" ";LIN3'TEMP
!!  LOOP
!!  PRINT #223,"END   DUMP'LIN: ";ENTRY
!!  CLOSE #223
RETURN

SET'WGT'FROM'BOX'CHARGES:        !!Sets WGT' fields from BOX'CHARGES bits
    TIME'CSV = "SET'WGT'FROM'BOX'CHARGES:" : \TIME'CSV
    VIA'KNO = HDR'VIA'NO
    CALL GET'VIA
    \SETWGTFROMBOX CACHE'FIELDS="N"   !!place !!real
RETURN

!!BCHARGES from BREC

SET'BCHARGES'FROM'WGT'CACHE:       !!Set bits from !!cache
    TIME'CSV = "SET'BCHARGES'FROM'WGT'CACHE:" : \TIME'CSV
    \SETBOXFROMWGT CLRWGT="Y" CACHE'FIELDS="Y"   !!place !!cache
RETURN

MAP1 OS3'SURCHARGE,S,1

SNUFF'BOXES:
    TIME'CSV = "SNUFF'BOXES:" : \TIME'CSV
    LENTRY = "SNUFF'BOXES:"
    \LOG'IT
    BOX'SPACE = SPACE
    BOX'HDR'LOC'NO = HDR'LOC'NO
    BOX'DOC'TYPE = HDR'DOC'TYPE
    BOX'HDR'NO = HDR'NO
    BOX'NO = 1
    BOX'SHIPMENT = HDR'SHIPMENT + 1
    \SETKEY BOX MODE="KEY"
    CALL DELETE'REMAINING'BOXES
    BXV'SPACE = SPACE
    BXV'HDR'LOC'NO = HDR'LOC'NO
    BXV'DOC'TYPE = HDR'DOC'TYPE
    BXV'HDR'NO = HDR'NO
    BXV'NO = 1
    BXV'SHIPMENT = HDR'SHIPMENT + 1
    \SETKEY BXV MODE="KEY"
    CALL DELETE'REMAINING'BXVES
    CALL RESTORE'WREC'CACHE
RETURN

COMPUTE'OS'STUFF:   !!Only used if mannually entering which we don't do
                    !!COMPUTE'OS'STUFF uses BOX and we use cache
        TIME'CSV = "COMPUTE'OS'STUFF:" : \TIME'CSV
        LENTRY = "COMPUTE'OS'STUFF:"
        \LOG'IT
        CALL SET'BREC'FROM'BOX'REC
        CALL COMPUTE'OS'STUFF1
        CALL SET'BOX'REC'FROM'BREC
RETURN

COMPUTE'OS'STUFF1:
        TIME'CSV = "COMPUTE'OS'STUFF1:" : \TIME'CSV
        LENTRY = "COMPUTE'OS'STUFF1:"
        \LOG'IT
        NEW'SWGT = 0
        CASE
        IF VIA'MTYPE = "U" THEN
!!UPS
            COMPUTE'OS = 0
            RATE'SHOPPING = 1
!!place !!real
            CALL SET'WGT'AC'YN !!Only to get WGT'AC'YN set  !!doing cache
            RATE'SHOPPING = 0
            CALL SET'BOX'CHARGES'FROM'WGT'REAL !!Set bits from !!real

            IF AMT1 # 0 THEN
                COMPUTE'OS = 1
                RETURN            !!new way done
            ENDIF
            COMPUTE'OS = 0
            IF (VIA'MTYPE = "U" AND (VIA'MAN'YN = "C" OR VIA'MAN'YN = "A" OR &
                VIA'MAN'YN = "S" OR VIA'MAN'YN = "R" OR VIA'MAN'YN = "H" OR &
                VIA'MAN'YN = "1" OR VIA'MAN'YN = "2" OR VIA'MAN'YN = "3" OR &
                VIA'MAN'YN = "F" OR VIA'MAN'YN = "X" OR VIA'MAN'YN = "Y" OR &
                VIA'MAN'YN = "Z" OR VIA'MAN'YN = "W" OR VIA'MAN'YN = "P" OR &
                VIA'MAN'YN = "B" OR VIA'MAN'YN = "D" OR VIA'MAN'YN = "I")) THEN
              COMPUTE'OS = 1
            ENDIF
            IF COMPUTE'OS # 1 RETURN            !!KLUDGE
            LARGE'SIZE = BOX'GIRTH + BOX'LENGTH + (BOX'HEIGHT *2)
            CASE
            IF (VIA'MAN'YN = "C" AND VIA'SERV'TYPE = "03") OR &
                                                   VIA'MAN'YN = "H" THEN
!!UPS Ground or 100 Weight Ground (not including Surepost)
                CALL SET'WGT'AC'YN
            ELSE
            IF VIA'MAN'YN = "A" OR VIA'MAN'YN = "S" OR VIA'MAN'YN = "R" OR &
               VIA'MAN'YN = "1" OR VIA'MAN'YN = "2" OR VIA'MAN'YN = "3" OR &
               VIA'MAN'YN = "F" OR VIA'MAN'YN = "X" OR VIA'MAN'YN = "Y" OR &
               VIA'MAN'YN = "Z" OR VIA'MAN'YN = "W" OR VIA'MAN'YN = "P" OR &
               VIA'MAN'YN = "B" OR VIA'MAN'YN = "D" OR VIA'MAN'YN = "I" THEN
!!All other UPS not Surepost
                        CALL SET'WGT'AC'YN
            ELSE
            IF (VIA'SERV'TYPE = "92" OR VIA'SERV'TYPE = "93") AND LARGE'SIZE > 130 THEN
                WGT'LGE'PKG'YN = "N"
!!Surepost
            ELSE
            IF (VIA'SERV'TYPE = "92" OR VIA'SERV'TYPE = "93") THEN
!!Left hardcoded and may not even use the international above but ... easier
!!Surepost
                CASE
                IF BOX'LENGTH > 48 OR BOX'WIDTH > 48 OR BOX'HEIGHT > 48 THEN
                    WGT'AC'YN = "Y"
                    NON'MACHINABLE = "N"
                ELSE
                IF BOX'LENGTH > 30 AND BOX'WIDTH > 30 THEN
                    WGT'AC'YN = "Y"
                    NON'MACHINABLE = "N"
                ELSE
                IF BOX'LENGTH > 30 AND BOX'HEIGHT > 30 THEN
                    WGT'AC'YN = "Y"
                    NON'MACHINABLE = "N"
                ELSE
                IF BOX'WIDTH > 30 AND BOX'HEIGHT > 30 THEN
                    WGT'AC'YN = "Y"
                    NON'MACHINABLE = "N"
                ELSE
                IF BOX'LENGTH > 34 AND BOX'LENGTH <= 48 THEN
                    MAP1 NON'MACHINABLE,S,1
                    NON'MACHINABLE = "Y"
                    WGT'AC'YN = "N"
                ELSE
                IF BOX'WIDTH > 34 AND BOX'WIDTH <= 48 THEN
                    NON'MACHINABLE = "Y"
                    WGT'AC'YN = "N"
                ELSE
                IF BOX'HEIGHT > 34 AND BOX'HEIGHT <= 48 THEN
                    NON'MACHINABLE = "Y"
                    WGT'AC'YN = "N"
                ELSE
                IF (BOX'LENGTH > 17 AND BOX'LENGTH <= 30) AND &
                    (BOX'WIDTH > 17 AND BOX'WIDTH <= 30) THEN
                        NON'MACHINABLE = "Y"
                        WGT'AC'YN = "N"
                ELSE
                IF (BOX'LENGTH > 17 AND BOX'LENGTH <= 30) AND &
                    (BOX'HEIGHT > 17 AND BOX'HEIGHT <= 30) THEN
                        NON'MACHINABLE = "Y"
                        WGT'AC'YN = "N"
                ELSE
                IF (BOX'WIDTH > 17 AND BOX'WIDTH <= 30) AND &
                    (BOX'HEIGHT > 17 AND BOX'HEIGHT <= 30) THEN
                        NON'MACHINABLE = "Y"
                        WGT'AC'YN = "N"
                ELSE
                    WGT'AC'YN = "N"
                    NON'MACHINABLE = "N"
                ENDCASE
            ENDCASE

            CASE
            IF (LARGE'SIZE > 130 AND LARGE'SIZE =< 165) OR &
                        BOX'LENGTH > 96 THEN
                WGT'LGE'PKG'YN = "Y"      !!large package
                WGT'AC'YN = "N"
            ELSE
            IF LARGE'SIZE > 165 THEN
                ENTRY = "Cannot ship a package larger than 165 in."
                WGT'LGE'PKG'YN = "N"
                GOTO DO'ERR
            ELSE
                WGT'LGE'PKG'YN = "N"
            ENDCASE

            CUBIC'SIZE = BOX'HEIGHT * BOX'LENGTH * BOX'WIDTH
!!UPS Ground/100 Weight and UPS to Canada/Surepost
            \IS'POB PRE="LST"
            IF VIA'MTYPE = "U" AND (VIA'MAN'YN = "C" OR VIA'MAN'YN = "H" OR &
                                    VIA'MAN'YN = "B") THEN

!!All Surepost services (regardless of weight)
                IF VIA'1Z'SERV = "YH" OR VIA'1Z'SERV = "YN" OR VIA'1Z'SERV = "YP" OR &
                            VIA'1Z'SERV = "YT" OR VIA'1Z'SERV = "YW" THEN

                    IF CUBIC'SIZE >= 5184 THEN
                        CALL DETERMINE'DIM'EXTRA'CHARGES   !!weight is set
                        CALL DETERMINE'WEIGHT'FOR'BILLING  !!weight is set
                    ELSE
!!Surepost < 1 lb not dimensional
                        IF VIA'1Z'SERV = "YH" OR VIA'1Z'SERV = "YN" OR VIA'1Z'SERV = "YP" THEN
                            NEW'SWGT = (BOX'WEIGHT * 16)/100
                            WGT'D'YN = "N"                    !!Not Dimensional
                        ELSE
!!Surepost > 1 lb not dimensional
                            NEW'SWGT = INT((BOX'WEIGHT + 99)/100)
                            WGT'D'YN = "N"                    !!Not Dimensional
                        ENDIF
                    ENDIF
                ELSE
                    CALL DETERMINE'DIM'EXTRA'CHARGES
                    CALL DETERMINE'WEIGHT'FOR'BILLING
                ENDIF
                IF DIM'MULTI'BOX # 1 AND IPC'MQID = 0 AND RATE'SHOPPING = 0 THEN
                    \DDBEDT SCREEN="PACK12" SINX="Y" DDBEDT="SAV'PACKS"
                ENDIF
            ELSE                                           !!Air
!!UPS Air & International (excluding Canada)
                MAP1 UPS'SPECIAL'AIR,S,1
                \DG GETVALUE _UPSETUP UPS_Special.air ENTRY
                IF DG'CTL = 0 AND ENTRY = "Y" THEN
                    UPS'SPECIAL'AIR = "Y"
                ELSE
                    UPS'SPECIAL'AIR = "N"
                ENDIF
!!Next Day, 2nd Day, 3rd Day, Letters also
                IF (VIA'MAN'YN = "A" OR VIA'MAN'YN = "S" OR VIA'MAN'YN = "R" OR &
                    VIA'MAN'YN = "L" OR VIA'MAN'YN = "E") THEN
                    IF CUBIC'SIZE < 1728 AND UPS'SPECIAL'AIR = "Y" THEN
                        NEW'SWGT = INT((BOX'WEIGHT + 99)/100)
                        WGT'D'YN = "N"                    !!Not Dimensional
                    ELSE
                        CALL DETERMINE'DIM'EXTRA'CHARGES
                        CALL DETERMINE'WEIGHT'FOR'BILLING
                    ENDIF
                ELSE
!!International services
                    CALL DETERMINE'DIM'EXTRA'CHARGES
                    CALL DETERMINE'WEIGHT'FOR'BILLING
                ENDIF

                IF DIM'MULTI'BOX # 1 AND IPC'MQID = 0 AND RATE'SHOPPING = 0 THEN
                    \DDBEDT SCREEN="PACK12" SINX="Y" DDBEDT="SAV'PACKS"
                ENDIF
            ENDIF
!!UPS END
        ELSE
        IF VIA'MTYPE = "G" OR (VIA'MTYPE = "E" AND RATE'SHOPPING = 1) THEN
            LARGE'SIZE = BOX'LENGTH + BOX'GIRTH
            CASE
            IF LARGE'SIZE > 84 AND LARGE'SIZE =< 108 THEN
                WGT'AC'YN = "L"        !!Large
            ELSE
            IF LARGE'SIZE > 108 AND LARGE'SIZE <= 130 THEN
                IF VIA'MAN'YN = "D" THEN
                    WGT'AC'YN = "O"       !!Oversize
                ELSE
                    IF RATE'SHOPPING = 1 THEN
!                       IF WL'DEBUG # "" THEN
!                           ENTRY = " endicia fail via="+VIA'NO
!                           CALL LOG'ENTRY
!                       ENDIF
                        HDR'LVIA'NO(PP) = 0
                        RETURN                        !!KLUDGE
                    ENDIF
                    ENTRY = "Oversize packages can only be shipped Parcel Post!"
                    GOTO DO'ERR
                ENDIF
            ELSE
                WGT'AC'YN = "R"        !!Regular
            ENDCASE

            CUBIC'SIZE = BOX'HEIGHT * BOX'LENGTH * BOX'WIDTH
            IF WGT'RECTANGLE = "V" OR WGT'RECTANGLE = "N" THEN !!not rectangular
                CUBIC'SIZE = CUBIC'SIZE * (785/1000)
            ENDIF
            IF CUBIC'SIZE > 1728 AND VIA'MAN'YN # "E" THEN
                CALL DETERMINE'DIM'EXTRA'CHARGES
                NEW'SWGT = INT((DIM'WEIGHT + 99)/100)
!!Only put on manifest dimensional weight if zone is >= zone 5
                IF ZONE(1) >= 5 THEN
                    IF BOX'WEIGHT/100 > NEW'SWGT THEN
                        MANIFEST'WEIGHT = (BOX'WEIGHT + 99)/100
                    ELSE
                        MANIFEST'WEIGHT = NEW'SWGT
                    ENDIF
                    DIM'INDICATOR = "*"
                ELSE
                    IF WGT'AC'YN = "L" OR WGT'AC'YN = "O" THEN
                        IF INT((BOX'WEIGHT + 99)/100) > 20 THEN
                            MANIFEST'WEIGHT = INT((BOX'WEIGHT + 99)/100)
                        ELSE
                            MANIFEST'WEIGHT = 20
                        ENDIF
                        DIM'INDICATOR = ""
                    ELSE
                        MANIFEST'WEIGHT = INT((BOX'WEIGHT + 99)/100)
                        DIM'INDICATOR = ""
                    ENDIF
                ENDIF
                WGT'D'YN = "Y"            !!Dimensional
            ELSE
!!Express
                NEW'SWGT = INT((BOX'WEIGHT + 99)/100)
                MANIFEST'WEIGHT = NEW'SWGT
                WGT'D'YN = "N"            !!Not dimensional
            ENDIF
            IF WGT'RECTANGLE = "V" OR WGT'RECTANGLE = "N" THEN  !!non rectangular
                IF ((DIM'WEIGHT + 99)/100) > 7000 THEN
                    NEW'SWGT = 70         !!Minimum 70 lbs
                    WGT'D'YN = "Y"        !!Dimensional
                ENDIF
            ENDIF
            IF DIM'MULTI'BOX # 1 AND IPC'MQID = 0 AND RATE'SHOPPING = 0 THEN
                \DDBEDT SCREEN="PACK11" SINX="Y" DDBEDT="SAV'PACKS"
            ENDIF
        ELSE
!!Fedex
        IF VIA'MTYPE = "F" THEN
            COMPUTE'OS = 0
            IF (VIA'MTYPE = "F" AND (VIA'MAN'YN = "C" OR VIA'MAN'YN = "A" OR &
                VIA'MAN'YN = "B" OR VIA'MAN'YN = "D" OR VIA'MAN'YN = "E" OR &
                VIA'MAN'YN = "F" OR VIA'MAN'YN = "G" OR VIA'MAN'YN = "H" OR &
                VIA'MAN'YN = "J" OR VIA'MAN'YN = "K" OR VIA'MAN'YN = "L" OR &
                VIA'MAN'YN = "M")) THEN
              COMPUTE'OS = 1
            ENDIF
            IF COMPUTE'OS # 1 RETURN            !!KLUDGE
            LARGE'SIZE = BOX'GIRTH + BOX'LENGTH

            CASE
            IF VIA'MAN'YN = "E" THEN
!Smartpost
                CASE
                IF BOX'LENGTH > 60 OR BOX'WIDTH > 60 OR BOX'HEIGHT > 60 THEN
                    ENTRY = "Cannot ship a package that exceeds 60 inches!"
                    GOTO DO'ERR
                ELSE
                IF LARGE'SIZE > 84 THEN
                    ENTRY = "Cannot ship a package that exceeds 84 in (Length+girth)!"
                    GOTO DO'ERR
                ELSE
                IF BOX'LENGTH < 6 AND BOX'WIDTH < 4 AND BOX'HEIGHT < 1 THEN
                    ENTRY = "Cannot ship a package this small via Smartpost!"
                    GOTO DO'ERR
                ENDCASE
            ELSE
!Ground,Home Delivery
            IF BOX'LENGTH > 108 THEN
                ENTRY = "Cannot ship a package that exceeds 108 inches!"
                GOTO DO'ERR
            ELSE
!International First
            IF LARGE'SIZE > 130 AND (VIA'MAN'YN = "K" OR VIA'MAN'YN = "L" OR &
                            VIA'MAN'YN = "J") THEN
                ENTRY = "Cannot ship a package exceeding 130 in (Length+girth)!"
                GOTO DO'ERR
            ELSE

!Ground,Home Delivery
            IF LARGE'SIZE > 165 THEN
                ENTRY = "Cannot ship a package exceeding 165 in (Length+girth)!"
                GOTO DO'ERR
            ELSE
            IF (LARGE'SIZE > 130 AND LARGE'SIZE =< 165) OR &
                    BOX'LENGTH > 96 THEN
                WGT'LGE'PKG'YN = "Y"      !!large package
            ELSE
                WGT'LGE'PKG'YN = "N"
            ENDCASE
            CUBIC'SIZE = BOX'HEIGHT * BOX'LENGTH * BOX'WIDTH
!!the greater than 3 cubic foot rule no longer applies as of 1/1/15
!!          IF CUBIC'SIZE >= 5184 THEN
!Now have dimensional weight
                CALL DETERMINE'DIM'EXTRA'CHARGES
                CALL DETERMINE'WEIGHT'FOR'BILLING
!!          ELSE
!!              NEW'SWGT = INT((BOX'WEIGHT + 99)/100)
!!              WGT'D'YN = "N"                    !!Not Dimensional
!!          ENDIF
            IF DIM'MULTI'BOX # 1 AND IPC'MQID = 0 AND RATE'SHOPPING = 0 THEN
                \DDBEDT SCREEN="PACK09" SINX="Y" DDBEDT="SAV'PACKS"
            ENDIF
        ENDCASE
RETURN

MAP1 VVV,F

GET'VIA:
    TIME'CSV = "GET'VIA: SPECIAL'WGT="+SPECIAL'WGT+" CARRIER="+VIA'CARRIER : \TIME'CSV
    CALL FIND'CUS
    \VUSE VIA
!!Override UPSSPS VIA begin SPECIAL'WGT is calculated in CALC'SPECIAL'WGT
    IF VIA'CARRIER = "UPSSPS" AND SPECIAL'WGT > 950  THEN
        IF VIA'AVIA'NO(1) > 0 THEN
            HDR'VIA'NO = VIA'AVIA'NO(1)
            HDR'BVIA'NO = VIA'AVIA'NO(1)
            VIA'KNO = HDR'VIA'NO
            \VUSE VIA
        ENDIF
    ENDIF
!!Override UPSSPS VIA end
FIX'VIA:
    TIME'CSV = "FIX'VIA:"  : \TIME'CSV
    FOR VVV = 1 TO 7
        IF VIA'CHG'OPT(VVV) => 1 AND VIA'CHG'OPT(VVV) <= 5 THEN
            IF CUS'FCHG'YN(VIA'CHG'OPT(VVV)) = "N"  OR  CUS'FCHG'YN(VIA'CHG'OPT(VVV)) = "O" THEN
                VIA'TBL'NO(VVV) = 0
                IF (VVV - 3) > 0 THEN
                    VIA'MTDESC(VVV-3) = ""
                ENDIF
            ENDIF
        ENDIF
    NEXT VVV
RETURN

MAP1 PIG'ENTRY,S,160

CIF JUNK AND NOT JUNK THEN
!!Warning - careful you don't trash WKEY and WPTR if you use this
MAP1 WWCNT,B,5

DUMP'WREC'CACHE:
    IF |PGODS| THEN
        TIME'CSV = "DUMP'WREC'CACHE:" : \TIME'CSV
        LENTRY = "DUMP'WREC'CACHE:"
        \LOG'IT

        WWCNT = 0
        WKEY = ""
        DO
            XCALL VICSIT,7,4,WREC,WKEY,WPTR,0,WCTL    !!getnxt
            IF WCTL # 0 EXIT
            WWCNT = WWCNT + 1

                IF WTEMP= "Z" AND DOING'HAZ = 1  THEN
                    ENTRY = "  HAZ  "
                ELSE
                    ENTRY = " NORM  "
                ENDIF
                ENTRY = ENTRY+" CNT="+(WWCNT USING "#ZZ")
                ENTRY = ENTRY+" WLIN="+(WLIN'NO USING "#ZZZ")
                ENTRY = ENTRY+" WSUB="+WSUB'NO
                ENTRY = ENTRY+" WCTL="+WCTL
                ENTRY = ENTRY+" WTqty="+(WTQTY USING "#ZZ")
                ENTRY = ENTRY+" WPqty="+(WPQTY USING "#ZZ")
                ENTRY = ENTRY+" WK="+WKEY
                ENTRY = ENTRY+" WT="+WTEMP
                ENTRY = ENTRY+" WGT="+(WWGT/100 USING "####.##")
                \LABLOGGER ENTRY """/tmp/oepack.txt"""
        LOOP
!!      IF WWCNT # WCNT THEN
!!          ENTRY = "REAL ORG COUNT="+WCNT
!!          ENTRY = ENTRY+" NOW="+WWCNT+" ++++++++++++++++++++++++++++"
!!          \LABLOGGER ENTRY """/tmp/oepack.txt"""
!!      ENDIF
    ENDIF
RETURN

ENDCIF

SAVE'LOOK'SEE:
    TIME'CSV = "SAVE'LOOK'SEE:" : \TIME'CSV
    LENTRY = "SAVE'LOOK'SEE:"
    \LOG'IT
    IF NEED'CREATE'ARECS = 1 THEN
        CALL CREATE'ARECS
    ENDIF
    IF DO'EXCUSE = 1 THEN
        SAV'ENTRY = ENTRY
        ENTRY = "2: DUMP BOX"
        CALL DO'EXCUSE'LOG
        ENTRY = SAV'ENTRY
    ENDIF
    CALL DUMP'BOX'AND'TOTAL'HDR
RETURN

MAP1 WRK'QTY,B,5
MAP1 WRK'NUM'CS1,B,5
MAP1 RR,F
MAP1 HIGH'WGT,B,5

CALC'WRK'NUM'CS1:
    TIME'CSV = "CALC'WRK'NUM'CS1:" : \TIME'CSV
    LENTRY = "CALC'WRK'NUM'CS1:"
    \LOG'IT
    CALL FIND'MEA
    WRK'NUM'CS1 = 0
    IF MAX'BOX'CS < MAX'BOX'CS1 OR MAX'BOX'CS1  = 0 THEN !!KLUDGE
        RETURN
    ENDIF

    IF CTC = 2 THEN
        HIGH'WGT = INC'MAX'UPS
    ELSE
        HIGH'WGT = INC2'MAX'UPS
    ENDIF

    FOR RR = 1 TO 6
        TMP'WGT = (MEA'WGT(RR) * &
                UOW'DUNITS * UOW2'NUNITS)/((UOW'NUNITS*UOW2'DUNITS) MAX 1)
        TMP'WGT = TMP'WGT * MAX'BOX'CS
        IF TMP'WGT > HIGH'WGT THEN !!AND LIN'TCOM'QTY(RR) >= MAX'BOX'CS1 THEN
            WRK'NUM'CS1 = 0
            RR = 7
        ELSE
            WRK'NUM'CS1 = WRK'NUM'CS1 + INT(LIN'TCOM'QTY(RR)/(MAX'BOX'CS1 MAX 1))
        ENDIF
    NEXT RR

!!WRK'NUM'CS1 has the number of actual cases unstrapped

    IF WRK'NUM'CS1 > 0 THEN
        WRK'NUM'CS1 = INT(WRK'NUM'CS1/(MAX'BOX'CS/MAX'BOX'CS1))*(MAX'BOX'CS/MAX'BOX'CS1)

!!WRK'NUM'CS1 has the number cases to take out in even increments of strapping (MAX'BOX'CS)
!!example:  MAX'BOX'CS1 = 36 MAX'BOX'CS = 72 and total actual cases is 7
!!            7/(72/36) = 7/2 = 3.5 -- integer is 3 then x 2 = 6

    ENDIF
RETURN

!!We are not strapping but SMART'STRAP sets fields we need.  Do not remove!
!!Strapping does not work!!
SMART'STRAP:
    TIME'CSV = "SMART'STRAP:" : \TIME'CSV
    LENTRY = "SMART'STRAP:"
    \LOG'IT

    IF MEA'TREAT'CASE # "Y" RETURN                        !!KLUDGE
!!Case Pack C1 Rule - test order boxable weight against max box weight to determine if C1 rule should be applied
    IF SPECIAL'WGT < (HIGH'WGT*UPS'MAX'BOX) AND MANY'BOXES = "Y" THEN
        RETURN
    ENDIF


    CALL CALC'WRK'NUM'CS1     !!WRK'NUM'CS1 has cases to be take seperately

    IF WRK'NUM'CS1 > 0 THEN   !! AND MAX'NUM'CS1 > 0 THEN
        FOR WW = 1 TO 6
            IF LIN'TCOM'QTY(WW) # 0 THEN
                IF CTC = 2 AND LIN'TEMP = "N" AND MAX'BOX'CS1 > 0 AND WRK'NUM'CS1 > 0 THEN

                    WRK'QTY = (INT(LIN'TCOM'QTY(WW)/MAX'BOX'CS1)) MIN WRK'NUM'CS1
                                                           !!cases this size
                    IF WRK'QTY >= 1 AND WRK'NUM'CS1 > 0 THEN
                        WRK'NUM'CS1 = WRK'NUM'CS1 - WRK'QTY    !!reduce from total
                        WRK'QTY = WRK'QTY*MAX'BOX'CS1  !!back to pieces
!!how many cases
!!Cases expressed in pieces
!!piece count with cases removed
                        LIN'TCOM'QTY(WW) = LIN'TCOM'QTY(WW) - WRK'QTY !!PIECES part
                        LIN2'TCOM'QTY(WW) = LIN2'TCOM'QTY(WW) + WRK'QTY  !!CASE part
                        LIN'TEMP2 = "P"  !!Pieces and cases
                    ENDIF
                ELSE
                    WW = 7
                ENDIF
            ENDIF
        NEXT WW
    ENDIF
RETURN

MAP1 CUR'NUM'CS1,B,5
MAP1 QTY'TO'USE,B,5
MAP1 TMP'WRK,B,5
MAP1 TAKE'NOW,B,5
MAP1 IN'BOX,B,5

!!TMP'WGT = INT((TMP2'WGT+99)/100)*100
    !!Next highest pound weight

MAP1 MAX'NUM'CS1,B,5

COMPLICATED'CASE'PACK:
    TIME'CSV = "COMPLICATED'CASE'PACK:" : \TIME'CSV
    LENTRY = "COMPLICATED'CASE'PACK:"
    \LOG'IT
    BREC'SPACE = SPACE
    UOW2'KNO = VIA'UOW'NO
    CALL FIND'UOW2
    CALL CALC'WRK'NUM'CS1                !!How many cases (already an even number)
    MAX'NUM'CS1 = WRK'NUM'CS1
    TBOX'COUNT = TBOX'COUNT + 1
    BREC'SPACE = SPACE
    IN'BOX = 0
    FOR WW = 1 TO 6
      MORE'TO'TAKE:
        TAKE'NOW = INT(LIN'TCOM'QTY(WW)/MAX'BOX'CS1)     !!how many case
        TAKE'NOW = (MAX'BOX'CS/MAX'BOX'CS1) MIN TAKE'NOW !!Most I can put in one box
        TAKE'NOW = TAKE'NOW MIN MAX'NUM'CS1              !!limited by grand total
        MAX'NUM'CS1 = MAX'NUM'CS1 - TAKE'NOW
        IF TAKE'NOW > 0 THEN
            QTY'TO'USE = TAKE'NOW*MAX'BOX'CS1
            MAP1 PPP,B,5
            PPP = MAX'BOX'CS/MAX'BOX'CS1
            CALL LOGIT
            BNO = TBOX'COUNT
            BTYPE = "B"
            BCASE = "Y"                     !!It is a case (or strapped cases)
            CALL GET'FREEBE                 !!trashes MEA
            CALL FIND'MEA
            TMP2'WGT = (MEA'WGT(WW) * UOW'DUNITS * UOW2'NUNITS)  &
                    /((UOW'NUNITS*UOW2'DUNITS) MAX 1)
            TMP2'WGT = TMP2'WGT * QTY'TO'USE
                !!Weight of one or more cases
            BCWEIGHT = BCWEIGHT + TMP2'WGT

            IF FREEBE = "Y" THEN
                BFWEIGHT = BFWEIGHT + TMP2'WGT                                           !![66]
            ENDIF                                                                           !![66]
            ENTRY = "FREEBE="+FREEBE+" BFWEIGHT="+BFWEIGHT
            CALL LOGIT
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "FREEBE="+FREEBE+" BFWEIGHT="+BFWEIGHT
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            BXL'QTY = QTY'TO'USE
            SUB'NO = WW
!!Adding box records
            CALL ADD'BREC
            CALL ADD'XREC
            IN'BOX = IN'BOX + TAKE'NOW

            MAP1 MY'PART,S,30
            MY'PART = PRH'PART
            \STRIP MY'PART 7

            LIN'TCOM'QTY(WW) = LIN'TCOM'QTY(WW) - QTY'TO'USE

            IF IN'BOX = (MAX'BOX'CS/MAX'BOX'CS1) THEN
                LAST'HEAVY'PKG'BOX'NO = BNO
                TBOX'COUNT = TBOX'COUNT + 1
                IN'BOX = 0
                BREC'SPACE = SPACE
            ENDIF
            IF LIN'TCOM'QTY(WW) > 0 THEN
                GOTO MORE'TO'TAKE
            ENDIF
        ENDIF
    NEXT WW
    TBOX'COUNT = LAST'HEAVY'PKG'BOX'NO !!We added one too many at end
RETURN

!!DEBUGGING SUBROUTINES

MAP1 BKEY7,S,9
MAP1 BCTL7,B,1
MAP1 FROM'DLC,B,1

DUMP'LINKEY'CACHE:            !!DUMP LINKEY CACHE RECORDS
                              !!dump cache dump'cache
    IF |PGODS| THEN
        ENTRY = "**** DUMP'LINKEY'CACHE:"
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        ENTRY = "HDR'NAM'NO="+HDR'NAM'NO+" HDR'NO="+HDR'NO+" CUS'PACK'CASES="+CUS'PACK'CASES+" HDR'VIA'NO="+HDR'VIA'NO+" VIA'PACK'CASES="+VIA'PACK'CASES
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        ENTRY = "C1 oepack.pack_cases.many_boxes="+MANY'BOXES
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        ENTRY = "C2 oepack.pack_cases.customer="+CASES'CUS
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        ENTRY = "C3 oepack.pack_cases.via="+CASES'VIA
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        ENTRY = "C4 oepack.pack_cases.all_cases="+ALL'CASES
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        ENTRY = "S1 oepack.pack_cases.auto_strap="+AUTO'STRAP
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        ENTRY = "S2 oepack.pack_cases.pickup_strap="+DO'STRAP
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        ENTRY = "CTC="+CTC+" START'CTC="+START'CTC+" MANY'BOXES'CASES="+MANY'BOXES'CASES+" MAX'BOX="+MAX'BOX
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        \COPYF LIN OE LIN7 MODE="DTA"
        LIN7'REC = LIN'REC
        TMP'LINKEY = LINKEY
        LINKEY = ""
        DO
            XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
            IF LIN'CTL # 0 EXIT

            FROM'DLC = 1
            CALL DUMP'LINKEY'VALUES
            FROM'DLC = 0

        LOOP
        LIN'REC = LIN7'REC
        LINKEY = TMP'LINKEY
        ENTRY = "**** DUMP'LINKEY'CACHE: END ****"
        \LABLOGGER ENTRY """/tmp/oepack.txt"""
    ENDIF
RETURN

MAP1 WWW,F

DUMP'LINKEY'VALUES:
    IF |PGODS| THEN
        IF FROM'DLC # 1 THEN
            ENTRY = "**** DUMP'LINKEY'VALUES:"
            \LABLOGGER ENTRY """/tmp/oepack.txt"""
        ENDIF

        WRK'QTY = 0
        FOR WWW = 1 TO 6
            WRK'QTY = WRK'QTY + LIN'TCOM'QTY(WWW)
        NEXT WWW

        SLINKEY = LINKEY
        \STRIP SLINKEY 4
        ENTRY = "LINKEY="+SLINKEY+" TEMP="+LIN'TEMP+" TEMP2="+LIN'TEMP2+ &
                " TEMP3="+LIN'TEMP3+" LIN'NO="+(LIN'NO USING "#ZZZ")+ &
                " QTYS="+LIN'TCOM'QTY(1)+"-"+LIN'TCOM'QTY(2)+"-"+ &
                LIN'TCOM'QTY(3)+"-"+LIN'TCOM'QTY(4)+"-"+LIN'TCOM'QTY(5)+ &
                "-"+LIN'TCOM'QTY(6)
        \LABLOGGER ENTRY """/tmp/oepack.txt"""
        LINKEY = SLINKEY
    ENDIF
RETURN

MAP1 BPTR7,X,30
MAP1 SAVBPTR7,X,30

DUMP'BREC'BPTR:
    IF |PGODS| THEN
        ENTRY = "**** DUMP'BREC'BPTR:"
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        TMP'BREC = BREC
        BPTR7 = BPTR
        BCTL7 = BCTL
        BKEY7 = BKEY

        BKEY = ""
        DO
            XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
            IF BCTL # 0 EXIT
            ENTRY ="[BKEY=" + BKEY
            ENTRY = ENTRY + "]"
            ENTRY = ENTRY + " BCTL=" + BCTL
            ENTRY = ENTRY + " BTYPE=" + BTYPE
            ENTRY = ENTRY + " BNO=" + BNO
            ENTRY = ENTRY + " BCWEIGHT=" + BCWEIGHT
            ENTRY = ENTRY + " BCMAX=" + BCMAX
            ENTRY = ENTRY + " BITEMS=" + BITEMS
            ENTRY = ENTRY + " BSHP'LOC'NO" + BSHP'LOC'NO
            ENTRY = ENTRY + " BZONE=" + BZONE
            ENTRY = ENTRY + " BHAZ'MAT=" + BHAZ'MAT
            ENTRY = ENTRY + " BCASE=" + BCASE
            ENTRY = ENTRY + " BVBX'NOE=" + BVBX'NO
            ENTRY = ENTRY + " BSWGT=" + BSWGT
            ENTRY = ENTRY + " BLRGPKG=" + BLRGPKG
            \LABLOGGER ENTRY """/tmp/oepack.txt"""
        LOOP
        ENTRY = "**** DUMP'BREC'BPTR: END ****"
        \LABLOGGER ENTRY """/tmp/oepack.txt"""

        IF SAVBPTR > 0 THEN
            ENTRY = "**** DUMP'BREC'BPTR: Dump savbptr cache"
            \LABLOGGER ENTRY """/tmp/oepack.txt"""

            SAVBPTR7 = SAVBPTR
            BKEY = ""
            DO
                XCALL VICSIT,7,4,BREC,BKEY,SAVBPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                ENTRY ="[BKEY=" + BKEY
                ENTRY = ENTRY + " BCTL=" + BCTL
                ENTRY = ENTRY + "]"
                ENTRY = ENTRY + " BTYPE=" + BTYPE
                ENTRY = ENTRY + " BNO=" + BNO
                ENTRY = ENTRY + " BCWEIGHT=" + BCWEIGHT
                ENTRY = ENTRY + " BCMAX=" + BCMAX
                ENTRY = ENTRY + " BITEMS=" + BITEMS
                ENTRY = ENTRY + " BSHP'LOC'NO=" + BSHP'LOC'NO
                ENTRY = ENTRY + " BZONE=" + BZONE
                ENTRY = ENTRY + " BHAZ'MAT=" + BHAZ'MAT
                ENTRY = ENTRY + " BCASE=" + BCASE
                ENTRY = ENTRY + " BVBX'NOE=" + BVBX'NO
                ENTRY = ENTRY + " BSWGT=" + BSWGT
                ENTRY = ENTRY + " BLRGPKG=" + BLRGPKG
                \LABLOGGER ENTRY """/tmp/oepack.txt"""
            LOOP

            ENTRY = "**** DUMP'BREC'BPTR: Dump savbptr cache END ****"
            \LABLOGGER ENTRY """/tmp/oepack.txt"""
        ENDIF

        BKEY = BKEY7
        BCTL = BCTL7
        BPTR = BPTR7
        SAVBPTR = SAVBPTR7
        BREC = TMP'BREC
    ENDIF
RETURN

!!08/01/2023 below were added fix compile errors after adding FedEx code

!!COPY "BADLAB",PRGNAM="OEPACK",DEBUG="WL'DEBUG" !!PRINT'BAD'LABEL: and PRINT'BAD'LABEL2:
!!Copy "BADLAB" introduced too many errors.  Created PRINT'BAD'LABEL and PRINT'BAD'LABEL2 instead

\COPYF FUC WB
\COPYF RTS UP
COPYF "CMNFIL[SY]",NOAFR
COPYF "CMNFIL[SY]",=CMN2,NOAFR
COPYF "PRTFIL[SY]"
COPYF "PRTKEY[SY]"
COPYF "CMNFIL[SY]",=CMNO,NOAFR

MAP1 CMN'OVR,@CMN'OTHER
    MAP2 CMN'MQID,B,4
    MAP2 CMN'IDX,B,2
    MAP2 CMN'BQUEUE,S,1

MAP1 TCP'IDX,B,1
MAP1 TCP'MQID,B,4
MAP1 OTYPE,S,1
MAP1 TMP2,S,40
MAP1 USPS'TERRITORY,B,1
MAP1 EFNAME,S,128
!!MAP1 BADNUMBER,S,1
MAP1 BG'FLAG,S,1
MAP1 DOING'WLSCAN,B,1
MAP1 LAST'DO'ERR'ENTRY,S,166
!!MAP1 LOG'ENTRY,S,160
MAP1 BAGGER'RCN,F
MAP1 RAWS,S,80
MAP1 MY'NAME,S,128
MAP1 BAGGER'BQUEUE,S,1
MAP1 DASHC,S,4
MAP1 FIRST'ENTRY,S,80
MAP1 LAST'ENTRY,S,80
MAP1 ERCNT,B,1
MAP1 ENTRIES,S
    MAP2 ADDRESS'ENTRY,S,80
    MAP2 USPS'ENTRY,S,80
    MAP2 SHIPPING'ENTRY,S,80
    MAP2 CMPCRL'ENTRY,S,80
    MAP2 NOS'ENTRY,S,80
    MAP2 HAZ'ENTRY,S,80
    MAP2 CC'ENTRY,S,80
    MAP2 RATESHOP'ENTRY,S,80
MAP1 BAGGER'NUMLBL,S,1         !!1=CARRIER, 2=WM2+CARRIER,
MAP1 ERROR'HDR'RCN,B,4
MAP1 DTIME,B,2            !!Delay in seconds for testing
MAP1 ORG'STIME,B,4
MAP1 TMP,S,100
MAP1 X,F

DO'SHIPR2:                !! do i need this code?
RETURN

OEPACK'DO'ERR:
    IF BG'FLAG = "A" GOTO OE1SHP'DO'ERRLO
    GOTO DO'ERR
RETURN

OE1SHP'DO'ERR:
    IF BG'FLAG = "A" GOTO OE1SHP'DO'ERRLO
    GOTO DO'ERR
RETURN

OE1SHP'DO'ERRL:
    IF BG'FLAG = "A" GOTO OE1SHP'DO'ERRLO
    GOTO DO'ERRL
RETURN

OE1SHP'DO'ERR'CMPCRL:
    CMPCRL'ENTRY = ENTRY
    GOTO OE1SHP'DO'ERR
RETURN

OE1SHP'DO'ERR'CMPCRLL:
    CMPCRL'ENTRY = ENTRY
    GOTO OE1SHP'DO'ERRL
RETURN

OE1SHP'DO'ERRLO:
    TIME'CSV = "OE1SHP'DO'ERRLO:" : \TIME'CSV
    LENTRY = "OE1SHP'DO'ERRLO:"
    \LOG'IT
    IF FIRST'ENTRY = "" THEN
        FIRST'ENTRY = ENTRY
    ELSE
        LAST'ENTRY = ENTRY
    ENDIF
    \HDRERR
    CALL SNDMON
    CALL DO'ERRLO
LOG'ENTRY:
    IF EFNAME # "" THEN
        \ABLOGGER ENTRY EFNAME
    ELSE
    IF WL'DEBUG # "" THEN
        \ABLOGGER ENTRY WL'DEBUG
    ENDIF
    ENDIF
RETURN

RESUME'ME:
    TIME'CSV = "RESUME'ME:" : \TIME'CSV
    IF WL'DEBUG # "" THEN
        ENTRY = "Did a resume "+RAWS
        CALL LOG'ENTRY
    ENDIF
    RESUME                        !!sick
RETURN                            !!never gets here (resumed)

PRE'ERTRAP:
    TIME'CSV = "PRE'ERTRAP:" : \TIME'CSV
    IF BG'FLAG = "A" THEN
        IF ERR(0) = 1 AND WL'DEBUG # "" THEN
            ENTRY = "Control-C in ERTRAP"
            CALL LOG'ENTRY
        ENDIF
    ENDIF
    GOTO ERTRAP
!!Never gets here
RETURN
RATESHOP'DO'ERR:
    TIME'CSV = "RATESHOP'DO'ERR: RATE'SHOPPING="+RATE'SHOPPING : \TIME'CSV
    LENTRY = "RATESHOP'DO'ERR: RATE'SHOPPING="+RATE'SHOPPING
    \LOG'IT

    IF RATE'SHOPPING = 0 GOTO OE1SHP'DO'ERR
    IF EFNAME # "" THEN
        IF INSTR(1,ENTRY,STR(HDR'NO)) = 0 THEN
            ENTRY = ENTRY + " HDR="
            \KERROR HDR MODE="D" CNO="N"
        ENDIF
        LAST'DO'ERR'ENTRY = ENTRY
        CALL LOG'ENTRY
    ENDIF
RETURN

FEDEX'USER'ABORT:
    TIME'CSV = "FEDEX'USER'ABORT:" : \TIME'CSV
    LENTRY = "FEDEX'USER'ABORT:"
    \LOG'IT
    IF SHIPPING'ENTRY = "" THEN
        IF SHIPPING'ENTRY = "" THEN
            SHIPPING'ENTRY = ENTRY
        ENDIF
        BADNUMBER = "7"
        CALL PRINT'ERROR'LABEL
    ENDIF
    IF BG'FLAG = "A" THEN
        GOTO CHAIN'ME
    ENDIF
    GOTO USER'ABORT
RETURN

RATESHOP'USER'ABORT:                    !!Get from OE1SHP.BV
    TIME'CSV = "RATE'USER'ABORT: RATE'SHOPPING="+RATE'SHOPPING : \TIME'CSV
    LENTRY = "RATE'USER'ABORT: RATE'SHOPPING="+RATE'SHOPPING
    \LOG'IT
    IF RATE'SHOPPING = 0 THEN
        IF SHIPPING'ENTRY = "" THEN
            SHIPPING'ENTRY = ENTRY
        ENDIF
        BADNUMBER = "7"
        CALL PRINT'ERROR'LABEL
        IF BG'FLAG = "A" THEN
            GOTO CHAIN'ME
        ENDIF
        GOTO USER'ABORT
    ENDIF
    IF EFNAME # "" THEN
        ENTRY = "Failed Endicia next'pp PP="+PP+" HDR="
        \KERROR HDR MODE="D" CNO="N"
        IF RATE'SHOPPING = 1 THEN
            !!Need to look at OE1SHP INVOICE'OUT: and implement PP loop if rate shopping is active
!!          GOTO NEXT'PP
            ENTRY = "RATE SHOPPING NOT IMPLEMENTED P1"
            CALL DO'ERRL
            IF BG'FLAG = "A" THEN
                GOTO CHAIN'ME
            ENDIF
            GOTO USER'ABORT
        ELSE
            IF LAST'DO'ERR'ENTRY # "" THEN
                RTS'ENTRY = LAST'DO'ERR'ENTRY
            ELSE
                RTS'ENTRY = ENTRY
            ENDIF
            WRITE RTS FROM RTS'REC
            ENTRY = "Please set this aside -- Endicia not functioning!"
            SHIPPING'ENTRY = ENTRY
            CALL PRINT'ERROR'LABEL
            CALL LOG'ENTRY
            GOTO USER'ABORT
        ENDIF
    ENDIF
RETURN

PRE'PRINT'ERROR'LABEL:                !!Get from OE1SHP.BV
    TIME'CSV = "PRE'PRINT'ERROR'LABEL:" : \TIME'CSV
    LENTRY = "PRE'PRINT'ERROR'LABEL:"
    \LOG'IT
    HHS'REC = HDR'REC
    \SETKEY HHS MODE="KEY"
PRINT'ERROR'LABEL:
    SENTRY = ENTRY
    ENTRY = "/lbl/bads"+HDR'KNO+".1"
    LOOKUP ENTRY,PP
    IF PP # 0 THEN
        CALL UPDATE'BQR
        IF WL'DEBUG # "" THEN
            ENTRY = "FOUND: "+ENTRY
            CALL LOG'ENTRY
            ENTRY = SENTRY
            CALL LOG'ENTRY
        ENDIF
        ERCNT = ERCNT + 1
        IF ERCNT > 15 THEN
            ENTRY = "Aborting after 15 errors!"
            CALL LOG'ENTRY
            GOTO USER'DIE
        ENDIF
        RETURN                        !!KLUDGE
    ENDIF
    HDR'BREASON = ""
    CASE
    IF BADNUMBER = "t" THEN
        HDR'BREASON = "t"
    ELSE
    IF USPS'ENTRY # "" THEN
        SENTRY = USPS'ENTRY
        HDR'BREASON = "7"
        BADNUMBER = "7"
    ELSE
    IF CC'ENTRY # "" THEN
        SENTRY = "CC: " + CC'ENTRY[1;20]
        CC'ENTRY = ""
        HDR'BREASON = "1"
        BADNUMBER = "1"
    ELSE
    IF CMPCRL'ENTRY # "" THEN
        SENTRY = CMPCRL'ENTRY
        CMPCRL'ENTRY = ""
        IF HDR'HOLD'YN = "Y" THEN
            HDR'BREASON = "5"
            BADNUMBER = "5"
        ELSE
            HDR'BREASON = "2"
            BADNUMBER = "2"
        ENDIF
    ELSE
    IF ADDRESS'ENTRY # "" THEN
        SENTRY = ADDRESS'ENTRY
        ADDRESS'ENTRY = ""
        HDR'BREASON = "3"
        BADNUMBER = "3"
    ELSE
    IF SHIPPING'ENTRY # "" THEN
        SENTRY = SHIPPING'ENTRY
        SHIPPING'ENTRY = ""
        HDR'BREASON = "7"
        BADNUMBER = "7"
    ELSE
    IF NOS'ENTRY # "" THEN
        SENTRY = NOS'ENTRY
        NOS'ENTRY = ""
        HDR'BREASON = "4"
        BADNUMBER = "4"
    ELSE
    IF HAZ'ENTRY # "" THEN
        SENTRY = HAZ'ENTRY
        HAZ'ENTRY = ""
        HDR'BREASON = "6"
        BADNUMBER = "6"
    ELSE
        HDR'BREASON = "o"
    ENDCASE
    IF HDR'RCN # 0 AND HDR'RCN # ERROR'HDR'RCN THEN
        IF (HDR'BAGGER < "1" OR HDR'BAGGER > "9") AND HDR'RCN # 0 THEN
            HDR'BREASON = ""
            ON ERROR GOTO RESUME'ME
            UPDATE HDR FROM HDR'REC
            ON ERROR GOTO PRE'ERTRAP
        ENDIF
        ERROR'HDR'RCN = HDR'RCN
    ENDIF
    ENTRY = SENTRY
    \STRIP ENTRY 3
    IF ENTRY = "" OR LEN(ENTRY) < 10 THEN
        ENTRY = ENTRY + "error unknown or unreadable!"
        SENTRY = ENTRY
    ENDIF
    IF INSTR(1,ENTRY,RAWS) = 0 THEN
        ENTRY = ENTRY + " " + RAWS
    ENDIF
    ENTRY = "BL: "+ENTRY
    CALL OE1SHP'DO'ERRLO
!   IF RAWS  # "" THEN
!       ENTRY = RAWS
!       CALL OE1SHP'DO'ERRLO
!       ENTRY = SENTRY
!   ENDIF
    ENTRY = "For order: "
    \KERROR HHS MODE="D" CNO="N"
    LTMP = ENTRY

    IF BAGGER'BQUEUE < "1" OR BAGGER'BQUEUE > "9" THEN
        IF DOING'WLSCAN = 0 THEN
            IF BG'FLAG # "A" THEN
                IF UB'CNAME = "V.I.C.S., LLC" THEN
                    SCALE'PRT'SEQ = 99
                    GOTO VICS'KLUDGE
                ENDIF
                SCALE'PRT'SEQ = 0
!!from users .profile
                XCALL GETENV,"SCALE_ID",ENTRY
                IF ENTRY = "" THEN
!!Flip_client is ip address of the pc
                    XCALL GETENV,"FLIP_CLIENT",ENTRY
                    LTMP = LTMP + " CL="+ENTRY
                    IF VAL(ENTRY) = 0 THEN
                        X = INSTR(1,ENTRY,".")
                        ENTRY = ENTRY[1,X-1]
                        \PARSE STRING="ENTRY" DEL="-" SCALE'TTY SCALE'PRT'SEQ
                        LTMP = LTMP + " host "+ENTRY
                    ELSE
                        LTMP = LTMP + " IP "+ENTRY
                    ENDIF
                    IF SCALE'PRT'SEQ = 0 THEN
                        \GETPROFILE """/met/sy/metid.ini""" ENTRY TMP
                        IF TMP = "" THEN
                            ENTRY = "Cannot get scale/printer from "+ENTRY
                        ELSE
                            \PARSE STRING="TMP" DEL="-" SCALE'TTY SCALE'PRT'SEQ
                            ENTRY = "tty="+SCALE'TTY+" ptr1 is "+SCALE'PRT'SEQ
                        ENDIF
                    ELSE
                        ENTRY = "tty="+SCALE'TTY+" ptr2 is "+SCALE'PRT'SEQ
                    ENDIF
                ELSE
                    LTMP = LTMP + " env "+ENTRY
                    \PARSE STRING="ENTRY" DEL="-" SCALE'TTY SCALE'PRT'SEQ
                    ENTRY = "tty="+SCALE'TTY+" my printer is "+SCALE'PRT'SEQ
                ENDIF
                LTMP = LTMP + " " + ENTRY
            ELSE
                LTMP = STR(SCALE'PRT'SEQ)
            ENDIF
        ENDIF

        IF SCALE'PRT'SEQ = 0 AND HDR'DOC'TYPE # 2 THEN
            SCALE'PRT'SEQ = VIL'PRT'NO(2)
            ENTRY = "Printer resolved to zero: "+LTMP
            CALL DO'ERRL
            ENTRY = "Set to "+VIL'PRT'NO(2)
            CALL DO'ERRL
        ENDIF
        IF SCALE'PRT'SEQ # 0 THEN
            PRT'KSEQ = SCALE'PRT'SEQ
            USE PRT INTO PRT'REC KEY PRT'KEY
            IF PRT'CTL # 0 THEN
                \DG GETVALUE _OESETUP oe1shp_label_printer ENTRY
                IF DG'CTL = 0 AND ENTRY # "" THEN
                    PRT'KSEQ = VAL(ENTRY)
                    USE PRT INTO PRT'REC KEY PRT'KEY
                    IF PRT'CTL # 0 THEN
                       PRT'DESC = "*** INVALID ***"
                    ENDIF
                ENDIF
            ENDIF
            LTMP = LTMP + "-" + PRT'DESC
            IF PRT'CTL # 0 THEN
                ENTRY = "1: SEVERE ERROR: Printer "+PRT'KSEQ+" not found error label skipped!"
                CALL DO'ERRL
                ENTRY = SENTRY
                CALL DO'ERRL
                GOTO ABORT
            ENDIF
        ELSE
            IF HDR'DOC'TYPE # 2 THEN
                \DG GETVALUE _OESETUP oe1shp_label_printer ENTRY
                IF DG'CTL = 0 AND ENTRY # "" THEN
                    PRT'KSEQ = VAL(ENTRY)
                    USE PRT INTO PRT'REC KEY PRT'KEY
                    IF PRT'CTL # 0 THEN
                        PRT'DESC = "*** INVALID ***"
                    ENDIF
                ELSE
                    ENTRY = "2: SEVERE ERROR: No printer found -- aborting -- error label skipped!"
                    LTMP = LTMP + " " + ENTRY
                    CALL DO'ERRL
                    ENTRY = SENTRY
                    CALL DO'ERRL
                    GOTO ABORT
                ENDIF
            ENDIF
        ENDIF
    ENDIF
  VICS'KLUDGE:
    HHS'REC = HDR'REC
    \SETKEY HHS MODE="KEY"
    IF BADNUMBER = "7" AND SENTRY # "" THEN
        BADREASON = SENTRY
        ENTRY = BADREASON
        CALL PRINT'BAD'LABEL2
    ELSE
        ENTRY = SENTRY
        IF BADNUMBER = "" THEN BADNUMBER = "o"
        CALL PRINT'BAD'LABEL
    ENDIF
    ENTRY = ""
    SENTRY = ""
    ENTRIES = ""
RETURN

USER'DIE:
    TIME'CSV = "USER'DIE:" : \TIME'CSV
    LENTRY = "USER'DIE:"
    \LOG'IT
    CASE
    IF TCP'MQID # 0 THEN
        ENTRY = "DIE DIE DIE"
        \HDRERR
        CALL SNDMON
        IF WL'DEBUG # "" THEN
            CALL LOG'ENTRY
        ENDIF
        END
    ELSE
    IF BG'FLAG = "A" THEN
        GOTO CHAIN'ME
    ELSE
        GOTO USER'ABORT
    ENDCASE
RETURN

CHAIN'ME:
    TIME'CSV = "CHAIN'ME: FROM=BAGGER TO=OE1SHP" : \TIME'CSV
    LENTRY = "CHAIN'ME: FROM=BAGGER TO=OE1SHP"
    \LOG'IT
    CMN'REC = CMNO'REC
    CMN'FRM'PRGNAM = "BAGGER"
    CMN'TO'PRGNAM = "OE1SHP"
    CMN'SAV'RCN(4) = SCALE'PRT'SEQ
    IF WL'DEBUG # "" THEN
        CMN'SAV'RCN(3) = 1
        ENTRY = "Self chaining"
        CALL LOG'ENTRY
    ELSE
        CMN'SAV'RCN(3) = 0
    ENDIF
    CMN'SAV'RCN(2) = ORG'STIME/10000
    CMN'SAV'RCN(1) = DTIME
!   CMN'SAV'RCN(4) = PARENT'PID
    XCALL DB,22,HDR'PKT
    IF TCP'MQID # 0 THEN
        CMN'MQID = TCP'MQID
        CMN'IDX = TCP'IDX
    ENDIF
    CMN'BQUEUE = BAGGER'BQUEUE
    SNDCMN CMN'REC
    CHAIN "OE1SHP"
RETURN

UPDATE'BQR:
    TIME'CSV = "UPDATE'BQR:" : \TIME'CSV
    LENTRY = "UPDATE'BQR:"
    \LOG'IT
    ENTRY = "Update BQR for "
    \KERROR HHS MODE="D" CNO="N"
    ENTRY = ENTRY + " BQUEUE="+HHS'BQUEUE+" BAGGER="+HHS'BAGGER
    CALL LOG'ENTRY
    IF HHS'BQUEUE >= "1" AND HHS'BQUEUE <= "9" THEN
        \COPYF BQR OE
        BQR'DID = "OEBQ"+HHS'BQUEUE
        BQR'KID = BQR'DID
        BQRO'DID = BQR'DID
        BQRO'KID = "OEBQ"+HHS'BQUEUE+"O"
        BQRO'KLOC'NO = HHS'LOC'NO
        BQRO'KDOC'TYPE = HHS'DOC'TYPE
        BQRO'KHDR'NO = HHS'NO
        RDLOCK BQRO INTO BQR'REC KEY BQRO'KEY
        IF BQRO'CTL = 0 THEN
            IF INSTR(1,LNAME,"/lbl/w") # 0 THEN
                BQR'WNAME = LNAME            !!Walmart label saved
            ELSE
                BQR'CNAME = LNAME            !!Carrier label saved
            ENDIF
            IF BAGGER'NUMLBL = "2" THEN
                IF BQR'WNAME = "" AND INSTR(1,LNAME,"/lbl/bad") # 0 THEN
                    BQR'WNAME = BQR'CNAME
                ENDIF
            ENDIF
            WRITE BQRO FROM BQR'REC
            ENTRY = "Wrote "
            \KERROR BQRO MODE="D" CNO="N"
            CALL LOG'ENTRY
        ELSE
            ENTRY = "Failed RDLOCK BQRO: "
            \KERROR BQRO MODE="k" CNO="N"
            CALL LOG'ENTRY
        ENDIF
    ENDIF
RETURN

!!Below is because OE1SHP uses these in .CPY files and we don't need them
MAP1 BADNUMBER,S,1
MAP1 BADREASON,S,1
PRINT'BAD'LABEL:
PRINT'BAD'LABEL2:
RETURN
!!Above is because OE1SHP uses these in .CPY files and we don't need them

MAP1 TTLLIN,B,5
MAP1 TTLCOM,B,5

CHECK'OEPACK:
    TIME'CSV = "CHECK'OEPACK:" : \TIME'CSV
    LENTRY = "CHECK'OEPACK:"
    \LOG'IT
    TTLLIN = 0
    LIN2'KHDR'LOC'NO = HDR'LOC'NO
    LIN2'KDOC'TYPE = HDR'DOC'TYPE
    LIN2'KHDR'NO = HDR'NO
    LIN2'KNO = 0
    USE LIN2 INTO LIN'REC KEY LIN2'KEY
    DO
        GETNXT LIN2 INTO LIN'REC
        \CHKKEY LIN APID="OE" ALTKEY="LIN2" ALTPRE="LIN"
        IF LIN2'CTL # 0 EXIT
        PRH'KTRK'NO = LIN'TRK'NO
        \VUSE PRH
        IF PRH'INVENTORY = "N" THEN
            REPEAT                            !!Not in folders
        ENDIF
        TTLLIN = TTLLIN + LIN'COM'QTY
    LOOP

    TTLCOM = 0
    BXL'SPACE = SPACE
    BXL'DOC'TYPE = HDR'DOC'TYPE
    BXL'HDR'LOC'NO = HDR'LOC'NO
    BXL'HDR'NO = HDR'NO
    BXL'LIN'NO = 0
    BXL'SUB'NO = 0
    BXL'BOX'NO = 0
    BXL'SHIPMENT = HDR'SHIPMENT
    \SETKEY BXL MODE="KEY" APID="OE"
    USE BXL INTO BXL'REC KEY BXL'KEY
    DO
        GETNXT BXL INTO BXL'REC
        IF BXL'CTL # 0 EXIT
        IF BXL'HDR'NO # HDR'NO EXIT
        TTLCOM = TTLCOM + BXL'QTY
    LOOP
RETURN

CALC'SPECIAL'WGT:
    TIME'CSV = "CALC'SPECIAL'WGT:" : \TIME'CSV
    LENTRY = "CALC'SPECIAL'WGT:"
    \LOG'IT

    VIA'KNO = HDR'VIA'NO
    CALL GET'VIA
    IF VIA'CTL # 0 THEN
        TIME'CSV = "CALC'SPECIAL'WGT: Warning - ship via not found: "+VIA'KNO
        \TIME'CSV
        ENTRY = "CALC'SPECIAL'WGT: Warning - ship via not found: "+VIA'KNO
        \LOG'IT
        \LABLOGGER ENTRY """/tmp/oepack.txt"""
        CALL DO'ERR'OEPACK
    ENDIF

    UOW'KNO = VIA'UOW'NO
    CALL FIND'UOW
    UOW2'DUNITS = UOW'DUNITS
    UOW2'NUNITS = UOW'NUNITS

    CALL SET'INC2'MAX'UPS

    LIN'HDR'LOC'NO = HDR'LOC'NO
    LIN'DOC'TYPE = 1
    LIN'HDR'NO = HDR'NO
    LIN'NO = 0
    \SETKEY LIN MODE="KEY"
    USE LIN INTO LIN'REC KEY LIN'KEY
    DO
        GETNXT LIN INTO LIN'REC
        \CHKKEY LIN
        IF LIN'CTL # 0 EXIT
        IF WBWHAP # 1 THEN
            CALL TCOUNT
        ENDIF
        CALL FIND'PRH

        IF PRH'INVENTORY # "N" OR PACK'NON'INV = "Y" THEN
            CALL FIND'MEA     !!Also does FIND'PRH, FIND'UOW

!!All below highly related to CACHE'LIN so if you change

            FOR WW = 1 TO 6
                IF LIN'TCOM'QTY(WW) # 0 THEN
                    CALL FIND'MEA           !!Also does FIND'PRH, FIND'UOW
                    LIN'TEMP = "N"          !!Start with "N" normal items like apparel then determine if item
                                            !!fits another packing category ie Package(D), Heavy(H) or Hazardous(Z)
!!Weight of one
                    TMP2'WGT = (MEA'WGT(WW) * UOW'DUNITS * UOW2'NUNITS)  &
                                        /((UOW'NUNITS*UOW2'DUNITS) MAX 1)

                    TMP'WGT = INT((TMP2'WGT+99)/100)*100

                    IF PKG'CASE'LEN # 0 OR MEA'TREAT'CASE = "D" THEN
                        IS'PKG = 1
                    ELSE
                        IS'PKG = 0
                    ENDIF

                    CASE
                    IF TMP'WGT >= INC2'MAX'UPS THEN
!!Single item is too heavy for packing or packaged
                        LIN'TEMP = "H"
                    ELSE
                    IF IS'PKG = 1 THEN
                        LIN'TEMP = "D"
                    ENDCASE

                    IF LIN'TEMP = "N" THEN            !!NOT a PKG/Heavy item
                        IF PRH'HAZ'NO # 0 THEN
                            LIN'TEMP = "Z"          !!HAZ items
                        ENDIF
                    ENDIF
                    IF LIN'TEMP = "D" OR LIN'TEMP = "H" THEN
!!Single item is too heavy or too big for packing
                        ANY'LAST'STUFF = 1
                    ELSE
                        CALL FIND'MEA   !!I think this trashes UOW to the last line item
                                            !!Don't need this because I changed CC to lbs
                                    !!Dimensional/Heavy skips this (see above)
                        IF PRH'HAZ'NO # 0 THEN
                            LIN'TEMP = "Z"        !!HAZ items
                        ELSE
                            LIN'TEMP = "N"         !!Normal items
                        ENDIF
!!Now has total weight of one size
                        SPECIAL'WGT = SPECIAL'WGT + (TMP2'WGT * LIN'TCOM'QTY(WW))
                    ENDIF
                ENDIF
            NEXT WW
        ENDIF
    LOOP
RETURN

!!*** Delete loop without duplicate packets - Too many variables
DELETE'CMA:
    TIME'CSV = "DELETE'CMA:" : \TIME'CSV
!!CMA file stores the Type 4 Auto-Apply Credits
!!If HDR deleted then release type 4 credit
    CMA'KHDR'LOC'NO = HDR'LOC'NO
    CMA'KDOC'TYPE   = HDR'DOC'TYPE
    CMA'KHDR'NO     = HDR'NO
    CMA'KINVOICE    = 0
    USE CMA INTO CMA'REC KEY CMA'KEY
    DO
        GETNXT CMA INTO CMA'REC KEY CMA'KEY
        IF CMA'CTL # 0 EXIT
        CMA'KEY = CMA'KEY2
        IF CMA'HDR'LOC'NO # HDR'LOC'NO OR CMA'DOC'TYPE # HDR'DOC'TYPE OR &
                    CMA'HDR'NO # HDR'NO THEN
            EXIT
        ELSE
            CMA'KHDR'LOC'NO = CMA'HDR'LOC'NO
            CMA'KDOC'TYPE   = CMA'DOC'TYPE
            CMA'KHDR'NO     = CMA'HDR'NO
            CMA'KINVOICE    = CMA'INVOICE
            RDLOCK CMA INTO CMA'REC KEY CMA'KEY
            IF CMA'CTL = 0 THEN
                DELETE CMA KEY CMA'KEY
                IF CMA'CTL = 0 THEN
                    \SETKEY CMA MODE="KY2"
                    \ADDKEY CMA MODE="KY2"
                ENDIF
            ENDIF
        ENDIF
    LOOP
RETURN

\COPYF MBX OE MBX2   !!For delete

DELETE'OLD'MBX:            !!Delete where SHIPMENT = 1 AND 99
    CALL CHECK'MILL'DIRECT
    IF DELETE'MBX'YN = "N" THEN
        RETURN
    ENDIF

    TIME'CSV = "DELETE'OLD'MBX:" : \TIME'CSV
    MBX2'SPACE = SPACE
    MBX2'HDR'LOC'NO = HDR'LOC'NO
    MBX2'DOC'TYPE = HDR'DOC'TYPE
    MBX2'HDR'NO = HDR'NO
    MBX2'SHIPMENT = 0
    MBX2'BOX'NO = 0
    \SETKEY MBX MODE="KEY" APID="OE" ALTPRE="MBX2" ALTKEY="MBX2"
    USE MBX2 INTO MBX2'REC KEY MBX2'KEY
    DO
        GETNXT MBX2 INTO MBX2'REC KEY MBX2'KEY
        IF MBX2'CTL # 0 EXIT
        IF  MBX2'HDR'LOC'NO # HDR'LOC'NO OR &
            MBX2'DOC'TYPE # HDR'DOC'TYPE OR &
            MBX2'SHIPMENT # 0 OR &
            MBX2'HDR'NO # HDR'NO EXIT
        MBX'REC = MBX2'REC
        \SETKEY MBX MODE="KEY" APID="OE"
        RDLOCK MBX INTO MBX'REC KEY MBX'KEY
        IF MBX'CTL = 0 THEN
            IF MBX'MSGNO # 0 THEN
                DELMSG MBX'MSGNO "OEMSG"
            ENDIF
            DELETE MBX KEY MBX'KEY
            IF MBX'CTL = 0 THEN
                \SETKEY MBX MODE="KY2"
                \DELKEY MBX MODE="KY2"
            ENDIF
        ENDIF
    LOOP
RETURN

MAP1 TMP'LINKEY1,S,40
DUMP'LINKEY'CACHE2:            !!DUMP LINKEY CACHE RECORDS
                              !!dump cache dump'cache
        TIME'CSV   = "DUMP'LINKEY'CACHE2:" : \TIME'CSV
!!  IF |PGODS| THEN
        \COPYF LIN OE LIN7 MODE="DTA"
        LIN7'REC = LIN'REC
        TMP'LINKEY = LINKEY2
        TMP'LINKEY1 = LINKEY
        LINKEY = ""
        DO
            XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
            IF LIN'CTL # 0 EXIT

            FROM'DLC = 1
            CALL DUMP'LINKEY'VALUES2
            FROM'DLC = 0

        LOOP
        LIN'REC = LIN7'REC
        LINKEY2 = TMP'LINKEY
        LINKEY = TMP'LINKEY1

        TIME'CSV = "DUMP'LINKEY'CACHE2: END " : \TIME'CSV
!!  ENDIF
RETURN

DUMP'LINKEY'VALUES2:
!!  IF |PGODS| THEN
        IF FROM'DLC # 1 THEN
            TIME'CSV = "**** DUMP'LINKEY'VALUES:"
            \TIME'CSV
        ENDIF

        WRK'QTY = 0
        FOR WWW = 1 TO 6
            WRK'QTY = WRK'QTY + LIN'TCOM'QTY(WWW)
        NEXT WWW

        SLINKEY = LINKEY2
        \STRIP SLINKEY 4
        TIME'CSV = "LINKEY2="+SLINKEY+" TEMP="+LIN'TEMP+" TEMP2="+LIN'TEMP2+ &
                " TEMP3="+LIN'TEMP3+" LIN'NO="+(LIN'NO USING "#ZZZ")+ &
                " QTYS="+LIN'TCOM'QTY(1)+"-"+LIN'TCOM'QTY(2)+"-"+ &
                LIN'TCOM'QTY(3)+"-"+LIN'TCOM'QTY(4)+"-"+LIN'TCOM'QTY(5)+ &
                "-"+LIN'TCOM'QTY(6)
        \TIME'CSV
        LINKEY2 = SLINKEY
!!  ENDIF
RETURN

CREATE'MBX:    !!Create MBX with weight from cache data

!!Loop cache to get last box.  Needed on next loop
    MALVERN'LAST'BOX = 0
    BKEY = WORK'MODE + (VIA'NO USING "#ZZZ")
    SBKEY = BKEY
    DO
        XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
        IF BCTL # 0 EXIT

        IF BKEY[1;5] # SBKEY EXIT
        IF BNO > MALVERN'LAST'BOX THEN
            MALVERN'LAST'BOX = BNO
        ENDIF
    LOOP

    BKEY = WORK'MODE + (VIA'NO USING "#ZZZ")
    SBKEY = BKEY
    DO
        XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
        IF BCTL # 0 EXIT

        IF BKEY[1;5] # SBKEY EXIT
        CALL FIND'OVER'TRK'NO    !!Returns OVER'TRK'NO(BNO) with value

        MBX'SPACE = SPACE
        MBX'HDR'LOC'NO = HDR'LOC'NO
        MBX'DOC'TYPE = HDR'DOC'TYPE
        MBX'HDR'NO = HDR'NO
        MBX'SHIPMENT = 0
        MBX'BOX'NO = BNO
        \SETKEY MBX MODE="KEY" APID="OE"
        USE MBX INTO MBX'REC KEY MBX'KEY
        IF MBX'CTL # 0 THEN
            MBX'OVR'TRK'NO = OVER'TRK'NO(BNO)
            MBX'ERROR'FLAG = "W"
            MBX'WEIGHT = BCWEIGHT
            MBX'TTL'NONDIS = 0              !Total Non-Discounted Charge
            MBX'TTL'DISAMT = 0              !Total Discounted Charge
            MBX'NAM'NO = HDR'NAM'NO
            ADD MBX FROM MBX'REC KEY MBX'KEY
        ELSE
            RDLOCK MBX INTO MBX'REC KEY MBX'KEY
            IF MBX'CTL = 0 THEN
                MBX'OVR'TRK'NO = OVER'TRK'NO(BNO)
                MBX'ERROR'FLAG = "W"
                MBX'WEIGHT = BCWEIGHT
                MBX'TTL'NONDIS = 0          !Total Non-Discounted Charge
                MBX'TTL'DISAMT = 0          !Total Discounted Charge
                MBX'NAM'NO = HDR'NAM'NO
                WRITE MBX FROM MBX'REC KEY MBX'KEY
            ENDIF
            REL MBX
        ENDIF
    LOOP

MVRX02:
!!      XCALL LINK,1,"mvrx02[oe]",HDR'REC,MALVERN'LAST'BOX
!!
!! Do not call oerx02 if processing a Mill Direct.
!! LOC_PATH is blank when we invoice (second func p)
!!
        XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY
        IF HDR'LOC'NO = 1 OR &            !!NOT Mill direct order
            (HDR'LOC'NO > 1 AND ENTRY # "") THEN
            XCALL LINK,1,"oerx02[oe]",HDR'REC,MALVERN'LAST'BOX
            !!
            !!Get PID from OERX02 for OEPACK to pass on to OrderCreate call in WBXMLC
            GETCMN SND'MY'PID
        ENDIF

!!Validate that we have a rate for every box.  Flag should be blank.

        MBXERROR'COUNT = 0
        MBX'SPACE = SPACE
        MBX'HDR'LOC'NO = HDR'LOC'NO
        MBX'DOC'TYPE = HDR'DOC'TYPE
        MBX'HDR'NO = HDR'NO
        MBX'SHIPMENT = 0    !!for OEPACK, should always be zero
        MBX'BOX'NO = 1
        \SETKEY MBX MODE="KEY" APID="OE"
        USE MBX INTO MBX'REC KEY MBX'KEY
        DO
            GETNXT MBX INTO MBX'REC KEY MBX'KEY
            IF MBX'CTL # 0 EXIT
            IF MBX'HDR'LOC'NO # HDR'LOC'NO OR MBX'DOC'TYPE # HDR'DOC'TYPE OR &
                    MBX'HDR'NO # HDR'NO OR MBX'SHIPMENT # 0 EXIT
!!temp      IF MBX'ERROR'FLAG = "W" OR MBX'TTL'NONDIS = 0 THEN
            IF MBX'TTL'NONDIS = 0 AND VIA'CHG'TYPE # "TPB" THEN !!TPB = 3rd-Party Billing
                MBXERROR'COUNT = MBXERROR'COUNT + 1
            ENDIF
        LOOP
        IF MBXERROR'COUNT > 0 THEN
            ENTRY = "Error: Some boxes with no rate - aborting"
            CALL DO'ERR'OEPACK
            GOTO FINISH'UP2
            GOTO DEAD'ABORT    !!KLUDGE - may not need this but other call had
        ENDIF
RETURN

FIND'OVER'TRK'NO:
    TIME'CSV = "FIND'OVER'TRK'NO:" : \TIME'CSV
    IF INC'AUTOPACK = "Y" OR HDR'ACTION = "P" OR HDR'ACTION ="L"  THEN
        IF INC'AUTOPACK = "Y" THEN
            XKEY = (BNO USING "#ZZZ")
            XCALL VICSIT,7,4,XREC,XKEY,XPTR,0,XCTL !!GETNXT
            IF XCTL # 0 OR XNO # BNO THEN
                ENTRY = "Nothing in XREC box in SET'DIM'OS BNO="+BNO
                GOTO DO'ERR     !!KLUDGE
            ENDIF
            LIN'KHDR'LOC'NO = HDR'LOC'NO
            LIN'KHDR'NO = HDR'NO
            CALL SET'LINKEY
            IF LIN'CACHED = 2 THEN
                LIN'NO = XLIN'NO
                ENTRY = LINKEY+" look for "+LIN'NO+" in SET'DIM'OS"
                CALL FIND'LIN'REC
            ELSE
                LINKEY = LINKEY + (XLIN'NO USING "#ZZZ")
                XCALL VICSIT,7,3,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!USE
            ENDIF
            IF LIN'CTL # 0 THEN
                ENTRY = "Could not find line in SET'DIM'OS!"
                GOTO DO'ERR         !!KLUDGE
            ENDIF
            CALL FIND'PRH
            PKG'SPACE = SPACE
            IF LIN'TEMP # "N" THEN
                IF PRH'TRK'NO # LIN'TRK'NO OR &
                            PRH'PRC'TRK'NO = 0 OR PRH'WGTS'BY # "Y" THEN
                    MEA'KTRK'NO = LIN'TRK'NO
                ELSE
                    MEA'KTRK'NO = PRH'PRC'TRK'NO
                ENDIF
                MEA'KUOM'NO = LIN'UOM'NO
                \VUSE MEA
                IF MEA'CTL = 0 THEN
                    PKG'KTRK'NO = MEA'TRK'NO
                    \VUSE PKG
                ENDIF
            ENDIF
            BLENGTH = PKG'CASE'LEN
            BWIDTH = PKG'CASE'WID
            BHEIGHT = PKG'CASE'HEI

            IF BLENGTH > 0 THEN
                OVER'TRK'NO(BNO) = PKG'TRK'NO
            ENDIF
        ENDIF
    ENDIF
RETURN

MAP1 CR'AMT'USED,B,5
MAP1 DR'AMT'USED,B,5
MAP1 SKIP'ADD'CMA,S,1

ADD'UPDATE'CMA'RECORD:
    TIME'CSV = "ADD'UPDATE'CMA'RECORD:" : \TIME'CSV
    SKIP'ADD'CMA = "Y"
    FOR FFF = 1 TO 10
        IF SAVE'DOC'INVOICE(FFF) > 0 AND SAVE'DOC'AMT(FFF) # 0 THEN
            SKIP'ADD'CMA = "N"
            FFF = 10
        ENDIF
    NEXT FFF

    IF SKIP'ADD'CMA = "Y" RETURN

    CR'AMT'USED = 0
    DR'AMT'USED = 0
    FOR FFF = 1 TO 10
        IF SAVE'DOC'AMT(FFF) # 0 THEN
            CMA'KHDR'LOC'NO = HDR'LOC'NO
            CMA'KDOC'TYPE = HDR'DOC'TYPE
            CMA'KHDR'NO = HDR'NO
            CMA'KINVOICE = SAVE'DOC'INVOICE(FFF)
            RDLOCK CMA INTO CMA'REC KEY CMA'KEY
            IF CMA'CTL # 0 THEN
                CMA'HDR'LOC'NO = HDR'LOC'NO           !OE Location
                CMA'DOC'TYPE = HDR'DOC'TYPE           !OE Doc Type
                CMA'HDR'NO = HDR'NO                   !OE Order Number
                !!DOC fields below are from Type 4 Credit
                CMA'INV'TYPE = SAVE'DOC'INV'TYPE(FFF) !Invoice Type
                CMA'INVOICE = SAVE'DOC'INVOICE(FFF)   !Invoice #
                CMA'TYPE = SAVE'DOC'TYPE(FFF)         !Batch Type (1,2)
                CMA'BATCH = SAVE'DOC'BATCH(FFF)       !Batch Number
                CMA'TRN = SAVE'DOC'TRN(FFF)           !Transaction Number
                CMA'YEAR = SAVE'DOC'YEAR(FFF)         !year
                CMA'CUS'NO = HDR'NAM'NO               !Customer Number
                CMA'ORG'CR'AMT = ABS(SAVE'ORG'AMT(FFF))  !Original T4CM or T5DM Amt

                !! TEST FOR AUTO-APPLIED TYPES LIKE T4CM AND T5DM
                CASE
                IF CMA'INV'TYPE = 4 THEN
                    IF (SAVE'DOC'AMT(FFF) + CR'AMT'USED) > HDR'OLD'CR
                        SAVE'DOC'AMT(FFF) = HDR'OLD'CR - CR'AMT'USED
                    ENDIF
                ELSE
                IF CMA'INV'TYPE = 5 THEN
                    IF (SAVE'DOC'AMT(FFF) + DR'AMT'USED) > HDR'OLD'DR
                        SAVE'DOC'AMT(FFF) = HDR'OLD'DR - DR'AMT'USED
                    ENDIF
                ENDCASE
                CMA'AMT = SAVE'DOC'AMT(FFF)           !Amount
                CMA'CRID = UB'UID                  !Create User ID
                CMA'CRDT = DATE                    !Creation Date
                CMA'CRTIME = TIME                  !Creation time
                ADD CMA FROM CMA'REC KEY CMA'KEY
                IF CMA'CTL = 0 THEN
                    !! TEST FOR AUTO-APPLIED TYPES LIKE T4CM AND T5DM
                    CASE
                    IF CMA'INV'TYPE = 4 THEN
                        CR'AMT'USED = CR'AMT'USED + SAVE'DOC'AMT(FFF)
                    ELSE
                    IF CMA'INV'TYPE = 5 THEN
                        DR'AMT'USED = DR'AMT'USED + SAVE'DOC'AMT(FFF)
                    ENDCASE

                    TIME'CSV = "ADD'UPDATE'CMA'RECORD: ADD CMA was successful"
                    \TIME'CSV
                    IF CMA'INV'TYPE > 0 AND CMA'INVOICE > 0 THEN
                        \SETKEY CMAI MODE="KEY"
                        \ADDKEY CMAI MODE="KEY"
                    ELSE
                        XCALL GIN,"Unapplied credit/debit invoice is zero.  Very strange."
                    ENDIF
                ENDIF
            ELSE
                CMA'HDR'LOC'NO = HDR'LOC'NO               !OE Location
                CMA'DOC'TYPE = HDR'DOC'TYPE               !OE Doc Type
                CMA'HDR'NO = HDR'NO                       !OE Order Number

                !!DOC fields below are from Type 4 Credit or Type 5 Debit
                CMA'INV'TYPE = SAVE'DOC'INV'TYPE(FFF)     !Invoice Type
                CMA'INVOICE = SAVE'DOC'INVOICE(FFF)       !Invoice #
                CMA'TYPE = SAVE'DOC'TYPE(FFF)             !Batch Type (1,2)
                CMA'BATCH = SAVE'DOC'BATCH(FFF)           !Batch Number
                CMA'TRN = SAVE'DOC'TRN(FFF)               !Transaction Number
                CMA'YEAR = SAVE'DOC'YEAR(FFF)             !year
                CMA'CUS'NO = HDR'NAM'NO                   !Customer Number
                CMA'ORG'CR'AMT = ABS(SAVE'ORG'AMT(FFF))   !Original Type 4 Credit(T4CM) or Type 5 Debit(T5DM) Amt

                !! TEST FOR AUTO-APPLIED TYPES LIKE T4CM AND T5DM
                CASE
                IF CMA'INV'TYPE = 4 THEN                       !!T4CM
                    IF (SAVE'DOC'AMT(FFF) + CR'AMT'USED) > HDR'OLD'CR
                        SAVE'DOC'AMT(FFF) = HDR'OLD'CR - CR'AMT'USED
                    ENDIF
                ELSE
                IF CMA'INV'TYPE = 5 THEN                       !!T5DM
                    IF (SAVE'DOC'AMT(FFF) + DR'AMT'USED) > HDR'OLD'DR
                        SAVE'DOC'AMT(FFF) = HDR'OLD'DR - DR'AMT'USED
                    ENDIF
                ENDCASE

                CMA'AMT = SAVE'DOC'AMT(FFF)                !Amount
                CMA'CRID = UB'UID                          !Create User ID
                CMA'CRDT = DATE                            !Creation Date
                CMA'CRTIME = TIME                          !Creation time

                WRITE CMA FROM CMA'REC KEY CMA'KEY
                IF CMA'CTL = 0 THEN
                    !! TEST FOR AUTO-APPLIED TYPES LIKE T4CM AND T5DM
                    CASE
                    IF CMA'INV'TYPE = 4 THEN                       !!T4CM
                        CR'AMT'USED = CR'AMT'USED + SAVE'DOC'AMT(FFF)
                    ELSE
                    IF CMA'INV'TYPE = 5 THEN                       !!T5DM
                        DR'AMT'USED = DR'AMT'USED + SAVE'DOC'AMT(FFF)
                    ENDCASE

                    TIME'CSV = "ADD'UPDATE'CMA'RECORD: WRITE CMA was successful - amt="+CMA'AMT
                    \TIME'CSV
                ELSE
                    TIME'CSV = "ADD'UPDATE'CMA'RECORD: WRITE CMA was NOT successful"
                    \TIME'CSV
                ENDIF
                REL CMA
            ENDIF
        NEXT FFF
    ENDIF
RETURN

MAP1 CR'DR'USED,S,1
MAP1 TOTAL'CMA,B,5

DOES'CMA'EXIST:
    TIME'CSV = "DOES'CMA'EXIST: BALANCE="+BALANCE  : \TIME'CSV
    CR'DR'USED = "N"
    TOTAL'CMA = 0
    CMAI'KINV'TYPE = DOC'INV'TYPE
    CMAI'KINVOICE = DOC'INVOICE
    CMAI'KHDR'NO = 0
    USE CMAI INTO CMA'REC KEY CMAI'KEY
    DO
        GETNXT CMAI INTO CMA'REC
        IF CMAI'CTL # 0 EXIT
        IF CMA'INV'TYPE # DOC'INV'TYPE OR CMA'INVOICE # DOC'INVOICE EXIT
        IF CMA'HDR'NO # HDR'NO THEN    !!Excude current order?
            TOTAL'CMA = TOTAL'CMA + ABS(CMA'AMT)
        ENDIF
    LOOP

    IF TOTAL'CMA >= ABS(DOC'AMT) THEN    !!Total CMA >= Total Type 4 CR amt
        CR'DR'USED = "Y"                !!entire credit amount has been used
    ELSE                                 !!Remember: CMA has un-invoiced orders
        IF ABS(BALANCE) > (ABS(DOC'AMT) - TOTAL'CMA) THEN
            IF DOC'INV'TYPE = 4 THEN
                BALANCE = (ABS(DOC'AMT) - TOTAL'CMA) * -1
            ELSE
                IF DOC'INV'TYPE = 5 THEN
                    BALANCE = ABS(DOC'AMT) - TOTAL'CMA
                ENDIF
            ENDIF
        ENDIF
    ENDIF
    TIME'CSV = "DOES'CMA'EXIST: TOTAL'CMA="+TOTAL'CMA+" BAL="+BALANCE+" USED="+CR'DR'USED
    \TIME'CSV
RETURN

LOG'AUTH:
        XCALL GETENV,"OERCTL_AUTH_LOG",AUTH'FILLER    !!Save a variable
        IF AUTH'FILLER = "Y" THEN
            XCALL GETENV,"AUTH_LOG",AUTH'FILLER    !!Save a variable
        ENDIF
        IF AUTH'FILLER # "" THEN
            IF LEN(ENTRY) > 75 THEN
                \LABLOGGER ENTRY AUTH'FILLER
                ZZZ = INSTR(1,ENTRY,")")
                ENTRY = ENTRY[1,ZZZ+1]
            ENDIF
            ENTRY = ENTRY + LEFT(ATQ'SEQ+SPACE(11),11)
            ENTRY = ENTRY + LEFT(ATQ'CARDNO[-4,-1]+SPACE(5),5)
            IF ATQ'MAGIC > 0 THEN
                ENTRY = ENTRY + "MagicOnRec "
            ELSE
                ENTRY = ENTRY + "MagicUnKno "
            ENDIF
            ENTRY = ENTRY + LEFT(ATQ'RESPONSE+SPACE(5),5)
            ENTRY = ENTRY + LEFT(ATQ'APPROVAL+SPACE(5),5)
            \KERROR ATQT APID="CV" MODE="D"
            ENTRY = ENTRY + "->"
            \KERROR ATQ APID="CV" MODE="D"
            \LABLOGGER ENTRY AUTH'FILLER
        ENDIF
RETURN

MAP1 DELETE'MBX'YN,S,1

CHECK'MILL'DIRECT:
!!Do not delete MBX records for Mill Direct orders on second func P, during invoicing
    XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY
    IF HDR'LOC'NO = 1 OR &            !!NOT Mill direct order
            (HDR'LOC'NO > 1 AND ENTRY # "") THEN
        DELETE'MBX'YN = "Y"
    ELSE
        DELETE'MBX'YN = "N"
    ENDIF
RETURN

MAP1 FLAT'DISC'AMT,B,5    !!Flat by Weight/Sales and Discount Percent(s)
MAP1 DISC'AMT,B,5
MAP1 LAST'VTB'RATE,B,5
MAP1 LAST'VTB'PERC,B,3

!!TBL'BOX'ORDER  !O:Order, B:Box - currently using B:Box only
!!TBL'WEIGHT'AMT !G:Flat by Weight, S:Flat by Sales, D:Percent Down, U:Percent Up

FLAT'RATE'TEST:
    FLAT'DISC'AMT = 0
    DISC'AMT = 0

    CALL FIND'TBL
    IF TBL'CTL # 0 THEN
        ENTRY = "Cannot find table "+STR(VIA'TBL'NO(II))+" for "+STR(II)+" on via "+VIA'NO
        \LABLOGGER ENTRY WL'DEBUG
        ENTRY = "This Via is not availalbe for current shipping address"
        \LABLOGGER ENTRY WL'DEBUG
        RETURN
    ENDIF

    IF TBL'VTB'TYPE # "Z" OR TBL'BOX'ORDER # "B" THEN    !!Z:Zip/Zone
        RETURN
    ELSE
        IF TBL'WEIGHT'AMT = "S" OR TBL'WEIGHT'AMT = "E" OR &  !!by Sales Amount
                                TBL'WEIGHT'AMT = "V" THEN
            CALL FLAT'BY'SALES
        ELSE
            IF TBL'WEIGHT'AMT = "G" OR TBL'WEIGHT'AMT = "D" OR & !!by Weight
                                TBL'WEIGHT'AMT = "U" THEN
                CALL FLAT'BY'WEIGHT
            ELSE
            ENDIF
        ENDIF
    ENDIF
RETURN

FLAT'BY'SALES:
    VTB'KTBL'NO = TBL'NO
    VTB'KLOC'NO = 0
    VTB'KZONE = ZONE(II)
    VTB'KWEIGHT'AMT = 0
    USE VTB INTO VTB'REC KEY VTB'KEY
    DO
        GETNXT VTB INTO VTB'REC KEY VTB'KEY
        IF VTB'CTL # 0 EXIT
        IF VTB'TBL'NO # TBL'NO OR VTB'ZONE # ZONE(II) OR VTB'LOC'NO # 0 THEN
            EXIT
        ENDIF
        IF VTB'WEIGHT'AMT <= HDR'SHP'TOTAL THEN    !!test Sales Amount
            LAST'VTB'RATE = VTB'RATE
            LAST'VTB'PERC = VTB'PERC
        ENDIF

    LOOP
    IF TBL'WEIGHT'AMT = "S" THEN
        FLAT'DISC'AMT = LAST'VTB'RATE
    ELSE
        IF TBL'WEIGHT'AMT = "E" OR TBL'WEIGHT'AMT = "V" THEN
            IF LAST'VTB'PERC > 0 THEN
                IF TBL'WEIGHT'AMT = "E" THEN
                    DISC'AMT = (MBX'TTL'NONDIS * LAST'VTB'PERC)/10000
                    FLAT'DISC'AMT = MBX'TTL'NONDIS - DISC'AMT
                ELSE
                    IF TBL'WEIGHT'AMT = "V" THEN
                        DISC'AMT = (MBX'TTL'DISAMT * LAST'VTB'PERC)/10000
                        FLAT'DISC'AMT = MBX'TTL'DISAMT + DISC'AMT
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDIF
RETURN

FLAT'BY'WEIGHT:
    VTB'KTBL'NO = TBL'NO
    VTB'KLOC'NO = 0
    VTB'KZONE = ZONE(II)
    VTB'KWEIGHT'AMT = 0
    USE VTB INTO VTB'REC KEY VTB'KEY
    DO
        GETNXT VTB INTO VTB'REC KEY VTB'KEY
        IF VTB'CTL # 0 EXIT
        IF VTB'TBL'NO # TBL'NO OR VTB'ZONE # ZONE(II) OR &
                                VTB'LOC'NO # 0 EXIT

        IF VTB'WEIGHT'AMT <= HDR'WEIGHT THEN    !!test total order weight
            LAST'VTB'RATE = VTB'RATE
            LAST'VTB'PERC = VTB'PERC
        ENDIF
    LOOP
    IF LAST'VTB'RATE > 0 OR LAST'VTB'PERC > 0 THEN
        IF TBL'WEIGHT'AMT = "G" THEN
            FLAT'DISC'AMT = LAST'VTB'RATE
        ELSE
            IF TBL'WEIGHT'AMT = "D" OR TBL'WEIGHT'AMT = "U" THEN
                IF LAST'VTB'PERC > 0 THEN
                    IF TBL'WEIGHT'AMT = "D" THEN
                        DISC'AMT = (MBX'TTL'NONDIS * LAST'VTB'PERC)/10000
                        FLAT'DISC'AMT = MBX'TTL'NONDIS - DISC'AMT
                    ELSE
                        IF TBL'WEIGHT'AMT = "U" THEN    !!currently not used
                            DISC'AMT = (MBX'TTL'DISAMT * LAST'VTB'PERC)/10000
                            FLAT'DISC'AMT = MBX'TTL'DISAMT + DISC'AMT
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDIF
RETURN
