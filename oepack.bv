!!***********************************************************************
!!For developers:  You can use LOG'IT to add things that are specific
!!                 to whatever you are testing. Once you are done, remove
!!                 your logs from LOG'IT, or next person can remove them
!!                 TIME'CSV will have all labels, like BPP
!!***********************************************************************

DEFINE LOG'IT
    IF O''STOP'LOGIT'YN #  "Y" THEN    !! N means record log'it
        IF |PGODS| OR PGODS'FLAG = "Y" THEN
            IF LOGIT'NAME = "" THEN
                LOGIT'NAME = "/tmp/oepack_logit.NXTC"
                XCALL ABUTIL,46,LOGIT'NAME,LOGIT'NAME
            ENDIF
            \LABLOGGER LENTRY LOGIT'NAME
            LENTRY = ""
        ENDIF
    ENDIF
ENDMACRO

MAP1 TIME'IN'SEC,S,10
MAP1 TIME'CSV'NAME,S,50
MAP1 TIME'CSV,S,200
MAP1 DL,S,1,","
MAP1 QT,S,1,CHR(34)

DEFINE TIME'CSV
    IF O''STOP'LOGIT'YN #  "Y" THEN    !! N means record log'it
        IF |PGODS| OR PGODS'FLAG = "Y" THEN
            IF TIME'CSV'NAME = "" THEN
                TIME'CSV'NAME = "/tmp/oepack_csv.NXTC"
                OPEN #89999,TIME'CSV'NAME,OUTPUT
                GETCMN TIME'CSV'NAME
                CLOSE #89999
            ENDIF
            OPEN #89999,TIME'CSV'NAME,APPEND
            \S'TO'DTT'HMS
            TIME'IN'SEC = (HRS USING "#Z")+":"+(MNS USING "#Z")+":"+(SEC USING "#Z")
            TIME'CSV = QT + TIME'IN'SEC + QT + DL + QT + TIME'CSV + QT
            PRINT #89999,TIME'CSV
            TIME'CSV = ""
            CLOSE #89999
        ENDIF
    ENDIF
ENDMACRO

DEFINE GETPROFILEM
    XCALL ABUTIL,41,|0,|1,|2
ENDMACRO

MAP1 TMP'PERC,F

DEFINE VIADISC
        CIF NOT 2 THEN
            SYMBOL 2="ZONE'DISC'PERC(QQ)"
        ENDCIF
        IF HDR'FREE'FRT = "A" OR HDR'FREE'FRT = "T" OR &
                     HDR'FREE'FRT = "W" THEN
            |1 = |0                 !![20] - don't use percent
        ELSE
            IF HDR'FREE'FRT = "P" OR HDR'FREE'FRT = "O" THEN
                TMP'PERC = |2/10000 * HDR'ZONE'PERC/100
            ELSE
                TMP'PERC = |2/10000
            ENDIF
            \FROUND |0*TMP'PERC |1
        ENDIF
ENDMACRO

