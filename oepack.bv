MAP1 JJ,F
MAP1 DD,F
MAP1 PP,F
MAP1 QQ,F
MAP1 WW,F
MAP1 XX,F
!!MAP1 ZZ,F
MAP1 YY,F
MAP1 UU,F
MAP1 SUB'II,F
MAP1 FIRST'ROW,B,1
MAP1 FIRST'XLN,B,1

MAP1 PSEUDO'REC
        MAP2 PSEUDO'VTTL(7),B,5

MAP1 SHIP'MODE,S,15
MAP1 WE'HAVE'BRECS,B,1
MAP1 WE'HAVE'ARECS,B,1
MAP1 WE'ARE'PACKING,B,1
MAP1 MUST'WRITE'BRECS,B,1

MAP1 BREC2,X,86

MAP1 BCTL,B,1
MAP1 XCTL,B,1
MAP1 WCTL,B,1

MAP1 BREC
   MAP2 BREC'SPACE,S
                        !!1=PACKING
        MAP3    BTYPE,S,1                       !Customer/actual/????
        MAP3    BCONSTANT
                MAP4    BNO,B,2                         !Box Number
                MAP4    BCWEIGHT,B,5                    !Computed Weight
                MAP4    BFWEIGHT,B,5                    !![66] Computed Weight (Free Freight Items)
                MAP4    BCMAX,B,5                       !Maximum Weight (weighted average)
                MAP4    BCD(6),B,5                      !Charge/Discount totals
                MAP4    BSHP'TOTAL,B,5                  !Shippable Total
                MAP4    BSHP'DISC,B,5                   !Shippable Discount
                MAP4    BSHP'STX1,B,5                   !Sales Tax
                MAP4    BSHP'STX2,B,5                   !Extra Tax (Excise, Etc)
                MAP4    BOLD'CASH,B,5                   !Old Cash Applied
                MAP4    BOLD'DR,B,5                     !Old Debits Applied
                MAP4    BOLD'CR,B,5                     !Old Credits Applied
                MAP4    BLENGTH,B,1                     !Length
                MAP4    BWIDTH,B,1                      !Width
                MAP4    BHEIGHT,B,1                     !Height


        MAP3    BVARIABLE
                MAP4    BITEMS,B,5                      !Number Of Items
                MAP4    BSHP'VTTL(7),B,5                !Ship Via Totals
                MAP4    BSHP'LOC'NO,B,2                 !Ship From Location
                MAP4    BZONE,S,4                       !Zone
                MAP4    BVALUE'YN,S,1                   !Special Declared Value?
                MAP4    BOVERSIZ1,S,1                   !Oversize Box?
                MAP4    BOVERSIZ2,S,1                   !Oversize Box?
                MAP4    BOVERSIZ3,S,1                   !Oversize Box?
                MAP4    BADDCHG,S,1                     !Additional Charge?
                MAP4    BDIMENSION,S,1                  !Dimensional Weight?
                MAP4    BVIA'SUM(2),B,5                 !Ship via summary
                MAP4    BHAZ'MAT,S,1                    !Hazardous Material?
                MAP4    BCASE,S,1                       !Is it a case?
                MAP4    BMAXDIM,B,2                     !Max dim/OS wgt
                MAP4    BVBX'NO,B,1                     !Variable box number
                MAP4    BSWGT,B,1                       !Special weight
                MAP4    BCHARGES,B,1                    !Box charges bits
                MAP4    BRECTANGLE,S,1                  !Rectangle flag
                MAP4    BLRGPKG,S,1                     !Large package

MAP1 SAVBREC
   MAP2 SAVBREC'SPACE,S
                        !!1=PACKING
        MAP3    SAVBTYPE,S,1                    !Customer/actual/????
        MAP3    SAVBCONSTANT
                MAP4    SAVBNO,B,2                      !Box Number
                MAP4    SAVBCWEIGHT,B,5                 !Computed Weight
                MAP4    SAVBFWEIGHT,B,5                 !![66] Computed Weight (Free Freight Items)
                MAP4    SAVBCMAX,B,5                    !Maximum Weight (weighted average)
                MAP4    SAVBCD(6),B,5                   !Charge/Discount totals
                MAP4    SAVBSHP'TOTAL,B,5               !Shippable Total
                MAP4    SAVBSHP'DISC,B,5                !Shippable Discount
                MAP4    SAVBSHP'STX1,B,5                !Sales Tax
                MAP4    SAVBSHP'STX2,B,5                !Extra Tax (Excise, Etc)
                MAP4    SAVBOLD'CASH,B,5                !Old Cash Applied
                MAP4    SAVBOLD'DR,B,5                  !Old Debits Applied
                MAP4    SAVBOLD'CR,B,5                  !Old Credits Applied
                MAP4    SAVLENGTH,B,1                   !Length
                MAP4    SAVWIDTH,B,1                    !Width
                MAP4    SAVHEIGHT,B,1                   !Height
        MAP3    SAVBVARIABLE
                MAP4    SAVBITEMS,B,5                   !Number Of Items
                MAP4    SAVBSHP'VTTL(7),B,5             !Ship Via Totals
                MAP4    SAVBSHP'LOC'NO,B,2              !Ship From Location
                MAP4    SAVBZONE,S,4                    !Zone
                MAP4    SAVBVALUE'YN,S,1                !Special Declared Value?
                MAP4    SAVBOVERSIZ1,S,1                !Oversize Box?
                MAP4    SAVBOVERSIZ2,S,1                !Oversize Box?
                MAP4    SAVBOVERSIZ3,S,1                !Oversize Box?
                MAP4    SAVBADDCHG,S,1                  !Additional Charge?
                MAP4    SAVBDIMENSION,S,1               !Dimensional Weight?
                MAP4    SAVBVIA'SUM(2),B,5              !Ship via summary
                MAP4    SAVBHAZ'MAT,S,1                 !Hazardous Material?
                MAP4    SAVBCASE,S,1                    !Is it a case?
                MAP4    SAVBMAXDIM,B,2                  !Max dim/OS wgt
                MAP4    SAVBVBX'NO,B,1                  !Variable box number
                MAP4    SAVBSWGT,B,1                    !Special weight
                MAP4    SAVBCHARGES,B,1                 !Box charges bits
                MAP4    SAVBRECTANGLE,S,1               !Rectangle flag
                MAP4    SAVBLRGPKG,S,1                  !Large package

MAP1 TMP'REC,X,512,@BREC
MAP1 TMP'BREC,X,512

MAP1 XREC
   MAP2 XREC'SPACE,S
                                !!1=PACKING
        MAP3    XTYPE,S,1                       !Customer/actual/????
        MAP3    XNO,B,2                         !Box Number
        MAP3    XLIN'NO,B,2                     !Line number
        MAP3    XSUB'NO,B,1                     !SUB Line number
        MAP3    XQTY,B,5                        !Quantity here
        MAP3    XSHP'TOTAL,B,5                  !Dollar value

MAP1 WREC
   MAP2 WREC'SPACE,S
        MAP3    WLIN'NO,B,2                     !Line number
        MAP3    WSUB'NO,B,1                     !SUB Line number (size)
        MAP3    WTQTY,B,5                       !Total qty for size
        MAP3    WPQTY,B,5                       !packed for size
        MAP3    WWGT,B,5                        !Weight of one
        MAP3    WLIN'PRICE,B,5                  !Price-disc on line
        MAP3    WFREEBE,S,1                     !Free freight?
        MAP3    WTEMP,S,1                       !Type of item for packing
        MAP3    WTEMP2,S,1                      !Type of item for case packing

MAP1 LOCAL'FTIME,B,1,1
MAP1 COMING'FROM'GKD,B,1
MAP1 LINKED,B,1
MAP1 DO'FREE'FRT,B,1
COPYF "WRHFIL"
COPYF "CMNFIL[SY]",NOAFR
MAP1 SPWASTR,S,8                                !Special security
                                                !1=change "bill ship via"
                                                !2=change "freight changes"
!!E.G. can change free freight question
                                                !3=change "cheap freight"
!!Above means if 'Y' user can select other than cheapest freight.
                                                !4=change "by order frt"
                                                !5=change "chg/disc"
                                                !6=change tax
                                                !7=change restock

GOTO BEGIN

MAP1 LINPTR,X,30
MAP1 LINPTR2,X,30
MAP1 XPTR,X,30
MAP1 WPTR,X,30
MAP1 BPTR,X,30
MAP1 SAVBPTR,X,30
MAP1 SAVXPTR,X,30
MAP1 SAVWPTR,X,30

MAP1 DBG'LEVEL,B,1            !!Use setup specific debug areas

MAP1 O''STOP'LOGIT'YN,S,1

!! Malvern Transaction Errors (MTE)
MAP1 SND'MY'PID,B,4           !! Process ID for MTE Records

BEGIN:
PRG'OEPACK:      !!Label to Identify the program in BPP files

LDUSR
ON ERROR GOTO OEPACK'ERTRAP

GETCMN CMN'REC

TIME'CSV = "BEGIN:" : \TIME'CSV

IF CMN'TO'PRGNAM[1;5] # "OEPAC" THEN
    \HDRLNK 2

    TIME'CSV = "BEGIN1: HDR'NO="+HDR'NO+" TO'PRGNAM="+CMN'TO'PRGNAM+ &
             " FRM'PRGNAM="+CMN'FRM'PRGNAM
    \TIME'CSV

    LENTRY = "BEGIN1: HDR'NO="+HDR'NO+" TO'PRGNAM="+CMN'TO'PRGNAM+ &
             " FRM'PRGNAM="+CMN'FRM'PRGNAM
    \LOG'IT

    VIA'KNO = HDR'VIA'NO
    CALL GET'VIA

    IF CMN'TO'PRGNAM[1;2] # "OE" THEN
        GETCMN PTR'PASS
        IF PTR'YES = "YYY" THEN
                ENTRY = "/tmp/oepack.pass."+STR(V''JOBNUM)
                LOOKUP ENTRY,QFACTOR
            IF ABS(QFACTOR) < 50 THEN
                PASSED'PRH'ARRAY = SPACE(LEN(PASSED'PRH'ARRAY))
            ELSE
                OPEN #1717,ENTRY,RANDOM,512,II
                PFACTOR = (INT(LEN(PASSED'PRH'ARRAY)/512)*512)+512
                II = 0
                FOR QFACTOR = 1 TO PFACTOR STEP 512
                    READ #1717,TMP'REC
                    PASSED'PRH'ARRAY[QFACTOR;512] = TMP'REC
                    II = II + 1
                NEXT QFACTOR
                CLOSE #1717
            ENDIF
            HDR'REC = V''UNUSED(1)
        ELSE
            IF PTR'YES = "NNN" THEN
                HDR'REC = V''UNUSED(1)
            ELSE
                PTR'SPACE = SPACE
            ENDIF

        ENDIF
    ELSE
        IF CMN'FRM'PRGNAM # "OERCTL" THEN
            LINKED = 1
        ENDIF
    ENDIF
ELSE
    MAP1 WBWHAP,B,1
    IF CMN'FRM'PRGNAM = "WBWHAP" OR CMN'FRM'PRGNAM = "WBPOST" OR &
                                        CMN'FRM'PRGNAM = "WB1XML" THEN
        WBWHAP = 1
    ENDIF
    IF CMN'SAV'RCN(1) = 0 THEN
        ENTRY = "Order RCN not set!"
        CALL DO'ERR'OEPACK
        GOTO DEAD'ABORT
    ENDIF
    USE HDR CMN'SAV'RCN(1) INTO HDR'REC
    IF HDR'CTL # 0 THEN
        ENTRY = "Order RCN invalid!"
        CALL DO'ERR'OEPACK
        GOTO DEAD'ABORT
    ENDIF
    TIME'CSV = "BEGIN2: HDR'NO="+HDR'NO+" TO'PRGNAM="+CMN'TO'PRGNAM+ &
               " FRM'PRGNAM="+CMN'FRM'PRGNAM
    \TIME'CSV
    LENTRY = "BEGIN2: HDR'NO="+HDR'NO+" TO'PRGNAM="+CMN'TO'PRGNAM+ &
             " FRM'PRGNAM="+CMN'FRM'PRGNAM
    \LOG'IT
ENDIF
CALL FIRST'READCTL
IF WBWHAP = 1 THEN
        PWASTR = "YYYYYYYY"
        SPWASTR = "YYNYYYYY"
ELSE
        \DOPASS PRGNAM="OEPASS" DO'ERR="N"
        SPWASTR = PWASTR
        \DOPASS PRGNAM="OEPACK"
ENDIF

MAP1 PGODS'FLAG,S,1    !!Malvern

    \DG GETVALUE _OESETUP pgods_flag PGODS'FLAG    !!Malvern
    IF DG'CTL # 0 THEN
        PGODS'FLAG = "N"
    ENDIF
    TIME'CSV = "PGODS'FLAG="+PGODS'FLAG : \TIME'CSV
!! Use to control Logit for PGODS  the oepack_logit file is getting to big
    XCALL GETENV,"STOP_LOGIT",ENTRY
    O''STOP'LOGIT'YN = UCS(ENTRY)

IF CMN'TO'PRGNAM = "OE1SH1" OR CMN'TO'PRGNAM = "OEPAC1" OR &
                                    CMN'TO'PRGNAM = "OEPAC2" THEN
    MAP1 TOTALS'ONLY,S,1

    IF CMN'TO'PRGNAM = "OEPAC2" THEN
        TOTALS'ONLY = "Y"
    ELSE
        TOTALS'ONLY = "N"
    ENDIF

    CMN'TO'PRGNAM = "OEPACK"
    HDR'RCN = CMN'SAV'RCN(1)
    CALL RDLOCK'HDR
    IF HDR'CTL # 0 THEN
        IF WBWHAP # 0 THEN
            ENTRY = "Bad WBWHAP call on rcn "+HDR'RCN+"!"
        ELSE
            ENTRY = "Bad CMN return from Multi OERCTL"
        ENDIF
        CALL DO'ERR'OEPACKL
        GOTO CMNRTN
    ENDIF
    IF WBWHAP # 0 THEN
        ENTRY = ""
        \HDRERR
        PRINT TAB(-1,0);"Processing"+ENTRY
    ENDIF
    GOTO SKIP'BEGIN'SHIP
ENDIF
IF CMN'TO'PRGNAM # "OEPACK" THEN
!!
    BEGIN'SHIP:
        TIME'CSV = "BEGIN'SHIP: CMN'TO'PRGNAM="+CMN'TO'PRGNAM+" ACTION="+ACTION
        \TIME'CSV
        LENTRY = "BEGIN'SHIP: CMN'TO'PRGNAM="+CMN'TO'PRGNAM+" ACTION="+ACTION
        \LOG'IT

        MAP1 LOCAL'SHIP,B,1
        XLN = 0
        IF CMN'FRM'PRGNAM = "OE1HDR" AND CMN'SAV'RCN(1) # 0 THEN
            USE HDR CMN'SAV'RCN(1) INTO HDR'REC
!!why was it reading into CMN'REC???  worked but ....
            WRH'LOC'NO = HDR'LOC'NO
            WRH'DOC'TYPE = HDR'DOC'TYPE
            WRH'HDR'NO = HDR'NO
        ENDIF
        IF ACTION # "E" THEN
            SP = "Ship"
            ACTION = "P"
        ENDIF
        IF INC'AUTOPACK = "Y" OR ACTION = "E" THEN
            DSP OEPACK
            DDB OEPACK
        ELSE
!!NOTE:  WBWHAP can be normal (0), background running (1), > 1 for special
!!       processing in BG after normal (errors etc).
!!       So testing # 1 is not the same as # 0 (etc) so careful
            IF LOCAL'FTIME # 0 AND WBWHAP # 1 THEN
                LOCAL'FTIME = 0
                DSP PACK03
                SHIP'MODE = "Invoicing"
                CALL DSP'SHIP'MODE
            ELSE
                \CLRWIN 3 4 22 77
            ENDIF
        ENDIF
        LOCAL'SHIP = 1
        DO
            IF INC'AUTOPACK = "Y" OR ACTION = "E" THEN
                GDB OEPACK
            ELSE
                WGT'SPACE = SPACE
                IF HDR'LOC'NO = 0 THEN
                    HDR'LOC'NO = UB'LOC
                ENDIF
                IF HDR'DOC'TYPE = 0 THEN
                    HDR'DOC'TYPE = 1
                ENDIF
                HDR'NO = 0
                MAXFLD = 1
                CALL PRETEND'GKD'PACK03
                XCALL OUT,"/HL(" + "2" +","+"38"+","+ "78"+")/"
                ECFLD = 2
                GKD PACK03
                IF INX1 = I'ESC THEN
                    INX2 = FN'A
                    INX1 = I'FUN
                ENDIF
                COMING'FROM'GKD = 1
            ENDIF
            IF INX2 = FN'10 THEN INX2 = FN'A
                CALL OEPACK'TST'FUNC
                IF TST'FUNC = 0 THEN
                    HDR'SPACE = SPACE
                    HDR'KLOC'NO = WRH'LOC'NO
                    HDR'KDOC'TYPE = WRH'DOC'TYPE
                    HDR'KNO = WRH'HDR'NO
                    READ HDR INTO HDR'REC KEY HDR'KEY
                    CASE
                    IF HDR'CTL # 0 THEN
                        IF HDR'CTL # 4 THEN
                            ENTRY = "Order not found!"
                        ELSE
                            ENTRY = "Order not available!"
                        ENDIF
                        CALL DO'ERR
                    ELSE
                    IF INC'AUTOPACK # "Y" AND HDR'PICK'NEED # "N" AND &
                                                        ACTION # "E" THEN
                        ENTRY = "Cannot invoice w/o printing picking ticket!"
                        CALL DO'ERR
                        REL HDR
                        HDR'CTL = 1
                    ELSE
                    IF HDR'PQU'STAT = "Q" THEN
                        \CHKPQU PRGNAM="OERCTL" SF'TEST="CHKPQU2"
                        IF SF = 1 THEN HDR'PQU'STAT = ""
                        IF HDR'PQU'STAT = "Q" THEN
                            ENTRY = "Order on QUEUE - cannot ship!"+"-"+HDR'MULTI+"|"
                            \KERROR HDR MODE="D" CNO="N"
                            CALL DO'ERRL
                            REL HDR
                            HDR'CTL = 4
                        ENDIF
                    ELSE
                        IF LST'NO # HDR'NAM'NO THEN
                            CALL USE'LST'BILL
                        ENDIF
                        CALL DSP'COMPANY
                    ENDCASE
                    IF INC'AUTOPACK = "Y" OR ACTION = "E" THEN
                        ENTRY = "Not supposed to be here!"
                        CALL DO'ERR
                    ELSE
                        CALL SET'SHIP'MODE
                        CALL DSP'SHIP'MODE
                    ENDIF
            ENDIF
        LOOP UNTIL TST'FUNC # 0 OR HDR'CTL = 0
        IF TST'FUNC # 0 THEN
                ?TAB(23,79) ; TAB(-1,A'NORM) ;
                CALL ANYEXT
                IF LOCAL'SHIP = 1 THEN
                        CMN'SPACE = SPACE
                        LOCAL'SHIP = 0
                ENDIF
                GOTO CMNRTN
        ENDIF
        CMN'SPACE = SPACE
        CMN'FRM'PRGNAM = "OEPACK"               !!CAREFUL, MIGHT NEED OE1SHP
        CMN'SAV'RCN(1) = HDR'RCN
   SKIP'BEGIN'SHIP:
        TIME'CSV = "SKIP'BEGIN'SHIP:" : \TIME'CSV
        LENTRY = "SKIP'BEGIN'SHIP:" : \LOG'IT
        HDR'ACTION = ACTION
        HDR'PQU'STAT = "Q"
ELSE
        IF LINKED # 1 THEN
                HDR'RCN = CMN'SAV'RCN(1)
                CALL RDLOCK'HDR
        ENDIF
        ACTION = HDR'ACTION
ENDIF
!!
!!
!!
MAP1 ORDER'REPICK,B,2                   !![28]
ORDER'REPICK = HDR'MAN'FLAG             !![28]
\CNV'DTT DATE TODAY
CALL DO'BITS
!!
!!
IF HDR'CTL # 0 THEN
    ENTRY = "Cannot read Header record"
    CALL DO'ERR'OEPACK
    GOTO CMNRTN2
ENDIF

CALL DELETE'OLD'MBX

IF HDR'DOC'TYPE = OEC'INT'CR THEN
    ENTRY = "How did you find OEPACK on an internal credit!?"
    CALL DO'ERR'OEPACK
    GOTO CMNRTN2
ENDIF
IF OEC'SKIP'FUT = "Y" THEN
    DTT = HDR'PROM'DTT
    CALL CNV'DTT
    IF YDAYS > TODAY THEN
        \STRDTT DDATE="ENTRY" DTT="HDR'PROM'DTT"
        ENTRY = "Promise date cannot ship until "+ENTRY
        \L24CHR CLR="Y"
        INX1 = I'FUN        !!wanted this go back to order
        INX2 = FN'W         !!not wasting energy until we know what they want
        GOTO ABORT          !!meanwhile just goes back to OE
    ENDIF
ENDIF

MAP1 SAV'ACTION,S,1
                            !!We have the order, load line items, etc.
IF LIN'CACHED # 0 THEN
    CALL FINAL'CLEANUP
ENDIF
CALL SET'INC2'MAX'UPS       !!We needed the proper MAX'UPS weight here
CALL CACHE'LIN              !!Loads order into cache, sorted as we want it.
CALL UPDATE'HDR
CALL SPECIAL'READCTL

SAV'ACTION = HDR'ACTION
IF HDR'PQU'STAT # "Q" OR HDR'ACTION = SPACE THEN
        ENTRY = "BAD STAT on HDR|"+HDR'PQU'STAT+"|"+HDR'ACTION+"|"
        \KERROR HDR
        CALL DO'ERR'OEPACKL
        GOTO DEAD'ABORT
ENDIF
CALL SET'LST'RECORDS

SHIP'MULTI'LOC:         !!Used when processing multiple orders split from one
        TIME'CSV = "SHIP'MULTI'LOC: HDR'LOC'NO="+HDR'LOC'NO : \TIME'CSV
        LENTRY = "SHIP'MULTI'LOC: HDR'LOC'NO="+HDR'LOC'NO : \LOG'IT

        CALL CLEAR'BOX'CACHES
        CALL CLEAR'SAVED'CACHES
        CALL CLEAR'VARIOUS'FLAGS
        LOC'KNO = HDR'LOC'NO
        CALL FIND'LOC
        CHG'VIA = 0

CIF USE'VAT AND USE'VAT = "Y" THEN
        IF USE'VAT = "Y" THEN
            VIA'CUS'NO = 0
            VIA'KNO = HDR'VIA'NO
            CALL FIND'VIA
            AVIA'REC = VIA'REC
!!          IF AVIA'RES'VIA'NO # 0 THEN
!!              CALL SET'LST'RECORDS
!!          ENDIF
            IF HDR'BVIA'NO = 0 THEN
                IF VIA'CVIA'NO # 0 THEN
                    HDR'BVIA'NO = VIA'CVIA'NO
                ELSE
                    HDR'BVIA'NO = HDR'VIA'NO
                ENDIF
            ENDIF
            VIA'CUS'NO = 0
            VIA'KNO = HDR'BVIA'NO
            CALL FIND'VIA
            BVIA'REC = VIA'REC
            VIA'REC = AVIA'REC              !!LEAVE ON ACTUAL
        ENDIF
ENDCIF

START'OVER:             !!Used when changing from picking to invoicing ...
    TIME'CSV = "START'OVER:" : \TIME'CSV
    LENTRY = "START'OVER:" : \LOG'IT

CALL SET'SHIP'MODE

IF INC'AUTOPACK = "Y" OR HDR'ACTION = "E" OR HDR'ACTION = "L" THEN
        CALL SETUP'BILLING              !!Makes BZONE'REC, sets flags
ENDIF
IF INC'AUTOPACK = "Y" OR HDR'ACTION = "P" THEN
        CALL SETUP'ACTUAL               !!Makes AZONE'REC, sets flags
ENDIF

MAP1 DO'ALTVIA,B,1

!!STEP: 1) Pack boxes if either AUTOPACK="Y" or edit list mode
! SIROCCO
WGT'SPACE = SPACE
IF INC'AUTOPACK = "Y" OR HDR'ACTION = "E" OR HDR'ACTION = "L" OR &
            WBWHAP = 1 THEN
                                                !!packing going to happen
                                                !!so set some defaults
        LENTRY = "**********"
        \LOG'IT
STEP1:
        TIME'CSV = "STEP1:" : \TIME'CSV
        TIME'CSV = "STEP1: Pack boxes AUTOPACK="+INC'AUTOPACK+" ACTION="+HDR'ACTION
        \TIME'CSV

        LENTRY = "STEP1: Pack boxes AUTOPACK="+INC'AUTOPACK+" ACTION="+HDR'ACTION
        \LOG'IT
        LENTRY = "**********"
        \LOG'IT

        WE'ARE'PACKING = 1
        \CLRBIT HDR'MAN'FLAG 64 VAR="SF"        !!throw out weight on disk
        MAX'CASH = HDR'SAV'OCASH

        CALL GET'MAX'DR'CR
        IF MAX'CR = 0 AND MAX'DR = 0 THEN
            IS'MAX'CR'DR'ZERO = "Y"     !!Set to "Y" to not add CMA records
        ELSE
            IS'MAX'CR'DR'ZERO = "N"
        ENDIF

        IF DO'CASH = 1 THEN HDR'OLD'CASH = MAX'CASH
        IF DO'CR = 1 THEN HDR'OLD'CR = MAX'CR
        IF DO'DR = 1 THEN HDR'OLD'DR = MAX'DR

        CALL SET'FREE'FRT                       !!default free freight flag
        CALL SET'BILLING'MODE

        IF OEC'FREE'FRT # "N" THEN
                HDR'CD(1) = 0                   !!no free freight yet
        ENDIF
        CALL COMPUTE'FREIGHT'BY'ORDER           !!including order charges

        LOC'KNO = HDR'LOC'NO
        CALL FIND'LOC
    START'OVER'SAME'MODE:
        TIME'CSV = "START'OVER'SAME'MODE:" : \TIME'CSV
        LENTRY = "START'OVER'SAME'MODE:" : \LOG'IT

        IF WBWHAP = 0 AND CHG'VIA # 2 THEN
                CALL PRE'PACK01                         !!reverses signs, etc.
                DSP PACK01
           RE'DDB'GDB'PACK01:
                CALL PACK01'AFR
                DDB PACK01
                CALL PRE'DSP'FFP'DESC2
                CALL DSP'MAX'CASH
                CALL DSP'MAX'DR
                CALL DSP'MAX'CR
                CALL POST'PACK01                        !!corrects signs
                CHG'AMT = 0
                CALL PRE'PACK01                         !!reverse again (goto re'gdb)
                CALL DSP'BITS
                MAP1 SAVE'HDR'OLD'CR,B,5                !!Old CR Applied
                SAVE'HDR'OLD'CR = HDR'OLD'CR
                GDB PACK01                              !!now ask the user for amounts
                IF DELETE'CMA'FLAG = "Y" THEN
                    CALL DELETE'CMA
                ENDIF
                CALL POST'PACK01                        !!correct signs
                CALL DSP'BITS
                MAP1 CHG'AMT,B,1
                CALL OEPACK'TST'FUNC
        ELSE
            EDT = "" : TST'FUNC = 0 : CHG'AMT = 0
            INX1 = I'FUN : INX2 = FN'P
        ENDIF
        IF TST'FUNC = 0 AND WBWHAP = 0 THEN
!!              CALL UPDATE'HDR
                IF INX2 = FN'C THEN
                        DO'ALTVIA = 2
                ELSE
                IF OEC'AUTO'CMP = "Y" AND CHG'VIA # 2 THEN
                        DO'ALTVIA = 1
                ELSE
                        DO'ALTVIA = 0
                ENDIF
                ENDIF
                IF OC2'RSN'YN = "Y" AND CHG'AMT = 1 THEN
                                !!changed an amount, control rec says ask why
                        INX1 = I'FUN
                        INX2 = FN'I
                ENDIF
MAP1 DE'RCN,B,4
                IF INX2 = FN'I THEN
                        IF DE'RCN = HDR'RCN THEN
                                INX1 = I'RT
                                INX2 = 0
                        ELSE
                                DE'RCN = HDR'RCN
                        ENDIF
                ENDIF
                IF INX2 = FN'8 OR INX2 = FN'I THEN
                        CHG'AMT = INX2
                        \WINDOW FULL="Y" SCREEN="PACK" ACTION="WINMES2"
                        IF CHG'AMT = FN'I THEN ECFLD = 254
                        IF HDR'MSGNO2 # ZZZ'MSGNO2 THEN
                                CALL UPDATE'HDR         !!Because of MSGNO
                        ENDIF
                        IF CHG'AMT = FN'I THEN
                                INX1 = I'RT
                                INX2 = 0
                        ELSE
                                CHG'AMT = 0
                                GOTO RE'DDB'GDB'PACK01
                        ENDIF
                        CHG'AMT = 0
                ENDIF
        ENDIF
        IF WBWHAP = 0 THEN
            IF INX2 = FN'W GOTO ABORT                       !!goto header
            IF TST'FUNC = 1 OR INX2 = FN'B THEN             !!abort ...
                ?TAB(23,79) ; TAB(-1,A'NORM) ;
                ENTRY = "[ESC] or F10 to abort, [RETURN] to continue"
                \L24CHR CLR="Y"
                IF INX2 = FN'10 OR INX1 = I'ESC GOTO ABORT
                HDR'REC = ZZZ'REC
                GOTO RE'DDB'GDB'PACK01
            ENDIF
        ELSE
            IF INC'AUTOPACK # "Y" THEN
                CALL SET'FAKE'BOX
                MUST'WRITE'BRECS = 1
                CALL SHOULD'WE'SAVE'BOXES
            ENDIF
        ENDIF
        IF BVIA'SHP'FLAG > 1 THEN
            CALL PACK'HDR                                   !!Sets actual mode
            IF INC'AUTOPACK = "Y" THEN
                CALL CREATE'ARECS
            ENDIF
        ENDIF
ELSE                    !!AUTOPACK = "N" AND ACTION = "P"
!!STEP: 1) or just get weights
        LENTRY = "**********"
        \LOG'IT
STEP1B:
        TIME'CSV = "STEP1b: Get Weights AUTOPACK="+INC'AUTOPACK+" ACTION="+HDR'ACTION
        \TIME'CSV
        LENTRY = "STEP1b: Get Weights AUTOPACK="+INC'AUTOPACK+" ACTION="+HDR'ACTION
        \LOG'IT
        LENTRY = "**********"
        \LOG'IT

        WE'ARE'PACKING = 0
        IF COMING'FROM'GKD = 0 THEN
            IF WBWHAP # 1 THEN
                DSP PACK03
            ENDIF
            CALL PRETEND'GKD'PACK03                 !!Fills GKD fields
        ELSE
            COMING'FROM'GKD = 0
        ENDIF
        ORG'WEIGHT = HDR'WEIGHT                         !!Save values
        ORG'COUNT = HDR'BOX'COUNT
        ECFLD = 0
        IF AVIA'SHP'FLAG > 1 THEN                       !!Shipping by box
                \TSTBIT HDR'MAN'FLAG 64 VAR="SF"
                IF SF = 1 THEN                  !!Actual BOX on disk
                        CALL LOAD'WGT'REC'FROM'BOX'RECS
                        IF WGT'WGT(1) # 0 AND WBWHAP # 1 THEN
                                DDB PACK03
                                ECFLD = 254
                        ELSE
                                ECFLD = 0
                        ENDIF
                ELSE
                        WGT'SPACE = SPACE
                ENDIF
        ENDIF
START'OVER'PACK03:
        TIME'CSV = "START'OVER'PACK03:" : \TIME'CSV
        LENTRY = "START'OVER'PACK03:" : \LOG'IT

        COPYF "WGTFIL",=WGT2,NOAFR
        IF AVIA'SHP'FLAG > 1 THEN               !!Shipping by box
            PAGENO = 1
            INX2 = 0
            arrowc = arrowc OR |EX'EDD|
            DO
                WGT2'REC = WGT'REC
                IF PAGENO = 2 THEN
                    FOR KK = 1 TO 160
                        WGT'WGT(KK) = WGT2'WGT(KK+160)
                        WGT'OVERSIZ1(KK) = WGT2'OVERSIZ1(KK+160)
                        WGT'OVERSIZ2(KK) = WGT2'OVERSIZ2(KK+160)
                        WGT'OVERSIZ3(KK) = WGT2'OVERSIZ3(KK+160)
                        WGT'ADDCHG(KK) = WGT2'ADDCHG(KK+160)
                        WGT'DIMENSION(KK) = WGT2'DIMENSION(KK+160)
                        WGT'HAZ'MAT(KK) = WGT2'HAZ'MAT(KK+160)
                    NEXT KK
                ENDIF
                IF INX2 = FN'I THEN
                    \CLRWIN 3 4 22 77
                    DDB PACK03
                    ECFLD = JJ
                ENDIF
                GDB PACK03
                IF INX2 = FN'10 THEN INX2 = FN'6
                IF PAGENO = 2 THEN
                    FOR KK = 1 TO 160
                        WGT2'WGT(KK+160) = WGT'WGT(KK)
                        WGT2'OVERSIZ1(KK+160) = WGT'OVERSIZ1(KK)
                        WGT2'OVERSIZ2(KK+160) = WGT'OVERSIZ2(KK)
                        WGT2'OVERSIZ3(KK+160) = WGT'OVERSIZ3(KK)
                        WGT2'ADDCHG(KK+160) = WGT'ADDCHG(KK)
                        WGT2'DIMENSION(KK+160) = WGT'DIMENSION(KK)
                        WGT2'HAZ'MAT(KK+160) = WGT'HAZ'MAT(KK)
                    NEXT KK
                    WGT'REC = WGT2'REC
                ENDIF
                IF INX2 = FN'I THEN
                    REPEAT
                ENDIF
                                !!left arrow OR home OR ctrl-r
                IF lastchb = 8 OR lastchb = 30 OR lastchb = 18 THEN
                    INX1 = I'FUN
                    INX2 = FN'6
                ENDIF
                                !!right arrow OR end OR ctrl-t
                IF lastchb = 12 OR lastchb = 5 OR lastchb = 20 THEN
                    INX1 = I'FUN
                    INX2 = FN'1
                ENDIF
                IF PAGENO = 1 THEN
                    IF (INX2 = FN'1 OR INX1 = I'RT OR INX1 = I'TAB) AND &
                                                    WGT'WGT(160) # 0 THEN
                        PAGENO = 2
                        INX2 = FN'I
                        IF WGT'WGT(161) # 0 THEN
                            JJ = 254
                        ELSE
                            JJ = 0
                        ENDIF
                        MAXFLD = 161
                        KK = 320
                        DO WHILE WGT'WGT(KK) = 0
                            MAXFLD = MAXFLD - 1
                            IF MAXFLD = 1 EXIT
                            KK = KK - 1
                        LOOP
                        REPEAT
                    ENDIF
                ELSE
                    IF INX2 = FN'6 THEN
                        MAXFLD = 161
                        PAGENO = 1
                        INX2 = FN'I
                        JJ = 254
                        REPEAT
                    ENDIF
                ENDIF
                IF INX2 # FN'6 AND INX2 # FN'1 EXIT
                ECFLD = 254
            LOOP
            NEED'CREATE'ARECS = 1
            CALL OEPACK'TST'FUNC2

            IF TST'FUNC # 0 THEN
                CALL SHOULD'WE'SAVE'BOXES
                GOTO ABORT
            ENDIF
            IF OC2'WPERC # 0 CALL CHECK'WEIGHTS
        ELSE                                    !!Shipping by order (no boxes)
            CALL SNUFF'BOXES
        ENDIF
        CALL TOTAL'WGT
                                        !!Put shipping screen up
MAP1 PACK04'SAVE,X,1210
        MAP1 PACK04'UP,B,1
        IF WBWHAP # 1 THEN
            PACK04'UP = 1
            \WINDOW REPAINT="N" RESTORE="N" ACTION="DO'PACK04" &
                AUTOSIZE="PACK04" SCREEN="PACK03" SAVSCR="PACK04'SAVE"
        ENDIF
        CALL CREATE'ARECS               !!Now 'B' records loaded, because if
                                        !!they were not, we loaded from box.
ENDIF

FN'7'QUEUED = 0
FN'B'QUEUED = 0
FN'L'QUEUED = 0

!!STEP: 2) calculate billing freight if needed (see below conditions)
IF INC'AUTOPACK = "Y" OR HDR'ACTION = "E" OR HDR'ACTION = "L" OR &
                                        PSEUDO'CASH'TERMS = "N" THEN
        LENTRY = "**********"
        \LOG'IT
STEP2:
        TIME'CSV = "STEP2: AUTOPACK="+INC'AUTOPACK+" ACTION="+HDR'ACTION
        \TIME'CSV

        LENTRY = "STEP2: AUTOPACK="+INC'AUTOPACK+" ACTION="+HDR'ACTION
        \LOG'IT
        LENTRY = "**********"
        \LOG'IT
                !!We need to compute billing freight if:
                !!1) autopacking  2) picking phase 3) net customer invoicing
        IF WE'ARE'PACKING = 0 THEN
             CALL SET'SHIP'LST'RECORD        !!For state ...
             CALL CREATE'BRECS'FROM'ACTUAL
        ENDIF
        CALL SET'BILLING'MODE
        CALL ALLOCATE'CONSTANTS         !!Order charges, etc.
        IF WE'ARE'PACKING  = 1 THEN
                MAP1 ADDR1(5),S,40
                MAP1 DWGT,B,5
                MAP1 SFREE,S,33
                DWGT = INT((HDR'WEIGHT + 99)/100)       !!Round it up to next whole
                \GETTAB TABLE="OEPCK1" KEY="HDR'FREE'FRT" DESC="SFREE"
                ENTRY = "DWGT="+DWGT+" HDR FREE="+HDR'FREE'FRT
                CALL LOGIT
                IF HDR'FREE'FRT = "Z" OR HDR'FREE'FRT = "X" OR &
                   HDR'FREE'FRT = "P" OR HDR'FREE'FRT = "O" THEN
                        SFREE = SFREE + " " + STR(HDR'ZONE'PERC)
                ENDIF
                IF HDR'FREE'FRT = "P" OR HDR'FREE'FRT = "O" THEN
                        SFREE = SFREE + "%"
                ENDIF
                MAP1 DELIVERY,S,28
                CASE
                IF AVIA'MAN'YN = "A" OR AVIA'MAN'YN = "L" OR &
                                AVIA'MAN'YN = "1" OR AVIA'MAN'YN = "X" THEN
                    ZON'DAYS = 1
                ELSE
                IF AVIA'MAN'YN = "S" OR AVIA'MAN'YN = "E" OR &
                                AVIA'MAN'YN = "2" OR AVIA'MAN'YN = "Y" THEN
                    ZON'DAYS = 2
                ELSE
                IF AVIA'MAN'YN = "R" OR &
                                AVIA'MAN'YN = "3" OR AVIA'MAN'YN = "Z" THEN
                    ZON'DAYS = 3
                ELSE
                    ZON'KTBL'NO = AVIA'TBL'NO(1)
                    ZON'KLOC'NO = HDR'LOC'NO
                    IF HDR'SHP'COU = "CA" THEN
                        CALL CA'ZONE
                    ELSE
                        IF HDR'SHP'COU = "US" OR HDR'SHP'COU = "USA" OR &
                                HDR'SHP'COU = "PR" OR HDR'SHP'COU = "VI" THEN
                            ZON'KSTART'ZIP = HDR'SHP'ZIP
                            USE ZON INTO ZON'REC KEY ZON'KEY
                            IF ZON'CTL # 0 THEN
                                GETPRV ZON INTO ZON'REC
                            ENDIF
                            \CHKKEY ZON APID="IN"
                            IF HDR'SHP'ZIP > ZON'END'ZIP THEN ZON'CTL = 1
                        ELSE
                            ZON'KSTART'ZIP = UCS(HDR'SHP'COU)
                            USE ZON INTO ZON'REC KEY ZON'KEY
                        ENDIF
                        ENDIF
                        IF ZON'CTL # 0 THEN
                            ZON'KLOC'NO = 0
                            USE ZON INTO ZON'REC KEY ZON'KEY
                            IF HDR'SHP'COU = "US" OR HDR'SHP'COU = "USA" OR &
                                    HDR'SHP'COU = "PR" OR HDR'SHP'COU = "VI" THEN
                                IF ZON'CTL # 0 THEN
                                    GETPRV ZON INTO ZON'REC
                                ENDIF
                                \CHKKEY ZON APID="IN"
                                IF HDR'SHP'ZIP > ZON'END'ZIP THEN ZON'CTL = 1
                            ENDIF
                        ENDIF
                        IF ZON'CTL # 0 THEN
                                ZON'DAYS = 0
                        ELSE
                                IF AVIA'MAN'YN = "C" THEN
                                        IF ZON'DAYS = 0 THEN ZON'DAYS = ZON'ZONE
                                ELSE
                                        ZON'DAYS = 0
                                ENDIF
                        ENDIF
                ENDCASE
                DELIVERY = ""
                IF ZON'DAYS # 0 OR (VIA'SERV'TYPE = "03" AND &
                                                OC2'UPSONL'YN = "Y") THEN
                        MAP1 DO'UPSONL'YN,S,1
                        IF UPC'CHK'UPSONL = "N"
                            OC2'UPSONL'YN = "N"
                        ELSE
                        IF OC2'UPSONL'YN = "Y" AND DO'UPSONL'YN = "" THEN
!!If a dialup connection, do not do time-in-transit, set this env to "N"
                            XCALL GETENV,"OEPACK_UPSONL",DO'UPSONL'YN
                            IF DO'UPSONL'YN # "N" THEN DO'UPSONL'YN = "Y"
                        ENDIF
                        ENDIF
                        IF DO'UPSONL'YN = "Y" AND VIA'SERV'TYPE = "03" AND &
                                    WBWHAP # 1 THEN
                            LOC'KNO = HDR'LOC'NO
                            \VUSE LOC
                            \USELST LOC'LST'NO ALTFLD="LOC'ALT'SEQ"
                            ON ERROR GOTO TRANSIT'ERROR
                            \UPSONL'TRANSIT LST'ZIP HDR'SHP'ZIP ZZ
                          TRANSIT'RESUME:
                            ON ERROR GOTO OEPACK'ERTRAP
                            IF VAL(UPSONL'RESPONSE'RC) # 0 THEN
                                ZZ = ZON'DAYS
                            ELSE
                                DELIVERY = "*"
                            ENDIF
                        ELSE
                            ZZ = ZON'DAYS
                        ENDIF
                        IF LOC'OC = "C" THEN
                            II = ZZ + 1
                        ELSE
                            II = ZZ
                        ENDIF
                        ZON'DAYS = 0
                        DTT'DOW = DATE
                        DO UNTIL II = 0
                            ZON'DAYS = ZON'DAYS + 1
                            DAY'OF'WEEK = DAY'OF'WEEK + 1
                            DDY = DDY + 1
                            IF DAY'OF'WEEK > 6 THEN DAY'OF'WEEK = 0
                            IF DAY'OF'WEEK = 5 AND VIA'SAT'IND = "Y" AND &T
                                                        II = 1 EXIT
                            IF DAY'OF'WEEK > 4 REPEAT
                            IF DMN = 12 AND DDY = 25 REPEAT
                            IF DMN = 1 AND DDY = 1 REPEAT
                            IF DMN = 7 AND DDY = 4 REPEAT
                            II = II - 1
                        LOOP
                        \CNV'DTT DTT="DATE"
                        YDAYS = YDAYS + ZON'DAYS
                        QQ = YDAYS - (7 * INT(YDAYS/7)) + 1
                        IF QQ = 8 THEN QQ = 1
                        \UCNV'DTT
                        \STRDTT DDATE="ENTRY" FORMAT="SHORT"
                        DELIVERY = DELIVERY + STR(ZZ) + " days: " + &
                                         DAYS(QQ) + " " + ENTRY
                ENDIF
                CALL SET'LST'RECORDS
                IF WBWHAP = 0 THEN
                    DSP PACK02
                    PRINT TAB(-1,CR'OFF);
                    CALL DSP'BVIA'DESC
                    CALL DSP'AVIA'DESC
                            !!USED to call SET'LST'RECORDS here ...
                    LST'REC = BILL'REC
                    \NFMTADR ADDRESS="ADDR1" MAXI="5"
                    CALL DSP'BILL
                    IF LST'REC # SHIP'REC THEN
                        LST'REC = SHIP'REC
                        \NFMTADR ADDRESS="ADDR1" MAXI="5" ALTFLD="HDR'SHIP'TO"
                    ENDIF
                    CALL DSP'SHIP
                    \STRDTT DDATE="ENTRY" DTT="HDR'PROM'DTT"
                    CALL DSP'PROM
                ENDIF
        ELSE
                                                !!PSEUDO'CASH'TERMS = "N"
                                                !!AUTOPACK="N", ACTION="P"
                CALL SETUP'BILLING              !!Now we need these too
        ENDIF

CALL'CREATE'MBX:
        IF VIA'MTYPE # "O" THEN
            XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY
            IF HDR'LOC'NO = 1 OR &            !!NOT Mill direct order
                    (HDR'LOC'NO > 1 AND ENTRY # "") THEN
                CALL CREATE'MBX
            ENDIF
        ENDIF

        CALL COMPUTE'FREIGHT'BY'BOX     !!Box charges

        !!************ Malvern - do not execute Alternate Via
        DO'ALTVIA = 0       !!Force to skip Alternate Via
        OEC'AUTO'CMP = "N"  !!This field is in General Shipping Setup in OE
        !!************ Malvern - do not execute Alternate Via

        IF WE'ARE'PACKING = 1 AND DO'ALTVIA # 0 THEN
                IF CHG'VIA = 2 THEN
                    CHG'VIA = 0
                ELSE
                    CALL COMPUTE'ALTVIA'FREIGHT
                    IF CHG'VIA = 2 GOTO START'OVER
                ENDIF
                PRINT TAB(-1,CR'OFF);
        ENDIF
        CALL TOTAL'HDR'FROM'BREC        !!So free freight can be done
        IF FN'B'QUEUED = 1 GOTO FINISH'UP
        CALL ONE'COD'PER'ORDER          !!Still on billing ... or net order
        IF BVALUE'YN'BOX'NO # 0 OR LOC'STX'FRT'YN = "Y" OR &
                   HDR'OLD'CR # 0 OR HDR'OLD'CASH # 0 OR HDR'OLD'DR # 0 THEN
            ROUND'CASH = 1
            CALL ALLOCATE'CONSTANTS !!A constant changed, do it again!
            ROUND'CASH = 0
            CALL TOTAL'HDR'FROM'BREC !!So screen looks good
        ENDIF
        CALL COMPUTE'FREE'FRT'AMOUNT    !!Could be billing or actual
        IF DID'FREE'FRT = 1 THEN
            \DG GETVALUE _OESETUP oepack.large_package_free_freight ENTRY
            IF DG'CTL # 0 OR ENTRY = "N" THEN
                        !!If large package does not get FF subtract it out
                \FROUND ((HDR'SHP'TOTAL-HDR'SHP'DISC)/100) AMT2
                CASE
                IF (AMT2 - HDR'FFP'TOTAL) = 1 OR (AMT2 - HDR'FFP'TOTAL) = -1 THEN
                               !!Within a dollar to paste over rounding issues
                    AMT1 = 0
                ELSE
                IF AMT2 = 0 THEN
                    AMT1 = 0
                ELSE
                    AMT1 = HDR'FFP'TOTAL/AMT2 * 10000000
                ENDCASE
                \FROUND HDR'CD(1)+(LARGE'PKG'AMT*AMT1/10000000) HDR'CD(1)
                HDR'CD(1) = HDR'CD(1) MIN 0

                HDR'CD(1) = HDR'CD(1) MIN 0
            ENDIF
            ROUND'CASH = 1
            CALL ALLOCATE'CONSTANTS !!A constant changed, do it again!
            ROUND'CASH = 0
            CALL TOTAL'HDR'FROM'BREC !!So screen looks good
        ENDIF
        CALL UPDATE'HDR
ENDIF
!!STEP: 3) compute actual freight if needed (see below conditions)
!!         if possible, we copy the actual from the billing.
!!
IF INC'AUTOPACK = "Y" OR HDR'ACTION = "P" OR HDR'ACTION ="L"  THEN
                !!We are invoicing, so we need actual freight computed
        LENTRY = "**********"
        \LOG'IT
STEP3:
        TIME'CSV = "STEP3: AUTOPACK="+INC'AUTOPACK+" ACTION="+HDR'ACTION
        \TIME'CSV

        LENTRY = "STEP3: AUTOPACK="+INC'AUTOPACK+" ACTION="+HDR'ACTION
        \LOG'IT
        LENTRY = "**********"
        \LOG'IT

        IF WE'ARE'PACKING = 0 THEN
                CALL SET'SHIP'LST'RECORD        !!For state ...
        ENDIF
        CALL SET'ACTUAL'MODE
        CALL SEE'IF'SAME
        CALL CREATE'ARECS'FROM'BILLING  !!Just copy them over -- ALWAYS
        IF SAME # 0 THEN                        !!Billing = Actual
                CALL COMPUTE'FREIGHT'BY'ORDER   !!Do these again
                CALL ALLOCATE'CONSTANTS         !!And put them on boxes
                CALL COMPUTE'FREIGHT'BY'BOX     !!And re-do by box freight
                CALL ONE'COD'PER'ORDER          !!Still on actual ...
                IF INC'AUTOPACK # "Y" AND PSEUDO'CASH'TERMS = "Y" AND &
                                COMPUTE'BOX'CNT # HDR'BOX'COUNT THEN
                        !!Number boxes changed, allocate all fields from
                        !!COD estimate over all boxes.
                    IF HDR'BOX'COUNT > COMPUTE'BOX'CNT THEN
                        BKEY = "B"
                        BNO = COMPUTE'BOX'CNT + 1
                        CALL DELETE'REMAINING'BRECS
                        BOX'SPACE = SPACE
                        BOX'HDR'LOC'NO = HDR'LOC'NO
                        BOX'DOC'TYPE = HDR'DOC'TYPE
                        BOX'HDR'NO = HDR'NO
                        BOX'NO = COMPUTE'BOX'CNT + 1
                        BOX'SHIPMENT = HDR'SHIPMENT + 1
                        \SETKEY BOX MODE="KEY"
                        CALL DELETE'REMAINING'BOXES
                        BXV'SPACE = SPACE
                        BXV'HDR'LOC'NO = HDR'LOC'NO
                        BXV'DOC'TYPE = HDR'DOC'TYPE
                        BXV'HDR'NO = HDR'NO
                        BXV'NO = COMPUTE'BOX'CNT + 1
                        BXV'SHIPMENT = HDR'SHIPMENT + 1
                        \SETKEY BXV MODE="KEY"
                        CALL DELETE'REMAINING'BXVES
                    ENDIF
                    HDR'BOX'COUNT = COMPUTE'BOX'CNT
                    CALL CREATE'BRECS'FROM'ACTUAL
                    CNT = HDR'BOX'COUNT
                    CALL UPDATE'HDR
                    CALL SET'BILLING'MODE
                    ROUND'CASH = 1
                    ROUND'ALL = 1
                    CALL DIVIDE'UP
                    CALL ONE'COD'PER'ORDER
                    CALL SET'BILLING'MODE
                    BTYPE = "B"
                    BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
                    SBKEY = BKEY
                    DO
                        XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                        IF BCTL # 0 EXIT
                        IF BKEY[1;5] # SBKEY EXIT
                        CALL FILL'BOX'FROM'BREC
                    LOOP
                    CALL SET'ACTUAL'MODE
                    ROUND'CASH = 0
                    ROUND'ALL = 0
                ENDIF
        ENDIF
ENDIF

?TAB(24,1) ; TAB(-1,9) ;

FINISH'UP:                              !!Used if call tags, then print.
        TIME'CSV = "FINISH'UP:" : \TIME'CSV
        LENTRY = "FINISH'UP:" : \LOG'IT

        IF WE'ARE'PACKING = 1 AND FN'B'QUEUED = 0 THEN
            CALL SET'BILLING'MODE
            CALL TOTAL'HDR'FROM'BREC !!So screen looks good
            CALL SUM'HTOTAL
            IF TRH'COD'STATUS > 1 THEN
                IF (CALC'HTOTAL - HDR'OLD'CASH - HDR'OLD'CR + HDR'OLD'DR) <= 0 AND &
                            (VIA'MTYPE = "U" OR VIA'MTYPE = "F") THEN
!!to be nice if cr/dr or cash applied and it is cod order and 0 then we could
!!use a control XML field to change terms -- we MUST repack!!!
                    ENTRY = "Total <= 0 not allowed with COD terms: "+CALC'HTOTAL+"-"+HDR'OLD'CASH+"-"+HDR'OLD'CR+"+"+HDR'OLD'DR
                    CALL DO'ERR
                    GOTO ABORT
                ENDIF
            ENDIF
            IF WBWHAP = 0 THEN
                CALL DSP'PACK02'TOTALS
            ENDIF
        ENDIF
FINISH'UP2:
        TIME'CSV = "FINISH'UP2:" : \TIME'CSV
        LENTRY = "FINISH'UP2:" : \LOG'IT

        CALL GET'FINAL'ACTION           !!e.g. invoice or abort or ...
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "1: DUMP BOX"
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        IF BADCR = 1 THEN           !![59]
            IF WL'DEBUG # "" THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Order: "
                \KERROR HDR MODE="D" APID="OE" CNO="N"
                ENTRY = ENTRY + " Bad credit set not going on queue"
                \LABLOGGER ENTRY WL'DEBUG
                ENTRY = SAV'ENTRY
            ENDIF
            CALL DUMP'BOX'AND'TOTAL'HDR !![59]
            HDR'ACTION = SPACE
            HDR'PQU'STAT = ""
            CALL UPDATE'HDR
            GOTO OERCTL'ABORT   !![59]
        ENDIF                       !![59]
        IF INX2 = FN'D THEN
          LOOK'SEE: !!For debug you can goto here to see data
            CALL SAVE'LOOK'SEE
            IF WBWHAP # 0 THEN
                GOTO CMNRTN
            ELSE
                COPYF "CMNFIL[SY]",=CMN2,NOAFR
                CMN2'SPACE = SPACE
                CMN2'TO'PRGNAM = "OE1BOX"
                CMN2'FRM'PRGNAM = "OEPACK"
                CMN2'SAV'RCN(2) = 1
                CMN2'SAV'RCN(1) = HDR'RCN
                \WINDOW PRGNAM="OE1BOX" APID="OE" FULL="Y" COMMON="CMN2'REC" &
                                        SCREEN="PACK" LFA="F"
                GOTO FINISH'UP2
            ENDIF
        ENDIF
        IF WBWHAP # 0 THEN
            DO'CALL'TAG = "N"
        ENDIF
        IF INX2 = FN'7 AND DO'CALL'TAG # "Y" THEN
            IF HDR'ACTION = "E" OR HDR'ACTION = "L" THEN
                IF F7'SURE = "Y" OR (HDR'PICK'VER >= VAL(F7'SURE) AND &
                                                        VAL(F7'SURE) > 0) THEN
                    DO
                        ENTRY = "Are you sure you want to skip pick ticket "+&
                                                        STR(HDR'PICK'VER+1)
                        \L24CHR NOMSG="Y" CLR="Y"
                        ENTRY = UCS(ENTRY)
                    LOOP UNTIL ENTRY = "Y" OR ENTRY = "N"
                    IF ENTRY = "Y" THEN
                        HDR'ACTION = "P"
                    ELSE
                        HDR'ACTION = "E"
                    ENDIF
                ELSE
                    HDR'ACTION = "P"
                ENDIF
            ELSE
                CALL SHOULD'WE'SAVE'BOXES
                HDR'ACTION = "E"
            ENDIF
            SAV'ACTION = HDR'ACTION
            CALL UPDATE'HDR
            IF HDR'ACTION = "P" THEN
                CALL FIX'SPECIAL'TYPES
            ENDIF
            GOTO START'OVER
        ENDIF
        CASE
        IF INX2 = FN'W THEN
PRESSED'FUNC'W:
            TIME'CSV = "PRESSED'FUNC'W:" : \TIME'CSV
            LENTRY = "PRESSED'FUNC'W:" : \LOG'IT
            CALL SHOULD'WE'SAVE'BOXES
            INX1 = I'FUN : INX2 = FN'W      !!Above ruins these!
            GOTO ABORT
        ELSE
        IF INX2 = FN'10 THEN
            INX1 = I'RT
            INX2 = 0
        ELSE
        IF INX2 = FN'B THEN
PRESSED'FUNC'B:
            TIME'CSV = "PRESSED'FUNC'B:" : \TIME'CSV
            LENTRY = "PRESSED'FUNC'B:" : \LOG'IT
            IF INC'AUTOPACK = "N" AND HDR'ACTION = "P" THEN
                CALL CLEAR'PACK04
                IF WGT'WGT(161) # 0 THEN
                    ?TAB(-1,14) ;           !!Protect mode off
                    \CLRWIN 3 4 22 77
                    PAGENO = 1
                    DDB PACK03
                    ECFLD = 0
                ENDIF
                GOTO START'OVER'PACK03
            ELSE
                GOTO START'OVER'SAME'MODE
            ENDIF
        ENDCASE

        IF INC'USE'CV = "Y" AND TRH'CTP'NO # 0 AND HDR'ACTION # "L" AND &
                        TOTALS'ONLY # "Y" THEN
            IF WBWHAP = 0 THEN
!!If from WB1XML then it does not invoice, only packs
                CALL PROCESS'CREDIT'CARD        !!Could set FN'A ...
            ENDIF
        ENDIF
        HDR'SHP'DONE = "Y"
        IF WBWHAP # 0 AND INC'AUTOPACK # "Y" THEN
            CALL SET'FAKE'BOX
        ENDIF

        IF MBXERROR'COUNT > 0 THEN    !!Malvern
            HDR'HOLD'YN = "Y"    !!Temporary Hold
            ENTRY = "Box freight rate not retrieved - Please Release Hold and Repack"
            MSG'DID = "OEMSG"
            \LOOPMSG PRE="HDR" APPEND="HDR'MSGNO" DATA="ENTRY"
        ENDIF

        IF INX2 = FN'A THEN     !!PROCESS'CREDIT'CARD could set this
PRESSED'FUNC'A:
            TIME'CSV = "PRESSED'FUNC'A:" : \TIME'CSV
            LENTRY = "PRESSED'FUNC'A:" : \LOG'IT
            CALL SHOULD'WE'SAVE'BOXES
            CALL CLEAR'PACK04
            CALL PROCESS'ABORT'KEY  !!various cleanups
            GOTO ABORT
        ELSE
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "3: DUMP BOX"
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            CALL DUMP'BOX'AND'TOTAL'HDR
            IF BOX'BAD = 1 AND ANY'LAST'STUFF # 0 THEN
                BOX'BAD = 0
            ENDIF

            IF BOX'BAD = 1 THEN
                ENTRY = "All boxes have zero weight - please re-invoice!"
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
            ENDIF

            IF WBWHAP = 0 THEN
                ?TAB(24,1) ; TAB(-1,9) ;
            ENDIF
            IF HDR'ACTION # "L" AND WBWHAP = 0 THEN
                IF OEC'PULLER = "Y" AND HDR'ACTION = "P" AND INC'AUTOPACK = "N" THEN
                    CALL PROCESS'PULLER'CHECKER     !!Could change INX2
                    IF INX2 = FN'B GOTO PRESSED'FUNC'B
                    IF INX2 = FN'A GOTO PRESSED'FUNC'A
                    IF INX2 = FN'W GOTO PRESSED'FUNC'W
                ENDIF
                CALL CLEAR'PACK04
            ENDIF
            IF WBWHAP # 0 THEN
                DO'CALL'TAG = "N"
            ENDIF
            IF HDR'ACTION = "E" AND DO'CALL'TAG = "Y" THEN
                CALL DO'CAL
                GOTO FINISH'UP
            ELSE
                IF HDR'ACTION = "L" THEN
                    \WINDOW FULL="Y" SCREEN="PACK" ACTION="OERCTL'ABORT"
                    ENTRY = "Acknowledgement printed!"
                    MAP1 DONE'ACK,S,1
                    DONE'ACK = "Y"
                    \L24CHR CLR="Y"
                    HDR'RCN = CMN'SAV'RCN(1)
                    CALL RDLOCK'HDR
                    IF HDR'CTL # 0 THEN
                        GOTO CMNRTN
                    ENDIF
                    HDR'ACTION = "E"
                    GOTO FINISH'UP
                ELSE
                    GOTO OERCTL'ABORT
                ENDIF
            ENDIF
        ENDIF
!!Can never get here, either went to ABORT, FINISH'UP, or OERCTL'ABORT

    TIME'CSV = "END - PRESSED'FUNC'A:" : \TIME'CSV
END

MAP1 SENTRY,S,80

COPY "FORMAT"
COPY "BASERR"
COPY "CVTDTT"
COPY "CMPCRL",MY'DO'ERR="DO'ERR'OEPACK",WBWHAP'CHECK="Y" !!COMPUTE'CR'LIMIT:     !!TEST'HOLDS:

MAP1 LNAME,S,128
MAP1 LOGIT'NAME,S,128

DO'EXCUSE'LOG:
    TIME'CSV = "DO'EXCUSE'LOG" : \TIME'CSV
    IF DO'EXCUSE = 0 RETURN                            !!KLUDGE
    IF LNAME = "" THEN
        \DG GETSTRING _OESETUP oepack.log_frt LNAME
        IF DG'CTL # 0 THEN
            \DG GETSTRING _OESETUP oepack_log_frt LNAME
        ENDIF
        IF DG'CTL # 0 OR LNAME = "Y" THEN
            LNAME = "/logs/oepack_excuse.NXTC"
            XCALL ABUTIL,46,LNAME,LNAME
        ENDIF
    ENDIF
    IF INSTR(1,ENTRY,STR(HDR'NO)) = 0 THEN
        ENTRY = ENTRY + " NO="+STR(HDR'NO)
    ENDIF
    IF LNAME # "N" THEN
        \ABLOGGER ENTRY LNAME
    ELSE
        CALL DO'ERR'OEPACK
    ENDIF
    ENTRY = ""
RETURN

DO'ERR'OEPACK:
    IF WBWHAP = 0 CALL DO'ERR ELSE CALL DO'ERRLO
RETURN

MAP1 ENTRY'OEPACK,S,25

DO'ERR'OEPACKL:
        IF WBWHAP = 0 THEN
            CALL DO'ERRL
        ELSE
            IF WBWHAP # 3 THEN
                ENTRY'OEPACK = ENTRY
            ENDIF
            CALL DO'ERRLO
            WBWHAP = 3          !!Makes this fatal to WEB order
        ENDIF
RETURN

DO'ERR'OEPACKLO:
        IF WBWHAP = 0 THEN
            CALL DO'ERRLO
        ELSE
            CALL DO'ERR'OEPACKL
        ENDIF
RETURN

MAP1 TSTSTX,S,1

COPY "TTLSTX",CACHE="Y",TST'TAXABLE="TSTSTX"   !!COMPUTE'TTL'STX'PERC:, GET'SF'TAXABLE:
COPY "CCCARD[CV]",SHIP="Y",CTPPTR="CTPPTR"
                        !!E'CARDNO:, E'EXP:, E'APPROVAL:, SET'USE'CC:

!!GET'CC'PROVIDER for DO'ATQ call
\ANAUTHMAPS
COPY "CCANET[CV]" BLD="SKIP" SOURCE="OE"    !!SKIP ANET'BLD'AUTH'REQUEST

\\DUMLBL

MAP1 LIN'CACHED,B,1             !!0=NO, 1=BY LIN'NO, 2=BY PICK ORDER

MAP1 LINKEY,S,40
MAP1 CC'LINKEY,S,40
MAP1 TMP'LINKEY,S,40

DSP'PACK:
        IF PACK04'UP = 1 DSP PACK04 ELSE DSP PACK02
RETURN

START'FRESH:
    TIME'CSV = "START'FRESH:" : \TIME'CSV
    LENTRY = "START'FRESH:" : \LOG'IT
    BVALUE'YN'BOX'NO = 0
!!  XCALL VICSIT,7,9,BREC,BKEY,BPTR,0,BCTL           !!CLEAR (MOVED)
    XCALL VICSIT,7,9,WREC,WKEY,WPTR,0,WCTL           !!CLEAR
    XCALL VICSIT,7,9,XREC,XKEY,XPTR,0,XCTL           !!CLEAR
    CALL RESTORE'WREC'CACHE

    XCALL VICSIT,7,9,BREC,BKEY,BPTR,0,BCTL      !!CLEAR (SO NO SAVED CACHE)

    WE'HAVE'BRECS = 0
    MUST'WRITE'BRECS = 0
    WE'HAVE'ARECS = 0
    TBOX'COUNT = 0
    LAST'HEAVY'PKG'BOX'NO = 0
RETURN

CLEAR'BOX'CACHES:
        TIME'CSV = "CLEAR'BOX'CACHES:" : \TIME'CSV
        LENTRY = "CLEAR'BOX'CACHES:" : \LOG'IT
        BVALUE'YN'BOX'NO = 0
        XCALL VICSIT,7,9,BREC,BKEY,BPTR,0,BCTL           !!CLEAR
!!      XCALL VICSIT,7,9,WREC,WKEY,WPTR,0,BCTL           !!CLEAR
!!      XCALL VICSIT,7,9,XREC,XKEY,XPTR,0,BCTL           !!CLEAR
        CALL RESTORE'WREC'CACHE
        WE'HAVE'BRECS = 0
        MUST'WRITE'BRECS = 0
        WE'HAVE'ARECS = 0
RETURN

CLEAR'SAVED'CACHES:  !!I find it odd that when called it is right after
                     !!CLEAR'BOX'CACHES so the restore has happened
                     !!and the save is empty?  Should we not clear the
                     !!saved first?  I think it is working by accident
                     !!as after clearing we do re-write
        TIME'CSV = "CLEAR'SAVED'CACHES:" : \TIME'CSV
        LENTRY = "CLEAR'SAVED'CACHES:" : \LOG'IT
        XCALL VICSIT,7,9,WREC,WKEY,SAVWPTR,0,BCTL        !!CLEAR
        XCALL VICSIT,7,9,XREC,XKEY,SAVXPTR,0,BCTL        !!CLEAR
RETURN

CLEAR'VARIOUS'FLAGS:
        TIME'CSV = "CLEAR'VARIOUS'FLAGS:" : \TIME'CSV
        LENTRY = "CLEAR'VARIOUS'FLAGS:" : \LOG'IT
        ZONE'SPACE = SPACE
        AZONE'REC = ZONE'REC
        BZONE'REC = ZONE'REC
RETURN

MAP1 QTY'TO'PACK,B,5

CACHE'LIN:            !!First loop in white paper
    TIME'CSV = "CACHE'LIN:" : \TIME'CSV
    LENTRY = "CACHE'LIN:" : \LOG'IT

    IF LIN'CACHED = 0 THEN        !!LIN'CACHED IF
        IF (HDR'PICK'VER # 0 OR ORDER'REPICK # 0) AND HDR'PICK'NEED # "Y" THEN
            IF WBWHAP # 1 THEN
                CALL TCOUNT'START
            ENDIF
            FOR JJ = 1 TO 7
                PSEUDO'VTTL(JJ) = 0
            NEXT JJ
            BOX'SPACE = SPACE
            BOX'HDR'LOC'NO = HDR'LOC'NO
            BOX'DOC'TYPE = HDR'DOC'TYPE
            BOX'HDR'NO = HDR'NO
            BOX'NO = 1
            BOX'SHIPMENT = HDR'SHIPMENT + 1
            \SETKEY BOX MODE="KEY"
            USE BOX INTO BOX'REC KEY BOX'KEY
            DO
                GETNXT BOX INTO BOX'REC
                \CHKKEY BOX
                IF BOX'CTL # 0 THEN
                     EXIT
                ENDIF
                FOR JJ = 1 TO 7
                    PSEUDO'VTTL(JJ) = PSEUDO'VTTL(JJ) + BOX'SHP'VTTL(JJ)
                NEXT JJ
            LOOP
        ENDIF
                                                !![28] - above
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Loading order"
            CALL TCOUNT'START
        ENDIF
        IF MAX'BOX # 0 THEN
            VIA'KNO = HDR'VIA'NO
            CALL GET'VIA
            UOW2'KNO = VIA'UOW'NO
            CALL FIND'UOW2
        ENDIF
        DOZENS = 0
        PIECES = 0
        XCALL VICSIT,7,9,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!CLEAR
        IF MAX'BOX # 0 THEN
            XCALL VICSIT,7,9,LIN'REC,LINKEY,LINPTR2,0,LIN'PKT !!CLEAR
            ZZ = 0
        ENDIF
        QTY'TO'PACK = 0
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KDOC'TYPE = HDR'DOC'TYPE
        LIN'KHDR'NO = HDR'NO
        LIN'KNO = 0
        USE LIN INTO LIN'REC KEY LIN'KEY
!!Create LIN'REC cache

        DO                     !!Start LIN Loop
            GETNXT LIN INTO LIN'REC
            \CHKKEY LIN
            IF LIN'CTL # 0 THEN
                EXIT
            ENDIF
            IF LIN'NO < 1 OR LIN'NO > 9999 THEN
                ENTRY = "Invalid line number "
                \KERROR LIN MODE="D" CNO="N"
                ENTRY = ENTRY + " -- ABORTING!"
                CALL DO'ERRL
                GOTO DEAD'ABORT
            ENDIF

            IF OEC'SKIP'FUT = "Y" AND INC'INTERFACE # 6 AND &
                                                WBWHAP = 0 THEN
                DTT = LIN'PROM'DTT
                CALL CNV'DTT
                IF YDAYS > TODAY THEN
                    REPEAT
                ENDIF
            ENDIF
            CALL FIND'MEA           !!Also does FIND'PRH, FIND'UOW

            UOW2'KNO = VIA'UOW'NO
            CALL FIND'UOW2
            TMP'WGT = 0
            FOR II = 1 TO 6
                DOZENS = DOZENS  + INT(LIN'TORDER'QTY(II)/12)
                QTY'TO'PACK = QTY'TO'PACK + LIN'TCOM'QTY(II)

                IF LIN'TCOM'QTY(II) # 0 THEN
                    !!Weight of one
                    TMP'WGT = (MEA'WGT(II) * &
                        UOW'DUNITS * UOW2'NUNITS) /((UOW'NUNITS*UOW2'DUNITS) MAX 1)
                    TMP'WGT'ONE = TMP'WGT   !!Weight of one piece for the first size with order quantity
                ENDIF
            NEXT II
            PIECES = PIECES + LIN'ORDER'QTY
            IF WBWHAP # 1 THEN
                CALL TCOUNT
            ENDIF
            IF SPLIT'BO = "N" THEN
                IF LIN'COM'QTY = 0 THEN
                    REPEAT
                ENDIF
            ENDIF
            CASE                    !!CASE 1
            IF MAX'BOX # 0 THEN

                CTC = CTC MAX START'CTC
                LIN2'SPACE = SPACE
                LIN'CACHED = 2
                LIN'TEMP = "N"
                LIN'TEMP2 = "N"
                TMP2'WGT = INT((TMP'WGT+99)/100)*100
                HIGH'WGT = INC2'MAX'UPS

                MAP1 IS'PKG,B,1

                IF PKG'CASE'LEN # 0 OR MEA'TREAT'CASE = "D" THEN
                    IS'PKG = 1
                ELSE
                    IS'PKG = 0
                ENDIF

!!place1 -- setting of LIN'TEMP must match oetstp -- see oetstp for how to
!!          make pkg if 1 piece per case (see place2 must match)
                CASE                            !!CASE  2
                IF TMP2'WGT >= HIGH'WGT THEN
                    LIN'TEMP = "H"
                ELSE
                IF IS'PKG = 1 THEN
                    LIN'TEMP = "D"
                ELSE
!!We are not strapping but SMART'STRAP sets fields we need.  Do not remove!
                    CALL SMART'STRAP
                ENDCASE                !!ENDCASE for CASE 2

                IF LIN'TEMP = "N" THEN     !!NOT a PKG item
!!Non-algorithm goes last after heavy/packaging
                    IF PRH'HAZ'NO # 0 THEN
                        SENTRY = "Z"    !!HAZ items
                    ELSE
                        SENTRY = "N"    !!Normal items
                    ENDIF
!!Heaviest first
                    TMP'WGT = 100000 - TMP'WGT'ONE    !!KLUDGE
                ELSE
!!lighest first (heavy & packaging)  No need for heavy first as these are one
!!                                   one per box and oepack does not "think"
                    SENTRY = "C"        !!PKG items
!!                  TMP'WGT = TMP'WGT   !!leave alone for light 1st
                ENDIF

                IF LIN'TEMP # "N" THEN
!!In case ends up heavy or something ... restore original values

                    LIN'TEMP2 = "N"
                    FOR WW = 1 TO 6
                        LIN'TCOM'QTY(WW) = LIN'TCOM'QTY(WW) + &
                                                        LIN2'TCOM'QTY(WW)
                        LIN2'TCOM'QTY(WW) = 0
                    NEXT WW
                ENDIF

!!Use weight
                LINKEY = TMP'WGT USING "#ZZZZZ"
                LINKEY = (LIN'HDR'LOC'NO USING "#ZZZ") + &
                (LIN'HDR'NO USING "#ZZZZZZ") + &
                                         SENTRY + LINKEY + SPACE(30)
                LINKEY[-4,-1] = LIN'NO USING "#ZZZ"
!!If key has "C" then set LIN'TEMP TO "C" ?? - SENTRY could have C
            ELSE
                IF ((OEC'PCK'ORDER >= 1 AND OEC'PCK'ORDER <= 3) OR &
                                    HDR'PROC = 6) AND HDR'LIN'COUNT > 2 AND &
                                                    INC'AUTOPACK = "Y" THEN
!!In certain autopack cases (mostly) we want sorted, so just cache that way
                    LIN'CACHED = 2

                    IF OEC'PCK'ORDER < 1 OR OEC'PCK'ORDER > 3 THEN
                        LINKEY = LIN'NO USING "####"
                    ELSE
                        IF OEC'PCK'ORDER = 2 THEN
                            LINKEY = LIN'TRK'NO USING "##########"
                        ELSE
                            CALL FIND'PRH
                            CASE                !!CASE 4
                            IF PRH'CTL # 0 THEN
                                LINKEY = ""
                            ELSE
                            IF OEC'PCK'ORDER = 1 THEN
                                LINKEY = PRH'PART
                            ELSE
                                QTY'KLOC'NO = LIN'LOC'NO
                                QTY'KTRK'NO = LIN'TRK'NO
                                QTY'KATT'NO1 = 1
                                QTY'KATT'NO2 = 0
                                USE QTY INTO QTY'REC KEY QTY'KEY
                                GETNXT QTY INTO QTY'REC
                                IF QTY'TRK'NO # LIN'TRK'NO THEN
                                    QTY'CTL = 3
                                ENDIF
                                IF QTY'CTL # 0 THEN
                                    QTY'CGE'NO(1) = 0
                                    QTY'ASL'NO(1) = 0
                                    QTY'SCT'NO(1) = 0
                                    QTY'BIN'NO(1) = 0
                                ENDIF
                                IF KAYMAN'SORT = "Y" THEN
                                    LINKEY[1;4]  = QTY'CGE'NO(1) USING "####"
                                    LINKEY[5;4]  = QTY'ASL'NO(1) USING "####"
                                    LINKEY[9;8] = LEFT(PRH'PART+SPACE(8),8)
                                ELSE
                                    LINKEY[1;4]  = QTY'CGE'NO(1) USING "####"
                                    LINKEY[5;4]  = QTY'ASL'NO(1) USING "####"
                                    LINKEY[9;4]  = QTY'SCT'NO(1) USING "####"
                                    LINKEY[13;4] = QTY'BIN'NO(1) USING "####"
                                ENDIF
                            ENDCASE    !!ENDCASE for CASE 4
                            IF LINKEY[17;4] = "" THEN
                                LINKEY[17;4] = LIN'CMG'NO USING "####"
                            ENDIF
                        ENDIF
                    ENDIF
                    IF HDR'PROC = 6 THEN
                        LINKEY[5,-1] = LINKEY
                        LINKEY[1;4] = STR(LIN'HDR'LOC'NO) USING "####"
                    ENDIF
                    LINKEY = (LIN'HDR'LOC'NO USING "#ZZZ") + &
                                         (LIN'HDR'NO USING "#ZZZZZZ") + &
                                         LINKEY + SPACE(30)
                    LINKEY[-4,-1] = LIN'NO USING "#ZZZ"

            ELSE
!!non-autopack any old order will do ...
                LIN'CACHED = 1
                LINKEY = (LIN'HDR'LOC'NO USING "#ZZZ") + &
                                (LIN'HDR'NO USING "#ZZZZZZ") + &
                                (LIN'NO USING "#ZZZ")
            ENDCASE        !!ENDCASE for CASE 1
            WRK'QTY = 0
            FOR WW = 1 TO 6
                WRK'QTY = WRK'QTY + LIN'TCOM'QTY(WW)
            NEXT WW
            IF WRK'QTY # 0 THEN
!!Don't add pieces section if pure cases (LIN only has stray pieces here)
!!                            or if not PKG/case it is the entire line
                XCALL VICSIT,7,1,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!ADD

!!Above put the pieces in as normal or HAZ or PKG/cases

            ENDIF
            IF LIN'TEMP2 = "P" AND LIN'TEMP = "N" THEN
                LINKEY = TMP'WGT USING "#ZZZZZ"
                LINKEY = (LIN'HDR'LOC'NO USING "#ZZZ") + &
                            (LIN'HDR'NO USING "#ZZZZZZ") + &
                            "C" + LINKEY + SPACE(30)
                LINKEY[-4,-1] = LIN'NO USING "#ZZZ"
                LIN'TEMP2 = "C"         !!Cases portion
!!Only put pieces count in
                FOR WW = 1 TO 6
                    LIN'TCOM'QTY(WW) = LIN2'TCOM'QTY(WW)
                NEXT WW

                XCALL VICSIT,7,1,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!ADD

!!Above put the cases in as PKG  (the "C" in key)
            ENDIF

            IF LIN'CTL # 0 THEN
                IF LIN'CTL = 9 THEN
                    ENTRY = "Overflow LIN cache!"
                ELSE
                    ENTRY = "Duplicate LIN cache!"
                ENDIF
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
            ENDIF
        LOOP                       !!End LIN Loop

        PIECES = PIECES - (DOZENS*12)
        IF QTY'TO'PACK = 0 THEN
            ENTRY = "No lines to pack!?"
            CALL DO'ERR'OEPACK
            IF INC'AUTOPACK # "Y" THEN
                XCALL GETENV,"OEPACK_NADA",ENTRY
                IF ENTRY = "Y" GOTO FINISH'UP2  !![30]
            ENDIF
            GOTO DEAD'ABORT                 !!KLUDGE
        ENDIF
    ENDIF    !!ENDIF for LIN'CACHED

    TIME'CSV = "END of CACHE'LIN:" : \TIME'CSV
    LENTRY = "END of CACHE'LIN:" : \LOG'IT
    CALL DUMP'LINKEY'CACHE
RETURN                                !!CACHE'LIN

MAP1 CARTON'LOOP,B,1
MAP1 PACK'HDR'SPACE,S
    MAP2 PACK'RCN,B,4
    MAP2 PACK'UOW'NO,B,2
    MAP2 VIA'CUS'NO,B,3
    MAP2 VIA'NO'NO,B,2
MAP1 PACK'COUNT,B,5

SET'INC2'MAX'UPS:
!!The effect of [34] is that if other manifest and you leave max weight
!!zero it will behave the old way, otherwise it will use the via max weight.
        TIME'CSV = "SET'INC2'MAX'UPS:" : \TIME'CSV
        LENTRY = "SET'INC2'MAX'UPS:" : \LOG'IT
        IF VIA'NO = 0 THEN
            VIA'KNO = HDR'VIA'NO
            CALL FIND'VIA
        ENDIF
        INC2'REC = INC'REC                              !![35]
        IF VIA'MAX'WEIGHT # 0 THEN                      !![34]
           INC2'MAX'UPS = VIA'MAX'WEIGHT * 100
        ENDIF

        IF VIA'MAN'YN = "O" AND VIA'MAX'WEIGHT = 0 THEN
                INC2'MAX'UPS = 999999999
                FOR II = 1 TO 10
                        INC2'WEIGHT(II) = INC2'MAX'UPS
                NEXT II
        ELSE

!!Currently PSEUDO'CASH'TERMS is not set so below is never true

!!Cash terms do not work, only using Net terms
!!It would be a project to fix / make it work
!!Leave IF below for now - study code below if you want cash terms to work
!!              IF PSEUDO'CASH'TERMS = "Y" AND OC2'NET'PPERC > 0 AND OC2'NET'PPERC < 100 THEN
                        FOR II = 1 TO 10
                            \FROUND INC2'WEIGHT(II)/(OC2'NET'PPERC/100) INC2'WEIGHT(II)
                            INC2'WEIGHT(II) = INC2'WEIGHT(II) MIN INC2'MAX'UPS
                        NEXT II
!!              ENDIF
        ENDIF
        IF CUS'MAX'WEIGHT > 0 THEN
           INC2'MAX'UPS = INC2'MAX'UPS MIN (CUS'MAX'WEIGHT*100)
        ENDIF
!!Do the cartons
RETURN

PACK'HDR:
        LENTRY = "**********"
        \LOG'IT
        TIME'CSV = "PACK'HDR:" : \TIME'CSV
        LENTRY = "PACK'HDR:" : \LOG'IT
        LENTRY = "**********"
        \LOG'IT

        CALL SET'INC2'MAX'UPS
        CTC = START'CTC

PACK'HDR'RETRY:
        TIME'CSV = "PACK'HDR'RETRY:" : \TIME'CSV
        LENTRY = "PACK'HDR'RETRY:" : \LOG'IT

        CALL START'FRESH

        IF HDR'LOC'NO = 1 THEN
            MAX'BOX = START'MAX'BOX
        ELSE
            MAX'BOX = 9999    !!9999=pack by piece to max ups
            START'MAX'BOX = 9999
            HDR'HOW'PACK = "O"
        ENDIF
        TIME'CSV = "MAX'BOX="+MAX'BOX+" HOW'PACK="+HDR'HOW'PACK
        \TIME'CSV
        LARGE'PKG'AMT = 0   !!Used in dimsub for kludge FF and later in here
                            !!when we call VIADISC macro
        LARGE'PKG'BNO = 0   !!Ditto with AMT
        IF HDR'RCN = PACK'RCN AND PACK'UOW'NO = AVIA'UOW'NO THEN
            CALL CREATE'BRECS'FOR'THIS'VIA
            RETURN !!KLUDGE
        ENDIF
        HDR'SPI'WGT = 0
        PACK'RCN = HDR'RCN
        PACK'UOW'NO = AVIA'UOW'NO
        PACK'VIA'NO = HDR'BVIA'NO

        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Packing order, please wait"
            CALL TCOUNT'START
        ENDIF

        BVALUE'YN'BOX'NO = 0
        CALL CLEAR'BOX'CACHES
        CALL CLEAR'SAVED'CACHES
        IF INC'AUTOPACK = "Y" THEN
                BXL'SPACE = SPACE
                BXL'DOC'TYPE = HDR'DOC'TYPE
                BXL'HDR'LOC'NO = HDR'LOC'NO
                BXL'SHIPMENT = HDR'SHIPMENT + 1
                BXL'HDR'NO = HDR'NO
                \SETKEY BXLB MODE="KEY" ALTKEY="BXLB2"
                USE BXLB2 INTO BXL'REC KEY BXLB2'KEY
                DO
                        GETNXT BXLB2 INTO BXL'REC
                        \CHKKEY BXLB ALTKEY="BXLB2" LASTFIX="KEYFLD2"
                        IF BXLB2'CTL # 0 EXIT
                        RDLOCK BXL BXLB2'RCN INTO BXL'REC
                        \SETKEY BXL MODE="ALL"
                        DELETE BXL
                        \DELKEY BXL MODE="ALL"
                LOOP
        ENDIF

        UOW2'KNO = AVIA'UOW'NO
        CALL FIND'UOW2
        CALL SET'INC2'MAX'UPS

      RE'DO'CARTONS:
        TIME'CSV = "RE'DO'CARTONS:" : \TIME'CSV
        LENTRY = "RE'DO'CARTONS:" : \LOG'IT

        MAP1 SPECIAL'WGT,B,5
        MAP1 ANY'LAST'STUFF,B,1

        CALL CLEAR'BOX'CACHES
        CALL RESTORE'WREC'CACHE

        SPECIAL'WGT = 0
        ANY'LAST'STUFF = 0 MAX ANY'LAST'STUFF
        PACK'COUNT = 0
        CARTON'LOOP = 1
        PACK'SPACE = SPACE

        LAST'HEAVY'PKG'BOX'NO = 0
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KHDR'NO = HDR'NO
        CALL SET'LINKEY
        SET'LINKEY = LINKEY

!!Second loop in white paper
!!Read Cache'lin records and retest packing temp values: LIN'TEMP
!!Cache is built when you start program (CACHE'LIN:) which is first loop!
        TIME'CSV = "RE'DO'CARTONS: LOOP START" : \TIME'CSV
        DO
                XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
                IF LIN'CTL # 0 EXIT
                IF LINKEY[1,11] # SET'LINKEY EXIT
                PACK'COUNT = PACK'COUNT + 1
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                CALL FIND'PRH
                !!Test for Shippable items
                IF PRH'INVENTORY # "N" OR PACK'NON'INV = "Y" THEN
                  CALL FIND'MEA     !!Also does FIND'PRH, FIND'UOW

                  !![PACK'HDR]
                  !!PACK METHOD based on MAX'BOX Value
                  !!9999 = Conventioanl piece pack based on fixed max box weight determined
                  !!    by Location, VIA or Customer restrictions
                  !!    non'zero = Conventioanl piece pack based on VIA with SPI box weights
                  !!    or Non-SPI VIA using fixed box weight determined
                  !!    by Location, VIA or Customer restrictions
                  !!    zero = Old pack method in Cases, Dozen and pieces, fixed max box weight determined
                  !!    by Location, VIA or Customer restrictions

                  IF MAX'BOX # 0 THEN
!!All below highly related to CACHE'LIN so if you change

                   FOR WW = 1 TO 6
                      IF LIN'TCOM'QTY(WW) # 0 THEN

                        CALL FIND'MEA           !!Also does FIND'PRH, FIND'UOW
                        LIN'TEMP = "N"          !!Start with "N" normal items like apparel then determine if item
                                                !!fits another packing category ie Package(D), Heavy(H) or Hazardous(Z)
!!Weight of one
                        TMP2'WGT = (MEA'WGT(WW) * &
                                                UOW'DUNITS * UOW2'NUNITS)  &
                                                /((UOW'NUNITS*UOW2'DUNITS) &
                                                MAX 1)
                        TMP'WGT = INT((TMP2'WGT+99)/100)*100

                        IF PKG'CASE'LEN # 0 OR MEA'TREAT'CASE = "D" THEN
                            IS'PKG = 1
                        ELSE
                            IS'PKG = 0
                        ENDIF

!!setting of LIN'TEMP must match oetstp -- see oetstp for how to
!!          make pkg if 1 piece per case (see place1 must match)
                        CASE
                        IF TMP'WGT >= INC2'MAX'UPS THEN
!!Single item is too heavy for packing or packaged
                            LIN'TEMP = "H"
                        ELSE
                        IF IS'PKG = 1 THEN
                            LIN'TEMP = "D"
                        ENDCASE

                        IF LIN'TEMP = "N" THEN            !!NOT a PKG/Heavy item
                              IF PRH'HAZ'NO # 0 THEN
                                  LIN'TEMP = "Z"          !!HAZ items
                              ENDIF
                        ENDIF
                        IF LIN'TEMP = "D" OR LIN'TEMP = "H" THEN
!!Single item is too heavy or too big for packing
                            ANY'LAST'STUFF = 1
                        ELSE
!!Only add WREC for Hazardous or Apparel
!!Single item check
                            WREC'SPACE = SPACE
                            WLIN'NO = LIN'NO
                            WSUB'NO = WW
                            WTQTY = LIN'TCOM'QTY(WW)
!!                          WPQTY = 0
                            WWGT = TMP2'WGT
                            WLIN'PRICE = LIN'PRICE - LIN'DISC
                            CALL GET'FREEBE
                            CALL FIND'MEA   !!I think this trashes UOW to the last line item
                                            !!Don't need this because I changed CC to lbs
                            IF FREEBE = "Y" THEN
                                WFREEBE = "Y"
                            ELSE
                                WFREEBE = "N"
                            ENDIF
                                    !!Dimensional/Heavy skips this (see above)
                            IF PRH'HAZ'NO # 0 THEN
                                LIN'TEMP = "Z"    !!HAZ items
                            ELSE
                                LIN'TEMP = "N"    !!Normal items
                            ENDIF
                            WTEMP = LIN'TEMP
                            WKEY = (LIN'NO USING "#ZZZ") + WW
                            IF INSTR(1,LINKEY,"C") = 0 THEN
                                XCALL VICSIT,7,1,WREC,WKEY,WPTR,0,WCTL    !!ADD
!!Adding WREC to Cache and backup cache
                                XCALL VICSIT,7,1,WREC,WKEY,SAVWPTR,0,WCTL !!ADD
                            ENDIF
!!Now has total weight of one size
                            SPECIAL'WGT = SPECIAL'WGT + (TMP2'WGT * LIN'TCOM'QTY(WW))
                        ENDIF
                      ENDIF
                   NEXT WW
                   XCALL VICSIT,7,2,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!update or add
!!Update with zeros
                   XCALL VICSIT,7,2,LIN'REC,LINKEY,LINPTR2,0,LIN'PKT !!update or add
                  ELSE
                      LIN'TEMP = ""
                      LIN'TEMP2 = ""


                      SPECIAL'WGT = 0
                      DOING'NORMAL = 1
                  ENDIF
                ENDIF
        LOOP
        TIME'CSV = "RE'DO'CARTONS: LOOP END" : \TIME'CSV

        IF PACK'COUNT = 0 THEN
            ENTRY = "Nothing to pack!?"
            CALL DO'ERR'OEPACK
            IF INC'AUTOPACK # "Y" THEN
                XCALL GETENV,"OEPACK_NADA",ENTRY
                IF ENTRY = "Y" GOTO FINISH'UP2  !![30]
            ENDIF
            GOTO DEAD'ABORT                 !!KLUDGE
        ENDIF

        MAP1 ORG'SPECIAL'WGT,B,5
        MAP1 ORG'ZONE,S,4

        CALL GET'ZONE
        ORG'SPECIAL'WGT = SPECIAL'WGT
        HDR'ZONE = ALOC'ZONE(1)
        CALL SAVE'CACHE
        IF MAX'BOX # 0 THEN
            INCREASE = 0
            CTC = CTC MAX START'CTC

!!Comes here again when SPECIAL'WGT
!!changes due to failed pack at previous SPECIAL'WGT

      DO'DZ'PIECES'AGAIN:        !!keep here
            TIME'CSV = "DO'SZ'PIECES'AGAIN:" : \TIME'CSV
            LENTRY = "DO'SZ'PIECES'AGAIN:" : \LOG'IT

            MAP1 OLD'CONVENTIONAL,B,1

            OLD'CONVENTIONAL = CTC
            FORMER'WGT = 0
            TBOX'COUNT = 0

            CALL INIT'SPECIAL'PACKING
            CTC = CTC MAX START'CTC
            IF CTC = 0 AND MAX'BOX = 9999 THEN
!!              MAX'BOX = START'MAX'BOX  !!NO -- it has to be 9999
                CTC = 2
                LIN'CACHED = 0

                CALL CACHE'LIN      !!Reload CACHE'LIN
                PACK'RCN = 0
                GOTO PACK'HDR'RETRY                  !!KLUDGE
            ENDIF
            HDR'SPI'WGT = INT((ORG'SPECIAL'WGT+99)/100)
            IF MAX'BOX < 9999 THEN
                HDR'ASPI'WGT = SPD'KSPI'WGT
            ELSE
                HDR'ASPI'WGT = 0
            ENDIF
!!          IF SF = 1 GOTO RE'DO'CARTONS
        ENDIF
        CALL INIT'BOXES
        CALL RESTORE'WREC'CACHE
        CALL EMPTY'BOX                  !!Start with empty box after packing
        IF MAX'BOX = 0 THEN
            GOTO OLD'PACKING            !!KLUDGE
        ENDIF

!!packloop 1 (third loop in white paper but first to actually pack)
!!packs cases

        PACK'COUNT = 0
        CARTON'LOOP = 2

!!Process Cases first when LINKEY ends in "C" and LIN'TEMP2 = "C"
!!START PACKING HERE

        LENTRY = "**********"
        \LOG'IT
        TIME'CSV = "Packloop 1 Cases - HDR'NO="+HDR'NO : \TIME'CSV
        LENTRY = "Packloop 1 Cases - HDR'NO="+HDR'NO : \LOG'IT

        LENTRY = "**********"
        \LOG'IT

        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KHDR'NO = HDR'NO
        CALL SET'LINKEY
        LINKEY = LINKEY + "C"
        SET'LINKEY = LINKEY
        DO
            XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
            IF LIN'CTL # 0 THEN
                EXIT
            ENDIF
            IF LINKEY[1,12] # SET'LINKEY THEN
                EXIT
            ENDIF
!!To fix issue with case pack packing into Heavy or Package Boxes
!!Org IF LIN'TEMP # "D" AND LIN'TEMP # "H" AND LIN'TEMP2 # "C" THEN
           IF INSTR(1,LINKEY,"C") = 0 OR LIN'TEMP = "H" THEN    !!do heavy on next loop
                REPEAT
            ENDIF
            PACK'COUNT = PACK'COUNT + 1
            IF WBWHAP # 1 THEN
                CALL TCOUNT
            ENDIF
            CALL FIND'PRH
            IF PRH'INVENTORY # "N" OR PACK'NON'INV = "Y" THEN
                MAP1 DOING'HEAVY,B,1
                MAP1 DOING'CASES,B,1
                DOING'CASES = 1
                CALL PACK'HDR2
                LIN'TEMP3 = "Y"
                XCALL VICSIT,7,2,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!ADD/UPDATE
                DOING'CASES = 0
            ENDIF
        LOOP

        HDR'LPKG'BOX = LAST'HEAVY'PKG'BOX'NO
        TBOX'COUNT = LAST'HEAVY'PKG'BOX'NO

!!Process Heavy or package items when LINKEY ends in "C" and LIN'TEMP = "D" or "H"
!!packloop 2 (fourth loop in white paper actually packs)

        CARTON'LOOP = 2
        DOING'CASES = 0

        LENTRY = "**********"
        \LOG'IT
        TIME'CSV = "Packloop 2 Heavy or Package items -  HDR'NO="+HDR'NO
        \TIME'CSV
        LENTRY = "Packloop 2 Heavy or Package items -  HDR'NO="+HDR'NO
        \LOG'IT

        LENTRY = "**********"
        \LOG'IT

        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KHDR'NO = HDR'NO
        CALL SET'LINKEY
        LINKEY = LINKEY + "C"
        SET'LINKEY = LINKEY
        DO
            XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
            IF LIN'CTL # 0 THEN
                EXIT
            ENDIF
            IF LINKEY[1,12] # SET'LINKEY THEN
                EXIT
            ENDIF

!!If Item is not flagged as a case or dimensional but over Max Weight
!!then process it with Heavys

            IF LIN'TEMP # "D" AND LIN'TEMP # "H" THEN
                REPEAT
            ENDIF
            IF LIN'TEMP3 = "Y" THEN
                REPEAT
            ENDIF
            PACK'COUNT = PACK'COUNT + 1
            IF WBWHAP # 1 THEN
                CALL TCOUNT
            ENDIF
            CALL FIND'PRH
            IF PRH'INVENTORY # "N" OR PACK'NON'INV = "Y" THEN
                DOING'HEAVY = 1
                CALL PACK'HDR2
                DOING'HEAVY = 0
            ENDIF
        LOOP

        HDR'LPKG'BOX = LAST'HEAVY'PKG'BOX'NO
        TBOX'COUNT = LAST'HEAVY'PKG'BOX'NO

!!"We are calling FULL'BOX from Loop 2 - Heavy"

        CALL FULL'BOX                        !!Finish heavy, set to next box

        DOING'HEAVY = 0
        CARTON'LOOP = 0
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KHDR'NO = HDR'NO
        CALL SET'LINKEY
        LINKEY = LINKEY + "Z"
        SET'LINKEY = LINKEY

!!Pack hazardous third (only HAZ w/out heavy/PKG issues
!!packloop 3 (fifth loop in white paper actually packs)

        LENTRY = "**********"
        \LOG'IT
        TIME'CSV = "Packloop 3 Hazardous - HDR'NO="+HDR'NO : \TIME'CSV
        LENTRY = "Packloop 3 Hazardous - HDR'NO="+HDR'NO : \LOG'IT
        LENTRY = "**********"
        \LOG'IT

        DO
                XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
                IF LIN'CTL # 0 THEN
                    EXIT
                ENDIF
                IF LINKEY[1,12] # SET'LINKEY THEN
                    EXIT
                ENDIF
                IF LIN'TEMP # "Z" THEN
                    REPEAT
                ENDIF
                IF LIN'COM'QTY = 0 REPEAT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                CALL FIND'PRH

                IF PRH'INVENTORY # "N" OR PACK'NON'INV = "Y" THEN
                   MAP1 DOING'HAZ,B,1
                   DOING'HAZ = 1

                   CALL PACK'HDR2
                   DOING'HAZ = 0
                ENDIF
        LOOP

        MAP1 LAST'HEAVY'PKG'BOX'NO,B,2
        TBOX'COUNT = LAST'HEAVY'PKG'BOX'NO

!!packloop 4 (sixth loop in white paper and last to actually pack)
!!packing leftovers (normal)

        LENTRY = "**********"
        \LOG'IT
        TIME'CSV = "Packloop 4 Leftovers (Old Packing) - HDR'NO="+HDR'NO
        \TIME'CSV
        LENTRY = "Packloop 4 Leftovers (Old Packing) - HDR'NO="+HDR'NO
        \LOG'IT
        LENTRY = "**********"
        \LOG'IT

    OLD'PACKING:
!!pack the normal stuff
        BREC'SPACE = SPACE
        CALL FULL'BOX                        !!Finish heavy, set to next box
        BNO = TBOX'COUNT
        CARTON'LOOP = 0
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KHDR'NO = HDR'NO
        CALL SET'LINKEY
        LINKEY = LINKEY + "N"
        SET'LINKEY = LINKEY
        DO
                XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
                IF LIN'CTL # 0 THEN
                    EXIT
                ENDIF
                IF LINKEY[1,12] # SET'LINKEY THEN
                    EXIT
                ENDIF
                IF LIN'TEMP # "N" AND MAX'BOX # 0 THEN
                    REPEAT
                ENDIF
                IF LIN'COM'QTY = 0 THEN
                    REPEAT
                ENDIF
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                CALL FIND'PRH

                IF PRH'INVENTORY # "N" OR PACK'NON'INV = "Y" THEN
                    MAP1 DOING'NORMAL,B,1
                    DOING'NORMAL = 1
                    CALL PACK'HDR2
                    DOING'NORMAL = 0
                ENDIF
        LOOP

        LENTRY = "**********"
        \LOG'IT
        TIME'CSV = "After Old Packing" : \TIME'CSV
        LENTRY = "After Old Packing"
        \LOG'IT
        LENTRY = "**********"
        \LOG'IT

!!Check and see if the algorithm worked.  MAX'BOX = 0 means packed by
!!case/dz/pieces (not used now as it does not work -- was for EASI which now
!!pack conventional).  MAX'BOX = 9999 is conventional. In between is algorithm.

        IF MAX'BOX > 1 AND MAX'BOX < 9999 THEN
            ORG'ZONE = ALOC'ZONE(1)
!!          HDR'SPI'WGT = INT((SPECIAL'WGT+99)/100)
            IF HIGH'BOX > 1 AND HIGH'BOX < 9999 THEN
!!Check algorithm only if more than one box in ALGORITHM
                MAP1 INCREASE,B,5
                MAP1 HB,B,2

                CALL FIX'PROBLEM                 !!Fit something else
                CALL SEE'IF'ALGORITHM'OK
                TIME'CSV = "After SEE'IF'ALGORITHM'OK - SF="+SF+" If SF=1 then algorithm is not OK"
                \TIME'CSV
                LENTRY = "After SEE'IF'ALGORITHM'OK - SF="+SF+" If SF=1 then algorithm is not OK"
                \LOG'IT
                IF SF # 0 THEN                      !!algorithm not OK
!!1=Box weights or counts don't fit algorithm
!!2=Packed but BXL does not match LIN (Code currently not enabled)
                    CALL START'FRESH
                    IF (INCREASE/100) <= (HIGH'BOX-1) AND SF # 2 THEN
!!Most we want to increase
                        INCREASE = INCREASE + 100
                        SPECIAL'WGT = ORG'SPECIAL'WGT + INCREASE
                        LINKEY = ""
                        XCALL VICSIT,7,9,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!CLEAR
                        DO
                            XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR2,0,LIN'PKT !!GETNXT
                            IF LIN'CTL # 0 EXIT
                            XCALL VICSIT,7,2,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!ADD/UPDATE
                        LOOP
                    ELSE
                        TIME'CSV = "UTTER FAILURE TO PACK" : \TIME'CSV
                        LENTRY = "UTTER FAILURE TO PACK" : \LOG'IT
                                                   !!UTTER FAILURE TO PACK
                        MAX'BOX = 9999
                        HIGH'BOX = 9999
                        HDR'HOW'PACK = "S"    !!Switched
                    ENDIF
                    GOTO DO'DZ'PIECES'AGAIN        !!pack again
                ENDIF
            ENDIF
        ENDIF
        IF WBWHAP # 1 THEN
            CALL DSP'BOXES
        ENDIF
        WE'HAVE'BRECS = 1
        MUST'WRITE'BRECS = 1

        LENTRY = "**********"
        \LOG'IT
        TIME'CSV = "End of PACK'HDR:" : \TIME'CSV
        LENTRY = "End of PACK'HDR:" : \LOG'IT
        LENTRY = "**********"
        \LOG'IT
RETURN

MAP1 MEA'UOM'FACTOR(3),F,6

PACK'HDR2:
        TIME'CSV = "PACK'HDR2: LIN'TRK'NO="+LIN'TRK'NO : \TIME'CSV
        LENTRY = "PACK'HDR2: LIN'TRK'NO="+LIN'TRK'NO+" OC2'TRK'NO="+ &
                  OC2'TRK'NO+" INC'USE'CV="+INC'USE'CV
        \LOG'IT

        IF INC'USE'CV = "Y" AND LIN'TRK'NO = OC2'TRK'NO RETURN  !!KLUDGE
        CALL FIND'MEA           !![63]Also does FIND'PRH, FIND'UOW

        IF INC'TS'SUBI = 4 THEN
            MEA'UOM'FACTOR(1) = 1
        ELSE
            MEA'UOM'FACTOR(1) = LIN'UOM'FACTOR(1)
        ENDIF
        MEA'UOM'FACTOR(2) = MEA'PC'PER'PKG
        MEA'UOM'FACTOR(3) = (MEA'PKG'PER'CS*MEA'PC'PER'PKG)
        IF MEA'UOM'FACTOR(3) # 0 AND MAX'BOX = 0 THEN
           PIECES'PER'CASE = MEA'UOM'FACTOR(3)
           CASE'FACTOR = MEA'UOM'FACTOR(3) * (MEA'CASE'TO'1 MAX 1)
           PIECES'PER'DOZEN = MEA'UOM'FACTOR(2)
        ELSE
           PIECES'PER'CASE = 0                             !![63]
           PIECES'PER'DOZEN = 0                            !![63]
           IF MAX'BOX = 0 THEN
               FOR II = 3 TO 1 STEP -1
                    IF MEA'UOM'FACTOR(II) > 12 THEN
                        PIECES'PER'CASE = MEA'UOM'FACTOR(II)
                        CASE'FACTOR = MEA'UOM'FACTOR(II) * (MEA'CASE'TO'1 MAX 1)
                    ENDIF
                    IF MEA'UOM'FACTOR(II) <= 12 AND MEA'UOM'FACTOR(II) > 1 THEN
                        PIECES'PER'DOZEN = MEA'UOM'FACTOR(II)
                    ENDIF
               NEXT II
            ENDIF
        ENDIF

        IF MEA'TREAT'CASE = "D" AND PIECES'PER'CASE = 0 THEN    !![63]
           PIECES'PER'CASE = PIECES'PER'DOZEN              !![63]
           PIECES'PER'DOZEN = 0                            !![63]
        ENDIF                                                   !![63]
        IF PIECES'PER'DOZEN = 1 THEN PIECES'PER'DOZEN = 0
        IF CARTON'LOOP = 2 THEN
           IF LIN'TEMP2 = "C" AND MAX'BOX # 0 THEN
               PIECES'PER'CASE = MAX'BOX'CS1
               PIECES'PER'DOZEN = 1
               CASE'FACTOR = MAX'BOX'CS1
           ELSE
               PIECES'PER'CASE = 1
               PIECES'PER'DOZEN = 1
               CASE'FACTOR = 1
           ENDIF
        ENDIF
        SUB'II = 0
        DO WHILE SUB'II < 6
            SUB'II = SUB'II + 1
            IF MAX'BOX # 0 THEN
                IF CARTON'LOOP # 2 AND LIN'TCOM'QTY(SUB'II) # 0 THEN
!!pieces portion ONLY has this
                    WKEY = (LIN'NO USING "#ZZZ") + SUB'II
                    XCALL VICSIT,7,3,WREC,WKEY,WPTR,0,WCTL    !!use
                    IF WCTL = 0 THEN
                        LIN'TCOM'QTY(SUB'II) = LIN'TCOM'QTY(SUB'II) - WPQTY
!!WPQTY
                    ENDIF
                ENDIF
            ENDIF
            IF LIN'TCOM'QTY(SUB'II) # 0 THEN
                SUB'KNO = SUB'II
                CALL SET'SUB'REC
                CALL PACK'HDR3
            ENDIF
        LOOP
        LENTRY = "PACK'HDR2: END" : \LOG'IT
        TIME'CSV = "PACK'HDR2: END" : \TIME'CSV
RETURN

MAP1 SAVE'PPC,B,5
MAP1 PQTY,B,5

PACK'HDR3:
        TIME'CSV = "PACK'HDR3: LIN'NO="+" SUB'NO="+SUB'NO : \TIME'CSV
        LENTRY = "PACK'HDR3: LIN'NO="+" SUB'NO="+SUB'NO : \LOG'IT
        IF SUB'NO < 1 OR SUB'NO > 6 THEN
                ENTRY = "Cannot pack properly - illegal SUB: "
                \KERROR SUB
                GOTO DO'ERRL                    !!KLUDGE
        ENDIF
        PQTY = SUB'COM'QTY
        IF CASE'FACTOR # PIECES'PER'CASE AND PQTY > CASE'FACTOR AND &
                                                    CARTON'LOOP = 1 THEN
            SAVE'PPC = PIECES'PER'CASE
            PIECES'PER'CASE = CASE'FACTOR
            CALL PACK'HDR3'2
            PQTY = PQTY - (ABS(FIX(PQTY/PIECES'PER'CASE))*PIECES'PER'CASE)
            PIECES'PER'CASE = SAVE'PPC
        ENDIF
        CALL PACK'HDR3'2
RETURN

PACK'HDR3'2:
    TIME'CSV = "PACK'HDR3'2: LIN'NO="+" SUB'NO="+SUB'NO : \TIME'CSV
    LENTRY = "PACK'HDR3'2: LIN'NO="+" SUB'NO="+SUB'NO : \LOG'IT
TST'MEA'PACK'HDR3'2:
    TIME'CSV = "TST'MEA'PACK'HDR3'2:" : \TIME'CSV
    IF PIECES'PER'CASE # 0 THEN
        IF MEA'TREAT'CASE = "N" THEN
TST'MTC'CARTONS'ZERO:
            TIME'CSV = "TST'MTC'CARTONS'ZERO:" : \TIME'CSV
            CARTONS = 0
        ELSE
TST'CALCULATE'CARTONS:
            TIME'CSV = "TST'CALCULATON'CARTONS:" : \TIME'CSV
            CARTONS = ABS(FIX(PQTY/PIECES'PER'CASE))
        ENDIF
    ELSE
TST'PPC'ZERO:
        TIME'CSV = "TST'PPC'ZERO:" : \TIME'CSV
        CARTONS = 0
    ENDIF
    ENTRY = "PIECES="+PIECES'PER'CASE+" MEA="+MEA'TREAT'CASE+" CARTON'LOOP="+CARTON'LOOP+" CARTONS="+CARTONS+" BNO="+BNO+&
            " TBC="+TBOX'COUNT+" PQ="+PQTY+" CF="+CASE'FACTOR+ &
            " LIN="+(LIN'NO USING "#ZZZ")
    CALL LOGIT

    IF CARTON'LOOP # 0 THEN
        IF CARTONS # 0 THEN
            CALL PACK'HDR'CARTONS
        ENDIF
    ELSE
        CALL PACK'HDR'DZ'PIECES
    ENDIF
    TIME'CSV = "PACK'HDR3'2: LIN'NO="+" SUB'NO="+SUB'NO+" END"
    \TIME'CSV
RETURN

MAP1 TMP'WGT,B,5
MAP1 TMP'WGT'ONE,B,5    !!Weight of one piece for the first size with order quantity
MAP1 OO,F

PACK'HDR'CARTONS:
        TIME'CSV = "PACK'HDR'CARTONS:" : \TIME'CSV
        LENTRY = "PACK'HDR'CARTONS:"
        \LOG'IT
        UOW'KNO = MEA'UOW'NO

        CALL FIND'UOW
        TMP'WGT = (MEA'WGT(SUB'NO) * ABS(PIECES'PER'CASE) * &
                                UOW'DUNITS * UOW2'NUNITS)  &
                                /((UOW'NUNITS*UOW2'DUNITS) &
                                MAX 1)
        ENTRY = "TMP WGT="+TMP'WGT+" PRH="+PRH'INVENTORY+" PPC="+PIECES'PER'CASE
        CALL LOGIT
        IF TMP'WGT = 0 AND PRH'INVENTORY # "N" THEN
            ENTRY = "1:Weight zero: "+MEA'TRK'NO+"-"+SUB'NO+" aborting! ("+MEA'WGT(SUB'NO)+"-"+PIECES'PER'CASE+"-"+UOW'DUNITS+"-"+UOW2'NUNITS+")"
            CALL DO'ERR'OEPACKL
            GOTO DEAD'ABORT
        ENDIF
!!max'ups = 65 and some paints are 71 lbs
!!         box wgt      65lbs          wgt 1 thing  65lbs
        IF BCWEIGHT <= INC2'MAX'UPS OR TMP'WGT >= INC2'MAX'UPS &
                                    OR CARTON'LOOP = 2 THEN
            BOXES = 1
        ELSE
            BOXES = 2       !!Too heavy, make 2 cases out of 1
        ENDIF

        MAP1 DIM'WGT,B,2
        MAP1 OVS'QT1,B,4
        MAP1 OVS'QT2,B,4
        MAP1 OVS'QT3,B,4
        CASE
        IF VIA'DIM'YN = "O" OR VIA'DIM'YN = "B" THEN
          DIM'WGT = 0
          IF UPC'RCN # 0 THEN
              IF MEA'DIM'WGT # 0 THEN
                  VBX'KNO = MEA'DIM'WGT
                  \VUSE VBX
              ENDIF
              IF VBX'CTL = 0 THEN
                  OVS'QT1 = VBX'OVSBOX'QT1
                  OVS'QT2 = VBX'OVSBOX'QT2
                  OVS'QT3 = VBX'OVSBOX'QT3
              ELSE
                  OVS'QT1 = UPC'OVSBOX'QT2
                  OVS'QT2 = UPC'OVSBOX'QT2
                  OVS'QT3 = UPC'OVSBOX'QT3
              ENDIF
              IF OVS'QT1 = 0 THEN OVS'QT1 = -1        !!High values
              IF OVS'QT2 = 0 THEN OVS'QT2 = -1        !!High values
              IF OVS'QT3 = 0 THEN OVS'QT3 = -1        !!High values
              OVS'QT1 = -1
              OVS'QT2 = -1
              OVS'QT3 = -1
          ENDIF
        ELSE
        IF VIA'DIM'YN = "Y" OR VIA'DIM'YN = "B" THEN
          OVS'QT1 = -1
          OVS'QT2 = -1
          OVS'QT3 = -1
          IF UPC'STDBOX'VAR = "Y" THEN
                VBX'CTL = 1
                IF MEA'DIM'WGT # 0 THEN
                    VBX'KNO = MEA'DIM'WGT
                    \VUSE VBX
                ENDIF
                IF VBX'CTL = 0 THEN
                    DIM'WGT = VBX'DIM'WGT
                ELSE
                    DIM'WGT = UPC'DIM'WGT
                ENDIF
          ELSE
                DIM'WGT = MEA'DIM'WGT
          ENDIF
          ENTRY = "PACK'HDR'CARTONS: "+DIM'WGT+" CTL="+VBX'CTL+" MEA="+MEA'DIM'WGT
          CALL LOGIT
        ELSE
          OVS'QT1 = -1
          OVS'QT2 = -1
          OVS'QT3 = -1
          DIM'WGT = 0
        ENDCASE

        FOR II = 1 TO CARTONS           !!Add BOX/BXL for each
                BREC'SPACE = SPACE
                BCWEIGHT = TMP'WGT
                ENTRY = "BCWEIGHT="+BCWEIGHT
                CALL LOGIT

!!              BCMAX = INC2'MAX'UPS        !!Not used on cases
                TBOX'COUNT = TBOX'COUNT + 1
                BNO = TBOX'COUNT
                BTYPE = "B"
                BCWEIGHT = BCWEIGHT/BOXES
                BCASE = "Y"                     !!It is a case
                IF BCWEIGHT < (DIM'WGT*100) THEN
                    BSWGT = DIM'WGT
                    BDIMENSION = "Y"
                    ENTRY = "CARTONS SET DIM WGT TO: "+(BSWGT*100)
                    CALL LOGIT
                ELSE
                    ENTRY = "CARTONS DID NOT SET DIM WGT,ACTUAL IS: "+BCWEIGHT
                    CALL LOGIT
                ENDIF
                CALL GET'FREEBE
                IF FREEBE = "Y" THEN
                    BFWEIGHT = BFWEIGHT + TMP'WGT                                           !![66]
                ENDIF                                                                           !![66]
                ENTRY = "FREEBE="+FREEBE+" BFWEIGHT="+BFWEIGHT
                CALL LOGIT
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "FREEBE="+FREEBE+" BFWEIGHT="+BFWEIGHT
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
                BXL'QTY = PIECES'PER'CASE/BOXES
                IF BXL'QTY >= OVS'QT1 THEN
                    BOVERSIZ1 = "Y"
                ENDIF
                SAV'ENTRY = ENTRY
                ENTRY = "CARTONS SET OVERSIZ1 TO: "+BOVERSIZ1+" BXL'QTY="+BXL'QTY+" OVS'QT1="+OVS'QT1
                CALL LOGIT
                ENTRY = SAV'ENTRY

                IF BXL'QTY >= OVS'QT2 THEN
                    BOVERSIZ2 = "Y"
                ENDIF
                SAV'ENTRY = ENTRY
                ENTRY = "CARTONS SET OVERSIZ2 TO: "+BOVERSIZ2+" BXL'QTY="+BXL'QTY+" OVS'QT2="+OVS'QT2
                CALL LOGIT
                ENTRY = SAV'ENTRY

                IF BXL'QTY >= OVS'QT3 THEN
                    BOVERSIZ3 = "Y"
                ENDIF
                SAV'ENTRY = ENTRY
                ENTRY = "CARTONS SET OVERSIZ3 TO: "+BOVERSIZ3+" BXL'QTY="+BXL'QTY+" OVS'QT3="+OVS'QT3
                CALL LOGIT
                ENTRY = SAV'ENTRY

                CASE
                IF BOVERSIZ3 = "Y" THEN
                    BOVERSIZ2 = ""
                    BOVERSIZ1 = ""
                ELSE
                IF BOVERSIZ2 = "Y" THEN
                    BOVERSIZ1 = ""
                    BOVERSIZ3 = ""
                ENDCASE
                CALL ADD'BREC
                CALL ADD'XREC    !!Calls UPDATE'WREC:
               IF BOXES = 2 THEN
                    TBOX'COUNT = TBOX'COUNT + 1
                    BNO = TBOX'COUNT

                    CALL ADD'BREC
                    CALL ADD'XREC
               ENDIF
        NEXT II

    TIME'CSV = "PACK'HDR'CARTONS: END"
    \TIME'CSV
RETURN

PACK'HDR'DZ'PIECES:
        TIME'CSV = "PACK'HDR'DZ'PIECES:" : \TIME'CSV
        LENTRY = "PACK'HDR'DZ'PIECES:" : \LOG'IT
![1] Pieces'per'dozen replaced /12 in below 2 lines
        IF PIECES'PER'DOZEN # 0 THEN
             DOZENS = FIX((ABS(SUB'COM'QTY) - &
                 (CARTONS*ABS(PIECES'PER'CASE)))/PIECES'PER'DOZEN)
        ELSE
             DOZENS = 0
        ENDIF
        PIECES = ABS(SUB'COM'QTY) - (CARTONS*ABS(PIECES'PER'CASE)) - &
                                            (DOZENS*PIECES'PER'DOZEN)
        IF MAX'BOX = 0 AND DOZENS # 0 THEN
            UOM'CNT = DOZENS
            UOM'FACTOR = PIECES'PER'DOZEN
            CALL ADD'DZ'PIECES              !!e.g. pack 3 dozens
        ENDIF
        IF PIECES # 0 THEN
            UOM'CNT = PIECES
            UOM'FACTOR = 1
            CALL ADD'DZ'PIECES              !!e.g. pack 8 pieces
        ENDIF
        TIME'CSV = "PACK'HDR'DZ'PIECES: END"
        \TIME'CSV
RETURN

MAP1 WRK'WGT,B,5

FIND'MEA:        !!Gets UOW and PKG and MEA
        TIME'CSV = "FIND'MEA: LIN'TRK'NO="+LIN'TRK'NO : \TIME'CSV

        CTC = CTC MAX START'CTC
        CALL FIND'PRH
        IF PRH'TRK'NO # LIN'TRK'NO OR &
                            PRH'PRC'TRK'NO = 0 OR PRH'WGTS'BY # "Y" THEN
            MEA'KTRK'NO = LIN'TRK'NO
        ELSE
TST'PRH'PRC'TRK'NO:
            TIME'CSV = "TST'PRH'PRC'TRK'NO: LIN'TRK'NO="+LIN'TRK'NO : \TIME'CSV
            MEA'KTRK'NO = PRH'PRC'TRK'NO
        ENDIF
        MEA'KUOM'NO = LIN'UOM'NO
        \VUSE MEA
        IF MEA'CTL = 0 THEN
            \COPYF PKG WL
            MAP1 PKGPTR,X,30
            PKG'KTRK'NO = MEA'TRK'NO        !!Packaging not by size (could be)
            \VUSE PKG
            IF PKG'CTL # 0 THEN
                PKG'SPACE = SPACE
            ENDIF
        ENDIF
CIF USE'KITS AND USE'KITS = "Y" THEN
        IF MEA'CTL # 0 AND (PRH'KTD'FLAG = "B" OR PRH'KTD'FLAG = "O" OR &
                                                    PRH'KTD'FLAG = "P") THEN
            IF LIN'KTD'TRK'NO # 0 THEN
                \VUSEPRH LIN'KTD'TRK'NO
                KTD'CTL = 0
            ELSE
                KTD'KPRH'TRK'NO = LIN'TRK'NO
                KTD'KPRH'ATT1 = 0
                KTD'KPRH'ATT2 = 0
                KTD'KSEQ = 0
                USE KTD INTO KTD'REC KEY KTD'KEY
                DO
                    GETNXT KTD INTO KTD'REC
                    \CHKKEY KTD APID="IN"
                    IF KTD'CTL # 0 EXIT
                LOOP UNTIL KTD'REPLACE = "Y" OR KTD'REPLACE = "F"
                IF KTD'CTL = 0 THEN
                    \VUSEPRH KTD'TRK'NO
                ENDIF
            ENDIF
            IF PRH'CTL = 0 AND KTD'CTL = 0 THEN
                IF PRH'PRC'TRK'NO = 0 OR PRH'WGTS'BY # "Y" THEN
                    MEA'KTRK'NO = PRH'TRK'NO
                ELSE
                    MEA'KTRK'NO = PRH'PRC'TRK'NO
                ENDIF
                MEA'KUOM'NO = LIN'UOM'NO
                \VUSE MEA
            ENDIF
        ENDIF
ENDCIF
        IF MEA'CTL # 0 THEN
            IF PRH'INVENTORY # "N" THEN
TST'PRH'INVENTORY:
                TIME'CSV = "TST'PRH'INVENTORY:" : \TIME'CSV
                ENTRY = "Weights not found - aborting: "
                \KERROR MEA APID="IN" MODE="K"
                ENTRY = ENTRY + " PRH="+PRH'TRK'NO
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
            ELSE
TST'MEA'TRK'UOM'UOW:
                TIME'CSV = "TST'MEA'TRK'UOM'UOW: MEA not found" : \TIME'CSV
                MEA'SPACE = SPACE
                MEA'CTL = 0
                MEA'TRK'NO = LIN'TRK'NO
                MEA'UOM'NO = LIN'UOM'NO
                MEA'UOW'NO = VIA'UOW'NO         !![24]
            ENDIF
        ENDIF

        UOW'KNO = MEA'UOW'NO

        CALL FIND'UOW

        IF DO'STRAP # "N" THEN
            MEA'CASE'TO'1 = MEA'CASE'TO'1 MAX 1
        ELSE
            MEA'CASE'TO'1 = 1
        ENDIF
        CASE'TO'1 = MEA'CASE'TO'1
        MAX'BOX'CS = 0
        MAX'BOX'CS1 = 0
        IF MAX'BOX # 0 OR ALL'CASES'TEST # 0 THEN
            CTC = CTC MAX START'CTC

            IF CTC # 2 AND ALL'CASES'TEST = 0 THEN
                MEA'PC'PER'PKG = 0
                MEA'PKG'PER'CS = 0
                MEA'PPC = 0
            ELSE
TST'SET'MAX'BOX'CS1:
                TIME'CSV = "TST'SET'MAX'BOX'CS1: CTC="+CTC+" ALL'CASES'TEST="+ALL'CASES'TEST
                \TIME'CSV
                CALL SET'MAX'BOX'CS
            ENDIF
        ENDIF
RETURN

SET'MAX'BOX'CS:
    TIME'CSV = "SET'MAX'BOX'CS: LIN'NO="+LIN'NO+" CTC="+CTC : \TIME'CSV

    MAP1 MAX'BOX'CS,B,2  !!How many in case including strapping
    MAP1 MAX'BOX'CS1,B,2 !!How many in one actual case unstrapped
    MAP1 CASE'TO'1,B,2
    MAP1 W'W,F
    MAP1 MULTIPLIER,B,1

    IF (START'CTC = 0 AND MANY'BOXES'CASES = 0 AND ALL'CASES # "Y") OR &
                                                        NEVER'CASES = 1 THEN
TST'MEA'SET'MAX'BOX'CS:
        TIME'CSV = "TST'MEA'SET'MAX'BOX'CS:" : \TIME'CSV
        MEA'PC'PER'PKG = 0
        MEA'PKG'PER'CS = 0
!! Test LINKEY record are cases,heavy, and packaged items
!! Do not override MEA'TREAT'CASE flag
        IF INSTR(1,LINKEY,"C") = 0 THEN
            MEA'TREAT'CASE = "N"
        ENDIF
        MEA'PPC = 0
        MEA'CASE'TO'1 = 0
        MAX'BOX'CS1 = 0
        MAX'BOX'CS = 0
    ELSE
        IF AUTO'STRAP = "Y" THEN
            IF DO'STRAP = "N" THEN
                MULTIPLIER = 1
            ELSE
                MULTIPLIER = 2
            ENDIF
        ELSE
            MULTIPLIER = 1
        ENDIF
        IF AUTO'STRAP = "Y" AND MEA'CASE'TO'1 = 1 AND &
                                                    PKG'CASE'LEN = 0 THEN
            UOW2'KNO = VIA'UOW'NO
            CALL FIND'UOW2
            CASE'TO'1 = MULTIPLIER      !!2 X WEIGHT  < max weight
            FOR W'W = 1 TO 6
                WRK'WGT = (MEA'WGT(W'W) * UOW'DUNITS * UOW2'NUNITS)  &
                                                /((UOW'NUNITS*UOW2'DUNITS) &
                                                MAX 1) * MULTIPLIER
                MAX'BOX'CS1 = (MEA'PC'PER'PKG MAX 1) * (MEA'PKG'PER'CS MAX 1)
                MAX'BOX'CS = MAX'BOX'CS1 * (MULTIPLIER MAX 1)
                WRK'WGT = WRK'WGT * MAX'BOX'CS
                WRK'WGT = INT((WRK'WGT+99)/100)*100
                IF WRK'WGT >= INC2'MAX'UPS THEN
                    CASE'TO'1 = 1
                    W'W = 7
                ENDIF
            NEXT W'W
        ELSE
            IF DO'STRAP # "N" THEN
                CASE'TO'1 = MEA'CASE'TO'1 MAX 1
            ELSE
                CASE'TO'1 = 1
            ENDIF
        ENDIF
        MEA'CASE'TO'1 = CASE'TO'1
        MAX'BOX'CS1 = (MEA'PC'PER'PKG MAX 1) * (MEA'PKG'PER'CS MAX 1)
        MAX'BOX'CS = MAX'BOX'CS1 * (CASE'TO'1 MAX 1)
    ENDIF
    TIME'CSV = "End SET'MAX'BOX'CS: MAX'BOX'CS="+MAX'BOX'CS+ &
              " MEA'CASE'TO'1="+MEA'CASE'TO'1+" LIN'NO="+LIN'NO
    \TIME'CSV
RETURN

FIND'PRH:
        TIME'CSV = "FIND'PRH: LIN'TRK'NO="+LIN'TRK'NO : \TIME'CSV
        \VUSEPRH
        IF PRH'CTL # 0 THEN
                ENTRY  = "Part not found on line "+HDR'LOC'NO+"-"+HDR'DOC'TYPE+"-"+HDR'NO+"-"+LIN'NO+" TRK="+LIN'TRK'NO+" Not found!"
                TIME'CSV = "FIND'PRH: "+ENTRY
                \TIME'CSV
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
        ENDIF
        MAX'CNT = 1                             !!Current MAX weight
        FOR OO = 10 TO 1 STEP -1
                IF PRH'ITP'NO <= INC'ITP'NO(OO) THEN MAX'CNT = OO
        NEXT OO
RETURN

SET'SUB'REC:
        TIME'CSV = "SET'SUB'REC:" : \TIME'CSV
        SUB'SPACE = SPACE
        SUB'DOC'TYPE = LIN'DOC'TYPE
        SUB'HDR'LOC'NO = LIN'HDR'LOC'NO
        SUB'HDR'NO = LIN'HDR'NO
        SUB'LIN'NO = LIN'NO
        \SETSUB
RETURN

MAP1 ERR'HDR'NO,B,3

FIND'STX:               !!FIX TO CACHE
        TIME'CSV = "FIND'STX:" : \TIME'CSV
        IF STX'NO # STX'KNO OR SAVSTX'LOC'NO # STX'KLOC'NO OR STX'CTL # 0 THEN
            SAVSTX'LOC'NO = STX'KLOC'NO
            USE STX INTO STX'REC KEY STX'KEY
            IF STX'CTL # 0 THEN
                STX'KLOC'NO = 0
                USE STX INTO STX'REC KEY STX'KEY
            ENDIF
        ENDIF
        IF STX'CTL = 0 CALL COMPUTE'TTL'STX'PERC
RETURN

MAP1 III,F

MAP1 DO'CALL'TAG,S,1,"N"

FIND'VIA:
        TIME'CSV = "FIND'VIA: HDR'NAM'NO="+HDR'NAM'NO+" VIA'KNO="+VIA'KNO
        \TIME'CSV
        IF VIA'CUS'NO # HDR'NAM'NO OR VIA'NO'NO # VIA'KNO THEN
            VIA'SPACE = SPACE !![25]FORCE READ
            VIA'CUS'NO = HDR'NAM'NO
            VIA'NO'NO = VIA'KNO
        ENDIF
        CALL GET'VIA
        IF VIA'CTL # 0 THEN
            ENTRY = "Warning - ship via not found: "+VIA'KNO
            CALL DO'ERR'OEPACK
        ENDIF
CIF USE'VAT AND USE'VAT = "Y" THEN
        \COPYF VAT IN
        IF USE'VAT = "Y" AND VIA'NO = HDR'VIA'NO THEN
            VAT'KVIA'NO = HDR'VIA'NO
            VAT'KLOC'NO = HDR'LOC'NO
            VAT'KSTART'ZIP = HDR'SHP'ZIP
            USE VAT INTO VAT'REC KEY VAT'KEY
            IF VAT'CTL # 0 THEN
                GETPRV VAT INTO VAT'REC
            ENDIF
            \CHKKEY VAT APID="IN"
            IF HDR'SHP'ZIP > VAT'END'ZIP OR VAT'CTL # 0 THEN
                VAT'KLOC'NO = 0
                USE VAT INTO VAT'REC KEY VAT'KEY
                IF VAT'CTL # 0 GETPRV VAT INTO VAT'REC
                \CHKKEY VAT APID="IN"
            ENDIF
            IF VAT'CTL = 0 AND HDR'SHP'ZIP <= VAT'END'ZIP THEN
                IF VAT'NVIA'NO # 0 THEN
                    HDR'VIA'NO = VAT'NVIA'NO
                    VIA'KNO = HDR'VIA'NO
                    CALL GET'VIA
                    IF VIA'CTL # 0 THEN
                        ENTRY = "Warning - ship via not found: "+VIA'KNO+" VAT="
                        \KERROR VAT MODE="D" CNO="N"
                        CALL DO'ERR'OEPACK
                    ENDIF
                ENDIF

                IF VAT'NBVIA'NO # 0 THEN
                    HDR'BVIA'NO = VAT'NBVIA'NO
                ELSE
                    IF VIA'CVIA'NO # 0 THEN
                        HDR'BVIA'NO = VIA'CVIA'NO
                    ELSE
                        HDR'BVIA'NO = HDR'VIA'NO
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
ENDCIF
!       IF CUS'FFP'NO # 0 THEN
!           FFP'KNO = CUS'FFP'NO
!           \VUSE FFP
!           IF FFP'CTL # 0 THEN FFP'SPACE = SPACE
!       ENDIF
        \TSTBIT HDR'BIT'FLAG 32 VAR="SF"
        IF SF = 0 OR WBWHAP # 0 THEN              !!Not manually set
            SF = 0
            IF IN2'SUV = "Y" THEN                !! Additive free freight
                IF HDR'CRID = "WBWHAP" THEN
                    IF WBC'FFP'NO # 0 THEN
                        IF CUS'FFP'NO # 0 THEN
                            FFP'KNO = CUS'FFP'NO
                            \VUSE FFP
                            IF FFP'CTL = 0 THEN
                                IF FFP'CUS'OVER = "Y" THEN
                                    FFP'KNO = CUS'FFP'NO
                                ELSE
                                    FFP'KNO = WBC'FFP'NO
                                ENDIF
                            ELSE
                                FFP'KNO = WBC'FFP'NO
                            ENDIF
                        ELSE
                            FFP'KNO = WBC'FFP'NO
                        ENDIF
                    ELSE
                        IF CUS'FFP'NO # 0 THEN
                            FFP'KNO = CUS'FFP'NO
                        ENDIF
                    ENDIF
                ELSE
                    IF CUS'FFP'NO # 0 THEN
                        FFP'KNO = CUS'FFP'NO
                    ENDIF
                ENDIF
            ELSE
                IF CUS'FFP'NO # 0 THEN
                    FFP'KNO = CUS'FFP'NO
                ENDIF
            ENDIF
            HDR'FFP'NO = FFP'KNO
            \VUSE FFP
            CALL PRE'DSP'FFP'DESC2
        ELSE
            FFP'KNO = HDR'FFP'NO
            \VUSE FFP
        ENDIF
        IF FFP'CTL # 0 THEN FFP'SPACE = SPACE
        FOR III = 1 TO INC'MAX'VIA
            ENTRY = "FFP="+FFP'SHIP'TABLE(III)+" HDR="+HDR'LOC'NO+" ORG="+HDR'ORG'LOC
            CALL LOGIT
            IF FFP'SHIP'TABLE(III) = "P" AND HDR'LOC'NO # HDR'ORG'LOC THEN
!!P=Charge at Originating location, no charge on split
                VIA'TBL'NO(III) = 0
            ELSE
                IF FFP'SHIP'TABLE(III) = "O" AND HDR'LOC'NO = HDR'ORG'LOC THEN
!!O=Free at Originating location, charge on split location
                        VIA'TBL'NO(III) = 0
                ELSE
                    IF FFP'SHIP'TABLE(III) = "Z" THEN
!!Z=Do not charge this charge
                        VIA'TBL'NO(III) = 0
                    ELSE
                        IF VIA'CHG'OPT(III) => 1 AND VIA'CHG'OPT(III) <= 5 THEN
                            IF CUS'FCHG'YN(VIA'CHG'OPT(III)) = "N"  OR  CUS'FCHG'YN(VIA'CHG'OPT(III)) = "O" THEN
                                VIA'TBL'NO(III) = 0
                                DO'CALL'TAG = "N"
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        NEXT III
        IF WBWHAP # 0 THEN
            DO'CALL'TAG = "N"
        ENDIF
        IF DO'CALL'TAG # "F" THEN       !![55] - all this, set if not done
                                        !!could change whenever via changes
                DO'CALL'TAG = "N"
!![66] Note the line below was commented as [66] but I did not make the change during [66]. MCT 3/31/99.
                IF ARC'INV'CR'YN(HDR'DOC'TYPE) = "Y" AND HDR'ACTION = "E" THEN !![66]
                        IF OEC'MAN'YN = "Y"                     AND &
                                        VIA'NO = HDR'VIA'NO     AND &
                                        VIA'MAN'YN # "N"        AND &
                                        VIA'MAN'YN # "O"        AND &
                                        NO'CALL'TAGS # "N" THEN
                        DO'CALL'TAG = "Y"
                    ELSE
                        DO'CALL'TAG = "S"
                    ENDIF
                ENDIF
        ENDIF
RETURN

FIND'LOC:
        TIME'CSV = "FIND'LOC:" : \TIME'CSV
        \VUSE LOC VPTR="LOCPTR"
        IF LOC'CTL # 0 THEN
                ENTRY = "Location not found - aborting: "+LOC'KNO
                TIME'CSV = "FIND'LOC: "+ ENTRY : \TIME'CSV
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
        ENDIF
RETURN

FIND'FOB:
        TIME'CSV = "FIND'FOB:" : \TIME'CSV
        CASE
        IF HDR'FOB'NO > 2 THEN
                IF FOB'NO # HDR'FOB'NO THEN
                        FOB'KNO = HDR'FOB'NO
                        USE FOB INTO FOB'REC KEY FOB'KEY
                        IF FOB'CTL # 0 THEN FOB'NAM'PERC = 10000
                ENDIF
        ELSE
        IF HDR'FOB'NO = 2 THEN
                FOB'NAM'PERC = 0
        ELSE
                FOB'NAM'PERC = 10000
        ENDCASE
RETURN


FIND'UOW:
        TIME'CSV = "FIND'UOW:" : \TIME'CSV
        \VUSE UOW
        IF UOW'CTL # 0 THEN
            ENTRY = "Warning - measurements weight conversion not found: "+UOW'KNO
            TIME'CSV = "FIND'UOW: " + ENTRY : \TIME'CSV
            CALL DO'ERR'OEPACK
        ENDIF
RETURN

FIND'UOW2:
        TIME'CSV = "FIND'UOW2:" : \TIME'CSV
        \VUSE UOW2 VPTR="UOWPTR"
        IF UOW2'CTL # 0 THEN
            ENTRY = "Warning - ship via weight conversion not found: "+UOW2'KNO
            TIME'CSV = "FIND'UOW2: " + ENTRY : \TIME'CSV
            CALL DO'ERR'OEPACK
        ENDIF
RETURN

MAP1 SBKEY,S,9

TOTAL'HDR'FROM'BREC:
        TIME'CSV = "TOTAL'HDR'FROM'BREC:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 THEN
                CALL CLEAR'HDR'TOTALS
                RETURN                                  !!KLUDGE
        ENDIF
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Totaling order for " + VIA'DESC
            CALL TCOUNT'START
        ENDIF
        IF MUST'WRITE'BRECS = 1 THEN
          CALL CLEAR'HDR'TOTALS
          ZONE'REC = BZONE'REC
          BKEY = "B" + (BVIA'NO USING "#ZZZ")
          SBKEY = BKEY
          DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                IF BKEY[1;5] # SBKEY EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                CALL SUM'HDR'TOTALS
          LOOP
        ENDIF
        CALL SET'BY'ORDER'FREIGHT               !![28]
RETURN

SET'BY'ORDER'FREIGHT:                           !![28]
    TIME'CSV = "SET'BY'ORDER'FREIGHT:" : \TIME'CSV
    IF WORK'MODE = "B" THEN
        HDR'VIA'SUM(1) = 0
        FOR JJ = 1 TO 7
            IF ZONE'BOX'ORDER(JJ) = "O" THEN
                HDR'VIA'SUM(1) = HDR'VIA'SUM(1) + PSEUDO'VTTL(JJ)
            ENDIF
        NEXT JJ
    ENDIF
RETURN

MAP1 BOX'BAD,B,1
MAP1 OLD'MODE,S,1

DUMP'BOX'AND'TOTAL'HDR:
        TIME'CSV = "DUMP'BOX'AND'TOTAL'HDR:" : \TIME'CSV
        OLD'MODE = WORK'MODE
        CALL DUMP'BOX'AND'TOTAL'HDR2
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "OLD MODE="+OLD'MODE+" WORK MODE="+WORK'MODE
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        IF OLD'MODE # WORK'MODE THEN
            IF OLD'MODE = "A" THEN
                CALL SET'ACTUAL'MODE
            ELSE
                CALL SET'BILLING'MODE
            ENDIF
        ENDIF
RETURN

DUMP'BOX'AND'TOTAL'HDR2:
        TIME'CSV = "DUMP'BOX'AND'TOTAL'HDR2:" : \TIME'CSV
        BOX'BAD = 0
        IF VIA'SHP'FLAG <= 1 THEN
            CALL CLEAR'HDR'TOTALS
            RETURN                          !!KLUDGE
        ENDIF
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Writing out box records"
            CALL TCOUNT'START
        ENDIF
        IF MUST'WRITE'BRECS = 1 THEN
!!First write out all of the 'B' BOX records
          IF DO'EXCUSE = 1 THEN
              SAV'ENTRY = ENTRY
              ENTRY = "6: SET BILLING MODE"
              CALL DO'EXCUSE'LOG
              ENTRY = SAV'ENTRY
          ENDIF
          CALL SET'BILLING'MODE
          CALL CLEAR'HDR'TOTALS
          CALL ONE'COD'PER'ORDER

          BTYPE = "B"
          BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
          SBKEY = BKEY
          DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                IF BKEY[1;5] # SBKEY EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF

                CALL FILL'BOX'FROM'BREC        !!Write BOX
                CALL SUM'HDR'TOTALS
          LOOP

          CALL SET'BY'ORDER'FREIGHT             !![28]
          CALL UPDATE'HDR
        ENDIF
        CNT = 0
!!if there are more 'A' records than 'B' records.
        IF WE'HAVE'ARECS = 1 THEN
!         ZONE'REC = AZONE'REC
          CALL SET'ACTUAL'MODE
          CALL ONE'COD'PER'ORDER
          CNT = 0
          BTYPE = "A"
          BKEY = "A" + (HDR'VIA'NO USING "#ZZZ")
          SBKEY = BKEY
          DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                IF BKEY[1;5] # SBKEY EXIT
                IF BCWEIGHT = 0 EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                CNT = CNT + 1
                CALL FILL'BOX'FROM'BREC
          LOOP
          IF CNT = 0 THEN
              BOX'BAD = 1
          ENDIF
          IF CNT < HDR'BOX'COUNT THEN
!!We need to save the zero records for re-packing
                ENTRY = "CNT < HDR'BOX'COUNT: "+CNT+"<"+HDR'BOX'COUNT+" ON:"
                \HDRERR
                CALL DO'ERRLO
                FOR QQ = (CNT+1) TO HDR'BOX'COUNT
                        BREC'SPACE = SPACE
                        BNO = QQ
                        BTYPE = "A"
                        CALL FILL'BOX'FROM'BREC         !!To disk
                NEXT QQ
                CNT = HDR'BOX'COUNT
          ENDIF
          \SETBIT HDR'MAN'FLAG 64                       !!Actual BOX on disk
        ENDIF
        MAP1 B'CNT,B,2
        B'CNT = HDR'BOX'COUNT MAX CNT !!Every added 'A' = 'BXV' made sure there
                                !!was a 'B' = 'BOX' record for it, so adjust
                                !!the count ...
        IF MUST'WRITE'BRECS = 1 THEN
                BOX'KHDR'LOC'NO = HDR'LOC'NO
                BOX'KDOC'TYPE = HDR'DOC'TYPE
                BOX'KHDR'NO = HDR'NO
                BOX'KNO = B'CNT + 1
                BOX'KSHIPMENT = HDR'SHIPMENT + 1
                CALL DELETE'REMAINING'BOXES
        ENDIF
        IF WE'HAVE'ARECS = 1 THEN
                IF INC'AUTOPACK = "Y" THEN
                        XKEY = ""
                        DO
                                XCALL VICSIT,7,4,XREC,XKEY,XPTR,0,XCTL !!GETNXT
                                IF XCTL # 0 EXIT
                                IF XNO > CNT EXIT
                                CALL FILL'BXL'FROM'XREC
                        LOOP
                ENDIF
                BXV'KHDR'LOC'NO = HDR'LOC'NO
                BXV'KDOC'TYPE = HDR'DOC'TYPE
                BXV'KHDR'NO = HDR'NO
                BXV'KNO = CNT + 1
                BXV'KSHIPMENT = HDR'SHIPMENT + 1
                CALL DELETE'REMAINING'BXVES
        ENDIF
        CALL UPDATE'HDR
RETURN

MAP1 UOM'CNT,B,5                !!HOW MANY DOZENS OR PIECES
MAP1 UOM'FACTOR,B,5             !!1 FOR PIECES, 2-12 FOR DOZENS
MAP1 FORMER'WGT,B,5

ADD'DZ'PIECES:
        TIME'CSV = "ADD'DZ'PIECES:" : \TIME'CSV
        UOW'KNO = MEA'UOW'NO

        CALL FIND'UOW
        IF UOM'CNT # 0 THEN
                QQ = ((MEA'WGT(SUB'NO) * UOM'CNT * UOM'FACTOR * &
                                UOW'DUNITS * UOW2'NUNITS)       &
                                / ((UOW'NUNITS * UOW2'DUNITS)   &
                                MAX 1))
                IF QQ = 0 AND PRH'INVENTORY # "N" THEN
                        ENTRY = "2:Weight zero on "+MEA'TRK'NO+" size "+SUB'NO+" aborting! ("+MEA'WGT(SUB'NO)+"-"+UOM'CNT+"-"+UOM'FACTOR+"-"+UOW'DUNITS+"-"+UOW2'NUNITS+")"
                        CALL DO'ERR'OEPACKL
                        GOTO DEAD'ABORT
                ENDIF
                ENTRY=" PART="+PRH'PART+" TRK="+PRH'TRK'NO+"-"+MEA'TRK'NO+" TMP="+TMPVBX'NO+"     MEA="+MEA'DIM'WGT+" VIA="+VIA'DIM'YN+" QQ="+QQ
                CALL LOGIT
                ENTRY = "WGTS1="+MEA'WGT(1)+" 2="+MEA'WGT(2)+" 3="+MEA'WGT(3)+" 4="+MEA'WGT(4)+" 5="+MEA'WGT(5)+" 6="+MEA'WGT(6)
                CALL LOGIT
!!              IF MAX'BOX = 0 OR LIN'TEMP = "N" THEN
                IF MAX'BOX = 0 THEN
!!Remove XCALL later
                    XCALL GIN,"ADD'DZ'PIECES: MAX'BOX should never be zero - why am I here?"
                    IF (TMPVBX'NO # MEA'DIM'WGT OR TMPVBX'NO = 0) AND &
                             UPC'STDBOX'VAR = "Y" AND (VIA'DIM'YN = "Y" OR &
                                VIA'DIM'YN = "O" OR VIA'DIM'YN = "B") THEN
                      VBX'CTL = 1
                      IF MEA'DIM'WGT # 0 THEN
                        VBX'KNO = MEA'DIM'WGT
                        \VUSE VBX
                      ENDIF
                      ENTRY = "DZ'PIECES CTL="+VBX'CTL+" SIZ="+VBX'SIZ'WGT+" DIM="+VBX'DIM'WGT
                      CALL LOGIT
                      IF VBX'CTL = 0 THEN
                        IF VBX'SIZ'WGT = 0 THEN VBX'SIZ'WGT = VBX'DIM'WGT
                      ELSE
                        VBX'SPACE = SPACE
                      ENDIF
                      IF VBX'SIZ'WGT = 0 THEN
                          VBX'SIZ'WGT = UPC'DIM'WGT
                      ENDIF
                      ENTRY = "DZ'PIECES MAXDIM="+MAXDIM+" SIZ="+VBX'SIZ'WGT+" BNO="+BNO+" OVSBOX'QT1="+VBX'OVSBOX'QT1
                      CALL LOGIT
                      IF VIA'DIM'YN = "Y" OR VIA'DIM'YN = "B" THEN
                          IF VBX'SIZ'WGT >= MAXDIM THEN
                            IF VBX'NO # 0 OR VBX'SIZ'WGT > MAXDIM THEN
                                TMPVBX'NO = VBX'NO
                            ENDIF
                            MAXDIM = VBX'SIZ'WGT
                          ENDIF
                          ENTRY = "DZ'PIECES RESULT MAXDIM="+MAXDIM+" SIZ="+VBX'SIZ'WGT+" TMPVBX'NO="+TMPVBX'NO
                          CALL LOGIT
                      ELSE
                          IF VBX'OVSBOX'QT2 >= MAXDIM THEN
                            IF VBX'NO # 0 OR VBX'OVSBOX'QT2 > MAXDIM THEN
                                TMPVBX'NO = VBX'NO
                            ENDIF
                            MAXDIM = VBX'OVSBOX'QT2
                          ELSE
                          IF VBX'OVSBOX'QT1 >= MAXDIM THEN
                            IF VBX'NO # 0 OR VBX'OVSBOX'QT1 > MAXDIM THEN
                                TMPVBX'NO = VBX'NO
                            ENDIF
                            MAXDIM = VBX'OVSBOX'QT1
                          ENDIF
                          ENDIF
                          ENTRY = "DZ'PIECES RESULT MAXDIM="+MAXDIM+" TMPVBX'NO="+TMPVBX'NO
                          CALL LOGIT
                      ENDIF
                    ENDIF
                ENDIF
                IF USE'CASE'MAX = "Y" THEN
                    TMP'WGT = (MEA'WGT(SUB'NO) * ABS(PIECES'PER'CASE) * &
                                UOW'DUNITS * UOW2'NUNITS)  &
                                /((UOW'NUNITS*UOW2'DUNITS) &
                                MAX 1)
                    TMP'WGT = TMP'WGT * (MEA'CASE'TO'1 MAX 1)
                ELSE
                    TMP'WGT = INC2'WEIGHT(MAX'CNT)
                ENDIF
                IF ((((BCWEIGHT+QQ) < (MAX'WEIGHT*(1+(OC2'OVER'PERC/100))) AND &
                                                        MAX'WEIGHT # 0) OR &
                    ((BCWEIGHT+QQ) < TMP'WGT AND &
                                                       MAX'WEIGHT = 0)) AND &
                   (BCWEIGHT+QQ) <= INC2'MAX'UPS                AND &
                   ((BITEMS+(UOM'CNT*UOM'FACTOR)) <= VIA'MAX'QTY OR &
                                               VIA'MAX'QTY = 0)) AND &
                                               MAX'BOX = 0 THEN

!!We are in EASY WAY - NEVER DONE FOR ONESTOP (Location one)
!!We can do all at once because it is less than max weights
                        BCWEIGHT = BCWEIGHT+QQ
                        CALL GET'FREEBE
                        IF FREEBE = "Y" THEN
                            BFWEIGHT = BFWEIGHT + QQ                                                !![66]
                            IF DO'EXCUSE = 1 THEN
                                SAV'ENTRY = ENTRY
                                ENTRY = "FREEB="+FREEBE+" BF="+BFWEIGHT+" QQ="+QQ+" BC="+BCWEIGHT
                                CALL DO'EXCUSE'LOG
                                ENTRY = SAV'ENTRY
                            ENDIF
                        ENDIF                                                                           !![66]
                        BCMAX = MAX'WEIGHT
                        BCASE = "N"
                        MAX'WEIGHT = (MAX'WEIGHT'QTY*MAX'WEIGHT +  &
                           (UOM'CNT*UOM'FACTOR*TMP'WGT))/ &
                           (MAX'WEIGHT'QTY+(UOM'CNT*UOM'FACTOR))
                        BXL'QTY = UOM'CNT * UOM'FACTOR          !![35]
                        MAX'WEIGHT'QTY = MAX'WEIGHT'QTY + (UOM'CNT*UOM'FACTOR)
                        CALL ADD'TO'BOX
                ELSE
                        TIME'CSV = "ADD'DZ'PIECES: ELSE - do them the hard way"
                        \TIME'CSV
!!Got to do them the hard way (must do for MAX'BOX) REALLY PACKING

                        MAP1 WORKING'BOX'NO,B,2

                        WORKING'BOX'NO = BNO
                        UOW'KNO = MEA'UOW'NO

                        CALL FIND'UOW
                        UU = 0
                        DO WHILE UU < UOM'CNT
                                MAP1 TMP2'WGT,B,5
                                UU = UU + 1
                                QQ = BCWEIGHT
                                BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
                                BKEY = BKEY + (BNO USING "#ZZZ")
                                XCALL VICSIT,7,3,BREC,BKEY,BPTR,0,BCTL   !!USE
                                FORMER'WGT = BCWEIGHT
                                TMP2'WGT = &
                                        (MEA'WGT(SUB'NO) * UOM'FACTOR * &
                                        UOW'DUNITS * UOW2'NUNITS)       &
                                        / ((UOW'NUNITS * UOW2'DUNITS)   &
                                        MAX 1)
                                BCWEIGHT = BCWEIGHT + TMP2'WGT
                                CALL GET'FREEBE
                                IF FREEBE = "Y" THEN
                                    BFWEIGHT = BFWEIGHT + (BCWEIGHT - QQ)                                   !![66]
                                ENDIF                                                                           !![66]
                                IF TMP2'WGT = 0 AND PRH'INVENTORY # "N" THEN
                                    ENTRY = "3:Weight zero on "+PRH'TRK'NO+" size "+SUB'NO+" aborting! ("+BCWEIGHT+"-"+PRH'INVENTORY+")"
                                    CALL DO'ERR'OEPACKL
                                    GOTO DEAD'ABORT
                                ENDIF
                                IF DO'EXCUSE = 1 THEN
                                    SAV'ENTRY = ENTRY
                                    ENTRY = "BF="+BFWEIGHT+" QQ="+QQ+" UOM'CNT="+UOM'CNT+" II="+II
                                    CALL DO'EXCUSE'LOG
                                    ENTRY = SAV'ENTRY
                                ENDIF
                                BCMAX = MAX'WEIGHT
                                BCASE = "N"

                                IF (BCWEIGHT > INC2'MAX'UPS OR &
                                   ((BITEMS+UOM'FACTOR) > VIA'MAX'QTY AND &
                                         VIA'MAX'QTY # 0)) AND MAX'BOX = 0 THEN
                                        IF QQ # 0 THEN
                                                UU = UU - 1
                                                CALL EMPTY'BOX
                                                CALL FULL'BOX
                                        ELSE
                                                ENTRY = MEA'TRK'NO + " too heavy to ship!"
                                                CALL DO'ERR'OEPACKL
                                                GOTO DEAD'ABORT
                                        ENDIF
                                ELSE
                                        MAX'WEIGHT = (MAX'WEIGHT'QTY*MAX'WEIGHT+ &
                                         (UOM'FACTOR*TMP'WGT))/ &
                                          (MAX'WEIGHT'QTY+UOM'FACTOR)
                                        BXL'QTY = UOM'FACTOR
                                        MAX'WEIGHT'QTY = MAX'WEIGHT'QTY + UOM'FACTOR
                                        CALL ADD'TO'BOX
!!Don't comment the next six lines out
                                        IF MAX'BOX # 0 THEN  !!Actual fix
                                            IF WORKING'BOX'NO # BNO THEN
                                                UU = UU - 1
                                                WORKING'BOX'NO = BNO
                                            ENDIF
                                        ENDIF

                                        OLD'CONVENTIONAL = CTC   !![WC] force equal
                                        IF CTC # OLD'CONVENTIONAL THEN
                                            EXIT
                                        ENDIF
                                ENDIF
                        LOOP
                        IF CTC > (OLD'CONVENTIONAL+1) THEN
                            ENTRY = "Utterly failed to pack: "+" CTC="+CTC+" OLD'CONVENTIONAL="+OLD'CONVENTIONAL
                            \HDRERR
                            IF WBWHAP # 0 THEN
                                WBWHAP = 3          !!Makes this fatal to WEB order
                            ENDIF
                            CALL DO'ERR'OEPACKL
                            GOTO LOOK'SEE
                        ELSE
                        IF CTC = 1 THEN
                            CTC = 2
                            LIN'CACHED = 0
                            CALL START'FRESH
                            CALL CACHE'LIN
                            GOTO DO'DZ'PIECES'AGAIN  !!UTTER FAILURE TO PACK
                        ENDIF
                        ENDIF
                ENDIF
        ENDIF
        TIME'CSV = "ADD'DZ'PIECES: END"
        \TIME'CSV
RETURN

MAP1 BOX'FULL,B,1
MAP1 LBOX'NO,B,2

ADD'TO'BOX:             !!This takes BXL and puts into box and decides
                        !!if a new box is needed when we fill it.
        TIME'CSV = "ADD'TO'BOX:" : \TIME'CSV
        IF MAX'BOX # 0 AND CARTON'LOOP # 2 THEN
            CALL GET'SPD'JJ        !!JJ is computed max weight
            MAP1 OLD'BCWEIGHT,B,5
!!IF MAX'BOX # 0 THEN BELOW NEEDS TO RESET TO OLD PACKING
            IF HIGH'BOX # 9999 THEN
                EXIT'BOX = HIGH'BOX + LAST'HEAVY'PKG'BOX'NO
            ELSE
                EXIT'BOX = 9999
            ENDIF
            MAP1 TST'WGT,B,5
            TST'WGT = INT((BCWEIGHT+99)/100)*100

            CTC = CTC MAX START'CTC

!!SPD'BOX'NO is box in algorithm.  EXIT'BOX is highest box number in algorithm

!!JJ is Algorithm weight
            IF (TST'WGT > INC2'MAX'UPS AND SPD'BOX'NO = EXIT'BOX) OR &
                     (TST'WGT > JJ AND BITEMS = 0) OR &
                        ((MAX'BOX = 9999 OR BNO > MAX'BOX) AND &
                                    CTC = 0) THEN

!!              CALL DO'ERR'OEPACKLO
!!              GOTO DEAD'ABORT
         !!     INCREASE = -100
                MAX'BOX = 9999
                HDR'HOW'PACK = "S"    !!Switched
                HIGH'BOX = 9999

                INCREASE = INCREASE + 100
                MAP1 CTC,B,1                    !!CHANGE'TO'CONVENTIONAL
                CTC = CTC + 1
                CALL ADD'XREC
                TIME'CSV = "ADD'TO'BOX: EARLY RETURN"
                \TIME'CSV
                RETURN                             !!KLUDGE
            ENDIF

            IF TST'WGT > JJ AND BITEMS > 0 THEN !!Too much weight
!!IF WE SAVE CACHES AGAIN ... we could back off two pieces and try again ...
                OLD'BCWEIGHT = BCWEIGHT
                BCWEIGHT = FORMER'WGT            !!Back it off

                MAP1 SLIN'NO,B,2
                MAP1 SSUB'NO,B,2
                SLIN'NO = LIN'NO
                SSUB'NO = SUB'NO
                CALL FIX'PROBLEM                 !!Fit something else
                LIN'NO = SLIN'NO
                SUB'NO = SSUB'NO

                CALL EMPTY'BOX
                CALL FULL'BOX
                BCWEIGHT = BCWEIGHT + (OLD'BCWEIGHT - FORMER'WGT)
            ELSE
                CALL ADD'XREC
            ENDIF
        ELSE
            CALL ADD'XREC
        ENDIF

        IF BOX'FULL = 1 THEN
            CALL FULL'BOX
        ENDIF
!!The more items there are, the closer to the suggested, not overflow ...
        IF MAX'BOX = 0 THEN
            JJ = (OC2'OVER'PERC + ((MAX'WEIGHT'QTY/10)*100))/((MAX'WEIGHT'QTY/10)+1)
            ENTRY = "BCWEIGHT="+BCWEIGHT+" MAX="+MAX'WEIGHT
            CALL LOGIT
            IF BCWEIGHT > (MAX'WEIGHT/(JJ/100)) THEN
                CALL EMPTY'BOX
            ENDIF
        ELSE
            IF CARTON'LOOP = 2 THEN   !!one per box
!!              CALL FULL'BOX
                CALL EMPTY'BOX
            ENDIF
        ENDIF
        TIME'CSV = "ADD'TO'BOX: END"
        \TIME'CSV
RETURN

GET'SPD'JJ:    !!JJ is final max weight
    TIME'CSV = "GET'APD'JJ:" : \TIME'CSV
    IF MAX'BOX = 9999 THEN
        JJ = MAX'WEIGHT MIN (INC2'MAX'UPS - 100)
    ELSE
        SPD'KSPI'VIA'NO = HDR'BVIA'NO
        SPD'KSPI'ZONE = ALOC'ZONE(1)
        SPD'KSPI'WGT = INT((SPECIAL'WGT+99)/100)
        SPD'KBOX'NO = TBOX'COUNT - LAST'HEAVY'PKG'BOX'NO
        \VUSE SPD

       IF SPD'CTL = 0 THEN
            IF SPD'BOX'NO = HIGH'BOX THEN    !!last box
                JJ = MAX'WEIGHT MIN INC2'MAX'UPS
            ELSE
                JJ = MAX'WEIGHT MIN (SPD'BOX'WGT*100) MIN INC2'MAX'UPS
            ENDIF
        ELSE
            JJ = MAX'WEIGHT MIN INC2'MAX'UPS
            SPD'SPI'VIA'NO = HDR'BVIA'NO
            SPD'SPI'ZONE = ALOC'ZONE(1)
            SPD'SPI'WGT = INT((SPECIAL'WGT+99)/100)
            SPD'BOX'NO = TBOX'COUNT
        ENDIF
    ENDIF
RETURN

SAVE'CACHE:
    TIME'CSV = "SAVE'CACHE:" : \TIME'CSV
    IF MAX'BOX = 0 THEN
        RETURN                                !!KLUDGE
    ENDIF
    XCALL VICSIT,7,9,XREC,XKEY,SAVXPTR,0,XCTL     !!CLEAR
    XKEY = ""
    DO
        XCALL VICSIT,7,4,XREC,XKEY,XPTR,0,XCTL    !!getnxt
        IF XCTL # 0 EXIT
        XCALL VICSIT,7,2,XREC,XKEY,SAVXPTR,0,XCTL !!ADD/UPDATE
    LOOP
!!  XCALL VICSIT,7,9,BREC,BKEY,BPTR,0,BCTL        !!CLEAR
    XCALL VICSIT,7,9,BREC,BKEY,SAVBPTR,0,BCTL     !!CLEAR
    BKEY = ""
    DO
        XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL    !!getnxt
        IF BCTL # 0 EXIT
        XCALL VICSIT,7,2,BREC,BKEY,SAVBPTR,0,BCTL !!ADD/UPDATE
    LOOP
RETURN

RESTORE'WREC'CACHE:
    TIME'CSV = "RESTORE'WREC'CACHE:" : \TIME'CSV
    IF MAX'BOX = 0 THEN
        RETURN                                !!KLUDGE
    ENDIF

    XCALL VICSIT,7,9,WREC,WKEY,WPTR,0,WCTL     !!CLEAR
    WKEY = ""
    DO
        XCALL VICSIT,7,4,WREC,WKEY,SAVWPTR,0,WCTL    !!getnxt

        IF WCTL # 0 EXIT
        XCALL VICSIT,7,2,WREC,WKEY,WPTR,0,WCTL !!ADD/UPDATE
    LOOP

    XCALL VICSIT,7,9,XREC,XKEY,XPTR,0,XCTL     !!CLEAR
    XKEY = ""
    DO
        XCALL VICSIT,7,4,XREC,XKEY,SAVXPTR,0,XCTL    !!getnxt
        IF XCTL # 0 EXIT
        XCALL VICSIT,7,2,XREC,XKEY,XPTR,0,XCTL !!ADD/UPDATE
    LOOP

    XCALL VICSIT,7,9,BREC,BKEY,BPTR,0,BCTL     !!CLEAR
    BKEY = ""
    DO
        XCALL VICSIT,7,4,BREC,BKEY,SAVBPTR,0,BCTL    !!getnxt
        IF BCTL # 0 EXIT
        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
    LOOP
RETURN

MAP1 EXIT'BOX,B,2

SEE'IF'ALGORITHM'OK:
    TIME'CSV = "SEE'IF'ALGORITHM'OK:" : \TIME'CSV
    SF = 0
    BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
    BKEY = BKEY + (LAST'HEAVY'PKG'BOX'NO USING "#ZZZ")
    SBKEY = BKEY
    EXIT'BOX = TBOX'COUNT
    DO
        XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
        IF BCTL # 0 EXIT
        IF BKEY[1;5] # SBKEY[1;5] EXIT

        IF BNO > EXIT'BOX THEN
            SF = 1              !!Too many boxes
            EXIT                !!Could be >= which will make it less likely
                                !!to add a pound and try again -- HOWEVER
                                !!the last box will be heavy!!!
        ENDIF
        SPD'KSPI'VIA'NO = HDR'BVIA'NO
        SPD'KSPI'ZONE = ALOC'ZONE(1)
        SPD'KSPI'WGT = INT((SPECIAL'WGT+99)/100)
        SPD'KBOX'NO = BNO - LAST'HEAVY'PKG'BOX'NO
        \VUSE SPD
        IF SPD'CTL = 0 THEN
            IF INT((BCWEIGHT+99)/100) > SPD'BOX'WGT THEN
                SF = 1
            ENDIF
        ELSE
            SF = 1        !!no need with dead abort, but we should just
                          !!reject the algorithm
            ENTRY = "Special freight table not found: "+BNO+" for "
            \KERROR SPD APID="IN" CNO="N" MODE="K"
            CALL DO'ERR'OEPACKL
!!          GOTO DEAD'ABORT !!So we don't abort
        ENDIF
    LOOP UNTIL SF = 1

CIF NEEDED AND NOT NEEDED THEN    !!We don't need this but leave for now
                                  !!This tests the same as ALT W in OE1BOX
    IF SF = 0 THEN
        CALL CHECK'OEPACK
        IF TTLLIN # TTLCOM THEN
            SF = 2    !!Will force it to switch. Packs wrong - force conventional
        ENDIF
    ENDIF
ENDCIF
RETURN

FIX'PROBLEM:     !!Packs heaviest items to fill gap (problem)
    TIME'CSV = "FIX'PROBLEM:" : \TIME'CSV
    MAP1 PROBLEM,B,5
    MAP1 DELTA,B,5
!!  PROBLEM = JJ - BCWEIGHT            !!Left unpacked wgt in box
    PROBLEM = JJ - FORMER'WGT
    DELTA = 0
    DO WHILE PROBLEM > 0 AND DELTA # PROBLEM
        DELTA = 0
        WKEY = ""
        DO
            XCALL VICSIT,7,4,WREC,WKEY,WPTR,0,WCTL    !!getnxt
            IF WCTL # 0 EXIT
            IF WWGT > PROBLEM REPEAT   !!Too big
            IF WPQTY = WTQTY REPEAT    !!All packed
            IF DOING'HAZ = 0 THEN
                IF WTEMP = "Z" REPEAT
            ELSE
                IF WTEMP # "Z" REPEAT
            ENDIF
            DELTA = DELTA MAX WWGT     !!Save biggest
        LOOP                           !!Exact fit exit
        IF DELTA = 0 THEN
            EXIT              !!Nothing found that fits the weight
        ENDIF
        WKEY = ""
        DO
            XCALL VICSIT,7,4,WREC,WKEY,WPTR,0,WCTL    !!getnxt
            IF WCTL # 0 EXIT
            IF WWGT > PROBLEM REPEAT    !!Too heavy
            IF WPQTY = WTQTY REPEAT     !!All packed
            IF DOING'HAZ = 0 THEN
                IF WTEMP = "Z" REPEAT
            ELSE
                IF WTEMP # "Z" REPEAT
            ENDIF
            IF DELTA = WWGT THEN        !!The one we found
                MAP1 SAV'LIN'NO,B,2
                SAV'LIN'NO = LIN'NO
                LIN'NO = WLIN'NO
                MAP1 SAV'SUB'NO,B,1
                SAV'SUB'NO = SUB'NO
                SUB'NO = WSUB'NO
                MAP1 SAV'LIN'PRICE,B,5
                SAV'LIN'PRICE = LIN'PRICE
                LIN'PRICE = WLIN'PRICE
                MAP1 SAV'LIN'DISC,B,5
                SAV'LIN'DISC = LIN'DISC
                LIN'DISC = 0
                BXL'QTY = 1
                BCWEIGHT = BCWEIGHT + WWGT
                IF WFREEBE = "Y" THEN
                    BFWEIGHT = BFWEIGHT + WWGT
                ENDIF
                FORMER'WGT = FORMER'WGT + WWGT
                CALL ADD'XREC    !!CALL UPDATE'WREC:
                LIN'NO = SAV'LIN'NO
                SUB'NO = SAV'SUB'NO
                LIN'PRICE = SAV'LIN'PRICE
                LIN'DISC = SAV'LIN'DISC
                PROBLEM = PROBLEM - WWGT
                DELTA = 0
                EXIT                                !!exit
            ENDIF
        LOOP
    LOOP
    XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
RETURN

UPDATE'BREC:
    TIME'CSV = "UPDATE'BREC:" : \TIME'CSV
    SAVBREC = BREC
    XCALL VICSIT,7,3,BREC,BKEY,BPTR,0,BCTL    !!use
    IF BCTL # 0 THEN
        BITEMS = 0
    ENDIF
    BCWEIGHT = SAVBCWEIGHT
    BFWEIGHT = SAVBFWEIGHT
    BSWGT = SAVBSWGT
    BITEMS = SAVBITEMS
    BVBX'NO = TMPVBX'NO
    BMAXDIM = MAXDIM
    XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
    CALL CHANGE'VIA'FOR'HAZARDOUS
RETURN

SET'HAZCHG:
    TIME'CSV = "SET'HAZCHG:" : \TIME'CSV
    AMT1 = 0
    IF II = 1 AND VIA'MTYPE = "U" AND VIA'CHG'TYPE # "TPB" THEN
        WGT'H'YN = "N"
        IF BHAZ'MAT = "Y" THEN
            ENTRY = "UPS_Hazardous_"+STR(VIA'FTBL'NO)+"."
            SENTRY = ENTRY
            AMT1 = 0
            CALL GET'USE'XML
            IF DG'CTL = 0 THEN
                  !!reference is ADDCHG because the XML routine has that reference
                  !!really
                \DG GETVALUE ADDCHG amt AMT1
            ENDIF
            IF AMT1 # 0 THEN
                WGT'H'YN = "Y"
                AMT1 = 0        !!Malvern
            ENDIF
        ENDIF
    ENDIF
RETURN

SET'ADDCHG:
    TIME'CSV = "SET'ADDCHG:" : \TIME'CSV
    AMT1 = 0
    IF II # 1 THEN RETURN                                !!KLUDGE
    IF VIA'MTYPE = "U" AND VIA'CHG'TYPE # "TPB" THEN
        ADD'LARGE'PKG'AMT = 1
        CALL SET'WGT'AC'YN  !!Additional charges and large pkg dollars only
    ELSE
        WGT'AC'YN = "N"     !!These never charge, but bits need setting
    ENDIF
    CALL SET'BCHARGES'FROM'WGT'CACHE     !!Set bits from !!cache
    RATE'SHOPPING = 0
RETURN

SET'DIM'OS:    !!used to get weight changes and set flags
    TIME'CSV = "SET'DIM'OS:" : \TIME'CSV
!Presumably we try to use
!!"standard" boxes.  UPC contains the quantities for standard boxes and what
!!that weight would be ... which we now check.
    IF INC'AUTOPACK = "Y" OR HDR'ACTION = "P" OR HDR'ACTION ="L"  THEN
                    !!Invoicing
        ENTRY = "SET'DIM'OS VIA'DIM="+VIA'DIM'YN+" CASE="+BCASE+" VAR="+UPC'STDBOX'VAR
        CALL LOGIT
        IF INC'AUTOPACK = "Y" THEN
            XKEY = (BNO USING "#ZZZ")
            XCALL VICSIT,7,4,XREC,XKEY,XPTR,0,XCTL !!GETNXT
            IF XCTL # 0 OR XNO # BNO THEN
                ENTRY = "    Nothing in XREC box in SET'DIM'OS BNO="+BNO
                GOTO DO'ERR                                        !!KLUDGE
            ENDIF
            LIN'KHDR'LOC'NO = HDR'LOC'NO
            LIN'KHDR'NO = HDR'NO
            CALL SET'LINKEY
            IF LIN'CACHED = 2 THEN
                LIN'NO = XLIN'NO
                ENTRY = LINKEY+" look for "+LIN'NO+" in SET'DIM'OS"
                CALL FIND'LIN'REC
            ELSE
                LINKEY = LINKEY + (XLIN'NO USING "#ZZZ")
                XCALL VICSIT,7,3,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!USE
            ENDIF
            IF LIN'CTL # 0 THEN
                ENTRY = "Could not find line in SET'DIM'OS!"
                GOTO DO'ERR                                    !!KLUDGE
            ENDIF
            CALL FIND'PRH
            PKG'SPACE = SPACE
            IF LIN'TEMP # "N" THEN
                IF PRH'TRK'NO # LIN'TRK'NO OR &
                            PRH'PRC'TRK'NO = 0 OR PRH'WGTS'BY # "Y" THEN
                    MEA'KTRK'NO = LIN'TRK'NO
                ELSE
                    MEA'KTRK'NO = PRH'PRC'TRK'NO
                ENDIF
                MEA'KUOM'NO = LIN'UOM'NO
                \VUSE MEA
                IF MEA'CTL = 0 THEN
                    PKG'KTRK'NO = MEA'TRK'NO
                    \VUSE PKG
                ENDIF
            ENDIF
            BLENGTH = PKG'CASE'LEN
            BWIDTH = PKG'CASE'WID
            BHEIGHT = PKG'CASE'HEI

MAP1 OVER'TRK'NO(320),B,3

            IF BLENGTH > 0 THEN
                OVER'TRK'NO(BNO) = PKG'TRK'NO
            ENDIF
        ENDIF

        CASE
        IF VIA'DIM'YN = "O" OR VIA'DIM'YN = "B" THEN
            DD = 0
            IF BCASE # "Y" AND INC'AUTOPACK = "Y" THEN
                    VBX'CTL = 1
                    IF UPC'RCN # 0 AND BVBX'NO # 0 THEN
                          VBX'KNO = BVBX'NO
                          \VUSE VBX
                    ENDIF
                    ENTRY = "RCN="+UPC'RCN+" VBX'NO="+BVBX'NO+" CTL="+VBX'CTL
                    CALL LOGIT
                    IF VBX'CTL = 0 THEN
                        OVS'QT1 = VBX'OVSBOX'QT1
                        OVS'QT2 = VBX'OVSBOX'QT2
                        OVS'QT3 = VBX'OVSBOX'QT3
                    ELSE
                        OVS'QT1 = UPC'OVSBOX'QT1
                        OVS'QT2 = UPC'OVSBOX'QT2
                        OVS'QT3 = UPC'OVSBOX'QT3
                    ENDIF
                    IF OVS'QT1 = 0 THEN OVS'QT1 = -1
                    IF OVS'QT2 = 0 THEN OVS'QT2 = -1
                    IF OVS'QT3 = 0 THEN OVS'QT3 = -1
                    ENTRY = BOVERSIZ1
                    IF BITEMS >= OVS'QT1 THEN
                        BOVERSIZ1 = "Y"
                    ELSE
                        BOVERSIZ1 = ""
                    ENDIF
                    IF ENTRY # BOVERSIZ1 THEN DD = 1
                    ENTRY = "SET'DIM'OS SET OVERSIZ1 TO: "+BOVERSIZ1+" BITEMS="+BITEMS+" OVS'QT1="+OVS'QT1
                    CALL LOGIT
                    ENTRY = BOVERSIZ2
                    IF BITEMS >= OVS'QT2 THEN
                        BOVERSIZ2 = "Y"
                    ELSE
                        BOVERSIZ2 = ""
                    ENDIF
                    IF ENTRY # BOVERSIZ2 THEN DD = 1
                    ENTRY = "SET'DIM'OS SET OVERSIZ2 TO: "+BOVERSIZ2+" BITEMS="+BITEMS+" OVS'QT2="+OVS'QT2
                    CALL LOGIT
                    ENTRY = BOVERSIZ3
                    IF BITEMS >= OVS'QT3 THEN
                        BOVERSIZ3 = "Y"
                    ELSE
                        BOVERSIZ3 = ""
                    ENDIF
                    IF ENTRY # BOVERSIZ3 THEN DD = 1
                    ENTRY = "SET'DIM'OS SET OVERSIZ3 TO: "+BOVERSIZ3+" BITEMS="+BITEMS+" OVS'QT3="+OVS'QT3
                    CALL LOGIT
            ENDIF
            CASE
            IF BOVERSIZ3 = "Y" THEN
                BOVERSIZ2 = ""
                BOVERSIZ1 = ""
            ELSE
            IF BOVERSIZ2 = "Y" THEN
                BOVERSIZ1 = ""
                BOVERSIZ3 = ""
            ENDCASE
            IF BOVERSIZ1 = "Y" OR BOVERSIZ2 = "Y" OR &
                                  BOVERSIZ3 = "Y" OR DD = 1 THEN
                    XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                    ENTRY = "BC="+BCWEIGHT+" TBL'OS1="+(TBL'OVERSIZ1*100)+&
                                           " TBL'OS2="+(TBL'OVERSIZ2*100)+&
                                           " TBL'OS3="+(TBL'OVERSIZ3*100)
                    CALL LOGIT
                    ENTRY = "SET'DIM'OS OS="+BOVERSIZ1+" DD="+DD+" NEED="+NEED'OS'WGT+" TBL="+TBL'OVERSIZ1+" BC="+BCWEIGHT
                    CALL LOGIT
                    CASE
                    IF BOVERSIZ1 = "Y" THEN
                        IF NEED'OS'WGT # 0 THEN
                            IF (TBL'OVERSIZ1*100) > BCWEIGHT THEN
                                BSWGT = TBL'OVERSIZ1
                            ELSE
                                BSWGT = 0
                            ENDIF
                            IF BSWGT = 0 THEN
                                BOVERSIZ1 = "N"
                            ENDIF
                        ENDIF
                    ELSE
                    IF BOVERSIZ2 = "Y" THEN
                        IF NEED'OS'WGT # 0 THEN
                            IF (TBL'OVERSIZ2*100) > BCWEIGHT THEN
                                BSWGT = TBL'OVERSIZ2
                            ELSE
                                BSWGT = 0
                            ENDIF
                            IF BSWGT = 0 THEN
                                BOVERSIZ2 = "N"
                            ENDIF
                        ENDIF
                    ELSE
                    IF BOVERSIZ3 = "Y" THEN
                        IF NEED'OS'WGT # 0 THEN
                            IF (TBL'OVERSIZ3*100) > BCWEIGHT THEN
                                BSWGT = TBL'OVERSIZ3
                            ELSE
                                BSWGT = 0
                            ENDIF
                            IF BSWGT = 0 THEN
                                BOVERSIZ3 = "N"
                            ENDIF
                        ENDIF
                    ELSE
                        BSWGT = 0
                    ENDCASE


                    ENTRY = ENTRY + " final OS="+BOVERSIZ1+" BSWGT="+BSWGT
                    CALL LOGIT
                    ENTRY = ENTRY + " final OS="+BOVERSIZ2+" BSWGT="+BSWGT
                    CALL LOGIT
                    ENTRY = ENTRY + " final OS="+BOVERSIZ3+" BSWGT="+BSWGT
                    CALL LOGIT
                    XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD
        ELSE
        IF VIA'DIM'YN = "Y" OR VIA'DIM'YN = "B" THEN
                IF BCASE # "Y" THEN
                    MAP1 STDBOX'QTY(8),B,2
                    MAP1 STDBOX'DIM(8),B,2
                    MAP1 VBXPTR,X,30
                    VBX'CTL = 1
                    IF UPC'STDBOX'VAR = "Y" AND BVBX'NO # 0 THEN
                          VBX'KNO = BVBX'NO
                          \VUSE VBX
                    ENDIF
                    IF VBX'CTL = 0 THEN
                          FOR ZZ = 1 TO 8
                            STDBOX'QTY(ZZ) = VBX'STDBOX'QTY(ZZ)
                            STDBOX'DIM(ZZ) = VBX'STDBOX'DIM(ZZ)
                          NEXT ZZ
                          ENTRY = "SET'DIM'OS BVBX'NO="+BVBX'NO+" MAX="+BMAXDIM+" QTY="+STDBOX'QTY(6)+" DIM="+STDBOX'DIM(6)
                          CALL LOGIT
                    ELSE
                          FOR ZZ = 1 TO 8
                            STDBOX'QTY(ZZ) = UPC'STDBOX'QTY(ZZ)
                            STDBOX'DIM(ZZ) = UPC'STDBOX'DIM(ZZ)
                          NEXT ZZ
                          ENTRY = "SET'DIM'OS USE UPC="+BVBX'NO+" MAX="+BMAXDIM+" QTY="+STDBOX'QTY(6)+" DIM="+STDBOX'DIM(6)
                          CALL LOGIT
                    ENDIF
                    ZZ = 0
                    FOR WW = 8 TO 1 STEP -1
                        IF BITEMS <= STDBOX'QTY(WW) THEN
                            ZZ = STDBOX'DIM(WW)
                            ENTRY = "SET'DIM'OS ZZ="+ZZ+" BITEMS="+BITEMS+" QTY="+STDBOX'QTY(WW)+" WW="+WW
                            CALL LOGIT
                        ENDIF
                    NEXT WW
                    ENTRY = "SET'DIM'OS COMPARE="+(ZZ*100)+" BC="+BCWEIGHT
                    CALL LOGIT
                    IF BCWEIGHT < (ZZ*100) THEN
!!                      XCALL VICSIT,7,3,BREC,BKEY,BPTR,0,BCTL    !!use
                        IF BCTL = 0 THEN
                            XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                            BSWGT = ZZ
                            BDIMENSION = "Y"
                            XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD
                        ENDIF
                        ENTRY = "DZ SET DIM WGT: "+(BSWGT*100)
                        CALL LOGIT
                    ELSE
                        ENTRY = "DZ DID NOT SET DIM WGT,ACTUAL IS: "+BCWEIGHT
                        CALL LOGIT
                    ENDIF
                ENDIF
        ENDCASE
!!This called only to set weight because large package changes weight AND
!!                has charges.  Weight first as we need to have it to
!!                compute base freight charges
        BOVERSIZ1 = "N"
        BOVERSIZ2 = "N"
        BOVERSIZ3 = "N"
        CALL GET'LARGE'PKG !!place  !!To get weight only don't set dollars
        IF AMT1 = 0 THEN
            BSWGT = 0
            BLRGPKG = "N"                   !Large package NOT
        ELSE
           !!see if weight from large is used or actual biggest)
            TAMT = INT((BCWEIGHT/100) + .99)*100
                 !!TAMT is actual weight in 2 decimal next highest
            IF TAMT > NEW'SWGT THEN  !!NEW'SWGT is fake weight from UPS
                NEW'SWGT = 0   !!use actual weight
            ENDIF
            BSWGT = NEW'SWGT/100
            BLRGPKG = "Y"                   !Large package
        ENDIF
        BOX'SWGT = BSWGT
        WGT'LGE'PKG'YN = BLRGPKG
        CALL SET'WGT'AC'YN
        BADDCHG = WGT'AC'YN
        CALL SET'BCHARGES'FROM'WGT'CACHE        !!Set bits from !!cache
    ENDIF
RETURN

INIT'BOXES:                        !!START'FRESH is the real "init"
    TIME'CSV = "INIT'BOXES:" : \TIME'CSV
    BOX'SPACE = SPACE
    BOX'HDR'LOC'NO = HDR'LOC'NO
    BOX'DOC'TYPE = HDR'DOC'TYPE
    BOX'HDR'NO = HDR'NO
    BOX'NO = 0
    BOX'SHIPMENT = HDR'SHIPMENT + 1
    \SETKEY BOX MODE="KEY"
    CALL DELETE'REMAINING'BOXES        !!Remove any left over box recs
    CALL RESTORE'WREC'CACHE
    BREC'SPACE = SPACE
    IF MAX'BOX # 0 THEN
        TBOX'COUNT = 0
    ENDIF
RETURN

FULL'BOX:
    TIME'CSV = "FULL'BOX:" : \TIME'CSV

    TBOX'COUNT = TBOX'COUNT + 1
    BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
    BKEY = BKEY + (TBOX'COUNT USING "#ZZZ")
    XCALL VICSIT,7,3,BREC,BKEY,BPTR,0,BCTL   !!USE

    IF BCTL # 0 THEN
        BREC'SPACE = SPACE
        BNO = TBOX'COUNT
        BTYPE = "B"
        BVBX'NO = TMPVBX'NO
        BMAXDIM = MAXDIM
        CALL ADD'BREC

    ENDIF
    CALL EMPTY'BOX
    BOX'FULL = 0
    CALL CHANGE'VIA'FOR'HAZARDOUS
RETURN

EMPTY'BOX:
    BREC'SPACE = SPACE              !!Current box cleared
    BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
    BKEY = BKEY + (TBOX'COUNT USING "#ZZZ")
    XCALL VICSIT,7,3,BREC,BKEY,BPTR,0,BCTL   !!USE
    MAX'WEIGHT = 0                  !!Weighted averages cleared
    MAX'WEIGHT'QTY = 0
    MAXDIM = 0                      !!Dim/OS cleared
    BOX'FULL = 1                    !!Any previous box is full!
    TIME'CSV = "EMPTY'BOX: BKEY="+BKEY : \TIME'CSV
RETURN

MAP1 PACK'VIA'NO,B,2
MAP1 WGTMAX,B,2,320
MAP1 PAGENO,B,1

ADD'BREC:
        TIME'CSV = "ADD'BREC:" : \TIME'CSV
        ZZ = 320
        IF BNO > ZZ THEN
            ENTRY = "Order has: "+BNO+" boxes; max is "+STR(ZZ)+" split up order!"
!!          ENTRY = "Can only have "+STR(ZZ)+" boxes per order - split order up!"
            CALL DO'ERR'OEPACK
            GOTO DEAD'ABORT
        ENDIF
                                        !![39] above
        IF BTYPE = "B" THEN
            BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
            IF PACK'VIA'NO = 0 THEN PACK'VIA'NO = HDR'BVIA'NO
        ELSE
            BTYPE = "A"
            BKEY = "A" + (HDR'VIA'NO USING "#ZZZ")
        ENDIF
        BKEY = BKEY + (BNO USING "#ZZZ")
        ENTRY ="ADD'BREC BTYPE="+BTYPE+" BKEY="+BKEY+" BNO="+BNO+" BCWEIGHT="+BCWEIGHT

        CALL LOGIT
        BVALUE'YN = "?"

!!We are no longer rounding but leave here to know how to round
!       BCWEIGHT = INT((BCWEIGHT + 99)/100) * 100       !!Round it up to next whole
!       BFWEIGHT = INT((BFWEIGHT + 99)/100) * 100       !!Round it up to next whole
        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE

        TIME'CSV = "ADD'BREC: BKEY="+BKEY+" BCTL="+BCTL : \TIME'CSV

        IF DOING'HEAVY # 0 OR DOING'CASES # 0 THEN

            LAST'HEAVY'PKG'BOX'NO = BNO MAX LAST'HEAVY'PKG'BOX'NO
        ENDIF
        CALL DUMP'BREC'BPTR
RETURN

!!This routine is the only place we add boxes to memory (BREC)
ADD'XREC:               !!Need to add, if ctl = 9 (already there) then
                        !!read and add to it the qty, weight, shp'total
                        !!
        TIME'CSV = "ADD'XREC:" : \TIME'CSV

        IF INC'AUTOPACK # "Y" RETURN                    !!KLUDGE
        XKEY = (BNO USING "#ZZZ") + (LIN'NO USING "#ZZZ") + STR(SUB'NO)
        XCALL VICSIT,7,3,XREC,XKEY,XPTR,0,XCTL            !!use

!!      TIME'CSV = "ADD'XREC: XKEY="+XKEY+" XCTL="+XCTL : \TIME'CSV

        ENTRY = "XKEY="+BNO+        " LIN'NO="+(LIN'NO USING "#ZZZ")+ &
                " SUB="+SUB'NO+" CTL="+XCTL
        CALL LOGIT
        IF XCTL # 0 THEN
            XQTY = 0
        ELSE
            XCALL VICSIT,7,8,XREC,XKEY,XPTR,0,XCTL    !!delete
        ENDIF
        XTYPE = BTYPE           !![39] set fields anyway ...
        XNO = BNO
        XLIN'NO = LIN'NO
        XSUB'NO = SUB'NO
        XQTY = XQTY + BXL'QTY
        BITEMS = BITEMS + BXL'QTY
        XSHP'TOTAL = XQTY*(LIN'PRICE-LIN'DISC)
        XCALL VICSIT,7,2,XREC,XKEY,XPTR,0,XCTL    !!update or add
        IF XCTL # 0 THEN
            IF XCTL = 9 THEN
                ENTRY = "Overflow BXL cache!"
            ELSE
                ENTRY = "Weird BXL cache!"
            ENDIF
            CALL DO'ERR'OEPACK
            GOTO DEAD'ABORT
        ENDIF
        CALL UPDATE'WREC
        CALL UPDATE'BREC
RETURN

UPDATE'WREC:
        TIME'CSV = "UPDATE'WREC:" : \TIME'CSV
        IF CARTON'LOOP = 2 THEN
            RETURN                                        !!KLUDGE
        ENDIF
        WKEY = (LIN'NO USING "#ZZZ") + STR(SUB'NO)
        XCALL VICSIT,7,3,WREC,WKEY,WPTR,0,WCTL            !!use

!!      LENTRY = "UPDATE'WREC: WKEY="+WKEY+" WCTL="+WCTL : \LOG'IT

        IF INSTR(1,LINKEY,"C") # 0 THEN
            RETURN
        ENDIF

        IF WCTL # 0 THEN
            WPQTY = 0
!!WPQTY
        ENDIF
        WPQTY = WPQTY + BXL'QTY
        XCALL VICSIT,7,2,WREC,WKEY,WPTR,0,WCTL    !!update or add
RETURN

COPYF "INCFIL[IN]",=INC2,NOAFR

MAP1 KEEP'PACKING,S,1
MAP1 USE'CASE'MAX,S,1
MAP1 SPLIT'BO,S,1
MAP1 NO'CALL'TAGS,S,1
MAP1 KAYMAN'SORT,S,1
MAP1 PACK'NON'INV,S,1
MAP1 USE'VAT,S,1
MAP1 OEPACK'WGTLOG,S,30
MAP1 OEPACK'APPLY'NETS,S,1
MAP1 OEPACK'FEDEX'LIKE'UPS,S,1

FIRST'READCTL:
        TIME'CSV = "FIRST'READCTL:" : \TIME'CSV
        LDUSR
        IF INC'AUTOPACK = "Y" THEN
            XCALL GETENV,"KAYMAN_SORT",KAYMAN'SORT
        ENDIF
        XCALL GETENV,"OEPACK_FEDEX_LIKE_UPS",OEPACK'FEDEX'LIKE'UPS
        XCALL GETENV,"OEPACK_NO_CHANGE_FLAG",OEPACK'NO'CHANGE'FLAG
        XCALL GETENV,"OEPACK_APPLY_NETS",OEPACK'APPLY'NETS
        XCALL GETENV,"OEPACK_WGTLOG",OEPACK'WGTLOG
        IF OEPACK'WGTLOG = "Y" THEN
            OEPACK'WGTLOG = "/logs/oepack.DAILY"
        ENDIF
        XCALL GETENV,"PACK_NON_INV",PACK'NON'INV
        XCALL GETENV,"OEPACK_USE_VAT",USE'VAT
        XCALL GETENV,"OEPACK_SPLIT_BO",SPLIT'BO
        XCALL GETENV,"OEPACK_KEEP_PACKING",KEEP'PACKING
        XCALL GETENV,"OEPACK_USE_CASE_MAX",USE'CASE'MAX
        XCALL GETENV,"OEPACK_NO_CALL_TAGS",NO'CALL'TAGS

        MAP1 FORCE'P,S,1
        XCALL GETENV,"OE1WGA_FORCE_P",FORCE'P

        MAP1 F7'SURE,S,1
        XCALL GETENV,"OE1WGA_F7_SURE",F7'SURE

        MAP1 OEPACK'DSP'TOP'WGT,S,1
        XCALL GETENV,"OEPACK_DSP_TOP_WGT",OEPACK'DSP'TOP'WGT

        IF LINKED # 1 THEN
                \READCTL APP="MC"    GL="N" ABORT="DEAD'ABORT"
                \READCTL APP="OE/IN" GL="N" ABORT="DEAD'ABORT"
                \READCTL APP="AR"    GL="N" ABORT="DEAD'ABORT"
                USE OC2 UB'CNO INTO OC2'REC
                IF OC2'CTL # 0 THEN
                   ENTRY = "Set-up O/E control record for Shipping Set-Ups"
                   CALL DO'ERR'OEPACK
                   GOTO DEAD'ABORT
                ENDIF
        ENDIF
        USE IN2 UB'CNO INTO IN2'REC
        IF IN2'CTL # 0 THEN
            ENTRY = "IN2 not found - aborting"
            CALL DO'ERR
            GOTO ABORT
        ENDIF
        IF IN2'WL'YN = "Y" THEN
            \READCTL APP="WL" GL="N" ABORT="DEAD'ABORT"
        ENDIF
        IF IN2'WB'YN = "Y" THEN
            \READCTL APP="WB" GL="N"
        ENDIF
        IF IN2'SUV = "Y" THEN
            IF IN2'FRT'SCHEME(1) = "" THEN
                ENTRY = "IN2'SUV="+IN2'SUV+" first DESC is blank!"
                CALL DO'ERR
                GOTO ABORT
            ENDIF
        ENDIF
        IF OC2'CWT'GMIN = 0 THEN OC2'CWT'GMIN = 15
        IF OC2'CWT'AMIN = 0 THEN OC2'CWT'GMIN = 10
        IF OC2'CWT'GND'WB # 0 THEN
            WCWT'GND'WB = OC2'CWT'GND'WB
            W500'GND'WB = OC2'CWT'GND'WB
        ELSE
            XCALL GETENV,"WCWTGND",ENTRY
            WCWT'GND'WB = VAL(ENTRY)
            XCALL GETENV,"W500GND",ENTRY
            W500'GND'WB = VAL(ENTRY)
        ENDIF
        IF OC2'CWT'NXT'WB # 0 THEN
            WCWT'NXT'WB = OC2'CWT'NXT'WB
            W500'NXT'WB = OC2'CWT'NXT'WB
        ELSE
            XCALL GETENV,"WCWTNXT",ENTRY
            WCWT'NXT'WB = VAL(ENTRY)
            XCALL GETENV,"W500NXT",ENTRY
            W500'NXT'WB = VAL(ENTRY)
        ENDIF
        IF OC2'CWT'2ND'WB # 0 THEN
            WCWT'2ND'WB = OC2'CWT'2ND'WB
            W500'2ND'WB = OC2'CWT'2ND'WB
        ELSE
            XCALL GETENV,"WCWT2ND",ENTRY
            WCWT'2ND'WB = VAL(ENTRY)
            XCALL GETENV,"W5002ND",ENTRY
            W500'2ND'WB = VAL(ENTRY)
        ENDIF
        IF OC2'CWT'3RD'WB # 0 THEN
            WCWT'3RD'WB = OC2'CWT'3RD'WB
            W500'3RD'WB = OC2'CWT'3RD'WB
        ELSE
            XCALL GETENV,"WCWT3RD",ENTRY
            WCWT'3RD'WB = VAL(ENTRY)
            XCALL GETENV,"W5003RD",ENTRY
            W500'3RD'WB = VAL(ENTRY)
        ENDIF
        CALL SET'VICS'PTRS
        FOR BB = 0 TO 7
            IF IN2'FRT'SCHEME(BB+1) = "" THEN
                BB = 7
            ELSE
                BITTOP = BB + 1
            ENDIF
        NEXT BB

!!Maximum number of boxes to pack with SPI algorithm before switch to conventional
        MAP1 MAX'BOX,B,2    !!9999=Conventional other number are # of boxes in algorithm
        MAP1 UPS'MAX'BOX,B,2   !!Use to test if order has large number of boxes
!!Initialize MAX'BOX value for packing method
        CALL CALC'SPECIAL'WGT
        CALL INIT'SPECIAL'PACKING
        UPS'MAX'BOX  = MAX'BOX                !!Save MAX'BOX to use as a test for C1 rule
        MAP1 START'MAX'BOX,B,2
        MAP1 START'CTC,B,1
        MAP1 MANY'BOXES'CASES,B,1

        MAP1 AUTO'STRAP,S,1                   !!set from xml getvalue  oepack.pack_cases.auto_strap  - S1
        MAP1 DO'STRAP,S,1                     !!set from xml getvalue  oepack.pack_cases.pickup_strap- S2
        MAP1 MANY'BOXES,S,1                   !!set from xml getvalue  oepack.pack_cases.many_boxes  - C1
        MAP1 CASES'CUS,S,1                    !!set from xml getvalue  oepack.pack_cases.customer    - C2
        MAP1 CASES'VIA,S,1                    !!set from xml getvalue  oepack.pack_cases.via         - C3
        MAP1 ALL'CASES,S,1                    !!set from xml getvalue  oepack.pack_cases.all_cases   - C4

        START'CTC = 0
        MANY'BOXES'CASES = 0
        IF MAX'BOX > 0 THEN
            CALL GET'VIA
            \DG GETVALUE _OESETUP oepack.pack_cases.auto_strap AUTO'STRAP
            AUTO'STRAP = "N"    !!strapping doesn't work 1/23/2024

            IF DG'CTL # 0 OR AUTO'STRAP # "Y" THEN
                AUTO'STRAP = "N"
                DO'STRAP = "N"
            ELSE
                IF INSTR(1,UCS(VIA'DESC),"CUSTOMER PICKUP") # 0 OR &
                    (HDR'VIA'NO >= OEC'SCUS'VIA AND HDR'VIA'NO <= OEC'ECUS'VIA) THEN
                        \DG GETVALUE _OESETUP oepack.pack_cases.pickup_strap DO'STRAP
                    IF DG'CTL # 0 OR DO'STRAP # "Y" THEN
                        DO'STRAP = "N"
                    ENDIF
                ELSE
                    DO'STRAP = "Y"
                ENDIF
                IF DO'STRAP = "N" THEN
                    AUTO'STRAP = "N"
                ENDIF
            ENDIF
            CALL SET'INC2'MAX'UPS
            \DG GETVALUE _OESETUP oepack.pack_cases.many_boxes MANY'BOXES
            IF DG'CTL # 0 OR MANY'BOXES # "Y" THEN
                MANY'BOXES'CASES = 0
            ELSE
                MANY'BOXES'CASES = 1
            ENDIF

            \DG GETVALUE _OESETUP oepack.pack_cases.customer CASES'CUS
            IF CASES'CUS = "Y" THEN
                CALL FIND'CUS
                IF CUS'PACK'CASES = "Y" THEN
                    START'CTC = 2
                    MANY'BOXES'CASES = 0
                ENDIF
            ENDIF
            IF START'CTC = 0 THEN
                \DG GETVALUE _OESETUP oepack.pack_cases.via CASES'VIA
                IF CASES'VIA = "Y" THEN
                    IF VIA'PACK'CASES = "Y" THEN
                        START'CTC = 2
                        MANY'BOXES'CASES = 0
                    ENDIF
                ENDIF
            ENDIF
            IF START'CTC = 0 THEN
                \DG GETVALUE _OESETUP oepack.pack_cases.all_cases ALL'CASES
                IF ALL'CASES = "Y" THEN
                    MAP1 ALL'CASES'TEST,B,1
                    ALL'CASES'TEST = 1
                    SF = 0
                    LIN'KHDR'LOC'NO = HDR'LOC'NO
                    LIN'KDOC'TYPE = HDR'DOC'TYPE
                    LIN'KHDR'NO = HDR'NO
                    LIN'KNO = 0
                    USE LIN INTO LIN'REC KEY LIN'KEY
                    DO
                        GETNXT LIN INTO LIN'REC
                        \CHKKEY LIN
                        IF LIN'CTL # 0 EXIT
                        CALL FIND'MEA
                        IF MEA'TREAT'CASE # "Y" THEN
                            SF = 1
                            EXIT
                        ENDIF
!!Need this because FIND'MEA won't set them if CONVENTIONAL not already 2
TST'SET'MAX'BOX'CS2:
                        CALL SET'MAX'BOX'CS
!!Test MAX'BOX'CS for zero to prevent divide by zero results
                        IF MAX'BOX'CS # 0 THEN
                            FOR WW = 1 TO 6
                                IF INT(LIN'TCOM'QTY(WW)/MAX'BOX'CS) # &
                                           (LIN'TCOM'QTY(WW)/MAX'BOX'CS) THEN
                                    SF = 1
                                    EXIT
                                ENDIF
                            NEXT WW
                        ELSE
                            SF = 1
                            EXIT
                        ENDIF
                    LOOP
                    IF SF = 0 THEN
                        START'CTC = 2
                        MANY'BOXES'CASES = 0
                    ENDIF
                    ALL'CASES'TEST = 0
                ENDIF
            ENDIF
            IF START'CTC = 0 AND MANY'BOXES'CASES = 0 THEN
                MAP1 NEVER'CASES,B,1
                NEVER'CASES = 1
            ENDIF
        ENDIF


!!***********************************************
!!MAX'BOX = 0 does not work. It is supposed to do Case/Dz/Pc
!!MAX'BOX = 9999 does Case/Pc and works!
!!Since this is another company packing we don't know what they will do anyway
!!If you want MAX'BOX = 0 to work, give us two weeks.
!!The code below for HOB will force to pack conventional.
!!***********************************************
        IF HDR'LOC'NO # 1 THEN
            MAX'BOX = 9999
            START'MAX'BOX = 9999
        ELSE
            START'MAX'BOX = MAX'BOX  !!Save starting value of MAX'BOX based on packing method
        ENDIF
        IF MAX'BOX = 9999 THEN
            HDR'HOW'PACK = "C"    !!Conventional
        ELSE
            HDR'HOW'PACK = "A"    !!Algorithm
        ENDIF

        TIME'CSV = "HDR'HOW'PACK="+HDR'HOW'PACK : \TIME'CSV

        IF OC2'UPSONL'YN = "Y" THEN
                \READCTL APP="UP" GL="N" ABORT="DEAD'ABORT"
                \DG GETVALUE _UPSETUP UPS_Method ENTRY
                IF DG'CTL = 0 AND ENTRY[1;1] = "N" THEN
                    UPC'RURAL'CAMT = 0
                    UPC'RURAL'100 = 0
                    UPC'RES'AMT = 0
                    UPC'RES100'AMT = 0
                    UPC'LARGE'PKG = 0
                    UPC'GND'RESAMT = 0
                    UPC'RURAL'AMT = 0
                ENDIF
                MAP1 DIM'DEBUG,S,1
                XCALL GETENV,"OEPACK_DIM_DEBUG",DIM'DEBUG
                IF DIM'DEBUG = "Y" THEN
                    LOOKUP "/debug/dim_debug",ZZ
                    IF ZZ # 0 KILL "/debug/dim_debug"
                    ENTRY = "Read UPC: "+UPC'DIM'WGT+" VAR="+UPC'STDBOX'VAR
                    CALL LOGIT
                ENDIF
        ENDIF
        MAP1 WGT'ADJ,F
        \DG GETVALUE _UPSETUP UPS.wgtadj WGT'ADJ    !!For scale error
        IF DG'CTL # 0 THEN
            WGT'ADJ = 0
        ENDIF
        MAP1 DO'WAVE'PICKING,S,1
        MAP1 MASTER'DO'WAVE'PICKING,S,1
        XCALL GETENV,"OEPACK_WAVE_PICKING",MASTER'DO'WAVE'PICKING
        IF MASTER'DO'WAVE'PICKING = "" THEN
!!Either wave or consolidated, we add the record
            XCALL GETENV,"OEPACK_CONSOLIDATED'PICKING",MASTER'DO'WAVE'PICKING
        ENDIF
        IF MASTER'DO'WAVE'PICKING = "Y" THEN
            MAP1 OEPACK'WAVE'PU,S,1
            XCALL GETENV,"OEPACK_WAVE_PU",OEPACK'WAVE'PU
            MAP1 WL'DEBUG,S,100
            XCALL GETENV,"WL_DEBUG",WL'DEBUG
            IF WL'DEBUG = "Y" THEN
                WL'DEBUG = "/logs/wl_debug.DAILY"
            ELSE
            IF WL'DEBUG = "N" THEN
                WL'DEBUG = ""
            ENDIF
            ENDIF
            XCALL PUTENV,"WL_SKIPDOCS=X"
        ENDIF
!       IF V''SYSTEM="UNIX" THEN
                MAP1 OEPACK'HARSH,S,1,"Y"
                XCALL GETENV,"OEPACK_HARSH_CUS_WGT",OEPACK'HARSH
                MAP1 CHAIN'BETWEEN,S,1,"N"
                XCALL GETENV,"OEPACK_CHAIN_BETWEEN",CHAIN'BETWEEN
                MAP1 ENV'DO'EXCUSE,B,1
                XCALL GETENV,"OEPACK_DO_EXCUSE",ENTRY
                IF ENTRY = "Y" THEN
                    ENV'DO'EXCUSE = 1
                    DO'EXCUSE = 1
                ENDIF
                ENTRY = ""
                \DG GETSTRING _OESETUP oepack_do_excuse ENTRY
                IF DG'CTL = 0 AND ENTRY = "Y" THEN
                    ENV'DO'EXCUSE = 1
                    DO'EXCUSE = 1
                ENDIF
!       ENDIF
        IF INC'INTERFACE # 5 THEN
                ENTRY = "This is a T-Shirt only program!"
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
        ENDIF
        IF OC2'NET'PPERC < 50 OR OC2'NET'PPERC > 100 THEN
                OC2'NET'PPERC = 100
        ENDIF
        IF OC2'OVER'PERC <= 0 OR OC2'OVER'PERC > 100 THEN
                OC2'OVER'PERC = 100
        ENDIF
        INC2'REC = INC'REC
        IF OEC'TASK'YN = "Y" THEN
                PQU'DID = "OEQUE"
                PQU'KID = "OEQUE"
        ENDIF
        CALL SET'USE'CC
MAP1 ACTION,S,1
MAP1 DEBUG'ON,B,1
!       IF V''SYSTEM = "AMOS" THEN
!               LOOKUP "OEPACK.DBG",QQ
!       ELSE
                XCALL GETENV,"OEPACK_DEBUG",ENTRY
                IF ENTRY = "Y" THEN
                        QQ = 1
                ELSE
                IF ENTRY = "X" THEN
                        QQ = 2
                ELSE
                        QQ = 0
                ENDIF
                ENDIF
!       ENDIF
        IF WBWHAP # 0 THEN
            IF INC'AUTOPACK = "Y" THEN
                ACTION = "P"
            ELSE
                ACTION = "E"
            ENDIF
        ENDIF
        IF QQ # 0 THEN
                MAP1 DO'OERCTL,S,1
                DEBUG'ON = 1
                IF QQ = 2 THEN DO'OERCTL = "N"
                INC2'REC = INC'REC
                IF INC'AUTOPACK = "Y" THEN
                        ACTION="P"
                ELSE
                        INPUT "ENTER ACTION: ",ACTION
                        ACTION = UCS(ACTION)
                        IF ACTION # "P" THEN ACTION = "E"
                ENDIF
        ELSE
                IF INC'AUTOPACK = "Y" THEN
                        ACTION="P"
                ENDIF
        ENDIF
        IF WBWHAP # 0 THEN DO'OERCTL = "N"
RETURN

DO'BITS:
        TIME'CSV = "DO'BITS:" : \TIME'CSV

        IF HDR'MAN'FLAG = 0 OR HDR'FREE'FRT = "S" THEN  !!First time
!!Fix wbxmlc.bv HANDLE'ORDER'CREATE if bits change
!!Also check that oe1shp.bv sets bits the same
                \SETBIT HDR'MAN'FLAG 1                  !!First time flag set
                \SETBIT HDR'MAN'FLAG 2                  !!Cash on auto
                \SETBIT HDR'MAN'FLAG 4                  !!CR on auto
                \SETBIT HDR'MAN'FLAG 8                  !!DR on auto
                \SETBIT HDR'MAN'FLAG 16                 !!Charges by order
                CALL CLR'FREE'FRT'FLAGS        !!Sets 32
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "set MAN auto="+HDR'MAN'FLAG
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
!!              \SETBIT HDR'MAN'FLAG 64                 !!Actual BOX on disk
                \SETBIT HDR'MAN'FLAG 128                !!Sales tax
!!              \SETBIT HDR'BIT'FLAG 1                  !!This was multi
!!              \SETBIT HDR'BIT'FLAG 2                  !!Set when a split occurs and they
!!              \SETBIT HDR'BIT'FLAG 4                  !!re-pricing
                \SETBIT HDR'BIT'FLAG 8                  !!Restock auto
!!              \SETBIT HDR'BIT'FLAG 16                 !!If set, FFWGT = WGT
        ELSE
                \TSTBIT HDR'BIT'FLAG 4 VAR="SF"         !!Re-pricing bit set
                IF SF # 0 THEN
                    ENTRY = "Cannot process - re-pricing set - see order in order entry program!"
                    CALL DO'ERR
                    GOTO DEAD'ABORT
                ENDIF
        ENDIF
        \TSTBIT HDR'MAN'FLAG 2 VAR="DO'CASH"            !!Do cash if on auto
        \TSTBIT HDR'MAN'FLAG 4 VAR="DO'CR"              !!Do CR if on auto
        \TSTBIT HDR'MAN'FLAG 8 VAR="DO'DR"              !!Do DR if on auto
        \TSTBIT HDR'MAN'FLAG 32 VAR="DO'FREE'FRT"       !!Do free freight calcs
        IF HDR'FREE'FRT = "" THEN
            DO'FREE'FRT = 1
        ENDIF
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
!!          \TSTBIT HDR'BIT'FLAG 32 VAR="SF"       !!Do ffp (ZERO=auto)
            ENTRY = "TEST MAN auto="+HDR'MAN'FLAG+" DO="+DO'FREE'FRT+" BIT'F="+HDR'BIT'FLAG+" NO="+HDR'NO
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        IF HDR'MULTI # 0 THEN                   !!COULD use bit for this?
            \SETBIT HDR'BIT'FLAG 1          !!This was multi
        ENDIF
!!      \SETBIT HDR'BIT'FLAG 2          !!Set when a split occurs and they
                                        !!qualify for free freight
        CALL DSP'BITS
RETURN

COPYF "HDRFIL",=ZZZ,NOAFR

RDLOCK'HDR'BY'KEY:
        TIME'CSV = "RDLOCK'HDR'BY'KEY:" : \TIME'CSV
        RDLOCK HDR INTO HDR'REC KEY HDR'KEY
        ZZZ'REC = HDR'REC
        CALL DO'BITS
RETURN

RDLOCK'HDR:
        TIME'CSV = "RDLOCK HDR:" : \TIME'CSV
        RDLOCK HDR HDR'RCN INTO HDR'REC
        ZZZ'REC = HDR'REC
        CALL DO'BITS
        IF HDR'CTL = 0 THEN
            CALL DELETE'OLD'MBX    !!MBX will be created by MVR002
        ENDIF
RETURN

WRITE'HDR:
        TIME'CSV = "WRITE'HDR:" : \TIME'CSV
        CALL UPDATE'HDR
        REL HDR
RETURN

UPDATE'HDR:
    TIME'CSV = "UPDATE'HDR:" : \TIME'CSV
    IF ZZZ'REC # HDR'REC THEN
        IF HDR'RCN # 0 THEN
            UPDATE HDR FROM HDR'REC
            LENTRY = "UPDATE'HDR:" : \LOG'IT
        ELSE
            ENTRY = "Update attempted with record zero!"
            CALL DO'ERR
        ENDIF
        ZZZ'REC = HDR'REC
    ENDIF
RETURN

MAP1 MUSED'SPACE,S
        MAP2 MUSED'DR,B,5
        MAP2 MUSED'CR,B,5
        MAP2 MUSED'CASH,B,5

SET'WAVE'PICKING:
        TIME'CSV = "SET'WAVE'PICKING:" : \TIME'CSV
        XCALL PUTENV,"WL_SKIPDOCS=X" !!Not good for Morris, but their program
                                     !!does not look at this so it works hack way
        LOC'KNO = HDR'LOC'NO
        \VUSE LOC
        IF INC'AUTOPACK = "Y" OR (HDR'ACTION = "E" AND IN2'WL'YN = "Y") THEN
            IF HDR'QUOTE'YN # "Y" AND WLC'DOC'TYPES(HDR'DOC'TYPE) = "Y" THEN
                DO'WAVE'PICKING = MASTER'DO'WAVE'PICKING
                IF OEPACK'WAVE'PU = "N" AND DO'WAVE'PICKING # "N" THEN
                    IF HDR'VIA'NO >= OEC'SCUS'VIA AND HDR'VIA'NO <= OEC'ECUS'VIA THEN
                        DO'WAVE'PICKING = "N"
                    ENDIF
                ENDIF
                IF LOC'WL'YN # "Y" THEN
                    DO'WAVE'PICKING = "N"
                ENDIF
            ELSE
                DO'WAVE'PICKING = "N"
            ENDIF
        ELSE
            DO'WAVE'PICKING = "N"
        ENDIF
        IF DO'WAVE'PICKING = "N" THEN
            IF WL'DEBUG # "" THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Order: "
                \KERROR HDR MODE="D" APID="OE" CNO="N"
                ENTRY = ENTRY + " Wave pick not set, LOC:"+LOC'WL'YN+" IN2:"+IN2'WL'YN+" ACT:"+HDR'ACTION+" IN2:"+IN2'WL'YN+" TYPE="+WLC'DOC'TYPES(HDR'DOC'TYPE)
                \LABLOGGER ENTRY WL'DEBUG
                ENTRY = SAV'ENTRY
            ENDIF
        ELSE
            ENTRY = "wave_picking.L"+STR(HDR'LOC'NO)
            \DG GETVALUE _OESETUP ENTRY ENTRY TAGVAR="Y"
            IF DG'CTL = 0 AND ENTRY = "N" THEN
                DO'WAVE'PICKING = "N"
            ENDIF
        ENDIF
RETURN

MAP1 WL'PICKING'CC,B,1
MAP1 WL'HOB,B,1

!!The below maps are needed in DIMSUB
MAP1 DIM'MULTI'BOX,B,1
MAP1 IPC'MQID,B,4         !!Location or arbitrary number matches OE1SCL.BV
MAP1 RATE'SHOPPING,B,1

COPY "DIMSUB[OE]"  !Calculations for length, width & height for dim & oversize

OERCTL'ABORT:
        TIME'CSV = "OERCTL'ABORT:" : \TIME'CSV
        WL'HOB = 0
        IF WL'DEBUG # "" THEN
            SAV'ENTRY = ENTRY
            ENTRY = "Order: "
            \KERROR HDR MODE="D" APID="OE" CNO="N"
            ENTRY = ENTRY + " oepack in oerctl'abort OEC="+OEC'MULTI'LOC+" MF="+MULTI'FLAG+" AO="+ADD'ONE+" HOLD="+HDR'HOLD'YN
            \LABLOGGER ENTRY WL'DEBUG
            ENTRY = SAV'ENTRY
        ENDIF
        IF OEC'MULTI'LOC = "Y" AND MULTI'FLAG # 0 AND ADD'ONE # 0 THEN
            HDR'PQU'STAT = "Q"
            HDR'ACTION = SAV'ACTION
!!clear except the original order because OERCTL needs original set!
            IF FIRST'LOC'NO # HDR'LOC'NO THEN
                HDR'MULTI = 0
            ENDIF
            HDR'FFP'TOTAL = FINAL'FFP'TOTAL !![60]
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "1) HDR FFP TOTAL="+HDR'FFP'TOTAL
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            CALL UPDATE'HDR
            MUSED'CR = MUSED'CR + HDR'OLD'CR
            MUSED'DR = MUSED'DR + HDR'OLD'DR
            MUSED'CASH = MUSED'CASH + HDR'OLD'CASH
            GETNXT SHL INTO SHL'REC
            \CHKKEY SHL
            IF SHL'CTL = 0 THEN
                HDR'LOC'NO = SHL'SLOC'NO
                HDR'NO = SHL'NNO
                \SETKEY HDR MODE="KEY"
                CALL RDLOCK'HDR'BY'KEY
                IF WL'DEBUG # "" THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Order: "
                    \KERROR HDR MODE="D" APID="OE" CNO="N"
                    ENTRY = ENTRY + "SHL found, HDR'CTL="+HDR'CTL
                    \LABLOGGER ENTRY WL'DEBUG
                    ENTRY = SAV'ENTRY
                ENDIF
                IF HDR'CTL = 0 THEN
                    CMN'SAV'RCN(1) = HDR'RCN
                    GOTO SHIP'MULTI'LOC
                ELSE
                    ENTRY = "Lost multi-loc order number: "
                    \KERROR HDR MODE="K"
                    CALL DO'ERR'OEPACKL
                    GOTO CMNRTN
                ENDIF
            ENDIF
            REL SHL
            HDR'KLOC'NO = FIRST'LOC'NO
            HDR'KNO = FIRST'HDR'NO
            CALL RDLOCK'HDR'BY'KEY
            IF HDR'CTL # 0 THEN
                ENTRY = "Lost original multi-loc shipping! ":
                \KERROR HDR MODE="K"
                CALL DO'ERR'OEPACKL
                IF WL'DEBUG # "" THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Order: "
                    \KERROR HDR MODE="D" APID="OE" CNO="N"
                    ENTRY = ENTRY + "oepack lost original multi loc shipping"
                    \LABLOGGER ENTRY WL'DEBUG
                    ENTRY = SAV'ENTRY
                ENDIF
                GOTO DEAD'ABORT         !!KLUDGE
            ENDIF
            CMN'SAV'RCN(1) = HDR'RCN
        ELSE
            CALL UPDATE'HDR
            FIRST'LOC'NO = HDR'LOC'NO
        ENDIF

CHAIN'OERCTL:
!!problem is that do'oerctl=n in ostp case but when doing wl'picking'cc we
!!need to do oerctl ... but ... wl'picking'cc not set.  Easy to fix -- but,
!!what if customer puts order on hold or message and then we really don't want
!!to do cc ... grrrr ....
!!DUMP'TITLE="CHAIN'OERCTL"
!!CALL DUMP'IT
        TIME'CSV = "CHAIN'OERCTL:" : \TIME'CSV
        IF WL'DEBUG # "" THEN
            SAV'ENTRY = ENTRY
            ENTRY = "Order: "
            \KERROR HDR MODE="D" APID="OE" CNO="N"
            ENTRY = ENTRY + " oepack in chain oerctl DO="+DO'OERCTL+" CT="+DO'CALL'TAG
            \LABLOGGER ENTRY WL'DEBUG
            ENTRY = SAV'ENTRY
        ENDIF
        IF DO'OERCTL = "N" THEN
            HDR'ACTION = ""
            HDR'PQU'STAT = ""
            CALL UPDATE'HDR
            IF WBWHAP # 0 AND WBWHAP # 3 THEN WBWHAP = 2
            GOTO CMNRTN
        ENDIF
        IF WBWHAP # 0 THEN
            DO'CALL'TAG = "N"
        ENDIF
        IF DO'CALL'TAG = "Y" THEN
!!NOTE: COPY BOX STUFF TO CALFIL AND GOTO ABORT (WHEN U STUFF IT HAVE
!!IT CLEAR ALL FREIGHT FIELDS IN BOX)
!!CALL TAG AMOUNT IN SPECIAL FIELD?  (FROM INC'CONTROL RECORD ...)
!!NOTE: THIS COMMENT ALSO IN OE1SHP AND MEANS WHAT?
            GOTO ABORT
        ENDIF
        IF WL'DEBUG # "" THEN
            SAV'ENTRY = ENTRY
            ENTRY = "Order: "
            \KERROR HDR MODE="D" APID="OE" CNO="N"
            ENTRY = ENTRY + " oepack calling set wave picking 2 pqu="+HDR'PQU'STAT+" action="+HDR'ACTION
            \LABLOGGER ENTRY WL'DEBUG
            ENTRY = SAV'ENTRY
        ENDIF
        CALL SET'WAVE'PICKING
        IF HDR'PQU'STAT # "Q" OR HDR'ACTION = "" THEN
                HDR'PQU'STAT = "Q"
                HDR'ACTION = SAV'ACTION
                IF DO'WAVE'PICKING # "Y" THEN
                    CALL UPDATE'HDR
                ENDIF
        ENDIF
        IF DO'WAVE'PICKING = "Y" AND HDR'ACTION # "L" THEN
            IF IN2'WL'YN = "Y" AND WLC'USE'VFH'YN = "Y" THEN
!!One Stop only
                IF HDR'QUOTE'YN = "Y" GOTO NORMAL'WLQ        !!KLUDGE
                TRH'KNO = HDR'TRH'NO
                \VUSE TRH
                IF TRH'CTL # 0 THEN
                    ENTRY = "Terms not found place 11: "+STR(TRH'KNO)
                    CALL DO'ERR
                    GOTO ABORT
                ENDIF
                IF TRH'CTP'NO = 0 GOTO NORMAL'WLQ
                XCALL PUTENV,"WL_SKIPDOCS=N"
                WL'PICKING'CC = 1
                IF WL'DEBUG # "" THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Credit card order"
                    \HDRERR
                    ENTRY = ENTRY + " ML="+OEC'MULTI'LOC+" MF="+MULTI'FLAG+" AO="+ADD'ONE
                    \LABLOGGER ENTRY WL'DEBUG
                    ENTRY = SAV'ENTRY
                ENDIF
!!Should fall through and do OERCTL for CC
            ELSE
!!Everyone else
              NORMAL'WLQ:
                IF WL'DEBUG # "" THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Standard order"
                    \HDRERR
                    ENTRY = ENTRY + " ML="+OEC'MULTI'LOC+" MF="+MULTI'FLAG+" AO="+ADD'ONE
                    \LABLOGGER ENTRY WL'DEBUG
                    ENTRY = SAV'ENTRY
                ENDIF
                CALL UPDATE'HDR
!!If multi still need oerctl to do the other locations that are HOB-like
!!NOTE: coded now so "real" location MUST be first and is only one
!!      will need MORE code and thought if they add another real location DUH!
!!
                IF WL'DEBUG # "" THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Add WLQ WAVE0 without HDRLNK: "
                    \KERROR HDR MODE="D" APID="OE" CNO="N"
                    \LABLOGGER ENTRY WL'DEBUG
                    ENTRY = SAV'ENTRY
                ENDIF
                CALL ADD'WLQ'RECORD
                WL'HOB = WL'HOB + SF
                REL WLQ
!!SF=0 means not HOB, SF=1 is HOB
                IF SF = 0 AND (INC'AUTOPACK = "Y" OR ACTION = "E") AND &
                                            HDR'QUOTE'YN # "Y" THEN
                  IF OEC'MULTI'LOC # "Y" OR MULTI'FLAG = 0 OR ADD'ONE = 0 THEN
!!We don't have multi-loc OR not a multi-loc order or we did a split (ADD'ONE)
!!not a split order -- go back to order entry
!!
                      IF WL'HOB = 1 GOTO NORMAL'OERCTL        !!KLUDGE
                      GOTO CMNRTN2                  !!KLUDGE
                  ELSE
                    DD = SHL'RCN
                    SHL'LOC'NO = FIRST'LOC'NO
                    SHL'DOC'TYPE = HDR'DOC'TYPE
                    SHL'NO = FIRST'HDR'NO
                    SHL'SLOC'NO = 0
                    \SETKEY SHL MODE="KEY"
                    USE SHL INTO SHL'REC KEY SHL'KEY
                    DO
                        GETNXT SHL INTO SHL'REC
                        \CHKKEY SHL
                        IF SHL'CTL # 0 EXIT
                        IF SHL'SLOC'NO = SHL'LOC'NO REPEAT
                        HDR'NO = SHL'NNO
                        HDR'LOC'NO = SHL'SLOC'NO
                        \SETKEY HDR MODE="KEY"
                        CALL RDLOCK'HDR'BY'KEY
                        IF HDR'CTL = 0 THEN
                            CALL UPDATE'HDR
                            CALL ADD'WLQ'RECORD
                            REL WLQ
                            REL HDR
                            WL'HOB = WL'HOB + SF
!!SF=0 means not HOB, SF=1 is HOB
                        ENDIF
                    LOOP
                    USE SHL DD INTO SHL'REC
                    IF SHL'CTL # 0 THEN
                        ENTRY = "Program error DD:"
                        \HDRERR
                        CALL DO'ERR'OEPACK
                        GOTO ABORT
                    ENDIF
                    \SETKEY SHL MODE="KEY"
                    USE SHL INTO SHL'REC KEY SHL'KEY
                    GETNXT SHL INTO SHL'REC
                    IF WL'HOB = 1 GOTO NORMAL'OERCTL        !!KLUDGE
                    RETURN                            !!More to go
                  ENDIF
                ENDIF
!!Should fall through and do OERCTL for HOB
            ENDIF
        ENDIF
    NORMAL'OERCTL:
        TIME'CSV = "NORMAL'OERCTL:" : \TIME'CSV
        LST'REC = BILL'REC
        IF (LOC'INV'BGP > 0 AND HDR'ACTION = "P")                       OR &
           (LOC'PICK'BGP > 0 AND HDR'ACTION # "P")                      THEN
                TST="C"
            IF OEC'TASK'YN # "Y" THEN
                XCALL PRTQUE,TST
            ENDIF
        ELSE
            TST = "N"
        ENDIF
        IF WL'DEBUG # "" THEN
            SAV'ENTRY = ENTRY
            XCALL GETENV,"WL_SKIPDOCS",ENTRY
            ENTRY = "oepack HDRLNK ("+ENTRY+")"+": "
            \KERROR HDR MODE="D" APID="OE" CNO="N"
            ENTRY = ENTRY + " tst="+TST+" cc="+WL'PICKING'CC+" action="+HDR'ACTION+" WP="+DO'WAVE'PICKING
            ENTRY = ENTRY + " ML="+OEC'MULTI'LOC+" MF="+MULTI'FLAG+" AO="+ADD'ONE+" RCN="+CMN'SAV'RCN(1)+" O="+STR(HDR'LOC'NO)+"-"+STR(HDR'NO)
            \LABLOGGER ENTRY WL'DEBUG
            ENTRY = SAV'ENTRY
        ENDIF
        IF TST="N" THEN
            MAP1 SAV'RCN,B,4
            SAV'RCN = CMN'SAV'RCN(1)
!!          IF WL'PICKING'CC # 1 THEN    !!Ask Will before removing
!!              CALL RELS
!!              IF HDR'ACTION # "L" THEN
!!                  CALL FINAL'CLEANUP                         !!BEFORE SNDCMN
!!              ENDIF
!!          ENDIF
            CMN'TO'PRGNAM="LINK"
            SNDCMN CMN'REC
            ENTRY = "OERCTL"
MAP1 SACTION,S,1
MAP1 SORDNO,B,3
            IF HDR'LIN'BO # 0 THEN    !!To check if we want to print ticket for BOs when done
                SACTION = HDR'ACTION
                SORDNO = HDR'NO
            ELSE
                SACTION = "N"
                SORDNO = 0
            ENDIF
            \HDRLNK 1                    !!CALLS OERCTL
            GETCMN CMN'REC

            XCALL PUTENV,"WL_SKIPDOCS=X"
            HDR'FFP'TOTAL = FINAL'FFP'TOTAL !![60]
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "2) HDR FFP TOTAL="+HDR'FFP'TOTAL
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            IF DO'WAVE'PICKING = "Y" THEN
                RDLOCK HDR SAV'RCN INTO HDR'REC
                IF HDR'CTL # 0 THEN
                    HDR'KLOC'NO = FIRST'LOC'NO
                    HDR'KDOC'TYPE = SHL'DOC'TYPE
                    HDR'KNO = FIRST'HDR'NO
                    RDKEY HDR
                    IF HDR'CTL # 0 THEN
                        WLQ'SPACE = SPACE
                        WLQ'LOC'NO = HDR'KLOC'NO
                        WLQ'DOC'TYPE = HDR'KDOC'TYPE
                        WLQ'HDR'NO = HDR'KNO
                        WLQ'SHIPMENT = 1
                        \SETKEY WLQ MODE="KEY" APID="WL"
                        IF WL'DEBUG # "" THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "HDRLNK order gone, no lines left, del WLQ"
                            \KERROR WLQ MODE="K" APID="WL" CNO="N"
                            \LABLOGGER ENTRY WL'DEBUG
                            ENTRY = SAV'ENTRY
                        ENDIF
                        CALL DELETE'WLQ
                    ELSE
                        IF WL'DEBUG # "" THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "HDRLNK order gone, no lines left, HDR there?"
                            \KERROR HDR MODE="K" APID="OE" CNO="N"
                            \LABLOGGER ENTRY WL'DEBUG
                            ENTRY = SAV'ENTRY
                        ENDIF
                    ENDIF
                ELSE
                    IF WL'DEBUG # "" THEN
                        SAV'ENTRY = ENTRY
                        ENTRY = "FROM="+CMN'FRM'PRGNAM+" OTHER="+CMN'OTHER
                        \LABLOGGER ENTRY WL'DEBUG
                        ENTRY = SAV'ENTRY
                    ENDIF
                    IF CMN'FRM'PRGNAM # "GOOD" THEN
                        IF CMN'OTHER = "" THEN
                            CMN'OTHER = "Unexplained CC error"
                        ENDIF
                        ENTRY = CMN'FRM'PRGNAM + ": " + CMN'OTHER
                        IF ENTRY = "" THEN
                            ENTRY = "Link to oerctl failed"
                        ENDIF
                        IF WL'DEBUG # "" THEN
                            SAV'ENTRY = ENTRY
                            \HDRERR
                            \LABLOGGER ENTRY WL'DEBUG
                            ENTRY = SAV'ENTRY
                        ENDIF
                        CALL DO'ERR
                        GOTO ABORT
                    ELSE
                        IF WL'DEBUG # "" THEN
                            SAV'ENTRY = ENTRY
                            IF WL'PICKING'CC # 1 THEN
                                ENTRY = "Order posted correctly"
                            ELSE
                                ENTRY = "Credit card passed and orders ran"
                            ENDIF
                            \HDRERR
                            \LABLOGGER ENTRY WL'DEBUG
                            ENTRY = SAV'ENTRY
                        ENDIF
                    ENDIF
                    IF WL'DEBUG # "" THEN
                        SAV'ENTRY = ENTRY
                        ENTRY = "Add WLQ after HDRLNK: "
                        \KERROR HDR MODE="D" APID="OE" CNO="N"
                        \LABLOGGER ENTRY WL'DEBUG
                        ENTRY = SAV'ENTRY
                    ENDIF
                    CALL ADD'WLQ'RECORD
                    REL WLQ
                ENDIF
                IF (INC'AUTOPACK = "Y" OR ACTION = "E") AND &
                                            HDR'QUOTE'YN # "Y" THEN
                  IF OEC'MULTI'LOC # "Y" OR MULTI'FLAG = 0 OR ADD'ONE = 0 THEN
                      GOTO CMNRTN2            !!KLUDGE, done
                  ELSE
                      RETURN                  !!KLUDGE, more to do
                  ENDIF
                ENDIF
                CALL RELS
                CALL FINAL'CLEANUP
            ELSE
                IF IS'MAX'CR'DR'ZERO # "Y" THEN  !!Someone change the CR $ to zero on Func P
                    IF HDR'DOC'TYPE = 1 THEN      !!don't call for type 4's, etc
                        CALL ADD'UPDATE'CMA'RECORD
                    ENDIF
                ENDIF
            IF SACTION = "P" THEN
                XCALL GETENV,"OEPACK_REPICK_BO",ENTRY
                IF ENTRY = "Y" THEN
                    RDLOCK HDR SAV'RCN INTO HDR'REC
                    IF HDR'CTL = 0 AND HDR'LIN'BO # 0 AND HDR'NO = SORDNO THEN
                        ENTRY = "Print remaining backorders on a pick ticket?"
                        \L24CHR NOMSG="Y" CLR="Y"
                        IF UCS(ENTRY) = "Y" THEN
                            HDR'ACTION = "E"
                            HDR'PQU'STAT = "Q"
                            CALL UPDATE'HDR
                            \HDRLNK 1        !!CALLS OERCTL A 2ND TIME FOR PICKING
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
            ENDIF
        ELSE
MAP1 QNO,B,5
                ENTRY = STR(HDR'DOC'TYPE)+STR(HDR'NO) USING "#######"
                QNO = ENTRY
                VIL'SPACE = SPACE
                VIL'KVIA'NO = HDR'VIA'NO
                VIL'KLOC'NO = HDR'LOC'NO
                \VUSE VIL
                II = LOC'INV'BGP
                IF HDR'ACTION = "P" THEN
                        LOC'INV'BGP = (LOC'INV'BGP - VIL'BGP'OFFSET) MAX 1
                ELSE
                        LOC'INV'BGP = (LOC'PICK'BGP - VIL'BGP'OFFSET) MAX 1
                ENDIF
                \PUTQUE TST """OERCTL""" LOC'INV'BGP HDR'RCN QNO OE'TEST="Y"
                LOC'INV'BGP = II
                IF DO'WAVE'PICKING = "Y" THEN
                    CALL ADD'WLQ'RECORD
                    REL WLQ
                    CALL UPDATE'HDR
                ENDIF
                IF OEC'MULTI'LOC # "Y" OR MULTI'FLAG = 0 OR ADD'ONE = 0 THEN
                    GOTO CMNRTN2            !!KLUDGE, done
                ELSE
                    RETURN                  !!KLUDGE, more to do
                ENDIF
        ENDIF
        IF INX2 = FN'L THEN
            RETURN
        ENDIF
        TIME'CSV = "GOTO CMNRTN" : \TIME'CSV
GOTO CMNRTN

ADD'WLQ'RECORD:
    TIME'CSV = "ADD'WLQ'RECORD:" : \TIME'CSV
    SF = 0                           !!Not HOB
    IF HDR'QUOTE'YN = "Y" RETURN            !!KLUDGE
    IF TOTALS'ONLY = "Y" RETURN             !!KLUDGE
    IF HDR'HOLD'YN # "O" AND HDR'HOLD'YN # "N" THEN
        IF WL'DEBUG # "" THEN
            SAV'ENTRY = ENTRY
            ENTRY = "WLQ not added"
            \HDRERR
            ENTRY = ENTRY + " hold=" + HDR'HOLD'YN
            \LABLOGGER ENTRY WL'DEBUG
            ENTRY = SAV'ENTRY
        ENDIF
        RETURN            !!KLUDGE
    ENDIF
    XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY
    IF ENTRY = "" THEN
        XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PICK_MIN_CCFRT",ENTRY
        IF ENTRY # "" THEN
            SF = 1                        !!HOB
            RETURN                        !!KLUDGE (HOB does not go on WLQ)
        ENDIF
    ELSE
        SF = 1                            !!HOB
        RETURN                            !!KLUDGE (HOB does not go on WLQ)
    ENDIF
    IF INC'AUTOPACK = "Y" THEN
        BOX'SPACE = SPACE
        BOX'HDR'LOC'NO = HDR'LOC'NO
        BOX'DOC'TYPE = HDR'DOC'TYPE
        BOX'HDR'NO = HDR'NO
        BOX'NO = 1
        BOX'SHIPMENT = HDR'SHIPMENT + 1
        \SETKEY BOX MODE="KEY"
        USE BOX INTO BOX'REC KEY BOX'KEY
        IF BOX'CTL # 0 THEN
            ENTRY = "No boxes when trying to put on queue!"
            \HDRERR
            CALL DO'ERR'OEPACKL
            ENTRY = "Not added to queue!"
            GOTO DO'ERR
        ENDIF
        HWEIGHT = 0            !!Just re-used variable
        DO
            GETNXT BOX
            \CHKKEY BOX
            IF BOX'CTL # 0 EXIT
            HWEIGHT = HWEIGHT + BOX'WEIGHT
        LOOP
        IF HWEIGHT # HDR'WEIGHT THEN
            ENTRY = "Box weight ("+(HWEIGHT/100 USING "###.##")+") not matching hdr (" + &
                                            (HDR'WEIGHT/100 USING "###.##")+")"
            \HDRERR
            CALL DO'ERR'OEPACKL
            ENTRY = "Not added to queue!"
            GOTO DO'ERR
        ENDIF
    ENDIF
    WLQ'SPACE = SPACE
    WLQ'LOC'NO = HDR'LOC'NO
    WLQ'DOC'TYPE = HDR'DOC'TYPE
    WLQ'HDR'NO = HDR'NO
    WLQ'SHIPMENT = HDR'SHIPMENT + 1
    \SETKEY WLQ MODE="KEY" APID="WL"
    CALL DELETE'WLQ
    WLQ'CRID = UB'UID
    \S'TO'U WLQ'CRUDT
    WLQ'LAST'UDT = WLQ'CRUDT
    WLQ'HDR'RCN = HDR'RCN
!!  WLQ'PRINT'UDT = 0
!!  WLQ'REASON = 0
    WLQ'STAT = "R"      !!ready to print
!!  WLQ'LAST'UDT = 0
!!  WLQ'TSTAMP = 0
!!  WLQ'MSGNO = 0
    \HASHOEHDR WLQ'HASH
!!  WLQ'FILLER = SPACE
    \SETKEY WLQ MODE="KEY" APID="WL"
    ADDL WLQ FROM WLQ'REC KEY WLQ'KEY
    SF = 0
    IF WLQ'CTL # 0 THEN
        SAV'ENTRY = ENTRY
        ENTRY = "Order: "
        \KERROR HDR MODE="D" APID="OE" CNO="N"
        ENTRY = ENTRY + " NOT added to WLQ in oepack ctl="+WLQ'CTL
        IF WL'DEBUG # "" THEN
            \LABLOGGER ENTRY WL'DEBUG
            ENTRY = SAV'ENTRY
        ENDIF
        GOTO DO'ERR                                    !!KLUDGE
    ELSE
        IF IS'MAX'CR'DR'ZERO # "Y" THEN  !!Someone change the CR $ to zero on Func P
            IF HDR'DOC'TYPE = 1 THEN      !!don't call for type 4's, etc
                CALL ADD'UPDATE'CMA'RECORD
            ENDIF
        ENDIF
    ENDIF
    IF WL'DEBUG # "" THEN
        SAV'ENTRY = ENTRY
        ENTRY = "Order: "
        \KERROR HDR MODE="D" APID="OE" CNO="N"
        ENTRY = ENTRY + " added to WLQ in oepack ctl="+WLQ'CTL
        \LABLOGGER ENTRY WL'DEBUG
        ENTRY = SAV'ENTRY
    ENDIF
RETURN

DELETE'WLQ:
        TIME'CSV = "DELETE'WLQ:" : \TIME'CSV
        VFDO'KVFH'LOC'NO = HDR'LOC'NO
        VFDO'KDOC'TYPE = HDR'DOC'TYPE
        VFDO'KHDR'NO = HDR'NO
        VFDO'KSHIPMENT = HDR'SHIPMENT + 1
        VFDO'KLS = "L"
        RDKEY VFDO
        IF VFDO'CTL = 0 THEN
            RDLOCK VFD VFDO'RCN INTO VFD'REC
            IF VFD'CTL = 0 THEN
                \SETKEY VFD MODE="ALL" APID="WL"
                \DELKEY VFD MODE="ALL" APID="WL"
                DELETE VFD
            ENDIF
        ENDIF
        VFDO'KLS = "S"
        RDKEY VFDO
        IF VFDO'CTL = 0 THEN
            RDLOCK VFD VFDO'RCN INTO VFD'REC
            IF VFD'CTL = 0 THEN
                \SETKEY VFD MODE="ALL" APID="WL"
                \DELKEY VFD MODE="ALL" APID="WL"
                DELETE VFD
            ENDIF
        ENDIF
        RDLOCK WLQ INTO WLQ'REC KEY WLQ'KEY
        IF WLQ'CTL = 0 THEN
            ENTRY = "Delete WLQ repack: "
            \KERROR HDR MODE="D" CNO="N"
            \ABLOGGER ENTRY """/logs/rare.DAILY"""
            IF WLQ'MSGNO # 0 THEN
                DELMSG WLQ'MSGNO "WLMSG"
            ENDIF
            \SETKEY WLQ MODE="KY2" APID="WL"
            \DELKEY WLQ MODE="ALL" APID="WL"
            DELETE WLQ
            IF WL'DEBUG # "" THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Order: "
                \KERROR HDR MODE="D" APID="OE" CNO="N"
                ENTRY = ENTRY + " DELETED from oepack"
                \LABLOGGER ENTRY WL'DEBUG
                \ABLOGGER ENTRY """/logs/wlddel.DAILY"""
                ENTRY = SAV'ENTRY
            ENDIF
        ENDIF
RETURN

DEAD'ABORT:
        TIME'CSV = "DEAD'ABORT:" : \TIME'CSV
        IF |PGODS| AND DBG'LEVEL <> 0 THEN    !!Leave this PGOD in
!!For debug purposes this saves boxes from an abort only programmers can do
!!this ...
            IF WBWHAP # 0 THEN
                WBWHAP = 3
                INX1 = I'RT
                ENTRY = "Y"
            ELSE
                PRINT TAB(23,1) ; TAB(-1,10) ; TAB(-1,A'NORM);
                ENTRY = "'Y' to see boxes: "
                \L24CHR CLR="Y"
            ENDIF
            IF INX1 = I'RT AND UCS(ENTRY) = "Y" THEN
!![23] - all the below fudging
                NEED'CREATE'ARECS = 1
                JJ = 0
                XKEY = ""
                DO
                    XCALL VICSIT,7,4,XREC,XKEY,XPTR,0,XCTL !!GETNXT
                    IF XCTL # 0 EXIT
                    JJ = JJ + 1
                    CALL FILL'BXL'FROM'XREC
                LOOP
                IF JJ = 0 THEN
                    XKEY = ""
                    DO
                        XCALL VICSIT,7,4,XREC,XKEY,SAVXPTR,0,XCTL    !!getnxt
                        IF XCTL # 0 EXIT
                        XCALL VICSIT,7,2,XREC,XKEY,XPTR,0,XCTL !!ADD/UPDATE
                    LOOP
                ENDIF
                IF WBWHAP = 0 THEN
                    CALL SAVE'LOOK'SEE
                    GOTO LOOK'SEE
                ENDIF
            ENDIF
        ENDIF
        CTRLC'ABORT = 1

USER'ABORT:                !!Maybe this belongs at OERCTL'ABORT was only used for ENDICIA
ABORT:
        TIME'CSV = "ABORT:" : \TIME'CSV
        HDR'ACTION = SPACE
        HDR'PQU'STAT = ""
        CALL UPDATE'HDR
        IF WBWHAP # 0 THEN
            WBWHAP = 3
        ENDIF
CMNRTN:
        TIME'CSV = "CMNRTN:" : \TIME'CSV
        IF INX2 = FN'W AND CTRLC'ABORT = 0 AND WBWHAP = 0 THEN
                CMN'SPACE = SPACE
                CMN'TO'PRGNAM = "OE1HDR"
                CMN'FRM'PRGNAM = "EXTRNL"
                CMN'SAV'RCN(1) = HDR'RCN
                IF LOCAL'SHIP = 1 THEN CMN'LEVEL = 7
                IF MULTI'FLAG = 1 CALL DELETE'SHL
                CALL RELS
                CALL FINAL'CLEANUP
                IF LINKED # 1 THEN
                    SNDCMN CMN'REC
                    CHAIN "OE1HDR"
                ENDIF
                \HDRLNK 3
                END
        ENDIF
        IF MULTI'FLAG = 1 CALL DELETE'SHL
CMNRTN2:
        TIME'CSV = "CMNRTN2:" : \TIME'CSV
        CALL RELS
        CALL FINAL'CLEANUP
        IF LOCAL'SHIP = 1 AND CTRLC'ABORT = 0 AND WBWHAP = 0 THEN
                IF CHAIN'BETWEEN # "Y" THEN
                        GOTO BEGIN'SHIP
                ELSE
!                       IF V''SYSTEM="UNIX" THEN
                                ENTRY = "/tmp/oepack.pass."+STR(V''JOBNUM)
                                LOOKUP ENTRY,QFACTOR
                                IF QFACTOR = 0 THEN
                                        ALLOCATE ENTRY,50
                                ELSE
                                IF ABS(QFACTOR) < 50 THEN
                                        KILL ENTRY
                                        ALLOCATE ENTRY,50
                                ENDIF
                                ENDIF
                                OPEN #1717,ENTRY,RANDOM,512,II
                                PFACTOR = (INT(LEN(PASSED'PRH'ARRAY)/512)*512)+512
                                II = 0
                                FOR QFACTOR = 1 TO PFACTOR STEP 512
                                        WRITE #1717,PASSED'PRH'ARRAY[QFACTOR;512]
                                        II = II + 1
                                NEXT QFACTOR
                                CLOSE #1717
                                PTR'YES = "YYY"
!                       ELSE
!                               PTR'YES = "NNN"
!                       ENDIF
                        V''UNUSED(1) = HDR'REC
                        SNDCMN PTR'PASS
                        CHAIN "OEPACK"
                ENDIF
        ENDIF
        IF LINKED = 1 THEN
            \HDRLNK 3
        ELSE
        IF WBWHAP # 0 THEN
                CMN'SPACE = SPACE
                CMN'TO'PRGNAM = "WBWHAP"
                IF WBWHAP = 2 THEN
                    CMN'FRM'PRGNAM = "GOOD"
                ELSE
                    CMN'OTHER = ENTRY'OEPACK
                    IF WBWHAP = 3 THEN
                        CMN'FRM'PRGNAM = "ABORT"
                    ELSE
!!                      CMN'OTHER = ENTRY
                        CMN'FRM'PRGNAM = "ERROR"
                    ENDIF
                ENDIF
                IF MBXERROR'COUNT > 0 THEN    !!If any box rate failed send ABORT
                    IF TOTALS'ONLY = "Y" THEN
                        CMN'FRM'PRGNAM = "ABORT"
                    ELSE
                        CMN'FRM'PRGNAM = "ERROR"
                    ENDIF
                    CMN'LASTFN(6) = 111        !!Rate Shop Error flag
                ENDIF
SNDCMN1:

                !!Pass PID from OEPACK to OrderCreate call in WBXMLC
                CMN'SAV'RCN(6) = SND'MY'PID

                SNDCMN CMN'REC
                !!Really linked ... fall thru to END below
        ELSE
        IF CMN'FRM'PRGNAM # "OE2CRM" AND CMN'FRM'PRGNAM # "OE2CRE" THEN
                \CMNRTN
        ENDIF
        ENDIF
        ENDIF
        TIME'CSV = "FINAL END" : \TIME'CSV
        LENTRY = "FINAL END" : \LOG'IT
FINAL'END:
END                                                     !!NOT RETURN

FINAL'CLEANUP:
        TIME'CSV = "FINAL'CLEANUP:" : \TIME'CSV
        LIN'CACHED = 0
        XCALL VICSIT,7,9,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!CLEAR
        CALL CLEAR'BOX'CACHES
        MUSED'SPACE = SPACE
RETURN

RELS:
        TIME'CSV = "RELS:" : \TIME'CSV
        HDR'RCN = 0 : REL HDR
        IF MASTER'DO'WAVE'PICKING = "Y" THEN    !!Conservative - release
                                                !!if wave possible
            WLQ'RCN = 0 : REL WLQ
        ENDIF
!!I think my locking is clean enough not to need the below RELS.
!!      LIN'RCN = 0 : REL LIN
!!      IF INC'AUTOPACK = "Y" THEN
!!              BXL'RCN = 0 : REL BXL
!!      ENDIF
!!      BOX'RCN = 0 : REL BOX
RETURN

DELETE'SHL:
        TIME'CSV = "DELETE'SHL:" : \TIME'CSV
        SHL'LOC'NO = FIRST'LOC'NO
        SHL'DOC'TYPE = HDR'DOC'TYPE
        SHL'NO = FIRST'HDR'NO
        SHL'SLOC'NO = 0
        \SETKEY SHL MODE="KEY"
        IF WBWHAP = 0 THEN
            \DELOOP PRE="SHL" DSP="Y" ACTION="CLEAR'PQU'STAT"
        ELSE
            \DELOOP PRE="SHL" DSP="N" ACTION="CLEAR'PQU'STAT"
        ENDIF
        LIN'KHDR'LOC'NO = FIRST'LOC'NO
        LIN'KDOC'TYPE = HDR'DOC'TYPE
        LIN'KHDR'NO = FIRST'HDR'NO
        LIN'KNO = 1
        RDKEY LIN
        GETNXT LIN
        LIN'KEY = LIN'KEY2
        IF LIN'KHDR'LOC'NO # FIRST'LOC'NO OR LIN'KDOC'TYPE # HDR'DOC'TYPE OR &
                           LIN'KHDR'NO # FIRST'HDR'NO OR LIN'CTL # 0 THEN
                HDR'LOC'NO = FIRST'LOC'NO
                HDR'NO = FIRST'HDR'NO
                \SETKEY HDR MODE="KEY"
                CALL RDLOCK'HDR'BY'KEY
                IF HDR'CTL = 0 THEN
                        \SETKEY HDR MODE="KY2"
                        \DELKEY HDR MODE="ALL"
                        DELETE HDR
                        !![216] Below ATQ stuff
                        IF INC'USE'CV = "Y" AND TOTALS'ONLY # "Y" THEN
                                \UCNVATQ AKEY="Y"
                                RDKEY ATQT
                                IF ATQT'CTL = 0 THEN
                                        RDLOCK ATQ ATQT'RCN INTO ATQ'REC
                                        \CHKKEY ATQT LASTFIX="SPECIAL" APID="CV"
                                        IF ATQ'CTL # 0 THEN
                                                ENTRY = "Unable to delete ATQ record "
                                                \HDRERR
                                                CALL DO'ERR'OEPACKL
                                        ELSE
                                                \SETKEY ATQ APID="CV" MODE="ALL"
                                                \DELKEY ATQ APID="CV" MODE="ALL"
                                                DELETE ATQ
                                        ENDIF
                                ENDIF
                        ENDIF
                ENDIF
        ENDIF
RETURN

E'LOC'NO:
        \TABC FROM="WRH" ON="LOC" APID="IN" VCACHE="LOCPTR"
RETURN

E'DOC'TYPE:                                     !![132] - test internal credit.
        \TSTF
        IF INC'AUTOPACK = "Y" OR HDR'ACTION = "E" OR HDR'ACTION = "L" THEN
            \TABDOCTYPE WRH'DOC'TYPE EXITDSP="(7,40),(7,56)"
        ELSE
            \TABDOCTYPE WRH'DOC'TYPE EXITDSP="(1,44),(1,60)"
        ENDIF
        IF HDR'DOC'TYPE = OEC'INT'CR THEN
            ENTRY = "Internal Credit not allowed!"
            CALL DO'ERR
        ENDIF
RETURN

PRE'DSP'DOC'DESC:
        TIME'CSV = "PRE'DSP'DOC'DESC:" : \TIME'CSV
        II = WRH'DOC'TYPE
        IF LOC'TYP'DESC(II) = "" THEN LOC'TYP'DESC(II) = "Invalid?"
        CALL DSP'DOC'DESC
RETURN

COPYF "HDRFIL",=HDR2,NOAFR
MAP1 ORG'VIA'NO,B,2
MAP1 ORG'BVIA'NO,B,2
\COPYF CUS AR MODE="PRI"

FIND'CUS:
    TIME'CSV = "FIND'CUS:" : \TIME'CSV
    CUS'KNO = HDR'NAM'NO
    \VUSE CUS
    IF CUS'CTL # 0 THEN
        ENTRY = "Customer not found on "+HDR'NO+"-"+HDR'ACTION
        TIME'CSV = "FIND'CUS: " + ENTRY : \TIME'CSV
        CALL DO'ERR'OEPACK
        GOTO DEAD'ABORT
    ENDIF
RETURN

SPECIAL'READCTL:
        TIME'CSV = "SPECIAL'READCTL:" : \TIME'CSV
        FFP'SUMMED = 0
        ORG'BIT'FLAG = HDR'BIT'FLAG
        CALL FIND'CUS
        CALL CHECK'FOR'WB'FF
        CALL FIND'FOB
        LOC'KNO = HDR'LOC'NO
        CALL FIND'LOC
        IF LOC'CTL # 0 THEN
                ENTRY = "Location not found on "+HDR'NO+"-"+HDR'ACTION+" "+LOC'KNO
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
        ENDIF
        ORG'VIA'NO = HDR'VIA'NO
        ORG'BVIA'NO = HDR'BVIA'NO
        VIA'KNO = HDR'VIA'NO
        DO'CALL'TAG = "N"               !!Clear for new order
        CALL FIND'VIA
        AVIA'REC = VIA'REC
        IF AVIA'RES'VIA'NO # 0 THEN
            CALL SET'LST'RECORDS
        ENDIF
        IF HDR'BVIA'NO = 0 THEN
            IF VIA'CVIA'NO # 0 THEN
                HDR'BVIA'NO = VIA'CVIA'NO
            ELSE
                HDR'BVIA'NO = HDR'VIA'NO
            ENDIF
        ENDIF
        VIA'KNO = HDR'BVIA'NO
        CALL FIND'VIA
        BVIA'REC = VIA'REC
        VIA'REC = AVIA'REC              !!LEAVE ON ACTUAL
        IF TRH'NO # HDR'TRH'NO THEN
            TRH'KNO = HDR'TRH'NO
            \VUSE TRH
            IF TRH'CTL # 0 THEN
                ENTRY = "Invalid terms on "+HDR'NO+"-"+HDR'ACTION
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
            ENDIF
        ENDIF
MAP1 CASH'TERMS,S,1
MAP1 PSEUDO'CASH'TERMS,S,1
        IF OEC'INV'UPS'YN = "N" CALL ADD'CON
        IF HDR'PROC < 5 AND INC'AUTOPACK = "N" THEN
                IF TRM'NO # HDR'TRH'NO THEN
                        TRM'KNO = HDR'TRH'NO
                        TRM'KCASE = 0
                        TRM'KSEQ = 0
                        USE TRM INTO TRM'REC KEY TRM'KEY
                        GETNXT TRM INTO TRM'REC
                ENDIF
                IF TRM'NO # HDR'TRH'NO OR TRM'CTL # 0 THEN
                        ENTRY = "Invalid terms (C): "+TRM'KNO
                        CALL DO'ERR'OEPACKL
                        GOTO DEAD'ABORT
                ENDIF
                IF TRM'DUE'DAYS = 0 THEN
                        CASH'TERMS = "Y"
                ELSE
                        CASH'TERMS = "N"
                ENDIF
                PSEUDO'CASH'TERMS = CASH'TERMS
                IF OC2'ESTIM'FRT = "Y" THEN
                    PSEUDO'CASH'TERMS = "Y"
                ENDIF
!!Always charge actual freight for Fedex
                IF VIA'MTYPE = "F" THEN
                    PSEUDO'CASH'TERMS = "N"
                ENDIF
!![55] Removed setting of DO'CALL'TAG from here because we can change the
!!     via in here and this could make call tags valid/invalid.
!!
!!
        ENDIF
!!USED TO CALL SET'LST'RECORDS, NOT NEEDED IF NO DISPLAY
!!USED TO CHECK CREDIT, NOT NEEDED AS IT CHECKS AT THE END
!!      IF HDR'ACTION = "P" THEN
!!              IF OEC'HOLD'COM # "Y" THEN
!!                      CALL TEST'HOLDS
!!                      IF IER1 # 1 GOTO ABORT
!!              ENDIF
!!      ENDIF
        UOW'KNO = VIA'UOW'NO

        CALL FIND'UOW
        UOW2'DUNITS = UOW'DUNITS
        UOW2'NUNITS = UOW'NUNITS

        IF OEC'REPRICE = "Y" AND &
         (INC'AUTOPACK = "Y" OR HDR'ACTION = "E" OR HDR'ACTION = "L") THEN
                CALL RE'PRICE'HDR
                IF SF = 0 THEN
                    CALL RE'TOTAL'HDR
                    HDR'FFP'TOTAL = FINAL'FFP'TOTAL !![60]
                    IF DO'EXCUSE = 1 THEN
                        SAV'ENTRY = ENTRY
                        ENTRY = "3) HDR FFP TOTAL="+HDR'FFP'TOTAL
                        CALL DO'EXCUSE'LOG
                        ENTRY = SAV'ENTRY
                    ENDIF
                    CALL UPDATE'HDR
                ENDIF
        ENDIF
        IF OEC'DUPS > 1 AND (INC'AUTOPACK = "Y" OR &
                            HDR'ACTION = "L" OR HDR'ACTION = "E") THEN
                CALL CHECK'DUPS
        ENDIF

        CALL FIX'SPECIAL'TYPES

        CASE
        IF OEC'MULTI'LOC = "Y" AND HDR'MULTI # 0 AND (INC'AUTOPACK = "Y" OR &
                              HDR'ACTION = "L" OR HDR'ACTION = "E") THEN
!!OR &
!!                              WBWHAP = 1 THEN
           MAP1 MULTI'FLAG,B,1
           MAP1 FIRST'HDR'NO,B,3
           MAP1 FIRST'LOC'NO,B,2
           MAP1 HDRL'FLAG,B,1
           MAP1 LINL'FLAG,B,1
           MAP1 TMP'TOTAL,B,5
           MAP1 TBOX'CNT,B,5
           MAP1 PRICE,B,5
           MAP1 DISC,B,5
                CALL DO'BITS
!![44]          CALL SET'BILLING'MODE
!![44]          CALL SET'FREE'FRT               !!Set before split.
!![44]          \CLRBIT HDR'MAN'FLAG 32         !!Set manual so after split
                                                !!won't change it.
!![44]          IF HDR'FREE'FRT # "N" THEN
!!this is a split order ([44] no need for this - not used at all)
!![44]                  \SETBIT HDR'BIT'FLAG 2
!![44]          ENDIF
                CALL UPDATE'HDR                 !!DELETE'SHL will read off disk
                MULTI'FLAG = 1
                FIRST'LOC'NO = HDR'LOC'NO
                FIRST'HDR'NO = HDR'NO
                \SETKEY HDRL MODE="KEY"
                RDKEY HDRL
                HDRL'FLAG = HDRL'CTL
!!change made because if existing SHL record was deleted it also
!!       clears PQU'STAT and ACTION for current HDR record.
                LEAVE'HDR = 1
                CALL DELETE'SHL
                LEAVE'HDR = 0
                ATQT'CTL = 3
                IF INC'USE'CV = "Y" AND TRH'CTP'NO # 0 AND TOTALS'ONLY # "Y" THEN
                        ATQ'SPACE = SPACE
                        \UCNVATQ AKEY="Y"
                        USE ATQT INTO ATQ'REC KEY ATQT'KEY
                        \CHKKEY ATQT LASTFIX="SPECIAL" APID="CV"
                        IF ATQT'CTL # 0 THEN
                                RDKEY ATQT
                                IF ATQT'CTL = 0 THEN
                                        IF ATQ'SPECIAL = "" AND &
                                                   ATQ'LST'NO = HDR'NAM'NO THEN
                                                RDLOCK ATQT
                                                ATQ'SOURCE = ATQT'KSOURCE
                                                ATQ'SPECIAL = ATQT'KSPECIAL
                                                ATQ'CNO = ATQT'KCNO
                                                WRITE ATQT
                                                ENTRY = "Credit card key fixed!"
                                                \KERROR HDR MODE="D"
                                                ENTRY = ENTRY +"/"
                                                \KERROR ATQT MODE="K" APID="CV"
                                                CALL DO'ERRLO
                                                GOTO CC'KLUDGE
                                        ENDIF
                                        ENTRY = "Credit card authorization record INVALID! "
                                ELSE
                                        ENTRY = "1: ERROR - Authorization record not found "
                                ENDIF
                                \KERROR HDR MODE="D"
                                ENTRY = ENTRY +"/"
                                \KERROR ATQT MODE="K" APID="CV"
                                CALL DO'ERR'OEPACKL
                        ENDIF
                   CC'KLUDGE:
                ENDIF
                SPLITKEY2 = (HDR'LOC'NO USING "#ZZZ") + &
                                     (HDR'NO USING "#ZZZZZZ")

                CALL SPLIT'SUM'FFP
                IF ABS(SUM'FFP) > 6553500 THEN
                    HDR'FFP'TOTAL = 65535
                ELSE
                    \FROUND ABS(SUM'FFP)/100 HDR'FFP'TOTAL
                ENDIF
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "4) HDR FFP TOTAL="+HDR'FFP'TOTAL+" SUM="+SUM'FFP
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
                CALL UPDATE'HDR
                CALL FINAL'FFP'TOTAL                !![60]
                HDR2'REC = HDR'REC                      !!Save
                LIN'KHDR'LOC'NO = HDR'LOC'NO
                LIN'KHDR'NO = HDR'NO
MAP1 ADD'ONE,B,2
                ADD'ONE = 0                     !!Counter of added HDR
                TMP'TOTAL = 0
                CALL CACHE'LIN
                CALL SET'LINKEY
                IF WBWHAP # 1 THEN
                    TCOUNT'DESC = "Splitting order"
                    CALL TCOUNT'START
                ENDIF
MAP1 SLINKEY,S,40
!!might need LIN'USED() here when splitting, I think not as other locs don't
!!have goofy packing
                SLINKEY = LINKEY
                DO
                        XCALL VICSIT,7,4,LIN'REC,SLINKEY,LINPTR,0,LIN'PKT !!GETNXT
                        LIN'KHDR'LOC'NO = FIRST'LOC'NO
                        LIN'KHDR'NO = FIRST'HDR'NO
                        \CHKKEY LIN
                        IF LIN'CTL # 0 EXIT
                        IF WBWHAP # 1 THEN
                            CALL TCOUNT
                        ENDIF
                        CALL ADD'SHL
                LOOP
                IF ADD'ONE = 0 THEN
                        \CLRBIT HDR'BIT'FLAG 1  !![44]
                        HDR'MULTI = 0
                        IF TMP'TOTAL # (HDR'SHP'TOTAL-HDR'SHP'DISC) OR &
                                                ATQT'CTL = 0 THEN
                                CALL RE'TOTAL'HDR
                                HDR'FFP'TOTAL = FINAL'FFP'TOTAL !![60]
                                IF DO'EXCUSE = 1 THEN
                                    SAV'ENTRY = ENTRY
                                    ENTRY = "5) HDR FFP TOTAL="+HDR'FFP'TOTAL
                                    CALL DO'EXCUSE'LOG
                                    ENTRY = SAV'ENTRY
                                ENDIF
                                CALL UPDATE'HDR
                        ENDIF
                        GOTO ADD'ONE'FAILED     !!Kludge, nada added
                ENDIF
                REL HDR
                SHL'LOC'NO = FIRST'LOC'NO
                SHL'DOC'TYPE = HDR'DOC'TYPE
                SHL'NO = FIRST'HDR'NO
                SHL'SLOC'NO = 0
                \SETKEY SHL MODE="KEY"
                USE SHL INTO SHL'REC KEY SHL'KEY
                DO
                        GETNXT SHL INTO SHL'REC
                        \CHKKEY SHL
                        IF SHL'CTL # 0 EXIT
                        HDR'NO = SHL'NNO
                        HDR'LOC'NO = SHL'SLOC'NO
                        \SETKEY HDR MODE="KEY"
                        CALL RDLOCK'HDR'BY'KEY
!!Silly code - will remove when bugs all gone!
                        IF HDR'CTL # 0 THEN
                                ENTRY = "Programmer error ..."
                                \KERROR HDR MODE="D"
                                ENTRY = ENTRY + " / "
                                \KERROR SHL MODE="K"
                                CALL DO'ERR'OEPACK
                                GOTO DEAD'ABORT
                        ENDIF
                        CALL RE'TOTAL'HDR
                        HDR'FFP'TOTAL = FINAL'FFP'TOTAL !![60]
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "6) HDR FFP TOTAL="+HDR'FFP'TOTAL
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
                        IF HDR'LOC'NO # FIRST'LOC'NO            OR  &
                                        HDR'NO # FIRST'HDR'NO   THEN
!!How much of charges from original header go to split header.
                                MAP1 SPLIT'FRACTION,F
                                IF (HDR2'SHP'TOTAL-HDR2'SHP'DISC) # 0 THEN
                                        SPLIT'FRACTION = (HDR'SHP'TOTAL-HDR'SHP'DISC)/(HDR2'SHP'TOTAL-HDR2'SHP'DISC)
                                ELSE
                                        SPLIT'FRACTION = 1
                                ENDIF
                                FOR II = 1 TO 6
                                        HDR'CD(II) = HDR'CD(II) * SPLIT'FRACTION
                                NEXT II
                                IF USE'VAT = "Y" THEN
                                    HDR'VIA'NO = ORG'VIA'NO
                                    HDR'BVIA'NO = ORG'BVIA'NO
                                ENDIF
                        ELSE
                                CMN'SAV'RCN(1) = HDR'RCN
!![44]                          \CLRBIT HDR'BIT'FLAG 1  !!Don't count on original
                        ENDIF
                        CALL WRITE'HDR
                LOOP
                HDR'RCN = CMN'SAV'RCN(1)
        SKIP'RE'TOTAL:
                TIME'CSV = "SKIP'RE'TOTAL:" : \TIME'CSV
                SHL'LOC'NO = FIRST'LOC'NO
                SHL'DOC'TYPE = HDR'DOC'TYPE
                SHL'NO = FIRST'HDR'NO
                SHL'SLOC'NO = 0
                \SETKEY SHL MODE="KEY"
                USE SHL INTO SHL'REC KEY SHL'KEY
                GETNXT SHL INTO SHL'REC
                \CHKKEY SHL
                IF SHL'CTL # 0 THEN
                    REL SHL
                    ENTRY = "Nothing on order to ship!"
                    CALL DO'ERR'OEPACK
                    GOTO CMNRTN
                ENDIF
                HDR'RCN = 0
                REL HDR
                HDR'NO = SHL'NNO
                HDR'LOC'NO = SHL'SLOC'NO
                \SETKEY HDR MODE="KEY"
                CALL RDLOCK'HDR'BY'KEY
!!Silly code - will remove when bugs all gone!
                IF HDR'CTL # 0 THEN
                        ENTRY = "Programmer error ..."
                        \KERROR HDR MODE="K"
                        CALL DO'ERR'OEPACK
                        GOTO DEAD'ABORT
                ENDIF
                IF USE'VAT = "Y" THEN
                    VIA'CUS'NO = 0
                    CALL FIND'VIA
                ENDIF
                CMN'SAV'RCN(1) = HDR'RCN
                HDR'FFP'TOTAL = FINAL'FFP'TOTAL !![60]
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "7) HDR FFP TOTAL="+HDR'FFP'TOTAL
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
        ELSE
            SPLITKEY2 = ""
            ADD'ONE'FAILED:
                TIME'CSV = "ADD'ONE'FAILED:" : \TIME'CSV
                IF OEC'SKIP'FUT = "Y" OR OC2'CALC'YN # "N" THEN
!!WHY                        OR (CUS'STX'NO # 0 AND HDR'STX1ABLE = 0) THEN
                        CALL RE'TOTAL'HDR
                        CALL FINAL'FFP'TOTAL                !![60]
                        CALL UPDATE'HDR
                ELSE
                        !!Since ATQ is only deleted by OEPQTY,
                        !!if the order EVER had a credit card record (ATQ),
                        !!it should still be there.  If they switch to a
                        !!non-credit card terms, we need to recalculate
                        !!to remove the charge.
                        CALL FINAL'FFP'TOTAL                !![60]
                        IF INC'USE'CV = "Y" AND TOTALS'ONLY # "Y" THEN
                                \UCNVATQ AKEY="Y"
                                RDKEY ATQT
                                IF ATQT'CTL = 0 THEN
                                        CALL RE'TOTAL'HDR
                                        CALL UPDATE'HDR
                                ENDIF
                        ENDIF
                ENDIF
        ENDCASE
RETURN

MAP1 FINAL'FFP'TOTAL,B,2
MAP1 ORG'BIT'FLAG,B,1

FINAL'FFP'TOTAL:            !![60]
        TIME'CSV = "FINAL'FFP'TOTAL:" : \TIME'CSV
        IF FFP'SUMMED = 0 THEN
            \TSTBIT ORG'BIT'FLAG 1 VAR="SF"
            IF SF = 0 THEN                  !!Not from a multi location split order.
                IF ABS(HDR'SHP'TOTAL) > 6553500 THEN
                    HDR'FFP'TOTAL = 65535
                ELSE
                    \FROUND ABS(HDR'SHP'TOTAL)/100 HDR'FFP'TOTAL
                ENDIF
            ELSE
                SF = 0
            ENDIF
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "7-1) HDR FFP TOTAL="+HDR'FFP'TOTAL+" FFP SUM="+FFP'SUMMED+" HDR'SHP'TOTAL="+HDR'SHP'TOTAL
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
        ENDIF
        FINAL'FFP'TOTAL = HDR'FFP'TOTAL
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "FINAL FFP: HDR'FFP'TOTAL="+HDR'FFP'TOTAL+" NO="+HDR'NO
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
RETURN

MAP1 QUAL'FF,B,1
MAP1 BB,F
MAP1 SUM'FFP,B,5
MAP1 FFP'SUMMED,B,1
MAP1 QUAL'SUM'SPACE,S
    MAP2 QUAL'SUM(8),B,5
MAP1 EXEMPT'SPACE,S
    MAP2 EXEMPT'TRK'NO(250),B,3
    MAP2 EXEMPT'CNT,B,2
MAP1 EXEMPT'MAX,B,2,250
MAP1 SPLITTING,B,1

SPLIT'SUM'FFP:
    TIME'CSV = "SPLIT'SUM'FFP:" : \TIME'CSV
    SPLITTING = 1
    CALL SUM'FFP
    SPLITTING = 0
RETURN

MAP1 FREEFRT'BIT,B,1

SET'FREEFRT'BIT:
    TIME'CSV = "SET'FREEFRT'BIT: PRH'ON'SALE="+PRH'ON'SALE+ &
             " MEA'FREEFRT'YN="+MEA'FREEFRT'YN
    \TIME'CSV
    ENTRY = ""
    IF PRH'ON'SALE = "Y" THEN
        XCALL GETENV,"OEPACK_ON_SALE_QUALIFY",ENTRY
        IF (ENTRY = "N" AND FFP'NO = 0) OR ENTRY = "A" THEN
            FREEFRT'BIT = 0
            RETURN                                    !!KLUDGE
        ELSE
            FREEFRT'BIT = MEA'FREEFRT'YN
        ENDIF
    ELSE
        FREEFRT'BIT = MEA'FREEFRT'YN
    ENDIF
    IF PRH'ON'SALE = "Y" THEN
        IF FFP'FF'ON'SALE = "N" THEN
            IF IN2'CHANGE'FF = "Y" THEN
                FOR DD = 1 TO 11
                    IF MEA'FREEFRT'YN = IN2'NORM'FFSCH(DD) THEN
                        FREEFRT'BIT = IN2'SALE'FFSCH(DD)
                        DD = 20
                    ENDIF
                NEXT DD
            ENDIF
        ELSE
!!allow override and give free freight to on sale items
            IF FFP'FF'ON'SALE = "O" THEN
               IF IN2'CHANGE'FF = "Y" THEN
                   FOR DD = 1 TO 11
                       IF MEA'FREEFRT'YN = IN2'NORM'FFSCH(DD) AND IN2'OVRRDE'FF(DD) # "Y" THEN
                           FREEFRT'BIT = IN2'SALE'FFSCH(DD)
                           DD = 20
                       ENDIF
                    NEXT DD
               ENDIF
            ENDIF
        ENDIF
    ENDIF
RETURN

SUM'FFP:
    TIME'CSV = "SUM'FFP:" : \TIME'CSV
    CALL SUM'FFP2
    ? TAB(24,1);TAB(-1,9);
RETURN

SUM'FFP2:
    TIME'CSV = "SUM'FFP2:" : \TIME'CSV
    SAV'ENTRY = ENTRY
    ENTRY = "SUM'FFP USING'FFL="+USING'FFL+" SUV="+IN2'SUV+" FFP'NO="+FFP'NO+" HFFP="+HDR'FFP'NO
    CALL DO'EXCUSE'LOG
    ENTRY = SAV'ENTRY
    FFP'SUMMED = 1
!!  \TSTBIT ORG'BIT'FLAG 1 VAR="SF"
!!  IF SF = 0 THEN                  !!Not from a multi location split order.
        EXEMPT'SPACE = SPACE
        IF HDR'FREE'FRT = "Y" THEN
            FRTITM = -1    !!Not needed, see below, but more clear this way
        ELSE
        IF IN2'SUV = "Y" THEN
!!FFP'CFREE'CUT should be zero in2'suv = Y
            IF USING'FFL = 0 AND (FFP'CFREE'CUT(1) > 0 OR FFP'NFREE'CUT(1) > 0 OR &
                                            FFP'WFREE'CUT(1) > 0) THEN
                FRTITM = FFP'SC'QUAL'FF
            ELSE
                TIME'CSV = "CALL SET'FRTITM #1"
                \TIME'CSV
                CALL SET'FRTITM
            ENDIF
        ELSE
            FRTITM = FFP'SC'QUAL'FF
        ENDIF
        ENDIF
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "FFL="+USING'FFL+" FFPC="+FFP'CFREE'CUT(1)+" FRT="+FRTITM
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        IF IN2'SUV = "Y" THEN
            IF IN2'FRT'SCHEME(1) = "" THEN
                ENTRY = "IN2'SUV="+IN2'SUV+" first DESC is blank!(2)"
                CALL DO'ERR
                GOTO ABORT
            ENDIF
        ENDIF
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KHDR'NO = HDR'NO
        CALL SET'LINKEY
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Re-total the order for free freight2"
            CALL TCOUNT'START
        ENDIF
        SUM'FFP = 0
!!Might need LIN'USED() I think not as it is just setting bits which it may do twice
        TIME'CSV = "BEGIN Re-total the order for free freight2"
        \TIME'CSV
        DO
            XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
            \CHKKEY LIN
            IF LIN'CTL # 0 EXIT
            IF WBWHAP # 1 THEN
                CALL TCOUNT
            ENDIF

            IF HDR'FREE'FRT = "Y" THEN
                QUAL'FF = 1
            ELSE
                CALL FIND'MEA        !!Does FIND'PRH for us
                QUAL'FF = 0

                IF LIN'QFREE'FRT # "N" THEN
!!Either not a quote or quote says 'Y' free freight
                    CALL SET'FREEFRT'BIT
                    FOR BB = 0 TO BITTOP
                        \TSTBIT FRTITM (2^BB) VAR="SF"
                        IF SF # 0 THEN
                            \TSTBIT FREEFRT'BIT (2^BB) VAR="SF"
                            IF SF # 0 THEN
                                QUAL'FF = 1
                                BB = 20
                            ENDIF
                        ENDIF
                    NEXT BB
                ELSE
                    IF EXEMPT'CNT # 0 THEN
                        FOR BB = 1 TO EXEMPT'CNT
                            IF EXEMPT'TRK'NO(BB) = LIN'TRK'NO THEN
                                BB = EXEMPT'MAX + 2
                            ENDIF
                        NEXT BB
                    ELSE
                        BB = 0
                    ENDIF
                    IF BB < (EXEMPT'MAX+2) THEN
                        IF EXEMPT'CNT < EXEMPT'MAX THEN
                            EXEMPT'CNT = EXEMPT'CNT + 1
                            EXEMPT'TRK'NO(EXEMPT'CNT) = LIN'TRK'NO
                            IF DO'EXCUSE = 1 THEN
                                SAV'ENTRY = ENTRY
                                ENTRY = "Items on quote exempt="+ LIN'TRK'NO
                                CALL DO'EXCUSE'LOG
                                ENTRY = SAV'ENTRY
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
            IF QUAL'FF = 1 THEN
                IF IN2'SUV = "Y" AND SPLITTING = 1 THEN
                    LIN'QFREE'FRT = "Y"
                    XCALL VICSIT,7,2,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!ADD/UPDATE
                    XCALL VICSIT,7,2,LIN'REC,LINKEY,LINPTR2,0,LIN'PKT !!ADD/UPDATE
                ENDIF
                SUM'FFP = SUM'FFP + LIN'NET
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Sum FFP="+SUM'FFP+" LINQ="+LIN'QFREE'FRT+" SPL="+SPLITTING
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
            ENDIF
        LOOP
        TIME'CSV = "END Re-total the order for free freight2"
        \TIME'CSV
        \TSTBIT ORG'BIT'FLAG 1 VAR="SF"
        IF SF = 0 THEN
            IF ABS(SUM'FFP) > 6553500 THEN
                HDR'FFP'TOTAL = 65535
            ELSE
                \FROUND ABS(SUM'FFP)/100 HDR'FFP'TOTAL
            ENDIF
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Calculated HDR'FFP'TOTAL="+HDR'FFP'TOTAL
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
        ENDIF
!!  ENDIF
    SF = 0
RETURN

MAP1 LIN'USED'SPACE,S
    MAP2 LIN'USED(9999),B,1

RE'TOTAL'HDR:
        TIME'CSV = "RE'TOTAL'HDR:" : \TIME'CSV
        LAST'LIN = 0
        CC'LIN = 0
        CC'LINKEY = ""
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KHDR'NO = HDR'NO
        CALL ZTOTAL
        CALL SET'LINKEY
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Re-total the order from line items"
            CALL TCOUNT'START
        ENDIF
        LIN'USED'SPACE = SPACE
        DO
                XCALL VICSIT,7,4,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
                \CHKKEY LIN
                IF LIN'CTL # 0 EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                IF LIN'USED(LIN'NO) = 0 THEN
!!LIN'USED keeps us from counting the same line twice but the
!!cache does not have the complete LIN record so we read it off disk
                    \SETKEY LIN MODE="KEY"
                    USE LIN INTO LIN'REC KEY LIN'KEY
                    CALL TOTAL'HDR
                    LIN'USED(LIN'NO) = 1
                ENDIF
        LOOP
        SF = 0
        CALL DO'CC'LINE
!!      IF TRH'CTP'NO # 0 AND (TRH'AMT # 0 OR TRH'PERCENT # 0) THEN
        IF SF = 1 THEN
                SPECIAL'CC = 1
                CALL TOTAL'HDR
                SPECIAL'CC = 0
                SF = 0
        ENDIF
        CALL COMPUTE'TAX
RETURN

DO'CC'LINE:
        TIME'CSV = "DO'CC'LINE:" : \TIME'CSV
        IF CC'LIN # 0 THEN
                IF CUS'CC'CHG'YN = "N" OR CUS'CC'CHG'YN = "O" THEN
                        CALL DELETE'CC'LINE
                ELSE
                IF TRH'CTP'NO # 0 AND TRH'CHOICE # "N" AND &
                                (TRH'AMT # 0 OR TRH'PERCENT # 0) THEN
                        SF = 1
                        CALL UPDATE'CC'LINE
                ELSE
                        CALL DELETE'CC'LINE
                ENDIF
                ENDIF
        ELSE
                IF TRH'CTP'NO # 0 AND TRH'CHOICE # "N" AND &
                                (TRH'AMT # 0 OR TRH'PERCENT # 0) AND &
                                CUS'CC'CHG'YN # "N" AND CUS'CC'CHG'YN # "O" THEN
                        SF = 1
                        CALL ADD'CC'LINE
                ENDIF
        ENDIF
RETURN

MAP1 CC'AMT,B,5
MAP1 CC'PERC,B,5

ADD'CC'LINE:
        TIME'CSV = "ADD'CC'LINE:" : \TIME'CSV
        LIN'SPACE = SPACE
        LIN'HDR'LOC'NO = HDR'LOC'NO
        LIN'DOC'TYPE = HDR'DOC'TYPE
        LIN'HDR'NO = HDR'NO
        LIN'NO = LAST'LIN + 10
        LIN'TRK'NO = OC2'TRK'NO
        \ADD'LIN PERC="TRH'PERCENT" AMT="TRH'AMT" CHOICE="TRH'CHOICE"
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KHDR'NO = HDR'NO
        CALL SET'LINKEY
        LINKEY = LINKEY + "~CC:" + (LIN'NO USING "#ZZZ") !!If sorted, I don't care if
                                                         !!this is in wrong place
        XCALL VICSIT,7,1,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!ADD
        XCALL VICSIT,7,1,LIN'REC,LINKEY,LINPTR2,0,LIN'PKT !!ADD
RETURN

DELETE'CC'LINE:
        TIME'CSV = "DELETE'CC'LINE:" : \TIME'CSV
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KDOC'TYPE = HDR'DOC'TYPE
        LIN'KHDR'NO = HDR'NO
        LIN'KNO = CC'LIN
        RDLOCK LIN INTO LIN'REC KEY LIN'KEY
        IF LIN'CTL = 0 THEN
                \SETKEY LIN MODE="KY2"
                \DELKEY LIN MODE="KY2"
                DELETE LIN FROM LIN'REC KEY LIN'KEY
                LINKEY = CC'LINKEY
                XCALL VICSIT,7,8,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!DELETE
                XCALL VICSIT,7,8,LIN'REC,LINKEY,LINPTR2,0,LIN'PKT !!DELETE
        ELSE
                ENTRY = "Unable to reread line " + CC'LIN+" for credit card fee deletion."
                \KERROR LIN MODE="K"
                CALL DO'ERR'OEPACKL
        ENDIF
RETURN

UPDATE'CC'LINE:
        TIME'CSV = "UPDATE'CC'LINE:" : \TIME'CSV
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KDOC'TYPE = HDR'DOC'TYPE
        LIN'KHDR'NO = HDR'NO
        LIN'KNO = CC'LIN
        RDLOCK LIN INTO LIN'REC KEY LIN'KEY
        IF LIN'CTL = 0 THEN
                \UPDATE'LIN PERC="TRH'PERCENT" AMT="TRH'AMT" CHOICE="TRH'CHOICE"
                WRITE LIN FROM LIN'REC
                LINKEY = CC'LINKEY
                XCALL VICSIT,7,2,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!ADD/update
                XCALL VICSIT,7,2,LIN'REC,LINKEY,LINPTR2,0,LIN'PKT !!ADD/update
        ELSE
                ENTRY = "Unable to reread line " + CC'LIN+" for credit card fee update."
                \KERROR LIN MODE="K"
                CALL DO'ERR'OEPACKL
        ENDIF
RETURN

!!SHL stores all the locations for a split order
ADD'SHL:
        TIME'CSV = "ADD'SHL:" : \TIME'CSV
        TMP'TOTAL = TMP'TOTAL + LIN'NET
!*************
XCALL GIN,"HDR'LOC'NO="+HDR'LOC'NO+" LIN'LOC'NO="+LIN'LOC'NO  !!remove later
        IF HDR'LOC'NO > 1 AND HDR'LOC'NO = LIN'LOC'NO THEN  !!Mill Direct Location
            SPLIT'LOC = "N"
            SPLIT'BO = "N"
!************
XCALL GIN,"Set SPLIT'LOC and SPLIT'BO to N"    !!remove later
        ENDIF

        IF (SPLIT'BO # "N" AND LIN'ORDER'QTY # 0) OR LIN'COM'QTY # 0 THEN
            CALL SET'SPLIT'LOC
            IF SPLIT'LOC = "Y" THEN
                SHL'LOC'NO = FIRST'LOC'NO
                SHL'DOC'TYPE = HDR'DOC'TYPE
                SHL'NO = FIRST'HDR'NO
                SHL'SLOC'NO = LIN'LOC'NO
                IF LIN'LOC'NO # FIRST'LOC'NO THEN
                        SHL'NNO = 0
                ELSE
                        SHL'NNO = FIRST'HDR'NO
                ENDIF
                \SETKEY SHL MODE="KEY"
                ADD SHL FROM SHL'REC KEY SHL'KEY
                IF LIN'LOC'NO # FIRST'LOC'NO THEN
                    IF SHL'CTL = 0 THEN
                                                !!New header needed
                        RDLOCK SHL
                        LOC'KNO = SHL'SLOC'NO
                        RDLOCK LOC INTO LOC'REC KEY LOC'KEY
                        IF LOC'CTL # 0 THEN
                                ENTRY = "Cannot find location record: "+SHL'SLOC'NO
                                CALL DO'ERR'OEPACK
                                GOTO DEAD'ABORT
                        ENDIF
                        HDR'LOC'NO = SHL'SLOC'NO
                        LOC'INV'CNT'NO(HDR'DOC'TYPE) = (LOC'INV'CNT'NO(HDR'DOC'TYPE) MAX 1) MIN 9
                        HDR'NO = LOC'COUNTER(LOC'INV'CNT'NO(HDR'DOC'TYPE ))+1
                        HDR'KLOC'NO = HDR'LOC'NO
                        HDR'KDOC'TYPE = HDR'DOC'TYPE
                        HDR'KNO = HDR'NO
                        RDKEY HDR
                        IF HDR'CTL # 0 THEN
                                HHS'KEY = HDR'KEY
                                HHS'KSHIPMENT = 1
                                RDKEY HHS
                                HDR'CTL = HHS'CTL
                        ENDIF
                        IF HDR'CTL = 0 THEN
                                HDR'KNO = -1
                                RDKEY HDR
                                GETPRV HDR
                                HDR'KEY = HDR'KEY2
                                IF HDR'KLOC'NO = HDR'LOC'NO AND         &
                                   HDR'KDOC'TYPE = HDR'DOC'TYPE THEN
                                        HDR'KNO = HDR'KNO + 1
                                ELSE
                                        HDR'KNO = HDR'NO
                                ENDIF
                        ENDIF
                        HHS'KNO = -1
                        HHS'KSHIPMENT = -1
                        RDKEY HHS
                        GETPRV HHS
                        HHS'KEY = HHS'KEY2
                        IF HHS'KLOC'NO = HHS'LOC'NO AND         &
                           HHS'KDOC'TYPE = HHS'DOC'TYPE THEN
                                HHS'KNO = HHS'KNO + 1
                        ELSE
                                HHS'KNO = HDR'NO
                        ENDIF
                        HDR'NO = HDR'KNO MAX HHS'KNO
                        IF HDR'NO > 9999999 THEN
                                ENTRY = "Cannot asign new order number!"
                                REL LOC
                                GOTO DO'ERR             !!KLUDGE
                        ENDIF
                        LOC'COUNTER(LOC'INV'CNT'NO(HDR'DOC'TYPE)) = HDR'NO
                        WRITE LOC LOC'RCN FROM LOC'REC
                        IF HDR'MSGNO # 0 THEN
                                DD = HDR'MSGNO
                                HDR'MSGNO = 0
                                \LOOPMSG FLDNAM="DD" COPY="HDR"
                        ENDIF
                        HDR'MAN'FLAG = 0
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "CLR ALL MAN auto="+HDR'MAN'FLAG+" DO="+DO'FREE'FRT
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
                        \SETKEY HDR MODE="KEY"
                        ADD HDR FROM HDR'REC KEY HDR'KEY
                        IF HDR'CTL = 0 THEN
                                IF OEC'INV'UPS'YN = "N" CALL ADD'CON
                                CALL ADD'ATQ
                                CALL COPY'TAD
                                ADD'ONE = ADD'ONE + 1   !!Added one!
                                SHL'NNO = HDR'NO
                                WRITE SHL
                                \SETKEY HDR MODE="KY2"
                                \ADDKEY HDR MODE="KY2"
                                IF HDRL'FLAG = 0 THEN
                                        \SETKEY HDRL MODE="KEY"
                                        ADDKEY HDRL
                                ENDIF
                                ENTRY = "Added multi-location order number: "
                                \KERROR HDR MODE="KEY" CNO="N"
                                CALL DO'ERR'OEPACK
!![51] below
                                CAP'KHDR'LOC'NO = FIRST'LOC'NO
                                CAP'KDOC'TYPE = HDR'DOC'TYPE
                                CAP'KHDR'NO = FIRST'HDR'NO
                                CAP'KSHIPMENT = HDR'SHIPMENT + 1
                                USE CAP INTO CAP'REC KEY CAP'KEY
                                IF CAP'CTL = 0 THEN
                                    CAP'HDR'LOC'NO = HDR'LOC'NO
                                    CAP'HDR'NO = HDR'NO
                                    \SETKEY CAP MODE="KEY"
                                    ADD CAP FROM CAP'REC KEY CAP'KEY
                                    IF CAP'CTL = 0 THEN
                                        \SETKEY CAP MODE="KY2"
                                        \ADDKEY CAP MODE="KY2"
                                    ENDIF
!![51] above
                                ENDIF
                        ENDIF
                        SHL'CTL = HDR'CTL
                   ELSE
                        USE SHL INTO SHL'REC KEY SHL'KEY
                   ENDIF
                   IF SHL'CTL = 0 THEN
                        \SETKEY LIN MODE="KEY"
                        ENTRY = LIN'QFREE'FRT
                        RDLOCK LIN INTO LIN'REC KEY LIN'KEY
                        LIN'QFREE'FRT = ENTRY
                        \SETKEY LINL MODE="KEY"
                        RDKEY LINL
                        LINL'FLAG = LINL'CTL
                        CALL SET'LINKEY
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "SET LINQ"+LIN'QFREE'FRT+" LIN="+LIN'NO
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
                        IF LIN'CACHED = 2 THEN
                            ENTRY = LINKEY+" look for "+LIN'NO+" in ADD'SHL"
                            CALL FIND'LIN'REC
                        ELSE
                            LINKEY = LINKEY + (LIN'NO USING "#ZZZ")
                        ENDIF
                        XCALL VICSIT,7,8,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!DELETE
                        XCALL VICSIT,7,8,LIN'REC,LINKEY,LINPTR2,0,LIN'PKT !!DELETE
                        DELKEY LIN
                        \SETKEY LIN MODE="KY2"
                        \DELKEY LIN MODE="KY2"
                        LIN'PRV'LOC'NO = FIRST'LOC'NO
                        LIN'PRV'HDR'NO = FIRST'HDR'NO
                        LIN'PRV'TYPE = LIN'DOC'TYPE
                        LIN'HDR'LOC'NO = SHL'SLOC'NO
                        LIN'HDR'NO = SHL'NNO
                        UPDATE LIN
                        \SETKEY LIN MODE="KEY"
                        ENTRY = LINKEY[12,-1]
                        CALL SET'LINKEY
                        LINKEY = LINKEY + ENTRY
                        XCALL VICSIT,7,1,LIN'REC,LINKEY,LINPTR,0,LIN'PKT !!ADD
                        XCALL VICSIT,7,1,LIN'REC,LINKEY,LINPTR2,0,LIN'PKT !!ADD
                        ADDKEY LIN
                        \SETKEY LIN MODE="KY2"
                        \ADDKEY LIN MODE="KY2"
                        IF LINL'FLAG = 0 THEN
                            \SETKEY LINL MODE="KEY"
                            ADDKEY LINL
                        ENDIF
                        REL LIN
                  ENDIF
                ENDIF
            ENDIF
        ENDIF
RETURN

ADD'ATQ:
        TIME'CSV = "ADD'ATQ:" : \TIME'CSV
        IF INC'USE'CV = "Y" AND TRH'CTP'NO # 0 AND ATQ'SEQ # 0 AND &
                            TOTALS'ONLY # "Y" THEN
                ATQ2'REC = ATQ'REC
                \UCNVATQ APRE="ATQ2"    !!Put new HDR information in ATQ2
                ATQ2'KQUEUE = ATQ'QUEUE
                ATQ2'KSEQ = 99999999999         !![223]
                RDKEY ATQ2 KEY ATQ2'KEY
                GETPRV ATQ2
                IF ATQ2'CTL = 0 THEN
                        ATQ2'KEY = ATQ2'KEY2
                        ATQ2'SEQ = ATQ2'KSEQ
                ELSE
                        ATQ2'SEQ = 0
                ENDIF
                DO
                        ATQ2'SEQ = ATQ2'SEQ + 1
                        \SETKEY ATQ MODE="KEY" APID="CV" ALTPRE="ATQ2" ALTKEY="ATQ2"
                        ADDL ATQ2 FROM ATQ2'REC KEY ATQ2'KEY
                LOOP WHILE ATQ2'CTL # 0 AND ATQ2'SEQ < 999999999999

                IF ATQ2'SEQ > 999999999999 THEN
                        ENTRY = "FATAL ERROR - NO REMAINING AUTHORIZATION SEQUENCES!!!! "
                        \KERROR HDR
                        CALL DO'ERR'OEPACKL
                        GOTO DEAD'ABORT
                ELSE
                        \SETKEY ATQ ALTPRE="ATQ2" ALTKEY="ATQ2" APID="CV" MODE="KY2"
                        ADDKEY ATQT2
                        IF ATQT2'CTL # 0 THEN
                            DELKEY ATQ2
                            DELETE ATQ2
                            ENTRY = "Duplicate ATQT2 "
                            \KERROR ATQT MODE="K" APID="CV" CNO="N" ALTKEY="ATQT2"
                            GOTO DO'ERR'OEPACKL
                            GOTO DEAD'ABORT
                        ENDIF
                        \ADDKEY ATQ ALTPRE="ATQ2" ALTKEY="ATQ2" APID="CV" MODE="KY2" BAD1="ATQT"
                        REL ATQ2
                ENDIF
        ENDIF
RETURN

TOTAL'HDR:
        TIME'CSV = "TOTAL'HDR: LIN'NO="+LIN'NO+" LIN'TRK'NO="+LIN'TRK'NO
        \TIME'CSV
        CALL GET'TAX'PERC
        CALL FIND'PRH
        IF SPECIAL'CC = 0 THEN
                IF LIN'NO > LAST'LIN THEN
                        LAST'LIN = LIN'NO
                ENDIF
                IF LIN'TRK'NO = OC2'TRK'NO THEN
                        IF CC'LIN = 0 THEN
                                CC'LIN = LIN'NO
                                CC'LINKEY = LINKEY
                        ELSE
                                \SETKEY LIN ALTKEY="LIN2" MODE="KEY"
                                RDLOCK LIN2 INTO LIN2'REC KEY LIN2'KEY
                                IF LIN2'CTL = 0 THEN
                                        \SETKEY LIN ALTPRE="LIN2" ALTKEY="LIN2" MODE="KY2"
                                        \DELKEY LIN ALTPRE="LIN2" ALTKEY="LIN2" MODE="KY2"
                                        DELETE LIN2 FROM LIN2'REC KEY LIN2'KEY
                                ELSE
                                        ENTRY = "ERROR - Unable to reread LIN"
                                        \KERROR LIN MODE="K" ALTKEY="LIN2"
                                        CALL DO'ERR'OEPACK
                                ENDIF
                        ENDIF
                        XCALL VICSIT,7,8,LIN'REC,LINKEY,LINPTR,0,LIN2'PKT !!DELETE
                        XCALL VICSIT,7,8,LIN'REC,LINKEY,LINPTR2,0,LIN2'PKT !!DELETE
                        RETURN
                ENDIF
        ENDIF
        IF WBWHAP = 0 THEN
            SENTRY = "Y"
        ELSE
            SENTRY = "N"
        ENDIF
        COPY    "TTLHDR[SA]",ZTOTAL="Y",SKIP'FUT="SENTRY"    !!ZTOTAL:
RETURN

ADD'CON:
        TIME'CSV = "ADD'CON:" : \TIME'CSV
        IF HDR'PROC < 5 THEN
                CONO'KLOC'NO = HDR'LOC'NO
                CONO'KDOC'TYPE = HDR'DOC'TYPE
                CONO'KHDR'NO = HDR'NO
                CONO'KSHIPMENT = HDR'SHIPMENT + 1
                RDKEY CONO
                IF CONO'CTL # 0 THEN
                        USE OC2 UB'CNO INTO OC2'REC
                        CON'NO = OC2'CON'NO + 1
                        CON'LOC'NO = HDR'LOC'NO
                        CON'DOC'TYPE = HDR'DOC'TYPE
                        CON'HDR'NO = HDR'NO
                        CON'SHIPMENT = HDR'SHIPMENT + 1
                        \SETKEY CON MODE="KEY"
                        ADD CON FROM CON'REC KEY CON'KEY
                        DO WHILE CON'CTL # 0
                                CON'NO = CON'NO + 1
                                IF CON'NO > 16000000 THEN
                                        ENTRY = "No legal control number found.  Contact your dealer immediately."
                                        CALL DO'ERR'OEPACKL
                                        CON'NO = 0
                                        RETURN
                                ENDIF
                                \SETKEY CON MODE="KEY"
                                ADD CON FROM CON'REC KEY CON'KEY
                        LOOP
                        RDLOCK OC2 UB'CNO INTO OC2'REC
                        IF CON'NO > OC2'CON'NO THEN
                            OC2'CON'NO = CON'NO
                            WRITE OC2 FROM OC2'REC
                        ELSE
                            REL OC2
                        ENDIF
                        \SETKEY CON MODE="KY2"
                        \ADDKEY CON MODE="KY2"
                ENDIF
        ENDIF
RETURN

!!Old way - get closest location only if we have shipping charges by zones
!!          that are different by location.

!!New way - always get closest location.  If no charges by zone or the zone
!!          is the same for all locations use "OEC'TBL'NO" to figure locations.
!!          Like old way, use 1st zip/zone table in regular case.


LCL1 ZONE'IN'ZON'ZONE,B,1
LCL1 TZONE,S,4
LCL1 DO'BILLING'MODE,B,1

FNDLOC:
        TIME'CSV = "FNDLOC:" : \TIME'CSV
        IF FNDLOC'DONE = HDR'RCN AND FNDLOC'VIA'NO = VIA'NO RETURN !!KLUDGE
        FNDLOC'DONE = HDR'RCN
        FNDLOC'VIA'NO = VIA'NO
FNDLOC2:
        TIME'CSV = "FNDLOC2:" : \TIME'CSV
        IF WORK'MODE = "B" THEN
            DO'BILLING'MODE = 1
            CALL SET'ACTUAL'MODE
        ENDIF
        CALL GET'ZONE
        IF DO'BILLING'MODE = 1 THEN
            CALL SET'BILLING'MODE
        ENDIF
RETURN

GET'ZONE:
        TIME'CSV = "GET'ZONE:" : \TIME'CSV
        FOR II = 1 TO 7
                IF VIA'TBL'NO(II) # 0 THEN
                        CALL FIND'TBL
                        IF TBL'VTB'TYPE = "Z" THEN
                                II = 99
                        ENDIF
                ENDIF
        NEXT II
        IF II < 90 THEN
                ZON'SPACE = SPACE
                ZON'ZONE = "ZONE"
                ZONE'IN'ZON'ZONE = 1
                CALL MACRO'FNDLOC
                ALOC'ZONE(1) = "ZONE"
                ALOC'ZONE(2) = "ZONE"
        ELSE
                ZON'KTBL'NO = TBL'NO
                ZON'KLOC'NO = HDR'LOC'NO
                IF HDR'SHP'COU = "US" OR HDR'SHP'COU = "USA" OR &
                        HDR'SHP'COU = "PR" OR HDR'SHP'COU = "VI" THEN
                    ZON'KSTART'ZIP = HDR'SHP'ZIP
                    USE ZON INTO ZON'REC KEY ZON'KEY
                    IF ZON'CTL # 0 THEN
                        GETPRV ZON INTO ZON'REC
                    ENDIF
                    \CHKKEY ZON APID="IN"
                    IF ZON'CTL # 0 THEN
                        ZON'KLOC'NO = 0
                        USE ZON INTO ZON'REC KEY ZON'KEY
                        IF ZON'CTL # 0 THEN
                            GETPRV ZON INTO ZON'REC
                        ENDIF
                        \CHKKEY ZON APID="IN"
                    ENDIF
                    IF HDR'SHP'ZIP > ZON'END'ZIP THEN ZON'CTL = 1
                ELSE
                    ZON'KSTART'ZIP = UCS(HDR'SHP'COU)
                    USE ZON INTO ZON'REC KEY ZON'KEY
                ENDIF
                IF ZON'CTL # 0 THEN
                        ZONE'IN'ZON'ZONE = 0
                        CALL MACRO'FNDLOC
                        IF ALOC'ZONE(1) = "VICS" THEN
                                GOTO FNDLOC2    !!BLAH
                        ENDIF
                        DO WHILE ALOC'ZONE(1)[1,1] = " " AND LEN(ALOC'ZONE(1)) # 0
                                ALOC'ZONE(1) = ALOC'ZONE(1)[2,-1]
                        LOOP
                        DO WHILE ALOC'ZONE(2)[1,1] = " " AND LEN(ALOC'ZONE(2)) # 0
                                ALOC'ZONE(2) = ALOC'ZONE(2)[2,-1]
                        LOOP
!![44] add 3 and 4 below.
                        DO WHILE ALOC'ZONE(3)[1,1] = " " AND LEN(ALOC'ZONE(3)) # 0
                                ALOC'ZONE(3) = ALOC'ZONE(3)[2,-1]
                        LOOP
                        DO WHILE ALOC'ZONE(4)[1,1] = " " AND LEN(ALOC'ZONE(4)) # 0
                                ALOC'ZONE(4) = ALOC'ZONE(4)[2,-1]
                        LOOP
                ELSE
                        TZONE = ZON'ZONE
                        ZONE'IN'ZON'ZONE = 1
                        CALL MACRO'FNDLOC
                        ALOC'ZONE(1) = TZONE
                        ALOC'ZONE(2) = TZONE
!![44] add 3 and 4 below.
                        ALOC'ZONE(3) = TZONE
                        ALOC'ZONE(4) = TZONE
                ENDIF
        ENDIF
        TIME'CSV = "End of GET'ZONE: TBL'NO="+TBL'NO+" HDR'LOC'NO="+HDR'LOC'NO+ &
                 " ZON'ZONE="+ZON'ZONE+" ZONE1="+ALOC'ZONE(1)
        \TIME'CSV
RETURN

LCL1 BASED,B,2
MAP1 FNDLOC'DONE,B,3
MAP1 FNDLOC'VIA'NO,B,2
COPYF "LOCFIL[IN]",=LOC7,NOAFR

MACRO'FNDLOC:
        TIME'CSV = "MACRO'FNDLOC:" : \TIME'CSV
        LOC7'REC = LOC'REC
        IF ZONE'IN'ZON'ZONE = 1 OR TBL'NO = 0 THEN
                BASED = OEC'TBL'NO
        ELSE
                BASED = TBL'NO
        ENDIF
!![42] below made max into 4 instead of 2
        \FNDLOC FLDNAM="HDR'SHP'ZIP" OUTPUT="LOCS" MAX="4"              &
                                BASED=BASED BADLOC="HDR'LOC'NO"         &
                                ABORT="DEAD'ABORT" BADTBL="TBL'NO"
        IF CUS'LOC'NO # 0 AND ALOC'NO(1) # CUS'LOC'NO THEN
!![44] - rewrote below to shuffle properly with 4 locations ...
                ZZ = 0
                FOR XX = 1 TO 4
                    IF ALOC'NO(XX) = CUS'LOC'NO THEN
                        ZZ = XX
                        XX = 4
                    ENDIF
                NEXT XX
                ENTRY = ""
                II = 0
                IF ZZ # 0 THEN
                    ENTRY = ALOC'ZONE(ZZ)
                    II = ALOC'NO(ZZ)
                    IF ZZ < 4 THEN
                        FOR XX = ZZ TO 3
                            ALOC'ZONE(XX) = ALOC'ZONE(XX+1)
                            ALOC'NO(XX) = ALOC'NO(XX+1)
                        NEXT XX
                    ENDIF
                ENDIF
                ALOC'NO(4) = ALOC'NO(3)
                ALOC'NO(3) = ALOC'NO(2)
                ALOC'NO(2) = ALOC'NO(1)
                ALOC'ZONE(4) = ALOC'ZONE(3)
                ALOC'ZONE(3) = ALOC'ZONE(2)
                ALOC'ZONE(2) = ALOC'ZONE(1)
                ALOC'NO(1) = CUS'LOC'NO
                IF II = CUS'LOC'NO OR ZONE'IN'ZON'ZONE = 1 THEN
                        ALOC'ZONE(1) = ENTRY
                ELSE
                        ZON'KTBL'NO = OEC'TBL'NO
                        ZON'KLOC'NO = CUS'LOC'NO
                        IF HDR'SHP'COU = "US" OR HDR'SHP'COU = "USA" OR &
                                HDR'SHP'COU = "PR" OR HDR'SHP'COU = "VI" THEN
                            ZON'KSTART'ZIP = HDR'SHP'ZIP
                            USE ZON INTO ZON'REC KEY ZON'KEY
                            IF ZON'CTL # 0 THEN
                                GETPRV ZON INTO ZON'REC
                            ENDIF
                            \CHKKEY ZON APID="IN"
                            IF HDR'SHP'ZIP > ZON'END'ZIP THEN ZON'CTL = 1
                        ELSE
                            ZON'KSTART'ZIP = UCS(HDR'SHP'COU)
                            USE ZON INTO ZON'REC KEY ZON'KEY
                        ENDIF
                        IF ZON'CTL # 0 THEN
                                CUS'LOC'NO = 0
                                ZON'ZONE = "VICS"
!!force this above              GOTO FNDLOC2    !!BLAH
                        ENDIF
                        ALOC'ZONE(1) = ZON'ZONE
                ENDIF
        ENDIF
        LOC'REC = LOC7'REC
RETURN

FIND'TBL:
        TIME'CSV = "FIND'TBL: VIA'TBL'NO="+VIA'TBL'NO(II)
        \TIME'CSV
        TBL'KNO = VIA'TBL'NO(II)
        \VUSE TBL - V''PTR1
RETURN

MAP1 SET'LINKEY,S,40

SET'LINKEY:
        LINKEY = (LIN'KHDR'LOC'NO USING "#ZZZ") + &
                 (LIN'KHDR'NO USING "#ZZZZZZ")
RETURN

FIND'LIN'REC:
        TIME'CSV = "FIND'LIN'REC:" : \TIME'CSV
        DO
                XCALL VICSIT,7,4,LIN2'REC,LINKEY,LINPTR,0,LIN'PKT !!GETNXT
                \CHKKEY LIN ALTPRE="LIN2"
                IF LIN'CTL # 0 EXIT
        LOOP UNTIL LIN'NO = LIN2'NO
        LIN'REC = LIN2'REC
        IF LIN'CTL # 0 THEN
!!          ENTRY = "Could not find LIN'NO="+LIN'NO+" in cache!"
            ENTRY = ENTRY + " not in cache!"
            CALL DO'ERR'OEPACK
            GOTO DEAD'ABORT
        ENDIF
RETURN

CHKPQU2:
        IF PQU'USRPTR = HDR'RCN THEN SF = 0
RETURN

CLEAR'PQU'STAT:
        TIME'CSV = "CLEAR'PQU'STAT:" : \TIME'CSV
        IF LEAVE'HDR = 1 RETURN
        HDR'LOC'NO = SHL'SLOC'NO
        HDR'NO = SHL'NNO
        \SETKEY HDR MODE="KEY"
        CALL RDLOCK'HDR'BY'KEY
        IF HDR'CTL = 0 AND HDR'PQU'STAT # "" THEN
                HDR'MULTI = 0
                HDR'ACTION = ""
                HDR'PQU'STAT = ""
                CALL WRITE'HDR
        ELSE
                IF HDR'CTL = 0 REL HDR
        ENDIF
RETURN

GET'TAX'PERC:
        TIME'CSV = "GET'TAX'PERC:" : \TIME'CSV
        CALL FIND'CUS
        TAX'PERC = 0
        CALL GET'SF'TAXABLE
        IF CUS'TAXABLE = "Y" OR CUS'TAXABLE = "S" OR SF = 0 THEN
                STX'KLOC'NO = HDR'LOC'NO
                STX'KNO = CUS'STX'NO
                TSTSTX = "S"
                CALL FIND'STX
                IF STX'CTL # 0 THEN
                    IF ERR'HDR'NO # HDR'NO THEN
                        ENTRY = "WARNING:  Invalid customer tax code"
                        CALL DO'ERR'OEPACK
                    ENDIF
                    ERR'HDR'NO = HDR'NO
                ELSE
                    TAX'PERC = TTL'STX'PERC
                ENDIF
        ENDIF
RETURN

MAP1 TOS,B,5
MAP1 JJS,F
MAP1 QQS,B,5

E'STX1FINAL:                                    !![39] all this (see pack01.s)
        TIME'CSV = "E'STX1FINAL:" : \TIME'CSV
        IF OEC'CHG'TAX # "Y" OR SPWASTR[6;1] # "Y" RETURN       !!KLUDGE
        IF EDSPSW = 0 THEN
                CALL OEPACK'TST'FUNC
                IF TST'FUNC = 1 RETURN                          !!KLUDGE
                IF INX1 = I'TAB THEN
                        \SETBIT HDR'MAN'FLAG 128        !!Sales tax on auto
                        CALL DSP'BITS
                        HDR'STX1FINAL = 0
                ELSE
                        IF EFCHG # 0 THEN
                            \CLRBIT HDR'MAN'FLAG 128 !!Taxes on manual
                            CALL DSP'BITS
                        ENDIF
                ENDIF
                IF INX1 = I'TAB THEN IER1 = 0
        ELSE
                IER2 = 0
        ENDIF
        \TSTBIT HDR'MAN'FLAG 128 VAR="SF"               !![39]
        IF SF = 1 THEN                                  !![39]Automatic
                ENTRY = "(Computed)"
        ELSE
                ENTRY = "(Manually Entered)"
        ENDIF
        CALL DSP'TAX'AUTO
        ENTRY = STR(HDR'STX1FINAL)
RETURN
COMPUTE'TAX:
    TIME'CSV = "COMPUTE'TAX:" : \TIME'CSV
    IF WORK'MODE = "B" THEN
        CALL GET'TAX'PERC
        TOS = HDR'STX1ABLE
        IF LOC'STX'FRT'YN = "Y" OR STS'TAX'FRT = "Y" THEN
            TOS = TOS + HDR'VIA'SUM(1) + HDR'VIA'SUM(2)   !!add taxable amount + Shipping total if freight flag is Y
        ENDIF                                             !!further down, if there is free freight, we will
                                                          !!subtract free freight amount
                                                          !!so that TOS will only tax freight on the difference if any.
        FOR JJS = 3 TO 6
            IF OC2'STX'YN(JJS-2) = "Y" THEN
                TOS = TOS + HDR'CD(JJS)
            ENDIF
        NEXT JJS
        IF STS'TAX'FRT = "Y" THEN
            TOS = TOS + HDR'CD(1) !!remove free freight amount from taxable amount.  HDR'CD(1) is a negative value
                                  !!This is when freight is taxable, But there is free freight that does not equal
                                  !!all shipping cost.  Example, free freight is 67.04 but total shipping is 68.00
                                  !!we only tax on the difference which in this example is .96 cents added to taxable.
        ENDIF
        \TSTBIT HDR'MAN'FLAG 128 VAR="SF"
        IF SF = 1 THEN                     !!Automatic
            \FROUND TOS*TAX'PERC/10000 HDR'STX1FINAL
        ENDIF
        HDR'STX2FINAL = HDR'STX2TOTAL
    ENDIF
RETURN

E'VIA'NO:           !![47] made it tab on AVIA to avoid invalid getnxt
        \TABC FROM="HDR" ON="AVIA" DSPFLD="Y" APID="IN" FLDNAM="HDR'VIA'NO" &
                   SF'TEST="E'AVIA'NO'SF" VCACHE="VIAPTR" REFCHG="Y" REAL="VIA"
        VIA'REC = AVIA'REC
        CALL FIX'VIA
        AVIA'REC = VIA'REC
        IF EDSPSW = 0 AND (EFCHG # 0 OR HDR'BVIA'NO = 0) THEN
                IF VIA'CVIA'NO # 0 THEN
                        HDR'BVIA'NO = VIA'CVIA'NO
                ELSE
                        HDR'BVIA'NO = HDR'VIA'NO
                ENDIF
                VIA'KNO = HDR'BVIA'NO
                CALL FIND'VIA
                BVIA'REC = VIA'REC
                CALL SET'FREE'FRT       !![46] Calls SET'BOX'ORDER'B
                CALL COMPUTE'FREIGHT'BY'ORDER           !!including order charges
                VIA'KNO = HDR'VIA'NO
                CALL FIND'VIA
                AVIA'REC = VIA'REC
                IF WE'HAVE'ARECS = 1 THEN
                    CALL SET'BOX'ORDER'A    !!Makes AZONE'REC
                ENDIF
                IF WBWHAP # 1 THEN
                    CALL DSP'VIA'DESC2
                ENDIF
                \SETBIT HDR'MAN'FLAG 16 !!By order charges on auto
                CALL DSP'BITS
                VIA'KNO = HDR'BVIA'NO
                CALL FIND'VIA
                CALL PRE'DSP'FFP'DESC2
                ?TAB(EROW+1,ECOL+EMAX+1) ; TAB(-1,A'YEL) ; LEFT(VIA'DESC+SPACE(30),30) ;
                VIA'REC = AVIA'REC
        ENDIF
        ENTRY = STR(VIA'NO)
        PRINT TAB(EROW,ECOL) SPACE(EMAX);
        PRINT TAB(EROW,ECOL) STR(VIA'NO);
RETURN

E'BVIA'NO:              !![47] made it tab on BVIA to avoid invalid getnxt
        \TABC FROM="HDR" ON="BVIA" DSPFLD="Y" APID="IN" FLDNAM="HDR'BVIA'NO" &
                SF'TEST="E'BVIA'NO'SF" VCACHE="VIAPTR" REFCHG="Y" REAL="VIA"
        VIA'REC = BVIA'REC
        CALL FIX'VIA
        BVIA'REC = VIA'REC
        IF EDSPSW = 0 AND EFCHG # 0 THEN
                \CLRBIT HDR'BIT'FLAG 32             !!Going to reset FFP
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
!!                  \TSTBIT HDR'BIT'FLAG 32 VAR="SF"       !!Do ffp (ZERO=auto)
                    ENTRY = "CLEAR BIT'F="+HDR'BIT'FLAG
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
                CALL SET'FREE'FRT       !![46] Calls SET'BOX'ORDER'B
                CALL COMPUTE'FREIGHT'BY'ORDER           !!including order charges
                CHG'AMT = 1
                CALL GET'XTR
                \SETBIT HDR'MAN'FLAG 16 !!By order charges on auto
                CALL DSP'BITS
                VIA'REC = BVIA'REC
        ENDIF
        ENTRY = STR(VIA'NO)
        PRINT TAB(EROW,ECOL) SPACE(EMAX);
        PRINT TAB(EROW,ECOL) STR(VIA'NO);
RETURN

E'AVIA'NO'SF:
        VIA'REC = AVIA'REC
        IF VIA'MTYPE = "U" THEN
            IF VIA'MAN'YN # "N" AND VIA'MAN'YN # "" AND VIA'MAN'YN # "O" AND &
                        VIA'MAN'YN # "T" AND OC2'TRACK'YN = "Y" AND &
                        (LEN(VIA'1Z'SERV) < 2 OR LEN(VIA'SERV'TYPE) < 2) THEN
                SF = 2
                ENTRY = "Invalid ship via "+VIA'NO+" service types bad!"
            ENDIF
        ENDIF
        IF VIA'MTYPE = "U" AND VIA'CHG'TYPE = "TPB" THEN
            CUS'KNO = HDR'NAM'NO
            USE CUS INTO CUS'REC KEY CUS'KEY
            IF CUS'CTL # 0 THEN
                SF = 2
                ENTRY = "Cannot find customer record to look up Third Party Billing!"
            ELSE
                IF CUS'UPS'NO = "" THEN
                    SF = 2
                    ENTRY = "Cannot ship Third Party; no UPS account on customer!"
                ENDIF
            ENDIF
        ENDIF
        IF VIA'MTYPE = "U" AND VIA'CHG'TYPE = "COL" THEN
            CUS'KNO = HDR'NAM'NO
            USE CUS INTO CUS'REC KEY CUS'KEY
            IF CUS'CTL # 0 THEN
                SF = 2
                ENTRY = "Cannot find customer record to lookup up Collect Billing account!"
            ELSE
                IF CUS'UPS'NO2 = "" THEN
                    SF = 2
                    ENTRY = "Cannot ship Collect billing; no UPS account on customer!"
                ENDIF
            ENDIF
        ENDIF
        IF VIA'MTYPE = "F" AND VIA'CHG'TYPE = "TPB" THEN
            FED'KLST'NO = HDR'NAM'NO
            \VUSE FED
            IF FED'CTL # 0 THEN
                SF = 2
                ENTRY = "Cannot find FedEx record for customer: "+ HDR'NAM'NO
            ELSE
                IF FED'NO'ONE = "" THEN
                    SF = 2
                    ENTRY = "Cannot ship Third Party; no FedEx account on customer!"
                ENDIF
            ENDIF
        ENDIF
        IF VIA'MTYPE = "E" AND VIA'GCHG'TYPE = "TPB" THEN
            FED'KLST'NO = HDR'NAM'NO
            \VUSE FED
            IF FED'CTL # 0 THEN
                SF = 2
                ENTRY = "Cannot find Endicia record for customer: "+ HDR'NAM'NO
            ELSE
                IF FED'END'NO = "" THEN
                    SF = 2
                    ENTRY = "Cannot ship Third Party; no Endicia account on customer!"
                ENDIF
            ENDIF
        ENDIF
        IF SF = 0 CALL E'VIA'NO'SF
RETURN

E'BVIA'NO'SF:
        VIA'REC = BVIA'REC
        IF VIA'SHP'FLAG # AVIA'SHP'FLAG THEN
            SF = 2
            ENTRY = "Both billing and actual must be by box or not by box!"
            RETURN
        ENDIF
E'VIA'NO'SF:
        IF SF = 0 THEN
            \ALLOW PRE="VIA" ALLOWED="SF" LOC'NO="HDR'LOC'NO"
            CASE
            IF SF = 1 AND VIA'AD = "D" THEN
                LOC'KNO = HDR'LOC'NO
                \VUSE LOC
                IF LOC'CTL = 0 THEN
                    ENTRY = "1) "+VIA'DESC+" for " + LOC'SDESC+" location disallowed!"
                    SF = 2
                    RETURN
                ELSE
                    ENTRY = "Cannot find location"
                    \KERROR LOC MODE="K" APID="IN"
                        SF = 2
                    RETURN
                ENDIF
            ELSE
            IF SF = 1 AND VIA'AD = "A" THEN
                LOC'KNO = HDR'LOC'NO
                \VUSE LOC
                IF LOC'CTL = 0 THEN
                    ENTRY = "2) "+VIA'DESC+" for " + LOC'SDESC+" location disallowed!"
                    SF = 2
                    RETURN
                ELSE
                    ENTRY = "Cannot find location"
                    \KERROR LOC MOD="K" APID="IN"
                    SF = 2
                    RETURN
                ENDIF
            ENDCASE
        ENDIF
        IF VIA'ACTIVE = "N" THEN
            SF = 2
            ENTRY = "Inactive ship via!"
            RETURN
        ENDIF
        TRH'KNO = HDR'TRH'NO
        \VUSE TRH
        IF VIA'ALLOW'COD = "N" AND TRH'COD'STATUS > 1 THEN
            SF = 2
            ENTRY = "COD not allowed on this ship via!"
            RETURN
        ENDIF
        IF VIA'ALLOW'TYPE > 1 THEN                  !!Not all orders
                TRH'KNO = HDR'TRH'NO
                \VUSE TRH
                IF TRH'COD'STATUS = 1 AND VIA'ALLOW'TYPE = 3 THEN
!!Terms are not COD and via applies to Non-COD Only
                    SF = 1
                ELSE
                IF TRH'COD'STATUS > 1 AND VIA'ALLOW'TYPE = 2 THEN
!!Terms are COD of some sort and via applies to Non-COD Only
                    SF = 1
                ENDIF
                ENDIF
                IF SF = 0 RETURN                    !!KLUDGE
                SF = 0                              !!reset it!
        ENDIF

        CALL SET'SHIP'LST'RECORD
        CASE
        IF SHIP'ST = "" AND (SHIP'COUNTRY = "USA" OR SHIP'COUNTRY = "US") THEN
            SF = 2
            ENTRY = "There is no state on that shipping address - fix now!"
        ELSE
        IF VIA'ALLOW'POB # "Y" THEN
            FOR II = 1 TO 4
                IF UCS(SHIP'ADDR(II)[1,4]) = "POB " OR &
                   UCS(SHIP'ADDR(II)[1,7]) = "P.O BOX" OR &
                   UCS(SHIP'ADDR(II)[1,7]) = "P O BOX" OR &
                   UCS(SHIP'ADDR(II)[1,3]) = "PO " OR &
                   UCS(SHIP'ADDR(II)[1,4]) = "P O " OR &
                   UCS(SHIP'ADDR(II)[1,5]) = "P.O. " OR &
                   UCS(SHIP'ADDR(II)[1,4]) = "BOX " THEN
                        SF = 2
                        ENTRY = "PO BOX found in address, not allowed on this ship via"
                        RETURN
                ENDIF
            NEXT II
        ELSE
        IF VIA'ALLOW = 1 THEN
            IF SHIP'ST = "AK" OR SHIP'ST = "HI" OR &
                    (SHIP'COUNTRY # "USA" AND SHIP'COUNTRY # "US") OR &
                    SHIP'ST = "GU" OR SHIP'ST = "PR" THEN
!!Guam and Puerto Rico
                    ENTRY = "Only allowed in continental US "+SHIP'ST+" not in "+SHIP'COUNTRY
                    SF = 2
            ENDIF
        ELSE
        IF VIA'ALLOW = 2 THEN
            IF SHIP'ST # "AK" THEN
                ENTRY = "Only allowed in Alaska not "+SHIP'ST
                SF = 2
            ENDIF
        ELSE
        IF VIA'ALLOW = 3 THEN
            IF SHIP'ST # "HI" THEN
                ENTRY = "Only allowed in Hawaii not "+SHIP'ST
                SF = 2
            ENDIF
        ELSE
        IF VIA'ALLOW = 4 THEN
            IF SHIP'ST # VIA'ALLOW'ST THEN
                ENTRY = "Only allowed in "+VIA'ALLOW'ST+" not "+SHIP'ST
                 SF = 2
            ENDIF
        ELSE
        IF VIA'ALLOW = 5 THEN
            IF SHIP'COUNTRY # "USA" AND SHIP'COUNTRY # "US" AND &
                    SHIP'COUNTRY # "PR" AND SHIP'COUNTRY # "VI" THEN
                ENTRY = "Only allowed in USA not "+SHIP'COUNTRY
                SF = 2
            ENDIF
        ELSE
        IF VIA'ALLOW = 6 THEN
            IF SHIP'COUNTRY # "CAN" AND SHIP'COUNTRY # "CA" THEN
                ENTRY = "Only allowed in Canada not "+SHIP'COUNTRY
                SF = 2
            ENDIF
        ELSE
        IF VIA'ALLOW = 7 THEN
            IF SHIP'ST # "HI" AND SHIP'ST # "AK" THEN
                ENTRY = "Only allowed in HI and AK not "+SHIP'ST
                SF = 2
            ENDIF
        ELSE
        IF VIA'ALLOW = 8 THEN
            IF LST'COUNTRY = "US" OR LST'COUNTRY = "USA" THEN
                ENTRY = "The ship via is allowed outside the USA only!"
                SF = 2
            ENDIF
        ENDCASE
RETURN

MAP1 MEFCHG,B,1

CLR'FREE'FRT'FLAGS:
    TIME'CSV = "CLR'FREE'FRT'FLAGS:" : \TIME'CSV
    CALL CLR'OEFRFR
    CALL CLR'OEPCK1
    \SETBIT HDR'MAN'FLAG 32             !!Put FREE'FRT on auto
    DO'FREE'FRT = 1                     !!ditto
RETURN
MAP1 SAV'ENTRY,S,80

E'FREE'FRT:
    IF INX2 = FN'7 AND ECFLD = lastfn THEN
        DO'EXCUSE = 1
        CALL CLR'FREE'FRT'FLAGS        !!Sets 32
        PACK'HDR'SPACE = SPACE
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "SET F7 auto="+HDR'MAN'FLAG+" DO="+DO'FREE'FRT
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        HDR'FREE'FRT = ""
        DO'EXCUSE = ENV'DO'EXCUSE
        CALL SET'FREE'FRT
        IER1 = 0
        MEFCHG = 0
        EFCHG = 0
        INX1 = I'RT : INX2 = 0
        ENTRY = HDR'FREE'FRT
        CALL DSP'BITS
        RETURN
    ENDIF
    IF EFCHG # 0 AND EDSPSW = 0 THEN
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "SET MEFCHG=1"
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        MEFCHG = 1
    ELSE
        MEFCHG = 0
        EFCHG = 0
    ENDIF
    IF EDSPSW # 0 THEN
        ENTRY = HDR'FREE'FRT
    ENDIF
    IF OEC'MULTI'LOC = "Y" THEN
        \TABEDTC OEFRFR HDR'FREE'FRT DSPZERO="(Set from system)" &
                NOT'REFCHG="N" CLRLBL="CLR'OEFRFR"
    ELSE
        \TABEDTC OEPCK1 HDR'FREE'FRT DSPZERO="(Set from system)" &
                NOT'REFCHG="N" CLRLBL="CLR'OEPCK1"
    ENDIF
    IF EDSPSW = 0 THEN
        IF EFCHG # 0 OR MEFCHG # 0 THEN
            \CLRBIT HDR'MAN'FLAG 32         !!Set manual
            DO'FREE'FRT = 0
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "CLR EFCHG MAN auto="+HDR'MAN'FLAG+" DO="+DO'FREE'FRT
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            PACK'HDR'SPACE = SPACE
            MEFCHG = 0
            CALL PRE'DO'OEPERC'AND'ZONE
            CALL SET'FREE'FRT
            CHG'AMT = 1
            CALL DSP'BITS
            IF HDR'FREE'FRT # BZONE'FREE'FRT OR &
                    HDR'ZONE'PERC # BZONE'ZONE'PERC THEN !!Could affect zone, etc.
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "DOING ZONE CHANGE STUFF"
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
                VIA'KNO = HDR'BVIA'NO
                CALL FIND'VIA
                BVIA'REC = VIA'REC
                CALL SET'BOX'ORDER'B    !!Makes BZONE'REC
            ENDIF
        ENDIF
    ENDIF
RETURN

PRE'DO'OEPERC'AND'ZONE:
    TIME'CSV = "PRE'DO'OEPERC'AND'ZONE:" : \TIME'CSV
    IF HDR'FREE'FRT = "P" OR HDR'FREE'FRT = "Z" OR &
            HDR'FREE'FRT = "O" OR HDR'FREE'FRT = "X" THEN
        \WINDOW ACTION="DO'OEPERC'AND'OEZONE" &
                                AUTOSIZE="OEPERC" PUSH="Y"
        IER1 = 0
    ENDIF
    ENTRY = HDR'FREE'FRT
RETURN

DO'OEPERC'AND'OEZONE:
        TIME'CSV = "DO'OEPERC'AND'OEZONE:" : \TIME'CSV
        ENTRY = HDR'ZONE'PERC
        IF HDR'FREE'FRT = "P" OR HDR'FREE'FRT = "O" THEN
            DSP OEPERC
            DDB OEPERC
            GDB OEPERC
        ELSE
            DSP OEZONE
            DDB OEZONE
            GDB OEZONE
        ENDIF
        CALL OEPACK'TST'FUNC2
        IF TST'FUNC = 0 THEN
            HDR'ZONE'PERC = ENTRY
        ENDIF
        IF EFCHG # 0 THEN CHG'AMT = 1
RETURN

MAP1 PO'ERR,B,1
MAP1 BALANCE,B,5
MAP1 ORGAMT,B,5
MAP1 PAID,B,5

E'HDR'PO:
        CALL OEPACK'TST'FUNC
        IF TST'FUNC = 1 OR INX1 = I'UA RETURN
        IF ARC'INV'CR'YN(HDR'DOC'TYPE) = "Y" AND OEC'CR'PO = "Y" THEN
                IF HDR'PO[2;1] = "-" THEN
                        DOCV'KINV'TYPE = HDR'PO[1;1]
                        DOCV'KINVOICE = HDR'PO[3,-1]
                        USE DOCV INTO DOC'REC KEY DOCV'KEY
                        IF DOCV'CTL # 0 OR DOC'CUS'NO # HDR'NAM'NO THEN
                                ENTRY = "Invoice "+HDR'PO+" not found in A/R for that customer!"
                                GOTO DO'ERR
                        ENDIF
                        TRH'KNO = HDR'TRH'NO
                        \VUSE TRH
                        IF HDR'TRH'NO # DOC'TRH'NO AND INC'USE'CV = "Y" AND &
                                        TOTALS'ONLY # "Y" THEN
                                TRH2'KNO = DOC'TRH'NO
                                USE TRH2 INTO TRH2'REC KEY TRH2'KEY
                                IF TRH2'CTL # 0 THEN
                                        ENTRY = "ERROR - Cannot find terms for original document "
                                        \HDRERR
                                        GOTO DO'ERRL
                                ELSE
                                        IF TRH'CTP'NO # TRH2'CTP'NO THEN
                                                ENTRY = "ERROR - The credit card types on the debit and credit must match. "+TRH'CTP'NO+"/"+TRH2'CTP'NO
                                                GOTO DO'ERR
                                        ENDIF
                                ENDIF
                        ENDIF
                        !!Only check for applications if this is not a credit
                        !!card order.  Credit cards are ALWAYS applied,
                        !!regardless of balance.
                        IF TRH'CTP'NO = 0 OR INC'USE'CV # "Y" AND &
                                            TOTALS'ONLY # "Y" THEN
                                II = 0
                                \SETKEY DOCA APID="AR"
                                USE DOCA INTO DOC'REC KEY DOCA'KEY
                                DO
                                        GETNXT DOCA INTO DOC'REC
                                        \CHKKEY DOCA APID="AR"
                                        IF DOCA'CTL # 0 EXIT
                                        IF DOC'TYPE = 2 THEN DOC'AMT = -DOC'AMT
                                        II = II + DOC'AMT
                                LOOP
                                IF II <= 0 THEN
                                        ENTRY = "Cannot apply - already paid!"
                                        CALL DO'ERR'OEPACK
                                ELSE
                                        ENTRY = (II/100) USING "$$###,###.##-"
                                        ENTRY = "Will apply up to " + ENTRY + " to invoice."
                                        CALL DO'ERR'OEPACK
                                        IER1 = 1
                                ENDIF
                        ELSE
                                CALL CHECK'ATQ'PO
                        ENDIF
                ELSE
                    \DG GETSTRING _OESETUP oepack.skip_message ENTRY
                    IF DG'CTL # 0 THEN
                        \DG GETSTRING _OESETUP oepack_skip_message ENTRY
                    ENDIF
                    IF DG'CTL # 0 OR ENTRY # "Y" THEN
                        IF (EFCHG # 0 AND ECFLD = lastfn) OR HDR'PO = "" THEN   !![116]
                            ENTRY = "Credit not applied!"
                            CALL DO'ERR'OEPACK
                            IER1 = 1
                        ENDIF
                    ENDIF
                ENDIF
        ELSE
                IF CUS'PO'CTL > 1 AND (EFCHG # 0 OR PO'ERR = 1) THEN
                        CALL E'HDR'PO'CHECK
                ELSE
                        PO'ERR = 0
                ENDIF
        ENDIF
RETURN

CHECK'ATQ'PO:
        TIME'CSV = "CHECK'ATQ'PO:" : \TIME'CSV
        IF TRH'CTP'NO # 0 AND TOTALS'ONLY # "Y" THEN
                IF DOCV'CTL = 0 AND DOC'HDR'NO # 0 THEN
                        CALL GET'ATQT
                        IF ATQT'CTL = 0 THEN
                                WAT'LOC'NO = DOC'HDR'LOC'NO
                                WAT'DOC'TYPE = DOC'DOC'TYPE
                                WAT'NO = DOC'HDR'NO
                                WAT'SHIPMENT = DOC'SHIPMENT - 1
                                \UCNVATQ PRE="WAT" CREDIT="Y"
                                UPDATE ATQT FROM ATQ'REC
                        ELSE
                                ENTRY = "ERROR - Cannot find the ATQT record for this order!"
                                \HDRERR
                                CALL DO'ERR'OEPACKL
                        ENDIF
                ELSE
                        IF DOCV'CTL # 0 THEN
                                ENTRY = "ERROR - Cannot find the A/R document specified in the PO field for credit card application."
                                \HDRERR
                                CALL DO'ERR'OEPACKL
                        ELSE
                                IF DOC'HDR'NO # 0 THEN
                                        ENTRY = "ERROR - No order attached to the A/R document specified by the PO field "
                                        \HDRERR
                                        CALL DO'ERR'OEPACKL
                                ENDIF
                        ENDIF
                ENDIF
        ENDIF
RETURN

GET'ATQT:
        TIME'CSV = "GET'ATQT:" : \TIME'CSV
        \UCNVATQ AKEY="Y"
        RDLOCK ATQT INTO ATQ'REC KEY ATQT'KEY
        \CHKKEY ATQT LASTFIX="SPECIAL" APID="CV"
        ATQ'RCN = ATQT'RCN
        IF ATQT'CTL # 0 THEN
            RDKEY ATQT
            IF ATQT'CTL = 0 THEN
                ENTRY = "Credit card authorization record INVALID! - Rebuild ATQ keys!"
            ELSE
                IF ATQT'KSOURCE = "WB" THEN
                    ATQT'KSOURCE = "OE"
                    RDLOCK ATQT INTO ATQ'REC KEY ATQT'KEY
                    \CHKKEY ATQT LASTFIX="SPECIAL" APID="CV"
                    ATQ'RCN = ATQT'RCN
                    IF ATQT'CTL = 0 THEN
                        ENTRY = "Source now "+ATQT'KSOURCE+" on "
                        \KERROR HDR MODE="D" CNO="N"
                        CALL DO'ERRLO
                    ELSE
                        ENTRY = "2: ERROR - Authorization record not found "
                    ENDIF
                ELSE
                    ENTRY = "3: ERROR - Authorization record not found "
                ENDIF
            ENDIF
            \KERROR HDR MODE="D" CNO="N"
            ENTRY = ENTRY +"/"
            \KERROR ATQT MODE="K" APID="CV"
            CALL DO'ERR'OEPACKL
        ENDIF
RETURN

COPYF "DOCIKY[AR]"

E'HDR'PO'CHECK:
        TIME'CSV = "E'HDR'PO'CHECK:" : \TIME'CSV
        DOCI'RCN = 0
        DOCI'KCUS'NO = HDR'NAM'NO
        DOCI'KPO = UCS(HDR'PO)
        RDKEY DOCI KEY DOCI'KEY
        IF DOCI'CTL # 0 THEN

!!Not in A/R, check open orders in OE for this customer only.
!!There should be only a couple of open orders for one customer at a time.
!!If this causes them grief, they may turn of duplicate checking in A/R
!!in the customer maintenance.

                HDRC2'KNAM'NO = HDR'NAM'NO
                HDRC2'KLOC'NO = 0
                HDRC2'KDOC'TYPE = 0
                HDRC2'KNO = 0
                USE HDRC2 INTO HDR2'REC KEY HDRC2'KEY
                DO
                        GETNXT HDRC2 INTO HDR2'REC
                        IF HDR2'NAM'NO # HDR'NAM'NO OR HDRC2'CTL # 0 EXIT
                        IF HDRC2'RCN = HDR'RCN REPEAT
                        IF HDR2'PO = HDR'PO THEN
                                DOC'HDR'LOC'NO = HDR2'LOC'NO
                                DOC'DOC'TYPE = HDR2'DOC'TYPE
                                DOC'HDR'NO = HDR2'NO
                                DOCI'CTL = 0
                                EXIT
                        ENDIF
                LOOP
        ELSE
                USE DOC DOCI'RCN INTO DOC'REC
        ENDIF

        IF DOCI'CTL = 0 THEN
                ENTRY = HDR'PO + " already entered on order "+          &
                        STR(DOC'HDR'LOC'NO) + "-" + STR(DOC'DOC'TYPE) + &
                        "-"+DOC'HDR'NO
                IF CUS'PO'CTL = 2 THEN
                        ENTRY = "WARNING - " + ENTRY
                        CALL DO'ERR'OEPACK
                        IER1 = 1
                ELSE
                        CALL DO'ERR'OEPACK
                        PO'ERR = 1
                ENDIF
        ELSE
                PO'ERR = 0
        ENDIF
RETURN

E'OLD'DR:
                !!                      CONTROL RECORD FOR CLEARING ACCT
                !!ADD PAYMENT OF OLD DR TO A/R (CASH ACCT - CLEARING ACT)
                !!INCREASE INVOICE (CAT, GROUP: ARBITRARY,  ACCT - CLEARING ACT)
                !!I DO THIS AT POSTING TIME ...
                !!
        IF INX1 = I'TAB THEN
                HDR'OLD'DR = MAX'DR
                IER1 = 0
        ENDIF

        CASE
        IF INX1 = I'TAB OR (INX2 = FN'7 AND lastfn = ECFLD) THEN
                \SETBIT HDR'MAN'FLAG 8                  !!On Auto
                CALL DSP'BITS
                DO'DR = 1
        ELSE
        IF EFCHG # 0 THEN
                \CLRBIT HDR'MAN'FLAG 8                  !!On Manual
                CALL DSP'BITS
                DO'DR = 0
        ENDCASE

        IF HDR'OLD'DR > MAX'DR THEN
                ENTRY = "Exceeds DRs available of "+(MAX'DR/100 USING "$###,###,###.##-")
                CALL DO'ERR'OEPACK
        ENDIF
RETURN

MAP1 DELETE'CMA'FLAG,S,1
E'OLD'CR:
                        !!
                        !!ADD -PAYMENT OF OLD CR TO A/R
                        !!DECREASE INVOICE
                        !!I DO THIS AT POSTING TIME ...
                        !!
        DELETE'CMA'FLAG = "N"
        IF INX1 = I'TAB THEN
                HDR'OLD'CR = MAX'CR
                IER1 = 0
        ENDIF

        CASE
        IF INX1 = I'TAB OR (INX2 = FN'7 AND lastfn = ECFLD) THEN
                \SETBIT HDR'MAN'FLAG 4                          !!On Auto
                CALL DSP'BITS
                DO'CR = 1
        ELSE
        IF EFCHG # 0 THEN
                \CLRBIT HDR'MAN'FLAG 4                          !!On Manual
                CALL DSP'BITS
                DO'CR = 0
        ENDCASE

        IF HDR'OLD'CR > MAX'CR THEN
                ENTRY = "Exceeds CRs available of "+(MAX'CR/100 USING "$###,###,###.##-")
                CALL DO'ERR'OEPACK
        ENDIF

        CASE
        IF SAVE'HDR'OLD'CR # 0 AND SAVE'HDR'OLD'CR # HDR'OLD'CR AND &
                HDR'OLD'CR # 0 THEN
            ENTRY = "You cannot change auto-applied credit except for zero"
            CALL DO'ERR'OEPACK
            HDR'OLD'CR = SAVE'HDR'OLD'CR
        ELSE
        IF SAVE'HDR'OLD'CR # 0 AND SAVE'HDR'OLD'CR # HDR'OLD'CR AND &
                HDR'OLD'CR = 0 THEN
            DELETE'CMA'FLAG = "Y"
        ELSE
            IF SAVE'HDR'OLD'CR = 0 AND SAVE'HDR'OLD'CR # HDR'OLD'CR THEN
                ENTRY = "Adding credits here not allowed. Add type 4 credit"
                CALL DO'ERR'OEPACK
                HDR'OLD'CR = 0
            ENDIF
        ENDCASE
RETURN

E'OLD'CASH:
        IF INX1 = I'TAB THEN
                HDR'OLD'CASH = MAX'CASH
                IER1 = 0
        ENDIF

        CASE
        IF INX1 = I'TAB OR (INX2 = FN'7 AND lastfn = ECFLD) THEN
                \SETBIT HDR'MAN'FLAG 2                          !!Set auto
                CALL DSP'BITS
                DO'CASH = 1
        ELSE
        IF EFCHG # 0 THEN
                \CLRBIT HDR'MAN'FLAG 2                          !!Set manual
                CALL DSP'BITS
                DO'CASH = 0
        ENDCASE

        IF (HDR'OLD'CASH > MAX'CASH AND MAX'CASH >= 0)                  OR &
           (HDR'OLD'CASH < MAX'CASH AND MAX'CASH <= 0)                  THEN
                ENTRY = "Exceeds cash available of "+(MAX'CASH/100 USING "$###,###,###.##-")
                CALL DO'ERR'OEPACK
        ENDIF
RETURN

MAP1 ORG'SGN,F

GET'MAX'DR'CR:                          !![27] use DOCA2 below.
    TIME'CSV = "GET'MAX'DR'CR:" : \TIME'CSV
    MAX'CR = 0
    MAX'DR = 0
    IF INSTR(1,UCS(TRH'DESC),"CASH&CARRY") = 0 OR           &      !For Evatees
                                    OEPACK'APPLY'NETS = "Y" THEN
        IF TRH'COD'STATUS # 1 OR LOC'APPLY'NETS = "Y" THEN
            DOC'SPACE = SPACE
            DOC'CUS'NO = HDR'NAM'NO
            \SETKEY DOCA MODE="KEY" APID="AR" ALTKEY="DOCA2"
            DOCA2'RCN = 0
            USE DOCA2 INTO DOC'REC KEY DOCA2'KEY
            DO
                GETNXT DOCA2 INTO DOC'REC
                IF DOCA2'CTL # 0 EXIT
                IF DOC'CUS'NO # HDR'NAM'NO EXIT
                IF DOC'HOLD'FLAG # "" REPEAT
                IF OEPACK'APPLY'NETS # "Y" THEN
                    IF DOC'TYPE # 1 REPEAT                  !![27]
                ENDIF
!!below IF MUST match AR1OEU.BV
!!Note: if DOC'SEQ > 0 that means the credit has already been applied to another order
                IF DOC'INV'TYPE >= 1 AND DOC'INV'TYPE <= 9              AND &
                                                DOC'SEQ = 0             THEN
                    IF LOC'ADD'COD(DOC'INV'TYPE) = "Y" THEN
                        TRH'KNO = DOC'TRH'NO    !![15]
                        \VUSE TRH
                        IF TRH'CTP'NO = 0 THEN  !![15] Not on credit card!
                            CALL GET'MAX'DR'CR2  !![14] Moved into a subroutine
                        ELSE
                            IF OEPACK'APPLY'NETS = "Y" THEN
                                CALL GET'MAX'DR'CR2
                            ENDIF
                        ENDIF
                    ENDIF
                ELSE
                    IF DOC'INV'TYPE = 0 AND DOC'SEQ = 0 AND LOC'UNAPPL'COD = "Y" &
                                                  AND DOC'HDR'NO = 0 THEN
                        CALL GET'MAX'DR'CR2
                    ENDIF
                ENDIF
            LOOP
            TRH'KNO = HDR'TRH'NO                    !![41]
            \VUSE TRH                               !![41]
       ENDIF
    ELSE
        TRH'KNO = HDR'TRH'NO
        \VUSE TRH
    ENDIF
    IF HDR'SHP'TOTAL < 0 THEN
        MAX'CR = 0
        MAX'CASH = 0
    ELSE
        MAX'CR = (MAX'CR - MUSED'CR) MAX 0
        MAX'CASH = (MAX'CASH - MUSED'CASH) MAX 0
    ENDIF

    MAX'DR = (MAX'DR - MUSED'DR) MAX 0

    TRH'KNO = HDR'TRH'NO         !![15]
    \VUSE TRH

GET'MAX'DR'CR'RET:

RETURN

MAP1 ORG'INV'TYPE,B,1
MAP1 SAVE'DOC'INVOICE(10),B,3
MAP1 SAVE'DOC'INV'TYPE(10),B,1
MAP1 SAVE'DOC'AMT(10),B,5
MAP1 SAVE'DOC'TYPE(10),B,1
MAP1 SAVE'DOC'BATCH(10),B,2
MAP1 SAVE'DOC'TRN(10),B,2
MAP1 SAVE'DOC'YEAR(10),B,1           !!leave here for future (add to CMA)
MAP1 SAVE'ORG'AMT(10),B,5
MAP1 FFF,F
MAP1 RUNNING'CMA'AMT,B,5
MAP1 PARTIAL'CR,B,5
MAP1 IS'MAX'CR'DR'ZERO,S,1,"N"        !!Set to "Y" to not add CMA records

GET'MAX'DR'CR2:
    TIME'CSV = "GET'MAX'DR'CR2:" : \TIME'CSV
    ORG'SGN = SGN(DOC'AMT)
    ORG'INV'TYPE = DOC'INV'TYPE
    \DOCBAL AKEY="DOCA" PRE="DOC" PRE2="DOC2" BALANCE="BALANCE" &
            ORGAMT="ORGAMT" UNPOSTED="Y" APID="AR"
    IF SGN(BALANCE) = ORG'SGN OR &
            (ORG'INV'TYPE = 0 AND SGN(BALANCE) = -1) THEN
!!
!!From A/R Document Entry Defaults screen
!!Type 1 Invoice         - ARC'INV'CR'YN(1) = "N" ARC'INV'CR'YN(HDR'DOC'TYPE)
!!Type 2 credit memos    - ARC'INV'CR'YN(2) = "Y"
!!Type 4 CR Memo/apply   - ARC'INV'CR'YN(4) = "Y"
!!

        IF ARC'INV'CR'YN(HDR'DOC'TYPE) # "Y" THEN
            IF DOC'INV'TYPE # 4 THEN
                MAX'CR = MAX'CR + (-BALANCE MAX 0)
            ELSE
                CALL DOES'CMA'EXIST        !!this can change BALANCE
                IF CR'DR'USED = "N" THEN  !! True for existing T4CM and T5DM CMA records
                    \HDRSUM PRE="HDR"
                    IF MAX'CR + (-BALANCE MAX 0) > INVOICE'HSUM THEN
                        PARTIAL'CR = (MAX'CR + (-BALANCE MAX 0)) - INVOICE'HSUM
                        BALANCE = BALANCE + PARTIAL'CR
                    ENDIF
                    MAX'CR = MAX'CR + (-BALANCE MAX 0)
                    IF BALANCE # 0 THEN
                        FFF = FFF + 1
                        IF FFF <= 10 THEN
                            SAVE'DOC'INV'TYPE(FFF) = DOC'INV'TYPE
                            SAVE'DOC'INVOICE(FFF) = DOC'INVOICE
                            SAVE'DOC'AMT(FFF) = ABS(BALANCE)
                            SAVE'DOC'TYPE(FFF) = DOC'TYPE
                            SAVE'DOC'BATCH(FFF) = DOC'BATCH
                            SAVE'DOC'TRN(FFF) = DOC'TRN
                            SAVE'DOC'YEAR(FFF) = DOC'YEAR
                            SAVE'ORG'AMT(FFF) = DOC'AMT
                            RUNNING'CMA'AMT = RUNNING'CMA'AMT + (-BALANCE MAX 0)
                        ELSE
                            LENTRY = "MAX'DR'CR2: Unable to use all available credits"
                            \LOG'IT
                        ENDIF
                    ENDIF
                ELSE
                    BALANCE = 0    !!all credit has been used
                ENDIF
            ENDIF
        ENDIF

        IF DOC'INV'TYPE # 5 THEN
            MAX'DR = MAX'DR + (BALANCE MAX 0)
        ELSE
            CALL DOES'CMA'EXIST         !!this can change BALANCE
            IF CR'DR'USED = "N" THEN    !! True for existing T4CM and T5DM CMA records
                MAX'DR = MAX'DR + (BALANCE MAX 0)
            ELSE
                BALANCE = 0    !!Debit has been used
            ENDIF
        ENDIF
    ENDIF
!![27]  DOCD'KEY = DOCD'KEY2
!![27]  DOCD'KSEQ = -1
!![27]  USE DOCD INTO DOC'REC KEY DOCD'KEY

!! T5DM ORDER DO NOT AUTO-APPLY OTHER T4CM AND T5DM TO THE ORDER
    IF HDR'DOC'TYPE = 5 THEN
        MAX'DR = 0
        MAX'CR = 0
    ENDIF

GET'MAX'DR'CR2'RET:

RETURN

MAP1 DISC'PERC,S,1

E'AMT:
        \GETFLD PACK01 HDR'CD(1) V''TMP
        IF OC2'ALLOWM(ECFLD-|V''TMP|+1) = "Y" THEN
                ETYP = ETYP OR E'NEG
        ELSE
                ETYP = ETYP AND (NOT E'NEG)
        ENDIF
        arrowc = arrowc OR |EX'EDD|
        IF EDSPSW # 0 THEN
                IER2 = 0
                RETURN                  !!KLUDGE
        ENDIF
        CALL OEPACK'TST'FUNC
        IF TST'FUNC = 1 RETURN                          !!KLUDGE
!![28]  IF INX1 = I'TAB THEN
!!              \SETBIT HDR'MAN'FLAG 16 !!By order charges on auto
!!              FOR II = 1 TO 6
!!                      HDR'CD(II) = DFLT'VTTL(JJ)
!!              NEXT II
!!              EFCHG = 1
!!      ELSE
!!              IF EFCHG # 0 THEN
!!                      \CLRBIT HDR'MAN'FLAG 16 !!By order charges on manual
!!              ENDIF
!![28]  ENDIF
        IF INX1 = I'TAB OR (INX2 = FN'7 AND lastfn = ECFLD) THEN
            IF (ECFLD-|V''TMP|+1) = OC2'RS'BUCKET THEN
                EFCHG = 0
                \SETBIT HDR'BIT'FLAG 8                  !!Restock auto
                CALL DSP'BITS
                CALL COMPUTE'RESTOCK
            ENDIF
            IER1 = 0
        ENDIF
        IF EFCHG # 0 THEN
                \GETFLD PACK01 HDR'CD(1) V''TMP
                IF OC2'SIGN(ECFLD-|V''TMP|+1) # "-" THEN
                    DISC'PERC = "N"
                ELSE
                    DISC'PERC = OEC'DISC'PERC
                ENDIF
                IF (INSTR(1,ENTRY,"%") # 0 OR (DISC'PERC = "Y"                  AND &
                                                VAL(ENTRY) <= 10000     AND &
                                                INSTR(1,ENTRY,"$") = 0)) THEN
                    \FROUND ((HDR'SHP'TOTAL*VAL(ENTRY))/10000) HDR'CD(II)
                ENDIF
                CHG'AMT = 1
                \GETFLD PACK01 HDR'CD(1) V''TMP
                IF (ECFLD-|V''TMP|+1) = OC2'RS'BUCKET THEN
                    \CLRBIT HDR'BIT'FLAG 8        !!On manual
                    CALL DSP'BITS
                ENDIF
        ENDIF
        IF OC2'ALLOWM(ECFLD-|V''TMP|+1) = "N" AND HDR'CD(ECFLD-|V''TMP|+1) < 0 THEN
                ENTRY = "Cannot enter a minus number!"
                GOTO DO'ERR
        ENDIF
RETURN

E'XTR'AMT:                                              !![28] all this
        CALL OEPACK'TST'FUNC
        IF TST'FUNC = 1 RETURN                          !!KLUDGE
        IF INX1 = I'TAB OR (INX2 = FN'7 AND lastfn = ECFLD) THEN
                \SETBIT HDR'MAN'FLAG 16 !!By order charges on auto
                CALL DSP'BITS
                II = 0
                FOR JJ = 1 TO 7
                        IF ZONE'BOX'ORDER(JJ) = "O" THEN
                                II = II + 1
                                IF II > 4 THEN
                                        ENTRY = "More than 4 ship via by order charges! "+HDR'VIA'NO
                                        CALL DO'ERR'OEPACK
                                        GOTO DEAD'ABORT
                                ENDIF
                                XTR'AMT(II) = DFLT'VTTL(JJ)
                        ENDIF
                NEXT JJ
                EFCHG = 1
        ELSE
                IF EFCHG # 0 THEN
                     \CLRBIT HDR'MAN'FLAG 16 !!By order charges on manual
                     CALL DSP'BITS
                ENDIF
        ENDIF
        IF INX1 = I'TAB THEN IER1 = 0
RETURN

PACK01'AFR:
        \GETFLD PACK01 HDR'CD(1) V''TMP
        ENTRY = "*"
        FOR II = 1 TO 6
                IF OC2'FDESC(II) = "" THEN
                        gafr(|V''TMP|+II-1) = "X"
                        HDR'CD(II) = 0
                ENDIF
        NEXT II
        \GETFLD PACK01 XTR'AMT(1) V''TMP
        FOR II = 1 TO 4
                IF XTR'DESC(II) = "" THEN
                        gafr(|V''TMP|+II-1) = "X"
                ENDIF
        NEXT II
        \AFR EDIT="N"
        IF OEC'FREE'FRT = "N" THEN
            \GAFR PACK01 AFR="XN:HDR'FREE'FRT" EDIT="N"
        ELSE
            \GAFR PACK01 AFR="XN:HDR'CD(1)" EDIT="N"
        ENDIF
        IF OEC'UP'BUCKET # 0 THEN
            \GETFLD PACK01 HDR'CD(1) V''TMP
            ENTRY = "*"
            gafr(OEC'UP'BUCKET-|V''TMP|+1) = "Y"
            \AFR EDIT="N"
        ENDIF
        IF OC2'WB'BUCKET # 0 THEN
            \GETFLD PACK01 HDR'CD(1) V''TMP
            ENTRY = "*"
            gafr(OC2'WB'BUCKET+|V''TMP|-1) = "Y"
            \AFR EDIT="N"
        ENDIF
        IF OC2'RS'BUCKET # 0 THEN
            \GETFLD PACK01 HDR'CD(1) V''TMP
            ENTRY = "*"
            IF SPWASTR[7;1] # "Y" THEN
                gafr(OC2'RS'BUCKET+|V''TMP|-1) = "Y"
            ELSE
                gafr(OC2'RS'BUCKET+|V''TMP|-1) = "E"
            ENDIF
            \AFR EDIT="N"
        ENDIF
        IF BVIA'SHP'FLAG > 1 THEN
            \GAFR PACK01 AFR="X:HDR'WEIGHT" EDIT="N"
        ENDIF
        IF MAX'CASH = 0 THEN
            \GAFR PACK01 AFR="XN:HDR'OLD'CASH" EDIT="N"
        ENDIF
        IF MAX'DR = 0 THEN
            \GAFR PACK01 AFR="XN:HDR'OLD'DR" EDIT="N"
        ENDIF
        IF MAX'CR = 0 THEN
            \GAFR PACK01 AFR="XN:HDR'OLD'CR" EDIT="N"
        ENDIF
        IF SPWASTR[1;1] # "Y" THEN
            \GAFR PACK01 AFR="XN:HDR'BVIA'NO" EDIT="N"
        ENDIF
        IF SPWASTR[2;1] # "Y" THEN
            \GAFR PACK01 AFR="XN:HDR'FREE'FRT" EDIT="N"
        ENDIF
        IF SPWASTR[5;1] # "Y" THEN
            \GAFR PACK01 AFR="XN:HDR'CD(1)+XN:HDR'CD(2)+XN:HDR'CD(3)+XN:HDR'CD(4)+XN:HDR'CD(5)+XN:HDR'CD(6)" EDIT="N"
        ENDIF
        IF SPWASTR[4;1] # "Y" THEN
            \GAFR PACK01 AFR="XN:XTR'AMT(1)+XN:XTR'AMT(2)+XN:XTR'AMT(3)+XN:XTR'AMT(4)" EDIT="N"
        ENDIF
        IF OEC'CHG'TAX # "Y" OR SPWASTR[6;1] # "Y" THEN         !![39]
!![54]          \GAFR PACK01 AFR="XN:HDR'STX1FINAL" EDIT="N"
            \GAFR PACK01 AFR="X:HDR'STX1FINAL" EDIT="N"         !![54]
        ENDIF
        ENTRY = ""
        \DG GETVALUE _OESETUP allow_ffp_change ENTRY
        IF DG'CTL # 0 OR UCS(ENTRY) # "Y" THEN
            \GAFR PACK01 AFR="X:HDR'FFP'NO" EDIT="N"
        ENDIF
RETURN

MAP1 WGT'TYPE,S,1
MAP1 WGT,B,5

MAP1 ZONE'REC
        MAP2 ZONE'SPACE,S
                MAP3    ZONE(7),S,4
                MAP3    ZONE'OVR3
                        MAP4    ZONE'BOX'ORDER(7),S,1
                MAP3    ZONE'OVR4,@ZONE'OVR3
                        MAP4    ZONE'STR2,S,7
                MAP3    ZONE'LOC'NO(7),B,2
                MAP3    ZONE'DISC'PERC(7),B,5
                MAP3    ZONE'IS'ZIP,B,1
                MAP3    UZ(7),S,1
                MAP3    ZONE'REC'SET,B,2
                MAP3    ZONE'FREE'FRT,S,1              !![46]
                MAP3    ZONE'ZONE'PERC,B,1             !![46]

MAP1 AZONE'REC
        MAP2    AZONE(7),S,4
        MAP2    AZONE'OVR3
                MAP3    AZONE'BOX'ORDER(7),S,1
        MAP2    AZONE'OVR4,@AZONE'OVR3
                MAP3    AZONE'STR2,S,7
        MAP2    AZONE'LOC'NO(7),B,2
        MAP2    AZONE'DISC'PERC(7),B,5
        MAP2    AZONE'IS'ZIP,B,1
        MAP2    AUZ(7),S,1
        MAP2    AZONE'REC'SET,B,2
        MAP2    AZONE'FREE'FRT,S,1              !![46]
        MAP2    AZONE'ZONE'PERC,B,1             !![46]

MAP1 BZONE'REC
        MAP2    BZONE(7),S,4
        MAP2    BZONE'OVR3
                MAP3    BZONE'BOX'ORDER(7),S,1
        MAP2    BZONE'OVR4,@BZONE'OVR3
                MAP3    BZONE'STR2,S,7
        MAP2    BZONE'LOC'NO(7),B,2
        MAP2    BZONE'DISC'PERC(7),B,5
        MAP2    BZONE'IS'ZIP,B,1
        MAP2    BUZ(7),S,1
        MAP2    BZONE'REC'SET,B,2
        MAP2    BZONE'FREE'FRT,S,1              !![46]
        MAP2    BZONE'ZONE'PERC,B,1             !![46]

COPYF "VIAFIL[IN]",AVIA,NOAFR
COPYF "VIAFIL[IN]",BVIA,NOAFR

ALLOCATE'CONSTANTS:
    TIME'CSV = "ALLOCATE'CONSTANTS:" : \TIME'CSV
    IF WORK'MODE = "B" THEN
        CALL COMPUTE'TAX
    ENDIF
    IF IN'ALTVIA = 0 THEN
        CALL COMPUTE'WGT'CNT
        IF WORK'MODE = "B" THEN
            HDR'WEIGHT = WGT
            HDR'BOX'COUNT = CNT
        ENDIF
    ENDIF
    CALL DIVIDE'UP
RETURN

MAP1 CNT,B,5
MAP1 FFWGT,B,5
MAP1 OS'WGT,B,5
MAP1 REAL'OS'WGT,B,5

COMPUTE'WGT'CNT:
        TIME'CSV = "COMPUTE'WGT'CNT:" : \TIME'CSV
        OS'WGT =0
        CNT = 0
        WGT = 0
        FFWGT = 0
        IF VIA'SHP'FLAG <= 1 RETURN
        IF WORK'MODE = "B" THEN
           BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
        ELSE
           BKEY = "A" + (HDR'VIA'NO USING "#ZZZ")
        ENDIF
        SBKEY = BKEY
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Totaling weight and box count"
            CALL TCOUNT'START
        ENDIF
        DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                IF BKEY[1;5] # SBKEY EXIT
                IF BCWEIGHT = 0 THEN
                    XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                    REPEAT
                ENDIF
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                WGT = WGT + BCWEIGHT
                FFWGT = FFWGT + BFWEIGHT
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "FFWGT="+FFWGT+" BFWEIGHT="+BFWEIGHT
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
                CNT = CNT + 1
                IF NEED'OS'WGT # 0 THEN
                    II = NEED'OS'WGT
                    CALL FIND'TBL
                ENDIF
                CALL SET'DIM'OS
                CALL LOGIT

                IF BSWGT = 0 THEN
                    OS'WGT = OS'WGT + BCWEIGHT
                ELSE
                    OS'WGT = OS'WGT + (BSWGT*100)
                ENDIF
                ENTRY = "Compute was="+BCWEIGHT+" now set to "+(BSWGT*100)
                CALL LOGIT
        LOOP
        ENTRY = "HDR="+HDR'ACTION+" WGT="+WGT+" FFWGT="+FFWGT
        CALL LOGIT
        IF INC'AUTOPACK = "Y" OR HDR'ACTION = "L" OR HDR'ACTION = "E" THEN
            IF WGT = FFWGT THEN
                \SETBIT HDR'BIT'FLAG 16     !!Set, FFWGT = WGT
            ELSE
                \CLRBIT HDR'BIT'FLAG 16     !!Clear, FFWGT # WGT
            ENDIF
        ENDIF
RETURN

DEFINE SAFACTOR
        CIF 1 AND 1 = "-" THEN
                T|0 = T|0 - B|0
        CELSE
                T|0 = T|0 + B|0
        ENDCIF
ENDMACRO

DEFINE AFACTOR
        !!tries what is passed (usually dollars), then weight, then count
        !!something should work out - there must be a count at least!

        B|3 = 0
        IF |1 # 0 THEN
                \FROUND .999999*((|0/|1)*|2) B|3
        ELSE
                CIF |1 # "WGT" THEN
                        IF WGT # 0 THEN
                                \FROUND .999999*((BCWEIGHT/WGT)*|2) B|3
                        ELSE
                        IF CNT # 0 THEN
                                \FROUND .999999*((1/CNT)*|2) B|3
                        ENDIF
                        ENDIF
                CELSE
                        IF CNT # 0 THEN
                                \FROUND .999999*((1/CNT)*|2) B|3
                        ENDIF
                ENDCIF
        ENDIF
        \SAFACTOR |3
ENDMACRO

MAP1 ROUND'CASH,B,1
MAP1 ROUND'ALL,B,1
MAP1 ROBBED'CASH,B,5
MAP1 ROBBED'CR,B,5

CIF COMMENTS AND NOT COMMENTS THEN
        The reason the below code is so strange is because of the freight

        On per box charges:
                a total is allocated to each box by percentage and then
                on the last box the difference is used. Each box has seven
                ship via totals and the sum of the by order charges within
                those seven is the BVIA'SUM(1).  Easy.

        On per order charges:
                a total is allocated to each box for billing purposes.
                an actual is also allocated to each box for actual.
                However, the total freight charged the customer must
                be what we billed - so the SUM of the actual freight
                BVIA'SUM(2) won't equal to total of the seven feight
                charges .. yech!
ENDCIF

DIVIDE'UP:
        TIME'CSV = "DIVIDE'UP:" : \TIME'CSV
        ROBBED'CASH = 0
        ROBBED'CR = 0
        TCONSTANTS = SPACE
        IF VIA'SHP'FLAG <= 1 RETURN
        BKEY = WORK'MODE + (VIA'NO USING "#ZZZ")
        SBKEY = BKEY
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Divide up constants for "+VIA'DESC
            CALL TCOUNT'START
        ENDIF
        DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                IF BKEY[1;5] # SBKEY EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                IF BNO = CNT THEN
                        BSHP'TOTAL = HDR'SHP'TOTAL - TSHP'TOTAL

                        IF INC'AUTOPACK = "Y" THEN
                            BSHP'TOTAL = BSHP'TOTAL - (HDR'SHP'DISC - TSHP'DISC)
                        ELSE
                            BSHP'DISC = HDR'SHP'DISC - TSHP'DISC
                        ENDIF
                        FOR JJ = 1 TO 6
                                BCD(JJ) = HDR'CD(JJ) - TCD(JJ)
                        NEXT JJ
                        BOLD'CR = HDR'OLD'CR - TOLD'CR
                        BOLD'DR = HDR'OLD'DR - TOLD'DR
                        BOLD'CASH = HDR'OLD'CASH - TOLD'CASH
                        BSHP'STX1 = HDR'STX1FINAL - TSHP'STX1
                        BSHP'STX2 = HDR'STX2FINAL - TSHP'STX2
!!By order charges always rounded properly
                        IF ROUND'ALL = 1 THEN
                            BVIA'SUM(1) = 0
                            BVIA'SUM(2) = 0
!!By order charges
                            FOR JJ = 1 TO 7
                               BSHP'VTTL(JJ) = PSEUDO'VTTL(JJ) - TSHP'VTTL(JJ)
                               IF ZONE'BOX'ORDER(JJ) = "O" THEN
                                    BVIA'SUM(1) = BVIA'SUM(1) + BSHP'VTTL(JJ)
                               ELSE
                                    BVIA'SUM(2) = BVIA'SUM(2) + BSHP'VTTL(JJ)
                               ENDIF
                            NEXT JJ
                        ELSE
                            BVIA'SUM(1) = 0
                            FOR JJ = 1 TO 7
                               IF ZONE'BOX'ORDER(JJ) = "O" THEN
!!By order charges
                                    BSHP'VTTL(JJ) = PSEUDO'VTTL(JJ) - TSHP'VTTL(JJ)
                                    BVIA'SUM(1) = BVIA'SUM(1) + BSHP'VTTL(JJ)
                               ENDIF
                            NEXT JJ
                            IF WORK'MODE = "A" THEN
!!Round the by box charges if in actual mode ...
                                BVIA'SUM(2) = HDR'VIA'SUM(2) - TVIA'SUM(2)
                            ELSE
!!Else on billing sum up the the by box charges
                                BVIA'SUM(2) = 0
                                FOR JJ = 1 TO 7
                                    IF ZONE'BOX'ORDER(JJ) # "O" THEN
                                        BVIA'SUM(2) = BVIA'SUM(2) + BSHP'VTTL(JJ)
                                    ENDIF
                                NEXT JJ
                            ENDIF
                        ENDIF
                ELSE
                        IF INC'AUTOPACK = "Y" THEN
                                BSHP'TOTAL = 0                  !![35]
!![35] - change xkey
                                XKEY = (BNO USING "#ZZZ")
                                DO
                                    XCALL VICSIT,7,4,XREC,XKEY,XPTR,0,XCTL !!GETNXT
                                    IF XCTL # 0 EXIT
                                    IF XNO # BNO EXIT
                                    BSHP'TOTAL = BSHP'TOTAL + XSHP'TOTAL
                                LOOP
                                TSHP'TOTAL = TSHP'TOTAL + BSHP'TOTAL
                                BSHP'DISC = 0
                        ELSE
                                \AFACTOR BCWEIGHT WGT HDR'SHP'TOTAL SHP'TOTAL
                                \AFACTOR BCWEIGHT WGT HDR'SHP'DISC SHP'DISC
                        ENDIF
                        FOR JJ = 1 TO 6
                                \AFACTOR BSHP'TOTAL HDR'SHP'TOTAL HDR'CD(JJ) CD(JJ)
                        NEXT JJ
!!Sum up by order charges as they always equal box amount.
                        IF ROUND'ALL = 1 THEN
                            BVIA'SUM(1) = 0
                            BVIA'SUM(2) = 0
!!By order charges
                            FOR JJ = 1 TO 7
                               \AFACTOR BSHP'TOTAL HDR'SHP'TOTAL PSEUDO'VTTL(JJ) SHP'VTTL(JJ)
                               IF ZONE'BOX'ORDER(JJ) = "O" THEN
                                   BVIA'SUM(1) = BVIA'SUM(1) + BSHP'VTTL(JJ)
                               ELSE
                                   BVIA'SUM(2) = BVIA'SUM(2) + BSHP'VTTL(JJ)
                               ENDIF
                            NEXT JJ
                        ELSE
                            BVIA'SUM(1) = 0
                            FOR JJ = 1 TO 7
                               IF ZONE'BOX'ORDER(JJ) = "O" THEN
                                   \AFACTOR BSHP'TOTAL HDR'SHP'TOTAL PSEUDO'VTTL(JJ) SHP'VTTL(JJ)
!!By order charges
                                   BVIA'SUM(1) = BVIA'SUM(1) + BSHP'VTTL(JJ)
                               ENDIF
                            NEXT JJ
                            IF WORK'MODE = "A" THEN
!!Weirdly notice that sum of shipping charges does NOT equal individuals ...
                                \AFACTOR BSHP'TOTAL HDR'SHP'TOTAL HDR'VIA'SUM(2) VIA'SUM(2)
                            ELSE
!!On billing it does match
                                BVIA'SUM(2) = 0
                                FOR JJ = 1 TO 7
                                    IF ZONE'BOX'ORDER(JJ) # "O" THEN
                                        BVIA'SUM(2) = BVIA'SUM(2) + BSHP'VTTL(JJ)
                                    ENDIF
                                NEXT JJ
                            ENDIF
                        ENDIF
                        \AFACTOR BSHP'TOTAL HDR'SHP'TOTAL HDR'OLD'CR OLD'CR
                        \AFACTOR BSHP'TOTAL HDR'SHP'TOTAL HDR'OLD'DR OLD'DR
                        \AFACTOR BSHP'TOTAL HDR'SHP'TOTAL HDR'OLD'CASH OLD'CASH
                        \AFACTOR BSHP'TOTAL HDR'SHP'TOTAL HDR'STX1FINAL SHP'STX1
                        \AFACTOR BSHP'TOTAL HDR'SHP'TOTAL HDR'STX2FINAL SHP'STX2
                        IF HDR'SHP'TOTAL = 0 CALL FUDGE'ZERO'BOX
                ENDIF
                IF ROUND'CASH = 1 THEN  !!AND IN'ALTVIA = 0
!!We can't have any cash or credits on a credit memo, so below fairly simple.
                        CALL SUM'BTOTAL
                        IF HDR'SHP'TOTAL = 0 AND CALC'BTOTAL < 0 AND &
                                        BCD(1) < 0 AND BSHP'STX1 < 0 AND &
                                        BOLD'CR = 0 AND BOLD'CASH = 0 THEN
!!We are shipping zero dollars, but result may be less than zero if
!!free freight is taxable because we result in negative tax ... fudge it!
!!(it will reduce free freight and related tax until box is zero)
                                HDR'CD(1) = HDR'CD(1) - BCD(1)
                                TCD(1) = TCD(1) - BCD(1)
                                HDR'STX1FINAL = HDR'STX1FINAL - BSHP'STX1
                                FOR PP = .99 TO .01 STEP -.01
                                        \FROUND BCD(1)*PP BCD(1)
                                        \FROUND BSHP'STX1*PP BSHP'STX1
                                        CALL SUM'BTOTAL
                                        IF CALC'BTOTAL > 0 THEN
                                                BCD(1) = BCD(1) - CALC'BTOTAL
                                                CALL SUM'BTOTAL
                                        ENDIF
                                        IF CALC'BTOTAL = 0 THEN
                                                PP = 0
                                        ENDIF
                                NEXT PP
                                HDR'CD(1) = HDR'CD(1) + BCD(1)
                                TCD(1) = TCD(1) + BCD(1)
                                HDR'STX1FINAL = HDR'STX1FINAL + BSHP'STX1
                        ENDIF
                        IF HDR'SHP'TOTAL >= 0 AND CALC'BTOTAL < 0 THEN
                                IF BOLD'CR > 0 THEN
!!take from credit memo first
                                        ROBBED'CR = ROBBED'CR + BOLD'CR
                                        BOLD'CR = (BOLD'CR + CALC'BTOTAL) MAX 0
                                        ROBBED'CR = ROBBED'CR - BOLD'CR
                                        CALL SUM'BTOTAL
                                ENDIF
                        ENDIF
                        IF HDR'SHP'TOTAL >= 0 AND CALC'BTOTAL < 0 THEN
                                IF BOLD'CASH > 0 THEN
!!then take from cash
                                        ROBBED'CASH = ROBBED'CASH + BOLD'CASH
                                        BOLD'CASH = (BOLD'CASH + CALC'BTOTAL) MAX 0
                                        ROBBED'CASH = ROBBED'CASH - BOLD'CASH
                                        CALL SUM'BTOTAL
                                ENDIF
                        ENDIF
!!Then from free freight
                        IF HDR'SHP'TOTAL >= 0 AND CALC'BTOTAL < 0 THEN
                                BCD(1) = BCD(1) - CALC'BTOTAL
                                TCD(1) = TCD(1) - CALC'BTOTAL
                                CALL SUM'BTOTAL
                                IF CALC'BTOTAL < 0 THEN
                                        ENTRY = "CR Box "+BNO+" very weird - signs don't match!"
                                        ENTRY = ENTRY +  " " + &
                                                (HDR'SHP'TOTAL/100 USING "###,###.##-")
                                        ENTRY = ENTRY +  " " + &
                                                (CALC'BTOTAL/100 USING "###,###.##-")
                                        CALL DO'ERR'OEPACK
                                        IF DEBUG'ON = 1 CALL DUMP'BTOTAL
                                        GOTO DEAD'ABORT
                                ENDIF
                        ELSE
                        IF HDR'SHP'TOTAL < 0 AND CALC'BTOTAL > 0 THEN
!!On credits, we can apply DR memos ... only so far ...
                                IF BOLD'DR > 0 THEN
                                        BOLD'DR = (BOLD'DR - CALC'BTOTAL) MAX 0
                                        CALL SUM'BTOTAL
                                ENDIF
                                IF CALC'BTOTAL > 0 THEN
                                        ENTRY = "DR Box "+BNO+" very weird - signs don't match!"
                                        ENTRY = ENTRY +  " " + &
                                                (HDR'SHP'TOTAL/100 USING "###,###.##-")
                                        ENTRY = ENTRY +  " " + &
                                                (CALC'BTOTAL/100 USING "###,###.##-")
                                        CALL DO'ERR'OEPACK
                                        GOTO DEAD'ABORT
                                ENDIF
                        ENDIF
                        ENDIF
                ENDIF
                XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                IF BCTL = 0 THEN
                        XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                ENDIF
                XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
        LOOP
!!Now we need to make sure that due to rounding we did not leave a balance
!!on a box when we did not have to. !![16] this entire thing.
        IF ROUND'CASH = 1 AND (ROBBED'CASH # 0 OR ROBBED'CR # 0) AND &
                                                HDR'SHP'TOTAL >= 0 THEN
                BKEY = WORK'MODE + (VIA'NO USING "#ZZZ")
                SBKEY = BKEY
                DO
                        XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                        IF BCTL # 0 EXIT
                        IF BKEY[1;5] # SBKEY EXIT
                        IF WBWHAP # 1 THEN
                            CALL TCOUNT
                        ENDIF
                        CALL SUM'BTOTAL
                        IF CALC'BTOTAL = 0 REPEAT
                        IF ROBBED'CASH # 0 THEN
                                JJ = ROBBED'CASH MIN CALC'BTOTAL
                                ROBBED'CASH = ROBBED'CASH - JJ
                                BOLD'CASH = BOLD'CASH + JJ
                                CALL SUM'BTOTAL
                        ENDIF
                        IF ROBBED'CR # 0 AND CALC'BTOTAL # 0 THEN
                                JJ = ROBBED'CR MIN CALC'BTOTAL
                                ROBBED'CR = ROBBED'CR - JJ
                                BOLD'CR = BOLD'CR + JJ
                        ENDIF
                        XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                        IF BCTL = 0 THEN
                                XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                        ENDIF
                        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE

                LOOP UNTIL ROBBED'CR = 0 AND ROBBED'CASH = 0
        ENDIF
RETURN

MAP1 TCONSTANTS'REC
    MAP2 TCONSTANTS,S
        MAP3    TCWEIGHT,B,5                    !Total weight

        MAP3    TSHP'STX1,B,5                   !Sales Tax
        MAP3    TSHP'STX2,B,5                   !Extra Tax (Excise, Etc)
        MAP3    TOLD'CASH,B,5                   !Old Cash Applied
        MAP3    TOLD'DR,B,5                     !Old Debits Applied
        MAP3    TOLD'CR,B,5                     !Old Credits Applied
        MAP3    TSHP'VTTL(7),B,5                !Ship Via Totals
        MAP3    TCD(6),B,5                      !Charge/Discount totals
        MAP3    TSHP'TOTAL,B,5                  !Shippable Total
        MAP3    TSHP'DISC,B,5                   !Shippable Discount
        MAP3    TVIA'SUM(2),B,5                 !Ship via summary totals

MAP1 SET'LOC'NO,B,2

SET'BOX'ORDER'B:
        TIME'CSV = "SET'BOX'ORDER'B:" : \TIME'CSV
        IF HDR'FREE'FRT = "O" OR HDR'FREE'FRT = "X" OR &
                                HDR'FREE'FRT = "C" THEN !!Play location games
                CALL FNDLOC
                SET'LOC'NO = ALOC'NO(1)
        ELSE
                SET'LOC'NO = HDR'LOC'NO
        ENDIF

        CALL SET'BILLING'MODE
!![46] don't set user zone here
!![45]  IF VAL(CUS'ZONE) # 0 THEN               !!And game from CUS
!!              IF USER'ZONE # 0 THEN
!!                      USER'ZONE = USER'ZONE MIN VAL(CUS'ZONE)
!!              ELSE
!!                      USER'ZONE = VAL(CUS'ZONE)
!!              ENDIF
!![45]  ENDIF
FF0:
        CALL SET'BOX'ORDER
        BZONE'REC = ZONE'REC
        BZONE'REC'SET = BVIA'NO
        BZONE'FREE'FRT = HDR'FREE'FRT           !![46]
        BZONE'ZONE'PERC = HDR'ZONE'PERC         !![46]
RETURN

SET'BOX'ORDER'A:
        TIME'CSV = "SET'BOX'ORDER'A:" : \TIME'CSV
        CALL SET'ACTUAL'MODE
        SET'LOC'NO = HDR'LOC'NO                 !!No games to play!

!![46]  USER'ZONE = 0
FF2:
        CALL SET'BOX'ORDER
        AZONE'REC = ZONE'REC
        AZONE'REC'SET = AVIA'NO
        AZONE'FREE'FRT = HDR'FREE'FRT           !![46]
        AZONE'ZONE'PERC = HDR'ZONE'PERC         !![46]
RETURN

SET'BOX'ORDER:
  TIME'CSV = "SET'BOX'ORDER:" : \TIME'CSV
  FOR II = 1 TO 7
        UZ(II) = "N"
        IF VIA'TBL'NO(II) # 0 AND FOB'NAM'PERC # 0 THEN
                CALL FIND'TBL
                ZONE'LOC'NO(II) = SET'LOC'NO
                ZONE'DISC'PERC(II) = TBL'DISC'PERC
                IF VIA'SHP'FLAG = 1 AND TBL'BOX'ORDER = "B" THEN
                        TBL'BOX'ORDER = "O"
                ENDIF
                ZONE'BOX'ORDER(II) = TBL'BOX'ORDER
            FIGURE'ZONES:
                CASE
                IF TBL'VTB'TYPE = "Z" THEN
!!Zip/Zone
                    ZON'KTBL'NO = TBL'NO
                    ZON'KLOC'NO = SET'LOC'NO
                    IF HDR'SHP'COU = "US" OR HDR'SHP'COU = "USA" OR &
                                HDR'SHP'COU = "PR" OR HDR'SHP'COU = "VI" THEN
                        ZON'KSTART'ZIP = HDR'SHP'ZIP
                        USE ZON INTO ZON'REC KEY ZON'KEY
                        IF ZON'CTL # 0 THEN
                            GETPRV ZON INTO ZON'REC
                        ENDIF
                        \CHKKEY ZON APID="IN"
                        IF HDR'SHP'ZIP > ZON'END'ZIP THEN ZON'CTL = 1
                    ELSE
                        ZON'KSTART'ZIP = UCS(HDR'SHP'COU)
                        USE ZON INTO ZON'REC KEY ZON'KEY
                    ENDIF
                    IF ZON'CTL # 0 THEN
                        ZON'KLOC'NO = 0
                        USE ZON INTO ZON'REC KEY ZON'KEY
                        IF HDR'SHP'COU = "US" OR HDR'SHP'COU = "USA" OR &
                                HDR'SHP'COU = "PR" OR HDR'SHP'COU = "VI" THEN
                            IF ZON'CTL # 0 THEN
                                GETPRV ZON INTO ZON'REC
                            ENDIF
                            \CHKKEY ZON APID="IN"
                            IF HDR'SHP'ZIP > ZON'END'ZIP THEN ZON'CTL = 1
                        ENDIF
                    ENDIF
                    IF ZON'CTL # 0 THEN
                        IF HDR'SHP'ZIP # SHIP'ZIP THEN
                            HDR'SHP'ZIP = SHIP'ZIP
                            GOTO FIGURE'ZONES
                        ENDIF
                        IF IN'ALTVIA = 0 THEN
CIF OLD AND NOT OLD THEN
                            ENTRY = "Invalid ZIP/ZONE cross ref: "
                            \HDRERR APID="OE"
                            \KERROR ZON MODE="K" CNO="N" APID="IN"
                            IF ZON'CTL = 0 THEN
                                \KERROR ZON MODE="D" CNO="N" APID="IN"
                                ENTRY = ENTRY + " End: " + ZON'END'ZIP
                            ELSE
                                ENTRY = ENTRY + " CTL=" + ZON'CTL
                            ENDIF
ENDCIF
                            ENTRY = "This Via is not available for current shipping address."
                            CALL DO'ERR'OEPACKL
                            GOTO DEAD'ABORT         !![36]
                        ELSE
                            SAV'VIA'NO(ALTVIA'II) = 0
                        ENDIF
                        ZONE(II) = ""
                    ELSE
                        ZONE(II) = ZON'ZONE
                    ENDIF

                    VTB'KTBL'NO = TBL'NO
                    VTB'KLOC'NO = 0
                    VTB'KZONE = ZONE(II)
                    VTB'KWEIGHT'AMT = 0
                    USE VTB INTO VTB'REC KEY VTB'KEY
                    IF VTB'CTL # 0 THEN
                        ENTRY = "VTB Zone "+ZONE(II)+" out of range "
                        \KERROR VTB MODE="K" CNO="N" APID="IN"
                        \HDRERR APID="OE"
                        CALL DO'ERR'OEPACKL
                        GOTO DEAD'ABORT
                    ENDIF

                    IF ZONE'IS'ZIP = 0 THEN ZONE'IS'ZIP = II
!![46] below set user zone
                    IF HDR'FREE'FRT = "Z" OR HDR'FREE'FRT = "X" THEN
                                        !!Play "zone" games from HDR
                        USER'ZONE = HDR'ZONE'PERC
                    ELSE
                        USER'ZONE = 0
                    ENDIF
                    IF USER'ZONE # 0 AND WORK'MODE = "B" THEN   !![46] test mode
                        VTB'KTBL'NO = TBL'NO
                        IF INC'MULTI'LOC = "Y" THEN
                            LOC'KNO = LOC'NO
                        ELSE
                            LOC'KNO = 0
                        ENDIF
                        VTB'KLOC'NO = LOC'KNO
                        VTB'KZONE = STR(USER'ZONE)
                        VTB'KWEIGHT'AMT = 99999999999
                        RDKEY VTB
                        GETPRV VTB
                        VTB'KEY = VTB'KEY2
                        IF VTB'KTBL'NO # TBL'NO OR VTB'KLOC'NO # LOC'KNO OR &
                                          VAL(VTB'KZONE) # USER'ZONE THEN
                            IF LOC'KNO # 0 THEN
                                VTB'KLOC'NO = 0
                                VTB'KZONE = STR(USER'ZONE)
                                VTB'KWEIGHT'AMT = 99999999999
                                RDKEY VTB
                                GETPRV VTB
                                VTB'KEY = VTB'KEY2
                                IF VTB'KTBL'NO # TBL'NO OR VTB'KLOC'NO # 0 OR &
                                            VAL(VTB'KZONE) # USER'ZONE THEN
                                    VTB'CTL = 1
                                ENDIF
                            ELSE
                                VTB'CTL = 1
                            ENDIF
                        ENDIF
                        IF USER'ZONE # 0 AND VTB'CTL = 0 AND &
                                    USER'ZONE < VAL(ZONE(II)) THEN
                            ZONE(II) = STR(USER'ZONE)
                            UZ(II) = "Y"
                        ENDIF
                    ENDIF
                ELSE
                IF TBL'VTB'TYPE = "O" THEN
!!Customer Zone
                    IF CUS'ZONE # "" THEN
                        ZONE(II) = CUS'ZONE
                    ELSE
                        IF CUS'FREE'FRT = "X" OR CUS'FREE'FRT = "Z" THEN !![45]
                            ZONE(II) = STR(CUS'ZONE'PERC)
                        ELSE
                            IF IN'ALTVIA = 0 THEN
                                ENTRY = "Invalid Customer Zone"
                                CALL DO'ERR'OEPACK
                            ELSE
                                SAV'VIA'NO(ALTVIA'II) = 0
                            ENDIF
                            ZONE(II) = ""
                        ENDIF
                    ENDIF
                ELSE
                IF TBL'VTB'TYPE = "S" THEN
!!Single Rate (no zone)
                    ZONE(II) = "ZONE"
                ELSE
!!='N' = Operator enter zone
                    ENTRY = "THIS DOES NOT WORK!"
                    CALL DO'ERR
                ENDCASE
        ELSE
            ZONE(II) = ""
            ZONE'BOX'ORDER(II) = ""
            PSEUDO'VTTL(II) = 0
        ENDIF
  NEXT II
RETURN

MAP1 ZONE'OK,S,1
MAP1 WGT'TST,B,5
MAP1 CALC'TBL'AMT,B,5

CALC'TBL'AMT:
    TIME'CSV = "CALC'TBL'AMT:" : \TIME'CSV
    IF II = 1 THEN    !!Freight
        CASE
        IF VIA'MTYPE = "F" THEN
            CALL GET'FEDEX'CALC'TBL'AMT
        ELSE
        IF VIA'MTYPE = "E" THEN
            CALL GET'ENDICIA'CALC'TBL'AMT
        ELSE
            CALL CALC'TBL'AMT'OTHER
        ENDCASE
    ELSE
        CALL CALC'TBL'AMT'OTHER
    ENDIF
RETURN

MAP1 MON'MQID,B,4
MAP1 MON'KEY,B,2
MAP1 MON'REC
    MAP2 MON'SPACE,S
        MAP3 MON'PRGNAM,S,6
        MAP3 MON'ENTRY,S,166            !!Data message
        MAP3 MON'UDT,B,4
        MAP3 MON'NOLF,B,1
MAP1 NOLF,B,1

MAP1 MSP,S,20
MAP1 SPOT,F,6
MAP1 SPEED'T2,F,6
MAP1 SNDMON'LOG,S,100
MAP1 INTERNATIONAL,B,1
MAP1 ZZZ,F,6
MAP1 RESPONSE'NAME,S,128
MAP1 ETIME,F,6
MAP1 DENTRY,S,160

SNDMON:
    TIME'CSV = "SNDMON:" : \TIME'CSV
    IF DOING'WLSCAN # 0 RETURN            !!KLUDGE
    IF MON'MQID # 0 AND ENTRY # "" THEN   !!Only for use with OEDSHP
        MON'SPACE = SPACE
        MON'PRGNAM = "OE1SHP"
        \DG GETVALUE _OESETUP monMS MSP
        IF MSP = "Y" THEN
            MSP = STR(SPEED'T2)
            MSP = LEFT(MSP+"000000000",12)
            MON'ENTRY = MSP+":"+ENTRY
        ELSE
            MON'ENTRY = ENTRY
        ENDIF
        MON'NOLF = NOLF
        NOLF = 0
        \S'TO'U UDT="MON'UDT"
        MON'MQID = MON'MQID
        MON'KEY = 1                !!1 for sending to monitor
        \VIPCSND MON'REC DEST="MON'KEY" CTL="VMYCTL" MQID="MON'MQID"
        IF SNDMON'LOG = "" THEN
            \DG GETVALUE _UPSETUP sndmon_log SNDMON'LOG
            IF DG'CTL # 0 OR SNDMON'LOG # "Y" THEN
                SNDMON'LOG = "N"
            ENDIF
            IF SNDMON'LOG = "Y" THEN
                SNDMON'LOG = "/logs/sndmon.DAILY"
            ENDIF
        ENDIF
        IF SNDMON'LOG # "N" THEN
            \U'TO'DTT'HMS UDT="MON'UDT"
            \STRDTC DDATE="DENTRY"
            DENTRY = MON'PRGNAM+":"+MON'ENTRY+" D="+DENTRY+ &
                (HRS USING "#Z") + ":" + &
                    (MNS USING "#Z") + ":" + (SEC USING "#Z")
            \ABLOGGER DENTRY SNDMON'LOG
        ENDIF
    ENDIF
RETURN

SET'UP'CALC'TBL:
        TIME'CSV = "SET'UP'CALC'TBL: HDR'NO="+HDR'NO+" VIA'NO="+HDR'VIA'NO
        \TIME'CSV
        VIA'KNO = HDR'VIA'NO
        CALL FIND'VIA
        IF OVIA'TBL'NO(1) = 0 OR II # 1 THEN
            CALC'TBL'AMT = 0
            RETURN                            !!KLUDGE
        ENDIF
        CALL FIND'TBL
        IF SHIP'COUNTRY = "US" OR SHIP'COUNTRY = "USA" OR &
                    SHIP'COUNTRY = "U.S." OR SHIP'COUNTRY = "" THEN
            INTERNATIONAL = 0
        ELSE
            INTERNATIONAL = 1
        ENDIF

        CALL SET'WGT'FROM'BOX'CHARGES

        IF CLOSEST'LOC'FLAG # 0 THEN
            LOC'KNO = ALOC'NO(1)
        ELSE
            LOC'KNO = HDR'LOC'NO
        ENDIF
        \VUSE LOC
        \USELST LOC'LST'NO ALTFLD="LOC'ALT'SEQ"
RETURN

GET'ENDICIA'CALC'TBL'AMT:
    TIME'CSV = "GET'ENDICIA'CALC'TBL'AMT:"
    \TIME'CSV
RETURN                        !!Get FedEx working before working on Endicia
CIF NOW AND NOT NOW
    CHG'TO'VIA'NO = 0
    CALL SET'UP'CALC'TBL
    \USELST LOC'LST'NO
    L1LST'REC = LST'REC
    IF RATE'SHOPPING = 0 THEN
        CALL FLIP'SHIP'VIAS         !!adrchk.cpy[OE]
    ENDIF
    IF CHG'TO'VIA'NO = 0 THEN
        ZZZ = 0
        IF HDR'SPECIAL # "A" THEN
            RESPONSE'NAME = "/tmp/reuse_"+STR(HDR'NO)+"_"+STR(BOX'NO)+"_"+STR(VIA'NO)+".PID"
            XCALL ABUTIL,46,RESPONSE'NAME,RESPONSE'NAME
            ETIME = 0
            CALL ENDICIA'RATE'REQUEST         !! Put in Endicia rate call here
            CIF RATE'DEBUG = "Y" THEN
                DENTRY = "Order: "+HDR'NO+" Box: "+BOX'NO+" After rate request amt is: "+ CALC'TBL'AMT+" time="+ETIME
                XCALL VICSIT,26,DENTRY,"/logs/shiprates.DAILY"
            ENDCIF
            ENTRY = "Endica rate request "+STR(VIA'NO)+" time: "+STR(ETIME)
            IF CALC'TBL'AMT = 0 THEN
                ENTRY = ENTRY + "(INVALID ZERO)"
            ELSE
                IF ETIME = 0 THEN
                    ENTRY = ENTRY + " (call saved)"
                ENDIF
            ENDIF
            \HDRERR
            CALL SNDMON
            IF CALC'TBL'AMT # 0 THEN
                CASE
                IF VIA'MAN'YN = "1" THEN
                    \DG GETVALUE _UPSETUP endicia.firstupchargePercent ZZZ
                    IF DG'CTL = 0 AND ZZZ > 0 THEN
!!Malavern              \FROUND CALC'TBL'AMT*((ZZZ+100)/100) CALC'TBL'AMT
                    ENDIF
                ELSE
                IF VIA'MAN'YN # "1" THEN
                    \DG GETVALUE _UPSETUP endicia.otherupchargePercent ZZZ
                    IF DG'CTL = 0 AND ZZZ > 0 THEN
!!Malvern       \FROUND CALC'TBL'AMT*((ZZZ+100)/100) CALC'TBL'AMT
                    ENDIF
                ELSE
                    \DG GETVALUE _UPSETUP endicia.upchargePercent ZZZ
                    IF DG'CTL = 0 AND ZZZ > 0 THEN
!!Malvern               \FROUND CALC'TBL'AMT*((ZZZ+100)/100) CALC'TBL'AMT
                    ENDIF
                ENDCASE
                CIF RATE'DEBUG = "Y" THEN
                    DENTRY = "Order: "+HDR'NO+" Box: "+BOX'NO+" After Endicia up chg amt is: "+ CALC'TBL'AMT
                    XCALL VICSIT,26,DENTRY,"/logs/shiprates.DAILY"
                ENDCIF
            ENDIF
        ELSE
            CALC'TBL'AMT = 0
        ENDIF
    ENDIF
RETURN
ENDCIF

\COPYF MBX OE MODE="PRI"        !!For Malvern
COPYF "BOXFIL[OE]",=BOX8        !!For Malvern
MAP1 MBXERROR'COUNT,F
MAP1 OVERSIZE'TRK'NO,B,3

CALC'TBL'AMT'OTHER:
        TIME'CSV = "CALC'TBL'AMT'OTHER: II="+II+" BNO="+BNO
        \TIME'CSV

        IF II = 2 THEN
            IF MBX'COD'FEE > 0 THEN
                CALC'TBL'AMT = MBX'COD'FEE
            ELSE
                CALC'TBL'AMT = 0
            ENDIF
            RETURN
        ENDIF

!!Malvern is not ready to give us COD charge so we have to do that ourselves
!!
!!II = 2 COD CHARGE,  II = 3 INSURANCE
!!
!!if VIA'CARRIER is not set then skip Malvern Call - Malvern Carrier Code
!! UPS Charges
!!Freight     VIA'CHG'OPT(1) = 0 Box    This program uses the value of 0 for box
!!COD Charge  VIA'CHG'OPT(2) = 2 COD
!!Insurance   VIA'CHG'OPT(3) = 3 Insurance
!!Box Chg.    VIA'CHG'OPT(4) = 1 Box Charge
!!Sm Ord.     VIA'CHG'OPT(5) = 4 Small Order Charge
!!
!!      IF II = 1 AND VIA'CARRIER # "" AND HDR'NO > 0 AND BNO > 0 THEN
    IF (HDR'VIA'NO >= OEC'SCUS'VIA AND HDR'VIA'NO <= OEC'ECUS'VIA) OR &
                VIA'MTYPE = "O" THEN    !!Manifest flag = Other
        VIA'MTYPE = VIA'MTYPE    !!I need something for this IF - customer pickup
    ELSE
        IF II < 2 AND VIA'CARRIER # "" AND HDR'NO > 0 AND BNO > 0 THEN
            MBX'HDR'LOC'NO = HDR'LOC'NO
            MBX'DOC'TYPE = HDR'DOC'TYPE
            MBX'HDR'NO = HDR'NO
            MBX'BOX'NO = BNO                 !!BNO is current Box - not BOX'NO
            MBX'SHIPMENT = 0
            \SETKEY MBX MODE="KEY" APID="OE"
            RDLOCK MBX INTO MBX'REC KEY MBX'KEY
            IF MBX'CTL = 0 THEN
!!FLAT RATE
                CALL FLAT'RATE'TEST
                CASE
                IF TBL'WEIGHT'AMT = "G" OR TBL'WEIGHT'AMT = "S" OR &
                        TBL'WEIGHT'AMT = "D" OR TBL'WEIGHT'AMT = "U" OR &
                        TBL'WEIGHT'AMT = "E" OR TBL'WEIGHT'AMT = "V" THEN
                    IF BNO = 1 THEN
                        IF FLAT'DISC'AMT > 0 THEN
                            CALC'TBL'AMT = FLAT'DISC'AMT
                        ELSE
                            CALC'TBL'AMT = 0    !!leave as zero?
                            MBXERROR'COUNT = MBXERROR'COUNT + 1
                            XCALL GIN,"Flat Rate failed!  Fix via setup."
                        ENDIF
                    ELSE
                        CALC'TBL'AMT = 0    !!Box # > 1 will be set to zero
                    ENDIF
                    MBX'OVR'RT'TYP = TBL'BOX'ORDER  !Override Rate Type, B:Box or O:Order
                    MBX'DIS'PC'TYP = TBL'WEIGHT'AMT !Discount Percent Type, D:Down, U:Up
                    MBX'DISC'PCT = LAST'VTB'PERC    !Discount Percent
                    IF TBL'WEIGHT'AMT = "D" OR TBL'WEIGHT'AMT = "U" THEN
                        MBX'DIS'PC'AMT = FLAT'DISC'AMT  !Discount Percent Amount
                    ELSE
                        MBX'FLT'RT'AMT = FLAT'DISC'AMT  !Flat Rate Amount
                    ENDIF
                    WRITE MBX FROM MBX'REC KEY MBX'KEY
                ELSE
                    CALC'TBL'AMT = MBX'TTL'NONDIS    !!non-discount freight rate
                    REL MBX
                ENDCASE
            ELSE
!!This should never happen because we test MBX in CREATE'MBX:
                CALC'TBL'AMT = 0
                MBXERROR'COUNT = MBXERROR'COUNT + 1
            ENDIF

            ZONE'OK = "Y"
            GOTO CALC'TBL'AMT'OTHER2    !!UGLY but should not RETURN
!!Note: We could remove or CIF the code below since we don't need to lookup
!!      the rate with VICS UPS tables but I will leave it here for now. Saul
        ENDIF
    ENDIF

        IF VIA'CHG'OPT(II) => 1 AND VIA'CHG'OPT(II) <= 5 THEN
            IF CUS'FCHG'YN(VIA'CHG'OPT(II)) = "N"  OR  CUS'FCHG'YN(VIA'CHG'OPT(II)) = "O" THEN
                VIA'TBL'NO(II) = 0
            ENDIF
        ENDIF
        ENTRY = "VIA TBL="+VIA'TBL'NO(II)
        CALL LOGIT
        IF VIA'TBL'NO(II) = 0 THEN
            DFLT'VTTL(II) = 0
            CALC'TBL'AMT = 0
            RETURN
        ENDIF
        CALL FIND'TBL
        IF TBL'CTL # 0 THEN
            CALC'TBL'AMT = 0
            ENTRY = "Cannot find table "+STR(VIA'TBL'NO(II))+" for "+STR(II)+" on via "+VIA'NO
            GOTO DO'ERR
        ENDIF
        VTB'KTBL'NO = TBL'NO
        VTB'KZONE = ZONE(II)
        AMT1 = CALC'TBL'AMT
!!      ENTRY = "AMT1="+AMT1
!!      CALL LOGIT
        CALC'TBL'AMT = 0
!!if zone (converted to numeric) is legal for UPS 100 weight    !![92] below
        IF TBL'WEIGHT'AMT = "W" AND &
            (SHIP'COUNTRY = "USA" OR SHIP'COUNTRY = "US" OR SHIP'COUNTRY = "PR") THEN
!![2] - rewrote below for 500 wgt, fixed zones for ground ...
            ZONE'OK = "?"
            VTB'KLOC'NO = VTB'KZONE
!!California Overnight
            IF VIA'MTYPE = "C" THEN
                IF VIA'MAN'YN = "C" OR VIA'MAN'YN = "G" OR VIA'MAN'YN = "C" THEN
                    ZONE'OK = "N"
                    IF VTB'KLOC'NO >= 1 AND VTB'KLOC'NO <= 7 THEN
                        ZONE'OK = "Y"
                    ENDIF
                ENDIF
            ENDIF

            IF VIA'MTYPE = "U" THEN
                CASE
!!Ground
                IF VIA'MAN'YN = "C" OR VIA'MAN'YN = "G"         OR &
                                VIA'MAN'YN = "F" OR VIA'MAN'YN = "H" THEN
                        ZONE'OK = "N"
                        IF VTB'KLOC'NO >= 2 AND VTB'KLOC'NO <= 8 OR &
                           VTB'KLOC'NO >= 44 AND VTB'KLOC'NO <= 46 THEN
                               ZONE'OK = "Y"
                        ENDIF
                        IF VIA'MAN'YN = "H" AND VTB'KZONE = "A" THEN ZONE'OK = "Y"
                        IF VIA'MAN'YN = "F" AND VTB'KZONE = "A" THEN ZONE'OK = "Y"
                        IF VIA'MAN'YN = "C" THEN
                            IF VTB'KLOC'NO >= 9 AND VTB'KLOC'NO <= 11 THEN
                                ZONE'OK = "Y"
                            ENDIF
                        ENDIF
                ELSE
!!Second day
                IF VIA'MAN'YN = "S" OR VIA'MAN'YN = "2" OR VIA'MAN'YN = "Y" THEN
                        ZONE'OK = "N"
                        IF VIA'MAN'YN # "2" THEN                        !![40]
                                IF VTB'KLOC'NO >= 12 AND VTB'KLOC'NO <= 18 THEN ZONE'OK = "Y"
                        ELSE
                                IF VTB'KLOC'NO = 12 THEN ZONE'OK = "Y"
                        ENDIF

                        IF VTB'KLOC'NO >= 202 AND VTB'KLOC'NO <= 226 THEN ZONE'OK = "Y"

                        IF VTB'KLOC'NO >= 242 AND VTB'KLOC'NO <= 248 THEN
                            ZONE'OK = "Y"
                        ENDIF
                ELSE
!!Next day
                IF VIA'MAN'YN = "A" OR VIA'MAN'YN = "1" OR VIA'MAN'YN = "X" THEN
                        ZONE'OK = "N"
                        IF VIA'MAN'YN # "1" THEN                        !![40]
                                IF VTB'KLOC'NO >= 22 AND VTB'KLOC'NO <= 28 THEN ZONE'OK = "Y"
                        ELSE
                                IF VTB'KLOC'NO = 22 THEN ZONE'OK = "Y"
                        ENDIF
                        IF VTB'KLOC'NO >= 102 AND VTB'KLOC'NO <= 126 THEN ZONE'OK = "Y"
                        IF VTB'KLOC'NO >= 132 AND VTB'KLOC'NO <= 138 THEN
                                ZONE'OK = "Y"
                        ENDIF
                        IF VTB'KLOC'NO >= 142 AND VTB'KLOC'NO <= 146 THEN
                            ZONE'OK = "Y"
                        ENDIF
                        IF VTB'KLOC'NO = 152 THEN ZONE'OK = "Y"
                        IF VTB'KLOC'NO = 12 THEN ZONE'OK = "Y"
                ELSE
!!Third day
                IF VIA'MAN'YN = "R" OR VIA'MAN'YN = "3" OR VIA'MAN'YN = "Z" THEN
                        ZONE'OK = "N"
                        IF VIA'MAN'YN # "3" THEN                        ![40]
                                IF VTB'KLOC'NO >= 32 AND VTB'KLOC'NO <= 38 THEN ZONE'OK = "Y"
                        ELSE
                                IF VTB'KLOC'NO = 32 THEN ZONE'OK = "Y"
                        ENDIF
                        IF VTB'KLOC'NO >= 302 AND VTB'KLOC'NO <= 308 THEN ZONE'OK = "Y"
                ENDCASE
            ENDIF
            IF VIA'MTYPE = "U" THEN
                IF VIA'MAN'YN = "1" OR VIA'MAN'YN = "2" OR VIA'MAN'YN = "3" OR &
                   VIA'MAN'YN = "X" OR VIA'MAN'YN = "Y" OR VIA'MAN'YN = "Z" OR &
                   VIA'MAN'YN = "H" OR VIA'MAN'YN = "F" THEN
                        IF ZONE'OK = "Y" THEN
                                CALL SET'SHIP'LST'RECORD
                                IF SHIP'ST = LOC'NO'100'ST THEN ZONE'OK = "N"
                                IF SHIP'ST = "" THEN
                                        ZONE'OK = "N"
                                        ENTRY = "Ship to state is blank - cannot ship!"
                                        CALL DO'ERR'OEPACK
                                ENDIF
                        ENDIF
                ENDIF
            ENDIF
            IF ZONE'OK = "N" THEN
!!For Sun???
                IF SHIP'ST = "HI" AND (VTB'KLOC'NO = 1 OR &
                                    VTB'KLOC'NO = 12 OR VTB'KLOC'NO = 40) THEN
                    LOC'KNO = HDR'LOC'NO
                    \VUSE LOC
                    \USELST LOC'LST'NO ALTFLD="LOC'ALT'SEQ"
                    IF LST'ST = "HI" THEN
                        ZONE'OK = "Y"
                    ENDIF
                ENDIF
                IF ZONE'OK = "N" THEN
                    IF IN'ALTVIA = 0 THEN
                        ENTRY = "Invalid zone ok "+VIA'MAN'YN+"-"+STR(II)+" "
                        \KERROR VTB APID="IN" CNO="N" MODE="K"
                        ENTRY = ENTRY + " MODE="+WORK'MODE+" BVIA="+BVIA'NO+" AVIA="+AVIA'NO+" VIA="+VIA'NO
                        GOTO DO'ERRL
                    ELSE
                        SAV'VIA'NO(ALTVIA'II) = 0
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        IF INC'MULTI'LOC = "Y" THEN
                VTB'KLOC'NO = ZONE'LOC'NO(II)
        ELSE
                VTB'KLOC'NO = 0
        ENDIF
!!actual normal freight calculations by weight and box ("W")
        CASE
        IF TBL'WEIGHT'AMT = "W" THEN
                IF TBL'BOX'ORDER = "B" THEN
                        IF TBL'OVERSIZ1 # 0 OR TBL'OVERSIZ2 # 0 OR &
                                TBL'OVERSIZ3 # 0 THEN
                            NEED'OS'WGT = II
                            ENTRY = "TBL1="+TBL'OVERSIZ1+" TBL2="+TBL'OVERSIZ2+&
                                    " TBL3="+TBL'OVERSIZ3
                            CALL LOGIT
                        ENDIF
!!we could change         the weight here    !!place  !!cache
                        CALL SET'DIM'OS  !!Things that change weight
                        AMT1 = 0
                        NEED'OS'WGT = 0
                        IF BSWGT # 0 THEN
                            VTB'KWEIGHT'AMT = BSWGT*100
                        ELSE
                            VTB'KWEIGHT'AMT = ABS(BCWEIGHT) + 99
                        ENDIF
                        ENTRY = "USING WGT: "+VTB'KWEIGHT'AMT+" OVERSIZ1="+BOVERSIZ1+" OS="+TBL'OVERSIZ1+&
                                " OVERSIZ2="+BOVERSIZ2+" OS="+TBL'OVERSIZ2+ &
                                " OVERSIZ3="+BOVERSIZ3+" OS="+TBL'OVERSIZ3
                        CALL LOGIT
                        ENTRY = ""
                ELSE
                        ENTRY = "WARNING:  Invalid TBL file"
                        CALL DO'ERR'OEPACK
                        RETURN                  !!KLUDGE FOR NOW
                ENDIF
        ELSE
        IF TBL'WEIGHT'AMT = "A" THEN
                IF TBL'BOX'ORDER = "B" AND VIA'SHP'FLAG # 1 THEN
                    VTB'KWEIGHT'AMT = ABS(BSHP'TOTAL)
                ELSE
                    IF TBL'INC'SPLITS = "Y" THEN
                        VTB'KWEIGHT'AMT = (ABS(HDR'SHP'TOTAL) MAX (HDR'FFP'TOTAL*100))
                    ELSE
                        VTB'KWEIGHT'AMT = ABS(HDR'SHP'TOTAL)
                    ENDIF
                ENDIF
        ELSE
        IF TBL'WEIGHT'AMT = "F" THEN
                VTB'KWEIGHT'AMT = 0
        ENDCASE
        VTB'KWEIGHT'AMT = ABS(VTB'KWEIGHT'AMT)
RECHECK'VTB:
        IF VTB'KLOC'NO = HDR'LOC'NO THEN
            DD = 1
        ELSE
            DD = 0
        ENDIF
!!Look in cache
        XCALL VICSIT,7,106,VTB'REC,0,VTBPTR,0,VTB'PKT,VTB'KEY
        IF VTB'CTL # 0 THEN
!!Not in cache
                USE VTB INTO VTB'REC KEY VTB'KEY
                IF VTB'CTL # 0 THEN GETPRV VTB INTO VTB'REC
                \CHKKEY VTB APID="IN"
                IF VTB'CTL # 0 THEN
                        VTB'SPACE = SPACE
                ENDIF
!!Put in cache - EVEN IF CTL # 0 so I don't keep looking for it
                XCALL VICSIT,7,105,VTB'REC,0,VTBPTR,0,VTB'PKT,VTB'KEY
        ENDIF
!!Check CTL and TBL'NO in case in cache but not valid
        IF VTB'CTL # 0 OR VTB'TBL'NO = 0 THEN
                VTB'KLOC'NO = 0
!!Look for this one in cache
                XCALL VICSIT,7,106,VTB'REC,0,VTBPTR,0,VTB'PKT,VTB'KEY
                IF VTB'CTL # 0 THEN
                        USE VTB INTO VTB'REC KEY VTB'KEY
                        IF VTB'CTL # 0 THEN GETPRV VTB INTO VTB'REC
                        \CHKKEY VTB APID="IN"
                        IF VTB'CTL # 0 THEN
                                VTB'SPACE = SPACE
                        ENDIF
!!And put this one in cache even if bad CTL
                        XCALL VICSIT,7,105,VTB'REC,0,VTBPTR,0,VTB'PKT,VTB'KEY
                ENDIF
        ENDIF
!!And make sure we test TBL'NO in case in cache invalid
        IF VTB'CTL # 0 OR VTB'TBL'NO = 0 THEN
                IF DD = 0 AND INC'MULTI'LOC = "Y" THEN
                        ENTRY = "This ship via not available from closest location."
                        CALL DO'ERR'OEPACK
                        ENTRY = "Customer charged actual freight."
                        \KERROR VTB MODE="K" APID="IN" CNO="N"
                        CALL DO'ERR'OEPACK
                        VTB'KLOC'NO = HDR'LOC'NO
                        VTB'KZONE = AZONE(II)
                        IER1 = 1
                        GOTO RECHECK'VTB
                ELSE
                        IF IN'ALTVIA = 0 THEN
                            ENTRY = "Invalid VIA table (VTB) "+II+" L="+ZONE'LOC'NO(II)+" K="
                            \KERROR VTB MODE="K" APID="IN" CNO="N"
                            CALL DO'ERR'OEPACK
                        ELSE
                            SAV'VIA'NO(ALTVIA'II) = 0
                        ENDIF
                ENDIF
        ENDIF                                           !![42]
        MAP1 AMT2,B,5
        IF TBL'WEIGHT'AMT = "F" AND ZONE(II) = "ZONE" AND       &
                                        VTB'RATE = 0 AND VTB'PERC = 0 THEN
                IF VTB'FLAG # "L" THEN
                        CALC'TBL'AMT = AMT1
                ELSE
                        CALC'TBL'AMT = 0
                ENDIF
        ELSE
                AMT1 = VTB'RATE
                IF TBL'WEIGHT'AMT = "A" THEN
                    AMT2 = (VTB'PERC * VTB'KWEIGHT'AMT)/10000
                ELSE
                    AMT2 = 0
                ENDIF
                CASE
                IF VTB'FLAG = "H" THEN
                        IF ((TBL'OVERSIZ1 # 0 OR TBL'OVERSIZ2 # 0 OR &
                                                    TBL'OVERSIZ3 # 0) AND &
                                    VIA'DIM'YN = "O") OR &
                                    VIA'DIM'YN = "B" OR &
                                                VIA'DIM'YN = "Y" THEN
                            AMT1 = REAL'OS'WGT   !![56]
                        ELSE                     !![56]
                            AMT1 = WGT           !![56]
                        ENDIF                    !![56]
                                                 !![56] use OS'WGT not WGT
                                                 !!Total weight of all boxes
                                                 !!with oversize figured in.
                        CALL CALC'CWT
!!difference of freight charged on all previous boxes and total order
!!very wrong            AMT2 = AMT1 - ((HDR'BOX'COUNT-1)*AMT2)
!!also wrong            AMT2 = AMT1 - PSEUDO'VTTL(II)
                        IF BNO = CNT THEN
                                AMT2 = AMT2 + (AMT1 - (AMT2*CNT))
                        ENDIF
                        CALC'TBL'AMT = AMT2
                ELSE
                IF VTB'FLAG = "P" THEN
                        CALC'TBL'AMT = AMT1 + AMT2
                ELSE
                IF VTB'FLAG = "G" THEN
!!Malvern - do not remove line below.  It produces the 3.50 box chg (field 12)
                    IF II # 2 THEN        !!Malvern Suppress VICS COD Amount
                        CALC'TBL'AMT = AMT1 MAX AMT2    !!Box Charge
                    ENDIF
                ELSE
                IF VTB'FLAG = "L" THEN
                        CALC'TBL'AMT = AMT1 MIN AMT2
                ELSE    !!default
                        CALC'TBL'AMT = AMT1 + AMT2
                ENDCASE
                IF CALC'TBL'AMT # 0 THEN
!!Malvern - restore line below
                    \FROUND CALC'TBL'AMT*(FOB'NAM'PERC/10000) CALC'TBL'AMT
                ENDIF
        ENDIF

        CALC'TBL'AMT'OTHER2:   !!UGLY need to process below for CALC'TBL'AMT

        IF II = 1 THEN
!!Malvern   CALL SET'ADDCHG  !!Additional handling OR large package
!!Malvern   CALC'TBL'AMT = CALC'TBL'AMT + AMT1
            CALL SET'HAZCHG
!!Malvern   CALC'TBL'AMT = CALC'TBL'AMT + AMT1    !!Malvern - don't add penny
        ENDIF
        IF HDR'SHP'TOTAL < 0 THEN CALC'TBL'AMT = -CALC'TBL'AMT
RETURN

MAP1 TOP'WGTS
    MAP2 W500'GND'WB,B,2
    MAP2 W500'NXT'WB,B,2
    MAP2 W500'2ND'WB,B,2
    MAP2 W500'3RD'WB,B,2
    MAP2 WCWT'GND'WB,B,2
    MAP2 WCWT'NXT'WB,B,2
    MAP2 WCWT'2ND'WB,B,2
    MAP2 WCWT'3RD'WB,B,2

SET'WGTS:
    TIME'CSV = "SET'WGTS:" : \TIME'CSV
    CASE
!![40]IF VIA'MAN'YN = "H" THEN
    IF VIA'MAN'YN = "F" THEN                            ![40]
        WGT'TST = W500'GND'WB * 100
    ELSE
    IF VIA'MAN'YN = "X" THEN
        WGT'TST = W500'NXT'WB * 100
    ELSE
    IF VIA'MAN'YN = "Y" THEN
        WGT'TST = W500'2ND'WB * 100
    ELSE
    IF VIA'MAN'YN = "Z" THEN
        WGT'TST = W500'3RD'WB * 100
    ELSE
![40]IF VIA'MAN'YN = "C" OR VIA'MAN'YN = "G" OR VIA'MAN'YN = "F" THEN
    IF VIA'MAN'YN = "C" OR VIA'MAN'YN = "G" OR VIA'MAN'YN = "H" THEN    ![40]
        WGT'TST = WCWT'GND'WB * 100
    ELSE
    IF VIA'MAN'YN = "A" OR VIA'MAN'YN = "1" THEN
        WGT'TST = WCWT'NXT'WB * 100
    ELSE
    IF VIA'MAN'YN = "S" OR VIA'MAN'YN = "2" THEN
        WGT'TST = WCWT'2ND'WB * 100
    ELSE
    IF VIA'MAN'YN = "R" OR VIA'MAN'YN = "3" THEN
        WGT'TST = WCWT'3RD'WB * 100
    ENDCASE
RETURN

CALC'CWT:
        TIME'CSV = "CALC'CWT:" : \TIME'CSV
        CALL SET'WGTS
        IF HDR'WEIGHT < WGT'TST OR DO'CALL'TAG = "Y" OR ZONE'OK = "N" THEN
                IF IN'ALTVIA = 0 THEN
                        ENTRY = "Invalid UPS 100/500 weight - cannot do this!!"
                        CALL DO'ERR'OEPACK
                        GOTO PRESSED'FUNC'B             !!KLUDGE
                ELSE
                        SAV'VIA'NO(ALTVIA'II) = 0
                        RETURN                          !!KLUDGE
                ENDIF
        ENDIF
        IF VIA'MAN'YN = "H" OR VIA'MAN'YN = "3" OR VIA'MAN'YN = "Z" THEN
!!below is minimum weight to use in calcs (15lbs per box minimum charge)
                AMT1 = AMT1 MAX (CNT*OC2'CWT'GMIN*100)
        ELSE
!!below is minimum weight to use in calcs (10lbs per box minimum charge)
                AMT1 = AMT1 MAX (CNT*OC2'CWT'AMIN*100)
        ENDIF
        IF VIA'MAN'YN = "F" OR (VIA'MAN'YN >= "X" AND VIA'MAN'YN <= "Z") THEN
                AMT1 = AMT1 MAX 50000
        ENDIF
!!below is calculated amount per box
        IF CNT # 0 THEN
                \FROUND ((VTB'PERC*AMT1)/10000)/CNT AMT2
!!below is minimum amount allowed by UPS - we will max the #'s
!!Malvern       \FROUND VTB'RATE/CNT CALC'TBL'AMT
                AMT2 = AMT2 MAX CALC'TBL'AMT
        ELSE
                AMT2 = 0
        ENDIF
!!if last box correct for rounding errors
!!below is calculated amount per order
        \FROUND ((VTB'PERC*AMT1)/10000) AMT1
!!below is minimum charge UPS allows maxed to our number
        AMT1 = AMT1 MAX VTB'RATE
RETURN

MAP1 CALC'HTOTAL,B,5

SUM'HTOTAL:
        TIME'CSV = "SUM'HTOTAL:" : \TIME'CSV
        CALC'HTOTAL = HDR'CD(1) + HDR'VIA'SUM(1) + HDR'VIA'SUM(2)
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "CALC1="+CALC'HTOTAL+" 1="+HDR'CD(1)+" 2="+HDR'VIA'SUM(2)
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        FOR JJ = 2 TO 6
            CALC'HTOTAL = CALC'HTOTAL + HDR'CD(JJ)
        NEXT JJ
        CALC'HTOTAL = HDR'SHP'TOTAL - HDR'SHP'DISC              &
                + HDR'STX1FINAL + HDR'STX2FINAL + CALC'HTOTAL
!!              - HDR'OLD'CASH - HDR'OLD'CR + HDR'OLD'DR
        IF WBWHAP = 1 THEN
            CALL COMPUTE'TAX
        ENDIF
RETURN

MAP1 CALC'BTOTAL,B,5

SUM'BTOTAL:             !!this must twin above to insure exact
                        !!        apples to apples comparisons.
        TIME'CSV = "SUM'BTOTAL:" : \TIME'CSV
        CALC'BTOTAL = BCD(1) + BSHP'VTTL(1) + BSHP'VTTL(7)
        FOR JJ = 2 TO 6
                CALC'BTOTAL = CALC'BTOTAL + BCD(JJ) + BSHP'VTTL(JJ)
        NEXT JJ
        CALL SUM'BTOTAL'FINAL
RETURN

DUMP'BTOTAL:
    TIME'CSV = "DUMP'BTOTAL:" : \TIME'CSV
RETURN            !!Better save key and re-use BREC if you enable this
CIF USED AND NOT USED THEN
        OPEN #222,"OEPACK.BUG", APPEND
        ? #222,"Opened file!";
        IF ENTRY[1;6] = "DEBUG:" THEN
            ? #222,ENTRY[7,-1]
        ELSE
            ? #222
        ENDIF
        BKEY = ""
        DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                ? #222,"BOX ";BNO;" BKEY=";BKEY;" WEIGHT=";BCWEIGHT
                PRINT #222,"BCD(1)="+BCD(1)
                PRINT #222,"BCD(2)="+BCD(2)
                PRINT #222,"BCD(3)="+BCD(3)
                PRINT #222,"BCD(4)="+BCD(4)
                PRINT #222,"BCD(5)="+BCD(5)
                PRINT #222,"BCD(6)="+BCD(6)
                PRINT #222,"BSHP'VTTL(1)="+BSHP'VTTL(1)
                PRINT #222,"BSHP'VTTL(2)="+BSHP'VTTL(2)
                PRINT #222,"BSHP'VTTL(3)="+BSHP'VTTL(3)
                PRINT #222,"BSHP'VTTL(4)="+BSHP'VTTL(4)
                PRINT #222,"BSHP'VTTL(5)="+BSHP'VTTL(5)
                PRINT #222,"BSHP'VTTL(6)="+BSHP'VTTL(6)
                PRINT #222,"BSHP'VTTL(7)="+BSHP'VTTL(7)
                PRINT #222,"SHP'TOTAL="+BSHP'TOTAL
                PRINT #222,"SHP'DISC="+BSHP'DISC
                PRINT #222,"STX1="+BSHP'STX1
                PRINT #222,"STX2="+BSHP'STX2
                PRINT #222,"OLD'CASH="+BOLD'CASH
                PRINT #222,"OLD'CR="+BOLD'CR
                PRINT #222,"OLD'DR="+BOLD'DR
                CALL SUM'BTOTAL
                PRINT #222,"BTOTAL="+CALC'BTOTAL
                IF INC'AUTOPACK = "Y" THEN
                        XKEY = (BNO USING "#ZZZ")
                        DO
                                XCALL VICSIT,7,4,XREC,XKEY,XPTR,0,XCTL !!GETNXT
                                IF XCTL # 0 EXIT
                                IF XNO # BNO EXIT
                                ? #222, "          BXL: ";XLIN'NO;"-";XSUB'NO;" QTY=";XQTY;" SHP'TOTAL=";XSHP'TOTAL
                        LOOP
                ENDIF
                PRINT #222,"--------------------------------------------------"
        LOOP
        ? #222,"Closed file!"
        CLOSE #222
!!      ENTRY = "SEE oepack.bug for details!"
!!      \L24CHR CLR="Y"
RETURN
ENDCIF

SUM'BTOTAL'NO'FREIGHT:
        TIME'CSV = "SUM'BTOTAL'NO'FREIGHT:" : \TIME'CSV
        CALC'BTOTAL = BCD(1)
        FOR JJ = 2 TO 6
                CALC'BTOTAL = CALC'BTOTAL + BCD(JJ)
        NEXT JJ
        CALL SUM'BTOTAL'FINAL
RETURN

SUM'BTOTAL'FINAL:
        TIME'CSV = "SET'BTOTAL'FINAL:" : \TIME'CSV
        CALC'BTOTAL = BSHP'TOTAL - BSHP'DISC                    &
                + BSHP'STX1 + BSHP'STX2 + CALC'BTOTAL           &
                - BOLD'CASH - BOLD'CR + BOLD'DR
RETURN

COPYF "XTRFIL"

MAP1 XTR'XTR
        MAP2 XTR'XTR'SPACE,S
                MAP3 XTR'XTR'PTR(4),B,1
                MAP3 XTR'XTR'CNT,B,1

GET'XTR:
        TIME'CSV = "GET'XTR:" : \TIME'CSV
        XTR'SPACE = SPACE
        XTR'XTR'SPACE = SPACE
        II = 0
        FOR JJ = 1 TO 7
                IF ZONE'BOX'ORDER(JJ) = "O" THEN
                        II = II + 1
                        IF II > 4 THEN
                                ENTRY = "More than 4 ship via by order charges! "+HDR'VIA'NO
                                CALL DO'ERR'OEPACK
                                GOTO DEAD'ABORT
                        ENDIF
                        CASE
                        IF JJ = 1 THEN
                                XTR'DESC(II) = "Freight"
                        ELSE
                        IF JJ = 2 THEN
                                XTR'DESC(II) = "COD charge"
                        ELSE
                        IF JJ = 3 THEN
                                XTR'DESC(II) = "Insurance"
                        ELSE
                                XTR'DESC(II) = VIA'MTDESC(JJ-3)
                        ENDCASE
                        XTR'AMT(II) = PSEUDO'VTTL(JJ)
                        XTR'XTR'PTR(II) = JJ
                        XTR'XTR'CNT = XTR'XTR'CNT + 1
                ENDIF
        NEXT JJ
RETURN

PRE'PACK01:
        TIME'CSV = "PRE'PACK01:" : \TIME'CSV
        CALL GET'XTR
        FOR JJ = 1 TO 6
                IF OC2'SIGN(JJ) = "-" THEN
                        HDR'CD(JJ) = -HDR'CD(JJ)
                ENDIF
        NEXT JJ
RETURN

POST'PACK01:
        TIME'CSV = "POST'PACK01:" : \TIME'CSV
        IF XTR'XTR'CNT > 0 THEN
                FOR JJ = 1 TO XTR'XTR'CNT
                        PSEUDO'VTTL(XTR'XTR'PTR(JJ)) = XTR'AMT(JJ)
                NEXT JJ
        ENDIF
        FOR JJ = 1 TO 6
                IF OC2'SIGN(JJ) = "-" THEN
                        HDR'CD(JJ) = -HDR'CD(JJ)
                ENDIF
        NEXT JJ
        CALL SET'BY'ORDER'FREIGHT
RETURN

MAP1 CALC'FREE'FRT,S,1
MAP1 CALC'ZONE'PERC,B,1

CIF NOTES AND NOT NOTES THEN
        1) If OEC'FREE'FRT = "N" then nobody ever gets free freight ever.
        2) If manually entered - just use manual entry.
        3) Now calculate(order does not matter, we set to the best of the lot)
                by various means and set to the best of the lot.  Order
                is for efficiency only to try and get a 'Y' ASAP.
        4) If no free freight, then set closest location flag.
        5) FYI: If OEC'FREE'FRT # "C" then the customer record is ignored
                If OEC'FREE'FRT = "C" then the control record is ignored
                BUT - FZP is ALWAYS examined ...
ENDCIF

SET'FREE'FRT:
    TIME'CSV = "SET'FREE'FRT:" : \TIME'CSV

    IF OEC'FREE'FRT = "N" THEN                              !!See 1) above
        HDR'FREE'FRT = "N"
        HDR'ZONE'PERC = 0
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "Control Record not set for free freight!"
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        RETURN                                          !!KLUDGE
    ENDIF

    IF HDR'ACTION # "P" OR INC'AUTOPACK = "Y" OR WBWHAP = 1 THEN
        IF WBWHAP = 0 THEN
            \TSTBIT HDR'BIT'FLAG 32 VAR="SF"
        ELSE
            SF = 0            !!Calculate for sure
        ENDIF
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "TEST SET'F'F BIT FFP="+SF+" BIT'F="+HDR'BIT'FLAG+" HDR'FFP="+HDR'FFP'NO
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        IF SF # 0 AND HDR'FFP'NO # 0 THEN !!This was manually set
            FFP'KNO = HDR'FFP'NO
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "1) Calling find ffp FFP="+FFP'KNO
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            CALL FIND'FFP            !!Is it valid?
            IF FFP'CTL # 0 THEN
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "WOW - HDR'FFP'NO CTL="+FFP'CTL+" FOR HDR'FFP="+HDR'FFP'NO
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
                CALL CLR'FREE'FRT'FLAGS        !!Sets 32
            ENDIF
        ELSE
            FFP'CTL = 1
        ENDIF
        IF FFP'CTL = 0 THEN
                            !!Valid manual, use it!
            CALL CALC'FREE'FRT'FROM'FFP
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Free Frt set by manual entry "+FFP'NO+" to "+CALC'FREE'FRT+" cutoff="+FREE'CUT+" order="+HDR'FFP'TOTAL*100
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
        ELSE
            CALL CALC'FREE'FRT'FROM'OEC     !!See 3) above
            IF (HDR'FREE'FRT = "" OR DO'FREE'FRT = 1) THEN         !!See 2) above

                ENTRY = "BEFORE HDR="+HDR'FREE'FRT+" CALC="+CALC'FREE'FRT+" DO="+DO'FREE'FRT
                CALL LOGIT

                HDR'FREE'FRT = CALC'FREE'FRT
                HDR'ZONE'PERC = CALC'ZONE'PERC
            ENDIF
            IF HDR'FREE'FRT # "A" THEN
                IF CUS'ZONE # "" THEN
                    IF CUS'FREE'FRT = "N" THEN
                        CUS'FREE'FRT = "Z"
                        CUS'ZONE'PERC = VAL(CUS'ZONE)
                    ELSE
                        IF CUS'FREE'FRT = "C" THEN
                            CUS'FREE'FRT = "X"
                            CUS'ZONE'PERC = VAL(CUS'ZONE)
                        ENDIF
                    ENDIF                   !![45]
                ENDIF
                CALL CALC'FREE'FRT'FROM'CUS
                CALL SET'HDR'FREE'FRT'FROM'CALC'FREE'FRT
                IF HDR'FREE'FRT # "A" THEN
                    CALL CALC'FREE'FRT'FROM'FZP
                    CALL SET'HDR'FREE'FRT'FROM'CALC'FREE'FRT
                ENDIF
            ENDIF
            IF HDR'FREE'FRT = "N" AND DO'FREE'FRT = 1 THEN
                CALL SET'CLOSEST'LOC'FLAG       !!See 4) above
                IF CLOSEST'LOC'FLAG = 1 THEN
                    HDR'FREE'FRT = "C"
                ENDIF
            ENDIF
        ENDIF
    ENDIF
!![46] - add below
    IF HDR'FREE'FRT # BZONE'FREE'FRT OR HDR'BVIA'NO # BZONE'REC'SET OR &
                            HDR'ZONE'PERC # BZONE'ZONE'PERC THEN !!Could affect zone, etc.
        VIA'KNO = HDR'BVIA'NO
        CALL FIND'VIA
        BVIA'REC = VIA'REC
        CALL SET'BOX'ORDER'B    !!Makes BZONE'REC
    ENDIF

    TIME'CSV = "SET'FREE'FRT: END" : \TIME'CSV
RETURN

MAP1 FFLPTR,X,30
MAP1 USING'FFL,B,1

FIND'FFP:                           !![42] add in FFL stuff.
        TIME'CSV = "FIND'FFP:" : \TIME'CSV
        USING'FFL = 0
        \VUSE FFP
        IF FFP'CTL # 0 THEN
            ENTRY = "Free freight profile not found! "+FFP'KNO
            GOTO DO'ERR
        ENDIF
        IF FFP'APPLY'FFP # 0 THEN
              \CNV'DTT DTT="FFP'START'DTT"
              IF TODAY >= YDAYS THEN
                  \CNV'DTT DTT="FFP'END'DTT"
                  IF TODAY <= YDAYS THEN
                      FFP'KNO = FFP'APPLY'FFP
                      \VUSE FFP
                  ENDIF
              ENDIF
        ENDIF
        IF FFP'FFL'COUNT # 0 THEN
                FFL'KNO = FFP'KNO
                FFL'KLOC'NO = HDR'LOC'NO
                \VUSE FFL
                IF FFL'CTL # 0 THEN
                    CALL FNDLOC
                    ZZ = 0
                    FOR XX = 1 TO 4
                        IF HDR'LOC'NO = ALOC'NO(XX) THEN
                            ZZ = XX
                            XX = 4
                        ENDIF
                    NEXT XX
                    IF ZZ = 0 THEN ZZ = 5
                    XX = ZZ
                    DO
                            XX = XX - 1
                            IF XX <= 1 EXIT
                            IF ALOC'NO(XX) = ALOC'NO(XX-1) THEN ZZ = ZZ - 1
                    LOOP
                    FFL'KLOC'NO = 10000 - ZZ
!!Looking for the zzth closest location (ties by zone are equalized)
!!9999=closest location, 9998= 2nd closest location, 9997= third, 9996= 4th
!!9995=any further away.
                    \VUSE FFL
                    IF FFL'CTL = 0 THEN
                        USING'FFL = 1
!!                      FFP'REC = FFL'REC   !!Set phoney FFL in place of FFP
                        FFP'FFL'REC = FFL'FFL'REC
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "FFL SET FROM LOC "+FFL'KLOC'NO+" LOCS="+ &
                                ALOC'NO(1)+" "+ALOC'NO(2)+" "+ALOC'NO(3)+" "+ALOC'NO(4) + &
                                " FFL1="+FFL'FREE'FRT(1)
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
                    ELSE
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "COULD NO FIND "+FFL'KLOC'NO+" LOCS="+ &
                                ALOC'NO(1)+" "+ALOC'NO(2)+" "+ALOC'NO(3)+" "+ALOC'NO(4)
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
                    ENDIF
                ELSE
                    USING'FFL = 1
!!                  FFP'REC = FFL'REC   !!Set phoney FFL in place of FFP
                    FFP'FFL'REC = FFL'FFL'REC
                    IF DO'EXCUSE = 1 THEN
                        SAV'ENTRY = ENTRY
                        ENTRY = "SET LOCATION PROFILE FROM LOC "+FFL'KLOC'NO
                        CALL DO'EXCUSE'LOG
                        ENTRY = SAV'ENTRY
                    ENDIF
                ENDIF
        ELSE
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "No location free freight tables set up!"
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
        ENDIF
RETURN

CALC'FREE'FRT'FROM'FZP:
        TIME'CSV = "CALC'FREE'FRT'FROM'FZP:" : \TIME'CSV
        CALC'FREE'FRT = "N"
        CALC'ZONE'PERC = 0
        IF OC2'FZP'YN # "Y" THEN
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Free Freight not by zip code calc free frt="+CALC'FREE'FRT
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            RETURN                  !!KLUDGE  !!Not used
        ENDIF
        FZP'KSTART'ZIP = HDR'SHP'ZIP
        USE FZP INTO FZP'REC KEY FZP'KEY
        IF FZP'CTL # 0 GETPRV FZP INTO FZP'REC
        IF HDR'SHP'ZIP > FZP'END'ZIP OR FZP'CTL # 0 THEN
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Free Freight by zip code not found for "+HDR'SHP'ZIP
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            RETURN  !!KLUDGE (not found)
        ENDIF
        IF FZP'FFP'NO = 0 THEN
            IF FZP'FREE'FRT # "N" THEN          !!Check only if not 'N'
                IF (HDR'FREE'FRT # "" AND DO'FREE'FRT # 1) THEN
                        !!MANUAL ENTRY, so cutoff does not matter.
                    FREE'CUT = 0
                ELSE
                    IF PSEUDO'CASH'TERMS = "Y" THEN
                        FREE'CUT = FZP'CFREE'CUT
                    ELSE
                        FREE'CUT = FZP'NFREE'CUT
                    ENDIF
                ENDIF
                IF ((((HDR'FFP'TOTAL*100) MAX ABS(HDR'SHP'TOTAL-HDR'SHP'DISC)) &
                        >= FREE'CUT) AND IN2'SUV # "Y") OR &
                       (((HDR'FFP'TOTAL*100) >= FREE'CUT) AND IN2'SUV = "Y") THEN
                    CALC'FREE'FRT = FZP'FREE'FRT
                    IF CALC'FREE'FRT = "P" OR CALC'FREE'FRT = "Z" OR &
                               CALC'FREE'FRT = "O" OR CALC'FREE'FRT = "X" THEN
                        CALC'ZONE'PERC = FZP'ZONE'PERC
                    ELSE
                        CALC'ZONE'PERC = 0
                    ENDIF
                ENDIF
            ENDIF
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Free Freight set by zip code to "+CALC'FREE'FRT+" cutoff="+FREE'CUT+" order="+HDR'FFP'TOTAL
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
        ELSE
            FFP'KNO = FZP'FFP'NO
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "2) Calling find ffp FFP="+FFP'KNO
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            CALL FIND'FFP
            IF FFP'CTL = 0 THEN
                CALL CALC'FREE'FRT'FROM'FFP
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Free Freight set by zip code profile "+FFP'NO+" to "+CALC'FREE'FRT+" cutoff="+FREE'CUT+" order="+HDR'FFP'TOTAL*100
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
            ENDIF
        ENDIF
RETURN

MAP1 DOING'FFP,B,1

CALC'FREE'FRT'FROM'FFP:
    TIME'CSV = "CALC'FREE'FRT'FROM'FFP:" : \TIME'CSV
    IF DO'EXCUSE = 1 THEN
        SAV'ENTRY = ENTRY
!!      \TSTBIT HDR'BIT'FLAG 32 VAR="SF"       !!Do ffp (ZERO=auto)
        ENTRY = "CALC'FF'FRM'FFP auto="+HDR'MAN'FLAG+" DO="+DO'FREE'FRT+" BIT'F="+HDR'BIT'FLAG+" HFF="+HDR'FREE'FRT+" DO="+DO'FREE'FRT+" array="+FFP'OE'PROCESS(HDR'PROC)
        CALL DO'EXCUSE'LOG
        ENTRY = SAV'ENTRY
    ENDIF
    IF (HDR'FREE'FRT # "" AND DO'FREE'FRT # 1) THEN         !!Manual entry
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "hff="+HDR'FREE'FRT+" do="+DO'FREE'FRT
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        CALL SUM'FFP
        RETURN                                              !!KLUDGE
    ENDIF
    IF FFP'OE'PROCESS(HDR'PROC) = "N" THEN
        CALL SUM'FFP
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "SPECIAL N: "+DOING'FFP
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        DOING'FFP = 2                    !!Special NO
        RETURN
    ENDIF
    DOING'FFP = 0

    CALL SUM'FFP
    FOR JJ = 3 TO 1 STEP -1
        IF FFP'FREE'FRT(JJ) = "" THEN
            FFP'FREE'FRT(JJ) = "N"
        ENDIF
        IF FFP'FREE'FRT(JJ) # "N" THEN      !!Check only if not 'N'
            IF (HDR'FREE'FRT # "" AND DO'FREE'FRT # 1) THEN
                    !!MANUAL ENTRY, so cutoff does not matter.
                FREE'CUT = 0
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Setting Free Cut to Zero "+ HDR'FREE'FRT+" DO="+DO'FREE'FRT
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
            ELSE
                IF IN2'SUV = "Y" THEN
                    IF FFP'CFREE'CUT(JJ) > 0 OR FFP'NFREE'CUT(JJ) > 0 OR &
                                FFP'WFREE'CUT(JJ) > 0 THEN
                        CASE
                        IF HDR'CRID = "WBWHAP" THEN
                            FREE'CUT = FFP'WFREE'CUT(JJ)
                        ELSE
                        IF PSEUDO'CASH'TERMS = "Y" THEN
                            FREE'CUT = FFP'CFREE'CUT(JJ)
                        ELSE
                            FREE'CUT = FFP'NFREE'CUT(JJ)
                        ENDCASE
                    ELSE
                        IF FRTITM = 0 THEN
                            FREE'CUT = (HDR'FFP'TOTAL*100) + 1
                        ELSE
                            FREE'CUT = 0
                        ENDIF
                    ENDIF
                ELSE
                    CASE
                    IF HDR'CRID = "WBWHAP" THEN
                        FREE'CUT = FFP'WFREE'CUT(JJ)
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "Setting Free Cut from FFP:"+FFP'WFREE'CUT(JJ)+" JJ="+JJ
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
                    ELSE
                    IF PSEUDO'CASH'TERMS = "Y" THEN
                        FREE'CUT = FFP'CFREE'CUT(JJ)
                    ELSE
                        FREE'CUT = FFP'NFREE'CUT(JJ)
                    ENDCASE
                ENDIF
            ENDIF
!!compare the free freight total against the cutoff when parts on sale
            IF ((((HDR'FFP'TOTAL*100) MAX ABS(HDR'SHP'TOTAL-HDR'SHP'DISC)) &
                    >= FREE'CUT) AND IN2'SUV # "Y") OR &
                   (((HDR'FFP'TOTAL*100) >= FREE'CUT) AND IN2'SUV = "Y") THEN
                IF FFP'MINIMUM # 0 AND HDR'ORG'LOC # HDR'LOC'NO THEN
                    IF ABS(HDR'SHP'TOTAL-HDR'SHP'DISC) >= FFP'MINIMUM THEN
                        CALC'FREE'FRT = FFP'FREE'FRT(JJ)
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "DOING'FFP1: CALC="+CALC'FREE'FRT
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
ELSE
IF DO'EXCUSE = 1 THEN
    SAV'ENTRY = ENTRY
    ENTRY = "DOING'FFP3: CALC="+CALC'FREE'FRT
    CALL DO'EXCUSE'LOG
    ENTRY = SAV'ENTRY
ENDIF
                    ENDIF
                ELSE
                    CALC'FREE'FRT = FFP'FREE'FRT(JJ)
                    IF DO'EXCUSE = 1 THEN
                        SAV'ENTRY = ENTRY
                        ENTRY = "DOING'FFP2: CALC="+CALC'FREE'FRT+" jj="+JJ
                        CALL DO'EXCUSE'LOG
                        ENTRY = SAV'ENTRY
                    ENDIF
                ENDIF

                IF CALC'FREE'FRT = "P" OR CALC'FREE'FRT = "Z" OR &
                               CALC'FREE'FRT = "O" OR CALC'FREE'FRT = "X" THEN
                    CALC'ZONE'PERC = FFP'ZONE'PERC(JJ)
                ELSE
                    CALC'ZONE'PERC = 0
                ENDIF
                DOING'FFP = 1
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "DOING'FFP SET FFP="+HDR'FFP'NO+" FF="+HDR'FREE'FRT+" CALC="+CALC'FREE'FRT
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
                RETURN  !!Got it                !!KLUDGE
            ENDIF
        ENDIF
    NEXT JJ
    IF DO'EXCUSE = 1 THEN
        SAV'ENTRY = ENTRY
        ENTRY = "DOING'FFP NOT SET FFP="+HDR'FFP'NO+" FF="+HDR'FREE'FRT
        CALL DO'EXCUSE'LOG
        ENTRY = SAV'ENTRY
    ENDIF
RETURN

CALC'FREE'FRT'FROM'CUS:
    TIME'CSV = "CALC'FREE'FRT'FROM'CUS:" : \TIME'CSV
    CALC'FREE'FRT = "N"
    CALC'ZONE'PERC = 0
    IF OEC'FREE'FRT # "C" THEN
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "Free Freight not set by customer calc free="+CALC'FREE'FRT
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        RETURN                  !!KLUDGE
    ENDIF
    IF CUS'FFP'NO = 0 THEN
        IF CUS'FREE'FRT = "N" THEN
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Free Freight on customer is 'N'"
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            RETURN          !!KLUDGE
        ENDIF
        IF (HDR'FREE'FRT # "" AND DO'FREE'FRT # 1) THEN
                        !!MANUAL ENTRY, so cutoff does not matter.
            FREE'CUT = 0
        ELSE
            IF CUS'FREE'CUT # 0 THEN
                IF CUS'FREE'CUT = 1 THEN
                    FREE'CUT = 0
                ELSE
                    FREE'CUT = CUS'FREE'CUT * 100
                ENDIF
            ELSE
                IF PSEUDO'CASH'TERMS = "Y" THEN
                    FREE'CUT = OC2'CFREE'CUT
                ELSE
                    FREE'CUT = OC2'NFREE'CUT
                ENDIF
            ENDIF
        ENDIF
        IF ((((HDR'FFP'TOTAL*100) MAX ABS(HDR'SHP'TOTAL-HDR'SHP'DISC)) &
                        >= FREE'CUT) AND IN2'SUV # "Y") OR &
                       (((HDR'FFP'TOTAL*100) >= FREE'CUT) AND IN2'SUV = "Y") THEN
            CALC'FREE'FRT = CUS'FREE'FRT
            IF CALC'FREE'FRT = "P" OR CALC'FREE'FRT = "Z" OR &
                           CALC'FREE'FRT = "O" OR CALC'FREE'FRT = "X" THEN
                CALC'ZONE'PERC = CUS'ZONE'PERC
            ELSE
                CALC'ZONE'PERC = 0
            ENDIF
        ENDIF
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "Free Freight set by customer to "+CALC'FREE'FRT+" cutoff="+FREE'CUT+" order="+HDR'FFP'TOTAL*100+" (ZP="+CALC'ZONE'PERC+")"
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
    ELSE
        IF IN2'SUV = "Y" THEN                !! Additive free freight
            IF HDR'CRID = "WBWHAP" THEN
                IF WBC'FFP'NO # 0 THEN
                    IF CUS'FFP'NO # 0 THEN
                        FFP'KNO = CUS'FFP'NO
                        \VUSE FFP
                        IF FFP'CTL = 0 THEN
                            IF FFP'CUS'OVER = "Y" THEN
                                FFP'KNO = CUS'FFP'NO
                            ELSE
                                FFP'KNO = WBC'FFP'NO
                            ENDIF
                        ELSE
                            FFP'KNO = WBC'FFP'NO
                        ENDIF
                    ELSE
                        FFP'KNO = WBC'FFP'NO
                    ENDIF
                ELSE
                    IF CUS'FFP'NO # 0 THEN
                        FFP'KNO = CUS'FFP'NO
                    ENDIF
                ENDIF
            ELSE
                IF CUS'FFP'NO #0 THEN
                    FFP'KNO = CUS'FFP'NO
                ENDIF
            ENDIF
        ELSE
            FFP'KNO = CUS'FFP'NO
        ENDIF
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "3) Calling find ffp FFP="+FFP'KNO
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        CALL FIND'FFP
        IF FFP'CTL = 0 THEN
            CALL CALC'FREE'FRT'FROM'FFP
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Free Frt set by cus profile "+FFP'NO+" to "+CALC'FREE'FRT+" cutoff="+FREE'CUT+" order="+HDR'FFP'TOTAL*100
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
        ENDIF
    ENDIF
RETURN

CALC'FREE'FRT'FROM'OEC:
        TIME'CSV = "CALC'FREE'FRT'FROM'OEC:" : \TIME'CSV
        CALC'FREE'FRT = "N"
        CALC'ZONE'PERC = 0
        IF OEC'FREE'FRT = "C" THEN
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Free Freight not set from control record calc free="+CALC'FREE'FRT
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            RETURN          !!By customer
        ENDIF
        IF OEC'FFP'NO = 0 THEN
                IF (HDR'FREE'FRT # "" AND DO'FREE'FRT # 1) THEN
                        !!MANUAL ENTRY, so cutoff does not matter.
                    FREE'CUT = 0
                ELSE
                IF PSEUDO'CASH'TERMS = "Y" THEN
                    FREE'CUT = OC2'CFREE'CUT
                ELSE
                    FREE'CUT = OC2'NFREE'CUT
                ENDIF
                ENDIF
                IF ((((HDR'FFP'TOTAL*100) MAX ABS(HDR'SHP'TOTAL-HDR'SHP'DISC)) &
                           >= FREE'CUT) AND IN2'SUV # "Y") OR &
                           (((HDR'FFP'TOTAL*100) >= FREE'CUT) AND IN2'SUV = "Y") THEN
                    CALC'FREE'FRT = OEC'FREE'FRT
                    IF CALC'FREE'FRT = "P" OR CALC'FREE'FRT = "Z" OR &
                           CALC'FREE'FRT = "O" OR CALC'FREE'FRT = "X" THEN
                        CALC'ZONE'PERC = OEC'ZONE'PERC
                    ELSE
                        CALC'ZONE'PERC = 0
                    ENDIF
                ENDIF
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Free Freight set control record to "+CALC'FREE'FRT+" cutoff="+FREE'CUT+" order="+HDR'FFP'TOTAL*100
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
        ELSE
            FFP'KNO = OEC'FFP'NO
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "4) Calling find ffp FFP="+OEC'FFP'NO
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            CALL FIND'FFP
            IF FFP'CTL = 0 THEN
                CALL CALC'FREE'FRT'FROM'FFP
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Free Freight set by control record profile "+FFP'NO+" to "+CALC'FREE'FRT+" cutoff="+FREE'CUT+" order="+HDR'FFP'TOTAL*100
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
            ENDIF
        ENDIF
RETURN

CIF NOTES AND NOT NOTES THEN
        Below checks that the customer gets the BEST of the lot by
        setting in the following order:  free freight = 'Y' is best,
        'O' 2nd, 'P' is 3rd best, 'Y' 4th, and 'Z' is 5th.
        NOTE: the best percentage is picked if percent discount - BUT DOES
                NOT mix with closest location/percentage ... e.g. if
                60% off versus 20% off, then 60% off chosen, BUT
                60% off not closest ('P') and 20% off with closest ('O')
                        then 20% off closest chosen.
        NOTE: ditto for picking lowest zone.
ENDCIF

MAP1 DO'EXCUSE,B,1

MAP1 FFRT'ORDER,S,20,"NCZXPOQWTYA"    !!Order of preference, lowest ot highest
MAP1 HDR'POS,B,1
MAP1 CALC'POS,B,1

SET'HDR'FREE'FRT'FROM'CALC'FREE'FRT:
        TIME'CSV = "SET'HDR'FREE'FRT'FROM'CALC'FREE'FRT:" : \TIME'CSV
        IF (HDR'FREE'FRT # "" AND DO'FREE'FRT # 1) THEN
                        !!MANUAL -- set back
            CALC'FREE'FRT = HDR'FREE'FRT
            CALC'ZONE'PERC = HDR'ZONE'PERC
            IF DO'EXCUSE = 1 AND HDR'FREE'FRT # "N" AND HDR'FREE'FRT # CALC'FREE'FRT THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Calc free frt set from hdr="+CALC'FREE'FRT
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
        ENDIF
        IF HDR'FREE'FRT = "" THEN
            HDR'POS = 0
        ELSE
            HDR'POS = INSTR(1,FFRT'ORDER,HDR'FREE'FRT)
        ENDIF
        CALC'POS = INSTR(1,FFRT'ORDER,CALC'FREE'FRT)
        IF CALC'POS >= HDR'POS THEN
            IF CALC'FREE'FRT = "O" OR CALC'FREE'FRT = "P" THEN
                                !!Get maximum percentage
                IF HDR'FREE'FRT = CALC'FREE'FRT THEN
                    HDR'ZONE'PERC = HDR'ZONE'PERC MAX CALC'ZONE'PERC
                ELSE
                    HDR'ZONE'PERC = CALC'ZONE'PERC
                ENDIF
            ELSE
            IF CALC'FREE'FRT = "X" OR CALC'FREE'FRT = "Z" THEN
                                !!Get minimum zone
                IF HDR'FREE'FRT = CALC'FREE'FRT THEN
                    HDR'ZONE'PERC = HDR'ZONE'PERC MIN CALC'ZONE'PERC
                ELSE
                    HDR'ZONE'PERC = CALC'ZONE'PERC
                ENDIF
            ELSE
                HDR'ZONE'PERC = 0
            ENDIF
            ENDIF
            IF DO'EXCUSE = 1 AND HDR'FREE'FRT # "N" AND HDR'FREE'FRT # CALC'FREE'FRT THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Free Freight Changed from "+HDR'FREE'FRT+" to "+CALC'FREE'FRT
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            HDR'FREE'FRT = CALC'FREE'FRT
        ENDIF
RETURN

MAP1 CLOSEST'LOC'FLAG,B,1

SET'CLOSEST'LOC'FLAG:
        TIME'CSV = "SET'CLOSEST'LOC'FLAG:" : \TIME'CSV
        IF WBWHAP # 0 THEN
            DO'CALL'TAG = "N"
        ENDIF
        CLOSEST'LOC'FLAG = 0
        IF OEC'CLOSE'LOC = "Y" THEN
                IF OEC'MAN'YN = "Y"                                    AND &
                                        VIA'MAN'YN # "N"               AND &
                                        VIA'MAN'YN # "O"               AND &
                                                DO'CALL'TAG # "Y" THEN
                                CLOSEST'LOC'FLAG = 1
                ENDIF
        ENDIF
RETURN

COMPUTE'RESTOCK:
       TIME'CSV = "COMPUTE'RESTOCK:" : \TIME'CSV
       IF OC2'RS'BUCKET # 0 AND HDR'DOC'TYPE >= 1 AND HDR'DOC'TYPE <= 9 AND &
                 (HDR'CRID # "WBWHAP" OR OC2'WB'BUCKET # OC2'RS'BUCKET) AND &
                                                HDR'SHP'TOTAL < 0 THEN

            \FROUND (-HDR'SHP'TOTAL*OC2'RS'DISC)/10000 HDR'CD(OC2'RS'BUCKET)
            HDR'CD(OC2'RS'BUCKET) = HDR'CD(OC2'RS'BUCKET) MAX OC2'RS'MIN
            IF OC2'RS'MAX # 0 THEN
                HDR'CD(OC2'RS'BUCKET) = HDR'CD(OC2'RS'BUCKET) MIN OC2'RS'MAX
            ENDIF
        ENDIF
RETURN

COMPUTE'FREIGHT'BY'ORDER:
   TIME'CSV = "COMPUTE'FREIGHT'BY'ORDER:" : \TIME'CSV

   IF WBWHAP # 1 THEN
       TCOUNT'DESC = "Compute freight by order for "+VIA'DESC
       CALL TCOUNT'START
   ENDIF
   IF OC2'WB'BUCKET # 0 AND HDR'CRID = "WBWHAP" AND HDR'SHP'TOTAL > 0 THEN
        \FROUND (-HDR'SHP'TOTAL*OC2'WB'DISC)/10000 HDR'CD(OC2'WB'BUCKET)
   ENDIF
   \TSTBIT HDR'BIT'FLAG 8 VAR="SF"
   IF SF = 1 CALL COMPUTE'RESTOCK  !!On auto
   FOR II = 1 TO 7
        IF VIA'TBL'NO(II) = 0 THEN
                DFLT'VTTL(II) = 0
        ELSE
        IF ZONE'BOX'ORDER(II) = "O" THEN
                DFLT'VTTL(II) = 0
                IF VIA'TBL'FLAG(II) = 1                          OR &
                   (VIA'TBL'FLAG(II) = 2 AND HDR'SHP'TOTAL # 0  AND &
                    TRH'COD'STATUS # 1)                          OR &
                   (VIA'TBL'FLAG(II) = 3 AND (HDR'SHP'TOTAL  = 0 OR &
                    TRH'COD'STATUS = 1))                        THEN
!!COD charges by order based on SHP total only!!!!!
!!Malvern               CALC'TBL'AMT = PSEUDO'VTTL(II)
!!
!!*** I am activating the line below on 8/1/2025
!!*** It should not break anything because I think we never call it
!!*** we'll have to test to verify - saul
MALVERN99:    !!to see in BPP_ file
                        CALL CALC'TBL'AMT'OTHER
                        MAP1 DFLT'VTTL(7),B,5
                        \TSTBIT HDR'MAN'FLAG 16 VAR="SF"
                        IF SF = 1 THEN                  !!Automatic
                            PSEUDO'VTTL(II) = CALC'TBL'AMT
                        ENDIF
                        IF IN'ALTVIA = 0 THEN
                            DFLT'VTTL(II) = CALC'TBL'AMT
                        ENDIF
                        IF TBL'OVERSIZ1 # 0 OR TBL'OVERSIZ2 # 0 OR &
                                    TBL'OVERSIZ3 # 0 THEN
                                ENTRY = "Warning - oversize on by order charges - ignored!"
                                \KERROR TBL MODE="D" CNO="N" APID="IN"
                                ENTRY = ENTRY + "(" + STR(II) + ")"
                                CALL DO'ERR'OEPACK
                        ENDIF
                        IF TBL'ADD'HAN # 0 THEN
                                ENTRY = "Warning - additional handling on by order charges - ignored!"
                                \KERROR TBL MODE="D" CNO="N" APID="IN"
                                ENTRY = ENTRY + "(" + STR(II) + ")"
                                CALL DO'ERR'OEPACK
                        ENDIF
                ENDIF
        ENDIF
        ENDIF
   NEXT II
!! IF VIA'SHP'FLAG <= 1 AND WORK'MODE = "B" THEN
   CALL SET'BY'ORDER'FREIGHT            !![28] (code was here, made a subroutine)
   TIME'CSV = "COMPUTE'FREIGHT'BY'ORDER: END"
   \TIME'CSV
RETURN

MAP1 WORK'MODE,S,1
MAP1 COMPUTE'BOX'CNT,B,5
MAP1 NEED'OS'WGT,B,1

COMPUTE'FREIGHT'BY'BOX:
        TIME'CSV = "COMPUTE'FREIGHT'BY'BOX:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 THEN
            IF IN'ALTVIA # 0 THEN
                SAV'VIA'NO(ALTVIA'II) = 0
            ENDIF
            TIME'CSV = "COMPUTE'FREIGHT'BY'BOX: EARLY RETURN" : \TIME'CSV
            RETURN                          !!KLUDGE
        ENDIF
        NEED'OS'WGT = 0     !![56] All of this stuff
        IF VIA'DIM'YN = "O" OR VIA'DIM'YN = "B" THEN
          FOR II = 1 TO 7
              IF VIA'TBL'NO(II) # 0 AND ZONE'BOX'ORDER(II) = "B" THEN
                  CALL FIND'TBL
                  IF (TBL'OVERSIZ1 # 0 OR TBL'OVERSIZ2 # 0 OR &
                                                  TBL'OVERSIZ3 # 0) &
                                                  AND TBL'CTL = 0 THEN
                      NEED'OS'WGT = II
                      II = 9
                  ENDIF
              ENDIF
          NEXT II
        ENDIF

        IF IN'ALTVIA = 0 OR NEED'OS'WGT # 0 OR VIA'DIM'YN = "Y" OR &
                                                    VIA'DIM'YN = "B" THEN
                CALL COMPUTE'WGT'CNT
                REAL'OS'WGT = OS'WGT
        ENDIF
        NEED'OS'WGT = 0
        COMPUTE'BOX'CNT = 0
        SAVBREC'SPACE = SPACE
        BREC = SAVBREC
        BKEY = WORK'MODE + (VIA'NO USING "#ZZZ")
        SBKEY = BKEY
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Computing freight by box for "+VIA'DESC
            CALL TCOUNT'START
        ENDIF
        BCWEIGHT = 0
        DO
            IF IN'ALTVIA # 0 THEN
                IF SAV'VIA'NO(ALTVIA'II) = 0 EXIT
            ENDIF
            SAVBREC = BREC
            XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
            IF BCTL # 0 EXIT
            IF BKEY[1;5] # SBKEY EXIT

            IF WBWHAP # 1 THEN
                CALL TCOUNT
            ENDIF
            COMPUTE'BOX'CNT = COMPUTE'BOX'CNT + 1
            BVALUE'YN = "?"         !!Clear just in case ...
            IF SAVBCONSTANT = BCONSTANT AND BNO > 1 THEN
!!If the weight is the same as last box, just copy record ...
                BNO = BNO - 1
                BKEY = SBKEY + (BNO USING "#ZZZ")
                XCALL VICSIT,7,3,BREC,BKEY,BPTR,0,BCTL !!USE
                IF BCTL # 0 THEN
                    ENTRY = "Weird - could not find last box "+BKEY+"!"
                    CALL DO'ERR'OEPACK
                    GOTO DEAD'ABORT
                ENDIF
                BNO = BNO + 1
                BKEY = SBKEY + (BNO USING "#ZZZ")
                XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                IF BCTL = 0 THEN
                    XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                ENDIF
                XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!UPDATE
                REPEAT
            ENDIF
!!HLB: old code moved to silly.txt and replaced by below.
            CALL SUM'BTOTAL'NO'FREIGHT      !!total w/out freight.
            FOR II = 1 TO 7
                IF VIA'TBL'NO(II) = 0 THEN
!!Clear as needed
                    BSHP'VTTL(II) = 0
                ELSE
                    IF ZONE'BOX'ORDER(II) = "B" THEN
                        IF VIA'TBL'FLAG(II) = 1 THEN
!!Add in the "always" charge fees
!!Malvern                   CALC'TBL'AMT = BSHP'VTTL(II)
                            CALL CALC'TBL'AMT
!!all these charges should work if compute'os'stuff called
                            CASE
                            IF (VIA'MTYPE = "U" AND VIA'CHG'TYPE # "TPB") OR &
                                    (VIA'MTYPE = "F" AND OEPACK'FEDEX'LIKE'UPS = "Y") THEN
CIF MALVERN AND NOT MALVERN THEN
                                IF II = 1 CALL CALC'DAS'AMT
!!Oversize 3 extra charge
                                IF II = 1 AND WGT'OS3'YN = "Y" THEN
!!Malvern                           CALC'TBL'AMT = CALC'TBL'AMT + UPC'OS3'SURCHG
                                ENDIF
!!UPS Express Plus
                                IF II = 1 AND VIA'MTYPE = "U" AND VIA'MAN'YN = "I" THEN
!!Malvern                           CALC'TBL'AMT = CALC'TBL'AMT + UPC'EXP'PLUS
                                ENDIF
ENDCIF

                                DTT = DATE
                                BYR = DYR
                                CALL CNV'DTT
                                TODAY = YDAYS

                                IF II = 1 AND VIA'CHG'TYPE # "TPB" THEN
!!use table to chose DMN ...
                                    IF DMN >= 11 AND DMN <= 12 THEN
                                        CALL ADD'HOLIDAY'CHARGES
                                    ENDIF
                                ENDIF
!!Large package extra charge
!!Not sure if the DAS (rural) is retained
!!Not sure if the holiday charge is retained
!!Not sure if surcharge is retained
!!                              IF WGT'LGE'PKG'YN = "Y" THEN
!!                                  IF CALC'TBL'AMT < UPC'LARGE'PKG THEN
!!Malvern                               CALC'TBL'AMT = UPC'LARGE'PKG
!!                                  ENDIF
!!                              ENDIF
                                IF TBL'SURCHARGE # 0 THEN
                                    AMT2 = TBL'SURCHARGE + 10000

                                    SAVE'CALC'TBL'AMT = CALC'TBL'AMT                  !!Malvern
!!Malvern                           \FROUND ((CALC'TBL'AMT*AMT2)/10000) CALC'TBL'AMT
                                ENDIF
CIF MALVERN AND NOT MALVERN THEN
                            ELSE
!!CA Overnight oversize extra charge
                            IF VIA'MTYPE = "C" THEN
                                CASE
                                IF II = 1 AND WGT'OS1'YN = "Y" THEN
!!Malvern                           CALC'TBL'AMT = CALC'TBL'AMT + UPC'CA'OVRSIZE
                                ELSE
                                IF II = 1 AND VIA'SAT'IND = "Y" AND &
                                                VIA'MAN'YN = "H" THEN
!!Malvern                           CALC'TBL'AMT = CALC'TBL'AMT + UPC'SAT'HDEL
                                ELSE
                                IF II = 1 AND VIA'SAT'IND = "Y" AND &
                                            VIA'MAN'YN # "H" THEN
!!Malvern                           CALC'TBL'AMT = CALC'TBL'AMT + UPC'SAT'DEL
                                ENDCASE
                                IF II = 1 AND ZON'DEL'FEE # 0 THEN
                                    IF HDR'SHP'TOTAL < 0 THEN
!!Malvern                               CALC'TBL'AMT = CALC'TBL'AMT - UPC'CA'DAS'FEE
                                    ELSE
!!Malvern                               CALC'TBL'AMT = CALC'TBL'AMT + UPC'CA'DAS'FEE
                                    ENDIF
                                ENDIF
ENDCIF    !!Malvern
                            ELSE
                            IF VIA'MTYPE = "F" AND II = 1 THEN
                                CALL SET'BOX'REC'FROM'BREC
                                CALL GET'FEDEX'CALC'TBL'AMT

                                ENTRY = "Order: "+HDR'LOC'NO+"-"+HDR'DOC'TYPE+"-"+HDR'NO+"-"+BOX'NO+" Freight: "+CALC'TBL'AMT/100
                                XCALL VICSIT,26,ENTRY,"/logs/fedex.DAILY"
                                ENTRY = ""

                                \DG GETVALUE _OESETUP fedex_fees.upcharge_percent FED'CHARGE
                                IF DG'CTL = 0 AND FED'CHARGE > 0 THEN
                                    \FROUND CALC'TBL'AMT*((FED'CHARGE+100)/100) CALC'TBL'AMT
                                    ENTRY = "Order: "+HDR'LOC'NO+"-"+HDR'DOC'TYPE+"-"+HDR'NO+"-"+BOX'NO+" Up Chg: "+FED'CHARGE+ " Freight: "+CALC'TBL'AMT/100
                                    XCALL VICSIT,26,ENTRY,"/logs/fedex.DAILY"
                                    ENTRY = ""
                                ENDIF
!!Sun special for 1 customer
                                IF HDR'FOB'NO > 3 THEN
                                    FOB'KNO = HDR'FOB'NO
                                    USE FOB INTO FOB'REC KEY FOB'KEY
                                    IF FOB'CTL = 0 AND FOB'NAM'PERC # 0 THEN
!!Malvern                               \FROUND CALC'TBL'AMT*(FOB'NAM'PERC/10000) CALC'TBL'AMT
                                        ENTRY = "Order: "+HDR'LOC'NO+"-"+HDR'DOC'TYPE+"-"+HDR'NO+"-"+BOX'NO+" FOB: "+FOB'NAM'PERC+" Freight: "+CALC'TBL'AMT/100
                                        XCALL VICSIT,26,ENTRY,"/logs/fedex.DAILY"
                                        ENTRY = ""
                                    ENDIF
                                ENDIF
                            ENDCASE
                            BSHP'VTTL(II) = CALC'TBL'AMT
!!And add to our box total
                            CALC'BTOTAL = CALC'BTOTAL + BSHP'VTTL(II)
                        ENDIF
                    ELSE
!!Add in the by order charges too
                        CALC'BTOTAL = CALC'BTOTAL + BSHP'VTTL(II)
                    ENDIF
                ENDIF
                IF IN'ALTVIA # 0 THEN
                    IF SAV'VIA'NO(ALTVIA'II) = 0 EXIT
                ENDIF
            NEXT II
                IF WORK'MODE = "A" THEN
                    CALL SUM'BTOTAL'NO'FREIGHT      !!total w/out freight.
!!Now we include BILLED freight (e.g. this is the COD amount).
                    CALC'BTOTAL = CALC'BTOTAL + BVIA'SUM(1) + &
                                        BVIA'SUM(2)
                ENDIF
!!If more than enough cash to cover ship total and freight, zero the
!!total so below "CALC'BTOTAL # 0" tests work.
                IF CALC'BTOTAL < 0 AND BSHP'TOTAL >= 0 THEN
                    CALC'BTOTAL = 0 !!Plus order is zero after cash
                ENDIF
                IF CALC'BTOTAL > 0 AND BSHP'TOTAL <= 0 THEN
                    CALC'BTOTAL = 0 !!Minus is zero after cash
                ENDIF
!!Below we calculate charges EITHER for COD or for non-COD (never both).
                IF TRH'COD'STATUS # 1 AND CALC'BTOTAL # 0 THEN
!!This is a COD box
                    FOR II = 1 TO 7
                        IF VIA'TBL'NO(II) = 0 THEN
                            BSHP'VTTL(II) = 0
                        ELSE
                        IF ZONE'BOX'ORDER(II) = "B"     AND &
                                VIA'TBL'FLAG(II) = 2 THEN
!!Calculate COD charges
!!Malvern                   CALC'TBL'AMT = BSHP'VTTL(II)
                            CALL CALC'TBL'AMT
                            BSHP'VTTL(II) = CALC'TBL'AMT
                        ENDIF
                        ENDIF
                    NEXT II
                ELSE
!!This is a non-COD box
                    FOR II = 1 TO 7
                        IF VIA'TBL'NO(II) = 0 THEN
                            BSHP'VTTL(II) = 0
                        ELSE
                        IF ZONE'BOX'ORDER(II) = "B"     AND &
                                                VIA'TBL'FLAG(II) = 3 THEN
!!Calculate non-COD charges
!!Malvern                   CALC'TBL'AMT = BSHP'VTTL(II)
                            CALL CALC'TBL'AMT
                            BSHP'VTTL(II) = CALC'TBL'AMT
                        ENDIF
                        ENDIF
                    NEXT II
                ENDIF
                XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                IF BCTL = 0 THEN
                        XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                ENDIF
                BTYPE = SBKEY[1;1]
                XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!UPDATE
        LOOP
        IF COMPUTE'BOX'CNT # CNT THEN
                ENTRY = "Weird!? computed freight for "+COMPUTE'BOX'CNT+" should be "+CNT+" "+IN'ALTVIA+" "+SBKEY+" "+BCTL+" "+BKEY
                IF IN'ALTVIA # 0 THEN
                        IF SAV'VIA'NO(ALTVIA'II) # 0 THEN
                                SAV'VIA'NO(ALTVIA'II) = 0
                                CALL DO'ERR'OEPACK
                        ENDIF
                ELSE
                        CALL DO'ERR'OEPACK
                ENDIF
        ENDIF
        TIME'CSV = "COMPUTE'FREIGHT'BY'BOX: END"
        \TIME'CSV
RETURN

!!Be carefull of sizes below ...

MAP1 ALTVIA'II,F

MAP1 ALTVIA'SPACE,S
        MAP2 IN'ALTVIA,B,1
        MAP2 ALTVIA'CNT,B,1
        \SIZEOF HDR OE
        MAP2 SAV'HDR'REC(20),X,|V''TMP|
        MAP2 SAV'VIA'NO'REC
                MAP3 SAV'VIA'NO(20),B,2
        MAP2 SAV'PSEUDO'REC(20),X,35
        MAP2 SAV'ZONE'REC(20),X,85

MAP1 COPY'VIA'NO'REC
        MAP2 COPY'VIA'NO'SPACE,S
                MAP3 COPY'VIA'NO(20),B,2

COPYF "VIAFIL[IN]",=OVIA,NOAFR
MAP1 CHG'VIA,B,1

COMPUTE'ALTVIA'FREIGHT:
    TIME'CSV = "COMPUTE'ALTVIA'FREIGHT:" : \TIME'CSV
    CALL COMPUTE'ALTVIA'FREIGHT2
    IF WORK'MODE = "A" THEN
        VIA'REC = AVIA'REC
    ELSE
        VIA'REC = BVIA'REC
    ENDIF
RETURN

COMPUTE'ALTVIA'FREIGHT2:
        TIME'CSV = "COMPUTE'ALTVIA'FREIGHT2:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 RETURN             !!KLUDGE
        CHG'VIA = 0
        OVIA'REC = VIA'REC                      !!To save
        ALTVIA'SPACE = SPACE
        CALL COMPUTE'WGT'CNT
        CALL TOTAL'HDR'FROM'BREC                !!So we can compare
        CALL ONE'COD'PER'ORDER                  !!Still on billing ...
        IF BVALUE'YN'BOX'NO # 0 THEN
            CALL TOTAL'HDR'FROM'BREC                !!So we can compare
        ENDIF
        IN'ALTVIA = 1
        SAV'ZONE'REC(20) = BZONE'REC            !!Save originals as #20
        SAV'HDR'REC(20) = HDR'REC
        SAV'PSEUDO'REC(20) = PSEUDO'REC
        SAV'VIA'NO(20) = HDR'BVIA'NO
!!Save off original alternates first - if func-c pressed compare all, else
!!                                     just the auto compares.
MAP1 VV,F
        VV = 0
        FOR ALTVIA'II = 1 TO 5
                IF OVIA'AVIA'NO(ALTVIA'II) # 0                  AND &
                  (OVIA'AUTO'CMP(ALTVIA'II) = "Y" OR DO'ALTVIA = 2) THEN
                        VIA'KNO = OVIA'AVIA'NO(ALTVIA'II)
                        CALL FIND'VIA
                        IF VIA'CTL = 0 AND VIA'KNO # SAV'VIA'NO(20) THEN
                            IF WBWHAP # 1 OR VIA'WB'YN = "Y" THEN
                                \ALLOW PRE="VIA" ALLOWED="DD" LOC'NO="HDR'LOC'NO"
                                IF DD = 0 THEN
                                    VV = VV + 1
                                    IF VV >= 20 GOTO NO'MORE'ALTVIA
                                    SAV'VIA'NO(VV) = VIA'NO
                                ENDIF
                            ENDIF
                        ENDIF
!                       IF VIA'CTL = 0 AND VIA'KNO # SAV'VIA'NO(20) THEN
!                           IF WBWHAP # 1 OR VIA'WB'YN = "Y" THEN
!                               XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY
!                               IF VIA'HOB'YN # "N" OR ENTRY = "" THEN
!                                   VV = VV + 1
!                                   IF VV >= 20 GOTO NO'MORE'ALTVIA
!                                   SAV'VIA'NO(VV) = VIA'NO
!                               ENDIF
!                           ENDIF
!                       ENDIF
                ENDIF
        NEXT ALTVIA'II
        IF VV = 0 THEN
            IN'ALTVIA = 0
            RETURN                  !!Nothing to do ...
        ENDIF
!!For each of the alternates, add their alternates to the list
        WW = 0
KEEP'DOING:
        TIME'CSV = "KEEP'DOING:" : \TIME'CSV
        XX = VV
        FOR YY = (WW+1) TO XX
            VIA'KNO = SAV'VIA'NO(YY)
            CALL FIND'VIA
            FOR ALTVIA'II = 1 TO 5
!!only if auto compare or func-c pressed.
                IF VIA'CTL = 0 AND VIA'AVIA'NO(ALTVIA'II) # 0 AND &
                          (VIA'AUTO'CMP(ALTVIA'II) = "Y" OR DO'ALTVIA = 2) THEN
                    VIA'KNO = VIA'AVIA'NO(ALTVIA'II)
                    FOR ZZ = 1 TO VV
                        IF SAV'VIA'NO(ZZ) = VIA'KNO THEN
                            ZZ = 1000
                        ENDIF
                    NEXT ZZ
                    IF ZZ < 500 AND VIA'KNO # SAV'VIA'NO(20) THEN
                        CALL FIND'VIA
                        IF VIA'CTL = 0 THEN
                            VV = VV + 1
                            IF VV >= 20 GOTO NO'MORE'ALTVIA
                            SAV'VIA'NO(VV) = VIA'NO
                        ENDIF
                    ENDIF
                ENDIF
            NEXT ALTVIA'II
        NEXT YY
        WW = XX
        IF VV > XX THEN
            GOTO KEEP'DOING
        ENDIF
NO'MORE'ALTVIA:
        TIME'CSV = "NO'MORE'ALTVIA:" : \TIME'CSV
        IF ALTVIA'CNT < 19 AND DO'ALTVIA = 2 THEN
                CALL EDIT'ALTVIA'LIST
        ENDIF
        CALL CREATE'BRECS'FOR'ALTVIA
        FOR ALTVIA'II = 1 TO 19  !!20 contains original, no need to compute
                IF SAV'VIA'NO(ALTVIA'II) # 0 THEN
                        VIA'KNO = SAV'VIA'NO(ALTVIA'II)
                        CALL FIND'VIA
                        IF VIA'CTL = 0 AND VIA'ACTIVE # "N" THEN
                                BVIA'REC = VIA'REC
                                HDR'BVIA'NO = VIA'NO
                                HDR'VIA'NO = VIA'NO
                                CALL SET'BOX'ORDER'B
                                IF SAV'VIA'NO(ALTVIA'II) # 0 THEN
                                        SAV'ZONE'REC(ALTVIA'II) = BZONE'REC
                                ENDIF
                                IF SAV'VIA'NO(ALTVIA'II) # 0 THEN
                                        CALL COMPUTE'FREIGHT'BY'ORDER
                                ENDIF
                                IF SAV'VIA'NO(ALTVIA'II) # 0 THEN
                                        CALL ALLOCATE'CONSTANTS
                                        CALL COMPUTE'FREIGHT'BY'BOX
                                ENDIF
                                IF SAV'VIA'NO(ALTVIA'II) # 0 THEN
                                        CALL TOTAL'HDR'FROM'BREC
                                        CALL ONE'COD'PER'ORDER
                                        IF BVALUE'YN'BOX'NO # 0 THEN
                                            CALL TOTAL'HDR'FROM'BREC
                                        ENDIF
                                ENDIF
                                IF HDR'VIA'SUM(1) = 0 AND HDR'VIA'SUM(2) = 0 THEN
!!Do not allow ship via to compute zero freight ...
                                        SAV'VIA'NO(ALTVIA'II) = 0
                                ENDIF
                                IF SAV'VIA'NO(ALTVIA'II) # 0 THEN
                                        SAV'PSEUDO'REC(ALTVIA'II) = PSEUDO'REC
                                        SAV'HDR'REC(ALTVIA'II) = HDR'REC
                                        ALTVIA'CNT = ALTVIA'CNT + 1
                                ENDIF
                        ELSE
                                SAV'VIA'NO(ALTVIA'II) = 0
                        ENDIF
                ENDIF
        NEXT ALTVIA'II
        IN'ALTVIA = 0
        IF ALTVIA'CNT > 0 THEN
            MAP1 ALTVIA'TLR,F
            ALTVIA'TLR = 22 - (ALTVIA'CNT+1)
            IF WBWHAP # 1 THEN
                \WINDOW SCREEN="PACK" ACTION="ASK'ALTVIA'FREIGHT" &
                                                        TLR="ALTVIA'TLR"
            ELSE
                CALL ASK'ALTVIA'FREIGHT
            ENDIF
            IF CHG'VIA # 0 AND WBWHAP # 1 THEN
                CALL DSP'BVIA'DESC
                CALL DSP'AVIA'DESC
            ENDIF
        ELSE
            BZONE'REC = SAV'ZONE'REC(20)
            HDR'REC = SAV'HDR'REC(20)
            PSEUDO'REC = SAV'PSEUDO'REC(20)
            HDR'BVIA'NO = SAV'VIA'NO(20)
            VIA'KNO = HDR'BVIA'NO
            CALL FIND'VIA
            BVIA'REC = VIA'REC
        ENDIF
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "SET BILLING MODE VIA="+VIA'KNO+" BVIA="+HDR'BVIA'NO+" NO="+HDR'NO
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        CALL SET'BILLING'MODE           !!Re-fix it all.
RETURN


MAP1 FN'7'QUEUED,B,1
MAP1 FN'B'QUEUED,B,1
MAP1 FN'L'QUEUED,B,1

E'WGT'WGT1:
        TIME'CSV = "E'WGT'WGT1:" : \TIME'CSV
        IF EDSPSW = 0 THEN
                IF INX2 # FN'4 THEN
                        CALL OEPACK'TST'FUNC2
                        IF TST'FUNC = 1 RETURN  !!KLUDGE - do not return on up arrow!
                ENDIF
                IF INX2 = FN'B OR ENTRY = "B" THEN
                        FN'B'QUEUED = 1
                        INX1 = I'FUN
                        INX2 = FN'10
                        TST'FUNC = 1
                        RETURN                  !!KLUDGE
                ENDIF
                IF INX2 = FN'7 THEN
                        INX1 = I'RT
                        INX2 = 0
                        FN'7'QUEUED = 1
                ENDIF
                IF INX2 = FN'4 OR lastchb = 5 THEN      !!control-e
                        WGT'WGT(1) = ALTVIA'CNT + 1
                        IER1 = 0
                ELSE
                IF INX1 = I'HME THEN
                        WGT'WGT(1) = 1
                        IER1 = 0
                ELSE
                IF INX1 = I'LF THEN
                        WGT'WGT(1) = WGT'WGT(1) + 1
                        IF WGT'WGT(1) > (ALTVIA'CNT+1) THEN
                                WGT'WGT(1) = 1
                        ENDIF
                        IER1 = 0
                ELSE
                IF INX1 = I'UA THEN
                        WGT'WGT(1) = WGT'WGT(1) - 1
                        IF WGT'WGT(1) < 1 THEN
                                WGT'WGT(1) = ALTVIA'CNT + 1
                        ENDIF
                        IER1 = 0
                ENDIF
                ENDIF
                ENDIF
                ENDIF
                IF WGT'WGT(1) < 1 OR WGT'WGT(1) > (ALTVIA'CNT+1) THEN
                        ENTRY = "Invalid selection!"
                        CALL DO'ERR'OEPACK
                        WGT'WGT(1) = 1
                ENDIF
                IF IER1 = 0 THEN
                        FOR ALTVIA'II = FIRST'ROW TO 22
                                ?TAB(ALTVIA'II,4) ; TAB(-1,A'CYAN) ;
                        NEXT ALTVIA'II
                ENDIF
        ELSE
                IF EDSPSW = 2 THEN
                        XLN = FIRST'XLN + WGT'WGT(1) - 1
                        CALL VDSP'ALTVIA'HI
                        XLN = 0
                        CALL FORMAT'EMPTY'BUFFER
                ENDIF
                IER2 = 0
        ENDIF
        IF ALTVIA'CNT <= 8 THEN
                EMAX = 1
        ENDIF
RETURN

MAP1 ASK'ALTVIA,S
        MAP2 ASK'VIA'NO(20),B,2
        MAP2 ASK'AMT(20),B,5
        MAP2 ASK'INDEX(20),B,1

ASK'ALTVIA'FREIGHT:
        TIME'CSV = "ASK'ALTVIA'FREIGHT:" : \TIME'CSV
        YY = 0
        FOR ZZ = 1 TO 19
                IF SAV'VIA'NO(ZZ) # 0 THEN
                        YY = YY + 1
                        ASK'VIA'NO(YY) = SAV'VIA'NO(ZZ)
                        ASK'INDEX(YY) = ZZ
                        HDR'REC = SAV'HDR'REC(ZZ)
                        ASK'AMT(YY) = HDR'VIA'SUM(1) + HDR'VIA'SUM(2)
                ENDIF
        NEXT ZZ
        ALTVIA'CNT = YY                 !!Fix it ... in case some zeroed
                                        !!during calcs
!!Filled ASK array from sav array, packed out zeros, left out original
!!which is in element 20
        IF YY > 1 THEN
!!Now sort the alternates by amount
            DO
                SF = 0
                FOR ZZ = 1 TO (YY-1)
                        IF ABS(ASK'AMT(ZZ)) > ABS(ASK'AMT(ZZ+1)) THEN
                                ASK'VIA'NO(20) = ASK'VIA'NO(ZZ)
                                ASK'AMT(20) = ASK'AMT(ZZ)
                                ASK'INDEX(20) = ASK'INDEX(ZZ)
                                ASK'VIA'NO(ZZ) = ASK'VIA'NO(ZZ+1)
                                ASK'AMT(ZZ) = ASK'AMT(ZZ+1)
                                ASK'INDEX(ZZ) = ASK'INDEX(ZZ+1)
                                ASK'VIA'NO(ZZ+1) = ASK'VIA'NO(20)
                                ASK'AMT(ZZ+1) = ASK'AMT(20)
                                ASK'INDEX(ZZ+1) = ASK'INDEX(20)
                                SF = 1
                        ENDIF
                NEXT ZZ
            LOOP WHILE SF = 1
        ENDIF
!!Move up one to make space for original
        FOR ZZ = 20 TO 2 STEP -1
                ASK'VIA'NO(ZZ) = ASK'VIA'NO(ZZ-1)
                ASK'AMT(ZZ) = ASK'AMT(ZZ-1)
                ASK'INDEX(ZZ) = ASK'INDEX(ZZ-1)
        NEXT ZZ
!!Put the original (in element 20) into 1st position
        ASK'VIA'NO(1) = SAV'VIA'NO(20)
        ASK'INDEX(1) = 20
        HDR'REC = SAV'HDR'REC(20)
        ASK'AMT(1) = HDR'VIA'SUM(1) + HDR'VIA'SUM(2)
        WGT'SPACE = SPACE
        IF WBWHAP = 0 THEN
                ?TAB(24,1) ; TAB(-1,9) ;
                DSP PACK06
                PRINT TAB(-1,CR'OFF);
                FIRST'ROW = 22 - (ALTVIA'CNT+1) + 1
                ZZ = 0
                XLN = 21
                CALL VDSP'COLORS1
                FIRST'XLN = FIRST'ROW - 2
                XLN = FIRST'XLN - 1             !!To change color one above 1st row
                CALL VDSP'COLORS1
                ENTRY = "/BOX("+STR(FIRST'ROW-1)+",2,23,79)/"
                XCALL OUT,ENTRY
                ENTRY = "/LINT("+STR(FIRST'ROW-1)+",2)/"
                XCALL OUT,ENTRY
                ENTRY = "/RINT("+STR(FIRST'ROW-1)+",79)/"
                XCALL OUT,ENTRY
                IF ALTVIA'CNT >= 3 THEN
                    ENTRY = "/BINT("+STR(FIRST'ROW-1)+",41)/"
                    XCALL OUT,ENTRY
                ENDIF
                FOR ALTVIA'II = 1 TO (ALTVIA'CNT+1)
                    ZZ = ZZ + 1
                    XLN = XLN + 1
                    CALL VDSP'COLORS3
                    CALL VDSP'COLORS2
                    CALL VDSP'COLORS1
                    VIA'KNO = ASK'VIA'NO(ALTVIA'II)
                    CALL FIND'VIA
                    CALL VDSP'ALTVIA
                NEXT ALTVIA'II
                PRINT TAB(-1,CR'ON);
                IF ABS(ASK'AMT(2)) < ABS(ASK'AMT(1)) THEN
                    XLN = FIRST'XLN + 1
                    WGT'WGT(1) = 2
                ELSE
                    XLN = FIRST'XLN
                    WGT'WGT(1) = 1
                ENDIF
                CALL VDSP'ALTVIA'BEST
                XLN = 0
        ENDIF
        IF SPWASTR[3;1] # "Y" OR WBWHAP # 0 THEN
                IF WBWHAP = 0 THEN
                    ENTRY = "Lowest freight automatically selected - any key to exit."
                    \L24CHR CLR="Y"
                ELSE
                    IF INC'AUTOPACK # "Y" THEN
                        IF ABS(ASK'AMT(2)) < ABS(ASK'AMT(1)) THEN
                            WGT'WGT(1) = 2
                        ELSE
                            WGT'WGT(1) = 1
                        ENDIF
                    ENDIF
                ENDIF
                TST'FUNC = 0
        ELSE
                ECFLD = 0
                arrowc = arrowc OR |EX'EDD|
                CALL FORMAT'EMPTY'BUFFER
                GDB PACK06
                CALL OEPACK'TST'FUNC2
        ENDIF
        IF TST'FUNC = 1 THEN
                WGT'WGT(1) = 1
        ENDIF
        ALTVIA'II = ASK'INDEX(WGT'WGT(1))
        IF ALTVIA'II < 1 OR ALTVIA'II > 20 THEN
                ALTVIA'II = 20                  !!Original freight
        ENDIF
        IF SAV'VIA'NO(ALTVIA'II) = 0 THEN
                ALTVIA'II = 20                  !!Original freight
        ENDIF
        BZONE'REC = SAV'ZONE'REC(ALTVIA'II)
        PSEUDO'REC = SAV'PSEUDO'REC(ALTVIA'II)
        HDR'REC = SAV'HDR'REC(ALTVIA'II)
        VIA'KNO = HDR'VIA'NO
        CALL FIND'VIA
        IF ALTVIA'II # 20 THEN                  !!They changed it ...
                IF VIA'CVIA'NO # 0 THEN
                        HDR'BVIA'NO = VIA'CVIA'NO
                        CHG'VIA = 2
                ELSE
                        HDR'BVIA'NO = HDR'VIA'NO
                        CHG'VIA = 1
                ENDIF
                AVIA'REC = VIA'REC
                VIA'KNO = HDR'BVIA'NO
                CALL FIND'VIA
                BVIA'REC = VIA'REC
                CALL SEE'IF'GAMES
                IF GAMES = 0 AND BZONE'REC'SET = BVIA'NO THEN
                        AZONE'REC = BZONE'REC
                        ZONE'REC = BZONE'REC
                ELSE
                        CALL SET'BOX'ORDER'A    !!Makes AZONE'REC
                ENDIF
        ELSE
                VIA'KNO = HDR'BVIA'NO
                CALL FIND'VIA
                BVIA'REC = VIA'REC
        ENDIF
RETURN

EDIT'ALTVIA'LIST:
    IF WBWHAP # 1 THEN
        \WINDOW ACTION="EDIT'ALTVIA'LIST2" &
                                AUTOSIZE="PACK08" SCREEN="PACK"
    ENDIF
RETURN

EDIT'ALTVIA'LIST2:
        WGT'SPACE = SPACE
        YY = 0
        FOR ZZ = 1 TO 19
                IF SAV'VIA'NO(ZZ) # 0 THEN
                        YY = YY + 1
                        WGT'VIA'NO(YY) = SAV'VIA'NO(ZZ)
                ENDIF
        NEXT ZZ
        DSP PACK08
        ?TAB(24,1) ; TAB(-1,9) ;
        DDB PACK08
        ECFLD = 254
        DO
                GDB PACK08
                IF INX2 # FN'I EXIT
                ECFLD = 0
                DDB PACK08
                ECFLD = JJ
        LOOP
        CALL OEPACK'TST'FUNC2
        IF TST'FUNC = 0 THEN
!!Note that position 20 still contains original ship via.
                FOR ZZ = 1 TO 19
                        SAV'VIA'NO(ZZ) = WGT'VIA'NO(ZZ)
                NEXT ZZ
        ENDIF
RETURN

E'WGT'VIA'NO:
        IF EDSPSW = 0 THEN
                \TABPASS
                IF WGT'VIA'NO(ECFLD) = 0 AND ECFLD < 19 AND TABPASS = 0 AND &
                                                WGT'VIA'NO(ECFLD+1) # 0 THEN
                        INX2 = FN'3     !!Auto control-Z
                ENDIF
                IF lastchb = 2 OR INX2 = FN'4 THEN      !!CTRL-B, insert
                        FOR JJ = 19 TO ECFLD STEP -1
                                WGT'VIA'NO(JJ+1) = WGT'VIA'NO(JJ)
                        NEXT JJ
                        WGT'VIA'NO(ECFLD) = 0
                        JJ = ECFLD-1
                        INX1 = I'FUN
                        INX2 = FN'I
                        ECFLD = 254
                ELSE
                IF lastchb = 26 OR INX2 = FN'3 THEN     !!CTRL-Z, delete
                        FOR JJ = ECFLD TO 19
                                WGT'VIA'NO(JJ) = WGT'VIA'NO(JJ+1)
                        NEXT JJ
                        WGT'WGT(20) = 0
                        JJ = ECFLD-1
                        INX1 = I'FUN
                        INX2 = FN'I
                        ECFLD = 254
                ELSE
                IF INX2 = 0 AND INX1 # I'UA AND INX1 # I'HME THEN
                        IF WGT'VIA'NO(ECFLD) =  0 THEN
                                IF ECFLD = 1 THEN
                                        ENTRY = "You must enter at least one comparison!"
                                        CALL DO'ERR'OEPACK
                                ELSE
                                        INX1 = I'ESC
                                        INX2 = 0
                                        ECFLD = 254
                                ENDIF
                        ENDIF
                ENDIF
                ENDIF
                ENDIF
        ELSE
                IER2 = 0
                IF EDSPSW = 2 AND ECFLD > 1 THEN
                        IF WGT'VIA'NO(ECFLD-1) = 0 THEN
                                ECFLD = ECFLD - 1
                                DO UNTIL ECFLD = 1 OR WGT'VIA'NO(ECFLD) # 0
                                        ECFLD = ECFLD - 1
                                LOOP
                                ECFLD = ECFLD + 1
                                RETURN          !!KLUDGE
                        ENDIF
                ENDIF
        ENDIF
        IF (EDSPSW # 0 OR INX2 # FN'I) AND ECFLD >= 1 AND ECFLD <= 19 THEN
         \TABC FROM="WGT" ON="VIA" DSPFLD="Y" APID="IN" MAND="N" DSPLEN="25" &
                SF'TEST="E'WGT'VIA'NO'SF" VCACHE="VIAPTR" FLDNAM="WGT'VIA'NO(ECFLD)"
         IF EDSPSW = 0 AND WGT'VIA'NO(ECFLD) = 0 THEN
                ECFLD = 254
         ENDIF
        ENDIF
RETURN

E'WGT'VIA'NO'SF:
        CALL E'VIA'NO'SF
        IF SF = 0 AND VIA'NO = SAV'VIA'NO(20) THEN
                SF = 2
                ENTRY = "The original ship via is automatically compared!"
        ENDIF
        IF SF = 0 THEN
                FOR QQ = 1 TO 19
                        IF QQ # ECFLD AND VIA'NO = WGT'VIA'NO(QQ) THEN
                                SF = 2
                                ENTRY = "You are already comparing this one (see #"+STR(QQ)+")!"
                        ENDIF
                NEXT QQ
        ENDIF
RETURN

COPYF "WGTFIL"
MAP1 LAST'BNO,B,2
MAP1 MALVERN'LAST'BOX,B,2

CREATE'ARECS:
        TIME'CSV = "CREATE'ARECS:" : \TIME'CSV
        NEED'CREATE'ARECS = 0
        IF VIA'SHP'FLAG <= 1 RETURN
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Moving billing to actual"
            CALL TCOUNT'START
        ENDIF
        LAST'BNO = 0
        IF WE'HAVE'BRECS = 1 THEN
                BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
                SBKEY = BKEY
                DO
                        XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                        IF BCTL # 0 EXIT
                        IF BKEY[1;5] # SBKEY EXIT
                        IF WBWHAP # 1 THEN
                            CALL TCOUNT
                        ENDIF
                        IF INC'AUTOPACK # "Y" THEN
                                IF WGT'WGT(BNO) = 0 EXIT
                                BCWEIGHT = WGT'WGT(BNO)*100
                                BOVERSIZ1 = WGT'OVERSIZ1(BNO)
                                BOVERSIZ2 = WGT'OVERSIZ2(BNO)
                                BOVERSIZ3 = WGT'OVERSIZ3(BNO)
                                CASE
                                IF BOVERSIZ3 = "Y" THEN
                                    BOVERSIZ2 = ""
                                    BOVERSIZ1 = ""
                                ELSE
                                IF BOVERSIZ2 = "Y" THEN
                                    BOVERSIZ1 = ""
                                    BOVERSIZ3 = ""
                                ENDCASE
                                BADDCHG = WGT'ADDCHG(BNO)
                                BDIMENSION = WGT'DIMENSION(BNO)
                                BHAZ'MAT = WGT'HAZ'MAT(BNO)
                                IF BDIMENSION = "Y" OR BOVERSIZ1 = "Y" OR &
                                       BOVERSIZ2 = "Y" OR BOVERSIZ3 = "Y" THEN
                                    \FROUND (BCWEIGHT/100) BSWGT
                                ELSE
                                    BSWGT = 0
                                ENDIF
                        ENDIF
                        BTYPE = "A"
                        BKEY[1;5] = "A" + (HDR'VIA'NO USING "#ZZZ")
                        XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                        IF BCTL = 0 THEN
                                XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                        ENDIF
                        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                        LAST'BNO = BNO
                        MALVERN'LAST'BOX = BNO
                        BKEY = SBKEY + (BNO USING "#ZZZ")
                LOOP
        ELSE
                LAST'BNO = 0
                BOX'SPACE = SPACE
                BOX'HDR'LOC'NO = HDR'LOC'NO
                BOX'DOC'TYPE = HDR'DOC'TYPE
                BOX'HDR'NO = HDR'NO
                BOX'NO = 1
                BOX'SHIPMENT = HDR'SHIPMENT + 1
                \SETKEY BOX MODE="KEY"
                USE BOX INTO BOX'REC KEY BOX'KEY
                DO
                        GETNXT BOX INTO BOX'REC
                        \CHKKEY BOX
                        IF BOX'CTL # 0 EXIT
                        IF WBWHAP # 1 THEN
                            CALL TCOUNT
                        ENDIF
                        CALL SET'BREC'FROM'BOX'REC      !!Load BREC fields
                        IF BCWEIGHT # 0 THEN
                                BTYPE = "B"
                                BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ") + &
                                                (BOX'NO USING "#ZZZ")
                                XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                                LAST'BNO = BNO
                        ENDIF
                        IF WGT'WGT(BNO) # 0 AND LAST'BNO = (BNO-1) THEN
                                BTYPE = "A"
                                BKEY = "A" + (HDR'VIA'NO USING "#ZZZ") + &
                                                (BOX'NO USING "#ZZZ")
                                BCWEIGHT = WGT'WGT(BNO)*100
                                BOVERSIZ1 = WGT'OVERSIZ1(BNO)
                                BOVERSIZ2 = WGT'OVERSIZ2(BNO)
                                BOVERSIZ3 = WGT'OVERSIZ3(BNO)
                                BADDCHG = WGT'ADDCHG(BNO)
                                BDIMENSION = WGT'DIMENSION(BNO)
                                CASE
                                IF BOVERSIZ3 = "Y" THEN
                                    BOVERSIZ2 = ""
                                    BOVERSIZ1 = ""
                                ELSE
                                IF BOVERSIZ2 = "Y" THEN
                                    BOVERSIZ1 = ""
                                    BOVERSIZ3 = ""
                                ENDCASE
                                IF BDIMENSION = "Y" OR BOVERSIZ1 = "Y" OR &
                                       BOVERSIZ2 = "Y" OR BOVERSIZ3 = "Y" THEN
                                    \FROUND (BCWEIGHT/100) BSWGT
                                ELSE
                                    BSWGT = 0
                                ENDIF
                                BHAZ'MAT = WGT'HAZ'MAT(BNO)
                                XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                                LAST'BNO = BNO
                        ENDIF
                LOOP
                WE'HAVE'BRECS = 1
        ENDIF
        CTC = CTC MAX START'CTC
        IF LAST'BNO = 0 AND ANY'LAST'STUFF = 0 AND INC'AUTOPACK = "Y" AND &
                                            CTC # 2 THEN
                HDR'PICK'NEED = "Y"
                CALL UPDATE'HDR
                ENTRY = "Nothing on order to ship?! - start over"
                \KERROR HDR CNO="N" MODE="D"
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
        ENDIF
        LAST'BNO = LAST'BNO + 1
        IF INC'AUTOPACK # "Y" THEN
                DO WHILE WGT'WGT(LAST'BNO) # 0
                        IF WBWHAP # 1 THEN
                            CALL TCOUNT
                        ENDIF
                        BNO = LAST'BNO
                        BTYPE = "A"
                        BKEY = "A" + (HDR'VIA'NO USING "#ZZZ") + &
                                                        (BNO USING "#ZZZ")
                        BCWEIGHT = WGT'WGT(BNO)*100
                        BFWEIGHT = 0
                        BOVERSIZ1 = WGT'OVERSIZ1(BNO)
                        BOVERSIZ2 = WGT'OVERSIZ2(BNO)
                        BOVERSIZ3 = WGT'OVERSIZ3(BNO)
                        CASE
                        IF BOVERSIZ3 = "Y" THEN
                            BOVERSIZ2 = ""
                            BOVERSIZ1 = ""
                        ELSE
                        IF BOVERSIZ2 = "Y" THEN
                            BOVERSIZ1 = ""
                            BOVERSIZ3 = ""
                        ENDCASE
                        BADDCHG = WGT'ADDCHG(BNO)
                        BDIMENSION = WGT'DIMENSION(BNO)
                        BHAZ'MAT = WGT'HAZ'MAT(BNO)
                        IF BDIMENSION = "Y" OR BOVERSIZ1 = "Y" OR &
                               BOVERSIZ2 = "Y" OR BOVERSIZ3 = "Y" THEN
                            \FROUND (BCWEIGHT/100) BSWGT
                        ELSE
                            BSWGT = 0
                        ENDIF
                        XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                        IF BCTL = 0 THEN
                                XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                        ENDIF
                        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                        LAST'BNO = LAST'BNO + 1
                LOOP
        ENDIF
        BKEY = "A"
        BNO = LAST'BNO
        CALL DELETE'REMAINING'BRECS
        IF INC'AUTOPACK = "Y" OR (HDR'ACTION = "P" AND PSEUDO'CASH'TERMS = "N") THEN
!!The number of actual boxes is the same as number of billing boxes.
                BKEY = "B"
                BNO = LAST'BNO
                CALL DELETE'REMAINING'BRECS
        ENDIF
RETURN

CREATE'BRECS'FOR'THIS'VIA:
        TIME'CSV = "CREATE'BRECS'FOR'THIS'VIA:" : \TIME'CSV
        IF HDR'BVIA'NO # PACK'VIA'NO AND WORK'MODE = "B" THEN
!!Could be we autopacked with via number different than current ...
                IF WBWHAP # 1 THEN
                    TCOUNT'DESC = "Copying billing for new via number"
                    CALL TCOUNT'START
                ENDIF
                FROM'VIA'NO = PACK'VIA'NO
                COPY'VIA'NO'SPACE = SPACE
                COPY'VIA'NO(1) = HDR'BVIA'NO
                CALL CREATE'BRECS'FOR'COPY'VIA'NO'REC
                PACK'VIA'NO = HDR'BVIA'NO
        ENDIF
RETURN

MAP1 FROM'VIA'NO,B,2

CREATE'BRECS'FOR'ALTVIA:
        TIME'CSV = "CREATE'BRECS'FOR'ALTVIA:" : \TIME'CSV
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Copying billing for alternate freight comparison"
            CALL TCOUNT'START
        ENDIF
        FROM'VIA'NO = OVIA'NO
        COPY'VIA'NO'REC = SAV'VIA'NO'REC
        CALL CREATE'BRECS'FOR'COPY'VIA'NO'REC
RETURN

CREATE'BRECS'FOR'COPY'VIA'NO'REC:
        TIME'CSV = "CREATE'BRECS'FOR'COPY'VIA'NO'REC:" : \TIME'CSV
        IF WE'HAVE'BRECS = 1 THEN
                BKEY = "B" + (FROM'VIA'NO USING "#ZZZ")
                SBKEY = BKEY
                DO
                        XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                        IF BCTL # 0 EXIT
                        IF BKEY[1;5] # SBKEY EXIT
                        IF WBWHAP # 1 THEN
                            CALL TCOUNT
                        ENDIF
                        FOR ALTVIA'II = 1 TO 20
                                IF COPY'VIA'NO(ALTVIA'II) # 0 THEN
!!For each ship via make memory based box records.
                                        BKEY[2;4] = &
                                          (COPY'VIA'NO(ALTVIA'II) USING "#ZZZ")
                                        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                                ENDIF
                        NEXT ALTVIA'II
                        BKEY = SBKEY + (BNO USING "#ZZZ")
                        LAST'BNO = BNO
                LOOP
        ENDIF
        FOR ALTVIA'II = 1 TO 20
                IF COPY'VIA'NO(ALTVIA'II) # 0 THEN
                        BKEY = "B"
                        BNO = LAST'BNO + 1
                        DEL'VIA'NO = COPY'VIA'NO(ALTVIA'II)
                        CALL DELETE'REMAINING'BRECS
                ENDIF
        NEXT ALTVIA'II
RETURN

FILL'BOX'FROM'BREC:
        TIME'CSV = "FILL'BOX'FROM'BREC:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 THEN
            RETURN
        ENDIF
        CALL SET'BOX'REC'FROM'BREC
        \SETKEY BOX MODE="KEY"
        IF BTYPE = "B" THEN
!!For billing
                BOX'VIA'SUM(1) = 0 : BOX'VIA'SUM(2) = 0
                FOR JJ = 1 TO 7
                   IF BZONE'BOX'ORDER(JJ) = "O" THEN
                        BOX'VIA'SUM(1) = BOX'VIA'SUM(1) + BOX'SHP'VTTL(JJ)
                   ELSE
                        BOX'VIA'SUM(2) = BOX'VIA'SUM(2) + BOX'SHP'VTTL(JJ)
                   ENDIF
                NEXT JJ
                IF BOX'VIA'SUM(1) # BVIA'SUM(1) OR BOX'VIA'SUM(2) # BVIA'SUM(2) THEN
                        BVIA'SUM(1) = BOX'VIA'SUM(1)
                        BVIA'SUM(2) = BOX'VIA'SUM(2)
                        XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                        IF BCTL = 0 THEN
                                XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                        ENDIF
                        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                ENDIF
                ADD BOX FROM BOX'REC KEY BOX'KEY

                IF BOX'CTL # 0 THEN
                    RDLOCK BOX INTO NOPLACE KEY BOX'KEY
                    WRITE BOX FROM BOX'REC
                ENDIF
        ELSE

                BXV'REC = BOX'REC
                IF BOX'NO > HDR'BOX'COUNT THEN
                    RDLOCK BOX INTO BOX'REC KEY BOX'KEY
                ELSE
                    USE BOX INTO BOX'REC KEY BOX'KEY
                ENDIF
                IF BOX'CTL # 0 THEN
                    BOX'CWEIGHT = 0         !!Not real
                    BOX'WEIGHT = 0          !!Not real
                    BOX'SWGT = 0            !!Not real
                    BOX'VALUE'YN = "N"

                    ADD BOX FROM BOX'REC KEY BOX'KEY
                ELSE
                IF BOX'NO > HDR'BOX'COUNT THEN
                    IF BOX'CWEIGHT # 0 OR BOX'WEIGHT # 0 THEN
                        BOX'CWEIGHT = 0         !!Not real
                        BOX'WEIGHT = 0          !!Not real
                        BOX'SWGT = 0            !!Not real
                        BOX'VALUE'YN = "N"
                        WRITE BOX FROM BOX'REC
                    ELSE
                        REL BOX
                    ENDIF
                ENDIF
                ENDIF
                \SETKEY BXV MODE="KEY"
                IF BXV'REC # BOX'REC[1;LEN(BXV'REC)] THEN
                        ADD BXV FROM BXV'REC KEY BXV'KEY
                        IF BXV'CTL # 0 THEN
                                RDLOCK BXV INTO NOPLACE KEY BXV'KEY
                                WRITE BXV FROM BXV'REC
                        ENDIF
                ELSE
                        RDLOCK BXV INTO BXV'REC KEY BXV'KEY
                        IF BXV'CTL = 0 THEN
                                DELETE BXV KEY BXV'KEY
                        ENDIF
                ENDIF
                CALL SUM'BTOTAL
!
!test not valid, one COD the order will have the total ... in fact almost
!                the opposite is a problem, a COD order with some zero boxes.
!
!               IF BOX'VALUE'YN = "Y" THEN
!                   IF CALC'BTOTAL <= 0 AND TRH'COD'STATUS > 1 THEN
!                       ENTRY = "Box total <= 0 not allowed with COD terms B="+STR(BOX'NO)+" V="+BOX'VALUE'YN+"!"
!                       CALL DO'ERR
!                       GOTO ABORT
!                   ENDIF
!               ENDIF
        ENDIF
RETURN

SET'BOX'REC'FROM'BREC:  !!place !!cache   !!HDR'REC and BREC available!
        TIME'CSV = "SET'BOX'REC'FROM'BREC:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 RETURN
        BOX'SPACE = SPACE
        BOX'CNO = UB'CNO
        BOX'HDR'LOC'NO = HDR'LOC'NO
        BOX'DOC'TYPE = HDR'DOC'TYPE
        BOX'HDR'NO = HDR'NO
        BOX'NO = BNO
        BOX'SHIPMENT = HDR'SHIPMENT + 1
            !!5002
            !!50.02
            !!50.02 - .07 = 49.94 - Where WGT'ATJ = .07
        BOX'CWEIGHT = ((BCWEIGHT/100)-WGT'ADJ)*100
        BOX'FWEIGHT = ((BFWEIGHT/100)-WGT'ADJ)*100

        BOX'WEIGHT = BCWEIGHT
        BOX'LENGTH = BLENGTH
        BOX'WIDTH = BWIDTH
        BOX'HEIGHT = BHEIGHT
        BOX'SWGT = BSWGT
        BOX'SHP'TOTAL = BSHP'TOTAL
        BOX'SHP'DISC = BSHP'DISC
        BOX'SHP'STX1 = BSHP'STX1
        BOX'SHP'STX2 = BSHP'STX2
        BOX'ITEMS = BITEMS
        FOR JJ = 1 TO 7
                BOX'SHP'VTTL(JJ) = BSHP'VTTL(JJ)
        NEXT JJ
        BOX'VIA'SUM(1) = BVIA'SUM(1)
        BOX'VIA'SUM(2) = BVIA'SUM(2)
        FOR JJ = 1 TO 6
                BOX'CD(JJ) = BCD(JJ)
        NEXT JJ
        BOX'OLD'CASH = BOLD'CASH
        BOX'SHP'LOC'NO = HDR'LOC'NO
        BOX'VALUE = BSHP'TOTAL
        BOX'OLD'DR = BOLD'DR
        BOX'OLD'CR = BOLD'CR
        BOX'LOC'NO = HDR'LOC'NO
        BOX'ZONE = ALOC'ZONE(1)
        ENTRY = "S"
        CALL SET'BOX'VALUE'YN
!!      BOX'FREE'FRT = 0
        BOX'RECTANGLE = BRECTANGLE
        CALL SET'BCHARGES'FROM'WGT'CACHE  !!Set bits from !!cache  !!place
        BOX'CHARGES = BCHARGES
RETURN

DELETE'REMAINING'BOXES:
        TIME'CSV = "DELETE'REMAINING'BOXES:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 THEN
            BOX'KNO = 0
        ENDIF
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Deleting extra box records"
            CALL TCOUNT'START
        ENDIF
        USE BOX INTO BOX'REC KEY BOX'KEY
        DO
                GETNXT BOX INTO BOX'REC
                \CHKKEY BOX
                IF BOX'CTL # 0 EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                IF INC'AUTOPACK = "Y" THEN
                    CALL DELETE'BXL'RECORDS
                ENDIF
                BOX2'KEY = BOX'KEY2
                RDLOCK BOX2 BOX'RCN INTO BOX'REC
                DELETE BOX2 KEY BOX2'KEY
                \SETKEY BOX MODE="KY2"
                \DELKEY BOX MODE="KY2"
                BXV'SPACE = SPACE
                BXV'HDR'LOC'NO = BOX'HDR'LOC'NO
                BXV'DOC'TYPE = BOX'DOC'TYPE
                BXV'HDR'NO = BOX'HDR'NO
                BXV'SHIPMENT = BOX'SHIPMENT
                BXV'NO = BOX'NO
                \SETKEY BXV MODE="KEY"
                RDLOCK BXV INTO BXV'REC KEY BXV'KEY
                IF BXV'CTL = 0 THEN
                        \SETKEY BXV MODE="KY2"
                        \DELKEY BXV MODE="KY2"
                        DELETE BXV KEY BXV'KEY
                ENDIF
                CALL DELETE'CAL
        LOOP
RETURN

DELETE'REMAINING'BXVES:
        TIME'CSV = "DELETE'REMAINING'BXVES:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 THEN
                BXV'KNO = 1
        ENDIF
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Deleting extra BXV records"
        ENDIF
        USE BXV INTO BXV'REC KEY BXV'KEY
        DO
                GETNXT BXV INTO BXV'REC
                \CHKKEY BXV
                IF BXV'CTL # 0 EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                BXV2'KEY = BXV'KEY2
                RDLOCK BXV2 BXV'RCN INTO BXV'REC
                DELETE BXV2 KEY BXV2'KEY
                \SETKEY BXV MODE="KY2"
                \DELKEY BXV MODE="KY2"
        LOOP
RETURN

FILL'BXL'FROM'XREC:
        TIME'CSV = "FILL'BXL'FROM'XREC:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 RETURN
        BXL'SPACE = SPACE
        BXL'DOC'TYPE = HDR'DOC'TYPE
        BXL'HDR'LOC'NO = HDR'LOC'NO
        BXL'SHIPMENT = HDR'SHIPMENT + 1
        BXL'HDR'NO = HDR'NO
        BXL'LIN'NO = XLIN'NO
        BXL'SUB'NO = XSUB'NO
        BXL'BOX'NO = XNO
        BXL'QTY = XQTY
        BXL'SHP'TOTAL = XSHP'TOTAL
        \SETKEY BXL MODE="KEY"
        ADDL BXL FROM BXL'REC KEY BXL'KEY
        IF BXL'CTL # 0 THEN
            RDLOCK BXL INTO BXL2'REC KEY BXL'KEY
            IF BXL'CTL = 0 THEN
                \SETKEY BXL MODE="KY2" ALTPRE="BXL2"
                \UPDKEY BXL MODE="KY2"
                WRITE BXL FROM BXL'REC
            ENDIF
        ELSE
            \SETKEY BXL MODE="KY2"
            \ADDKEY BXL MODE="KY2"
            REL BXL
        ENDIF
        CALL SET'LWH                    !!LENGTH, WIDTH, HEIGHT set
RETURN

DELETE'BXL'RECORDS:
        TIME'CSV = "DELETE'BXL'RECORDS:" : \TIME'CSV
        BXL'SPACE = SPACE
        BXL'DOC'TYPE = BOX'DOC'TYPE
        BXL'HDR'LOC'NO = BOX'HDR'LOC'NO
        BXL'SHIPMENT = BOX'SHIPMENT
        BXL'HDR'NO = BOX'HDR'NO
        BXL'BOX'NO = BOX'NO
        \SETKEY BXLB MODE="KEY" ALTKEY="BXLB2"
        USE BXLB2 INTO BXL'REC KEY BXLB2'KEY
        DO
            GETNXT BXLB2 INTO BXL'REC
            \CHKKEY BXLB ALTKEY="BXLB2" LASTFIX="BOX'NO"
            IF BXLB2'CTL # 0 EXIT
            RDLOCK BXL BXLB2'RCN INTO BXL'REC
            \SETKEY BXL MODE="ALL"
            DELETE BXL
            \DELKEY BXL MODE="ALL"
                                                !![39] delete from cache too
                                                !!not needed but good practice.
            XKEY = (BXL'BOX'NO USING "#ZZZ") + &
                                (BXL'LIN'NO USING "#ZZZ") + STR(BXL'SUB'NO)
            XCALL VICSIT,7,8,XREC,XKEY,XPTR,0,XCTL    !!delete
        LOOP
RETURN

MAP1    SUBTOTAL1,B,5
MAP1    SUBTOTAL2,B,5
MAP1    GRANDTOTAL,B,5
MAP1    VIATOTAL,B,5
MAP1    CASHTOTAL,B,5
MAP1    DISC'TOTAL,B,5
MAP1    CHARGE'TOTAL,B,5

COPY "DSPTOT",DSP'CASH="Y"         !!DSP'PACK02'TOTALS:

WINMES2:
        ENTRY = "    Discount Explanation"
        GETMSG HDR'MSGNO2 "OEMSG" 78
RETURN

WINMES3:
        ENTRY = "    Order Header Message"
        CALL WINMAC
RETURN

WINMAC:
        TIME'CSV = "WINMAC:" : \TIME'CSV
        MSG'DID = "OEMSG"
        IF HDR'MSGNO = 0 THEN
            \LOOPMSG FLDNAM="OEC'HDR'MSGNO" COPY'FLDNAM="HDR'MSGNO" SET'DID="N"
        ENDIF
        \MSGMAC MSGFIL="OEMSG" MSGNO="HDR'MSGNO" LENGTH="78"      &
                VTITLE="ENTRY" WHOLE="Y" FLG="|MF'TMPL|" DSP="N"
RETURN

CLEAR'HDR'TOTALS:
        TIME'CSV = "CLEAR'HDR'TOTALS:" : \TIME'CSV
        IF WORK'MODE = "A" THEN
            RETURN                       !!KLUDGE
        ENDIF
        HDR'BOX'COUNT = 0
        HDR'WEIGHT = 0
        HDR'VIA'SUM(2) = 0
        FOR JJ = 1 TO 7
           IF ZONE'BOX'ORDER(JJ) = "B" THEN
                PSEUDO'VTTL(JJ) = 0
           ENDIF
        NEXT JJ
        IF VIA'SHP'FLAG > 1 THEN                !![9]
            HDR'OLD'CASH = 0
            HDR'OLD'CR = 0
            HDR'OLD'DR = 0
        ENDIF
RETURN

SUM'HDR'TOTALS:
        TIME'CSV = "SUM'HDR'TOTALS:" : \TIME'CSV
        IF WORK'MODE = "A" RETURN                       !!KLUDGE
        IF BCWEIGHT # 0 THEN
            HDR'BOX'COUNT = HDR'BOX'COUNT + 1
        ENDIF
        HDR'WEIGHT = HDR'WEIGHT + BCWEIGHT
        BOX'VIA'SUM(1) = 0 : BOX'VIA'SUM(2) = 0
        FOR JJ = 1 TO 7
            IF BZONE'BOX'ORDER(JJ) = "O" THEN
                BOX'VIA'SUM(1) = BOX'VIA'SUM(1) + BSHP'VTTL(JJ)
            ELSE
                BOX'VIA'SUM(2) = BOX'VIA'SUM(2) + BSHP'VTTL(JJ)
            ENDIF
        NEXT JJ
        IF BOX'VIA'SUM(1) # BVIA'SUM(1) OR BOX'VIA'SUM(2) # BVIA'SUM(2) THEN
                BVIA'SUM(1) = BOX'VIA'SUM(1)
                BVIA'SUM(2) = BOX'VIA'SUM(2)
                XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                IF BCTL = 0 THEN
                        XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                ENDIF
                XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
        ENDIF
        FOR JJ = 1 TO 7
           IF ZONE'BOX'ORDER(JJ) = "B" THEN
                HDR'VIA'SUM(2) = HDR'VIA'SUM(2) + BSHP'VTTL(JJ)
                PSEUDO'VTTL(JJ) = PSEUDO'VTTL(JJ) + BSHP'VTTL(JJ)
           ENDIF
        NEXT JJ
        HDR'OLD'CASH = HDR'OLD'CASH + BOLD'CASH
        HDR'OLD'CR = HDR'OLD'CR + BOLD'CR
        HDR'OLD'DR = HDR'OLD'DR + BOLD'DR
RETURN

OEPACK'TST'FUNC:
        CALL TST'FUNC
        IF INX2 = FN'A THEN TST'FUNC = 1
        IF INX2 = FN'10 THEN TST'FUNC = 0
RETURN

OEPACK'TST'FUNC2:
        CALL TST'FUNC
        IF INX2 = FN'A THEN TST'FUNC = 1
RETURN

E'PUL'UID:
        \TABC APRE="PCF" AKEY="UID" FLDNAM="PLC'PUL'UID" DSPFLD="Y"
RETURN

E'CHK'UID:
        \TABC APRE="PCF" AKEY="UID" FLDNAM="PLC'CHK'UID" DSPFLD="Y"
RETURN

!![53]  E'PLC'DTT:
!![53]          \EDTDTE FLDNAM="PLC'DTT"
!![53]  RETURN

DSP'LOC'DESC:
        IF INC'AUTOPACK = "Y" OR HDR'ACTION = "E" OR HDR'ACTION = "L" THEN
                CALL DSP'LOC'DESC0
        ELSE
                CALL DSP'LOC'DESC3
        ENDIF
RETURN

DSP'DOC'DESC:
        IF INC'AUTOPACK = "Y" OR HDR'ACTION = "E" OR HDR'ACTION = "L" THEN
                CALL DSP'DOC'DESC0
        ELSE
                CALL DSP'DOC'DESC3
        ENDIF
RETURN

SET'SHIP'MODE:
        IF INC'AUTOPACK = "Y" THEN
                SHIP'MODE = "Invoicing"
        ELSE
        IF HDR'ACTION = "E" THEN
                SHIP'MODE = "  Picking - "+HDR'PICK'VER
        ELSE
        IF HDR'ACTION = "L" THEN
                SHIP'MODE = "Acknowledg- "+HDR'PICK'VER
        ELSE
                SHIP'MODE = "Invoicing - "+HDR'PICK'VER
        ENDIF
        ENDIF
        ENDIF
RETURN

MAP1 DSP'NO,B,2
MAP1 MAXFLD,B,1,1

E'WGT:
        arrowc = arrowc OR |EX'EDD|
        IF WGT'WGT(ECFLD) # 0 THEN
            MAXFLD = MAXFLD MAX ECFLD+1
        ENDIF
        IF EDSPSW # 0 THEN
                ETYP = ETYP OR E'FAST
                IER2 = 0
                IF EDSPSW = 2 AND ECFLD > 1 THEN
                        IF WGT'WGT(ECFLD-1) = 0 THEN
                                ECFLD = ECFLD - 1
                                DO UNTIL ECFLD = 1 OR WGT'WGT(ECFLD) # 0
                                        ECFLD = ECFLD - 1
                                LOOP
                                ECFLD = ECFLD + 1
                                RETURN          !!KLUDGE
                        ENDIF
                ENDIF
                ?TAB(-1,14);
                IF EDSPSW = 255 THEN
                        IF (WGT'OVERSIZ1(ECFLD) = "Y"           OR &
                                WGT'OVERSIZ2(ECFLD) = "Y"       OR &
                                WGT'OVERSIZ3(ECFLD) = "Y"       OR &
                                WGT'ADDCHG(ECFLD) = "Y"         OR &
                                WGT'DIMENSION(ECFLD) = "Y")     THEN
                                        ?TAB(EROW,ECOL-1) ; "*" ;
                        ELSE
                                ?TAB(EROW,ECOL-1) ; TAB(-1,A'NORM) ;
                        ENDIF
                ENDIF
                IF ECFLD > MAXFLD THEN
                        ECFLD = 254
                ELSE
                        DSP'NO = 0
                        IF EDSPSW = 255 THEN
                                IF WGT'WGT(ECFLD) # 0 THEN DSP'NO = 1
                        ELSE
                                IF ECFLD = 1 THEN
                                        DSP'NO = 1
                                ELSE
                                        IF WGT'WGT(ECFLD-1) # 0 THEN DSP'NO = 1
                                ENDIF
                        ENDIF
                        ?TAB(-1,14) ;           !!Protect mode off
                        IF DSP'NO = 1 THEN
                            IF EDSPSW = 255 THEN
                                PAGENO = PAGENO MAX 1
                                DSP'NO = ((PAGENO-1)*160)+ECFLD
                                ?TAB(EROW,ECOL-6) ; TAB(-1,11) ; TAB(-1,A'CYAN) ; (DSP'NO USING "###.")  ; TAB(-1,12) ;
                             ELSE
                                DSP'NO = ((PAGENO-1)*160)+ECFLD
                                ?TAB(EROW,ECOL-6) ; TAB(-1,11) ; TAB(-1,A'CYAN) ; (DSP'NO USING "###.") ; TAB(-1,12) ;
                             ENDIF
                        ELSE
                            ?TAB(EROW,ECOL-5) ; SPACE(4) ;
                        ENDIF
                ENDIF
        ELSE
                IF PAGENO = 2 THEN
                                !!left arrow OR home on first field
                    IF (lastchb = 8 OR lastchb = 30) AND ECFLD = 1 THEN
                        INX1 = I'FUN
                        INX2 = FN'6
                    ENDIF
                    IF lastchb = 18 THEN            !!ctrl-r
                        INX1 = I'FUN
                        INX2 = FN'6
                    ENDIF
                    IF INX2 = FN'6 THEN
                        ECFLD = 254
                        INX2 = FN'10
                        RETURN            !!KLUDGE
                    ENDIF
                ELSE
                                !!right arrow OR end on last field
                    IF (lastchb = 12 OR lastchb = 5) AND &
                                ECFLD = 160 AND WGT'WGT(160) # 0 THEN
                        INX1 = I'FUN
                        INX2 = FN'1
                    ELSE
                        IF lastchb = 5 THEN
                            ECFLD = 159
                            INX1 = I'RT : INX2 = 0
                            RETURN                !!KLUDGE
                        ENDIF
                    ENDIF
                    IF lastchb = 20 THEN            !!ctrl-t
                        INX1 = I'FUN
                        INX2 = FN'1
                    ENDIF
                    IF INX2 = FN'1 AND WGT'WGT(160) = 0 THEN
                        ENTRY = "Fill in the first page first!"
                        CALL DO'ERR
                    ENDIF
                    IF INX2 = FN'1 THEN
                        ECFLD = 254
                        RETURN                              !!KLUDGE
                    ENDIF
                ENDIF
                IF INX2 # FN'3 AND INX2 # FN'4 AND lastchb # 2 AND &
                                                lastchb # 26 THEN
                        CALL OEPACK'TST'FUNC2
                        IF TST'FUNC = 1 THEN
                            ECFLD = 254
                            RETURN                  !!KLUDGE
                        ENDIF
                ENDIF
                IF INX2 = FN'2 THEN                     !!Oversize
                        WGT'OS1'YN = WGT'OVERSIZ1(ECFLD)
                        WGT'OS2'YN = WGT'OVERSIZ2(ECFLD)
                        WGT'OS3'YN = WGT'OVERSIZ3(ECFLD)
                        CASE
                        IF WGT'OS3'YN = "Y" THEN
                            WGT'OS2'YN = "N"
                            WGT'OS1'YN = "N"
                        ELSE
                        IF WGT'OS2'YN = "Y" THEN
                            WGT'OS1'YN = "N"
                            WGT'OS3'YN = "N"
                        ELSE
                        IF WGT'OS1'YN = "Y" THEN
                            WGT'OS2'YN = "N"
                            WGT'OS3'YN = "N"
                        ENDCASE
                        WGT'AC'YN = WGT'ADDCHG(ECFLD)
                        WGT'D'YN = WGT'DIMENSION(ECFLD)
                        WGT'H'YN = WGT'HAZ'MAT(ECFLD)
!                       \WINDOW OVRLAY="PACK12" PUSH="Y" AUTOSIZE="PACK12"
! CIF USED AND NOT USED THEN
                        \WINDOW OVRLAY="PACK10" PUSH="Y" AUTOSIZE="PACK10"
                        CASE
                        IF WGT'OS3'YN = "Y" THEN
                            WGT'OS2'YN = "N"
                            WGT'OS1'YN = "N"
                            IF INC'AUTOPACK # "Y" THEN
                                BOVERSIZ3 = "Y"
                                BOVERSIZ2 = ""
                                BOVERSIZ1 = ""
                            ENDIF
                        ELSE
                        IF WGT'OS2'YN = "Y" THEN
                            WGT'OS1'YN = "N"
                            WGT'OS3'YN = "N"
                            IF INC'AUTOPACK # "Y" THEN
                                BOVERSIZ2 = "Y"
                                BOVERSIZ1 = ""
                                BOVERSIZ3 = ""
                            ENDIF
                        ELSE
                        IF WGT'OS1'YN = "Y" THEN
                            WGT'OS2'YN = "N"
                            WGT'OS3'YN = "N"
                            IF INC'AUTOPACK # "Y" THEN
                                BOVERSIZ1 = "Y"
                                BOVERSIZ2 = ""
                                BOVERSIZ3 = ""
                            ENDIF
                        ENDCASE
                        IF WGT'OS1'YN = "Y" AND &
                                WGT'WGT(ECFLD) > UPC'MAX'OVS1 AND &
                                       UPC'MAX'OVS1 # 0 THEN
                            ENTRY = "Cannot have oversize of "+WGT'WGT(ECFLD)+" (it weighs more than "+UPC'MAX'OVS1+" lbs)!"
                            CALL DO'ERR
                            WGT'OS1'YN = "N"
                        ENDIF
                        IF WGT'OS2'YN = "Y" AND &
                                WGT'WGT(ECFLD) > UPC'MAX'OVS2 AND &
                                    UPC'MAX'OVS2 # 0 THEN
                            ENTRY = "Cannot have oversize of "+WGT'WGT(ECFLD)+" (it weighs more than "+UPC'MAX'OVS2+" lbs)!"
                            CALL DO'ERR
                            WGT'OS2'YN = "N"
                        ENDIF
                        IF WGT'OS3'YN = "Y" AND &
                                WGT'WGT(ECFLD) > UPC'MAX'OVS3 AND &
                                    UPC'MAX'OVS3 # 0 THEN
                            ENTRY = "Cannot have oversize of "+WGT'WGT(ECFLD)+" (it weighs more than "+UPC'MAX'OVS3+" lbs)!"
                            CALL DO'ERR
                            WGT'OS3'YN = "N"
                        ENDIF

                        WGT'OVERSIZ1(ECFLD) = WGT'OS1'YN
                        WGT'OVERSIZ2(ECFLD) = WGT'OS2'YN
                        WGT'OVERSIZ3(ECFLD) = WGT'OS3'YN
                        WGT'ADDCHG(ECFLD) = WGT'AC'YN
                        WGT'DIMENSION(ECFLD) = WGT'D'YN
                        WGT'HAZ'MAT(ECFLD) = WGT'H'YN
                        IF (WGT'OVERSIZ1(ECFLD) = "Y"           OR &
                                WGT'OVERSIZ2(ECFLD) = "Y"       OR &
                                WGT'OVERSIZ3(ECFLD) = "Y"       OR &
                                WGT'ADDCHG(ECFLD) = "Y"         OR &
                                WGT'HAZ'MAT(ECFLD) = "Y"        OR &
                                WGT'DIMENSION(ECFLD) = "Y")     THEN
                                        ?TAB(EROW,ECOL-1) ; "*" ;
                        ELSE
                                ?TAB(EROW,ECOL-1) ; TAB(-1,A'NORM) ;
                        ENDIF
!ENDCIF
!                       IF WGT'DIMENSION(ECFLD) = "Y" THEN
!                           CALL DETERMINE'DIM'RATE
!                       ENDIF
!                       WGT'HAZ'MAT(ECFLD) = WGT'H'YN
!                       IF (WGT'ADDCHG(ECFLD) = "Y"           OR &
!                           WGT'HAZ'MAT(ECFLD) = "Y"        OR &
!                           WGT'DIMENSION(ECFLD) = "Y")     THEN
!                               ?TAB(EROW,ECOL-1) ; "*" ;
!                       ELSE
!                               ?TAB(EROW,ECOL-1) ; TAB(-1,A'NORM) ;
!                       ENDIF

                        INX1 = I'RT
                        INX2 = 0
                ENDIF
                IF WGT'WGT(ECFLD) = 0 AND ECFLD < 159 AND &
                                                WGT'WGT(ECFLD+1) # 0 THEN
                    INX2 = FN'3     !!Auto control-Z
                ENDIF
                CASE
                IF lastchb = 2 OR INX2 = FN'4 THEN      !!CTRL-B, insert
                        FOR JJ = WGTMAX TO ECFLD STEP -1
                            WGT'WGT(JJ+1) = WGT'WGT(JJ)
                        NEXT JJ
                        WGT'WGT(ECFLD) = 0
                        JJ = ECFLD-1
                        INX1 = I'FUN
                        INX2 = FN'I
                        ECFLD = 254
                        MAXFLD = MAXFLD + 1
                ELSE
                IF lastchb = 26 OR INX2 = FN'3 THEN     !!CTRL-Z, delete
                        FOR JJ = ECFLD TO WGTMAX
                            WGT'WGT(JJ) = WGT'WGT(JJ+1)
                        NEXT JJ
                        WGT'WGT(WGTMAX+1) = 0
                        JJ = ECFLD-1
                        INX1 = I'FUN
                        INX2 = FN'I
                        ECFLD = 254
                ELSE
                IF INX1 = I'TAB THEN
                        IF ECFLD = 1 THEN
                            IF PAGENO = 2 AND WGT'WGT(ECFLD) = 0 THEN
                                WGT'WGT(ECFLD) = WGT2'WGT(160)
                                MAXFLD = MAXFLD + 1
                                ?TAB(EROW,ECOL) ; STR(WGT'WGT(ECFLD)) ;
                            ELSE
                                ? CHR(7);
                                IER1 = 0
                            ENDIF
                        ELSE
                            IF WGT'WGT(ECFLD) = 0 THEN
                                WGT'WGT(ECFLD) = WGT'WGT(ECFLD-1)
                                MAXFLD = MAXFLD + 1
                            ENDIF
                            ?TAB(EROW,ECOL) ; STR(WGT'WGT(ECFLD)) ;
                        ENDIF
                        ?TAB(EROW,ECOL+EMAX) ; TAB(-1,A'CYAN);
                        INX1 = I'RT
                        INX2 = 0
                ELSE
                IF INX1 = I'LF THEN
                        CALL E'WGT'VALID
                        IF lastchb = 10 AND ECFLD < 153 AND IER1 # 0 THEN
!!down arrow (not right arrow), go down one row
                            ECFLD = ECFLD + 7
                            IF WGT'WGT(ECFLD) = 0 THEN
!!unless invalid, let gin deal with it
                                ECFLD = ECFLD - 7
                            ENDIF
                        ENDIF
                ELSE
                IF INX1 = I'UA THEN
                    IF lastchb = 11 AND ECFLD > 8 THEN
!!up arrow (not left arrow), go up one row
                        ECFLD = ECFLD - 7
                    ENDIF
                ELSE
                IF INX2 = 0 AND INX1 # I'HME THEN
                    CALL E'WGT'VALID
                ENDCASE
        ENDIF
RETURN

E'WGT'VALID:
        IF WGT'WGT(ECFLD) = 0 THEN
                IF ECFLD = 1 THEN
                        ENTRY = "You must enter at least one box!"
                        CALL DO'ERR'OEPACK
                ELSE
                        lastchb = 27
                        INX1 = I'ESC
                        INX2 = 0
                        ECFLD = 254
                ENDIF
        ELSE
                IF (WGT'WGT(ECFLD)*100) > INC2'MAX'UPS THEN
                        ENTRY = "Weight larger than maximum of " + &
                                (INT(INC2'MAX'UPS/100) USING "#,###")
                        CALL DO'ERR'OEPACK
                ELSE
                IF (CUS'MAX'WEIGHT > 0 AND &
                            WGT'WGT(ECFLD) > CUS'MAX'WEIGHT AND &
                                            OEPACK'HARSH = "Y") THEN
                        ENTRY = "Weight larger than customer maximum of " + &
                                (INT(CUS'MAX'WEIGHT/100) USING "#,###")
                        CALL DO'ERR'OEPACK
                        IER1 = 1
                ENDIF
                ENDIF
        ENDIF
RETURN

DO'PACK04:
        TIME'CSV = "DO'PACK04:" : \TIME'CSV
        DSP PACK04
RETURN

SET'BREC'FROM'BOX'REC:
        TIME'CSV = "SET'BREC'FROM'BOX'REC:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 RETURN
        BREC'SPACE = SPACE
        BNO = BOX'NO
        BCWEIGHT = BOX'CWEIGHT
        BFWEIGHT = BOX'FWEIGHT
        BLENGTH = BOX'LENGTH
        BWIDTH = BOX'WIDTH
        BHEIGHT = BOX'HEIGHT
        BSWGT = BOX'SWGT
        BRECTANGLE = BOX'RECTANGLE
        BSHP'TOTAL = BOX'SHP'TOTAL
        BSHP'DISC = BOX'SHP'DISC
        BSHP'STX1 = BOX'SHP'STX1
        BSHP'STX2 = BOX'SHP'STX2
        BITEMS = BOX'ITEMS
        FOR WW = 1 TO 6
                BCD(WW) = BOX'CD(WW)
                BSHP'VTTL(WW) = BOX'SHP'VTTL(WW)
        NEXT WW
        BSHP'VTTL(7) = BOX'SHP'VTTL(7)
        BVIA'SUM(1) = BOX'VIA'SUM(1)
        BVIA'SUM(2) = BOX'VIA'SUM(2)
        BOLD'CASH = BOX'OLD'CASH
        BOLD'DR = BOX'OLD'DR
        BOLD'CR = BOX'OLD'CR
        BVALUE'YN = BOX'VALUE'YN

        \SETWGTFROMBOX CACHE'FIELDS="Y" CLRWGT="Y"   !!place !!real
        BOX'CHARGES = BCHARGES
        IF BOVERSIZ1 # "Y" AND BOVERSIZ2 # "Y" AND &
                BOVERSIZ3 # "Y" AND BDIMENSION # "Y" AND &
                BLRGPKG # "Y" THEN
            BSWGT = 0
        ENDIF
RETURN

PRETEND'GKD'PACK03:
        TIME'CSV = "PRETEND'GKD'PACK03:" : \TIME'CSV
        WRH'LOC'NO = HDR'LOC'NO
        WRH'DOC'TYPE = HDR'DOC'TYPE
        WRH'HDR'NO = HDR'NO
        LOC'KNO = HDR'LOC'NO
        CALL FIND'LOC
        CALL SET'SHIP'MODE
        IF WBWHAP = 0 THEN
            CALL DSP'PACK03'GKD
            PRINT TAB(-1,CR'OFF);
            CALL DSP'LOC'DESC
            CALL PRE'DSP'DOC'DESC
            CALL DSP'SHIP'MODE
            ?TAB(24,1) ; TAB(-1,9) ;
            PRINT TAB(-1,CR'ON);
        ENDIF
RETURN


MAP1 DID'FREE'FRT,B,1

COMPUTE'FREE'FRT'AMOUNT:
        TIME'CSV = "COMPUTE'FREE'FRT'AMOUNT:" : \TIME'CSV
        DID'FREE'FRT = 0
        HDR'CD(1) = 0
!!if by a zone change or closest location, no amount is put in
!!      the free freight field ... it just calculates differently.
!!      but, we go through below loop because of COD charge credits ...
        FOR QQ = 1 TO 7
           IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Start compute free frt QQ="+QQ+" HDR="+HDR'FREE'FRT+" FPP="+FFP'SHIP'TABLE(QQ)
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
           ENDIF
           CALC'TBL'AMT = 0
           SF = 0
!![44] - added org'loc test so I did not have to clear bit 1 on original.
           IF VIA'TBL'FLAG(QQ) = 2 AND OEC'CLOSE'LOC = "Y" AND &
                    HDR'BOX'COUNT = 1 AND HDR'LOC'NO # HDR'ORG'LOC THEN
                \TSTBIT HDR'BIT'FLAG 1 VAR="SF"
                IF SF = 1 THEN                  !!From multi location
                        CALL FNDLOC
                ENDIF
           ENDIF
           CASE
           IF HDR'LOC'NO # ALOC'NO(1)                                    AND &
                (HDR'LOC'NO # ALOC'NO(2) OR ALOC'ZONE(1) # ALOC'ZONE(2)) AND &
                                                        SF = 1 THEN
!!This is a COD charge not on the closest location for only 1 box, credit freight
!!This occurs even if no other free freight.
!!Malvern - leave below line in program - leave all free freight code in
                CALC'TBL'AMT = PSEUDO'VTTL(QQ)
           ELSE                         !![20] below test is 'A'
           IF ZONE'DISC'PERC(QQ) # 0 OR HDR'FREE'FRT = "A" OR &
                HDR'FREE'FRT = "T" OR HDR'FREE'FRT = "W" OR   &
                                                HDR'FREE'FRT = "Q" THEN
!!This is normal free freight discount, credit by rules if applicable.
                    IF HDR'FREE'FRT = "Y" OR HDR'FREE'FRT = "P" OR &
                                 HDR'FREE'FRT = "O" OR HDR'FREE'FRT = "A" &
                                 OR HDR'FREE'FRT = "T" OR HDR'FREE'FRT = "W" &
                                             OR HDR'FREE'FRT = "Q" THEN

!!Malvern - line below adds Free Freight.  Do not remove for Malvern mods.
                            \VIADISC PSEUDO'VTTL(QQ) CALC'TBL'AMT
                        IF DOING'FFP = 1 THEN
                            IF FFP'SHIP'TABLE(QQ) = "N" THEN
                                IF HDR'FREE'FRT # "T" AND HDR'FREE'FRT # "A" THEN
                                    CALC'TBL'AMT = 0
                                    IF DO'EXCUSE = 1 THEN
                                        SAV'ENTRY = ENTRY
                                        ENTRY = "1) SET "+QQ+" to zero from FFP'SHIP'TABLE"+" HDR'FF="+HDR'FREE'FRT
                                        CALL DO'EXCUSE'LOG
                                        ENTRY = SAV'ENTRY
                                    ENDIF
                                ENDIF
                            ENDIF
                        ELSE
                            IF QQ = VIA'COD'NO AND HDR'FREE'FRT = "W" THEN
                                CALC'TBL'AMT = 0
                                IF DO'EXCUSE = 1 THEN
                                    SAV'ENTRY = ENTRY
                                    ENTRY = "2) SET "+QQ+" to zero from HDR'FREE'FRT=W"
                                    CALL DO'EXCUSE'LOG
                                    ENTRY = SAV'ENTRY
                                ENDIF
                            ENDIF
                        ENDIF
                        IF FFP'SHIP'TABLE(QQ) = "O" AND HDR'LOC'NO # HDR'ORG'LOC THEN
                            IF HDR'FREE'FRT # "T" AND HDR'FREE'FRT # "A" THEN
                                CALC'TBL'AMT = 0
                                IF DO'EXCUSE = 1 THEN
                                    SAV'ENTRY = ENTRY
                                    ENTRY = "3) SET "+QQ+" to zero for originating location"
                                    CALL DO'EXCUSE'LOG
                                    ENTRY = SAV'ENTRY
                                ENDIF
                            ENDIF
                        ENDIF
                    ENDIF
           ENDCASE
           HDR'CD(1) = HDR'CD(1) - CALC'TBL'AMT
        NEXT QQ
        IF HDR'FREE'FRT = "Y" OR HDR'FREE'FRT = "P" OR &
                HDR'FREE'FRT  = "T" OR HDR'FREE'FRT = "W" OR &
                                                HDR'FREE'FRT = "Q" THEN
            IF INC'AUTOPACK # "Y" AND HDR'ACTION = "P" THEN
                \TSTBIT HDR'BIT'FLAG 16 VAR="SF"
            ELSE
                SF = 0
            ENDIF
            IF SF # 1 THEN
                CALL COMPUTE'WGT'CNT    !!Better be mode "B"
                IF INC'AUTOPACK # "Y" AND ACTION # "E" THEN
                    WGT = ORG'WEIGHT
                ENDIF
                IF WGT # 0 AND WGT > FFWGT THEN
                     !!Only do if WGT > FFWGT so we don't give more than 100%
                    HDR'CD(1) = (FFWGT / WGT) * HDR'CD(1)                         !![66]
                ENDIF
            ENDIF
        ENDIF                                                                           !![66]
FREE'FREIGHT:    !!Free Freight - leave label for future debug
        IF HDR'CD(1) # 0 THEN
                DID'FREE'FRT = 1
        ENDIF
RETURN

MAP1 BIGGEST'SPACE,S
        MAP2 BIGGEST'BNO,B,2
        MAP2 BIGGEST'VALUE,B,5
        MAP2 BIGGEST'CHARGE(7),B,5

ONE'COD'PER'ORDER:
        TIME'CSV = "ONE'COD'PER'ORDER:" : \TIME'CSV
        IF OC2'ONECOD'OVR = "Y" THEN
            IF TRH'COD'STATUS = 2 THEN    !! should be order terms
                CUS'ONE'COD = "Y"
            ENDIF
        ENDIF
        BVALUE'YN'BOX'NO = 0
        IF VIA'SHP'FLAG <= 1 RETURN                             !!KLUDGE
        IF TRH'COD'STATUS = 1 OR CUS'ONE'COD # "Y" RETURN       !!KLUDGE
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "Terms cod status: "+TRH'COD'STATUS+" Cus one cod: "+CUS'ONE'COD
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Setting one COD charge for "+VIA'DESC
            CALL TCOUNT'START
        ENDIF
        BIGGEST'SPACE = SPACE
        BKEY = WORK'MODE + (VIA'NO USING "#ZZZ")
        SBKEY = BKEY
        DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                IF BKEY[1;5] # SBKEY EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                FOR II = 1 TO 7
                  IF ZONE'BOX'ORDER(II) = "B" AND VIA'TBL'FLAG(II) = 2 THEN
!!COD charge by box ...
!!autopack used instead of OC2'1ST'ONEBOX.  we only really know value if
!!autopacking, and if so we should use it, if not just put on 1st.
!![holy cow] added 1ST'ONEBOX back to next if and left autopack in as well.
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "OC2="+OC2'1ST'ONEBOX+" BV="+BIGGEST'VALUE+" BC="+BIGGEST'CHARGE(II)
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
                        IF INC'AUTOPACK # "Y" OR OC2'1ST'ONEBOX # "N" THEN
!!Not autopacking put this on 1st box every time.
                            IF BNO = 1 THEN
                                BIGGEST'BNO = BNO
                                BIGGEST'VALUE = ABS(BSHP'TOTAL)
                                BIGGEST'CHARGE(II) = BSHP'VTTL(II)
                            ENDIF
                        ELSE
                            IF (ABS(BSHP'TOTAL) >= BIGGEST'VALUE         AND &
                                  INC'AUTOPACK = "Y") OR BIGGEST'VALUE = 0 THEN
!! COD charge
                                IF BSHP'VTTL(II) # 0 THEN
                                    BIGGEST'BNO = BNO
                                    BIGGEST'VALUE = ABS(BSHP'TOTAL)
                                    BIGGEST'CHARGE(II) = BSHP'VTTL(II)
                                ENDIF
                            ENDIF
                        ENDIF
                        BVALUE'YN = "N"
                        BSHP'VTTL(II) = 0       !!Snuff it
                  ENDIF
                NEXT II
                XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                IF BCTL = 0 THEN
                    XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                ENDIF
                XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
        LOOP
        IF BIGGEST'BNO # 0 THEN
            BKEY = SBKEY + (BIGGEST'BNO USING "#ZZZ")
            XCALL VICSIT,7,3,BREC,BKEY,BPTR,0,BCTL !!USE
            FOR II = 1 TO 7
                  IF ZONE'BOX'ORDER(II) = "B" AND VIA'TBL'FLAG(II) = 2 THEN
                        BSHP'VTTL(II) = BIGGEST'CHARGE(II)      !!Put it back
                  ENDIF
            NEXT II
            XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
            BVALUE'YN = "Y"         !!It is this one!
            BVALUE'YN'BOX'NO = BNO
            XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
        ENDIF
RETURN

PROCESS'CREDIT'CARD:
        TIME'CSV = "PROCESS'CREDIT'CARD:" : \TIME'CSV

        IF HDR'ACTION # "P" THEN
            XCALL GETENV,"LOC"+STR(HDR'LOC'NO)+"_PATH",ENTRY
            IF ENTRY = "" RETURN        !!Not HOB
        ENDIF
        CALL GET'ATQT
        IF ATQT'CTL # 0 THEN
            INX1 = I'FUN
            INX2 = FN'A
        ELSE
            CALL SUM'HTOTAL
            IF (CALC'HTOTAL - HDR'OLD'CASH - HDR'OLD'CR + HDR'OLD'DR) > ATQ'AMT THEN
                ATQ'HRS = 99
ATQ'99'HRS:
                ENTRY = "  OEPACK: PROCESS'CREDIT'CARD (Order Total Changed) [UB'UID="+UB'UID+" UB'NAME="+UB'NAME+"] "
                CALL LOG'AUTH
                ENTRY = "Reset Authorization) HRS="+ATQ'HRS+" HTOT="+CALC'HTOTAL+" OLD'CSH="+HDR'OLD'CASH+" OLD'CR="+HDR'OLD'CR+" OLD'DR="+HDR'OLD'DR+" ATQ'AMT="+ATQ'AMT
                CALL LOG'AUTH
            ENDIF
            ATQ'AMT = CALC'HTOTAL - &
                                HDR'OLD'CASH - HDR'OLD'CR + HDR'OLD'DR
            UPDATE ATQT FROM ATQ'REC
            IF ATQ'AMT < 0 THEN
                ATQT2'KEY = ATQT'KEY
                ATQT2'KSPECIAL = ATQ'OSPECIAL
                USE ATQT2 INTO ATQ2'REC KEY ATQT2'KEY
                IF ATQT2'CTL # 0 AND ATQT2'KSOURCE = "OE" THEN
                    ATQT2'KSOURCE = "WB"
                    USE ATQT2 INTO ATQ2'REC KEY ATQT2'KEY
                ENDIF
                IF ATQT2'CTL # 0 THEN
                    ENTRY = "ERROR - Unable to find original order to verify amount. "+ATQ'OSPECIAL
                    \KERROR ATQT APID="CV" MODE="K"
                    CALL DO'ERR'OEPACKL
                    INX1 = I'FUN
                    INX2 = FN'A
                ELSE
                    IF ATQ2'STATUS = "P" THEN
                        IF ATQ2'AMT < ATQ'AMT THEN
                            ENTRY = "ERROR - Credit amount cannot be larger than original order amount "+ATQ2'AMT+"/"+ATQ'AMT
                            \KERROR ATQT APID="CV" MODE="K"
                            CALL DO'ERR'OEPACK
                            INX1 = I'FUN
                            INX2 = FN'A
                        ENDIF
                    ELSE
                        IF ATQ2'AMT # ABS(ATQ'AMT) THEN
                            ENTRY = "ERROR - Credit amount must match original order amount "+ATQ2'AMT+"/"+ATQ'AMT
                            \KERROR ATQT APID="CV" MODE="K"
                            CALL DO'ERR'OEPACK
                            INX1 = I'FUN
                            INX2 = FN'A
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
            IF INX2 # FN'A THEN
                IF ATQ'VSTATUS # "P" AND HDR'HOLD'YN # "O" THEN
                    ENTRY = "This credit card order is not verified.  Invoicing not allowed."
                    CALL DO'ERR'OEPACK
                    INX1 = I'FUN
                    INX2 = FN'A
                ELSE
                    CTP'SPACE = SPACE
                    CTP'KNO = TRH'CTP'NO
                    \VUSE CTP
                    IF CTP'CTL # 0 THEN
                        ENTRY = "Error - Credit card type not found "
                        \HDRERR
                        CALL DO'ERR'OEPACKL
                    ENDIF
                    IF ATQ'APPROVAL = "" AND (USE'CC = "N" OR &
                                                CTP'ATIME = 0) THEN
                        CALL DO'ATQ
                        IF INX2 >  2 THEN
                            REL ATQT
                            ENTRY = "The approval code MUST be entered before invoicing"
                            CALL DO'ERR'OEPACK
                            INX1 = I'FUN
                            INX2 = FN'A
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        REL ATQT
RETURN

PROCESS'PULLER'CHECKER:
    TIME'CSV = "PROCESS'PULLER'CHECKER:" : \TIME'CSV
    IF WBWHAP = 0 THEN
        PLC'SPACE = SPACE
        PLC'LOC'NO = HDR'LOC'NO
        PLC'DOC'TYPE = HDR'DOC'TYPE
        PLC'HDR'NO = HDR'NO
        PLC'SHIPMENT = HDR'SHIPMENT + 1
        \SETKEY PLC MODE="KEY"
        RDLOCK PLC INTO PLC'REC KEY PLC'KEY
        PLCOLD'REC = PLC'REC
        IF PLC'DTT = 0 THEN PLC'DTT = DATE
        IF INC'AUTOPACK = "N" THEN
            ECFLD = 0
            DDB PACK04
            GDB PACK04
        ELSE
            \WINDOW REPAINT="N" RESTORE="N" &
                        OVRLAY="PLCWIN" AUTOSIZE="PLCWIN" SINX="Y"
        ENDIF
        CALL OEPACK'TST'FUNC2
        IF TST'FUNC = 0 THEN
            IF PLC'CTL = 0 THEN
                IF PLC'REC # PLCOLD'REC THEN
                    WRITE PLC FROM PLC'REC
                ELSE
                    REL PLC
                ENDIF
            ELSE
                ADD PLC FROM PLC'REC KEY PLC'KEY
                \SETKEY PLC MODE="KY2"
                \ADDKEY PLC MODE="KY2"
            ENDIF
        ENDIF
    ENDIF
RETURN

MAP1 BADCR,B,1

GET'FINAL'ACTION:
        TIME'CSV = "GET'FINAL'ACTION:" : \TIME'CSV
        BADCR = 0                               !![59]
        IF WBWHAP # 0 THEN        !!this code is for Web orders
            IF WL'DEBUG # "" THEN
                SAV'ENTRY = ENTRY
                ENTRY = "Order: "
                \KERROR HDR MODE="D" APID="OE" CNO="N"
                ENTRY = ENTRY + " 1: calling cmpcrl from oepack hold="+HDR'HOLD'YN
                \LABLOGGER ENTRY WL'DEBUG
                ENTRY = SAV'ENTRY
            ENDIF
            CALL TEST'HOLDS
            INX1 = I'FUN
            INX2 = FN'P
            TIME'CSV = "GET'FINAL'ACTION: EARLY RETURN"
            \TIME'CSV
            RETURN
        ENDIF
        IF WBWHAP # 0 THEN
            DO'CALL'TAG = "N"
        ENDIF
        IF HDR'ACTION = "E" OR HDR'ACTION = "L" THEN
            IF DO'CALL'TAG # "Y" THEN
                IF WL'DEBUG # "" THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "Order: "
                    \KERROR HDR MODE="D" APID="OE" CNO="N"
                    ENTRY = ENTRY + " 2: calling cmpcrl from oepack hold="+HDR'HOLD'YN
                    \LABLOGGER ENTRY WL'DEBUG
                    ENTRY = SAV'ENTRY
                ENDIF
                CALL TEST'HOLDS
                IF DONE'ACK # "Y" THEN
                    IF HDR'HOLD'YN = "5" THEN
                        ENTRY = "A>bort, B go back, W Header"
                    ELSE
                        ENTRY = "P>ick, A>bort, B go back, W Header, F7 invoice, L Ord/Ack"
                    ENDIF
                ELSE
                    IF HDR'HOLD'YN = "5" THEN
                        ENTRY = "A>bort, B go back, W Header"
                    ELSE
                        ENTRY = "P>ick, A>bort, B go back, W Header, F7 invoice"
                    ENDIF
                ENDIF
            ELSE
                ENTRY = "C or F10 for call tags, B go back, W Header, A>to continue"
            ENDIF
        ELSE
            IF OEC'HOLD'COM = "Y" THEN
                CALL TEST'HOLDS
!!Save message from Test Holds; ENTRY gets used in DUMP'BOX'AND'TOTAL'HDR
                SENTRY = ENTRY
                IF IER1 # 1 THEN
                    LOCAL'FTIME = 1         !!Force screen re-display
                    CALL DUMP'BOX'AND'TOTAL'HDR
                    ENTRY = SENTRY
                    HDR'SHP'DONE = "Y"

                    IF MULTI'FLAG # 0 AND KEEP'PACKING = "Y" THEN
                        BADCR = 1               !![59]
                        RETURN                  !![59]
                    ELSE
                        CALL DO'ERR
                        TIME'CSV = "GET'FINAL'ACTION: GOTO ABORT"
                        \TIME'CSV
                        GOTO ABORT
                    ENDIF
                ENDIF
            ENDIF
            IF INC'AUTOPACK = "N" AND HDR'ACTION = "P" THEN
                        CALL SUM'HTOTAL
                        CALL DSP'PACK04'TOTALS1
                        CALC'HTOTAL = CALC'HTOTAL - HDR'OLD'CASH - &
                                        HDR'OLD'CR + HDR'OLD'DR
                        CALL DSP'PACK04'TOTALS2
                        IF CHK'WGT = 1 THEN
                                CHK'WGT = 0
                                ENTRY = "Check weights and counts - there is a large variance!"
                                CALL DO'ERR'OEPACK
                        ENDIF
            ENDIF
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "INC="+INC'AUTOPACK+" ACTION="+HDR'ACTION+" CALC="+CALC'HTOTAL+" NO="+HDR'NO
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF

            ENTRY = "P to invoice, A>bort, B>ack, W to Header"

            IF INC'AUTOPACK = "N" THEN
                ENTRY = ENTRY + ", F7 to Pick"
            ENDIF
            ENTRY = ENTRY + ", F8 Msg"

            IF MBXERROR'COUNT > 0 THEN
                ENTRY = "Malvern box rate not retrieved - Invoice aborted"
                FN'7'QUEUED = 0
                FN'B'QUEUED = 0
                FN'L'QUEUED = 0
                INX2 = FN'A
                IF WBWHAP # 0 THEN        !!IN YOUR FACE
                    ENTRY = "Pack failed! Forced Abort see message"
                    CALL DO'ERR
                ENDIF
            ENDIF
        ENDIF
        SENTRY = ENTRY
        DO
            IF FN'7'QUEUED = 1 THEN
                FN'7'QUEUED = 0
                INX1 = I'FUN
                INX2 = FN'7
            ELSE
                IF FN'B'QUEUED = 1 THEN
                    FN'B'QUEUED = 0
                    INX1 = I'FUN
                    INX2 = FN'B
                ELSE
                    IF FN'L'QUEUED = 1 THEN
                        FN'L'QUEUED = 0
                        INX1 = I'FUN
                        INX2 = FN'L
                    ELSE
                        ENTRY = SENTRY
                        \L24CHR NOMSG="Y" CLR="Y"
                        IF INX2 = FN'8 THEN
                            \WINDOW FULL="Y" SCREEN="PACK" ACTION="WINMES3"
                            CALL UPDATE'HDR
                            REPEAT
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
            IF WBWHAP # 0 THEN
                DO'CALL'TAG = "N"
            ENDIF
            IF DO'CALL'TAG = "Y" THEN
                CASE
                IF UCS(ENTRY) = "C" THEN
                    ENTRY = "P"
                ELSE
                IF UCS(ENTRY) = "P" THEN
                    ENTRY = "C"
                ENDCASE
            ENDIF
            IF MBXERROR'COUNT > 0 THEN
                ENTRY = "Malvern box rate not retrieved - Invoice aborted"
                MSG'DID = "OEMSG"
                \LOOPMSG PRE="HDR" APPEND="HDR'MSGNO" DATA="ENTRY"
                ENTRY = "A"
            ENDIF
            IF UCS(ENTRY) = "A" THEN INX2 = FN'A
            IF UCS(ENTRY) = "B" THEN INX2 = FN'B
            IF UCS(ENTRY) = "W" THEN INX2 = FN'W
            IF UCS(ENTRY) = "D" THEN INX2 = FN'D
            IF UCS(ENTRY) = "L" THEN INX2 = FN'L
            IF INX2 = FN'L THEN
                IF HDR'ACTION # "E" THEN
                    ENTRY = "Cannot do acknowledgement now!"
                    CALL DO'ERR
                    REPEAT
                ELSE
                    HDR'ACTION = "L"
                ENDIF
            ENDIF
            IF FORCE'P = "Y" THEN
                IF INX2 = FN'10 OR INX1 = I'ESC REPEAT
            ENDIF
            IF UCS(ENTRY) = "P" OR INX2 = FN'P OR INX1 = I'ESC THEN
                INX2 = FN'10
                IF INC'AUTOPACK = "Y" THEN
                    SENTRY = UB'UID+" Invoiced: "+HDR'LOC'NO+"-"+HDR'DOC'TYPE+"-"+ &
                                    HDR'NO
                    XCALL VICSIT,26,SENTRY,"/logs/oe1wga.DAILY"
                ENDIF
            ENDIF
            IF WBWHAP # 0 THEN
                DO'CALL'TAG = "N"
            ENDIF
            IF INX2 = FN'7 AND (DO'CALL'TAG = "Y" OR INC'AUTOPACK = "Y") REPEAT
        LOOP UNTIL INX2 = FN'7 OR INX2 = FN'A OR INX2 = FN'B OR INX2 = FN'10 OR INX2 = FN'W OR INX2 = FN'D OR INX2 = FN'L

                        !![17] only if FN'A
        IF WBWHAP # 0 THEN
            DO'CALL'TAG = "N"
        ENDIF
        IF HDR'ACTION = "E" AND DO'CALL'TAG = "Y" AND INX2 = FN'A THEN
            ENTRY = "Call tag NOT generated!"
            \L24CHR CLR="Y"
            DO'CALL'TAG = "F"               !!Finished w/call tag
            CALL GET'FINAL'ACTION
        ENDIF
RETURN

PROCESS'ABORT'KEY:
        TIME'CSV = "PROCESS'ABORT'KEY:" : \TIME'CSV
        IF HDR'ACTION = "P" THEN
                LOCAL'FTIME = 1         !!Force screen re-display
                IF HDR'HOLD'YN = "N" THEN HDR'HOLD'YN = "Y"
                IF WBWHAP # 1 THEN
                    DO
                        ?TAB(-1,0);
                        ENTRY = "Reason For Not Invoicing"
                        CALL WINMAC
                        IF HDR'MSGNO = 0 THEN
                            ENTRY = "You MUST enter your reason!"
                            CALL DO'ERR'OEPACK
                        ENDIF
                    LOOP UNTIL HDR'MSGNO # 0
                ENDIF
        ENDIF
RETURN

SET'LST'RECORDS:
        TIME'CSV = "SET'LST'RECORDS:" : \TIME'CSV
        IF BILL'NO # HDR'NAM'NO THEN
                COPYF "LSTFIL[MC]",=BILL,NOAFR
                COPYF "LSTFIL[MC]",=SHIP,NOAFR
                CALL USE'LST'BILL

                IF LSTF'CTL # 0 THEN
                        ENTRY = "Customer LSTF not found on "+HDR'NO+"-"+HDR'ACTION
                        CALL DO'ERR'OEPACK
                        GOTO DEAD'ABORT
                ENDIF
        ELSE
                LST'REC = BILL'REC
        ENDIF
SET'SHIP'LST'RECORD:
!       ALB'RES'YN = BILL'RES'YN
        ALB'RES'YN = SHIP'RES'YN
        IF HDR'DROP'YN = "Y" THEN
            IF SHIP'NO # HDR'SHP'NO OR SHIP'ALT'NO # HDR'SHIP'TO THEN
                CALL USE'LST'SHIP
                SHIP'REC = LST'REC
                IF HDR'SHIP'TO = 0 THEN ALB'RES'YN = LST'RES'YN
            ENDIF
        ELSE
        IF HDR'SHIP'TO # 0 THEN
            IF SHIP'NO # HDR'NAM'NO OR SHIP'ALT'NO # HDR'SHIP'TO THEN
                CALL USE'LST'SHIP
                SHIP'REC = LST'REC
            ENDIF
        ELSE
                IF LST'NO # HDR'NAM'NO THEN
                    CALL USE'LST'BILL
                ELSE
                    CALL USE'LST'SHIP
                ENDIF
                SHIP'REC = LST'REC
                ALB'RES'YN = SHIP'RES'YN
        ENDIF
        ENDIF
        IF AVIA'RES'VIA'NO # 0 THEN
!!If ALB'RES'YN is blank old code would default to N which will force to commercial
            IF VIA'CARRIER = "UPSSPS" AND ALB'RES'YN = "" THEN
                IF LST'RES'YN = "N" OR LST'RES'YN = "Y" THEN
                    ALB'RES'YN = LST'RES'YN
                ENDIF
            ENDIF
            IF ALB'RES'YN # "Y" THEN ALB'RES'YN = "N"
!!          IF UPC'RES'GAMES = "Y" THEN ENTRY = "Y" ELSE ENTRY = ALB'RES'YN
            IF ALB'RES'YN # AVIA'RES'IND THEN
                VIA'KNO = AVIA'RES'VIA'NO
                CALL FIND'VIA
                IF VIA'NO # AVIA'RES'VIA'NO AND VIA'RES'VIA'NO # 0 AND SF # 2 THEN
                    VIA'KNO = VIA'RES'VIA'NO
                    CALL GET'VIA
                ENDIF
!!              IF UPC'RES'GAMES = "Y" THEN ENTRY = "Y" ELSE ENTRY = ALB'RES'YN
                IF VIA'CTL = 0 AND ALB'RES'YN = VIA'RES'IND THEN
                    IF HDR'BVIA'NO = HDR'VIA'NO OR &
                                            HDR'BVIA'NO = AVIA'CVIA'NO THEN
                        IF VIA'CVIA'NO # 0 THEN
                            HDR'BVIA'NO = VIA'CVIA'NO
                        ELSE
                            HDR'BVIA'NO = VIA'NO
                        ENDIF
                    ENDIF
                    DD = HDR'VIA'NO
                    HDR'VIA'NO = VIA'NO
                    AVIA'REC = VIA'REC
                    CALL E'AVIA'NO'SF
                    IF SF # 0 THEN        !! Sets back to original via
                        HDR'VIA'NO = DD
                        VIA'KNO = HDR'VIA'NO
                        CALL GET'VIA
                        AVIA'REC = VIA'REC
                    ENDIF
                    IF HDR'BVIA'NO # BVIA'NO THEN
                        VIA'KNO = HDR'BVIA'NO
                        CALL GET'VIA
                        BVIA'REC = VIA'REC
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        IF BVIA'RES'VIA'NO # 0 THEN !!USE'VAT is why I added it, but it should always be there!
            IF ALB'RES'YN # "Y" THEN ALB'RES'YN = "N"
!!          IF UPC'RES'GAMES = "Y" THEN ENTRY = "Y" ELSE ENTRY = ALB'RES'YN
            IF ALB'RES'YN # BVIA'RES'IND THEN
                VIA'KNO = BVIA'RES'VIA'NO
                CALL GET'VIA
!!              IF UPC'RES'GAMES = "Y" THEN ENTRY = "Y" ELSE ENTRY = ALB'RES'YN
                IF VIA'CTL = 0 AND ALB'RES'YN = VIA'RES'IND THEN
                    HDR'BVIA'NO = VIA'NO
                    BVIA'REC = VIA'REC
                ENDIF
            ENDIF
        ENDIF
        IF CUS'CTL # 0 OR LSTF'CTL # 0 THEN
                ENTRY = "Ship to not found on "+HDR'NO+"-"+HDR'ACTION
                CALL DO'ERR'OEPACK
                GOTO DEAD'ABORT
        ENDIF
RETURN

CLEAR'PACK04:
        TIME'CSV = "CLEAR'PACK04:" : \TIME'CSV
        IF INC'AUTOPACK = "N" AND HDR'ACTION = "P" THEN
                PACK04'UP = 0
                \WINDOW SAVE="N" RESTORE="Y" ACTION="DO'PACK04" &
                        AUTOSIZE="PACK04" SCREEN="PACK03" SAVSCR="PACK04'SAVE"
        ENDIF
RETURN

MAP1 HWEIGHT,B,5
MAP1 LWEIGHT,B,5
MAP1 CHK'WGT,B,1

CHECK'WEIGHTS:
        TIME'CSV = "CHECK'WEIGHTS:" : \TIME'CSV
        IF WBWHAP = 1 RETURN                    !!KLUDGE
        CHK'WGT = 0
        HWEIGHT = INT((((10000+OC2'WPERC)*HDR'WEIGHT)/10000)+99)/100
!! TEN % FOR 25 LBS                1000         2500
!!11000 X 2500 = 27500000
!!2750 + 99 = 2849/100 = 28.49, INT X 100 = 2800
!!
!!E.G. HIGH WEIGHT IS 110 PERCENT OF ACTUAL ROUND UP UP UP TO NEXT LBS
!!
        LWEIGHT = INT(((10000-OC2'WPERC)*HDR'WEIGHT)/10000)/100
!! TEN % FOR 25 LBS                1000         2500
!!9000 X 2500 = 22500000
!!2250/100 = 22.50, INT X 100 = 2200
!!
!!E.G. HIGH WEIGHT IS 110 PERCENT OF ACTUAL ROUND UP UP UP TO NEXT LBS
!!
!!THIS MEANS THAT AT 10.00% ERROR A 25LBS CALCULATED PACKAGE SHOULD BE
!!BETWEEN 22.00 AND 28.00 LBS ...
!!
        CALL TOTAL'WGT
        ENTRY = ""
        IF WGT'WGT'TOTAL < LWEIGHT THEN
            ENTRY = "Wgt low: "+(LWEIGHT USING "#,###")+" yours: "+(WGT'WGT'TOTAL USING "#,###")+" compute: "+(INT(HDR'WEIGHT/100) USING "#,###")
        ELSE
        IF WGT'WGT'TOTAL > HWEIGHT THEN
            ENTRY = "Wgt high: "+(HWEIGHT USING "#,###")+" yours: "+(WGT'WGT'TOTAL USING "#,###")+" compute: "+(INT(HDR'WEIGHT/100) USING "#,###")
        ENDIF
        ENDIF
!!Reusing variables for count ...
        HWEIGHT = INT(((10000+OC2'WPERC)*HDR'BOX'COUNT/10000)+.99)
        LWEIGHT = INT(((10000-OC2'WPERC)*HDR'BOX'COUNT/10000)+.99)
        HWEIGHT = HWEIGHT MAX (HDR'BOX'COUNT + 1)
        LWEIGHT = LWEIGHT MIN (HDR'BOX'COUNT - 1)
        IF WGT'WGT'CNT < LWEIGHT THEN
                ENTRY = ENTRY + " Count low: "+(LWEIGHT USING "#,###")+" yours: "+(WGT'WGT'CNT USING "#,###")+" compute: "+(HDR'BOX'COUNT USING "#,###")
        ELSE
        IF WGT'WGT'CNT > HWEIGHT THEN
                ENTRY = ENTRY + " Count high: "+(HWEIGHT USING "#,###")+" yours: "+(WGT'WGT'CNT USING "#,###")+" compute: "+(HDR'BOX'COUNT USING "#,###")
        ENDIF
        ENDIF
        IF ENTRY # "" THEN
                ENTRY = ENTRY + " for order:"
                \KERROR PRE="HDR" MODE="D"
                IF OEPACK'WGTLOG # "" THEN
                    XCALL VICSIT,26,ENTRY,OEPACK'WGTLOG
                ELSE
                    CALL DO'ERRLO
                ENDIF
                CHK'WGT = 1
        ENDIF
RETURN

TOTAL'WGT:
        TIME'CSV = "TOTAL'WGT:" : \TIME'CSV
        WGT'WGT'SPACE = SPACE
        IF VIA'SHP'FLAG <= 1 RETURN
        FOR II = 1 TO WGTMAX
                        !!Fix weights so all after first zero wgt
                        !!are also zero.
                IF WGT'WGT'MODE = 0 THEN
                        IF WGT'WGT(II) = 0 THEN
                                WGT'WGT'MODE = 1
                        ELSE
                                WGT'WGT'CNT = WGT'WGT'CNT + 1
                                WGT'WGT'TOTAL = WGT'WGT'TOTAL + WGT'WGT(II)
                        ENDIF
                ELSE
                        WGT'WGT(II) = 0
                        WGT'OVERSIZ1(II) = "N"
                        WGT'OVERSIZ2(II) = "N"
                        WGT'OVERSIZ3(II) = "N"
                        WGT'ADDCHG(II) = "N"
                        WGT'DIMENSION(II) = "N"
                ENDIF
        NEXT II
RETURN

COPYF "CALFIL",=CAL1

DO'CAL:
        TIME'CSV = "DO'CAL:" : \TIME'CSV
        WGT'SPACE = SPACE
        WGT'WGT'SPACE = SPACE
        BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
        SBKEY = BKEY
        DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                IF BKEY[1;5] # SBKEY EXIT
                WGT'WGT(BNO) = INT((BCWEIGHT + 99)/100)       !!Round it up to next whole
                WGT'OVERSIZ1(BNO) = BOVERSIZ1
                WGT'OVERSIZ2(BNO) = BOVERSIZ2
                WGT'OVERSIZ3(BNO) = BOVERSIZ3
                WGT'ADDCHG(BNO) = BADDCHG
                WGT'DIMENSION(BNO) = BDIMENSION
                WGT'HAZ'MAT(BNO) = BHAZ'MAT
                WGT'WGT'CNT = WGT'WGT'CNT + 1
                WGT'WGT'TOTAL = WGT'WGT'TOTAL + WGT'WGT(BNO)
                IF BDIMENSION = "Y" OR BOVERSIZ1 = "Y" OR BOVERSIZ2 = "Y" OR &
                        BOVERSIZ3 = "Y" THEN
                    WGT'WGT(BNO) = BSWGT
                ENDIF
        LOOP
        CALL CREATE'ARECS       !!Same weights as billing, but the
                                !!zips, zones, closest loc, etc. are actual.
        CALL SETUP'ACTUAL       !!get flags, etc., correct

        IF AZONE'IS'ZIP = 0 THEN
                ENTRY = "Invalid call tags - no zip/zone table in ship via!"
                GOTO DO'ERR
        ENDIF
        CAL'LOC'NO = HDR'LOC'NO
        CAL'DOC'TYPE = HDR'DOC'TYPE
        CAL'CUS'NO = HDR'NAM'NO
        CAL'ALT'NO = HDR'SHIP'TO
        CAL'ZONE = AZONE(AZONE'IS'ZIP)
        CAL'VIA'NO = HDR'VIA'NO                 !!Actual ...
        CAL'HDR'NO = HDR'NO
        CAL'PRINTED'YN = "N"
        CAL'NO = 9999999
        \SETKEY CAL MODE="KEY"
        USE CAL INTO CAL1'REC KEY CAL'KEY
        IF CAL'CTL # 0 THEN
                GETPRV CAL INTO CAL1'REC
                IF CAL'CTL # 0 THEN
                        CAL1'NO = 0
                ELSE
                        CAL'CTL = 1
                ENDIF
                CAL'NO = CAL1'NO
                DO WHILE CAL'CTL # 0
                        CAL'DTT = DATE
                        CAL'TIME = TIME
                        CAL'NO = CAL'NO + 10
                        \SETKEY CAL MODE="KEY"
                        ADD CAL FROM CAL'REC KEY CAL'KEY
                LOOP
                \SETKEY CAL MODE="KY2"
                \ADDKEY CAL MODE="KY2"
        ELSE
                ENTRY = "Highest possible Call Tag number already exists.  Unable to add."
                CALL DO'ERR'OEPACK
        ENDIF

        CLB'SPACE = SPACE
        CLB'CAL'LOC'NO = CAL'LOC'NO
        CLB'CAL'NO = CAL'NO
        BKEY = "A" + (HDR'VIA'NO USING "#ZZZ")
        SBKEY = BKEY
        DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                IF BKEY[1;5] # SBKEY EXIT
                CLB'NO = BNO
                CLB'WEIGHT = BCWEIGHT
                CLB'FREIGHT = ABS(BSHP'VTTL(AZONE'IS'ZIP))
                CLB'CHARGE = OEC'CALL'TAG
                CLB'RECEIVED = "N"
                CLB'DECL'VAL = -BSHP'TOTAL
                CLB'OS1'YN = "N"
                CLB'OS2'YN = "N"
                CLB'AC'YN = "N"
                \UPSNUM CLB'TRACK'NO SERV="VIA'1Z'SERV" BOX'NO="CLB'NO" UPSNUM'TRHPTR="Y" LSTPRE="SHIP"
                CLB'TRACK'NO = "Not manifested"
!!Track No set in manifest program
                \SETKEY CLB MODE="KEY"
                ADD CLB FROM CLB'REC KEY CLB'KEY
                \SETKEY CLB MODE="KY2"
                \ADDKEY CLB MODE="KY2"
        LOOP
!!      INX1 = I'FUN
!!      INX2 = FN'A
        ENTRY = "Call tag generated - billing totals now displayed"
        \L24CHR CLR="Y"
        DO'CALL'TAG = "F"               !!Finished
RETURN

DELETE'CAL:
        TIME'CSV = "DELETE'CAL:" : \TIME'CSV
        CAL'LOC'NO = HDR'LOC'NO
        CAL'DOC'TYPE = HDR'DOC'TYPE
        CAL'HDR'NO = HDR'NO
        CAL'NO = 0
        \SETKEY CALO MODE="KEY"
        USE CALO INTO CAL'REC KEY CALO'KEY
        GETNXT CALO INTO CAL'REC
        IF CAL'LOC'NO # HDR'LOC'NO OR CAL'DOC'TYPE # HDR'DOC'TYPE OR &
                        CAL'HDR'NO # HDR'NO THEN CALO'CTL = 3
        IF CALO'CTL = 0 THEN
                IF CAL'PRINTED'YN = "N" THEN
                        \SETKEY CALO ALTKEY="CALO1"
                        USE CALO1 INTO CAL1'REC KEY CALO1'KEY
                        DO
                                GETNXT CALO1 INTO CAL1'REC
                                \CHKKEY CALO ALTPRE="CAL1" ALTKEY="CALO1"
                                IF CALO1'CTL # 0 EXIT
                                IF CAL1'PRINTED'YN = "Y" EXIT
                                RDLOCK CAL CALO1'RCN INTO CAL'REC
                                IF CAL'CTL = 0 THEN
                                        \SETKEY CAL MODE="ALL"
                                        DELETE CAL KEY CAL'KEY
                                        \DELKEY CAL MODE="KY2"
                                        CLB'KCAL'LOC'NO = CAL'LOC'NO
                                        CLB'KCAL'NO = CAL'NO
                                        CLB'KNO = 0
                                        IF WBWHAP = 0 THEN
                                            \DELOOP PRE="CLB" DSP="Y"
                                        ELSE
                                            \DELOOP PRE="CLB" DSP="N"
                                        ENDIF
                                ELSE
                                        ENTRY = "Reread error on call tags "
                                        \KERROR CAL MODE="D"
                                        CALL DO'ERRLO
                                        INX1 = I'FUN
                                        INX2 = FN'A
                                        RETURN
                                ENDIF
                        LOOP
                        IF CALO1'CTL # 0 THEN
                                CAL'SPACE = SPACE
                                CLB'SPACE = SPACE
                        ELSE
                                CAL'REC = CAL1'REC
                        ENDIF
                ENDIF
                IF CAL'PRINTED'YN = "Y" THEN
                        ENTRY = "A call tag has already been generated for this order."
                        CALL DO'ERR'OEPACK
                        ENTRY = "Before generating a new one, the old one must be deleted."
                        CALL DO'ERR'OEPACK
                        INX1 = I'FUN
                        INX2 = FN'A
                        RETURN
                ENDIF
        ENDIF
RETURN

SETUP'ACTUAL:
        TIME'CSV = "SETUP'ACTUAL:" : \TIME'CSV
        WE'HAVE'ARECS = 1               !!Set to simplify later tests
        CALL SEE'IF'GAMES
        IF GAMES = 0 AND BZONE'REC'SET = BVIA'NO THEN
                AZONE'REC = BZONE'REC
                ZONE'REC = BZONE'REC
        ELSE
                CALL SET'BOX'ORDER'A    !!Makes AZONE'REC
        ENDIF
RETURN

SETUP'BILLING:
        TIME'CSV = "SETUP'BILLING:" : \TIME'CSV
        WE'HAVE'BRECS = 1               !!Set to simplify later tests
        MUST'WRITE'BRECS = 1
        CALL SET'BOX'ORDER'B            !!Makes BZONE'REC
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "TEST BIT'FLAG FFP="+SF+" BIT'F="+HDR'BIT'FLAG
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
RETURN

MAP1 NEED'CREATE'ARECS,B,1

SHOULD'WE'SAVE'BOXES:
        TIME'CSV = "SHOULD'WE'SAVE'BOXES:" : \TIME'CSV
        IF AVIA'SHP'FLAG > 1 AND HDR'ACTION = "P" AND INC'AUTOPACK = "N" AND &
                                                        WGT'WGT(1) # 0 THEN
            IF WBWHAP # 1 THEN
                \PUSHEDT
                ENTRY = "Enter 'Y' to save weights you just input: "
                CALL KEYIN
                IF ENTRY = "Y" THEN
                        IF NEED'CREATE'ARECS = 1 THEN
                                CALL CREATE'ARECS
                        ENDIF
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "6: DUMP BOX"
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
                        CALL DUMP'BOX'AND'TOTAL'HDR
                        \SETBIT HDR'MAN'FLAG 64  !!Actual BOX on disk
                ENDIF
                \POPEDT
            ELSE
                CALL DUMP'BOX'AND'TOTAL'HDR
                \SETBIT HDR'MAN'FLAG 64  !!Actual BOX on disk
            ENDIF
        ENDIF
RETURN

KEYIN:
        ?TAB(24,1) ; TAB(-1,A'CYAN) ; ENTRY ; TAB(-1,9); TAB(-1,A'NORM) ;
        EDT = "" : EROW = 24 :  ECOL = 78 : EMAX = 1
        ETYP = E'YES + E'FAST + E'CAPS + E'MUST
        ENTRY = "Y"
        CALL FORMAT'EMPTY'BUFFER
        KEYIN ETYP ENTRY
        CALL OEPACK'TST'FUNC2
        IF TST'FUNC = 1 THEN ENTRY = "Y"
RETURN

LOAD'WGT'REC'FROM'BOX'RECS:
        TIME'CSV = "LOAD'WGT'REC'FROM'BOX'RECS:" : \TIME'CSV
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Loading weights from BOX records"
            CALL TCOUNT'START
        ENDIF
        WGT'SPACE = SPACE
        BOX'SPACE = SPACE
        BOX'HDR'LOC'NO = HDR'LOC'NO
        BOX'DOC'TYPE = HDR'DOC'TYPE
        BOX'HDR'NO = HDR'NO
        BOX'NO = 1
        BOX'SHIPMENT = HDR'SHIPMENT + 1
        \SETKEY BOX MODE="KEY"
        USE BOX INTO BOX'REC KEY BOX'KEY
        DO
                GETNXT BOX INTO BOX'REC
                \CHKKEY BOX
                IF BOX'CTL # 0 EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                IF WE'HAVE'BRECS = 0 THEN
                        CALL SET'BREC'FROM'BOX'REC      !!Billing
                        IF BCWEIGHT # 0 THEN
                                BTYPE = "B"
                                BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ") + &
                                                (BNO USING "#ZZZ")
                                XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                        ENDIF
                ENDIF
                BXV'KEY = BOX'KEY2
                USE BXV INTO BOX'REC KEY BXV'KEY        !!Actual in BXV file
                                                        !!but used into BOX.

                CALL SET'BREC'FROM'BOX'REC              !!Actual
                WGT'WGT(BNO) = BCWEIGHT/100
                WGT'OVERSIZ1(BNO) = BOVERSIZ1
                WGT'OVERSIZ2(BNO) = BOVERSIZ2
                WGT'OVERSIZ3(BNO) = BOVERSIZ3
                WGT'ADDCHG(BNO) = BADDCHG
                WGT'DIMENSION(BNO) = BDIMENSION
                WGT'HAZ'MAT(BNO) = BHAZ'MAT
                IF BDIMENSION = "Y" OR BOVERSIZ1 = "Y" OR BOVERSIZ2 = "Y" OR &
                        BOVERSIZ3 = "Y" THEN
                    \FROUND (BCWEIGHT/100) DD
                ELSE
                    DD = 0
                ENDIF
                IF WGT'WGT(BNO) # 0 THEN
                        BTYPE = "A"
                        BKEY = "A" + (HDR'VIA'NO USING "#ZZZ") + &
                                                (BNO USING "#ZZZ")
!                       BCWEIGHT = WGT'WGT(BNO)*100
!                       BOVERSIZ1 = WGT'OVERSIZ1(BNO)
!                       BOVERSIZ2 = WGT'OVERSIZ2(BNO)
!                       BADDCHG = WGT'ADDCHG(BNO)
!                       BDIMENSION = WGT'DIMENSION(BNO)
!                       BHAZ'MAT = WGT'HAZ'MAT(BNO)
                        BSWGT = DD
                        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                ENDIF
        LOOP
        WE'HAVE'ARECS = 1
RETURN

MAP1 SETTING,B,1

SET'BILLING'MODE:
        TIME'CSV = "SET'BILLING'MODE:" : \TIME'CSV
        WORK'MODE = "B"
        VIA'REC = BVIA'REC
        ZONE'REC = BZONE'REC
        IF ZONE'REC'SET # VIA'NO THEN
            IF SETTING = 0 THEN
                SETTING = 1
                CALL SET'BOX'ORDER'B
                SETTING = 0
            ENDIF
        ENDIF
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "BILL MODE="+ZONE'REC'SET+" VIA="+VIA'NO+" SET="+SETTING
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
RETURN

SET'ACTUAL'MODE:
        TIME'CSV = "SET'ACTUAL'MODE:" : \TIME'CSV
        WORK'MODE = "A"
        VIA'REC = AVIA'REC
        ZONE'REC = AZONE'REC
        IF ZONE'REC'SET # VIA'NO THEN
            IF SETTING = 0 THEN
                SETTING = 1
                CALL SET'BOX'ORDER'A
                SETTING = 0
            ENDIF
        ENDIF
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "ACT ZONE="+ZONE'REC'SET+" VIA="+VIA'NO+" SET="+SETTING
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
RETURN

MAP1 TCOUNT'DESC,S,72
MAP1 TCOUNT,B,5
MAP1 TCOUNT'ACTIVE,B,1
MAP1 TCOUNT'T1,B,3,TIME

TCOUNT'START:
        PRINT TAB(-1,CR'OFF);
        TCOUNT'ACTIVE = 0
        TCOUNT = 0
RETURN

TCOUNT:
        TCOUNT = TCOUNT + 1
        IF (TIME-TCOUNT'T1) > 3 THEN
                TCOUNT'T1 = TIME
                IF TCOUNT'ACTIVE = 0 THEN
                        TCOUNT'ACTIVE = 1
                        ?TAB(24,1) ; TAB(-1,A'RED) ; TCOUNT'DESC ; ":" ; &
                                                TAB(-1,A'YEL) ; TAB(-1,9) ;
                ENDIF
                ?TAB(24,75) ; TCOUNT;
        ENDIF
RETURN

MAP1 MOVE'MODE,S,1

CREATE'BRECS'FROM'ACTUAL:
        TIME'CSV = "CREATE'BRECS'FROM'ACTUAL:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 RETURN
        MOVE'MODE = "A"
        CALL CREATE'MEM'RECS
RETURN

CREATE'ARECS'FROM'BILLING:
        TIME'CSV = "CREATE'ARECS'FROM'BILLING:" : \TIME'CSV
        IF VIA'SHP'FLAG <= 1 RETURN
        MOVE'MODE = "B"
        CALL CREATE'MEM'RECS
RETURN

CREATE'MEM'RECS:
        TIME'CSV = "CREATE'MEM'RECS:" : \TIME'CSV
        IF WBWHAP # 1 THEN
            IF MOVE'MODE = "A" THEN         !!MOVE'MODE = who we are moving FROM
                TCOUNT'DESC = "Moving actual to billing"
            ELSE
                TCOUNT'DESC = "Moving billing to actual"
            ENDIF
            CALL TCOUNT'START
        ENDIF
        LAST'BNO = 0
        IF WE'HAVE'ARECS = 1 OR MOVE'MODE = "B" THEN
                IF MOVE'MODE = "A" THEN
                        BKEY = "A" + (HDR'VIA'NO USING "#ZZZ")
                ELSE
                        BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ")
                ENDIF
                SBKEY = BKEY
                DO
                        XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                        IF BCTL # 0 EXIT
                        IF BKEY[1;5] # SBKEY EXIT
                        IF WBWHAP # 1 THEN
                            CALL TCOUNT
                        ENDIF
                        IF MOVE'MODE = "A" THEN
                                BTYPE = "B"
                                JJ = HDR'BVIA'NO
                        ELSE
                                BTYPE = "A"
                                JJ = HDR'VIA'NO
                        ENDIF
                        IF INC'AUTOPACK # "Y" THEN
                            BOVERSIZ1 = WGT'OVERSIZ1(BNO)
                            BOVERSIZ2 = WGT'OVERSIZ2(BNO)
                            BOVERSIZ3 = WGT'OVERSIZ3(BNO)
                            BADDCHG = WGT'ADDCHG(BNO)
                            BDIMENSION = WGT'DIMENSION(BNO)
                            IF BOVERSIZ1 = "Y" OR BOVERSIZ2 = "Y" OR &
                                  BOVERSIZ3 = "Y" OR BDIMENSION = "Y" THEN
                                BSWGT = WGT'WGT(BNO)
                            ELSE
                                BSWGT = 0
                            ENDIF
                            BHAZ'MAT = WGT'HAZ'MAT(BNO)
                        ENDIF
                        BKEY[1;5] = BTYPE + (JJ USING "#ZZZ")
                        XCALL VICSIT,7,3,BREC2,BKEY,BPTR,0,BCTL !!USE
                        IF BCTL = 0 THEN
                                XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                        ENDIF
                        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                        LAST'BNO = BNO
                        BKEY = SBKEY + (LAST'BNO USING "#ZZZ")
                LOOP
        ELSE
                BOX'SPACE = SPACE
                BOX'HDR'LOC'NO = HDR'LOC'NO
                BOX'DOC'TYPE = HDR'DOC'TYPE
                BOX'HDR'NO = HDR'NO
                BOX'NO = 1
                BOX'SHIPMENT = HDR'SHIPMENT + 1
                \SETKEY BOX MODE="KEY"
                USE BOX INTO BOX'REC KEY BOX'KEY
                DO
                        GETNXT BOX INTO BOX'REC
                        \CHKKEY BOX
                        IF BOX'CTL # 0 EXIT
                        BXV'KEY = BOX'KEY2
                        USE BXV INTO BOX'REC KEY BXV'KEY !!Actual in BXV file
                                                         !!but used into BOX.
                        IF WBWHAP # 1 THEN
                            CALL TCOUNT
                        ENDIF
                        CALL SET'BREC'FROM'BOX'REC      !!Load BREC fields
                        BOVERSIZ1 = WGT'OVERSIZ1(BNO)
                        BOVERSIZ2 = WGT'OVERSIZ2(BNO)
                        BOVERSIZ3 = WGT'OVERSIZ3(BNO)
                        BADDCHG = WGT'ADDCHG(BNO)
                        BDIMENSION = WGT'DIMENSION(BNO)
                        BHAZ'MAT = WGT'HAZ'MAT(BNO)
                        IF BDIMENSION = "Y" OR BOVERSIZ1 = "Y" OR &
                                BOVERSIZ2 = "Y" OR BOVERSIZ3 = "Y" THEN
                            BSWGT = WGT'WGT(BNO)
                        ELSE
                            BSWGT = 0
                        ENDIF
                        BTYPE = "B"
                        BKEY = "B" + (HDR'BVIA'NO USING "#ZZZ") + &
                                                (BOX'NO USING "#ZZZ")
                        XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
                        LAST'BNO = BNO
                LOOP
        ENDIF
!!Now delete left over stuff
        IF MOVE'MODE = "B" THEN
                BKEY = "A"
        ELSE
                BKEY = "B"
        ENDIF
        BNO = LAST'BNO + 1
        CALL DELETE'REMAINING'BRECS
        IF MOVE'MODE = "A" THEN
                WE'HAVE'BRECS = 1
        ELSE
                WE'HAVE'ARECS = 1
        ENDIF
RETURN

MAP1 GAMES,B,1

SEE'IF'GAMES:
        TIME'CSV = "SEE'IF'GAMES:" : \TIME'CSV
        GAMES = 1
!!Check if different ship via
        IF AVIA'REC # BVIA'REC THEN
            RETURN                   !!KLUDGE
        ENDIF
!!Check if closest loc set and this is not the closest location
        IF HDR'FREE'FRT = "C" OR HDR'FREE'FRT = "O" OR HDR'FREE'FRT = "X" THEN
SEE'IF'GAMES2:
                TIME'CSV = "SEE'IF'GAMES2:" : \TIME'CSV
                CALL FNDLOC
                IF HDR'LOC'NO # ALOC'NO(1)                       AND &
                  (HDR'LOC'NO # ALOC'NO(2)                       OR  &
                   ALOC'ZONE(1) # ALOC'ZONE(2)) THEN
                        RETURN  !!KLUDGE
                ENDIF
        ELSE
!!Check if a zone set that differs from the actual zone
!!This will fail if we have never calculated billing freight ...
        IF HDR'FREE'FRT = "Z" OR HDR'FREE'FRT = "X" THEN
                FOR JJ = 1 TO 7
                   IF BUZ(JJ) # "N" THEN
                       RETURN              !!KLUDGE
                   ENDIF
                NEXT JJ
        ENDIF
        ENDIF
        GAMES = 0                                       !!NO GAMES ...
RETURN

MAP1 SAME,B,1

!!"Same" meaning billing is the same as actual - for this to be true we
!!must be playing no games AND either be autopack or net (non-cash) customer.
!!
!!

SEE'IF'SAME:
        TIME'CSV = "SEE'IF'SAME: INC'AUTOPACK="+INC'AUTOPACK+ &
                 " PSEUDO'CASH'TERMS="+PSEUDO'CASH'TERMS
        \TIME'CSV
!!  IF WBWHAP # 1 THEN
        SAME = 0
        IF INC'AUTOPACK = "N" AND PSEUDO'CASH'TERMS = "Y" THEN
                RETURN                  !!KLUDGE
        ENDIF
        CALL SEE'IF'GAMES
        SAME = 1 - GAMES                !!If games, not same ...
!!  ELSE
!!      SAME = 0
!!  ENDIF
RETURN

MAP1 DEL'BNO,B,2
MAP1 DEL'VIA'NO,B,2

DELETE'REMAINING'BRECS: !!Set BKEY to A or B and BNO to 1st box # to delete.
                        !!OPTIONALY set DEL'VIA'NO ...
        TIME'CSV = "DELETE'REMAINING'BRECS:" : \TIME'CSV
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Deleting boxes from memory"
            CALL TCOUNT'START
        ENDIF
        IF BKEY = "B" THEN
                IF DEL'VIA'NO = 0 THEN
                        DEL'VIA'NO = HDR'BVIA'NO
                ENDIF
        ELSE
                IF DEL'VIA'NO = 0 THEN
                        DEL'VIA'NO = HDR'VIA'NO
                ENDIF
        ENDIF
        BKEY = BKEY + (DEL'VIA'NO USING "#ZZZ")
        DEL'VIA'NO = 0                  !!Clear for next call ...
        DEL'BNO = BNO - 1
        BKEY = BKEY + (DEL'BNO USING "#ZZZ")
        SBKEY = BKEY
        DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
                IF BKEY[1;5] # SBKEY EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                DEL'BNO = BNO
                XCALL VICSIT,7,8,BREC,BKEY,BPTR,0,BCTL !!DELETE
                BKEY = SBKEY + (DEL'BNO USING "#ZZZ")
        LOOP
RETURN

CIF DEBUG = "Y" OR DEBUG # "Y" THEN
MAP1 DUMP'TITLE,S,80
MAP1 SAV'BKEY,S,9

DUMP'IT:
CIF BREC AND NOT BREC THEN
        TIME'CSV = "DUMP'IT:"
        \TIME'CSV
        BKEY = "A" + (HDR'VIA'NO USING "#ZZZ")
        DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
        LOOP

        BKEY = "B" + (HDR'VIA'NO USING "#ZZZ")
        DO
                XCALL VICSIT,7,4,BREC,BKEY,BPTR,0,BCTL !!GETNXT
                IF BCTL # 0 EXIT
        LOOP
ENDCIF

MAP1 XKEY2,S,9
MAP1 XPTR2,X,30
MAP1 XCTL2,B,1
MAP1 XREC'SAVE,X,16

        XREC'SAVE = XREC
        XKEY2 = ""
        DO
            XCALL VICSIT,7,4,XREC,XKEY2,XPTR2,0,XCTL2  !!GETNXT
            IF XCTL2 # 0 EXIT
        LOOP
        XREC = XREC'SAVE
RETURN
ENDCIF

!!below, trying to guess what they are doing - not really possible,
!!but if all free freight I force them to zero.  If don't allow debit,
!!then force <= 0, otherwise force >= 0.

FUDGE'ZERO'BOX:
        TIME'CSV = "FUDGE'ZERO'BOX:" : \TIME'CSV
        CALL SUM'BTOTAL
        IF HDR'FREE'FRT # "A" AND HDR'FREE'FRT # "T" &
                    AND HDR'FREE'FRT # "W" AND HDR'FREE'FRT # "Q" THEN
                IF ARC'INV'DR'YN(HDR'DOC'TYPE) = "N" THEN
                        IF CALC'BTOTAL <= 0 RETURN  !!KLUDGE
                ELSE
                        IF CALC'BTOTAL >= 0 RETURN  !!KLUDGE !!was = 0 (I like this better, either way could be trouble).
                ENDIF
        ELSE
                IF CALC'BTOTAL = 0 RETURN  !!KLUDGE
        ENDIF
        IF BSHP'DISC # 0 THEN
                \SAFACTOR SHP'DISC -
                BSHP'DISC = (BSHP'DISC + CALC'BTOTAL) MAX 0
                \SAFACTOR SHP'DISC
                CALL SUM'BTOTAL
                IF CALC'BTOTAL = 0 RETURN  !!KLUDGE
        ENDIF
        FOR JJ = 1 TO 6
                IF BCD(JJ) # 0 THEN
                        \SAFACTOR CD(JJ) -
                        BCD(JJ) = (BCD(JJ) - CALC'BTOTAL) MIN 0
                        \SAFACTOR CD(JJ)
                        CALL SUM'BTOTAL
                        IF CALC'BTOTAL = 0 RETURN  !!KLUDGE
                ENDIF
        NEXT JJ
        IF BOLD'CR # 0 THEN
                \SAFACTOR OLD'CR -
                BOLD'CR = (BOLD'CR + CALC'BTOTAL) MAX 0
                \SAFACTOR OLD'CR
                CALL SUM'BTOTAL
                IF CALC'BTOTAL = 0 RETURN  !!KLUDGE
        ENDIF
        IF BOLD'CASH # 0 THEN
                \SAFACTOR OLD'CASH -
                BOLD'CASH = (BOLD'CASH + CALC'BTOTAL) MAX 0
                \SAFACTOR OLD'CASH
                CALL SUM'BTOTAL
                IF CALC'BTOTAL = 0 RETURN  !!KLUDGE
        ENDIF
        IF BOLD'DR # 0 THEN
                \SAFACTOR OLD'DR -
                BOLD'DR = (BOLD'DR - CALC'BTOTAL) MAX 0
                \SAFACTOR OLD'DR
                CALL SUM'BTOTAL
                IF CALC'BTOTAL = 0 RETURN  !!KLUDGE
        ENDIF
        IF BSHP'STX1 # 0 THEN
                \SAFACTOR SHP'STX1 -
                BSHP'STX1 = (BSHP'STX1 - CALC'BTOTAL) MAX 0
                \SAFACTOR SHP'STX1
                CALL SUM'BTOTAL
                IF CALC'BTOTAL = 0 RETURN  !!KLUDGE
        ENDIF
        IF BSHP'STX2 # 0 THEN
                \SAFACTOR SHP'STX2 -
                BSHP'STX2 = (BSHP'STX2 - CALC'BTOTAL) MAX 0
                \SAFACTOR SHP'STX2
                CALL SUM'BTOTAL
                IF CALC'BTOTAL = 0 RETURN  !!KLUDGE
        ENDIF
        FOR JJ = 1 TO 7
           IF ZONE'BOX'ORDER(JJ) = "O" THEN
                IF BSHP'VTTL(JJ) # 0 THEN
                        \SAFACTOR SHP'VTTL(JJ) -
                        BSHP'VTTL(JJ) = (BSHP'VTTL(JJ) - CALC'BTOTAL) MAX 0
                        \SAFACTOR SHP'VTTL(JJ)
                        CALL SUM'BTOTAL
                        IF CALC'BTOTAL = 0 RETURN  !!KLUDGE
                ENDIF
           ENDIF
        NEXT JJ
RETURN

MAP1 TTLQTY,B,5
MAP1 WRK'TYP'NO,B,2

RE'PRICE'HDR:
        TIME'CSV = "RE'PRICD'HDR:" : \TIME'CSV
        IF INC'TS'SUBI # 4 THEN
                ENTRY = "Can only do this for cap sub-interface of t-shirts!"
                GOTO DO'ERRL
        ENDIF
        CALL CACHE'LIN          !!Computes DOZENS in dozens
        TTLQTY = ABS(DOZENS)    !!Make it a plus number
        SF = 1
        IF TTLQTY = 0 THEN
                RETURN          !!kludge - no change
        ENDIF
        LIN'KHDR'LOC'NO = HDR'LOC'NO
        LIN'KHDR'NO = HDR'NO
        CALL SET'LINKEY
        IF WBWHAP # 1 THEN
            TCOUNT'DESC = "Re-pricing order"
            CALL TCOUNT'START
        ENDIF
        SLINKEY = LINKEY
        DO
                XCALL VICSIT,7,4,LIN'REC,SLINKEY,LINPTR,0,LIN'PKT !!GETNXT
                \CHKKEY LIN
                IF LIN'CTL # 0 EXIT
                IF WBWHAP # 1 THEN
                    CALL TCOUNT
                ENDIF
                IF INC'USE'CV = "Y" AND LIN'TRK'NO = OC2'TRK'NO REPEAT
                LIN2'REC = LIN'REC
                CALL RE'PRICE'HDR2
                IF LIN2'REC # LIN'REC THEN
                    MAP1 NOPLACE,B,1
                    \SETKEY LIN ALTKEY="LIN2" MODE="KEY"
                    RDLOCK LIN2 INTO NOPLACE KEY LIN2'KEY
                    MEFCHG = 0
                    WRITE LIN2 FROM LIN'REC
                    XCALL VICSIT,7,2,LIN'REC,SLINKEY,LINPTR,0,LIN'PKT !!update or add
                    XCALL VICSIT,7,2,LIN'REC,SLINKEY,LINPTR2,0,LIN'PKT !!update or add
                    SF = 0
                ENDIF
        LOOP
RETURN

!!DOZENS has the UOM we want to price (based on entire order)

RE'PRICE'HDR2:
        TIME'CSV = "RE'PRICE'HDR2:" : \TIME'CSV
        CALL FIND'PRH
        SPR'CTL = 3
        SPR'SPACE = SPACE
        IF CUS'SPR'COUNT # 0 THEN
                SPR'KCUS'NO = HDR'NAM'NO
                IF SPR'SEC'NO # PRH'SEC'NO OR SPR'CTL # 0 THEN
                    SPR'KSEC'NO = PRH'SEC'NO
                    USE SPR INTO SPR'REC KEY SPR'KEY
                ENDIF
                IF SPR'CTL # 0 THEN
                    SPR'KSEC'NO = 0
                    USE SPR INTO SPR'REC KEY SPR'KEY
                ENDIF
        ENDIF
        IF SPR'CTL = 0 THEN
                WRK'TYP'NO = SPR'TYP'NO
        ELSE
                WRK'TYP'NO = HDR'NAM'TYP'NO
        ENDIF
        IF WRK'TYP'NO # TYP'NO THEN
                TYP'KNO = WRK'TYP'NO
                \VUSE TYP
        ENDIF
        IF TYP'BRK'BASE > 0 THEN
                YY = TYP'BRK'BASE
        ELSE
                YY = 0
                FOR II = 1 TO 4
                    IF TTLQTY >= OEC'COLQ(II) THEN
                        YY = II  !!Customer's column
                    ENDIF
                NEXT II
        ENDIF
        YY = (YY MAX 1) MIN 4
        IF LIN'CAP'PCOL = 0 OR (LIN'SHIPMENT = 0 AND LIN'PRV'HDR'NO = 0) THEN
!!if never set on this line or never been shipped (not a BO) and not a split
                LIN'CAP'PCOL = YY
        ELSE
!!this means it is either a backorder (SHIPMENT >=1) or
!!a split (PRV'HDR'NO # 0) - then we set it to the "best case"
                LIN'CAP'PCOL = LIN'CAP'PCOL MAX YY
        ENDIF
!!Note - oe1wga will reset the field to zero if the part number is changed
!!or the location is changed on the line item ... meaning on backorders
!!if you add line items or delete items, the remaining left over line items
!!will still get the good pricing ...
        \COMNET PRE="LIN" SETLIN="Y" WHICH="ORDER"
RETURN

COPYF "HDRCKY",=HDRC2
COPYF "HDRFIL",=HDR2

CHECK'DUPS:
        TIME'CSV = "CHECK'DUPS:" : \TIME'CSV
        SF = 1
        \SETKEY PRE="HDRC" MODE="KEY" ALTKEY="HDRC2"
        HDRC2'KNO = 0
        USE HDRC2 INTO HDR2'REC KEY HDRC2'KEY
        DO
                GETNXT HDRC2 INTO HDR2'REC
                IF HDRC2'CTL = 0 AND HDRC2'RCN = HDR'RCN THEN
                    GETNXT HDRC2 INTO HDR2'REC
                ENDIF
                \CHKKEY PRE="HDRC" ALTKEY="HDRC2" LASTFIX="NAM'NO"
                IF HDRC2'CTL = 0 CALL CHECK'DUPS2
        LOOP UNTIL SF = 0 OR HDRC2'CTL # 0
        IF SF = 1 THEN
                HHSD'KNAM'NO = HDR'NAM'NO
                HHSD'KSHIP'DTT = DATE
                HHSD'KLOC'NO = -1
                HHSD'KDOC'TYPE = -1
                HHSD'KNO = -1
                USE HHSD INTO HDR2'REC KEY HHSD'KEY
                DO
                    GETPRV HDRC2 INTO HDR2'REC
                    \CHKKEY PRE="HHSD" ALTPRE="HDR2" LASTFIX="NAM'NO"
                    \CNV'DTT HDR2'SHIP'DTT YDAYS
                    \CNV'DTT HDR2'MAN'DTT YY
                    YDAYS = YDAYS MAX YY        !!Latest date
                    IF (TODAY - YDAYS) > OEC'DUP'DAYS THEN
                        HHSD'CTL = 1
                    ENDIF
                    IF HHSD'CTL = 0 CALL CHECK'DUPS2
                LOOP UNTIL SF = 0 OR HHSD'CTL # 0
        ENDIF
        IF SF = 0 THEN              !!We found a duplicate
                ENTRY = "Duplicate "
                \KERROR HDR ALTPRE="HDR2" MODE="D" CNO="N"
                ENTRY = ENTRY + " found, 'Y' to check, 'N' to continue:"
                \L24CHR CLR="Y"
                IF INX1 # I'RT OR UCS(ENTRY) # "N" THEN
                    INX2 = FN'W     !!Go back to the header ...
                    GOTO ABORT
                ENDIF
        ENDIF
RETURN

!!OEC'DUPS <=1  don't check (so never even called check'dups)
!!          =2  check with "easy" rules of oe1hdr
!!          =3  check with crazy rules used by Otto
!!

CHECK'DUPS2:
        TIME'CSV = "CHECK'DUPS2:" : \TIME'CSV
        SF = 0
        IF HDR'QUOTE'YN # HDR2'QUOTE'YN AND OEC'CQUOTE'YN # "Y" SF = 1
        IF HDR'GL'CNO # HDR2'GL'CNO AND OEC'CGL'CNO # "Y" SF = 1
        IF HDR'SHIP'TO # HDR2'SHIP'TO AND OEC'CSHIP'TO # "Y" SF = 1
        IF HDR'BO'YN # HDR2'BO'YN AND OEC'CBO'YN # "Y" SF = 1
        IF HDR'SHP'NO # HDR2'SHP'NO AND OEC'CSHP'NO # "Y" SF = 1
        IF HDR'TRH'NO # HDR2'TRH'NO AND OEC'CTRH'NO # "Y" SF = 1
        IF HDR'VIA'NO # HDR2'VIA'NO AND OEC'CVIA'NO # "Y" SF = 1
        IF HDR'FOB'NO # HDR2'FOB'NO AND OEC'CFOB'NO # "Y" SF = 1
        IF HDR'PO # HDR2'PO AND OEC'CPO # "Y" SF = 1
        IF HDR'HOLD'YN # HDR2'HOLD'YN AND OEC'CHOLD'YN # "Y" SF = 1
        IF HDR'PRI'NO1 # HDR2'PRI'NO1 AND OEC'CPRI'NO1 # "Y" SF = 1
        IF HDR'PRI'NO2 # HDR2'PRI'NO2 AND OEC'CPRI'NO2 # "Y" SF = 1
        IF HDR'ORDER'DTT # HDR2'ORDER'DTT AND OEC'CORDER'DTT # "Y" SF = 1
        IF HDR'PROM'DTT # HDR2'PROM'DTT AND OEC'CPROM'DTT # "Y" SF = 1
        IF HDR'CRID # HDR2'CRID AND OEC'CCRID # "Y" SF = 1
        IF HDR'NAM'TYP'NO # HDR2'NAM'TYP'NO AND OEC'CNAM'TYPNO # "Y" SF = 1
        IF HDR'PROC # HDR2'PROC AND OEC'CPROC # "Y" SF = 1
        IF HDR'PROC < 5 AND HDR2'PROC >= 5 THEN SF = 1
        IF HDR'PROC >= 5 AND HDR2'PROC < 5 THEN SF = 1
        IF HDR'CMG'NO # HDR2'CMG'NO AND OEC'CCMG'NO # "Y" SF = 1
        IF HDR'MSGNO # HDR2'MSGNO AND OEC'CMSGNO # "Y" SF = 1
        IF SF = 0 AND OEC'DUPS = 3 THEN !!So far OK ...
                IF HDR'LIN'COUNT # HDR2'LIN'COUNT THEN SF = 1
                IF HDR'LIN'TOTAL # HDR2'LIN'TOTAL THEN SF = 1
        ENDIF
RETURN

LOGIT:
    IF DIM'DEBUG = "Y" THEN
        ENTRY = "BNO="+BNO+" "+ENTRY
        \ABLOGGER ENTRY """/debug/dim_debug.txt"""
    ENDIF
    IF INSTR(1,ENTRY,STR(HDR'NO)) = 0 THEN
        ENTRY = ENTRY + " NO="+STR(HDR'NO)
    ENDIF
    CALL DO'EXCUSE'LOG
    ENTRY = ""
RETURN

E'OS1'YN:
    IF WGT'OS1'YN = "Y" THEN
        WGT'OS2'YN = "N"
        \GAFR PACK10 AFR="X:WGT'OS2'YN+X:WGT'OS3'YN"
    ELSE
        \GAFR PACK10 AFR="E:WGT'OS2'YN+E:WGT'OS3'YN"
    ENDIF
RETURN

E'OS2'YN:
    IF WGT'OS2'YN = "Y" THEN
        WGT'OS3'YN = "N"
        \GAFR PACK10 AFR="X:WGT'OS3'YN"
    ELSE
        \GAFR PACK10 AFR="E:WGT'OS3'YN"
    ENDIF
RETURN

MAP1 FRTITM,B,1

GET'FREEBE:    !!Finds out if part is free, if yes, FREEBE="Y"
    TIME'CSV = "GET'FREEBE:" : \TIME'CSV
    IF HDR'FREE'FRT = "Y" OR HDR'FREE'FRT = "A" THEN
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "HDR'FREE'FRT="+HDR'FREE'FRT+" so FREEBE=Y"
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        FREEBE = "Y"
        RETURN                        !!KLUDGE
    ELSE
    IF HDR'FREE'FRT = "N" THEN
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "HDR'FREE'FRT = "+HDR'FREE'FRT+" so FREEBE=N"
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        FREEBE = "N"
        RETURN                        !!KLUDGE
    ENDIF
    ENDIF
    IF EXEMPT'CNT > 0 THEN
        FOR BB = 1 TO EXEMPT'CNT
            IF MEA'TRK'NO = EXEMPT'TRK'NO(BB) THEN
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "EXEMPT CNT= "+EXEMPT'CNT+" TRK'NO="+EXEMPT'TRK'NO(BB)+" so FREEBE=N"
                    CALL DO'EXCUSE'LOG
                    ENTRY = SENTRY
                ENDIF
                FREEBE = "N"
                RETURN
            ENDIF
        NEXT BB
    ENDIF
    CASE
    IF DOING'FFP = 2 THEN
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "DOING'FFP=2 so no FF"
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        FREEBE = "N"
        RETURN                        !!KLUDGE
    ELSE
    IF DOING'FFP = 1 THEN
        IF IN2'SUV = "Y" THEN
            IF USING'FFL = 0 AND (FFP'CFREE'CUT(1) > 0 OR FFP'NFREE'CUT(1) > 0 OR &
                                                FFP'WFREE'CUT(1) > 0) THEN
                FRTITM = FFP'SC'FREE'ON
            ELSE
                CALL SET'FRTITM
            ENDIF
        ELSE
            FRTITM = FFP'SC'FREE'ON
        ENDIF
    ELSE
        FRTITM = CUS'FRTITM'YN
    ENDCASE
    FREEBE = "N"
    IF LIN'QFREE'FRT = "Y" THEN
        FREEBE = "Y"    !!Splits?
    ELSE
        CALL FIND'MEA
        CALL SET'FREEFRT'BIT
        FOR BB = 0 TO 7
            \TSTBIT FRTITM (2^BB) VAR="SF"
            IF SF # 0 THEN    !!bit is set in the CUS/FFP
                \TSTBIT FREEFRT'BIT (2^BB) VAR="SF"
                IF SF # 0 THEN
                    FREEBE = "Y"
                    BB = 20
                ENDIF
            ENDIF
        NEXT BB
    ENDIF
    IF DO'EXCUSE = 1 THEN
        SAV'ENTRY = ENTRY
        ENTRY = "Line="+LIN'NO+" Customer FF="+ &
                CUS'FRTITM'YN+" Part FF="+MEA'FREEFRT'YN+ &
                " FFP="+STR(DOING'FFP)+"-"+STR(FRTITM)+&
                " Free="+FREEBE
        CALL DO'EXCUSE'LOG
        ENTRY = SAV'ENTRY
    ENDIF
    TIME'CSV = "GET'FREEBE: END" : \TIME'CSV
RETURN

MAP1 LAST'LINKEY,S,40
MAP1 LINKEY2,S,40
MAP1 SPLITKEY2,S,40
MAP1 LAST'FRTITM,B,1
COPYF "MEAFIL[IN]",=MEA2,NOAFR
MAP1 BITTOP,B,1
MAP1 ANYQ,B,1

MAP1 FRTITM'CNT,F

SET'FRTITM:     !!What qualifies by item (mea)
    TIME'CSV = "SET'FRTITM: cnt="+FRTITM'CNT : \TIME'CSV

    LINKEY2 = (HDR'LOC'NO USING "#ZZZ") + (HDR'NO USING "#ZZZZZZ")

!!FRTITM'CNT = FRTITM'CNT + 1
!!IF FRTITM'CNT = 880 OR FRTITM'CNT = 890 THEN
!!    CALL DUMP'LINKEY'CACHE2             !!DUMP LINKEY CACHE RECORDS
!!ENDIF
!!LINKEY2 = (HDR'LOC'NO USING "#ZZZ") + (HDR'NO USING "#ZZZZZZ") !!del later

    IF LAST'LINKEY = LINKEY2 OR &
         (SPLITTING = 0 AND SPLITKEY2 # "" AND IN2'SUV = "Y" AND &
                                            SPLITKEY2 = LAST'LINKEY) THEN
        FRTITM = LAST'FRTITM
        IF IN2'SUV # "Y" RETURN            !!KLUDGE (not wild system)
        IF FFP'CFREE'CUT(1) = 0 AND FFP'NFREE'CUT(1) = 0 AND &
                   FFP'WFREE'CUT(1) = 0 RETURN !!KLUDGE (no cutoffs to check)
        IF (HDR'FREE'FRT # "" AND DO'FREE'FRT # 1) RETURN !!KLUDGE (manual)
    ENDIF

    ANYQ = 0
    MEA2'REC = MEA'REC
    LIN2'REC = LIN'REC
    QUAL'SUM'SPACE = SPACE
    IF WBWHAP # 1 THEN
        TCOUNT'DESC = "Re-total the order for free freight1"
        CALL TCOUNT'START
    ENDIF
    LINKEY2 = (LIN'KHDR'LOC'NO USING "#ZZZ") + &
                 (LIN'KHDR'NO USING "#ZZZZZZ")
    LIN'USED'SPACE = SPACE
    DO
        XCALL VICSIT,7,4,LIN'REC,LINKEY2,LINPTR,0,LIN2'PKT !!GETNXT
        IF LIN2'CTL # 0 EXIT
        IF LIN'HDR'LOC'NO # HDR'LOC'NO EXIT
        IF LIN'HDR'NO # HDR'NO EXIT
        IF LIN'QFREE'FRT = "Y" THEN ANYQ = 1
        IF WBWHAP # 1 THEN
            CALL TCOUNT
        ENDIF
        IF LIN'USED(LIN'NO) # 0 THEN
            REPEAT
        ENDIF
        LIN'USED(LIN'NO) = 1
        CALL FIND'MEA        !!Does FIND'PRH for us
        CALL SET'FREEFRT'BIT
        FOR BB = 0 TO BITTOP
            \TSTBIT FFP'SC'QUAL'FF (2^BB) VAR="SF"
            IF SF # 0 THEN
                \TSTBIT FREEFRT'BIT (2^BB) VAR="SF"
                IF SF # 0 THEN
                    QUAL'SUM(BB+1) = QUAL'SUM(BB+1) + ABS(LIN'NET)
                    IF DO'EXCUSE = 1 THEN
                        SAV'ENTRY = ENTRY
                        ENTRY = "QUAL SUM="+QUAL'SUM(BB+1)+" LN="+LIN'NET
                        CALL DO'EXCUSE'LOG
                        ENTRY = SAV'ENTRY
                    ENDIF
                ENDIF
            ENDIF
        NEXT BB
    LOOP
!!If they get charge zero dollars then they won't get free freight.
    FRTITM = 0
    \TSTBIT ORG'BIT'FLAG 1 VAR="SF"
                        !!Not from a multi location split order.
    IF DO'EXCUSE = 1 THEN
        SAV'ENTRY = ENTRY
        ENTRY = "SPLIT="+SPLITTING+" SF="+SF+" ANY="+ANYQ
        CALL DO'EXCUSE'LOG
        ENTRY = SAV'ENTRY
    ENDIF
    IF (IN2'SUV # "Y" OR SPLITTING = 1) OR (IN2'SUV = "Y" AND SPLITTING = 0 AND &
                    SF = 0) THEN
        FOR BB = 0 TO (BITTOP-1)
            IF QUAL'SUM(BB+1) >= IN2'CUTOFF(BB+1) AND IN2'CUTOFF(BB+1) > 0 THEN
                \SETBIT FRTITM (2^BB)
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "1) QUALS="+QUAL'SUM(BB+1)+" IN2="+IN2'CUTOFF(BB+1)+" FRT="+FRTITM+" BB="+BB
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
            ENDIF
        NEXT BB
        LAST'FRTITM = FRTITM
    ELSE
        IF ANYQ = 0 THEN
            FRTITM = 0
        ELSE
            FOR BB = 0 TO (BITTOP-1)
                QUAL'SUM(1) = QUAL'SUM(1) + QUAL'SUM(BB+1)
                !!QUAL'SUM(1) is the total of the qualifying items
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "2) QUALS="+QUAL'SUM(1)+" BB="+BB
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
            NEXT BB
            TIME'CSV = "SET'FRTITM: #3" : \TIME'CSV
            FOR JJ = 3 TO 1 STEP -1
                IF FFP'FREE'FRT(JJ) = "" THEN
                    FFP'FREE'FRT(JJ) = "N"
                ENDIF
                IF FFP'FREE'FRT(JJ) # "N" THEN      !!Check only if not 'N'
                                !!NOT MANUAL ENTRY, so check cutoff
                    CASE
                    IF HDR'CRID = "WBWHAP" THEN
                        FREE'CUT = FFP'WFREE'CUT(JJ)
                    ELSE
                    IF PSEUDO'CASH'TERMS = "Y" THEN
                        FREE'CUT = FFP'CFREE'CUT(JJ)
                    ELSE
                        FREE'CUT = FFP'NFREE'CUT(JJ)
                    ENDCASE
                ENDIF
            NEXT JJ
            IF QUAL'SUM(1) >= FREE'CUT THEN
                FRTITM = LAST'FRTITM
            ELSE
                LINKEY2 = (HDR'LOC'NO USING "#ZZZ") + (HDR'NO USING "#ZZZZZZ")
                IF WBWHAP # 1 THEN
                    TCOUNT'DESC = "Clearing free freight items"
                    CALL TCOUNT'START
                ENDIF
                DO
                    XCALL VICSIT,7,4,LIN'REC,LINKEY2,LINPTR,0,LIN2'PKT !!GETNXT
                    IF LIN2'CTL # 0 EXIT
                    IF LIN'HDR'LOC'NO # HDR'LOC'NO EXIT
                    IF LIN'HDR'NO # HDR'NO EXIT
                    IF WBWHAP # 1 THEN
                        CALL TCOUNT
                    ENDIF
                    IF LIN'QFREE'FRT = "Y" THEN
                        LIN'QFREE'FRT = "N"
                        XCALL VICSIT,7,2,LIN'REC,LINKEY2,LINPTR,0,LIN'PKT !!ADD/UPDATE
                        XCALL VICSIT,7,2,LIN'REC,LINKEY2,LINPTR2,0,LIN'PKT !!ADD/UPDATE
                        \SETKEY LIN MODE="KEY"
                        RDLOCK LIN INTO LIN'REC KEY LIN'KEY
                        IF LIN'CTL = 0 THEN
                            LIN'QFREE'FRT = "N"
                            WRITE LIN FROM LIN'REC
                        ENDIF
                    ENDIF
                LOOP
            ENDIF
        ENDIF
    ENDIF
    LAST'LINKEY = LINKEY
    MEA'REC = MEA2'REC
    LIN'REC = LIN2'REC
    TIME'CSV   = "SET'FRTITM: END" : \TIME'CSV
RETURN

DSP'BITS:
    TIME'CSV = "DSP'BITS:" : \TIME'CSV
    \TSTBIT HDR'MAN'FLAG 2 VAR="SF"    !!Cash
    IF SF = 0 THEN
        ? TAB(11,40);"*";
    ELSE
        ? TAB(11,40);" ";
    ENDIF
    \TSTBIT HDR'MAN'FLAG 4 VAR="SF"    !!CR
    IF SF = 0 THEN
        ? TAB(13,40);"*";
    ELSE
        ? TAB(13,40);" ";
    ENDIF
    \TSTBIT HDR'MAN'FLAG 8 VAR="SF"    !!DR
    IF SF = 0 THEN
        ? TAB(12,40);"*";
    ELSE
        ? TAB(12,40);" ";
    ENDIF
    \TSTBIT HDR'MAN'FLAG 16 VAR="SF"    !!charges
    IF SF = 0 THEN
        ? TAB(14,40);"*";
    ELSE
        ? TAB(14,40);" ";
    ENDIF
    \TSTBIT HDR'BIT'FLAG 32 VAR="SF"    !!free frt profile (FFP)
    IF DO'EXCUSE = 1 THEN
        SAV'ENTRY = ENTRY
        ENTRY = "TEST SCREEN BIT FFP="+SF+" BIT'F="+HDR'BIT'FLAG
        CALL DO'EXCUSE'LOG
        ENTRY = SAV'ENTRY
    ENDIF
    IF SF # 0 THEN            !!This darn flag is backwards of all others
        ? TAB(8,4);"*";
    ELSE
        ? TAB(8,4);" ";
    ENDIF
    \TSTBIT HDR'MAN'FLAG 32 VAR="SF"    !!free frt
    IF SF = 0 THEN
        ? TAB(9,4);"*";
    ELSE
        ? TAB(9,4);" ";
    ENDIF
    \TSTBIT HDR'MAN'FLAG 128 VAR="SF"    !!free frt
    IF SF = 0 THEN
        ? TAB(19,40);"*";
    ELSE
        ? TAB(19,40);" ";
    ENDIF
    IF OC2'RS'BUCKET # 0 THEN
        \TSTBIT HDR'BIT'FLAG 8 VAR="SF"    !!restock
        IF SF = 0 THEN
            ?TAB(13+OC2'RS'BUCKET,40);"*";
        ELSE
            ?TAB(13+OC2'RS'BUCKET,40);"*";
        ENDIF
    ENDIF
    \TSTBIT ORG'BIT'FLAG 1 VAR="SF"
    IF SF # 0 THEN                  !!From a multi location split order.
        ? TAB(4,1);TAB(-1,A'RED);"Split Order";TAB(-1,A'CYAN);
    ENDIF
RETURN

LCL1 CUS'FFP'RANK,B,1
CHECK'FOR'WB'FF:
    TIME'CSV = "CHECK'FOR'WB'FF:" : \TIME'CSV
    IF IN2'SUV # "Y" AND HDR'CRID = "WBWHAP" THEN  !!Not for additive free freight
        IF WBC'FFP'NO # 0 THEN
            IF DO'EXCUSE = 1 THEN
                SAV'ENTRY = ENTRY
                ENTRY = "WBC FFP: "+WBC'FFP'NO+" CRID: "+HDR'CRID+" CUS'FFP'NO: "+CUS'FFP'NO
                CALL DO'EXCUSE'LOG
                ENTRY = SAV'ENTRY
            ENDIF
            IF CUS'FFP'NO # 0 THEN
                FFP'KNO = CUS'FFP'NO
                \VUSE FFP
                IF FFP'CTL = 0 THEN
                    CUS'FFP'RANK = FFP'RANK
                    FFP'KNO = WBC'FFP'NO
                    \VUSE FFP
                    IF DO'EXCUSE = 1 THEN
                        SAV'ENTRY = ENTRY
                        ENTRY = "Cus Rank "+CUS'FFP'RANK+" WB Rank "+FFP'RANK
                        CALL DO'EXCUSE'LOG
                        ENTRY = SAV'ENTRY
                    ENDIF
                    IF FFP'CTL = 0 THEN
                        IF FFP'RANK < CUS'FFP'RANK THEN
                            CUS'FFP'NO = WBC'FFP'NO
                            IF DO'EXCUSE = 1 THEN
                                SAV'ENTRY = ENTRY
                                ENTRY = "Setting FFP to WB Control FFP "+ WBC'FFP'NO
                                CALL DO'EXCUSE'LOG
                                ENTRY = SAV'ENTRY
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ELSE
                CUS'FFP'NO = WBC'FFP'NO
            ENDIF
        ENDIF
        IF HDR'SUB'NO > 0 THEN
            WCSS'KSUB'NO = HDR'SUB'NO
            USE WCSS INTO WCS'REC KEY WCSS'KEY
!!Note: this only works for ezid numbers > 10 (i.e. actual WEB customers)
            IF WCSS'CTL = 0 AND WCS'FFP'NO # 0 THEN
                IF DO'EXCUSE = 1 THEN
                    SAV'ENTRY = ENTRY
                    ENTRY = "WCS'FFP: "+WCS'FFP'NO+" CRID: "+HDR'CRID+" CUS'FFP'NO: "+CUS'FFP'NO
                    CALL DO'EXCUSE'LOG
                    ENTRY = SAV'ENTRY
                ENDIF
                IF CUS'FFP'NO # 0 THEN
                    FFP'KNO = CUS'FFP'NO
                    \VUSE FFP
                    IF FFP'CTL = 0 THEN
                        CUS'FFP'RANK = FFP'RANK
                        FFP'KNO = WCS'FFP'NO
                        \VUSE FFP
                        IF DO'EXCUSE = 1 THEN
                            SAV'ENTRY = ENTRY
                            ENTRY = "Cus Rank "+CUS'FFP'RANK+" WCS Rank "+FFP'RANK
                            CALL DO'EXCUSE'LOG
                            ENTRY = SAV'ENTRY
                        ENDIF
                        IF FFP'CTL = 0 THEN
                            IF FFP'RANK < CUS'FFP'RANK THEN
                                CUS'FFP'NO = WCS'FFP'NO
                                IF DO'EXCUSE = 1 THEN
                                    SAV'ENTRY = ENTRY
                                    ENTRY = "Setting FFP to WCS record FFP "+ WCS'FFP'NO
                                    CALL DO'EXCUSE'LOG
                                    ENTRY = SAV'ENTRY
                                ENDIF
                            ENDIF
                        ENDIF
                    ENDIF
                ELSE
                    CUS'FFP'NO = WCS'FFP'NO
                ENDIF
            ENDIF
        ENDIF
    ENDIF
RETURN

SET'LST'FROM'TAD:
    TIME'CSV = "SET'LST'FROM'TAD:" : \TIME'CSV
    LST'SPACE = SPACE
    LST'LAB'YN = "N"
    LST'NO = HDR'NAM'NO
    LST'COMPANY = TAD'COMPANY
    LST'LAST = TAD'NAME
    LST'ADDR1 = TAD'ADDR1
    LST'ADDR2 = TAD'ADDR2
    LST'CITY = TAD'CITY
    LST'ST = TAD'ST
    LST'ZIP = TAD'ZIP
    LST'COUNTRY = TAD'COUNTRY
    IF TAD'RES'YN # "Y" THEN TAD'RES'YN = "N"
    LST'RES'YN = TAD'RES'YN
    LST'PHONE1 = TAD'PHONE
RETURN

USE'LST'BILL:
    TIME'CSV = "USE'LST'BILL:" : \TIME'CSV
    \USELST HDR'NAM'NO
    TAD'KBS = "B"
    TAD'KHDR'LOC'NO = HDR'LOC'NO
    TAD'KDOC'TYPE = HDR'DOC'TYPE
    TAD'KHDR'NO = HDR'NO
    USE TAD INTO TAD'REC KEY TAD'KEY
    IF TAD'CTL # 0 THEN
        TAD'KBS = "S"
        USE TAD INTO TAD'REC KEY TAD'KEY
        IF TAD'BOTH'YN # "Y" THEN TAD'CTL = 1
    ENDIF
    IF TAD'CTL = 0 THEN
        CALL SET'LST'FROM'TAD
    ENDIF
    BILL'REC = LST'REC
RETURN

USE'LST'SHIP:
    TIME'CSV = "USE'LST'SHIP:" : \TIME'CSV
    IF HDR'DROP'YN = "Y" THEN
        \USELST HDR'SHP'NO ALTFLD="HDR'SHIP'TO"
    ELSE
        \USELST HDR'NAM'NO ALTFLD="HDR'SHIP'TO"
    ENDIF
    TAD'KBS = "S"
    TAD'KHDR'LOC'NO = HDR'LOC'NO
    TAD'KDOC'TYPE = HDR'DOC'TYPE
    TAD'KHDR'NO = HDR'NO
    USE TAD INTO TAD'REC KEY TAD'KEY
    IF TAD'CTL # 0 THEN
        TAD'KBS = "B"
        USE TAD INTO TAD'REC KEY TAD'KEY
    ENDIF
    IF TAD'CTL = 0 THEN
        CALL SET'LST'FROM'TAD
    ENDIF
RETURN

COPY'TAD:
    TIME'CSV = "COPY'TAD:" : \TIME'CSV
    TAD'KBS = "B"
    TAD'KHDR'LOC'NO = FIRST'LOC'NO
    TAD'KDOC'TYPE = HDR'DOC'TYPE
    TAD'KHDR'NO = FIRST'HDR'NO
    USE TAD INTO TAD'REC KEY TAD'KEY
    IF TAD'CTL = 0 THEN
        TAD'HDR'LOC'NO = HDR'LOC'NO
        TAD'HDR'NO = HDR'NO
        \SETKEY TAD MODE="KEY" APID="OE"
        ADDL TAD FROM TAD'REC KEY TAD'KEY
        IF TAD'CTL = 0 THEN
            \SETKEY TAD MODE="KY2" APID="OE"
            \ADDKEY TAD MODE="KY2" APID="OE"
            REL TAD
        ENDIF
    ENDIF
    TAD'KBS = "S"
    USE TAD INTO TAD'REC KEY TAD'KEY
    IF TAD'CTL = 0 THEN
        TAD'HDR'LOC'NO = HDR'LOC'NO
        TAD'HDR'NO = HDR'NO
        \SETKEY TAD MODE="KEY" APID="OE"
        ADDL TAD FROM TAD'REC KEY TAD'KEY
        IF TAD'CTL = 0 THEN
            \SETKEY TAD MODE="KY2" APID="OE"
            \ADDKEY TAD MODE="KY2" APID="OE"
            REL TAD
        ENDIF
    ENDIF
RETURN

MAP1 SPLIT'LOC,S,1
MAP1 SPLIT'LOC'NO,B,2

SET'SPLIT'LOC:            !!Preserves LOC'REC and makes sure it is Y or N
    TIME'CSV = "SET'SPLIT'LOC:" : \TIME'CSV

!!If this is a Mill Direct Order and Header Location and Line Location are
!!both greater than location 1 then do not allow split order.
!!

    IF BOUNCE'LOC'NO = LIN'LOC'NO THEN
        SPLIT'LOC = "N"
    ELSE
        SPLIT'LOC'NO = LOC'NO
        SPLIT'LOC = "Y"
        LOC'KNO = LIN'LOC'NO
        \VUSE LOC
        IF LOC'SPLIT = "N" THEN
            SPLIT'LOC = "N"
        ENDIF
        LOC'KNO = SPLIT'LOC'NO
        \VUSE LOC
    ENDIF
RETURN

OEPACK'ERTRAP:
    TIME'CSV = "OEPACK'ERTRAP:" : \TIME'CSV
    IF WBWHAP # 0 AND ERR(0) = 1 THEN
        ENTRY = "Timeout during packing: ("+TOTALS'ONLY+")"
        \ABLOGGER ENTRY
        CALL DO'ERR'OEPACKL
        RESUME CMNRTN
    ENDIF
    GOTO ERTRAP
RETURN

TRANSIT'ERROR:
!!The control record can be changed automatically back to "Y" by setting up
!!a cron job to run up1ups
    TIME'CSV = "TRANSIT'ERROR:" : \TIME'CSV
    IF ERR(0) # 1 GOTO OEPACK'ERTRAP
    RDLOCK UPC UPC'RCN INTO UPC'REC
    UPC'CHK'UPSONL = "N"
    WRITE UPC FROM UPC'REC
    ENTRY = "WARNING: time in transit temporarily disabled!"
    CALL DO'ERR
    RESUME TRANSIT'RESUME
RETURN

MAP1 DASPTR,X,30

CALC'DAS'AMT:
    TIME'CSV = "CALC'DAS'AMT:" : \TIME'CSV
    RETURN                        !!Malvern - we don't do DAS in VICS
    IF TBL'RURAL'CHK = "Y" THEN
        IF UB'CNO # UPC'RCN THEN
            \READCTL APP="UP" GL="N"
        ENDIF
!!Remote Extended
        IF SHIP'COUNTRY = "USA" OR SHIP'COUNTRY = "US" THEN
            IF SHIP'ST = "AK" OR SHIP'ST = "HI" THEN
                DAS'SPACE = SPACE
                DAS'KTYPE = "R"
                DAS'KZIP = HDR'SHP'ZIP[1;5]
                \VUSE DAS
                IF DAS'CTL = 0 THEN
                    CALL ADD'ON'DAS
                ENDIF
            ELSE
!!Delivery Area Surcharge
                DAS'SPACE = SPACE
                DAS'KTYPE = "D"
                DAS'KZIP = HDR'SHP'ZIP[1;5]
                \VUSE DAS
                IF DAS'CTL = 0 THEN
                    CALL ADD'ON'DAS
                ELSE
!!Extended Delivery Area Surcharge
                    DAS'SPACE = SPACE
                    DAS'KTYPE = "E"
                    DAS'KZIP = HDR'SHP'ZIP[1;5]
                    \VUSE DAS
                    IF DAS'CTL = 0 THEN
                        CALL ADD'ON'DAS
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDIF
RETURN

ADD'ON'DAS:
    TIME'CSV = "ADD'ON'DAS:" : \TIME'CSV
    VIA'KNO = HDR'VIA'NO
    CALL GET'VIA
    RETURN                    !!Malvern

CIF MALVERN AND NOT MALVERN
    IF VIA'CTL = 0 THEN

        CASE
!!UPS 100 Weight
        IF VIA'MTYPE = "U" AND (VIA'MAN'YN = "H" OR &
                VIA'MAN'YN = "1" OR VIA'MAN'YN = "2" OR &
                VIA'MAN'YN = "3" OR VIA'MAN'YN = "F" OR &
                VIA'MAN'YN = "X" OR VIA'MAN'YN = "Y" OR &
                VIA'MAN'YN = "Z") THEN
            IF COMPUTE'BOX'CNT = 1 THEN !!per shipment charge
                IF HDR'SHP'TOTAL < 0 THEN
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT - DAS'HUND'WGT
                ELSE
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT + DAS'HUND'WGT
                ENDIF
            ENDIF
        ELSE
!!Fedex Ground
        IF VIA'MTYPE = "F" AND (VIA'MAN'YN = "C" OR &
                VIA'MAN'YN = "H" OR VIA'MAN'YN = "E") THEN
            IF HDR'RES'YN = "Y" THEN
                IF HDR'SHP'TOTAL < 0 THEN
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT - DAS'RES'RATE
                ELSE
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT + DAS'RES'RATE
                ENDIF
            ELSE
                IF HDR'SHP'TOTAL < 0 THEN
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT - DAS'COMM'RATE
                ELSE
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT + DAS'COMM'RATE
                ENDIF
            ENDIF
        ELSE
!!Fedex Air
        IF VIA'MTYPE = "F" AND (VIA'MAN'YN = "A" OR  &
                VIA'MAN'YN = "B" OR VIA'MAN'YN = "D" OR &
                VIA'MAN'YN = "F" OR VIA'MAN'YN = "G" OR &
                VIA'MAN'YN = "I") THEN
            IF HDR'RES'YN = "Y" THEN
                IF HDR'SHP'TOTAL < 0 THEN
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT - DAS'AIR'RES
                ELSE
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT + DAS'AIR'RES
                ENDIF
            ELSE
                IF HDR'SHP'TOTAL < 0 THEN
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT - DAS'AIR'COMM
                ELSE
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT + DAS'AIR'COMM
                ENDIF
            ENDIF
        ELSE
!!UPS Ground
        IF VIA'MTYPE = "U" AND VIA'MAN'YN = "C" THEN
            IF HDR'RES'YN = "Y" THEN
                IF HDR'SHP'TOTAL < 0 THEN
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT - DAS'RES'RATE
                ELSE
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT + DAS'RES'RATE
                ENDIF
            ELSE
                IF HDR'SHP'TOTAL < 0 THEN
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT - DAS'COMM'RATE
                ELSE
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT + DAS'COMM'RATE
                ENDIF
            ENDIF
!!UPS Air
        ELSE
        IF VIA'MTYPE = "U" AND (VIA'MAN'YN = "A" OR &
                VIA'MAN'YN = "S" OR VIA'MAN'YN = "R" OR &
                VIA'MAN'YN = "L" OR VIA'MAN'YN = "E") THEN
            IF HDR'RES'YN = "Y" THEN
                IF HDR'SHP'TOTAL < 0 THEN
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT - DAS'AIR'RES
                ELSE
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT + DAS'AIR'RES
                ENDIF
            ELSE
                IF HDR'SHP'TOTAL < 0 THEN
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT - DAS'AIR'COMM
                ELSE
!!Malvern           CALC'TBL'AMT = CALC'TBL'AMT + DAS'AIR'COMM
                ENDIF
            ENDIF
        ENDCASE
    ENDIF
ENDCIF    !!Malvern remove code
RETURN

COPY "ZONECA[OE]"    !Canada zip/zones for Standard Ground
!!COPY "FEDEX",WANT'RR="Y",WANT'PKG="Y",ERR'CALL="DO'ERR",ABORT'CALL="ABORT"
!!ERR'CALL might need changing when rate shopping is added.  ABORT'CALL same thing.
COPY "ENDICIA",WANT'RATE="Y",ERR'CALL="DO'ERR",ABORT'CALL="ABORT",RATE'SHOPPING="RATE'SHOPPING",TIME'WANTED="ETIME",RESPONSE'NAME="RESPONSE'NAME"
COPY "ADRCHK[OE]",VIA'ENTRY="SHIPPING'ENTRY",ADDRESS'ENTRY="ADDRESS'ENTRY",PRE="HDR"

CIF USE AND NOT USE    !!This is how OE1SHP pulls in FEDEX.CPY
    COPY "FEDEX",WANT'RR="Y",WANT'PKG="Y",ERR'CALL="DO'ERR",ABORT'CALL="FEDEX'USER'ABORT",RATE'SHOPPING="RATE'SHOPPING",TIME'WANTED="ETIME",RESPONSE'NAME="RESPONSE'NAME"
ENDCIF

E'FFP'NO:
    IF INX2 = FN'7 AND ECFLD = lastfn THEN
        DO'EXCUSE = 1
        CALL CLR'FREE'FRT'FLAGS        !!Sets 32
        PACK'HDR'SPACE = SPACE
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
            ENTRY = "SET F7 auto="+HDR'MAN'FLAG+" DO="+DO'FREE'FRT
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        HDR'FREE'FRT = ""
        DO'EXCUSE = ENV'DO'EXCUSE
        CALL SET'FREE'FRT
        IER1 = 0
        MEFCHG = 0
        EFCHG = 0
        INX1 = I'RT : INX2 = 0
        ENTRY = STR(HDR'FFP'NO)
        CALL DSP'BITS
        RETURN
    ENDIF
    \TABC FROM="HDR" ON="FFP" APID="OE" REFCHG="Y" &
                DSPZERO="(No Profile)" DSPNAM="PRE'DSP'FFP'DESC"
    ENTRY = ""
    \DG GETVALUE _OESETUP allow_ffp_change ENTRY
    IF HDR'FFP'NO = 0 AND DG'CTL = 0 AND ENTRY = "Y" THEN
        ENTRY = "Free freight profile required!"
        HDR'FFP'NO = CUS'FFP'NO
        CALL DO'ERR
        IER1 = 0
    ENDIF
    IF EDSPSW = 0 AND IER1 # 0 AND EFCHG # 0 THEN
        \SETBIT HDR'BIT'FLAG 32             !!Manually entered FFP
        CALL CLR'FREE'FRT'FLAGS
        IF DO'EXCUSE = 1 THEN
            SAV'ENTRY = ENTRY
!!          \TSTBIT HDR'BIT'FLAG 32 VAR="SF"       !!Do ffp (ZERO=auto)
            ENTRY = "SET EFCHG BIT'F="+HDR'BIT'FLAG
            CALL DO'EXCUSE'LOG
            ENTRY = SAV'ENTRY
        ENDIF
        PACK'HDR'SPACE = SPACE
        VIA'CUS'NO = -1
        VIA'KNO = HDR'VIA'NO
        CALL FIND'VIA
        CALL SET'FREE'FRT       !![46] Calls SET'BOX'ORDER'B
        CALL COMPUTE'FREIGHT'BY'ORDER           !!including order charges
        ? TAB(8,4);"*";
    ELSE
        ? TAB(8,4);" ";
    ENDIF
    ENTRY = STR(HDR'FFP'NO)
RETURN

PRE'DSP'FFP'DESC:
    TIME'CSV = "PRE'DSP'FFP'DESC:" : \TIME'CSV
    FFP2'REC = FFP'REC
    FFP'KNO = FFP'NO
    \VUSE FFP
    IF WBWHAP # 1 THEN
        CALL DSP'FFP'DESC
    ENDIF
    FFP'REC = FFP2'REC
RETURN

PRE'DSP'FFP'DESC2:
    FFP2'REC = FFP'REC
    FFP'KNO = FFP'NO
    \VUSE FFP
    IF WBWHAP # 1 THEN
        CALL DSP'FFP'DESC2
    ENDIF
    FFP'REC = FFP2'REC
RETURN

MAP1 SIGN,F

COMMIT'ALL'SIZES:
    TIME'CSV = "COMMIT'ALL'SIZES:" : \TIME'CSV
    FOR PP = 1 TO 6
        IF LIN'TCOM'QTY(PP) # 0 THEN
            CALL RDLOCK'QTY
            IF QTY'CTL # 0 THEN
                CALL ADD'QTY
            ENDIF
            IF QTY'CTL = 0 THEN
                CALL COMMIT'QTY
                WRITE QTY FROM QTY'REC
            ENDIF
        ENDIF
    NEXT PP
RETURN

RDLOCK'QTY:
    TIME'CSV = "RDLOCK'QTY:" : \TIME'CSV
    QTY'LOC'NO = LIN'LOC'NO
    QTY'TRK'NO = LIN'TRK'NO
    QTY'ATT'NO1 = PP
    QTY'ATT'NO2 = 0
    \SETKEY QTY APID="IN" MODE="KEY"
    DO
        RDLOCK QTY INTO QTY'REC KEY QTY'KEY
        IF QTY'REC[2;1] # CHR(0) AND QTY'CTL = 0 THEN
            REL QTY
            ENTRY = "Waiting for a repost to finish!"
            CALL DO'ERR
            QTY'CTL = 4
            \SLEEP 4
        ENDIF
    LOOP UNTIL QTY'CTL # 4
RETURN

ADD'QTY:
    TIME'CSV = "ADD'QTY:" : \TIME'CSV
    QTY'SPACE = SPACE
    QTY'LOC'NO = QTY'KLOC'NO
    QTY'TRK'NO = QTY'KTRK'NO
    QTY'ATT'NO1 = QTY'KATT'NO1
    QTY'ATT'NO2 = QTY'KATT'NO2
    ADDL QTY FROM QTY'REC KEY QTY'KEY
    IF QTY'CTL = 0 THEN
        \SETKEY PRE="QTY" MODE="KY2" APID="IN"
        \ADDKEY PRE="QTY" MODE="KY2" APID="IN"
    ELSE
        CALL RDLOCK'QTY
    ENDIF
RETURN

COMMIT'QTY:
    TIME'CSV = "COMMIT'QTY:" : \TIME'CSV
    QTY'COMMITTED = QTY'COMMITTED + (LIN'TCOM'QTY(PP) * SIGN)
    QTY'BACKORDER = QTY'BACKORDER + ((LIN'TORDER'QTY(PP)-LIN'TCOM'QTY(PP)) * SIGN)
    IF SIGN = 1 THEN
        QTY'SAFETY = QTY'SAFETY - LIN'TCOM'QTY(PP) - QTY'BACKORDER
!!      QTY'SAFETY = QTY'SAFETY - LIN'TCOM'QTY(PP)
    ENDIF
!!The document type and line item location for a mill bounce order is
!!defined by the Type9LOC_NO variable in the oesetup.xml file
!!(e.g <Type9LOC_NO>90</Type9LOC_NO>).  When you enter a mill bounce order
!!(i.e. 10-9-1234, 20-9-1234) order the line item location is set to 90.
!!The committed and backordered quantities on the order are added to the
!!quantity record for location 90 and a po is created for the order header
!!location.  When you pick the order, the quantity record for both location
!!90 and the order header location are updated (i.e. the committed and
!!backordered quantities are transferred from location 90 to the order
!!header location). When the po is posted the On Order quantity for the order
!!header location is updated.

!!When the order is invoiced, the quantity record for the order header
!!location is updated.  The On Hand quantity is updated by the quantity
!!shipped, the backordered quantity is updated by the quantity on b/o and
!!the safety stock field is updated by the total of the quantity shipped
!!plus the quantity on backorder.

!!When the po is received, the on hand and safety stock fields for the order
!!header location are updated.
RETURN

FIX'SPECIAL'TYPES:
        TIME'CSV = "FIX'SPECIAL'TYPES:" : \TIME'CSV
        MAP1 OTHER'LOCS,B,1
        ENTRY = "Type"+STR(HDR'DOC'TYPE)+"LOC_NO"
        \DG GETVALUE _OESETUP ENTRY BOUNCE'LOC'NO TAGVAR="Y"
        IF HDR'PROC < 5 AND (INC'AUTOPACK = "Y" OR HDR'ACTION = "P") THEN
            IF DG'CTL = 0 AND BOUNCE'LOC'NO # 0 AND &
                                            HDR'LOC'NO # BOUNCE'LOC'NO THEN
                OTHER'LOCS = 0
                LIN2'KHDR'LOC'NO = HDR'LOC'NO
                LIN2'KDOC'TYPE = HDR'DOC'TYPE
                LIN2'KHDR'NO = HDR'NO
                LIN2'KNO = 0
                USE LIN2 INTO LIN'REC KEY LIN2'KEY
                DO
                    GETNXT LIN2 INTO LIN'REC
                    \CHKKEY LIN ALTKEY="LIN2"
                    IF LIN2'CTL # 0 EXIT
                    IF LIN'LOC'NO # BOUNCE'LOC'NO AND LIN'LOC'NO # HDR'LOC'NO THEN
                        OTHER'LOCS = 1
                    ENDIF
                    IF LIN'LOC'NO # BOUNCE'LOC'NO REPEAT
                    RDLOCK LIN LIN2'RCN INTO LIN'REC
                    SIGN = -1
                    CALL COMMIT'ALL'SIZES
                    LIN'LOC'NO = HDR'LOC'NO
                    SIGN = 1            !!Not really sign, just a flag
                                        !!Subtract from safety
                    CALL COMMIT'ALL'SIZES
                    WRITE LIN FROM LIN'REC
                LOOP
                IF OTHER'LOCS = 0 THEN
                    \CLRBIT ORG'BIT'FLAG 1        !!Not a split order
                    HDR'MULTI = 0
                ENDIF
                CALL UPDATE'HDR
            ENDIF
        ENDIF
RETURN

MAP1 BVALUE'YN'BOX'NO,B,2

SET'BOX'VALUE'YN:
    TIME'CSV = "SET'BOX'VALUE'YN:" : \TIME'CSV
    IF (INC'AUTOPACK # "Y" OR OC2'1ST'ONEBOX # "N") AND BVALUE'YN'BOX'NO > 1 THEN
        BVALUE'YN'BOX'NO = 1
    ENDIF
    IF BVALUE'YN'BOX'NO # 0 THEN
        IF BVALUE'YN'BOX'NO # BOX'NO THEN
            BOX'VALUE'YN = "N"
        ELSE
            BOX'VALUE'YN = "Y"
        ENDIF
     ELSE
        BOX'VALUE'YN = "N"
     ENDIF
RETURN

CHANGE'VIA'FOR'HAZARDOUS:
    TIME'CSV = "CHANGE'VIA'FOR'HAZARDOUS:" : \TIME'CSV
    CALL FIND'PRH
    IF PRH'HAZ'NO # 0 AND INC'AUTOPACK = "Y" THEN
        BHAZ'MAT = "Y"
    ENDIF
    ENTRY = ""
    IF BHAZ'MAT = "Y" AND (VIA'MTYPE = "U" AND (VIA'MAN'YN # "C" &
            AND VIA'MAN'YN # "G" AND VIA'MAN'YN # "1" &
            AND VIA'MAN'YN # "H" AND VIA'MAN'YN # "F")) THEN
        IF VIA'RES'IND = "Y" THEN
            ENTRY = ""
            \DG GETVALUE _OESETUP oepack.chg_res_via ENTRY
            IF DG'CTL # 0 THEN
                \DG GETVALUE _OESETUP oepack_chg_res_via ENTRY
            ENDIF
            IF DG'CTL = 0 AND ENTRY # 0 THEN
                HDR'VIA'NO = ENTRY
                HDR'BVIA'NO = HDR'VIA'NO
            ENDIF
        ELSE
            ENTRY = ""
            \DG GETVALUE _OESETUP oepack.chg_comm_via ENTRY
            IF DG'CTL # 0 THEN
                \DG GETVALUE _OESETUP oepack_chg_comm_via ENTRY
            ENDIF
            IF DG'CTL = 0 AND ENTRY # 0 THEN
                HDR'VIA'NO = ENTRY
                HDR'BVIA'NO = HDR'VIA'NO
            ENDIF
        ENDIF
        \STRIP PRH'PART 3
        ENTRY = "Must ship "+PRH'PART+ " ground because it is hazardous!"
        CALL DO'ERR
        GOTO RE'DDB'GDB'PACK01
    ENDIF
    XCALL VICSIT,7,2,BREC,BKEY,BPTR,0,BCTL !!ADD/UPDATE
RETURN

COPYF "LSTFIL[MC]",=L1LST,NOAFR
COPYF "LSTFIL[MC]",=L3LST,NOAFR

GET'FEDEX'CALC'TBL'AMT:
        TIME'CSV = "GET'FEDEX'CALC'TBL'AMT:" : \TIME'CSV
        LENTRY = "GET'FEDEX'CALC'TBL'AMT:"
        \LOG'IT
        VIA'KNO = HDR'VIA'NO
        CALL FIND'VIA
        CALL FIND'TBL

        CALL USE'LST'SHIP
        L3LST'REC = LST'REC

        IF CLOSEST'LOC'FLAG # 0 THEN
            LOC'KNO = ALOC'NO(1)
        ELSE
            LOC'KNO = HDR'LOC'NO
        ENDIF

        \VUSE LOC
        \USELST LOC'LST'NO ALTFLD="LOC'ALT'SEQ"

        \USELST LOC'LST'NO
        L1LST'REC = LST'REC

!!      CALL FEDEX'RATE'REQUEST                    !!fedex.cpy !too many var
RETURN


