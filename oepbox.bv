PROGRAM OEPBOX,8.0(4)
!!
!%W% %G% %U% - SCCS
!!
COPY    "LINKER"                !!LINK MAPS AND MACROS
!!
!!Delete Boxes:  Eric S. Eberhard, 04/14/86
!!
!!                        V. I. C. S.
!!                     of Camp Verde, AZ
!!
!!Copyright (c) 1986,1987,1988,1989,1990,1991,1992,1993,1994,1995,1996,1997,
!!              1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,
!!              2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,
!!              2022 by
!!
!!      VERTICAL INTEGRATED COMPUTER SYSTEMS
!!           2933 W Middle Verde Rd
!!              Camp Verde, AZ  86322
!!               (928) 567-3727
!!
!!              Vertical Integrated Computer Systems, Camp Verde, AZ  USA
!!              All rights reserved.
!!
!!
!!      REVISION HISTORY:
!!
!!7.2   12/06/88 ASC    New version created
!!
!![1]   12/10/90 ESE    Make work with new link values.
!!
!!7.3a  03/23/92 ESE    New release.
!!
!![2] 08/05/93 ESE      NEW: New PRH caching
!!                      IH: need VICSIT.SBR 7.3a(7) and a lot of other
!!                          programs (see ESEPRH.CMD).
!!
!![3] 10/28/93 ESE      NEW: new error trapping for gracefull ctrl-c.
!!
!!7.4   09/30/95 CAE    New version created
!!
!!8.0  03/31/97 CAE     New version created
!!
!![4]  03/31/97 CAE     NEW: Changes for year 2000.
!!
!  8.8    07/23/04 ese      Massive change for 2004 season at Morris
!                           Costumes
!  8.9    12/22/05 jmcook   corrected copyrights
!  8.10   10/26/07 elaine   change copyright
!  8.11   08/07/09 elaine   copyright
!  8.12   12/28/09 elaine   copyright
!  8.13   01/05/11 cae      Copyright
!  8.14   12/28/11 cae      Copyright
!  8.15   10/31/17 cae      Copyright
!  8.16   09/15/20 cae      Copyright
!  8.17   11/15/21 cae      Copyright
! !!COMMENT-MARKER!!LANGUAGE=BASIC!!    DO NOT REMOVE  DO NOT REMOVE
!!
!!
!!
\\SSRPTMAPS                     !!Standard report module maps
!!
COPY    "FORMAD"
!!
\COPYF  LIN MODE="PRI"
\COPYF  SUB MODE="PRI"
COPYF   "LINKEY",=LIN2
COPYF   "SUBKEY",=SUB2
\COPYF PRH IN MODE="PRI"
\COPYF LST MC MODE="ALL"

ON ERROR GOTO PRE'ERTRAP

BEGIN:
        \LNKIN
                                !!MODIFY:  below if program name changed ...
        IF PRGNAM # "OEPBOX" AND PRGNAM # "OEXBOX" THEN
                ENTRY = "Cannot run program directly"
                CALL DO'ERR
                GOTO ABORT
        ENDIF
        LDUSR                   !!DO NOT NOT NOT USE SECURITY IN THIS PROGRAM
        USE OC2 UB'CNO INTO OC2'REC
        IF OC2'CTL # 0 THEN
            ENTRY = "Cannot read OC2?"
            CALL DO'ERR
            GOTO ABORT
        ENDIF
        IF V''SYSTEM = "AMOS" THEN
                IF V''JOBNAM[1;4] = "TASK" THEN IN'TB = 1
        ELSE
                IF UB'UID[1;4] = "TASK" THEN IN'TB = 1
        ENDIF
        IF V''JOBNAM[1;3] = "BGP" THEN IN'TB = 1
!!

        IF HDR'PQU'STAT # "Q" OR HDR'ACTION # "P" THEN
                ENTRY = "Invalid HDR: "
                \HDRERR
                CALL DO'ERRL
                GOTO ABORT
        ENDIF
        IF OEC'BLOW'BOX # "Y" OR OC2'UPSONL'YN = "Y" OR &
                                   OEC'INV'YN = "N" OR HDR'PROC >= 5 THEN
                ENTRY = "How did you get here? "
                \HDRERR
                CALL DO'ERRL
                GOTO ABORT
        ENDIF

        USE HHS I INTO HHS'REC

        IF HHS'CTL # 0 THEN
                ENTRY = "CANNOT READ ARCHIVED HEADER IN OEPBOX"
                CALL DO'ERR
                GOTO ABORT
        ENDIF

        BXL'HDR'LOC'NO = HHS'LOC'NO             !Location
        BXL'DOC'TYPE = HHS'DOC'TYPE             !Document Type
        BXL'HDR'NO = HHS'NO                     !Order Number
        BXL'SHIPMENT = HHS'SHIPMENT             !Shipment Number
        BXL'KKEYFLD1 = BXL'KEYFLD1
        BXL'KKEYFLD2 = BXL'KEYFLD2
        BXL'KLIN'NO = 0
        BXL'KSUB'NO = 0
        BXL'KBOX'NO = 0
        \DELOOP PRE="BXL" BAD="TST'BXL"
        BOX'KHDR'LOC'NO = HHS'LOC'NO
        BOX'KDOC'TYPE = HHS'DOC'TYPE
        BOX'KHDR'NO = HHS'NO
        BOX'KSHIPMENT = HHS'SHIPMENT
        BOX'KNO = 0
        \DELOOP PRE="BOX"
        CALL CLEAN'UP
END

ABORT:                          !!Used for abnormal exit of program
                                !!such as error conditions or user
                                !!voluntary exit.
        PRGNAM="ABORT"
        CALL CLEAN'UP
END

CLEAN'UP:
        IF PRGNAM # "ABORT" THEN PRGNAM = "GOOD"
        IF PRGNAM="GOOD" AND CTC > 0 AND CTC <= 200 THEN
                PRGNAM="CTRLC"
        ENDIF
        \LNKOUT
RETURN

COPY    "FORMAT"
COPY    "BASERR"


TST'BXL:
        IF BXL'KEYFLD1 # BXL'KKEYFLD1 OR BXL'KEYFLD2 # BXL'KKEYFLD2 THEN BXL'CTL =3
RETURN

MAP1 CTC,B,5
MAP1 IN'TB,B,1

PRE'ERTRAP:
        IF ERR(0) = 1 THEN
                CTC = CTC + 1
                IF CTC > 200 GOTO ERTRAP        !!Die if lots ...
                ENTRY = "CTRL-C pressed - will abort at a good time."
                IF IN'TB = 1 THEN
                        ?TAB(-1,A'RED) ; ENTRY ; TAB(-1,A'NORM) ; TAB(-1,9)
                ELSE
                        CALL DO'ERR
                ENDIF
                RESUME
        ENDIF
        CTC = 0
GOTO ERTRAP
