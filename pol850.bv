MAP1 PO'DETAIL                !!PO detail
    MAP2 DETAIL'CODE,S,2
    MAP2 LINE'ITEM'NUM,S,4
    MAP2 ITEM'ID'GTIN,S,14
    MAP2 MASTER'STYLE,S,10
    MAP2 COLOR'CODE,S,7
    MAP2 SIZE'CODE,S,7
    MAP2 QUANTITY'ORDERED,S,10
    MAP2 PO'UOM,S,2
    MAP2 PURCHASE'UNIT'PRICE,S,10
    MAP2 TOTAL'LINE'ITEM,S,10

MAP1 OTHER'CHARGES'REC        !!Other charges record
    MAP2 OTHER'CHARGES,S,2
    MAP2 OC'LINE'ITEM'NUM,S,2
    MAP2 OTHER'CHARGE'DESC,S,45
    MAP2 OTHER'CHARGE'AMT,S,10

MAP1 TRAILER                  !!Trailer record
    MAP2 TRAILER'RECORD,S,2
    MAP2 RECORD'COUNT,S,7
    MAP2 TOTAL'QUANTITY'ORDERED,S,10
    MAP2 TOTAL'MONETARY'VALUE,S,14
    MAP2 TOTAL'ORDER'VALUE,S,14
    MAP2 TOTAL'NUM'CASES,S,7
    MAP2 PO'TOTAL'AMT,S,14

CREATE'850'HEADER:
        NUM'OF'RECORDS = 0
        EASI'HEADER = SPACE

        HEADER = "01"
        PRINT #33, HEADER; CHR(9);

        TRANS'TYPE = "850"
        PRINT #33, TRANS'TYPE; CHR(9);

        MAP1 ANVIL'ALWAYS'ORIGINAL,S,1
        MAP1 GILDAN'ALWAYS'ORIGINAL,S,1
        \DG GETSTRING _POSETUP pol850_gildan_always_original GILDAN'ALWAYS'ORIGINAL
        \DG GETSTRING _POSETUP pol850_anvil_always_original ANVIL'ALWAYS'ORIGINAL
        CASE
        IF GILDAN'ALWAYS'ORIGINAL = "Y" AND WRK'UCC'NO = "00821780" THEN
            TRANS'SET'PURPOSE = "00"
            PRINT #33, TRANS'SET'PURPOSE; CHR(9);
        ELSE
        IF ANVIL'ALWAYS'ORIGINAL = "Y" AND WRK'UCC'NO = "0707738" THEN
            TRANS'SET'PURPOSE = "00"
            PRINT #33, TRANS'SET'PURPOSE; CHR(9);
        ELSE
        IF PURPOSE = "F" THEN
            TRANS'SET'PURPOSE = "00"        !!00=Original, 07=Duplicate
            PRINT #33, TRANS'SET'PURPOSE; CHR(9);
        ELSE
            TRANS'SET'PURPOSE = "07"        !!16=Proposed, 22=Information copy
            PRINT #33, TRANS'SET'PURPOSE; CHR(9);
        ENDCASE

        CALL LOOKUP'BLF
        PRINT #33, VERSION'NUMBER; CHR(9);

!       \DG GETSTRING _POSETUP posune_AA_vendor AA'VEN'NO
!       IF DG'CTL = 0 AND AA'VEN'NO # 0 AND (HDR'NAM'NO = AA'VEN'NO AND &
!                         HDR'LOC'NO = 90 AND HDR'DROP'YN = "Y") THEN
!           PO'TYPE'CODE = "DS"
!       ELSE
            PO'TYPE'CODE = "SA"
!       ENDIF
        PRINT #33, PO'TYPE'CODE; CHR(9);

        BUYERS'PO'NUMBER = HDR'LOC'NO+"-"+HDR'DOC'TYPE+"-"+HDR'NO
        PRINT #33, BUYERS'PO'NUMBER; CHR(9);

        RELEASE'NUMBER = ""
        PRINT #33, RELEASE'NUMBER; CHR(9);

        \STRDTT DTT="HDR'ORDER'DTT" YYMMDD="Y" CDATE="PO'DATE"
        PO'DATE = "20" +PO'DATE
        PRINT #33, PO'DATE; CHR(9);

        \S'TO'HMS
        ENTRY = (HRS USING "#Z")+(MNS USING "#Z")+(SEC USING "#Z")
        PO'TIME = ENTRY
        PRINT #33, PO'TIME; CHR(9);

        CONTRACT'NUMBER = ""
        PRINT #33, CONTRACT'NUMBER; CHR(9);

        LOC'SPACE = SPACE
        LOC'KNO = HDR'LOC'NO
        USE LOC INTO LOC'REC KEY LOC'KEY
        IF LOC'CTL # 0 THEN
            ENTRY = "Cannot find location"
            \KERROR LOC MODE="KEY" APID="IN" CNO="N"
            ENTRY = ENTRY + " for PO " + &
                         HDR'DOC'TYPE + "-" + HDR'NO
            \LABLOGGER ENTRY LNAME
        ELSE
            LST'SPACE = SPACE
            LSTF'KNO = LOC'LST'NO              !!Contact on location maintenace
            USE LSTF INTO LST'REC KEY LSTF'KEY
            IF LSTF'CTL = 0 THEN
                CASE
                IF LST'COUNTRY = "USA" OR LST'COUNTRY = "US" THEN
                    CURRENCY'CODE = "USD"
                    PRINT #33, CURRENCY'CODE; CHR(9);
                ELSE
                IF LST'COUNTRY = "CAN" OR LST'COUNTRY = "CA" THEN
                    CURRENCY'CODE = "CAD"
                    PRINT #33, CURRENCY'CODE;  CHR(9);
                ELSE
                    CURRENCY'CODE = "EUR"
                    PRINT #33, CURRENCY'CODE; CHR(9);
                ENDCASE
                DELIVER'TO'COUNTRY = LST'COUNTRY
            ELSE
                ENTRY = "Country code not on file"
                \KERROR TAD MODE="KEY" CNO="N" APID="OE"
                ENTRY = ENTRY + " for PO " + HDR'DOC'TYPE + "-" + &
                            HDR'NO
                \LABLOGGER ENTRY LNAME
                ABORT'FLAG = 1
                GOTO ABORT
            ENDIF
        ENDIF

        UCD'KUCC'NO = UCC'NO
        IF PO'MULTI'STORE = "Y" THEN
            UCD'KSTORE'ID = WRK'STORE'ID
            USE UCD INTO UCD'REC KEY UCD'KEY
            IF UCD'CTL # 0 THEN
                ENTRY = "3: Cannot find store number"
                \KERROR UCD MODE="KEY" APID="PO" CNO="N"
                CALL DO'ERR
                \LABLOGGER ENTRY LNAME
                ABORT'FLAG = 1
                GOTO ABORT
            ENDIF
        ELSE
            UCD'KSTORE'ID = 0
            DO
                GETNXT UCD INTO UCD'REC
                IF UCD'CTL # 0 THEN
                    ENTRY = "4: Cannot find store number"
                    \KERROR UCD MODE="KEY" APID="PO" CNO="N"
                    CALL DO'ERR
                    \LABLOGGER ENTRY LNAME
                    ABORT'FLAG = 1
                    GOTO ABORT
                ENDIF
                IF UCD'LOC'NO = WRK'LOC'NO EXIT
            LOOP
        ENDIF
        SPECIAL'TYPE = 0
        IF HDR'DOC'TYPE = 8 THEN
            \DG GETSTRING _POSETUP potedt_kariban_vendor UCD'VEN'NO
            IF DG'CTL # 0 OR UCD'VEN'NO = 0 THEN
                ENTRY = "Kariban Vendor not set up!"
                \LABLOGGER ENTRY LNAME
                ABORT'FLAG = 1
                GOTO ABORT
            ELSE
                SPECIAL'TYPE = 1
            ENDIF
        ENDIF
        MAP1 AA'VEN'NO,B,3
        MAP1 AA'FAKE'NO,B,3
        \DG GETSTRING _POSETUP posune_AA_vendor AA'VEN'NO
        IF DG'CTL = 0 AND HDR'NAM'NO = AA'VEN'NO THEN
            \DG GETSTRING _POSETUP posune_AA_fake_vendor AA'FAKE'NO
            IF DG'CTL = 0 AND ENTRY # 0 THEN
                HDR'NAM'NO = AA'FAKE'NO
            ENDIF
        ENDIF
        IF (UCD'VEN'NO = HDR'NAM'NO AND UCD'LOC'NO = HDR'LOC'NO) OR &
             (UCD'VEN'NO = HDR'NAM'NO AND UCD'LOC'NO = HDR'SHP'NO AND &
                HDR'DROP'YN = "L") OR SPECIAL'TYPE = 1 THEN
            VEN'SPACE = SPACE
            VEN'KNO = UCD'VEN'NO
            USE VEN INTO VEN'REC KEY VEN'KEY
            IF VEN'CTL = 0 THEN
                IF VEN'ACCOUNT = "" THEN
                    ENTRY = "Vendor account must be set up"
                    \KERROR VEN MODE="KEY" CNO="N" APID="AP"
                    ENTRY = ENTRY + " for PO " + &
                    HDR'DOC'TYPE + "-" + HDR'NO
                    \LABLOGGER ENTRY LNAME
                    ABORT'FLAG = 1
                    GOTO ABORT
                ELSE
                    CASE
                    IF HDR'NAM'NO = AA'FAKE'NO AND HDR'FULL'CASE = "Y" THEN
                        PO'ACCOUNT'ID = "452558"
                    ELSE
                    IF HDR'NAM'NO = AA'FAKE'NO AND HDR'FULL'CASE = "N" THEN
                        PO'ACCOUNT'ID = "452558"
                    ELSE
                        PO'ACCOUNT'ID = VEN'ACCOUNT
                    ENDCASE
                    PRINT #33, PO'ACCOUNT'ID; CHR(9);
                    IF UCD'STORE'ID = "" THEN
                        ENTRY = "Store ID must be set up"
                        \KERROR UCD MODE="KEY" CNO="N" APID="PO"
                        ENTRY = ENTRY + " for PO " +  &
                                     HDR'DOC'TYPE + "-" + HDR'NO
                        \LABLOGGER ENTRY LNAME
                        ABORT'FLAG = 1
                        GOTO ABORT
                    ELSE
                        STORE'ID = UCD'STORE'ID
                        JJ = LEN(STORE'ID)
                        IF JJ < 4 THEN
                            STORE'ID = "0" + STORE'ID
                        ENDIF
                        JJ = LEN(STORE'ID)
                        IF JJ < 4 THEN
                            STORE'ID = "0" + STORE'ID
                        ENDIF
                        PRINT #33, STORE'ID; CHR(9);
                    ENDIF
                ENDIF
            ELSE
                ENTRY = "Vendor account not on file"
                \KERROR VEN MODE="KEY" CNO="N" APID="AP"
                ENTRY = ENTRY + " for PO " + &
                             HDR'DOC'TYPE + "-" + HDR'NO
                \LABLOGGER ENTRY LNAME
                ABORT'FLAG = 1
                GOTO ABORT
            ENDIF
        ELSE
            ENTRY = "Ven/loc"
            \KERROR UCD MODE="KEY" CNO="N" APID="PO"
            ENTRY = ENTRY + " PO="
            \KERROR HDR MODE="D" CNO="N" APID="PO"
            ENTRY = ENTRY + " PO " + &
                         HDR'DOC'TYPE + "-" + HDR'NO
            ENTRY = ENTRY + "("+STR(HDR'NAM'NO)+"-"+STR(UCD'VEN'NO)+")("+&
                    STR(HDR'LOC'NO)+"-"+STR(UCD'LOC'NO)+")"
            \LABLOGGER ENTRY LNAME
            ABORT'FLAG = 1
            GOTO ABORT
        ENDIF

        VENDOR'ID = UCC'NO
        PRINT #33, VENDOR'ID; CHR(9);

        LOC'SPACE = SPACE
        IF HDR'DROP'YN = "L" THEN
            LOC'KNO = HDR'SHP'NO
        ELSE
            LOC'KNO = HDR'LOC'NO
        ENDIF
        USE LOC INTO LOC'REC KEY LOC'KEY
        IF LOC'CTL # 0 THEN
            ENTRY = "Cannot find location"
            \KERROR LOC MODE="KEY" APID="IN" CNO="N"
            ENTRY = ENTRY + " for PO " + &
                         HDR'DOC'TYPE + "-" + HDR'NO
            \LABLOGGER ENTRY LNAME
        ELSE
            LST'SPACE = SPACE
            LSTF'KNO = LOC'LST'NO              !!Contact on location maintenace
            USE LSTF INTO LST'REC KEY LSTF'KEY
            IF LSTF'CTL = 0 THEN
                FOR II = 1 TO 3
                    IF UCS(LST'PTY'NO(II)) = "O" THEN
                        BUS'PHONE = LST'PHONE(II)
                    ENDIF
                NEXT II
                IF LST'PHONE(II) # "" THEN
                    CONTACT'NAME = LST'FIRST + " " + LST'LAST + " " + &
                        BUS'PHONE[1;3]+ "-" + BUS'PHONE[4;3] + "-" + &
                        BUS'PHONE[7;4]
                    PRINT #33, CONTACT'NAME; CHR(9);
                ELSE
                    CONTACT'NAME = LST'FIRST + " " + LST'LAST
                    PRINT #33, CONTACT'NAME; CHR(9);
                ENDIF
            ELSE
                CONTACT'NAME = ""
                PRINT #33, CHR(9);
            ENDIF
        ENDIF

        FOB = "CC"                            !!PP-Wholesaler pays freight
        PRINT #33, FOB; CHR(9);               !!CC-Freight charges paid by distributor
                                              !!   billed by carrier
        POT'SPACE = SPACE
        POT'KNO = HDR'POT'NO
        USE POT INTO POT'REC KEY POT'KEY
        IF POT'CTL # 0 THEN
            ENTRY = "Cannot find PO Terms"
            \KERROR LOC MODE="KEY" APID="IN" CNO="N"
            ENTRY = ENTRY + " for PO " + &
                       HDR'DOC'TYPE + "-" + HDR'NO
            \LABLOGGER ENTRY LNAME
        ELSE
            CASE
            IF POT'BO'S = "A" THEN
                SALES'CODE'SHIPMENT = "BK"        !!BK-Ship partial, B/O balance
            ELSE
            IF POT'BO'S = "P" THEN
                SALES'CODE'SHIPMENT = "SP"        !!SP-Ship partial, cancel rest
            ELSE
            IF POT'BO'S = "D" THEN
                SALES'CODE'SHIPMENT = "SC"        !!SC-Ship complete
            ENDCASE
            PRINT #33, SALES'CODE'SHIPMENT; CHR(9);
        ENDIF

        SALES'CODE'TRUCK = "LT"                   !!LT-Less than full truck
        PRINT #33, SALES'CODE'TRUCK; CHR(9);      !!FT-Full truck

        IF HANES'850'PO = "Y" AND WRK'UCC'NO = "766369" THEN
            SALES'CODE'SHIP'DATE = "  "
        ELSE
            SALES'CODE'SHIP'DATE = "P2"
        ENDIF
        PRINT #33, SALES'CODE'SHIP'DATE; CHR(9);

        SALES'CODE'CONSIGNEE = ""
        PRINT #33, SALES'CODE'CONSIGNEE; CHR(9);

        TRH'SPACE = SPACE
        TRH'KNO = HDR'TRH'NO
        USE TRH INTO TRH'REC KEY TRH'KEY
        IF TRH'CTL # 0 THEN
            ENTRY = "Cannot find terms"
            \KERROR TRH MODE="KEY" APID="AR" CNO="N"
            ENTRY = ENTRY + " for PO " + &
                         HDR'DOC'TYPE + "-" + HDR'NO
            \LABLOGGER ENTRY LNAME
            ABORT'FLAG = 1
            GOTO ABORT
        ENDIF

        PAYMENT'TERMS'DISCOUNT = ""
        PRINT #33, PAYMENT'TERMS'DISCOUNT; CHR(9);

        PAYMENT'TERMS'DAYS = ""
        PRINT #33, PAYMENT'TERMS'DAYS; CHR(9);

        PAYMENT'DUE'DAYS = ""
        PRINT #33, PAYMENT'DUE'DAYS; CHR(9);

        SPECIFIC'PAYMENT'DATE = ""
        PRINT #33, SPECIFIC'PAYMENT'DATE; CHR(9);

        LITERAL'PAYMENT'TERMS = TRH'DESC
        PRINT #33, LITERAL'PAYMENT'TERMS; CHR(9);

        MAP1 ANVIL'SET'PODATE,S,1
        MAP1 A4'SET'PODATE,S,1
        \DG GETSTRING _POSETUP pol850_anvil_set_podate ANVIL'SET'PODATE
        \DG GETSTRING _POSETUP pol850_a4_set_podate A4'SET'PODATE
        IF ANVIL'SET'PODATE = "Y" AND UCC'NO = "0707738" OR &
                    A4'SET'PODATE = "Y" AND UCC'NO = "76497" THEN
            IF HDR'SHP'DTT = "" THEN
                \STRDTT DTT="DATE" YYMMDD="Y" CDATE="REQUESTED'SHIP'DATE"
                REQUESTED'SHIP'DATE = "20" +REQUESTED'SHIP'DATE
            ELSE
                \STRDTT DTT="HDR'SHP'DTT" YYMMDD="Y" CDATE="REQUESTED'SHIP'DATE"
                REQUESTED'SHIP'DATE = "20" +REQUESTED'SHIP'DATE
            ENDIF
        ELSE
            IF HDR'SHP'DTT # "" THEN
                \STRDTT DTT="HDR'SHP'DTT" YYMMDD="Y" CDATE="REQUESTED'SHIP'DATE"
                REQUESTED'SHIP'DATE = "20" +REQUESTED'SHIP'DATE
            ENDIF
        ENDIF
        PRINT #33, REQUESTED'SHIP'DATE; CHR(9);

        CANCEL'DATE = ""
        PRINT #33, CANCEL'DATE; CHR(9);

        VIA'SPACE = SPACE
        VIA'KNO = HDR'VIA'NO
        \DG GETSTRING _POSETUP posune_AA_vendor AA'VEN'NO
        IF DG'CTL = 0 AND AA'VEN'NO # 0 THEN
            \DG GETSTRING _POSETUP posune_AA_fake_vendor ENTRY
            IF DG'CTL = 0 AND HDR'NAM'NO = ENTRY AND HDR'DOC'TYPE = 4 AND &
                      HDR'LOC'NO # 90 AND HDR'DROP'YN = "Y" THEN
                \DG GETSTRING _POSETUP pol850_AA_via AA'VIA'NO
                MAP1 AA'VIA'NO,B,2
                IF DG'CTL = 0 AND AA'VIA'NO # 0 THEN
                    VIA'KNO = AA'VIA'NO
                ENDIF
            ENDIF
        ENDIF
        USE VIA INTO VIA'REC KEY VIA'KEY
        IF VIA'CTL # 0 THEN
            ENTRY = "Cannot find ship via"
            \KERROR VIA MODE="KEY" APID="IN" CNO="N"
            ENTRY = ENTRY + " for PO " + &
                         HDR'DOC'TYPE + "-" + HDR'NO
            \LABLOGGER ENTRY LNAME
            ABORT'FLAG = 1
            GOTO ABORT
        ELSE
            CALL LOOKUP'VIA
        ENDIF

        CASE
        IF HDR'DROP'YN = "N" THEN
            LOC'SPACE = SPACE
            LOC'KNO = HDR'LOC'NO
            USE LOC INTO LOC'REC KEY LOC'KEY
            IF LOC'CTL # 0 THEN
                ENTRY = "1: Cannot find location shipping address"
                \KERROR LOC MODE="KEY" APID="IN" CNO="N"
                ENTRY = ENTRY + " for PO " + &
                             HDR'DOC'TYPE + "-" + HDR'NO
                \LABLOGGER ENTRY LNAME
            ELSE
                LST'SPACE = SPACE
                LSTF'KNO = LOC'LST'NO
                USE LSTF INTO LST'REC KEY LSTF'KEY
                IF LSTF'CTL # 0 THEN
                    ENTRY = "1: Cannot find vendor name for drop ship"
                    \KERROR LST MODE="KEY" APID="MC" CNO="N"
                    ENTRY = ENTRY + " for PO " + &
                                HDR'DOC'TYPE + "-" + HDR'NO
                    \LABLOGGER ENTRY LNAME
                    ABORT'FLAG = 1
                    GOTO ABORT
                ENDIF
            ENDIF
            CALL SET'DELIVER'TO'FIELDS
        ELSE
        IF HDR'DROP'YN = "L" THEN
            LOC'SPACE = SPACE
            LOC'KNO = HDR'SHP'NO
            USE LOC INTO LOC'REC KEY LOC'KEY
            IF LOC'CTL # 0 THEN
                ENTRY = "Cannot find location for drop ship"
                \KERROR LOC MODE="KEY" APID="IN" CNO="N"
                ENTRY = ENTRY + " for PO " + &
                             HDR'DOC'TYPE + "-" + HDR'NO
                \LABLOGGER ENTRY LNAME
            ELSE
                LST'SPACE = SPACE
                LSTF'KNO = LOC'LST'NO
                USE LSTF INTO LST'REC KEY LSTF'KEY
                IF LSTF'CTL # 0 THEN
                    ENTRY = "Cannot find vendor name for drop ship"
                    \KERROR LST MODE="KEY" APID="MC" CNO="N"
                    ENTRY = ENTRY + " for PO " + &
                                HDR'DOC'TYPE + "-" + HDR'NO
                    \LABLOGGER ENTRY LNAME
                    ABORT'FLAG = 1
                    GOTO ABORT
                ENDIF
            ENDIF
            CALL SET'DELIVER'TO'FIELDS
        ELSE
            \DG GETSTRING _POSETUP posune_AA_vendor ENTRY
            IF DG'CTL = 0 AND HDR'NAM'NO = ENTRY AND HDR'LOC'NO # 90 THEN
                LOC'SPACE = SPACE
                LOC'KNO = HDR'LOC'NO
                USE LOC INTO LOC'REC KEY LOC'KEY
                IF LOC'CTL # 0 THEN
                    ENTRY = "2: Cannot find location shipping address"
                    \KERROR LOC MODE="KEY" APID="IN" CNO="N"
                    ENTRY = ENTRY + " for PO " + &
                                     HDR'DOC'TYPE + "-" + HDR'NO
                    \LABLOGGER ENTRY LNAME
                ELSE
                    LST'SPACE = SPACE
                    LSTF'KNO = LOC'LST'NO
                    USE LSTF INTO LST'REC KEY LSTF'KEY
                    MILL'DIRECT = "N"
                    IF LSTF'CTL # 0 THEN
                        ENTRY = "2: Cannot find vendor name for drop ship"
                        \KERROR LST MODE="KEY" APID="MC" CNO="N"
                        ENTRY = ENTRY + " for PO " + &
                                        HDR'DOC'TYPE + "-" + HDR'NO
                        \LABLOGGER ENTRY LNAME
                        ABORT'FLAG = 1
                        GOTO ABORT
                    ENDIF
                ENDIF
            ELSE
                TAD'KBS = "P"
                TAD'KHDR'LOC'NO = 0
                TAD'KDOC'TYPE = HDR'DOC'TYPE
                TAD'KHDR'NO = HDR'NO
                USE TAD INTO TAD'REC KEY TAD'KEY
                IF TAD'CTL = 0 THEN
                    LST'SPACE = SPACE
                    LSTF'KNO = HDR'NAM'NO
                    USE LSTF INTO LST'REC KEY LSTF'KEY
                    IF LSTF'CTL # 0 THEN
                        ENTRY = "Cannot find temporary address for drop ship"
                        \KERROR LST MOD="KEY" APID="MC" CNO="N"
                        ENTRY = ENTRY + " for PO " + HDR'DOC'TYPE + "-" + HDR'NO
                            \LABLOGGER ENTRY LNAME
                        ABORT'FLAG = 1
                        GOTO ABORT
                    ELSE
                        LST'COMPANY = TAD'COMPANY
                        LST'ADDR1 = TAD'ADDR1
                        LST'ADDR2 = TAD'ADDR2
                        LST'CITY = TAD'CITY
                        LST'ST = TAD'ST
                        LST'ZIP = TAD'ZIP
                        LST'COUNTRY = TAD'COUNTRY
                    ENDIF
                ELSE
                    IF HDR'SHIP'TO = 0 THEN
                        LST'SPACE = SPACE
                        LSTF'KNO = HDR'SHP'NO
                        USE LSTF INTO LST'REC KEY LSTF'KEY
                        IF LSTF'CTL # 0 THEN
                            ENTRY = "Cannot find customer for drop ship"
                            \KERROR LST MODE="KEY" APID="MC" CNO="N"
                            ENTRY = ENTRY + " for PO " + &
                                HDR'DOC'TYPE + "-" + HDR'NO
                            \LABLOGGER ENTRY LNAME
                            ABORT'FLAG = 1
                            GOTO ABORT
                        ENDIF
                    ELSE
                        LST'SPACE = SPACE
                        LSTF'KNO = HDR'SHIP'TO
                        USE LSTF INTO LST'REC KEY LSTF'KEY
                        IF LSTF'CTL # 0 THEN
                            ENTRY = "Cannot find customer for ship to"
                            \KERROR LST MODE="KEY" APID="MC" CNO="N"
                            ENTRY = ENTRY + " for PO " + &
                                HDR'DOC'TYPE + "-" + HDR'NO
                            \LABLOGGER ENTRY LNAME
                            ABORT'FLAG = 1
                            GOTO ABORT
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
            CALL SET'DELIVER'TO'FIELDS
        ENDCASE

        IF HDR'DROP'YN = "Y" THEN
            IF MILL'DIRECT = "N" THEN
                DROP'SHIP'CODE = "N"
            ELSE
                DROP'SHIP'CODE = "Y"
            ENDIF
            PRINT #33, DROP'SHIP'CODE; CHR(9);
        ELSE
            DROP'SHIP'CODE = "N"
            PRINT #33, DROP'SHIP'CODE; CHR(9);
        ENDIF

        SPEC'DELIVERY'INSTRUCTIONS = ""
        PRINT #33, SPEC'DELIVERY'INSTRUCTIONS; CHR(9);

        SPEC'ORDER'INSTRUCTIONS = ""
        PRINT #33, SPEC'ORDER'INSTRUCTIONS; CHR(9);

        DELIVER'TO'COUNTY = ""
        PRINT #33, DELIVER'TO'COUNTY; CHR(9);

        MAP1 FLAG,B,1
        IF HDR'CONF'MSGNO # 0 THEN
            MSG'DID = "POMSG"
            MSG'SPACE = SPACE
            USE MSG HDR'CONF'MSGNO INTO MSG'REC
            DO
                FLAG = INSTR(1,UCS(MSG'DATA[1;2]),"P:")
                IF FLAG # 0 THEN
                    PROMO'CODE = MSG'DATA[3,-1]
                ELSE
                    IF MSG'CH = 0 EXIT
                    USE MSG MSG'CH INTO MSG'REC
                ENDIF
            LOOP UNTIL MSG'CTL # 0 OR FLAG # 0
        ELSE
            PROMO'CODE = ""
        ENDIF
        PRINT #33, PROMO'CODE; CHR(9);

        PRINT #33, DELIVER'SERV'LEVEL; CHR(9);

        PRINT #33, DELIVER'TO'PHONE; CHR(9);

        PRINT #33, CUSTOMER'PO'NUMBER; CHR(9);
        PRINT #33, COD'FOR'MERCHANDISE; CHR(9);
        PRINT #33, RECEIVER'EMAIL; CHR(9);
        PRINT #33, ACCOUNT'NUMBER; CHR(9);
        PRINT #33, NAME'OF'ACCOUNT; CHR(9);
        PRINT #33, TRACKING'ID; CHR(9);
        PRINT #33, PURCHASERS'ACCOUNT'ID; CHR(9);
        PRINT #33, DELIVER'TO'COMM'OR'RES; CHR(9);
        PRINT #33, COD'TAGS'INDICATOR; CHR(9);
        PRINT #33, THIRD'PARTY'ACCOUNT;

        NUM'OF'RECORDS = NUM'OF'RECORDS + 1
        NOTD = NOTD + 1
        PRINT #33, CHR(13) + CHR(10);                   !!CRLF
RETURN

CREATE'850'DETAIL:            !!PO detail
    LINE'ITEM'COUNTER = 0
    LIN'KDOC'TYPE = HDR'DOC'TYPE
    LIN'KHDR'NO = HDR'NO
    LIN'KNO = 0
    USE LIN INTO LIN'REC KEY LIN'KEY
    GETNXT LIN INTO LIN'REC
    DO UNTIL LIN'CTL # 0 OR LIN'DOC'TYPE # LIN'KDOC'TYPE OR &
                LIN'HDR'NO # LIN'KHDR'NO
        CALL LOOKUP'SUBS
!!      CALL CREATE'850'OTHER'CHARGES'REC
        GETNXT LIN INTO LIN'REC
    LOOP
RETURN

LOOKUP'SUBS:
    SUB'KDOC'TYPE = HDR'DOC'TYPE
    SUB'KHDR'NO = HDR'NO
    SUB'KLIN'NO = LIN'NO
    SUB'KNO = 0
    USE SUB INTO SUB'REC KEY SUB'KEY
    GETNXT SUB INTO SUB'REC
    DO UNTIL SUB'CTL # 0 OR SUB'KDOC'TYPE # SUB'DOC'TYPE OR &
            SUB'KHDR'NO # SUB'HDR'NO OR SUB'KLIN'NO # SUB'LIN'NO
        PO'DETAIL = SPACE
        DETAIL'CODE = "02"
        PRINT #33, DETAIL'CODE; CHR(9);

        LINE'ITEM'COUNTER = LINE'ITEM'COUNTER + 1
        LINE'ITEM'NUM = LINE'ITEM'COUNTER
        PRINT #33, LINE'ITEM'NUM; CHR(9);

        CALL LOOKUP'PART'GTIN
        CALL LOOKUP'PDD'INFO
        CALL LOOKUP'QUANTITY

        NUM'OF'RECORDS = NUM'OF'RECORDS + 1
        GETNXT SUB INTO SUB'REC
    LOOP
RETURN
\COPYF INT IN

LOOKUP'PART'GTIN:
    INT'SPACE = SPACE
    INT'TRK'NO = LIN'TRK'NO
    INT'ATT'NO1 = SUB'ATT'NO1
    INT'TYPE = "V"
    INT'NAM'NO = UCC'INT'VEN'NO
    INT'UOM'NO = 1
    \SETKEY INT MODE="KEY" APID="IN"
    USE INT INTO INT'REC KEY INT'KEY
    IF INT'CTL = 0 THEN
        \STRIP INT'PART 3
        ENTRY = INT'PART
        \NUMCHECK
        IF V''NUMCHECK'FLAG = 1 THEN
            ENTRY = "GTIN may not be valid for: "+ LIN'TRK'NO + "-" + SUB'ATT'NO1
            \LABLOGGER ENTRY LNAME
            CRITICAL'ERROR = 1
        ENDIF
        ITEM'ID'GTIN = INT'PART
        PRINT #33, ITEM'ID'GTIN; CHR(9);
        IF ITEM'ID'GTIN = "" THEN
            CALL LOOKUP'PRH
            ENTRY = "1) GTIN not found for :" + PRH'PART
            \LABLOGGER ENTRY LNAME
            ENTRY = "1) GTIN not found :"+ PRH'PART +" 850 not created!"
            CALL DO'ERR
            CRITICAL'ERROR = 1
        ENDIF
    ELSE
        CALL LOOKUP'PRH
        PRINT #33, ITEM'ID'GTIN; CHR(9);
        ENTRY = "2) GTIN not found for:" + PRH'PART + " Line: "+ LIN'NO +" Size: "+ SUB'ATT'NO1
        \LABLOGGER ENTRY LNAME
        ENTRY = "2) GTIN not found :"+ LIN'NO + "-"+ PRH'PART+" Size: "+SUB'ATT'NO1+"/"+UCC'INT'VEN'NO+ " 850 not created!"
        CALL DO'ERR
        CRITICAL'ERROR = 1
    ENDIF
RETURN

LOOKUP'PDD'INFO:
    IF UCC'KNO = "00194563" THEN
        PRH'KTRK'NO = INT'TRK'NO
        USE PRH INTO PRH'REC KEY PRH'KEY
        IF PRH'CTL = 0 THEN
            CALL GET'SIZE
            CALL LOOKUP'COLOR'DESC
            PRINT #33, PRH'MILL'STYLE; CHR(9);
            PRINT #33, COLOR'DESC; CHR(9);
            PRINT #33, SIZE; CHR(9);
        ENDIF
    ELSE
        MASTER'STYLE = ""
        PRINT #33, MASTER'STYLE; CHR(9);

        COLOR'CODE = ""
        PRINT #33, COLOR'CODE; CHR(9);

        SIZE'CODE = ""
        PRINT #33, SIZE'CODE; CHR(9);
    ENDIF
RETURN

LOOKUP'QUANTITY:
    CALL FIND'UOM
    CALL LOOKUP'PURCHASE'PRICE
RETURN

FIND'UOM:
    UOM'KNO = LIN'UOM'NO
    USE UOM INTO UOM'REC KEY UOM'KEY
    IF UOM'CTL # 0 THEN
        ENTRY = "Cannot find unit of measure"
        \KERROR UOM APID="IN" MODE="KEY" CNO="N"
        ENTRY = ENTRY + " for PO " + &
                         HDR'DOC'TYPE + "-" + HDR'NO
        \LABLOGGER ENTRY LNAME
        ABORT'FLAG = 1
        GOTO ABORT
    ELSE
        IF UOM'NO = 1 THEN
            QUANTITY'ORDERED = SUB'ORDER'QTY
            PRINT #33, QUANTITY'ORDERED; CHR(9);
            PO'UOM = "EA"
            PRINT #33, PO'UOM; CHR(9);
            TOTAL'QUANTITY = TOTAL'QUANTITY + QUANTITY'ORDERED
        ELSE
            QUANTITY'ORDERED = ((UOM'NUNITS/UOM'DUNITS) * SUB'ORDER'QTY)
            PRINT #33, QUANTITY'ORDERED; CHR(9);
            PO'UOM = "EA"
            PRINT #33, PO'UOM; CHR(9);
            TOTAL'QUANTITY = TOTAL'QUANTITY + QUANTITY'ORDERED
        ENDIF
    ENDIF
RETURN

LOOKUP'PURCHASE'PRICE:
    MAP1 GILDAN'EXCLUDE'PRICE,S,1
    \DG GETSTRING _POSETUP pol850_gildan_exclude_price GILDAN'EXCLUDE'PRICE
    IF GILDAN'EXCLUDE'PRICE = "Y" AND WRK'UCC'NO = "00821780" THEN
        PURCHASE'UNIT'PRICE = ""
        PRINT #33, PURCHASE'UNIT'PRICE; CHR(9);
        TOTAL'LINE'ITEM = ""
        PRINT #33, TOTAL'LINE'ITEM;
    ELSE
        CASE
        IF LIN'EST'AMT = 0 THEN
            TOTAL'LINE'ITEM = ""
            PRINT #33, TOTAL'LINE'ITEM USING "#####.####";
        ELSE
        IF UOM'NO = 1 THEN
            PURCHASE'UNIT'PRICE = LIN'EST'AMT/100
            PRINT #33, PURCHASE'UNIT'PRICE USING "####.####"; CHR(9);
            TOTAL'LINE'ITEM = LIN'EST'AMT/100 * SUB'ORDER'QTY
            PRINT #33, TOTAL'LINE'ITEM USING "#####.####";
        ELSE
            PURCHASE'UNIT'PRICE = LIN'EST'AMT/(UOM'NUNITS/UOM'DUNITS)/100
            PRINT #33, PURCHASE'UNIT'PRICE USING "####.####"; CHR(9);
            TOTAL'LINE'ITEM = (LIN'EST'AMT/(UOM'NUNITS/UOM'DUNITS)/100) * SUB'ORDER'QTY
            PRINT #33, TOTAL'LINE'ITEM USING "#####.####";
        ENDCASE
    ENDIF

    PRINT #33, CHR(13) + CHR(10);                   !!CRLF
RETURN

CREATE'850'TRAILER:
    TRAILER = SPACE
    TRAILER'RECORD = "09"
    PRINT #33, TRAILER'RECORD; CHR(9);

    NUM'OF'RECORDS = NUM'OF'RECORDS + 1
    RECORD'COUNT = NUM'OF'RECORDS
    PRINT #33, RECORD'COUNT; CHR(9);

    TOTAL'QUANTITY'ORDERED = TOTAL'QUANTITY
    PRINT #33, TOTAL'QUANTITY'ORDERED; CHR(9);

    TOTAL'MONETARY'VALUE = ""
    PRINT #33, TOTAL'MONETARY'VALUE; CHR(9);

    TOTAL'ORDER'VALUE = ""
    PRINT #33, TOTAL'ORDER'VALUE; CHR(9);

    TOTAL'NUM'CASES = ""
    PRINT #33, TOTAL'NUM'CASES; CHR(9);

    PO'TOTAL'AMT = ""
    PRINT #33, PO'TOTAL'AMT;

    PRINT #33, CHR(13) + CHR(10);                   !!CRLF
    TOTAL'QUANTITY = 0
RETURN

CIF IF USED AND NOT USED THEN
LOOKUP'PO'LINES:
    OELIN'KHDR'LOC'NO = OEHDR'LOC'NO
    OELIN'KDOC'TYPE = OEHDR'DOC'TYPE
    OELIN'KHDR'NO = OEHDR'NO
    OELIN'KNO = LIN'NO
    USE OELIN INTO OELIN'REC KEY OELIN'KEY
    IF OELIN'CTL # 0 THEN
        ENTRY = "Could not find line item for order"
        \KERROR OELIN APID="OE" MODE="KEY" CNO="N"
        ENTRY = ENTRY + " for Order " + OEHDR'LOC'NO + "-" + &
                         OEHDR'DOC'TYPE + "-" + OEHDR'NO
        \LABLOGGER ENTRY LNAME
    ELSE
        PURCHASE'UNIT'PRICE = OELIN'PRICE - OELIN'DISC
        PRINT #33, PURCHASE'UNIT'PRICE; CHR(9);
    ENDIF
RETURN

CREATE'850'OTHER'CHARGES'REC:
    OTHER'CHARGES'REC = SPACE
    OTHER'CHARGES = "06"
    PRINT #33, OTHER'CHARGES; CHR(9);

    OC'LINE'ITEM'NUM = "2"
    PRINT #33, OC'LINE'ITEM'NUM; CHR(9);
    PRH'KTRK'NO = LIN'TRK'NO
    USE PRH INTO PRH'REC KEY PRH'KEY
    IF PRH'CTL # 0 THEN
        ENTRY = "Credit card part not on file"
        \KERROR PRH APID="IN" MODE="KEY" CNO="N"
        ENTRY = ENTRY + " for Order " + OEHDR'LOC'NO + "-" + &
                         OEHDR'DOC'TYPE + "-" + OEHDR'NO
        \LABLOGGER ENTRY LNAME
        ABORT'FLAG = 1
        GOTO ABORT
    ELSE
        OTHER'CHARGE'DESC = PRH'DESC
        PRINT #33, OTHER'CHARGE'DESC; CHR(9);
    ENDIF
    CALL LOOKUP'PO'LINES

    OTHER'CHARGE'AMT = ""
    PRINT #33, OTHER'CHARGE'AMT;
    NUM'OF'RECORDS = NUM'OF'RECORDS + 1
    PRINT #33, CHR(13) + CHR(10);                   !!CRLF
RETURN
ENDCIF

EPO'ERROR:
    IF EPO'RCN = 0 THEN
        \LABLOGGER ENTRY LNAME
        RETURN
    ENDIF
    COPYF "MSGFIL[SY]",NOAFR
    MSG'DID = "POMSG"
    MAP1 SAV'MSG,B,3
    MSG'SPACE = SPACE
    MSG'DATA = ENTRY
    ADD MSG
    IF EPO'MSGNO = 0 THEN
        EPO'MSGNO = MSG'RCN
        UPDATE EPO FROM EPO'REC
    ELSE
        SAV'MSG = MSG'RCN
        MSG'RCN = EPO'MSGNO
        DO WHILE MSG'RCN # 0
            RDLOCK MSG
            IF MSG'CTL # 0 EXIT
            IF MSG'DATA = ENTRY THEN
                REL MSG
                RDLOCK MSG SAV'MSG INTO MSG'REC
                IF MSG'CTL = 0 THEN
                    DELETE MSG
                ENDIF
                EXIT
            ENDIF
            IF MSG'CH = 0 THEN
                MSG'CH = SAV'MSG
                WRITE MSG
                EXIT
            ELSE
                REL MSG
                MSG'RCN = MSG'CH
            ENDIF
        LOOP
    ENDIF
RETURN

LOOKUP'VIA:
    IF VIA'SCAC'CODE = "" THEN
        CARRIER'ROUTING'DETAILS = ""
    ELSE
        IF UCC'NO = "8465030" AND &
          (HDR'VIA'NO >= OEC'SCUS'VIA AND HDR'VIA'NO <= OEC'ECUS'VIA) THEN
              CARRIER'ROUTING'DETAILS = "PICKUP"
        ELSE
            CARRIER'ROUTING'DETAILS = VIA'SCAC'CODE
        ENDIF
    ENDIF
    PRINT #33, CARRIER'ROUTING'DETAILS; CHR(9);

    CASE
    IF VIA'MTYPE = "F" AND VIA'MAN'YN = "B" THEN
        DELIVER'SERV'LEVEL = "01"
    ELSE
    IF VIA'MTYPE = "F" AND VIA'MAN'YN = "G" THEN
        DELIVER'SERV'LEVEL = "03"
    ELSE
    IF VIA'MTYPE = "F" AND VIA'MAN'YN = "A" THEN
        DELIVER'SERV'LEVEL = "05"
    ELSE
    IF VIA'MTYPE = "F" AND VIA'MAN'YN = "D" THEN
        DELIVER'SERV'LEVEL = "06"
    ELSE
    IF VIA'MTYPE = "F" AND VIA'MAN'YN = "F" THEN
        DELIVER'SERV'LEVEL = "20"
    ELSE
    IF VIA'MTYPE = "F" AND VIA'MAN'YN = "H" THEN
        DELIVER'SERV'LEVEL = "90"
    ELSE
    IF VIA'MTYPE = "F" AND VIA'MAN'YN = "C" THEN
        DELIVER'SERV'LEVEL = "92"
    ELSE
    IF VIA'MTYPE = "U" AND VIA'SERV'TYPE = "01" AND VIA'SAT'IND # "Y" THEN
        DELIVER'SERV'LEVEL = "01"
    ELSE
    IF VIA'MTYPE = "U" AND VIA'SERV'TYPE = "02" THEN
        DELIVER'SERV'LEVEL = "02"
    ELSE
    IF VIA'MTYPE = "U" AND VIA'SERV'TYPE = "03" THEN
        DELIVER'SERV'LEVEL = "03"
    ELSE
    IF VIA'MTYPE = "U" AND VIA'SERV'TYPE = "59" THEN
        DELIVER'SERV'LEVEL = "07"
    ELSE
    IF VIA'MTYPE = "U" AND VIA'SERV'TYPE = "12" THEN
        DELIVER'SERV'LEVEL = "12"
    ELSE
    IF VIA'MTYPE = "U" AND VIA'SERV'TYPE = "13" THEN
        DELIVER'SERV'LEVEL = "13"
    ELSE
    IF VIA'MTYPE = "U" AND VIA'SERV'TYPE = "14" AND VIA'SAT'IND = "N" THEN
        DELIVER'SERV'LEVEL = "15"
    ELSE
    IF VIA'MTYPE = "U" AND VIA'SERV'TYPE = "01" AND VIA'SAT'IND = "Y" THEN
        DELIVER'SERV'LEVEL = "44"
    ELSE
    IF VIA'MTYPE = "U" AND VIA'SERV'TYPE = "14" AND VIA'SAT'IND = "Y" THEN
        DELIVER'SERV'LEVEL = "41"
    ELSE
    IF HDR'VIA'NO >= OEC'SCUS'VIA AND HDR'VIA'NO <= OEC'ECUS'VIA THEN
        IF UCC'NO = "8465030" THEN
            DELIVER'SERV'LEVEL = "PU"
        ELSE
            DELIVER'SERV'LEVEL = "10"
        ENDIF
    ELSE
        DELIVER'SERV'LEVEL = ""
    ENDCASE
RETURN

SET'DELIVER'TO'FIELDS:
    DELIVER'TO'COMPANY = LST'COMPANY
    PRINT #33, DELIVER'TO'COMPANY; CHR(9);

    FOR II = 1 TO 3
        IF UCS(LST'PTY'NO(II)) = "O" THEN
            BUS'PHONE = LST'PHONE(II)
        ENDIF
    NEXT II
    IF LST'PHONE(II) # "" THEN
        CONTACT'NAME = LST'FIRST + " " + LST'LAST + " " + &
            BUS'PHONE[1;3]+ "-" + BUS'PHONE[4;3] + "-" + &
            BUS'PHONE[7;4]
        PRINT #33, CONTACT'NAME; CHR(9);
    ELSE
        CONTACT'NAME = LST'FIRST + " " + LST'LAST
        PRINT #33, CONTACT'NAME; CHR(9);
    ENDIF

    DELIVER'TO'ADDR1 = LST'ADDR1
    PRINT #33, DELIVER'TO'ADDR1; CHR(9);

    IF LST'ADDR2 = "" THEN
        DELIVER'TO'ADDR2 = ""
        PRINT #33, DELIVER'TO'ADDR2; CHR(9);
    ELSE
        DELIVER'TO'ADDR2 = LST'ADDR2
        PRINT #33, DELIVER'TO'ADDR2; CHR(9);
    ENDIF

    IF LST'CITY = "" THEN
        ENTRY = "City not entered on shipping address"
        \KERROR LST APID="MC" CNO="N" MODE="KEY"
        ENTRY = ENTRY + " for PO " + &
                             HDR'DOC'TYPE + "-" + HDR'NO
        \LABLOGGER ENTRY LNAME
        ABORT'FLAG = 1
        GOTO ABORT
    ELSE
        DELIVER'TO'CITY = LST'CITY
        PRINT #33, DELIVER'TO'CITY; CHR(9);
    ENDIF

    CASE
    IF LST'ST = "" THEN
        ENTRY = "State not entered on shipping address"
        \KERROR LST APID="MC" MODE="KEY" CNO="N"
        ENTRY = ENTRY + " for PO " + &
                             HDR'DOC'TYPE + "-" + HDR'NO
        \LABLOGGER ENTRY LNAME
        ABORT'FLAG = 1
        GOTO ABORT
    ELSE
    IF LEN(LST'ST) > 2 OR LEN(LST'ST) = 1 THEN
        ENTRY = "State must be 2 character abbreviation"
        \KERROR LST APID="MC" MODE="KEY" CNO="N"
        ENTRY = ENTRY + " for PO " + &
                             HDR'DOC'TYPE + "-" + HDR'NO
        \LABLOGGER ENTRY LNAME
        ABORT'FLAG = 1
        GOTO ABORT
    ELSE
        DELIVER'TO'STATE = LST'ST
        PRINT #33, DELIVER'TO'STATE; CHR(9);
    ENDCASE

    IF LEN(LST'ZIP) > 5 THEN
        IF LST'ZIP[6;4] = "0000" THEN
            DELIVER'TO'ZIP = LST'ZIP[1;5]
            \STRIP DELIVER'TO'ZIP 3
        ELSE
            DELIVER'TO'ZIP = LST'ZIP[1;9]
            \STRIP DELIVER'TO'ZIP 3
        ENDIF
        PRINT #33, DELIVER'TO'ZIP; CHR(9);
    ELSE
        DELIVER'TO'ZIP = LST'ZIP[1;5]
        \STRIP DELIVER'TO'ZIP 3
        PRINT #33, DELIVER'TO'ZIP; CHR(9);
    ENDIF

    IF DELIVER'TO'COUNTRY = "USA" THEN
        DELIVER'TO'COUNTRY = "US"
    ELSE
        IF DELIVER'TO'COUNTRY = "CAN" THEN
            DELIVER'TO'COUNTRY = "CA"
        ENDIF
    ENDIF
    IF DELIVER'TO'COUNTRY = "" THEN
        DELIVER'TO'COUNTRY = "US"
    ENDIF
    PRINT #33, DELIVER'TO'COUNTRY; CHR(9);

    IF LST'PHONE1 # "" THEN
        IF LEN(LST'PHONE1) = 10 THEN
            DELIVER'TO'PHONE = LST'PHONE1[1;3]+"-"+LST'PHONE1[4;3]+"-"+ &
                               LST'PHONE1[7;4]
        ELSE
            DELIVER'TO'PHONE = LST'PHONE1[1;3]+"-"+LST'PHONE1[4;4]
        ENDIF
    ELSE
        DELIVER'TO'PHONE = ""
    ENDIF
RETURN

E'WRK'UCC'NO:
    \TABC NPRE="UCC" NKEY="NO" FLDNAM="WRK'UCC'NO" DSPNAM="DSP'UCC'NO" &
        APID="PO" MAND="Y"
RETURN

E'HEADER'SF:
    IF BLF'TYPE # "V" OR BLF'DOC'TYPE # "850" THEN
        SF = 2
        ENTRY = "Format must be for 850 PO output!"
    ENDIF
RETURN

E'LOC'NO:
    \TABC FROM="WRK" ON="LOC" DSPFLD="Y" APID="IN" DEFAULT="UB'LOC" &
        DSPLEN="25"
RETURN

E'STORE'ID:
    \TABC APRE="UCD" AKEY="STORE'ID" KFLD1="UCC'NO" BAD1="UCC'NO" &
        FLDNAM="WRK'STORE'ID" APID="PO" DSPNAM="DSP'STORE'DESC"
RETURN

E'WRK'TYP'NO:
    \TABC NPRE="BLF" NKEY="NO" FLDNAM="WRK'TYP'NO" DSPNAM="DSP'BLF'NO" &
        APID="PO" MAND="Y" SF'TEST="E'HEADER'SF"
RETURN

UPDATE'PO:
    HDR'KDOC'TYPE = WRK'MODE
    HDR'KNO = WRK'STRK'NO
    RDLOCK HDR INTO HDR'REC KEY HDR'KEY
    IF HDR'CTL = 0 THEN
        HDR'LSTID = "POL850"
        HDR'LSTDT = DATE
        WRITE HDR FROM HDR'REC
    ELSE
        ENTRY = "Cannot read PO!"
        \KERROR HDR APID="PO" CNO="N"
        \LABLOGGER ENTRY LNAME
        REL HDR
    ENDIF
RETURN

DELETE'EPO:
    EPO'SPACE = SPACE
    EPO'KPOHDR'DTYP = 1
    EPO'KPOHDR'NO = WRK'STRK'NO
    RDLOCK EPO INTO EPO'REC KEY EPO'KEY
    IF EPO'CTL = 0 THEN
        \SETKEY EPO MODE="ALL" APID="PO"
        \DELKEY EPO MODE="ALL" APID="PO"
        DELETE EPO
    ENDIF
RETURN

DELETE'PREVIOUS'850:
    CALL LOOKUP'BLF
    DIR = BASE + "/out"

    \U'TO'DTT'HMS EPO'AUDT

    \STRDTC CDATE="ENTRY" YYMMDD="Y" FORMAT="LONG"

    SENTRY = ENTRY

    \U'TO'DTT'HMS EPO'AUDT

    ENTRY = SENTRY + (HRS USING "#Z") + (MNS USING "#Z") + (SEC USING "#Z")

    ENTRY = DIR +"/850_"+EASI'SENDER'ID+"_"+ENTRY+".txt"

    LOOKUP ENTRY,II

    IF II # 0 THEN
        KILL ENTRY
        DELETED'850 = 1
        ENTRY = "Removing 850 file in /out directory "+II
        \LABLOGGER ENTRY LNAME
    ELSE
        DIR = BASE + "/done"
        \U'TO'DTT'HMS EPO'AUDT

        \STRDTC CDATE="ENTRY" YYMMDD="Y" FORMAT="LONG"

        SENTRY = ENTRY

        \U'TO'DTT'HMS EPO'AUDT

        ENTRY = SENTRY + (HRS USING "#Z") + (MNS USING "#Z") + (SEC USING "#Z")

        ENTRY = DIR +"/850_"+EASI'SENDER'ID+"_"+ENTRY+".txt"

        LOOKUP ENTRY,II

        IF II # 0 THEN
            KILL ENTRY
            DELETED'850 = 1
            ENTRY = "Removing 850 file in /done directory "+II
            \LABLOGGER ENTRY LNAME
        ENDIF
    ENDIF
RETURN

LOOKUP'BLF:
        BLF'KNO = WRK'TYP'NO
        USE BLF INTO BLF'REC KEY BLF'KEY
        IF BLF'CTL # 0 THEN
            ENTRY = "Cannot find interface format to process 850!"
            \KERROR BLF APID="PO" MODE="KEY" CNO="N"
            ENTRY = ENTRY + " for PO " + HDR'DOC'TYPE + "-" + HDR'NO
            \LABLOGGER ENTRY LNAME
            ABORT'FLAG = 1
            GOTO ABORT
        ELSE
            IF BLF'DOC'TYPE = "850" THEN
                VERSION'NUMBER = BLF'VERSION
                BASE = BLF'FILE'NAME
            ENDIF
        ENDIF
RETURN

DO'EMAIL:
        ENAME = "/tmp/email.PID"
        XCALL ABUTIL,46,ENAME,ENAME

        OPEN #9234, ENAME, OUTPUT
        PRINT #9234,"To: ";UCC'EMAIL'ADDR

        PRINT #9234,"Subject: 850 file creation"

        EMAIL'ADMIN = "Background Process"

        PRINT #9234,"From: ";EMAIL'ADMIN

        CALL LOOKUP'INT'VENDOR

        PRINT #9234,"Dear System Administrator:"
        PRINT #9234
        IF CRITICAL'ERROR = 1 THEN
            PRINT #9234,SPACE(5)+"An 850 file was not created due to invalid GTINS."
            PRINT #9234
            PRINT #9234,SPACE(5)+"See /logs/850_error.MMDDYY file for more information."
            PRINT #9234
            PRINT #9234,SPACE(5)+"This message was sent to you via an automated email system!"
        ELSE
            IF ABORT'FLAG = 1 THEN
                PRINT #9234,SPACE(5)+"An 850 file was not created."
                PRINT #9234
                PRINT #9234,SPACE(5)+"See /logs/850_error.MMDDYY file for more information."
                PRINT #9234
                PRINT #9234,SPACE(5)+"This message was sent to you via an automated email system!"
            ELSE
                PRINT #9234,SPACE(5)+"An 850 file was created for Purchase Order number"
                PRINT #9234
                PRINT #9234,SPACE(5)+HDR'LOC'NO+"-"+HDR'DOC'TYPE+"-"+HDR'NO+" for: "+ LST'COMPANY+"."
                PRINT #9234
                PRINT #9234,SPACE(5)+"The path and file name is: "+OUTNAME
                PRINT #9234
                PRINT #9234,SPACE(5)+"This message was sent to you via an automated email system!"
             ENDIF
        ENDIF
        CLOSE #9234
RETURN

SEND'EMAIL:
        \DG GETSTRING _POSETUP local_sendmail ENTRY
        IF ENTRY # "" THEN
            EMAIL'COMMAND = "aroot "+ENTRY
        ELSE
            EMAIL'COMMAND = "aroot sendmail"
        ENDIF
        EMAIL'COMMAND = EMAIL'COMMAND + " -t < "+ENAME
        XCALL SYSTEM,EMAIL'COMMAND
RETURN

LOOKUP'INT'VENDOR:
        LSTF'KNO = UCC'INT'VEN'NO
        USE LSTF INTO LST'REC KEY LSTF'KEY
RETURN

LOOKUP'PRH:
        PRH'KTRK'NO = LIN'TRK'NO
        USE PRH INTO PRH'REC KEY PRH'KEY
        IF PRH'CTL = 0 THEN
            \STRIP PRH'PART 3
        ENDIF
RETURN

GET'SIZE:
    ATT'KATH'NO = PRH'ATH'NO1
    ATT'KNO = INT'ATT'NO1
    USE ATT INTO ATT'REC KEY ATT'KEY
    GETNXT ATT INTO ATT'REC
    IF ATT'CTL # 0 THEN
        IF PRH'INTERFACE = 5 THEN
            ENTRY = "Size table incorrectly setup"
            CALL DO'ERR
            ATT'SPACE = SPACE
        ENDIF
    ELSE
        XCALL ABUTIL,11,ATT'DESC,2      !! remove trailing spaces
        SIZE = ATT'DESC
    ENDIF
RETURN
LOOKUP'COLOR'DESC:
        ROT'KCODE = PRH'PART[1,INC'ROT'LEN]
        USE ROT INTO ROT'REC KEY ROT'KEY
        IF ROT'CTL = 0 THEN
            IF ROT'ATH'NO2 # 0 THEN
                ATT'KATH'NO = ROT'ATH'NO2
                ATT'KNO = 0
                USE ATT INTO ATT'REC KEY ATT'KEY
                DO
                    GETNXT ATT INTO ATT'REC
                    IF ATT'CTL # 0 OR ATT'ATH'NO # ROT'ATH'NO2 EXIT
                    IF UCS(PRH'COLOR) = ATT'CODE THEN
                        COLOR'DESC = ATT'DESC
                        EXIT
                    ELSE
                        COLOR'DESC = "*** Not found ***"
                    ENDIF
                LOOP
            ENDIF
        ELSE
            COLOR'DESC = "ROT Not found ***"
        ENDIF

RETURN

